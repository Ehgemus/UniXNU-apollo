diff --git a/bsd/dev/hakios.apollo_adreno.c b/bsd/dev/hakios.apollo_adreno.c
new file mode 100644
index 000000000000..4899d0a198e9
--- /dev/null
+++ b/bsd/dev/hakios.apollo_adreno.c
@@ -0,0 +1,3651 @@
+/*
+ * The GPU of the Xiaomi Mi 10T (apollo), an Adreno 650 in the SM8250, woken step by step as redwood's
+ * Adreno 642L is (bsd/dev/hakios.adreno.c, whose way of going about it this follows; nothing of it is
+ * shared). Every address below belongs to this phone, and nothing here is touched unless boot-arg
+ * apollo_gpu=N asks for it, on device=apollo only. Steps 1 to N are performed, then everything they
+ * started is put back as it was found, in reverse.
+ *
+ *   1  reads   the GPU's clocks in the global clock controller, and the names RPMh knows its rails by
+ *   2  reads   the fuse that says which of the SM8250's GPUs this is (its speed bin)
+ *   3  reads   the GPU's own clock controller (0x3d90000), as the boot loader left it
+ *   4  writes  the "CX" power switch on: the half of the GPU block that is not the 3D core -- the power
+ *              management processor ("GMU"), the bus interface, the GPU's SMMU
+ *   5  writes  the clocks of that half on (the GMU at 200 MHz), and measures with the SoC's frequency
+ *              counter whether they run: the control register of the register bus's clock does not say
+ *   6  reads   the first words from the GPU block itself: registers of the GMU (among them a counter
+ *              that should be seen counting) and of the bus interface
+ *   7  reads   the GMU's own channel to RPMh (its RSC, 0x3de0000)
+ *   8  reads   the SMMU in front of the GPU: its ID registers, and which stream goes where
+ *   9  reads   that SMMU's first translation context
+ *  10  writes  two words into the GMU's memory and reads them back: the way its firmware goes
+ *  11  asks    TrustZone questions that pass no memory: whether it takes calls from this kernel, and
+ *              which firmware images it says it authenticates
+ *  12  asks    TrustZone to check the signature of the GPU's "zap shader", the signed image without
+ *              which the 3D core stays locked in secure mode: its header goes from the small image
+ *              (fw/a650_zap.mdt, from ../fw-gpu-apollo) into memory of ours that TrustZone is pointed at
+ *  13  writes  page tables for the memory the GMU's firmware asks for, and the SMMU: translation context 1
+ *              with those tables, and the GMU's requests (stream 5) sent through it
+ *  14  writes  the GMU's firmware (fw/a650_gmu.bin) into its own memory and into that memory
+ *  15  writes  the GMU's configuration, and lets its processor out of reset: the firmware runs
+ *  16  writes  the GMU's connection to RPMh; starts its message queues ("HFI")
+ *  17  talks   to the GMU: the tables it needs (the 3D core's speeds and supply levels, bus votes), "start",
+ *              the speed wanted, and the request to power the 3D core, whose registers are then read
+ *  18  writes  the 3D core's translation context (SMMU context 0, stream 0), with its ring and its microcode
+ *              (fw/a650_sqe.fw) in it
+ *  19  asks    TrustZone to load the zap shader (fw/a650_zap.b02) into the memory reserved for it, and run it
+ *  20  writes  the 3D core's registers as Linux's hw_init does for the a650; starts its command processor
+ *              and gives it its first command
+ *  21  commands the 3D core out of secure mode, and to write a word into a page of ours
+ *  22  commands a picture filled with three colours, and shows it on the panel
+ *
+ * With apollo_gpu_use=1 (and apollo_gpu=21, steps 1 to 21: the picture of step 22 is skipped) the steps are
+ * not undone: the GPU stays as step 21 leaves it, the 3D core powered and taking commands, and the service
+ * ApolloGPU (iokit/Kernel/hakios.apollo_gpu.cpp) hands it to programs through the interface of Linux's msm driver,
+ * which is what Mesa's freedreno speaks -- "the GPU kept on" below, a copy of hakios.adreno.c's, with
+ * the a650's answers. The GPU is given back when the run ends (apollo_adreno_stop()).
+ *
+ * More boot-args:
+ *   apollo_gpu_pause=MS  how long the newest step waits after saying what it is about to touch (default
+ *                        300), for the loader to have the line before a silent reset could swallow it
+ *   apollo_gpu_keep=1    leave CX and the clocks on at the end (for a look with a later run)
+ *   apollo_gpu_dcvs=0    with apollo_gpu_use=1: the 3D core's speed stays at apollo_gpu_speed instead of following how
+ *                        busy it is (the speed governor, "the GPU kept on" below); apollo_gpu_max=N: its top step (6)
+ *   apollo_gpu_use=1     keep the GPU for the system to draw with (see above); gpu_recover=1, gpu_exact=0 and
+ *                        gpu_log=1 as in redwood's (the names of the shared service's boot-args)
+ *   apollo_gpu_speed=N   step 17 asks for the 3D core's Nth speed of this phone's (speed bin 0): 1 305 MHz,
+ *                        2 400 MHz (the default), 3 441.6 MHz, 4 490 MHz, 5 525 MHz, 6 587 MHz
+ *
+ * Addresses are from the phone's own device tree (.device-local/apollo/device.dtb: qcom,kgsl-3d0@3d00000,
+ * qcom,gmu@3d6a000, qcom,gpucc@3d90000, gdsc@3d9106c, kgsl-smmu@3da0000, the qfprom cell gpu_speed_bin),
+ * register layouts from Xiaomi's apollo kernel (MiCode/Xiaomi_Kernel_OpenSource apollo-q-oss:
+ * drivers/clk/qcom/gcc-kona.c, gpucc-kona.c, debugcc-kona.c) and Linux (gpucc-sm8250.c, gdsc.c,
+ * clk-rcg2.c, drivers/gpu/drm/msm/adreno/a6xx_gmu.c with registers/adreno/a6xx{,_gmu}.xml, cmd-db.c).
+ */
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include <sys/hakios.apollo_input.h>
+#include <sys/systm.h>
+#include <vm/vm_kern.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern vm_offset_t ml_io_map_wcomb(vm_offset_t phys_addr, vm_size_t size);
+extern uint64_t kvtophys(vm_offset_t va);       /* pmap_paddr_t */
+
+static uint32_t last_step, pause_ms = 300, keep, use, speed_index = 2;
+static uint32_t step;                   /* the one being performed */
+static uint32_t speed_bin;
+static bool quiet;                      /* accesses that have been seen to work, repeated: say nothing */
+
+/* into the loader's log as well (as the other apollo drivers): a run that ends in a reset leaves no other */
+extern void loader_log_putc(char c);
+
+static int say(const char *format, ...) __printflike(1, 2);
+
+static int
+say(const char *format, ...)
+{
+	char line[400];
+	va_list list;
+
+	va_start(list, format);
+	vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
+	for (const char *c = line; *c != 0; c++) {
+		loader_log_putc(*c);
+	}
+	return printf("%s", line);
+}
+
+static void
+sleep_us(uint32_t us)
+{
+	delay_for_interval(us, NSEC_PER_USEC);
+}
+
+static void
+sleep_ms(uint32_t ms)
+{
+	delay_for_interval(ms, NSEC_PER_MSEC);
+}
+
+/* ---- register access ------------------------------------------------------------------------------- */
+
+/* one plain load or store of a general register (hakios.adreno.c: what a hypervisor's imitation can carry out) */
+static uint32_t __attribute__((noinline))
+rd(vm_offset_t address)
+{
+	uint32_t value;
+
+	__asm__ volatile ("ldr %w0, [%1]" : "=r" (value) : "r" (address) : "memory");
+	return value;
+}
+
+static uint32_t __attribute__((noinline))
+rd8(vm_offset_t address)
+{
+	uint32_t value;
+
+	__asm__ volatile ("ldrb %w0, [%1]" : "=r" (value) : "r" (address) : "memory");
+	return value;
+}
+
+static void __attribute__((noinline))
+wr(vm_offset_t address, uint32_t value)
+{
+	__asm__ volatile ("str %w0, [%1]" : : "r" (value), "r" (address) : "memory");
+}
+
+/* A stretch of registers; mapped when a step first needs it. */
+struct block {
+	const char *name;
+	uint32_t phys, size;
+	vm_offset_t base;
+};
+
+static void
+need(struct block *b)
+{
+	if (b->base == 0) {
+		b->base = ml_io_map(b->phys, b->size);
+	}
+}
+
+/* time for the loader to have what has just been said, where it is not yet known to be harmless */
+static void
+hold(void)
+{
+	if (step == last_step && pause_ms) {
+		sleep_ms(pause_ms);
+	}
+}
+
+static void
+announce(const char *what)
+{
+	say("apollo gpu: step %u: %s\n", step, what);
+	hold();
+}
+
+static uint32_t
+get(struct block *b, const char *name, uint32_t offset)
+{
+	uint32_t value;
+
+	need(b);
+	if (quiet) {
+		return rd(b->base + offset);
+	}
+	value = rd(b->base + offset);
+	say("apollo gpu: %u: %s %s (%#x) = %#x\n", step, b->name, name, b->phys + offset, value);
+	return value;
+}
+
+static void
+put(struct block *b, const char *name, uint32_t offset, uint32_t value)
+{
+	need(b);
+	if (!quiet) {
+		say("apollo gpu: %u: about to write %s %s at %#x: %#x\n", step, b->name, name, b->phys + offset, value);
+	}
+	wr(b->base + offset, value);
+}
+
+/* Look at a register until the masked bits have the value, for so many milliseconds. */
+static bool
+wait_for(struct block *b, uint32_t offset, uint32_t mask, uint32_t value, uint32_t ms)
+{
+	for (uint32_t i = 0; i < ms * 10; i++) {
+		if ((rd(b->base + offset) & mask) == value) {
+			return true;
+		}
+		sleep_us(100);
+	}
+	return (rd(b->base + offset) & mask) == value;
+}
+
+/*
+ * What the steps change, to be put back in reverse when they are over: a register and the value it had.
+ */
+struct undo {
+	struct block *b;
+	const char *name;
+	uint32_t offset, value;
+};
+static struct undo undo[32];
+static unsigned undo_count;
+
+/* write a register, noting what it held first (once: the first value is the one to go back to) */
+static void
+change(struct block *b, const char *name, uint32_t offset, uint32_t value)
+{
+	uint32_t was = get(b, name, offset);
+	unsigned i;
+
+	if (was == value) {
+		return;
+	}
+	for (i = 0; i < undo_count && !(undo[i].b == b && undo[i].offset == offset); i++) {
+	}
+	if (i == undo_count && undo_count < sizeof(undo) / sizeof(undo[0])) {
+		undo[undo_count++] = (struct undo){ b, name, offset, was };
+	}
+	put(b, name, offset, value);
+}
+
+/* ---- step 1: the clocks from outside, and RPMh's names ------------------------------------------------ */
+
+/*
+ * dt: qcom,gcc@100000 (gcc-kona.c). The GPU's clocks there, by the names the GPU's nodes give them:
+ * gcc_gpu_memnoc_gfx and gcc_gpu_snoc_dvm_gfx (its bus connections), gcc_ddrss_gpu_axi (memory),
+ * gcc_gpu_cfg_ahb (the registers of its clock controller), and the two taps of GPLL0 its clock
+ * controller takes as inputs. The touch screen, the audio and the PCIe drivers use this controller too.
+ */
+static struct block gcc = { "gcc", 0x00100000, 0x80000 };
+#define GCC_PLL_VOTE            0x52000         /* bit 15: gcc_gpu_gpll0_clk_src (600 MHz), bit 16: ..._div_clk_src (300 MHz) */
+#define GCC_PLL_VOTE_GPU        (1u << 15)
+#define GCC_PLL_VOTE_GPU_DIV    (1u << 16)
+#define GCC_GPU_CFG_AHB_CBCR    0x71004
+#define GCC_GPU_MEMNOC_GFX_CBCR 0x7100c
+#define GCC_GPU_SNOC_DVM_GFX_CBCR 0x71018
+#define GCC_DDRSS_GPU_AXI_CBCR  0x71154
+#define CBCR_ENABLE             (1u << 0)       /* a clock's control register: on */
+#define CBCR_OFF                (1u << 31)      /* ... and whether it is in fact off */
+
+/* dt: reserved-memory cmd_db@80860000: the boot loader's list of what RPMh can switch (cmd-db.c) */
+#define CMD_DB_PHYS             0x80860000UL
+#define CMD_DB_SIZE             0x20000UL
+
+struct cmd_db_slave {
+	uint16_t id, header_offset, data_offset, count, version, reserved[3];
+};
+struct cmd_db_header {
+	uint32_t version;
+	uint8_t magic[4];
+	struct cmd_db_slave slave[8];
+	uint32_t checksum, reserved;
+	uint8_t data[];
+};
+struct cmd_db_entry {
+	char id[8];
+	uint32_t priority[2];
+	uint32_t address;
+	uint16_t length, offset;
+};
+
+static const struct cmd_db_header *cmd_db;
+
+/* where RPMh has a resource (0: nowhere) and, for a rail, the levels it knows (the GMU is told positions in it) */
+static uint32_t
+rpmh_resource(const char *name, uint16_t *levels, unsigned *level_count)
+{
+	const struct cmd_db_header *db = cmd_db;
+	char id[8] = { 0 };
+
+	if (level_count != NULL) {
+		*level_count = 0;
+	}
+	if (db == NULL) {
+		db = cmd_db = (const struct cmd_db_header *)ml_io_map_wcomb(CMD_DB_PHYS, CMD_DB_SIZE);  /* memory, not registers */
+	}
+	if (db->magic[0] != 0xdb || db->magic[1] != 0x30 || db->magic[2] != 0x03 || db->magic[3] != 0x0c) {
+		return 0;
+	}
+	strlcpy(id, name, sizeof(id));
+	for (unsigned s = 0; s < 8; s++) {
+		const struct cmd_db_slave *slave = &db->slave[s];
+		const struct cmd_db_entry *entry = (const struct cmd_db_entry *)(db->data + slave->header_offset);
+
+		if (slave->id == 0 || slave->count > 512) {
+			continue;
+		}
+		for (unsigned i = 0; i < slave->count; i++) {
+			const uint8_t *data = db->data + slave->data_offset + entry[i].offset;
+			unsigned count = entry[i].length / 2u;
+
+			if (memcmp(entry[i].id, id, sizeof(id)) != 0) {
+				continue;
+			}
+			if ((unsigned)slave->data_offset + entry[i].offset + entry[i].length > CMD_DB_SIZE - 0x1000) {
+				count = 0;
+			}
+			for (unsigned l = 0; levels != NULL && l < count && l < 16; l++) {
+				levels[l] = (uint16_t)(data[2 * l] | data[2 * l + 1] << 8);
+				if (l > 0 && levels[l] == 0) {
+					break;
+				}
+				*level_count = l + 1;
+			}
+			return entry[i].address;
+		}
+	}
+	return 0;
+}
+
+static void
+show_rpmh_resource(const char *name)
+{
+	uint16_t level[16];
+	unsigned count = 0;
+	uint32_t address = rpmh_resource(name, level, &count);
+	char levels[160];
+	int at = 0;
+
+	if (address == 0) {
+		say("apollo gpu: %u: RPMh has no \"%s\"\n", step, name);
+		return;
+	}
+	levels[0] = 0;
+	for (unsigned l = 0; l < count && at < (int)sizeof(levels) - 8; l++) {
+		at += snprintf(levels + at, sizeof(levels) - (size_t)at, " %u", level[l]);
+	}
+	say("apollo gpu: %u: RPMh has \"%s\" at %#x; levels:%s\n", step, name, address, levels);
+}
+
+static bool
+step_outside(void)
+{
+	announce("read the GPU's clocks in the global clock controller");
+	get(&gcc, "pll votes", GCC_PLL_VOTE);
+	get(&gcc, "gpu_cfg_ahb", GCC_GPU_CFG_AHB_CBCR);
+	get(&gcc, "gpu_memnoc_gfx", GCC_GPU_MEMNOC_GFX_CBCR);
+	get(&gcc, "gpu_snoc_dvm_gfx", GCC_GPU_SNOC_DVM_GFX_CBCR);
+	get(&gcc, "ddrss_gpu_axi", GCC_DDRSS_GPU_AXI_CBCR);
+
+	announce("look up the GPU's rails in the boot loader's list of RPMh resources (memory at 0x80860000)");
+	show_rpmh_resource("gfx.lvl");          /* the 3D core's own rail (dt: VDD_GFX_LEVEL, pm8150a s1) */
+	show_rpmh_resource("cx.lvl");           /* the CX half's, shared with most of the SoC */
+	show_rpmh_resource("mx.lvl");           /* memories */
+	return true;
+}
+
+/* ---- step 2: the fuse ---------------------------------------------------------------------------------- */
+
+/*
+ * dt: the qfprom cell gpu_speed_bin at 0x419b, bits 5 to 7 (Linux's sm8250.dtsi has the same cell:
+ * qfprom@784000 + 0x19b). Which bin it is chooses the GPU's speeds (dt: qcom,gpu-pwrlevel-bins):
+ * 0 up to 587 MHz, 1, 2 and 4 up to 670 MHz, 3 up to 525 MHz.
+ */
+static struct block qfprom = { "qfprom", 0x00780000, 0x7000 };
+#define QFPROM_GPU_SPEED_BIN    0x419b
+
+static bool
+step_fuses(void)
+{
+	uint32_t raw;
+
+	announce("read the GPU's speed bin fuse (0x78419b)");
+	need(&qfprom);
+	raw = rd8(qfprom.base + QFPROM_GPU_SPEED_BIN);
+	speed_bin = raw >> 5 & 7;
+	say("apollo gpu: %u: qfprom %#x = %#x: speed bin %u, an Adreno 650 good for %s MHz\n", step,
+	    qfprom.phys + QFPROM_GPU_SPEED_BIN, raw, speed_bin, speed_bin == 0 ? "587" : speed_bin == 3 ? "525" :
+	    speed_bin == 1 || speed_bin == 2 || speed_bin == 4 ? "670" : "(a bin the device tree does not know)");
+	return true;
+}
+
+/* ---- step 3: the GPU's clock controller ----------------------------------------------------------------- */
+
+/*
+ * dt: qcom,gpucc@3d90000, 0x9000 long; offsets: gpucc-kona.c, Linux's gpucc-sm8250.c and the GDSCs of
+ * the device tree. Its registers answer only while gcc_gpu_cfg_ahb runs. Unlike the 642L's, the SM8250's
+ * has no "hub" and no "cb" clock.
+ */
+static struct block gpucc = { "gpucc", 0x03d90000, 0x9000 };
+#define GPUCC_PLL0_MODE         0x0000          /* the 3D core's PLL: bit 31 locked, bit 0 output on */
+#define GPUCC_PLL1_MODE         0x0100          /* a 500 MHz PLL, an alternative source for the GMU's clock */
+#define GPUCC_CXO_AON_CBCR      0x1004
+#define GPUCC_GX_SW_RESET       0x1008          /* dt: gpu_gx_gdsc sw-reset */
+#define GPUCC_GX_GDSCR          0x100c          /* dt: gpu_gx_gdsc, the 3D core's power switch: the GMU's to operate */
+#define GPUCC_GX_GMU_CBCR       0x1064
+#define GPUCC_CX_GDSCR          0x106c          /* dt: gpu_cx_gdsc */
+#define GPUCC_AHB_CBCR          0x1078          /* gpu_cc_ahb_clk: the register bus inside the GPU block */
+#define GPUCC_CX_SNOC_DVM_CBCR  0x108c          /* gpu_cc_cx_snoc_dvm_clk */
+#define GPUCC_CX_GMU_CBCR       0x1098          /* gpu_cc_cx_gmu_clk: the GMU */
+#define GPUCC_CX_GMU_WAKE_SLEEP (0xfu << 8 | 0xfu << 4)  /* gpucc-kona.c's probe: "recommended WAKEUP/SLEEP settings" */
+#define GPUCC_CXO_CBCR          0x109c          /* gpu_cc_cxo_clk: the crystal, for the GMU's timers */
+#define GPUCC_GMU_RCGR          0x1120          /* gpu_cc_gmu_clk_src: +0 command, +4 source and divider */
+#define GPUCC_GX_DOMAIN_MISC    0x1508          /* dt: gpu_gx_gdsc domain-addr (Linux: its clamp_io_ctrl) */
+#define GPUCC_CX_HW_CTRL        0x1540          /* dt: gpu_cx_gdsc hw-ctrl-addr: bit 31 is where CX is seen on */
+#define GPUCC_SMMU_VOTE_CBCR    0x5000          /* gpu_cc_hlos1_vote_gpu_smmu_clk: our vote for the SMMU's clock */
+
+#define GDSC_SW_COLLAPSE        (1u << 0)       /* a power switch's control register (gdsc.c): off, by software */
+#define GDSC_HW_CONTROL         (1u << 1)
+#define GDSC_POWER_ON           (1u << 31)
+
+static bool
+gpucc_answers(void)
+{
+	need(&gcc);
+	need(&gpucc);
+	if (rd(gcc.base + GCC_GPU_CFG_AHB_CBCR) & CBCR_OFF) {
+		say("apollo gpu: %u: the GPU clock controller's registers have no clock (gcc gpu_cfg_ahb %#x)\n", step,
+		    rd(gcc.base + GCC_GPU_CFG_AHB_CBCR));
+		return false;
+	}
+	return true;
+}
+
+static bool
+step_gpucc(void)
+{
+	uint32_t ahb;
+
+	announce("make sure the clock of the GPU clock controller's registers runs (gcc_gpu_cfg_ahb)");
+	ahb = get(&gcc, "gpu_cfg_ahb", GCC_GPU_CFG_AHB_CBCR);
+	if (!(ahb & CBCR_ENABLE)) {
+		change(&gcc, "gpu_cfg_ahb", GCC_GPU_CFG_AHB_CBCR, ahb | CBCR_ENABLE);
+	}
+	if (!wait_for(&gcc, GCC_GPU_CFG_AHB_CBCR, CBCR_OFF, 0, 10)) {
+		say("apollo gpu: %u: it stays off (%#x): the GPU's clock controller would not answer\n", step,
+		    rd(gcc.base + GCC_GPU_CFG_AHB_CBCR));
+		return false;
+	}
+
+	announce("read the GPU's clock controller (0x3d90000) as it is: the first access to the GPU's part of the SoC");
+	get(&gpucc, "cx_gdscr", GPUCC_CX_GDSCR);
+	get(&gpucc, "cx_hw_ctrl", GPUCC_CX_HW_CTRL);
+	get(&gpucc, "gx_gdscr", GPUCC_GX_GDSCR);
+	get(&gpucc, "gx_sw_reset", GPUCC_GX_SW_RESET);
+	get(&gpucc, "gx_domain_misc", GPUCC_GX_DOMAIN_MISC);
+	get(&gpucc, "pll0 mode", GPUCC_PLL0_MODE);
+	get(&gpucc, "pll0 multiplier", GPUCC_PLL0_MODE + 4);
+	get(&gpucc, "pll1 mode", GPUCC_PLL1_MODE);
+	get(&gpucc, "pll1 multiplier", GPUCC_PLL1_MODE + 4);
+	get(&gpucc, "gmu_clk_src command", GPUCC_GMU_RCGR);
+	get(&gpucc, "gmu_clk_src source", GPUCC_GMU_RCGR + 4);
+	get(&gpucc, "cxo_aon", GPUCC_CXO_AON_CBCR);
+	get(&gpucc, "gx_gmu", GPUCC_GX_GMU_CBCR);
+	get(&gpucc, "ahb", GPUCC_AHB_CBCR);
+	get(&gpucc, "cx_snoc_dvm", GPUCC_CX_SNOC_DVM_CBCR);
+	get(&gpucc, "cx_gmu", GPUCC_CX_GMU_CBCR);
+	get(&gpucc, "cxo", GPUCC_CXO_CBCR);
+	get(&gpucc, "smmu vote", GPUCC_SMMU_VOTE_CBCR);
+	return true;
+}
+
+/* ---- step 4: CX power --------------------------------------------------------------------------------- */
+
+static bool
+cx_is_on(void)
+{
+	return (rd(gpucc.base + GPUCC_CX_GDSCR) | rd(gpucc.base + GPUCC_CX_HW_CTRL)) & GDSC_POWER_ON;
+}
+
+/*
+ * The switch hangs on the rail cx.lvl, up for as long as the SoC runs at all; the vendor's driver
+ * (gdsc-regulator.c) clears the collapse bit and waits for bit 31 of hw-ctrl-addr, Linux for bit 31 of
+ * the control register itself.
+ */
+static bool
+step_cx_power(void)
+{
+	uint32_t gdscr;
+
+	if (!gpucc_answers()) {
+		return false;
+	}
+	announce("switch the CX half of the GPU block on (gpu_cx_gdsc): clear the collapse bit of its power switch");
+	gdscr = get(&gpucc, "cx_gdscr", GPUCC_CX_GDSCR);
+	get(&gpucc, "cx_hw_ctrl", GPUCC_CX_HW_CTRL);
+	if (cx_is_on()) {
+		say("apollo gpu: %u: CX is on already (an earlier kernel, or the boot loader, left it so)\n", step);
+	} else {
+		if (gdscr & GDSC_HW_CONTROL) {
+			say("apollo gpu: %u: the switch is under hardware control: not ours to operate\n", step);
+			return false;
+		}
+		change(&gpucc, "cx_gdscr", GPUCC_CX_GDSCR, gdscr & ~GDSC_SW_COLLAPSE);
+		for (int i = 0; i < 500 && !cx_is_on(); i++) {
+			sleep_us(100);
+		}
+		get(&gpucc, "cx_gdscr", GPUCC_CX_GDSCR);
+		get(&gpucc, "cx_hw_ctrl", GPUCC_CX_HW_CTRL);
+		if (!cx_is_on()) {
+			say("apollo gpu: %u: CX does not come on\n", step);
+			return false;
+		}
+		say("apollo gpu: %u: CX IS ON\n", step);
+	}
+	if (rd(gpucc.base + GPUCC_GX_GDSCR) & GDSC_POWER_ON) {
+		say("apollo gpu: %u: the 3D core (GX) has power already: left on by an earlier kernel\n", step);
+	}
+	return true;
+}
+
+/* ---- step 5: clocks ------------------------------------------------------------------------------------ */
+
+#define RCG_UPDATE              (1u << 0)       /* command register (clk-rcg2.c): take the new source and divider */
+#define RCG_SOURCE_MASK         0x371fu         /* [4:0] 2*divider-1, [10:8] source, [13:12] mode */
+#define RCG_GPLL0_DIV(twice)    (6u << 8 | ((twice) - 1))       /* source 6: GPLL0's 300 MHz tap (gpucc-kona.c parent map) */
+
+/* Turn a clock on and see it run. Not every clock's status can be believed (halt_check in Linux): `must` says which. */
+static bool
+clock_on(struct block *b, const char *name, uint32_t cbcr, bool must)
+{
+	uint32_t was = get(b, name, cbcr);
+
+	if (!(was & CBCR_ENABLE)) {
+		change(b, name, cbcr, was | CBCR_ENABLE);
+	}
+	if (wait_for(b, cbcr, CBCR_OFF, 0, 10)) {
+		return true;
+	}
+	say("apollo gpu: %u: %s %s stays off (%#x)%s\n", step, b->name, name, rd(b->base + cbcr),
+	    must ? "" : "; its status bit is not one to rely on, going on");
+	return !must;
+}
+
+static bool
+clock_source(const char *name, uint32_t rcgr, uint32_t source)
+{
+	uint32_t was = get(&gpucc, name, rcgr + 4);
+
+	if ((was & RCG_SOURCE_MASK) == source) {
+		return true;
+	}
+	change(&gpucc, name, rcgr + 4, (was & ~RCG_SOURCE_MASK) | source);
+	put(&gpucc, name, rcgr, rd(gpucc.base + rcgr) | RCG_UPDATE);
+	if (!wait_for(&gpucc, rcgr, RCG_UPDATE, 0, 10)) {
+		say("apollo gpu: %u: %s does not take its new source (command %#x)\n", step, name, rd(gpucc.base + rcgr));
+		return false;
+	}
+	get(&gpucc, name, rcgr + 4);
+	return true;
+}
+
+/*
+ * The SoC's frequency counter (debugcc-kona.c): a clock controller puts one of its clocks on its debug
+ * output, the global controller counts what it is given there against the crystal / 4. gpu_cc_ahb has
+ * "no bit to check" (BRANCH_HALT_DELAY): whether it runs is measured.
+ */
+#define GCC_DEBUG_MUX           0x62000         /* [9:0] which clock goes to the counter */
+#define GCC_DEBUG_MUX_GPUCC     0x163           /* ... the GPU clock controller's debug output */
+#define GCC_DEBUG_DIV           0x62004         /* [3:0] divider - 1 */
+#define GCC_DEBUG_CBCR          0x62008
+#define GCC_XO_DIV4_CBCR        0x4300c         /* the counter's time base: the crystal / 4, 4.8 MHz */
+#define GCC_MEASURE_CTL         0x62038         /* [19:0] how many ticks of the time base to count for */
+#define MEASURE_RUN             (1u << 20)
+#define MEASURE_CLEAR           (1u << 21)
+#define GCC_MEASURE_STATUS      0x6203c         /* [24:0] the count */
+#define MEASURE_DONE            (1u << 25)
+#define MEASURE_BRIEF           0x1000          /* ticks: a millisecond */
+#define MEASURE_FULL            0x20000         /* 27 ms */
+#define MEASURE_FAILED          0xffffffffu
+#define GPUCC_DEBUG_DIV         0x10fc          /* [1:0] divider - 1 */
+#define GPUCC_DEBUG_CBCR        0x1100
+#define GPUCC_DEBUG_MUX         0x1568          /* [7:0] which of the GPU's clocks */
+#define GPUCC_DEBUG_CXO_AON     0x0a
+#define GPUCC_DEBUG_GX_GFX3D    0x0b            /* the 3D core's own clock */
+#define GPUCC_DEBUG_GX_GMU      0x0f
+#define GPUCC_DEBUG_AHB         0x10
+#define GPUCC_DEBUG_CX_SNOC_DVM 0x15
+#define GPUCC_DEBUG_CX_GMU      0x18
+#define GPUCC_DEBUG_CXO         0x19
+
+static uint32_t
+count_clock(uint32_t ticks)
+{
+	uint32_t control = get(&gcc, "measure control", GCC_MEASURE_CTL) & ~(MEASURE_RUN | MEASURE_CLEAR | 0xfffffu);
+	uint32_t status = 0;
+
+	put(&gcc, "measure control", GCC_MEASURE_CTL, control | MEASURE_CLEAR);
+	sleep_us(10);
+	put(&gcc, "measure control", GCC_MEASURE_CTL, control | ticks);
+	put(&gcc, "measure control", GCC_MEASURE_CTL, control | ticks | MEASURE_RUN);
+	for (int i = 0; i < 2000 && !(status & MEASURE_DONE); i++) {
+		sleep_us(100);
+		status = rd(gcc.base + GCC_MEASURE_STATUS);
+	}
+	put(&gcc, "measure control", GCC_MEASURE_CTL, control | ticks);
+	return status & MEASURE_DONE ? get(&gcc, "measure status", GCC_MEASURE_STATUS) & 0x1ffffff : MEASURE_FAILED;
+}
+
+/* the rate in Hz of one of the GPU clock controller's clocks; 0 if it stands still. Everything changed is put back. */
+static uint32_t
+measure(uint32_t select)
+{
+	uint32_t gpu_mux = get(&gpucc, "debug mux", GPUCC_DEBUG_MUX), gpu_div = get(&gpucc, "debug divider", GPUCC_DEBUG_DIV);
+	uint32_t gpu_cbcr = get(&gpucc, "debug output", GPUCC_DEBUG_CBCR), mux = get(&gcc, "debug mux", GCC_DEBUG_MUX);
+	uint32_t div = get(&gcc, "debug divider", GCC_DEBUG_DIV), cbcr = get(&gcc, "debug input", GCC_DEBUG_CBCR);
+	uint32_t base = get(&gcc, "crystal/4", GCC_XO_DIV4_CBCR), control = get(&gcc, "measure control", GCC_MEASURE_CTL);
+	uint32_t brief, full;
+
+	put(&gpucc, "debug mux", GPUCC_DEBUG_MUX, (gpu_mux & ~0xffu) | select);
+	put(&gpucc, "debug divider", GPUCC_DEBUG_DIV, (gpu_div & ~0x3u) | 1);
+	put(&gpucc, "debug output", GPUCC_DEBUG_CBCR, gpu_cbcr | CBCR_ENABLE);
+	put(&gcc, "debug mux", GCC_DEBUG_MUX, (mux & ~0x3ffu) | GCC_DEBUG_MUX_GPUCC);
+	put(&gcc, "debug divider", GCC_DEBUG_DIV, (div & ~0xfu) | 1);
+	put(&gcc, "debug input", GCC_DEBUG_CBCR, cbcr | CBCR_ENABLE);
+	put(&gcc, "crystal/4", GCC_XO_DIV4_CBCR, base | CBCR_ENABLE);
+	/* a counter whose input stands still keeps its last count: the two counts differ only if the clock runs */
+	brief = count_clock(MEASURE_BRIEF);
+	full = brief == MEASURE_FAILED ? MEASURE_FAILED : count_clock(MEASURE_FULL);
+	put(&gcc, "measure control", GCC_MEASURE_CTL, control);
+	put(&gcc, "crystal/4", GCC_XO_DIV4_CBCR, base);
+	put(&gcc, "debug input", GCC_DEBUG_CBCR, cbcr);
+	put(&gcc, "debug divider", GCC_DEBUG_DIV, div);
+	put(&gcc, "debug mux", GCC_DEBUG_MUX, mux);
+	put(&gpucc, "debug output", GPUCC_DEBUG_CBCR, gpu_cbcr);
+	put(&gpucc, "debug divider", GPUCC_DEBUG_DIV, gpu_div);
+	put(&gpucc, "debug mux", GPUCC_DEBUG_MUX, gpu_mux);
+
+	if (full == MEASURE_FAILED) {
+		return MEASURE_FAILED;
+	}
+	if (full == brief) {
+		return 0;
+	}
+	/* the vendor's formula; times 4 for the two dividers on the way to the counter */
+	return (uint32_t)(((uint64_t)full * 10 + 15) * 4800000 / ((uint64_t)MEASURE_FULL * 10 + 35) * 4);
+}
+
+static uint32_t
+measure_quietly(uint32_t select)
+{
+	uint32_t hz;
+
+	quiet = true;
+	hz = measure(select);
+	quiet = false;
+	return hz;
+}
+
+/* The crystal's first and aloud: its rate is known, so it shows whether the counter can be believed. */
+static bool
+measure_clocks(void)
+{
+	static const struct {
+		const char *name;
+		uint32_t select;
+	} clocks[] = {
+		{ "cx_gmu (200 MHz was asked for)", GPUCC_DEBUG_CX_GMU }, { "cxo_aon", GPUCC_DEBUG_CXO_AON },
+		{ "cx_snoc_dvm", GPUCC_DEBUG_CX_SNOC_DVM }, { "gx_gmu (should be off)", GPUCC_DEBUG_GX_GMU },
+		{ "gx_gfx3d (should be off)", GPUCC_DEBUG_GX_GFX3D }, { "ahb, THE ONE IN QUESTION,", GPUCC_DEBUG_AHB },
+	};
+	uint32_t hz, ahb_hz = MEASURE_FAILED;
+
+	announce("measure the GPU block's clocks with the SoC's frequency counter (gcc 0x162000.., gpucc 0x3d910fc, "
+	    "0x3d91100, 0x3d91568)");
+	hz = measure(GPUCC_DEBUG_CXO);
+	if (hz == MEASURE_FAILED) {
+		say("apollo gpu: %u: the counter did not finish: it cannot be used as it is set up here\n", step);
+		return false;
+	}
+	say("apollo gpu: %u: measured: cxo runs at %u Hz (the crystal: 19200000)\n", step, hz);
+	if (hz < 18600000 || hz > 19800000) {
+		say("apollo gpu: %u: the counter does not show the crystal's rate: nothing it says can be used\n", step);
+		return false;
+	}
+	for (unsigned i = 0; i < sizeof(clocks) / sizeof(clocks[0]); i++) {
+		hz = measure_quietly(clocks[i].select);
+		if (hz == MEASURE_FAILED) {
+			say("apollo gpu: %u: measured: %s: the counter did not finish\n", step, clocks[i].name);
+		} else {
+			say("apollo gpu: %u: measured: %s runs at %u Hz\n", step, clocks[i].name, hz);
+		}
+		if (clocks[i].select == GPUCC_DEBUG_AHB) {
+			ahb_hz = hz;
+		}
+	}
+	if (ahb_hz != MEASURE_FAILED && ahb_hz >= 1000000) {
+		say("apollo gpu: %u: THE REGISTER BUS OF THE GPU BLOCK HAS ITS CLOCK\n", step);
+		return true;
+	}
+	say("apollo gpu: %u: the register bus of the GPU block has no clock: its registers are not to be touched\n", step);
+	return false;
+}
+
+/*
+ * The clocks the device tree gives the GMU and the SMMU (gmu_clk, cxo_clk, gpu_cc_ahb, axi_clk,
+ * memnoc_clk; the SMMU's gcc_gpu_snoc_dvm_gfx), the GMU at the 200 MHz both the vendor's driver and
+ * Linux start it with: GPLL0's 300 MHz tap / 1.5, a PLL that runs anyway.
+ */
+static bool
+step_clocks(void)
+{
+	uint32_t gmu_clock;
+
+	if (!gpucc_answers()) {
+		return false;
+	}
+	if (!cx_is_on()) {
+		say("apollo gpu: %u: CX is off: step 4\n", step);
+		return false;
+	}
+	announce("in the global clock controller: GPLL0's taps for the GPU; the GPU's bus and memory clocks on");
+	change(&gcc, "pll votes", GCC_PLL_VOTE, rd(gcc.base + GCC_PLL_VOTE) | GCC_PLL_VOTE_GPU | GCC_PLL_VOTE_GPU_DIV);
+	if (!clock_on(&gcc, "gpu_memnoc_gfx", GCC_GPU_MEMNOC_GFX_CBCR, false) ||
+	    !clock_on(&gcc, "gpu_snoc_dvm_gfx", GCC_GPU_SNOC_DVM_GFX_CBCR, true) ||
+	    !clock_on(&gcc, "ddrss_gpu_axi", GCC_DDRSS_GPU_AXI_CBCR, false)) {
+		return false;
+	}
+
+	announce("in the GPU's clock controller: the GMU's clock to 200 MHz");
+	if (!clock_source("gmu_clk_src", GPUCC_GMU_RCGR, RCG_GPLL0_DIV(3))) {       /* 300 MHz / 1.5 */
+		return false;
+	}
+
+	announce("in the GPU's clock controller: the clocks of the GMU and of the SMMU on");
+	gmu_clock = get(&gpucc, "cx_gmu", GPUCC_CX_GMU_CBCR);
+	if ((gmu_clock & GPUCC_CX_GMU_WAKE_SLEEP) != GPUCC_CX_GMU_WAKE_SLEEP) {
+		change(&gpucc, "cx_gmu", GPUCC_CX_GMU_CBCR, gmu_clock | GPUCC_CX_GMU_WAKE_SLEEP);
+	}
+	if (!clock_on(&gpucc, "cxo", GPUCC_CXO_CBCR, true) ||
+	    !clock_on(&gpucc, "ahb", GPUCC_AHB_CBCR, false) ||
+	    !clock_on(&gpucc, "cx_snoc_dvm", GPUCC_CX_SNOC_DVM_CBCR, false) ||
+	    !clock_on(&gpucc, "cx_gmu", GPUCC_CX_GMU_CBCR, true) ||
+	    !clock_on(&gpucc, "smmu vote", GPUCC_SMMU_VOTE_CBCR, false)) {
+		return false;
+	}
+	return measure_clocks();
+}
+
+/* What every later step stands on: CX powered, the GMU's clock running, the register bus's clock measured running. */
+static bool
+cx_ready(void)
+{
+	uint32_t gmu_clock, ahb_hz;
+
+	if (!gpucc_answers()) {
+		return false;
+	}
+	gmu_clock = rd(gpucc.base + GPUCC_CX_GMU_CBCR);
+	if (!cx_is_on() || (gmu_clock & (CBCR_ENABLE | CBCR_OFF)) != CBCR_ENABLE) {
+		say("apollo gpu: %u: needs CX on (it is %s) and the GMU's clock running (cx_gmu %#x): steps 4 and 5\n", step,
+		    cx_is_on() ? "on" : "off", gmu_clock);
+		return false;
+	}
+	ahb_hz = measure_quietly(GPUCC_DEBUG_AHB);
+	if (ahb_hz == MEASURE_FAILED || ahb_hz < 1000000) {
+		say("apollo gpu: %u: the GPU block's register bus clock does not run (%u Hz): not touching it\n", step, ahb_hz);
+		return false;
+	}
+	return true;
+}
+
+/* ---- step 6: the first words from the GPU block ------------------------------------------------------- */
+
+/* dt: qcom,gmu@3d6a000 "kgsl_gmu_reg", 0x30000 long. Offsets in a6xx_gmu.xml are in words, from here. */
+static struct block gmu = { "gmu", 0x03d6a000, 0x30000 };
+#define GMU_WORD(n)             (4u * (n))
+#define GMU_DTCM_VERSIONS       GMU_WORD(0x1c00 + 0xff8) /* five words where loaded firmware carries its versions */
+#define GMU_CM3_SYSRESET        GMU_WORD(0x5000)        /* 1: the processor is held in reset */
+#define GMU_CM3_BOOT_CONFIG     GMU_WORD(0x5001)
+#define GMU_CM3_FW_INIT_RESULT  GMU_WORD(0x501c)
+#define GMU_CM3_CFG             GMU_WORD(0x502d)
+#define GMU_ALWAYS_ON_COUNTER_L GMU_WORD(0x5088)        /* counts the 19.2 MHz crystal */
+#define GMU_ALWAYS_ON_COUNTER_H GMU_WORD(0x5089)
+#define GMU_RPMH_POWER_STATE    GMU_WORD(0x50ec)
+#define GMU_HFI_CTRL_STATUS     GMU_WORD(0x5180)
+#define GMU_HFI_VERSION_INFO    GMU_WORD(0x5181)
+#define GMU_GENERAL_7           GMU_WORD(0x51cc)
+#define GMU_AO_HOST_INTERRUPT_STATUS GMU_WORD(0x9305)
+#define GMU_AO_GPU_CX_BUSY_STATUS GMU_WORD(0x930c)
+#define GMU_AHB_FENCE_STATUS    GMU_WORD(0x9313)
+
+/*
+ * The 3D core (dt: kgsl_3d0_reg_memory at 0x3d00000) is not to be touched without power, which the GMU
+ * gives it -- except its bus interface ("GBIF", words 0x3c00 on in a6xx.xml), which is in the CX half.
+ */
+static struct block gbif = { "gbif", 0x03d00000 + 4 * 0x3c00, 0x1000 };
+#define GBIF_SCACHE_CNTL0       (4 * 0x01)
+#define GBIF_SCACHE_CNTL1       (4 * 0x02)
+#define GBIF_HALT               (4 * 0x45)
+#define GBIF_HALT_ACK           (4 * 0x46)
+
+static bool
+step_first_words(void)
+{
+	uint64_t start, nanos;
+	uint32_t before, hz;
+
+	if (!cx_ready()) {
+		return false;
+	}
+	announce("read registers of the GMU (0x3d6a000): the first words from the GPU block itself");
+	get(&gmu, "cm3_sysreset", GMU_CM3_SYSRESET);
+	get(&gmu, "cm3_boot_config", GMU_CM3_BOOT_CONFIG);
+	get(&gmu, "cm3_fw_init_result", GMU_CM3_FW_INIT_RESULT);
+	get(&gmu, "cm3_cfg", GMU_CM3_CFG);
+	get(&gmu, "hfi_ctrl_status", GMU_HFI_CTRL_STATUS);
+	get(&gmu, "hfi_version_info", GMU_HFI_VERSION_INFO);
+	get(&gmu, "general_7", GMU_GENERAL_7);
+	get(&gmu, "rpmh_power_state", GMU_RPMH_POWER_STATE);
+	get(&gmu, "ao_host_interrupt_status", GMU_AO_HOST_INTERRUPT_STATUS);
+	get(&gmu, "ao_gpu_cx_busy_status", GMU_AO_GPU_CX_BUSY_STATUS);
+	get(&gmu, "ahb_fence_status", GMU_AHB_FENCE_STATUS);
+	get(&gmu, "always_on_counter_h", GMU_ALWAYS_ON_COUNTER_H);
+	get(&gmu, "always_on_counter_l", GMU_ALWAYS_ON_COUNTER_L);
+	start = mach_absolute_time();
+	before = rd(gmu.base + GMU_ALWAYS_ON_COUNTER_L);
+	sleep_ms(10);
+	hz = rd(gmu.base + GMU_ALWAYS_ON_COUNTER_L) - before;
+	absolutetime_to_nanoseconds(mach_absolute_time() - start, &nanos);
+	hz = nanos ? (uint32_t)((uint64_t)hz * NSEC_PER_SEC / nanos) : 0;
+	say("apollo gpu: %u: the GMU's counter counts at %u Hz: %s\n", step, hz, hz > 18000000 && hz < 20500000 ?
+	    "the 19.2 MHz crystal: THE GPU BLOCK IS ALIVE" : "not the crystal's 19.2 MHz (firmware may start it)");
+	for (uint32_t i = 0; i < 5; i++) {
+		get(&gmu, "dtcm, where firmware has its versions", GMU_DTCM_VERSIONS + 4 * i);
+	}
+
+	announce("read the GPU's bus interface (0x3d0f000)");
+	get(&gbif, "scache_cntl0", GBIF_SCACHE_CNTL0);
+	get(&gbif, "scache_cntl1", GBIF_SCACHE_CNTL1);
+	get(&gbif, "halt", GBIF_HALT);
+	get(&gbif, "halt_ack", GBIF_HALT_ACK);
+	return true;
+}
+
+/* ---- step 7: the GMU's channel to RPMh ----------------------------------------------------------------- */
+
+/*
+ * dt: qcom,kgsl-3d0 "rscc" at 0x3de0000 (the a650 family has it apart from the GMU's registers;
+ * Linux: a6xx_gmu.c, "rscc"): command slots through which the GMU's firmware raises the 3D core's
+ * rail. Offsets in words: a6xx_gmu.xml, domain A6XX_RSCC.
+ */
+static struct block rscc = { "rscc", 0x03de0000, 0x2000 };
+#define RSCC_RSC_STATUS0_DRV0   (4 * 0x004)
+#define RSCC_PDC_SLAVE_ID_DRV0  (4 * 0x00b)
+#define RSCC_SEQ_BUSY_DRV0      (4 * 0x101)
+#define RSCC_SEQ_MEM_0_DRV0     (4 * 0x180)
+#define RSCC_TCS0_DRV0_STATUS   (4 * 0x346)
+#define GMU_RSCC_CONTROL_ACK    GMU_WORD(0x9308)
+
+static bool
+step_rscc(void)
+{
+	if (!cx_ready()) {
+		return false;
+	}
+	announce("read the GMU's RPMh channel (0x3de0000)");
+	get(&rscc, "rsc_status0_drv0", RSCC_RSC_STATUS0_DRV0);
+	get(&rscc, "pdc_slave_id_drv0", RSCC_PDC_SLAVE_ID_DRV0);
+	get(&rscc, "seq_busy_drv0", RSCC_SEQ_BUSY_DRV0);
+	get(&rscc, "seq_mem_0_drv0", RSCC_SEQ_MEM_0_DRV0);
+	get(&rscc, "tcs0_drv0_status", RSCC_TCS0_DRV0_STATUS);
+	get(&gmu, "rscc_control_ack", GMU_RSCC_CONTROL_ACK);
+	return true;
+}
+
+/* ---- steps 8 and 9: the SMMU --------------------------------------------------------------------------- */
+
+/*
+ * dt: kgsl-smmu@3da0000 (qcom,qsmmu-v500: an Arm MMU-500), 0x10000 long, "qcom,skip-init": the
+ * vendor's driver leaves its stream table as it finds it. Its streams (dt: qcom,kgsl-iommu and
+ * qcom,gmu "iommus"): 0 the GPU (mask 0x401), 2 secure content, 4 and 5 the GMU (mask 0x400).
+ * Offsets: arm-smmu.h.
+ */
+static struct block smmu = { "smmu", 0x03da0000, 0x10000 };
+#define SMMU_SCR0               0x000
+#define SMMU_IDR0               0x020           /* [7:0] stream match registers */
+#define SMMU_IDR1               0x024           /* bit 31: 64K pages, [30:28] log2(pages)-1, [7:0] translation contexts */
+#define SMMU_IDR2               0x028
+#define SMMU_IDR7               0x03c
+#define SMMU_SGFSR              0x048
+#define SMMU_SMR(n)             (0x800 + 4 * (n))       /* bit 31 valid, [30:16] mask, [14:0] stream */
+#define SMMU_S2CR(n)            (0xc00 + 4 * (n))       /* [17:16] 0 translate 1 bypass 2 fault, [7:0] context */
+#define SMMU_CBAR(n)            (4 * (n))               /* in the second page; [17:16] kind of context */
+#define SMMU_CB_SCTLR           0x00            /* a context's own page: bit 0 = translation on */
+#define SMMU_CB_TTBR0           0x20
+#define SMMU_CB_TCR             0x30
+#define SMMU_CB_FSR             0x58
+
+static uint32_t smmu_page, smmu_pages, smmu_contexts, smmu_matches;
+
+/* The layout of the SMMU's register space from its ID registers; false if it is not what the device tree says. */
+static bool
+smmu_layout(void)
+{
+	uint32_t idr0 = get(&smmu, "idr0", SMMU_IDR0), idr1 = get(&smmu, "idr1", SMMU_IDR1);
+
+	smmu_page = idr1 >> 31 ? 0x10000 : 0x1000;
+	smmu_pages = 2u << (idr1 >> 28 & 7);
+	smmu_contexts = idr1 & 0xff;
+	smmu_matches = idr0 & 0xff;
+	say("apollo gpu: %u: SMMU: %u stream match registers, %u contexts, %u pages of %#x before the contexts' own\n", step,
+	    smmu_matches, smmu_contexts, smmu_pages, smmu_page);
+	if (2 * smmu_pages * smmu_page != smmu.size) {
+		say("apollo gpu: %u: that makes %#x of registers, the device tree says %#x: not reading further\n", step,
+		    2 * smmu_pages * smmu_page, smmu.size);
+		return false;
+	}
+	return true;
+}
+
+static bool
+step_smmu(void)
+{
+	if (!cx_ready()) {
+		return false;
+	}
+	announce("read the ID registers of the GPU's SMMU (0x3da0000): global registers, which the hypervisor answers for");
+	if (!smmu_layout()) {
+		return false;
+	}
+	get(&smmu, "idr2", SMMU_IDR2);
+	get(&smmu, "idr7", SMMU_IDR7);
+	get(&smmu, "scr0", SMMU_SCR0);
+	get(&smmu, "sgfsr", SMMU_SGFSR);
+
+	announce("read the SMMU's stream table and the kinds of its contexts, as the boot loader and hypervisor left them");
+	for (uint32_t i = 0; i < smmu_matches && i < 16; i++) {
+		get(&smmu, "smr", SMMU_SMR(i));
+		get(&smmu, "s2cr", SMMU_S2CR(i));
+	}
+	for (uint32_t i = 0; i < smmu_contexts && i < 16; i++) {
+		get(&smmu, "cbar", smmu_page + SMMU_CBAR(i));
+	}
+	return true;
+}
+
+/* only context 0, the one both the vendor's driver and Linux give the GPU itself (others may be TrustZone's) */
+static bool
+step_smmu_context(void)
+{
+	uint32_t context;
+
+	if (!cx_ready()) {
+		return false;
+	}
+	announce("read translation context 0 of the SMMU: registers of the hardware itself, not the hypervisor's");
+	if (!smmu_layout()) {
+		return false;
+	}
+	context = smmu_pages * smmu_page;
+	get(&smmu, "cb0 sctlr", context + SMMU_CB_SCTLR);
+	get(&smmu, "cb0 ttbr0, low", context + SMMU_CB_TTBR0);
+	get(&smmu, "cb0 ttbr0, high", context + SMMU_CB_TTBR0 + 4);
+	get(&smmu, "cb0 tcr", context + SMMU_CB_TCR);
+	get(&smmu, "cb0 fsr", context + SMMU_CB_FSR);
+	return true;
+}
+
+/* ---- step 10: the GMU's memory -------------------------------------------------------------------------- */
+
+/*
+ * Firmware is loaded by writing it through these registers into the processor's memory while it is held
+ * in reset (a6xx_gmu_fw_load). Two words of data memory (0x3d71000, a6xx_gmu.xml GMU_CM3_DTCM_START) go
+ * there and back, and what was there is put back.
+ */
+#define GMU_DTCM                GMU_WORD(0x1c00)
+
+static bool
+step_gmu_memory(void)
+{
+	static const uint32_t pattern[2] = { 0x600d0001, 0x0a110002 };
+	uint32_t was[2], back[2];
+
+	if (!cx_ready()) {
+		return false;
+	}
+	announce("hold the GMU's processor in reset, write two words into its data memory (0x3d71000), read them back");
+	if (get(&gmu, "cm3_fw_init_result", GMU_CM3_FW_INIT_RESULT) == 0xbabeface) {
+		say("apollo gpu: %u: firmware is running in the GMU: leaving its memory alone\n", step);
+		return false;
+	}
+	put(&gmu, "cm3_sysreset", GMU_CM3_SYSRESET, 1);
+	get(&gmu, "cm3_sysreset", GMU_CM3_SYSRESET);
+	for (int i = 0; i < 2; i++) {
+		was[i] = get(&gmu, "dtcm", GMU_DTCM + 4 * i);
+	}
+	for (int i = 0; i < 2; i++) {
+		put(&gmu, "dtcm", GMU_DTCM + 4 * i, pattern[i]);
+	}
+	for (int i = 0; i < 2; i++) {
+		back[i] = get(&gmu, "dtcm", GMU_DTCM + 4 * i);
+	}
+	for (int i = 0; i < 2; i++) {
+		put(&gmu, "dtcm", GMU_DTCM + 4 * i, was[i]);
+	}
+	say("apollo gpu: %u: the GMU's memory %s\n", step, back[0] == pattern[0] && back[1] == pattern[1] ?
+	    "TAKES WHAT IS WRITTEN: its firmware can be loaded" : "does not hold what was written");
+	return back[0] == pattern[0] && back[1] == pattern[1];
+}
+
+/* ---- step 11: TrustZone -------------------------------------------------------------------------------- */
+
+/*
+ * The 3D core comes out of reset in "secure" mode, and only TrustZone lets it out: it does when handed the
+ * vendor's signed zap shader (a6xx_gpu.c: a6xx_hw_init; qcom_scm.c: qcom_scm_pas_*; dt: qcom,kgsl-hyp,
+ * qcom,pas-id 13). Questions that pass no memory first: whether it listens, whether the calls that
+ * authenticate an image are there, and which images it says it "supports" -- the GPU's and, for
+ * comparison, the audio DSP's (1, which hakios.apollo_adsp.c has it start), the modem's (4) and video's (9).
+ * A call is an SMC, which the hypervisor passes on; convention: qcom_scm-smc.c.
+ */
+#define SCM_FAST                (1ull << 31)
+#define SCM_64                  (1ull << 30)
+#define SCM_SIP                 (2ull << 24)
+#define SCM_CALL(service, command) ((uint64_t)(service) << 8 | (command))
+#define SCM_IS_CALL_AVAILABLE   SCM_CALL(6, 1)
+#define SCM_PAS_INIT_IMAGE      SCM_CALL(2, 1)
+#define SCM_PAS_AUTH_AND_RESET  SCM_CALL(2, 5)
+#define SCM_PAS_IS_SUPPORTED    SCM_CALL(2, 7)
+#define SCM_ONE_VALUE           1
+#define SCM_VALUE_AND_BUFFER    (2 | 2 << 6)    /* a number, and the address of memory it may read and write */
+#define SCM_INTERRUPTED         1
+#define PAS_GPU                 13
+
+static int32_t
+scm(const char *what, uint64_t function, uint64_t arguments, uint64_t first, uint64_t second, uint64_t third,
+    uint64_t *answer)
+{
+	uint64_t session = 0;
+
+	say("apollo gpu: %u: about to ask TrustZone %s: smc %#llx, arguments %#llx, %#llx, %#llx\n", step, what, function,
+	    first, second, third);
+	hold();
+	for (int i = 0; i < 100; i++) {
+		register uint64_t x0 __asm__("x0") = i == 0 ? function : SCM_INTERRUPTED;
+		register uint64_t x1 __asm__("x1") = arguments;
+		register uint64_t x2 __asm__("x2") = first;
+		register uint64_t x3 __asm__("x3") = second;
+		register uint64_t x4 __asm__("x4") = third;
+		register uint64_t x5 __asm__("x5") = 0;
+		register uint64_t x6 __asm__("x6") = session;
+		register uint64_t x7 __asm__("x7") = 0;
+
+		__asm__ volatile ("smc #0" : "+r" (x0), "+r" (x1), "+r" (x2), "+r" (x3), "+r" (x4), "+r" (x5), "+r" (x6),
+		    "+r" (x7) : : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+		session = x6;
+		if (x0 != SCM_INTERRUPTED) {
+			say("apollo gpu: %u: TrustZone returns %d, answer %#llx\n", step, (int32_t)x0, x1);
+			*answer = x1;
+			return (int32_t)x0;
+		}
+	}
+	say("apollo gpu: %u: TrustZone keeps saying the call was interrupted\n", step);
+	return -1;
+}
+
+static bool
+step_trustzone(void)
+{
+	static const struct {
+		const char *name;
+		uint32_t id;
+	} images[] = { { "audio", 1 }, { "modem", 4 }, { "video", 9 }, { "GPU zap shader", PAS_GPU } };
+	uint64_t answer = 0, how = SCM_FAST | SCM_64 | SCM_SIP;
+	uint32_t fast[4] = { 0 }, slow[4] = { 0 };
+
+	announce("ask TrustZone what Linux asks it first: is the call \"is this call available\" available");
+	if (scm("whether it can be asked", how | SCM_IS_CALL_AVAILABLE, SCM_ONE_VALUE, SCM_SIP | SCM_IS_CALL_AVAILABLE, 0,
+	    0, &answer) != 0 || answer != 1) {
+		how = SCM_FAST | SCM_SIP;
+		if (scm("the same, the 32-bit way", how | SCM_IS_CALL_AVAILABLE, SCM_ONE_VALUE, SCM_SIP | SCM_IS_CALL_AVAILABLE,
+		    0, 0, &answer) != 0 || answer != 1) {
+			say("apollo gpu: %u: TrustZone does not answer the way it answers Linux\n", step);
+			return false;
+		}
+	}
+
+	announce("ask TrustZone whether it has the calls that authenticate a firmware image");
+	scm("for the call that takes an image's signature", how | SCM_IS_CALL_AVAILABLE, SCM_ONE_VALUE,
+	    SCM_SIP | SCM_PAS_INIT_IMAGE, 0, 0, &answer);
+	scm("for the call that authenticates and starts an image", how | SCM_IS_CALL_AVAILABLE, SCM_ONE_VALUE,
+	    SCM_SIP | SCM_PAS_AUTH_AND_RESET, 0, 0, &answer);
+
+	announce("ask TrustZone which images it \"supports\", each both ways: at once, and as a call that may be preempted");
+	for (unsigned i = 0; i < 4; i++) {
+		answer = 0;
+		fast[i] = scm(images[i].name, how | SCM_PAS_IS_SUPPORTED, SCM_ONE_VALUE, images[i].id, 0, 0, &answer) == 0 && answer;
+		answer = 0;
+		slow[i] = scm(images[i].name, (how & ~SCM_FAST) | SCM_PAS_IS_SUPPORTED, SCM_ONE_VALUE, images[i].id, 0,
+		    0, &answer) == 0 && answer;
+	}
+	say("apollo gpu: %u: \"supported\", asked at once / as Linux asks: audio %u/%u, modem %u/%u, video %u/%u, GPU %u/%u\n",
+	    step, fast[0], slow[0], fast[1], slow[1], fast[2], slow[2], fast[3], slow[3]);
+	say("apollo gpu: %u: %s\n", step, fast[3] || slow[3] ? "TrustZone lists the GPU's zap shader" :
+	    "TrustZone does not list the GPU's: step 12 shows whether that matters");
+	return true;
+}
+
+/* ---- step 12: the zap shader's signature ----------------------------------------------------------------- */
+
+static void
+to_memory(vm_offset_t start, vm_size_t size)
+{
+	for (vm_offset_t line = start & ~(vm_offset_t)63; line < start + size; line += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (line));
+	}
+	__asm__ volatile ("dsb sy");
+}
+
+/* a file of the small image that travels with the kernel (userland/build.sh puts ../fw-gpu-apollo into its fw/) */
+extern const uint8_t *hakios_image_file(const char *dir, const char *name, uint64_t *size, int *disk_out);
+
+static const uint8_t *
+image_file(const char *name, uint64_t *size)
+{
+	int disk = -1;
+	const uint8_t *data = hakios_image_file("fw", name, size, &disk);      /* (hakios.image.c, shared) */
+
+	if (data != NULL) {
+		say("apollo gpu: %u: fw/%s: %llu bytes in the image of /dev/md%d\n", step, name, *size, disk);
+	} else {
+		say("apollo gpu: %u: no fw/%s in the small image: put the phone's /vendor/firmware/%s into fw-gpu-apollo/ and "
+		    "rebuild the images\n", step, name, name);
+	}
+	return data;
+}
+
+/*
+ * The first of the three calls with which Linux has a zap shader loaded (mdt_loader.c: qcom_mdt_pas_init;
+ * qcom_scm.c: qcom_scm_pas_init_image): TrustZone is given the image's header -- the ELF header and the
+ * block of hashes and certificates, all of a650_zap.mdt -- and checks the signature. Nothing of the GPU is
+ * involved. The header goes in a page of ours that is not touched again, and never freed: TrustZone
+ * protects it while it works.
+ */
+static bool
+zap_header(uint64_t *phys)
+{
+	const uint8_t *header;
+	vm_offset_t page = 0;
+	uint64_t size = 0;
+	uint32_t segments, hashes;
+
+	header = image_file("a650_zap.mdt", &size);
+	if (header == NULL) {
+		return false;
+	}
+	/* a 32-bit ELF: the count of segments at 44, the table of them at 52, 32 bytes each, the file size of one at +16 */
+	segments = size >= 52 + 2 * 32 ? header[44] | header[45] << 8 : 0;
+	if (memcmp(header, "\177ELF\1", 5) != 0 || segments < 2 || size > PAGE_SIZE) {
+		say("apollo gpu: %u: that is not such a header (%02x %02x %02x %02x, %u segments)\n", step, header[0], header[1],
+		    header[2], header[3], segments);
+		return false;
+	}
+	memcpy(&hashes, header + 52 + 32 + 16, sizeof(hashes));
+	say("apollo gpu: %u: an ELF header of %u segments, %u bytes with its table, then %llu bytes; by the table, %u of hashes\n",
+	    step, segments, 52 + 32 * segments, size - (52 + 32 * segments), hashes);
+	if (52 + 32 * segments + (uint64_t)hashes != size) {
+		say("apollo gpu: %u: the file is not the header followed by the hashes alone: not what TrustZone takes\n", step);
+		return false;
+	}
+	if (kmem_alloc(kernel_map, &page, PAGE_SIZE, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		say("apollo gpu: %u: no memory\n", step);
+		return false;
+	}
+	memcpy((void *)page, header, size);
+	to_memory(page, PAGE_SIZE);
+	*phys = kvtophys(page);
+	return true;
+}
+
+static bool
+step_zap_signature(void)
+{
+	uint64_t header = 0, answer = ~0ull;
+	int32_t result;
+
+	announce("find the zap shader's header, fw/a650_zap.mdt, in the small image that came with the kernel");
+	if (!zap_header(&header)) {
+		return false;
+	}
+	announce("hand the header to TrustZone to check its signature (image 13); a call that may be preempted, as Linux's is");
+	result = scm("to take the zap shader's signature", SCM_64 | SCM_SIP | SCM_PAS_INIT_IMAGE, SCM_VALUE_AND_BUFFER, PAS_GPU,
+	    header, 0, &answer);
+	if (result == 0 && answer == 0) {
+		say("apollo gpu: %u: TRUSTZONE ACCEPTS THE ZAP SHADER'S SIGNATURE FROM THIS KERNEL\n", step);
+		return true;
+	}
+	say("apollo gpu: %u: TrustZone does not take it: the call returns %d, its answer is %#llx\n", step, result, answer);
+	return false;
+}
+
+/* ---- memory the GPU block reaches ------------------------------------------------------------------- */
+
+/*
+ * Whatever in the GPU block reads or writes memory -- the GMU's processor, later the 3D core -- does it
+ * through the SMMU, walking page tables of ours: three levels of 4K pages, 39 bits of address (dt:
+ * qcom,use-3-lvl-tables). Formats and the order of programming: Linux io-pgtable-arm.c and arm-smmu.c
+ * (as hakios.adreno.c has them).
+ */
+#define PTE_TABLE               3ull
+#define PTE_PAGE                3ull
+#define PTE_SHARED              (2ull << 8)
+#define PTE_ACCESSED            (1ull << 10)
+#define PTE_NOT_GLOBAL          (1ull << 11)
+#define PTE_ADDRESS             0x0000fffffffff000ull
+#define PTE_GMU                 (PTE_SHARED | PTE_ACCESSED | PTE_NOT_GLOBAL)
+
+#define SMMU_S2CR_FAULT         (2u << 16)
+#define SMMU_SMR_VALID          (1u << 31)
+#define SMMU_CBAR_STAGE_1       (1u << 16 | 3u << 8 | 0xfu << 12)       /* our tables alone decide; weakest defaults */
+#define SMMU_CBA2R(n)           (0x800 + 4 * (n))                       /* in the second page, like CBAR */
+#define SMMU_CBA2R_64_BIT       1
+#define SMMU_CB_TCR2            0x10
+#define SMMU_CB_TTBR1           0x28
+#define SMMU_CB_MAIR0           0x38
+#define SMMU_CB_MAIR1           0x3c
+#define SMMU_CB_FAR             0x60
+#define SMMU_CB_FSYNR0          0x68
+#define SMMU_CB_TLBIASID        0x610
+#define SMMU_CB_TLBSYNC         0x7f0
+#define SMMU_CB_TLBSTATUS       0x7f4
+#define SMMU_SCTLR_ON           (1u << 0 | 1u << 1 | 1u << 2 | 1u << 5 | 1u << 12) /* on; faults recorded, no interrupt */
+#define SMMU_TCR_39_BITS        (25u | 1u << 8 | 1u << 10 | 3u << 12 | 1u << 23)   /* one table of 4K pages, cached walks */
+#define SMMU_TCR2               (1u | 1u << 4 | 7u << 15)       /* 36 bits of physical address, 16 of context tag */
+#define SMMU_MAIR0              0xf404ff44      /* Linux's: 0 uncached, 1 cached, 2 device */
+#define SMMU_FSR_ALL            0xc00001fe
+
+/*
+ * Every table of a space, of any level: enough for the whole of the first 4 GB, which is where the 3D core's
+ * addresses are (the steps' below GPU_ADDRESSES_START, the clients' from there up to 4 GB: checked below,
+ * where those are): 2048 tables of the last level (2 MB each), 4 above them and the root.
+ */
+#define SPACE_TABLES            2056
+
+struct gpu_space {
+	const char *name;
+	uint32_t context;               /* which of the SMMU's */
+	uint32_t mask;                  /* dt: the second cell of its stream's "iommus" */
+	uint32_t control;               /* bits of its control register besides the usual */
+	uint32_t table_count;
+	uint64_t *root;
+	struct {
+		uint64_t phys;
+		uint64_t *table;
+		bool changed;           /* since it was last written out of this processor's cache (space_commit()) */
+	} tables[SPACE_TABLES];
+	uint64_t *last_entry, *last_table;      /* the level 2 entry looked up last, and its table */
+	uint32_t last_changed;                  /* the table an entry was written in last */
+};
+
+static uint64_t *
+space_new_table(struct gpu_space *space)
+{
+	static vm_offset_t spare;
+	static unsigned spare_left;
+	uint64_t *table;
+
+	if (space->table_count == SPACE_TABLES) {
+		return NULL;
+	}
+	if (spare_left == 0) {
+		if (kmem_alloc(kernel_map, &spare, PAGE_SIZE, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) !=
+		    KERN_SUCCESS) {
+			return NULL;
+		}
+		spare_left = PAGE_SIZE / 4096;
+	}
+	table = (uint64_t *)(spare + PAGE_SIZE - 4096 * spare_left--);
+	space->tables[space->table_count].phys = kvtophys((vm_offset_t)table);
+	space->tables[space->table_count++].table = table;
+	return table;
+}
+
+/* An entry of one of the tables has been written: that table is to go out to memory. */
+static void
+space_changed(struct gpu_space *space, const uint64_t *entry)
+{
+	if ((uintptr_t)entry - (uintptr_t)space->tables[space->last_changed].table < 4096) {
+		space->tables[space->last_changed].changed = true;      /* page after page of one buffer */
+		return;
+	}
+	for (uint32_t i = space->table_count; i-- > 0;) {
+		if ((uintptr_t)entry - (uintptr_t)space->tables[i].table < 4096) {
+			space->tables[i].changed = true;
+			space->last_changed = i;
+			return;
+		}
+	}
+}
+
+/* the SMMU reads the tables from memory, not from this processor's cache */
+static void
+space_commit(struct gpu_space *space)
+{
+	for (uint32_t i = 0; i < space->table_count; i++) {
+		if (space->tables[i].changed) {
+			to_memory((vm_offset_t)space->tables[i].table, 4096);
+			space->tables[i].changed = false;
+		}
+	}
+}
+
+/* the table an entry of a higher table leads to; made if the entry is empty */
+static uint64_t *
+space_next(struct gpu_space *space, uint64_t *entry)
+{
+	uint64_t *table;
+
+	if (*entry & 1) {
+		for (uint32_t i = 0; i < space->table_count; i++) {
+			if (space->tables[i].phys == (*entry & PTE_ADDRESS)) {
+				return space->tables[i].table;
+			}
+		}
+		return NULL;
+	}
+	table = space_new_table(space);
+	if (table != NULL) {
+		*entry = kvtophys((vm_offset_t)table) | PTE_TABLE;
+		space_changed(space, entry);
+	}
+	return table;
+}
+
+/* one 4K page (the tables go out to memory when the context is given them: space_on(), later space_commit());
+ * no physical address and no attributes: the page is taken out again */
+static bool
+space_map(struct gpu_space *space, uint64_t address, uint64_t phys, uint64_t attributes)
+{
+	uint64_t *level2, *level3;
+
+	if (address >> 39 || (space->root == NULL && (space->root = space_new_table(space)) == NULL)) {
+		return false;
+	}
+	level2 = space_next(space, &space->root[address >> 30 & 0x1ff]);
+	if (level2 == NULL) {
+		return false;
+	}
+	if (space->last_entry == &level2[address >> 21 & 0x1ff]) {
+		level3 = space->last_table;             /* page after page of one buffer: the same table */
+	} else {
+		level3 = space_next(space, &level2[address >> 21 & 0x1ff]);
+		space->last_entry = &level2[address >> 21 & 0x1ff];
+		space->last_table = level3;
+	}
+	if (level3 == NULL) {
+		space->last_entry = NULL;
+		return false;
+	}
+	level3[address >> 12 & 0x1ff] = phys == 0 && attributes == 0 ? 0 : phys | attributes | PTE_PAGE;
+	space_changed(space, level3);
+	return true;
+}
+
+/* Memory of ours that the GPU block sees at an address of its own. */
+struct gpu_block {
+	uint64_t address;               /* the GPU's */
+	uint32_t size;
+	vm_offset_t memory;             /* ours */
+};
+
+static bool
+block_new(struct gpu_space *space, struct gpu_block *block, uint64_t address, uint32_t size, uint64_t attributes)
+{
+	block->address = address;
+	block->size = (size + 4095) & ~4095u;
+	if (kmem_alloc(kernel_map, &block->memory, round_page(block->size), KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+	    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return false;
+	}
+	for (uint32_t offset = 0; offset < block->size; offset += 4096) {
+		if (!space_map(space, address + offset, kvtophys(block->memory + offset), attributes)) {
+			return false;
+		}
+	}
+	to_memory(block->memory, block->size);
+	say("apollo gpu: %u: %s sees %#llx..%#llx in memory of ours (%#llx)\n", step, space->name, address,
+	    address + block->size - 1, kvtophys(block->memory));
+	return true;
+}
+
+/* a second view of a block without this processor's cache in between (blocks in one piece only) */
+static vm_offset_t
+block_uncached(const struct gpu_block *block)
+{
+	uint64_t phys = kvtophys(block->memory);
+
+	for (uint32_t offset = 0; offset < block->size; offset += 4096) {
+		if (kvtophys(block->memory + offset) != phys + offset) {
+			return 0;
+		}
+	}
+	return ml_io_map_wcomb(phys, block->size);
+}
+
+static uint32_t
+smmu_context(const struct gpu_space *space)
+{
+	return (smmu_pages + space->context) * smmu_page;
+}
+
+/* what a context has recorded of a request it could not serve */
+static bool
+space_faulted(const struct gpu_space *space)
+{
+	uint32_t context = smmu_context(space), status = rd(smmu.base + context + SMMU_CB_FSR);
+
+	if ((status & SMMU_FSR_ALL) == 0) {
+		return false;
+	}
+	say("apollo gpu: %u: THE SMMU REFUSED %s: status %#x, address %#llx, syndrome %#x\n", step, space->name, status,
+	    (uint64_t)rd(smmu.base + context + SMMU_CB_FAR + 4) << 32 | rd(smmu.base + context + SMMU_CB_FAR),
+	    rd(smmu.base + context + SMMU_CB_FSYNR0));
+	return true;
+}
+
+/* give a context our tables and send a stream through it; `match` is the entry of the stream table to use */
+static bool
+space_on(struct gpu_space *space, uint32_t match, uint32_t stream)
+{
+	uint32_t context = smmu_context(space), smr = SMMU_SMR_VALID | space->mask << 16 | stream;
+	uint64_t root = space->tables[0].phys | (uint64_t)space->context << 48;        /* tagged with the context's number */
+
+	for (uint32_t i = 0; i < space->table_count; i++) {
+		to_memory((vm_offset_t)space->tables[i].table, 4096);
+	}
+	put(&smmu, "cb sctlr", context + SMMU_CB_SCTLR, 0);
+	put(&smmu, "cba2r", smmu_page + SMMU_CBA2R(space->context), SMMU_CBA2R_64_BIT);
+	put(&smmu, "cbar", smmu_page + SMMU_CBAR(space->context), SMMU_CBAR_STAGE_1);
+	put(&smmu, "cb tcr2", context + SMMU_CB_TCR2, SMMU_TCR2);
+	put(&smmu, "cb tcr", context + SMMU_CB_TCR, SMMU_TCR_39_BITS);
+	put(&smmu, "cb ttbr0, low", context + SMMU_CB_TTBR0, (uint32_t)root);
+	put(&smmu, "cb ttbr0, high", context + SMMU_CB_TTBR0 + 4, (uint32_t)(root >> 32));
+	put(&smmu, "cb ttbr1, low", context + SMMU_CB_TTBR1, 0);
+	put(&smmu, "cb ttbr1, high", context + SMMU_CB_TTBR1 + 4, 0);
+	put(&smmu, "cb mair0", context + SMMU_CB_MAIR0, SMMU_MAIR0);
+	put(&smmu, "cb mair1", context + SMMU_CB_MAIR1, 0);
+	put(&smmu, "cb fsr", context + SMMU_CB_FSR, SMMU_FSR_ALL);
+	put(&smmu, "cb tlbiasid", context + SMMU_CB_TLBIASID, space->context);
+	put(&smmu, "cb tlbsync", context + SMMU_CB_TLBSYNC, 1);
+	if (!wait_for(&smmu, context + SMMU_CB_TLBSTATUS, 1, 0, 100)) {
+		say("apollo gpu: %u: the SMMU does not finish forgetting old translations (%#x)\n", step,
+		    rd(smmu.base + context + SMMU_CB_TLBSTATUS));
+		return false;
+	}
+	put(&smmu, "cb sctlr", context + SMMU_CB_SCTLR, SMMU_SCTLR_ON | space->control);
+	put(&smmu, "s2cr", SMMU_S2CR(match), space->context);
+	put(&smmu, "smr", SMMU_SMR(match), smr);
+
+	/* the global ones are the hypervisor's to grant: see what it made of them */
+	if (get(&smmu, "smr", SMMU_SMR(match)) != smr ||
+	    (get(&smmu, "s2cr", SMMU_S2CR(match)) & 0x300ff) != space->context ||
+	    (get(&smmu, "cbar", smmu_page + SMMU_CBAR(space->context)) & 0x30000) != (SMMU_CBAR_STAGE_1 & 0x30000) ||
+	    !(get(&smmu, "cb sctlr", context + SMMU_CB_SCTLR) & 1) ||
+	    get(&smmu, "cb ttbr0, low", context + SMMU_CB_TTBR0) != (uint32_t)root ||
+	    get(&smmu, "cb ttbr0, high", context + SMMU_CB_TTBR0 + 4) != (uint32_t)(root >> 32)) {
+		say("apollo gpu: %u: the SMMU did not take what was written: stream %u is not going through context %u\n", step,
+		    stream, space->context);
+		return false;
+	}
+	get(&smmu, "cb tcr", context + SMMU_CB_TCR);
+	get(&smmu, "cba2r", smmu_page + SMMU_CBA2R(space->context));
+	get(&smmu, "cb fsr", context + SMMU_CB_FSR);
+	get(&smmu, "sgfsr", SMMU_SGFSR);
+	return true;
+}
+
+/* a stream goes nowhere again, and its context translates nothing */
+static void
+space_off(struct gpu_space *space, uint32_t match)
+{
+	put(&smmu, "smr", SMMU_SMR(match), 0);
+	put(&smmu, "s2cr", SMMU_S2CR(match), SMMU_S2CR_FAULT);
+	put(&smmu, "cb sctlr", smmu_context(space) + SMMU_CB_SCTLR, 0);
+}
+
+/* ---- step 13: memory for the GMU ------------------------------------------------------------------------ */
+
+/*
+ * The GMU is a Cortex-M3 with 16K of code memory and 16K of data memory of its own (step 10); the rest
+ * of its firmware and everything it shares with us it reaches through the SMMU, at addresses the
+ * firmware file names: a file of blocks, each "this goes at address A" or, with no data, "I need N
+ * bytes at address A" (a6xx_gmu.c: a6xx_gmu_fw_load). a650_gmu.bin asks for 0x8000 at 0x4000, 0x13000
+ * at 0x144000, 0x9000 at 0x157000 and a page at 0x60000000. Besides those: 16K for the firmware's log,
+ * and a page for the table and queues of the message protocol ("HFI").
+ */
+#define GMU_ITCM_ADDRESS        0x00000000u
+#define GMU_DTCM_ADDRESS        0x10004000u     /* a6xx_gmu_fw_load: the 650 family's */
+#define GMU_TCM_SIZE            0x4000u
+#define GMU_LOG_ADDRESS         0x60002000u
+#define GMU_LOG_SIZE            0x4000u
+#define GMU_HFI_ADDRESS         0x60006000u
+#define GMU_STREAM              5               /* dt: qcom,gmu gmu_kernel, iommus <5 0x400> */
+#define GMU_MATCH               1               /* entry of the stream table; 0 is kept for the 3D core */
+
+struct gmu_firmware_block {
+	uint32_t address, size, type, value;
+};
+#define GMU_FIRMWARE_NEEDS      1               /* types of blocks without data: memory wanted, value = bytes */
+#define GMU_FIRMWARE_NEEDS_KEPT 7
+
+static struct gpu_space gmu_space = { .name = "the GMU", .context = 1, .mask = 0x400 };
+static struct gpu_block gmu_blocks[12], gmu_log, gmu_hfi;
+static unsigned gmu_block_count;
+static const uint8_t *gmu_firmware;
+static uint64_t gmu_firmware_size;
+static bool gmu_space_is_on, gmu_runs, gmu_talks, rsc_awake;
+
+static bool
+in_tcm(uint32_t address)
+{
+	return address - GMU_ITCM_ADDRESS < GMU_TCM_SIZE || address - GMU_DTCM_ADDRESS < GMU_TCM_SIZE;
+}
+
+static bool
+step_gmu_space(void)
+{
+	if (!cx_ready()) {
+		return false;
+	}
+	announce("find the GMU's firmware, fw/a650_gmu.bin, in the small image, and make the memory it asks for");
+	gmu_firmware = image_file("a650_gmu.bin", &gmu_firmware_size);
+	if (gmu_firmware == NULL) {
+		return false;
+	}
+	for (uint64_t at = 0; at + sizeof(struct gmu_firmware_block) <= gmu_firmware_size;) {
+		struct gmu_firmware_block block;
+
+		memcpy(&block, gmu_firmware + at, sizeof(block));
+		at += sizeof(block) + block.size;
+		if (at > gmu_firmware_size) {
+			say("apollo gpu: %u: the file ends inside a block\n", step);
+			return false;
+		}
+		if (block.size != 0 || (block.type != GMU_FIRMWARE_NEEDS && block.type != GMU_FIRMWARE_NEEDS_KEPT) ||
+		    in_tcm(block.address)) {
+			continue;
+		}
+		if (gmu_block_count == sizeof(gmu_blocks) / sizeof(gmu_blocks[0]) || (block.address & 4095) ||
+		    block.value > 0x100000 || !block_new(&gmu_space, &gmu_blocks[gmu_block_count++], block.address, block.value,
+		    PTE_GMU)) {
+			say("apollo gpu: %u: cannot make %#x bytes at %#x for the firmware\n", step, block.value, block.address);
+			return false;
+		}
+	}
+	if (!block_new(&gmu_space, &gmu_log, GMU_LOG_ADDRESS, GMU_LOG_SIZE, PTE_GMU) ||
+	    !block_new(&gmu_space, &gmu_hfi, GMU_HFI_ADDRESS, PAGE_SIZE, PTE_GMU)) {
+		return false;
+	}
+
+	announce("give the SMMU's context 1 these tables and send the GMU's requests (stream 5) through it: the first "
+	    "writes to the SMMU, the global ones (cbar, cba2r, s2cr, smr) through the hypervisor");
+	if (!smmu_layout()) {
+		return false;
+	}
+	gmu_space_is_on = true;         /* whatever of it has been written by the time something fails is taken back */
+	return space_on(&gmu_space, GMU_MATCH, GMU_STREAM);
+}
+
+/* ---- step 14: the GMU's firmware ----------------------------------------------------------------------- */
+
+#define GMU_ITCM                GMU_WORD(0x0c00)
+
+static bool
+step_gmu_firmware(void)
+{
+	uint32_t wrong = 0;
+
+	if (!cx_ready() || gmu_firmware == NULL) {
+		return false;
+	}
+	announce("load the GMU's firmware: its code and data memory through the GMU's registers (0x3d6d000, 0x3d71000), "
+	    "the rest into the memory just made");
+	put(&gmu, "cm3_sysreset", GMU_CM3_SYSRESET, 1);
+	for (int pass = 0; pass < 2; pass++) {
+		for (uint64_t at = 0; at + sizeof(struct gmu_firmware_block) <= gmu_firmware_size;) {
+			struct gmu_firmware_block block;
+			const uint8_t *data = gmu_firmware + at + sizeof(block);
+
+			memcpy(&block, gmu_firmware + at, sizeof(block));
+			at += sizeof(block) + block.size;
+			if (block.size == 0) {
+				continue;
+			}
+			/* (ends worked out in 64 bits: a block's address and size are the file's to say, and must not wrap) */
+			if (in_tcm(block.address) && (uint64_t)block.address + block.size - 1 <= 0xffffffffull &&
+			    in_tcm(block.address + block.size - 1) &&
+			    (block.address < GMU_DTCM_ADDRESS) == (block.address + block.size - 1 < GMU_DTCM_ADDRESS)) {
+				uint32_t registers = block.address < GMU_DTCM_ADDRESS ? GMU_ITCM + block.address - GMU_ITCM_ADDRESS :
+				    GMU_DTCM + block.address - GMU_DTCM_ADDRESS;
+
+				for (uint32_t offset = 0; offset + 4 <= block.size; offset += 4) {
+					uint32_t word;
+
+					memcpy(&word, data + offset, sizeof(word));
+					if (pass == 0) {
+						wr(gmu.base + registers + offset, word);
+					} else if (rd(gmu.base + registers + offset) != word) {
+						wrong++;
+					}
+				}
+				if (pass == 1) {
+					say("apollo gpu: %u: %#x bytes at the GMU's %#x, through its registers\n", step, block.size,
+					    block.address);
+				}
+				continue;
+			}
+			for (unsigned i = 0; pass == 0 && i <= gmu_block_count; i++) {
+				if (i == gmu_block_count) {
+					say("apollo gpu: %u: the firmware has %#x bytes for %#x, where it asked for no memory\n", step,
+					    block.size, block.address);
+					return false;
+				}
+				if (block.address >= gmu_blocks[i].address &&
+				    (uint64_t)block.address + block.size <= gmu_blocks[i].address + gmu_blocks[i].size) {
+					memcpy((void *)(gmu_blocks[i].memory + (block.address - gmu_blocks[i].address)), data, block.size);
+					to_memory(gmu_blocks[i].memory, gmu_blocks[i].size);
+					say("apollo gpu: %u: %#x bytes at the GMU's %#x, in memory\n", step, block.size, block.address);
+					break;
+				}
+			}
+		}
+	}
+	if (wrong) {
+		say("apollo gpu: %u: %u words of the GMU's own memory do not read back as written\n", step, wrong);
+		return false;
+	}
+	say("apollo gpu: %u: THE GMU'S FIRMWARE IS LOADED; its versions, read back from the GMU: core %#x, power %#x, HFI %#x\n",
+	    step, rd(gmu.base + GMU_DTCM_VERSIONS), rd(gmu.base + GMU_DTCM_VERSIONS + 8), rd(gmu.base + GMU_DTCM_VERSIONS + 16));
+	return true;
+}
+
+/* ---- step 15: start the GMU ---------------------------------------------------------------------------- */
+
+#define GMU_ICACHE_CONFIG       GMU_WORD(0x4c00)
+#define GMU_DCACHE_CONFIG       GMU_WORD(0x4c01)
+#define GMU_SYS_BUS_CONFIG      GMU_WORD(0x4c0f)
+#define GMU_PWR_COL_INTER_FRAME_CTRL GMU_WORD(0x50c0)
+#define GMU_RPMH_CTRL           GMU_WORD(0x50e8)
+#define GMU_RPMH_CTRL_ALL       0xf11           /* the RPMh interface, and every vote the firmware may cast */
+#define GMU_CX_FAL_INTF         GMU_WORD(0x50f0)
+#define GMU_CX_FALNEXT_INTF     GMU_WORD(0x50f1)
+#define GMU_PWR_COL_CP_MSG      GMU_WORD(0x5100)        /* at start: where the log is, and its pages - 1 */
+#define GMU_PWR_COL_CP_RESP     GMU_WORD(0x5101)        /* ... and how far it was written before */
+#define GMU_HFI_SFR_ADDR        GMU_WORD(0x5182)        /* at start: which GPU this is */
+#define GMU_HFI_QTBL_INFO       GMU_WORD(0x5184)
+#define GMU_HFI_QTBL_ADDR       GMU_WORD(0x5185)
+#define GMU_HFI_CTRL_INIT       GMU_WORD(0x5186)
+#define GMU_GMU2HOST_INTR_CLR   GMU_WORD(0x5191)
+#define GMU_GMU2HOST_INTR_INFO  GMU_WORD(0x5192)
+#define GMU_RSCC_CONTROL_REQ    GMU_WORD(0x9307)
+#define GMU_AHB_FENCE_RANGE_0   GMU_WORD(0x9311)
+#define GMU_AHB_FENCE           (1u << 31 | 0xau << 18 | 0xa0)  /* a6xx_gmu_fw_start, for the a6xx parts */
+#define GMU_CHIP                0x06050200      /* dt qcom,chipid 0x06050002 the way a6xx_gmu_fw_start encodes it */
+#define GMU_OLD_FIRMWARE        0x20010004      /* a core version up to this says 0xbabeface when it has started */
+#define GMU_STARTED_MASK        0x1ff           /* ... a newer one says 0x100 in these bits */
+#define GMU_STARTED             0x100
+#define GMU_FAILED              0xe00
+#define GBIF_QSB_SIDE0          (4 * 0x03)      /* a6xx_catalog.c a640_gbif, the a650's: written before the GMU starts */
+#define RSCC_ASLEEP             (1u << 16)      /* of rsc_status0: handed over to the always-on sequencer */
+
+/* The table at the head of the HFI page and the three queues after it, as the vendor's driver lays them out. */
+struct hfi_queue {
+	uint32_t status, start, type, words, message_words, unused[5], read, write;
+};
+struct hfi_table {
+	uint32_t version, words, first_queue, queue_words, queues, active_queues;
+	struct hfi_queue queue[17];
+};
+#define HFI_QUEUES              3               /* 0: ours to the GMU; 1: its answers; 2: its debugging messages */
+#define HFI_QUEUE_WORDS         1024
+#define HFI_QUEUE_AT(n)         (((uint32_t)sizeof(struct hfi_table) + 15) / 16 * 16 + 4096 * (n))
+
+static volatile struct hfi_table *hfi;  /* the uncached view */
+
+static void
+rscc_show(void)
+{
+	get(&rscc, "rsc_status0_drv0", RSCC_RSC_STATUS0_DRV0);
+	get(&rscc, "seq_busy_drv0", RSCC_SEQ_BUSY_DRV0);
+	get(&rscc, "seq_mem_0_drv0", RSCC_SEQ_MEM_0_DRV0);
+	get(&gmu, "rscc_control_ack", GMU_RSCC_CONTROL_ACK);
+}
+
+/* what can be seen of a GMU that does not come up: the tail of its log (16 bytes an event), its RSC, its state */
+static void
+gmu_post_mortem(void)
+{
+	uint32_t next = rd(gmu.base + GMU_PWR_COL_CP_RESP) & 0xffff, entries = GMU_LOG_SIZE / 16;
+	const volatile uint32_t *log = (const volatile uint32_t *)gmu_log.memory;
+
+	to_memory(gmu_log.memory, GMU_LOG_SIZE);
+	say("apollo gpu: %u: the GMU's log (event, time, two values), %u events in, the last 20:\n", step, next);
+	for (uint32_t i = next > 20 ? next - 20 : 0; i < next && i < entries; i++) {
+		say("apollo gpu: %u:   %x %x %x %x\n", step, log[4 * i], log[4 * i + 1], log[4 * i + 2], log[4 * i + 3]);
+	}
+	rscc_show();
+	get(&gpucc, "gx_gdscr", GPUCC_GX_GDSCR);
+	get(&gmu, "rpmh_power_state", GMU_RPMH_POWER_STATE);
+	get(&gmu, "ao_host_interrupt_status", GMU_AO_HOST_INTERRUPT_STATUS);
+	get(&gmu, "ahb_fence_status", GMU_AHB_FENCE_STATUS);
+	space_faulted(&gmu_space);
+}
+
+/*
+ * What Linux writes before it lets the processor go (a6xx_gmu_fw_start, a6xx_gmu_power_config), in its
+ * order, with the a650's values; then out of reset (a6xx_gmu_start).
+ */
+static bool
+step_gmu_start(void)
+{
+	static const uint8_t priority[HFI_QUEUES] = { 10, 10, 40 };
+	uint32_t result = 0, version, mask, started;
+
+	if (!cx_ready() || !gmu_space_is_on) {
+		return false;
+	}
+	hfi = (volatile struct hfi_table *)block_uncached(&gmu_hfi);
+	if (hfi == NULL) {
+		say("apollo gpu: %u: the page for the messages is not in one piece\n", step);
+		return false;
+	}
+	hfi->words = sizeof(struct hfi_table) / 4;
+	hfi->first_queue = 6;
+	hfi->queue_words = sizeof(struct hfi_queue) / 4;
+	hfi->queues = hfi->active_queues = HFI_QUEUES;
+	for (unsigned i = 0; i < HFI_QUEUES; i++) {
+		hfi->queue[i].start = GMU_HFI_ADDRESS + HFI_QUEUE_AT(i);
+		hfi->queue[i].type = i | (uint32_t)priority[i] << 8;
+		hfi->queue[i].words = HFI_QUEUE_WORDS;
+		hfi->queue[i].status = 1;
+	}
+
+	announce("tell the GMU where things are, by its registers: the message table, the log, which GPU this is; its "
+	    "caches and its use of RPMh; then let its processor out of reset");
+	if (get(&gmu, "cm3_sysreset", GMU_CM3_SYSRESET) != 1) {
+		say("apollo gpu: %u: the GMU's processor is not held in reset: not configuring it while it runs\n", step);
+		return false;
+	}
+	/* a6xx_rsc_wakeup: the GMU's RPMh channel taken back from the always-on sequencer, should it have it */
+	rscc_show();
+	if (rd(rscc.base + RSCC_RSC_STATUS0_DRV0) & RSCC_ASLEEP) {     /* (as a run before this one leaves it: gmu_stop()) */
+		put(&gmu, "rscc_control_req", GMU_RSCC_CONTROL_REQ, 2);
+		if (!wait_for(&gmu, GMU_RSCC_CONTROL_ACK, 2, 2, 100) || !wait_for(&rscc, RSCC_SEQ_BUSY_DRV0, ~0u, 0, 100)) {
+			say("apollo gpu: %u: the GMU's RPMh channel does not wake\n", step);
+		}
+		get(&gmu, "rscc_control_ack", GMU_RSCC_CONTROL_ACK);
+		put(&gmu, "rscc_control_req", GMU_RSCC_CONTROL_REQ, 0);
+	}
+	rsc_awake = true;
+	put(&gmu, "cx_fal_intf", GMU_CX_FAL_INTF, 1);
+	put(&gmu, "cx_falnext_intf", GMU_CX_FALNEXT_INTF, 1);
+	put(&gmu, "general_7", GMU_GENERAL_7, 1);
+	put(&gmu, "pwr_col_cp_resp", GMU_PWR_COL_CP_RESP, 0);
+	put(&gmu, "cm3_fw_init_result", GMU_CM3_FW_INIT_RESULT, 0);
+	put(&gmu, "cm3_boot_config", GMU_CM3_BOOT_CONFIG, 2);
+	put(&gmu, "hfi_qtbl_addr", GMU_HFI_QTBL_ADDR, GMU_HFI_ADDRESS);
+	put(&gmu, "hfi_qtbl_info", GMU_HFI_QTBL_INFO, 1);
+	put(&gmu, "ahb_fence_range_0", GMU_AHB_FENCE_RANGE_0, GMU_AHB_FENCE);
+	put(&gmu, "cm3_cfg", GMU_CM3_CFG, 0x4052);
+	put(&gmu, "hfi_sfr_addr", GMU_HFI_SFR_ADDR, GMU_CHIP);
+	put(&gmu, "pwr_col_cp_msg", GMU_PWR_COL_CP_MSG, GMU_LOG_ADDRESS | (GMU_LOG_SIZE / 4096 - 1));
+	for (uint32_t i = 0; i < 4; i++) {
+		put(&gbif, "qsb_side", GBIF_QSB_SIDE0 + 4 * i, 0x00071620);
+	}
+	put(&gmu, "sys_bus_config", GMU_SYS_BUS_CONFIG, 1);
+	put(&gmu, "icache_config", GMU_ICACHE_CONFIG, 1);
+	put(&gmu, "dcache_config", GMU_DCACHE_CONFIG, 1);
+	put(&gmu, "pwr_col_inter_frame_ctrl", GMU_PWR_COL_INTER_FRAME_CTRL, 0x9c40400);
+	put(&gmu, "rpmh_ctrl", GMU_RPMH_CTRL, rd(gmu.base + GMU_RPMH_CTRL) | GMU_RPMH_CTRL_ALL);
+	put(&gmu, "gmu2host_intr_clr", GMU_GMU2HOST_INTR_CLR, 0xffffffff);
+
+	version = rd(gmu.base + GMU_DTCM_VERSIONS);
+	mask = version <= GMU_OLD_FIRMWARE ? 0xffffffffu : GMU_STARTED_MASK;
+	started = version <= GMU_OLD_FIRMWARE ? 0xbabeface : GMU_STARTED;
+	gmu_runs = true;
+	put(&gmu, "cm3_sysreset", GMU_CM3_SYSRESET, 0);
+	for (int i = 0; i < 5000 && (result & mask) != started && !(mask != 0xffffffffu && (result & GMU_FAILED)); i++) {
+		sleep_us(100);
+		result = rd(gmu.base + GMU_CM3_FW_INIT_RESULT);
+	}
+	get(&gmu, "cm3_fw_init_result", GMU_CM3_FW_INIT_RESULT);
+	get(&gmu, "gmu2host_intr_info", GMU_GMU2HOST_INTR_INFO);
+	get(&gmu, "ao_host_interrupt_status", GMU_AO_HOST_INTERRUPT_STATUS);
+	get(&gmu, "hfi_ctrl_status", GMU_HFI_CTRL_STATUS);
+	if (space_faulted(&gmu_space) || (result & mask) != started) {
+		say("apollo gpu: %u: the GMU's firmware does not come up (core version %#x: waited for %#x in %#x)\n", step,
+		    version, started, mask);
+		gmu_post_mortem();
+		return false;
+	}
+	say("apollo gpu: %u: THE GMU'S FIRMWARE RUNS\n", step);
+	return true;
+}
+
+/* ---- step 16: the GMU's way to RPMh, and its message queues ------------------------------------------------ */
+
+/*
+ * The GMU raises and drops the 3D core's supply through command slots of its own (step 7) and a
+ * sequencer in the always-on part of the SoC, "PDC", which on the a650 family the always-on processor
+ * programs (a6xx_gmu_rpmh_init: pdc_in_aop). Left to us are the PDC's two enabling registers and the
+ * GMU side's little program, after the firmware has started and before the message queues are.
+ */
+static struct block pdc = { "pdc", 0x0b290000, 0x10000 };       /* dt: qcom,gmu "kgsl_gmu_pdc_cfg" */
+#define PDC_GPU_ENABLE          (4 * 0x1140)
+#define PDC_GPU_SEQ_START_ADDR  (4 * 0x1148)
+#define RSCC_PDC_SEQ_START_ADDR (4 * 0x008)
+#define RSCC_PDC_MATCH_VALUE_LO (4 * 0x009)
+#define RSCC_PDC_MATCH_VALUE_HI (4 * 0x00a)
+#define RSCC_HIDDEN_TCS_CMD0_ADDR (4 * 0x00d)
+#define RSCC_HIDDEN_TCS_CMD0_DATA (4 * 0x00e)
+#define RSCC_OVERRIDE_START_ADDR (4 * 0x100)
+
+static bool
+step_gmu_queues(void)
+{
+	static const uint32_t program[5] = { 0xeaaae5a0, 0xe1a1ebab, 0xa2e0a581, 0xecac82e2, 0x0020edad };
+
+	if (!cx_ready() || !gmu_runs) {
+		return false;
+	}
+	announce("give the GMU's RPMh channel its sleep and wake program (rscc, 0x3de0000)");
+	put(&rscc, "rsc_status0_drv0", RSCC_RSC_STATUS0_DRV0, 1u << 24);
+	put(&rscc, "pdc_slave_id_drv0", RSCC_PDC_SLAVE_ID_DRV0, 1);
+	put(&rscc, "hidden_tcs_cmd0_data", RSCC_HIDDEN_TCS_CMD0_DATA, 0);
+	put(&rscc, "hidden_tcs_cmd0_addr", RSCC_HIDDEN_TCS_CMD0_ADDR, 0);
+	put(&rscc, "hidden_tcs_cmd1_data", RSCC_HIDDEN_TCS_CMD0_DATA + 4 * 2, 0);
+	put(&rscc, "hidden_tcs_cmd1_addr", RSCC_HIDDEN_TCS_CMD0_ADDR + 4 * 2, 0);
+	put(&rscc, "hidden_tcs_cmd2_data", RSCC_HIDDEN_TCS_CMD0_DATA + 4 * 4, 0x80000000);    /* the a650's (Linux) */
+	put(&rscc, "hidden_tcs_cmd2_addr", RSCC_HIDDEN_TCS_CMD0_ADDR + 4 * 4, 0);
+	put(&rscc, "override_start_addr", RSCC_OVERRIDE_START_ADDR, 0);
+	put(&rscc, "pdc_seq_start_addr", RSCC_PDC_SEQ_START_ADDR, 0x4520);
+	put(&rscc, "pdc_match_value_lo", RSCC_PDC_MATCH_VALUE_LO, 0x4510);
+	put(&rscc, "pdc_match_value_hi", RSCC_PDC_MATCH_VALUE_HI, 0x4514);
+	for (unsigned i = 0; i < 5; i++) {
+		put(&rscc, "seq_mem_drv0", RSCC_SEQ_MEM_0_DRV0 + 4 * i, program[i]);
+	}
+	get(&rscc, "seq_mem_0_drv0", RSCC_SEQ_MEM_0_DRV0);
+
+	announce("enable the GPU's part of the always-on sequencer (pdc, 0xb294500 and 0xb294520: not touched before)");
+	get(&pdc, "gpu_enable", PDC_GPU_ENABLE);
+	get(&pdc, "gpu_seq_start_addr", PDC_GPU_SEQ_START_ADDR);
+	put(&pdc, "gpu_seq_start_addr", PDC_GPU_SEQ_START_ADDR, 0);
+	put(&pdc, "gpu_enable", PDC_GPU_ENABLE, 0x80000001);
+	get(&pdc, "gpu_enable", PDC_GPU_ENABLE);
+
+	announce("ask the GMU to start its message queues");
+	put(&gmu, "hfi_ctrl_init", GMU_HFI_CTRL_INIT, 1);
+	if (!wait_for(&gmu, GMU_HFI_CTRL_STATUS, 1, 1, 500)) {
+		get(&gmu, "hfi_ctrl_status", GMU_HFI_CTRL_STATUS);
+		get(&gmu, "cm3_fw_init_result", GMU_CM3_FW_INIT_RESULT);
+		say("apollo gpu: %u: the GMU does not start its message queues\n", step);
+		gmu_post_mortem();
+		return false;
+	}
+	get(&gmu, "hfi_ctrl_status", GMU_HFI_CTRL_STATUS);
+	get(&gmu, "hfi_version_info", GMU_HFI_VERSION_INFO);
+	gmu_talks = true;
+	say("apollo gpu: %u: THE GMU'S MESSAGE QUEUES ARE UP\n", step);
+	return !space_faulted(&gmu_space);
+}
+
+/* ---- step 17: talk to the GMU; the 3D core powered ---------------------------------------------------------- */
+
+/*
+ * A message is words: the first says which (bits 7:0), how many words (15:8), a request or an answer
+ * (19:16), and a number (31:20) that the answer repeats in its second word; the third word of an answer
+ * is the GMU's verdict, 0 for done. Linux a6xx_hfi.c, a6xx_hfi.h.
+ */
+#define HFI_BW_TABLE            3
+#define HFI_PERF_TABLE          4
+#define HFI_START               10
+#define HFI_CORE_FW_START       14
+#define HFI_GX_BW_PERF_VOTE     30
+#define HFI_PREPARE_SLUMBER     33
+#define HFI_ERROR               100
+#define HFI_ANSWER              1               /* in bits 19:16 */
+#define HFI_NO_INDEX            0xff
+#define GMU_HOST2GMU_INTR_SET   GMU_WORD(0x5194)
+#define GMU_SPTPRAC_PWR_CLK_STATUS GMU_WORD(0x50d0)     /* bit 6: the 3D core has no power, bit 7: no clock */
+#define GMU_CORE_REQUEST        (1u << 30)      /* of host2gmu_intr_set: OOB "GPU_SET", keep the 3D core up for us */
+#define GMU_CORE_RELEASE        (1u << 31)      /* ... no more */
+#define GMU_CORE_GRANTED        (1u << 31)      /* of gmu2host_intr_info */
+
+struct hfi_perf_table {
+	uint32_t header, gpu_levels, gmu_levels;
+	struct {
+		uint32_t vote, acd, khz;
+	} gpu[16];
+	struct {
+		uint32_t vote, khz;
+	} gmu[4];
+};
+struct hfi_bw_table {
+	uint32_t header, levels, cnoc_commands, ddr_commands, cnoc_wait, ddr_wait;
+	uint32_t cnoc_address[6], cnoc_data[2][6], ddr_address[8], ddr_data[16][8];
+};
+
+static uint32_t hfi_number;
+static bool core_is_on;
+
+/*
+ * everything waiting in a queue of the GMU's; true if the answer to the message numbered `number` was among it.
+ * How far the GMU has written is the GMU's word in shared memory: taken once, and only if it is a place in the
+ * queue where a message can begin (messages are whole multiples of four words); and no more messages than fit.
+ */
+static bool
+hfi_receive(unsigned which, uint32_t number, uint32_t *verdict)
+{
+	volatile struct hfi_queue *queue = &hfi->queue[which];
+	volatile uint32_t *data = (volatile uint32_t *)((vm_offset_t)hfi + HFI_QUEUE_AT(which));
+	uint32_t write = queue->write;
+	bool answered = false;
+
+	if (write >= HFI_QUEUE_WORDS || (write & 3)) {
+		say("apollo gpu: %u: the GMU's queue %u says it is written up to %#x: not a place in it\n", step, which, write);
+		return false;
+	}
+	for (uint32_t messages = 0; queue->read % HFI_QUEUE_WORDS != write && messages < HFI_QUEUE_WORDS / 4; messages++) {
+		uint32_t message[8] = { 0 }, at = queue->read % HFI_QUEUE_WORDS, words = data[at] >> 8 & 0xff;
+
+		for (uint32_t i = 0; i < words; i++) {
+			if (i < 8) {
+				message[i] = data[at];
+			}
+			at = (at + 1) % HFI_QUEUE_WORDS;
+		}
+		queue->read = (at + 3) / 4 * 4 % HFI_QUEUE_WORDS;
+		if ((message[0] >> 16 & 0xf) == HFI_ANSWER && message[1] >> 20 == number) {
+			*verdict = message[2];
+			answered = true;
+		} else {
+			message[7] = 0;
+			if ((message[0] & 0xff) == HFI_ERROR) {
+				say("apollo gpu: %u: THE GMU REPORTS AN ERROR: %u, %u, \"%s\"\n", step, message[1] >> 16,
+				    message[1] & 0xffff, (const char *)&message[2]);
+			} else {
+				say("apollo gpu: %u: the GMU says (queue %u, %u words): %#x %#x %#x %#x %#x %#x\n", step, which, words,
+				    message[0], message[1], message[2], message[3], message[4], message[5]);
+			}
+		}
+		if (words == 0) {
+			break;
+		}
+	}
+	return answered;
+}
+
+/* send a message whose first word is yet to be made and wait for the GMU's verdict on it */
+static bool
+hfi_send(const char *what, uint32_t id, uint32_t *message, uint32_t words)
+{
+	volatile struct hfi_queue *queue = &hfi->queue[0];
+	volatile uint32_t *data = (volatile uint32_t *)((vm_offset_t)hfi + HFI_QUEUE_AT(0));
+	uint32_t at = queue->write % HFI_QUEUE_WORDS, number = ++hfi_number & 0xfff, verdict = 0, waiting = 0;
+	uint32_t room = (queue->read % HFI_QUEUE_WORDS + HFI_QUEUE_WORDS - at - 1) % HFI_QUEUE_WORDS;
+	bool answered = false;
+
+	if (room < (words + 3) / 4 * 4) {
+		/* (the GMU has not taken what it was sent before: writing on would overwrite it) */
+		say("apollo gpu: %u: no room in the GMU's queue for %s: %u words free of %u, read up to %u, written up to %u\n", step,
+		    what, room, HFI_QUEUE_WORDS, queue->read, queue->write);
+		return false;
+	}
+	message[0] = id | words << 8 | number << 20;
+	if (!quiet) {
+		say("apollo gpu: %u: about to send the GMU %s: message %u, %u words, number %u\n", step, what, id, words, number);
+	}
+	hold();
+	for (uint32_t i = 0; i < (words + 3) / 4 * 4; i++) {
+		data[at] = i < words ? message[i] : 0xfafafafa;
+		at = (at + 1) % HFI_QUEUE_WORDS;
+	}
+	queue->write = at;
+	__asm__ volatile ("dsb sy");
+	wr(gmu.base + GMU_HOST2GMU_INTR_SET, 1);
+	for (int i = 0; i < 10000 && !answered; i++) {
+		sleep_us(100);
+		waiting = rd(gmu.base + GMU_GMU2HOST_INTR_INFO);
+		if (waiting & 1) {
+			wr(gmu.base + GMU_GMU2HOST_INTR_CLR, 1);
+			answered = hfi_receive(1, number, &verdict);
+		}
+		if (rd(gmu.base + GMU_CM3_FW_INIT_RESULT) & GMU_FAILED) {
+			break;
+		}
+	}
+	hfi_receive(2, ~0u, &waiting);
+	if (!answered || verdict != 0) {
+		say("apollo gpu: %u: the GMU %s (%#x) to %s; fw_init_result %#x, gmu2host_intr_info %#x\n", step,
+		    answered ? "says no" : "does not answer", verdict, what, rd(gmu.base + GMU_CM3_FW_INIT_RESULT),
+		    rd(gmu.base + GMU_GMU2HOST_INTR_INFO));
+		gmu_post_mortem();
+		return false;
+	}
+	if (!quiet) {
+		say("apollo gpu: %u: the GMU accepts %s\n", step, what);
+	}
+	return true;
+}
+
+/*
+ * A vote for a level of a supply: the level, its place in RPMh's list for the rail, and the place of
+ * the level the memories' rail must have with it (a6xx_gmu.c: a6xx_gmu_rpmh_arc_votes_init).
+ */
+static bool
+rail_vote(uint32_t level, const uint16_t *rail, unsigned rail_levels, const uint16_t *mx, unsigned mx_levels, uint32_t *vote)
+{
+	unsigned at, with = 0;
+
+	for (at = 0; at < rail_levels && rail[at] < level; at++) {
+	}
+	if (at == rail_levels || mx_levels == 0) {
+		return false;
+	}
+	while (with + 1 < mx_levels && mx[with] < rail[at]) {
+		with++;
+	}
+	*vote = (uint32_t)rail[at] << 16 | with << 8 | at;
+	return true;
+}
+
+/* dt: kgsl_3d0_reg_memory: the 3D core's registers; a6xx.xml counts in words */
+static struct block gpu = { "gpu", 0x03d00000, 0x40000 };
+#define GPU_WORD(n)             (4u * (n))
+#define RBBM_INT_0_STATUS       GPU_WORD(0x0201)
+#define RBBM_STATUS             GPU_WORD(0x0210)
+#define RBBM_CLOCK_CNTL         GPU_WORD(0x00ae)
+#define CP_RB_BASE              GPU_WORD(0x0800)
+
+static uint32_t core_khz;
+
+/*
+ * Linux's order (a6xx_hfi_start, then a6xx_gmu_set_initial_freq, then hw_init's a6xx_gmu_set_oob): the
+ * table of the 3D core's speeds with the supply level each needs -- this phone's (dt: qcom,gpu-pwrlevels
+ * of speed bin 0, levels from gpu-opp-table_v2) -- and the GMU's own; the a650's table of bus votes
+ * (a6xx_hfi.c a650_build_bw_table: one level, "off"); "start the core firmware", "start"; the speed
+ * wanted; then the request to keep the 3D core powered, after which its registers can be read.
+ */
+static bool
+step_core_power(void)
+{
+	static const struct {
+		uint32_t khz, level;
+	} speeds[] = { { 0, 0 }, { 305000, 64 }, { 400000, 128 }, { 441600, 144 }, { 490000, 192 }, { 525000, 224 },
+		       { 587000, 256 } };
+	static struct hfi_perf_table perf;
+	static struct hfi_bw_table bw;
+	uint32_t core_start[2] = { 0, 0 }, start[1] = { 0 }, vote[4] = { 0, 1, 2, HFI_NO_INDEX }, granted = 0;
+	uint16_t gfx[16], cx[16], mx[16];
+	unsigned gfx_levels, cx_levels, mx_levels;
+
+	if (!cx_ready() || !gmu_talks) {
+		return false;
+	}
+	if (!rpmh_resource("gfx.lvl", gfx, &gfx_levels) || !rpmh_resource("cx.lvl", cx, &cx_levels) ||
+	    !rpmh_resource("mx.lvl", mx, &mx_levels)) {
+		say("apollo gpu: %u: RPMh's list lacks one of the rails\n", step);
+		return false;
+	}
+	perf.gpu_levels = sizeof(speeds) / sizeof(speeds[0]);
+	for (unsigned i = 0; i < perf.gpu_levels; i++) {
+		perf.gpu[i].khz = speeds[i].khz;
+		perf.gpu[i].acd = 0xffffffff;           /* no adaptive clocking */
+		if (!rail_vote(speeds[i].level, gfx, gfx_levels, mx, mx_levels, &perf.gpu[i].vote)) {
+			say("apollo gpu: %u: RPMh has no level %u for the 3D core's rail\n", step, speeds[i].level);
+			return false;
+		}
+	}
+	perf.gmu_levels = 2;
+	perf.gmu[1].khz = 200000;
+	if (!rail_vote(0, cx, cx_levels, mx, mx_levels, &perf.gmu[0].vote) ||
+	    !rail_vote(48, cx, cx_levels, mx, mx_levels, &perf.gmu[1].vote)) {  /* sm8250.dtsi: the GMU's 200 MHz at MIN_SVS */
+		return false;
+	}
+	say("apollo gpu: %u: votes: 3D core %#x %#x %#x %#x %#x %#x %#x, GMU %#x %#x\n", step, perf.gpu[0].vote,
+	    perf.gpu[1].vote, perf.gpu[2].vote, perf.gpu[3].vote, perf.gpu[4].vote, perf.gpu[5].vote, perf.gpu[6].vote,
+	    perf.gmu[0].vote, perf.gmu[1].vote);
+
+	bw.levels = 1;
+	bw.ddr_commands = 3;
+	bw.ddr_wait = 1;
+	bw.ddr_address[0] = rpmh_resource("MC0", NULL, NULL);
+	bw.ddr_address[1] = rpmh_resource("SH0", NULL, NULL);
+	bw.ddr_address[2] = rpmh_resource("ACV", NULL, NULL);
+	bw.ddr_data[0][0] = bw.ddr_data[0][1] = bw.ddr_data[0][2] = 0x40000000;
+	bw.cnoc_commands = 1;
+	bw.cnoc_wait = 1;
+	bw.cnoc_address[0] = 0x500a4;           /* Linux's, fixed for the a650; cmd-db has no name for it here */
+	bw.cnoc_data[0][0] = 0x40000000;
+	bw.cnoc_data[1][0] = 0x60000001;
+	say("apollo gpu: %u: RPMh's bus resources: MC0 %#x, SH0 %#x, ACV %#x (Linux has 0x50000, 0x50004, 0x5007c)\n", step,
+	    bw.ddr_address[0], bw.ddr_address[1], bw.ddr_address[2]);
+	if (bw.ddr_address[0] == 0 || bw.ddr_address[1] == 0 || bw.ddr_address[2] == 0) {
+		return false;
+	}
+
+	if (speed_index >= 1 && speed_index < perf.gpu_levels) {
+		vote[2] = speed_index;
+	}
+	core_khz = speeds[vote[2]].khz;
+	say("apollo gpu: %u: the speed wanted: %u.%u MHz\n", step, core_khz / 1000, core_khz % 1000 / 100);
+	announce("send the GMU its tables (speeds and supply levels, bus votes), \"start\", and the speed wanted; "
+	    "from here on it casts votes in RPMh by itself");
+	if (!hfi_send("the table of speeds", HFI_PERF_TABLE, &perf.header, sizeof(perf) / 4) ||
+	    !hfi_send("the table of bus votes", HFI_BW_TABLE, &bw.header, sizeof(bw) / 4) ||
+	    !hfi_send("\"start the core firmware\"", HFI_CORE_FW_START, core_start, 2) ||
+	    !hfi_send("\"start\"", HFI_START, start, 1) ||
+	    !hfi_send("the speed wanted", HFI_GX_BW_PERF_VOTE, vote, 4)) {
+		return false;
+	}
+
+	announce("ask the GMU to power the 3D core and keep it powered");
+	get(&gmu, "sptprac_pwr_clk_status", GMU_SPTPRAC_PWR_CLK_STATUS);
+	get(&gpucc, "gx_gdscr", GPUCC_GX_GDSCR);
+	put(&gmu, "host2gmu_intr_set", GMU_HOST2GMU_INTR_SET, GMU_CORE_REQUEST);
+	for (int i = 0; i < 5000 && !(granted & GMU_CORE_GRANTED); i++) {
+		sleep_us(100);
+		granted = rd(gmu.base + GMU_GMU2HOST_INTR_INFO);
+	}
+	core_is_on = true;                      /* asked for, at least: to be given back */
+	put(&gmu, "gmu2host_intr_clr", GMU_GMU2HOST_INTR_CLR, GMU_CORE_GRANTED);
+	get(&gmu, "sptprac_pwr_clk_status", GMU_SPTPRAC_PWR_CLK_STATUS);
+	get(&gpucc, "gx_gdscr", GPUCC_GX_GDSCR);
+	get(&gmu, "rpmh_power_state", GMU_RPMH_POWER_STATE);
+	if (!(granted & GMU_CORE_GRANTED) || (rd(gmu.base + GMU_SPTPRAC_PWR_CLK_STATUS) & 0xc0) != 0) {
+		say("apollo gpu: %u: the GMU does not power the 3D core (gmu2host_intr_info %#x, fw_init_result %#x)\n", step,
+		    granted, rd(gmu.base + GMU_CM3_FW_INIT_RESULT));
+		gmu_post_mortem();
+		return false;
+	}
+	say("apollo gpu: %u: measured: the 3D core's clock runs at %u Hz (%u MHz was asked for), the GMU's in it at %u Hz\n", step,
+	    measure_quietly(GPUCC_DEBUG_GX_GFX3D), core_khz / 1000, measure_quietly(GPUCC_DEBUG_GX_GMU));
+
+	announce("read registers of the 3D core itself (0x3d00000): the first time it has power");
+	get(&gpu, "rbbm_status", RBBM_STATUS);
+	get(&gpu, "rbbm_int_0_status", RBBM_INT_0_STATUS);
+	get(&gpu, "rbbm_clock_cntl", RBBM_CLOCK_CNTL);
+	get(&gpu, "cp_rb_base", CP_RB_BASE);
+	say("apollo gpu: %u: THE 3D CORE HAS POWER AND ANSWERS\n", step);
+	return !space_faulted(&gmu_space);
+}
+
+/* ---- step 18: the 3D core's memory and its microcode -------------------------------------------------------- */
+
+/*
+ * The 3D core takes its orders as words in a ring of memory, which a small processor inside it ("SQE",
+ * with microcode of its own: a650_sqe.fw) reads up to where a register says we have written. Like the GMU
+ * it reaches memory through the SMMU: stream 0 (dt: gfx3d_user, iommus <0 0x401>), to which this gives
+ * context 0. The a650 has no second command processor (the 642L's "LPAC", hakios.adreno.c), so nothing
+ * else of the core needs a stream. a650_sqe.fw is version 0x093: Linux wants 0x095 for "other security
+ * fixes" (a6xx_ucode_check_version); the phone's own Android runs this one.
+ */
+#define CORE_STREAM             0
+#define CORE_MATCH              0
+#define PTE_UNPRIVILEGED        (1ull << 6)     /* the 3D core's accesses are; the GMU's are not */
+#define PTE_READ_ONLY           (1ull << 7)
+#define PTE_CORE                (PTE_GMU | PTE_UNPRIVILEGED)
+/*
+ * What is the kernel's alone in the 3D core's space -- the ring and the scratch page with the fences and the
+ * times -- is mapped for privileged accesses only, so that a program's command buffers cannot read or write
+ * it (Linux: MSM_BO_MAP_PRIV, IOMMU_PRIV, for the ring and its memptrs when the GPU has hw_apriv, which the
+ * a650 has). That works because CP_APRIV_CNTL (step 20) makes the command processor's own fetches of the
+ * ring and its writes from the ring privileged, as Linux's a6xx hw_init does. The microcode stays as Linux
+ * maps it (adreno_fw_create_bo: read-only, not privileged): it is the public a650_sqe.fw. Boot-arg
+ * gpu_protect=0: none of this (and no CP_PROTECT either, step 20) -- as before, for a phone where it does
+ * not work; it is not yet tried on the hardware.
+ */
+static uint32_t gpu_protect = 1;
+#define PTE_CORE_OWN            (gpu_protect ? PTE_GMU : PTE_CORE)
+#define CORE_RING_ADDRESS       0x01000000u
+#define CORE_RING_SIZE          0x8000u         /* Linux's; 8192 words */
+#define CORE_SQE_ADDRESS        0x01100000u
+#define CORE_SCRATCH_ADDRESS    0x01200000u
+#define SMMU_SCTLR_SERVE_AFTER_FAULT (1u << 8)  /* Linux (qcom_adreno_smmu_write_sctlr): or the core hangs on a fault */
+
+#define RBBM_GBIF_CLIENT_QOS_CNTL GPU_WORD(0x0011)
+#define RBBM_GBIF_HALT          GPU_WORD(0x0016)
+#define RBBM_GBIF_HALT_ACK      GPU_WORD(0x0017)
+#define RBBM_INTERFACE_HANG_INT_CNTL GPU_WORD(0x001f)
+#define RBBM_PERFCTR_CNTL       GPU_WORD(0x0500)
+#define RBBM_PERFCTR_GPU_BUSY_MASKED GPU_WORD(0x050b)
+#define CP_RB_CNTL              GPU_WORD(0x0802)
+#define CP_RB_RPTR              GPU_WORD(0x0806)
+#define CP_RB_WPTR              GPU_WORD(0x0807)
+#define CP_SQE_CNTL             GPU_WORD(0x0808)
+#define CP_HW_FAULT             GPU_WORD(0x0821)
+#define CP_INTERRUPT_STATUS     GPU_WORD(0x0823)
+#define CP_PROTECT_STATUS       GPU_WORD(0x0824)
+#define CP_SQE_INSTR_BASE       GPU_WORD(0x0830)
+#define CP_APRIV_CNTL           GPU_WORD(0x0844)
+#define CP_PROTECT_CNTL         GPU_WORD(0x084f)
+#define CP_PROTECT(n)           GPU_WORD(0x0850 + (n))
+#define CP_PROTECTS             48              /* the a650's count_max (DECLARE_ADRENO_PROTECT(a650_protect, 48)) */
+#define CP_PROTECT_CNTL_ON      (1u << 0 | 1u << 1 | 1u << 3)   /* access protection, fault on violation, last span to the end */
+#define PROTECT_RDONLY(reg, len) (((len) & 0x3fffu) << 18 | ((reg) & 0x3ffffu))
+#define PROTECT_NORDWR(reg, len) (1u << 31 | PROTECT_RDONLY(reg, len))
+#define CP_ROQ_THRESHOLDS_1     GPU_WORD(0x08c1)
+#define CP_ROQ_THRESHOLDS_2     GPU_WORD(0x08c2)
+#define CP_MEM_POOL_SIZE        GPU_WORD(0x08c3)
+#define CP_AHB_CNTL             GPU_WORD(0x098d)
+#define UCHE_WRITE_RANGE_MAX    GPU_WORD(0x0e05)
+#define UCHE_WRITE_THRU_BASE    GPU_WORD(0x0e07)
+#define UCHE_TRAP_BASE          GPU_WORD(0x0e09)
+#define UCHE_CACHE_WAYS         GPU_WORD(0x0e17)
+#define UCHE_FILTER_CNTL        GPU_WORD(0x0e18)
+#define UCHE_CLIENT_PF          GPU_WORD(0x0e19)
+#define PC_DBG_ECO_CNTL         GPU_WORD(0x9e00)
+#define RBBM_SECVID_TSB_TRUSTED_BASE GPU_WORD(0xf800)
+#define RBBM_SECVID_TSB_TRUSTED_SIZE GPU_WORD(0xf802)
+#define RBBM_SECVID_TSB_CNTL    GPU_WORD(0xf803)
+#define CP_RB_CNTL_VALUE        (12u | 2u << 8 | 1u << 27)      /* 2^12 pairs of words; no read position copied to memory */
+
+/* commands (Mesa's adreno_pm4.xml); a packet is a header word and so many more */
+#define CP_MEM_WRITE            0x3d
+#define CP_ME_INIT              0x48
+#define CP_SET_SECURE_MODE      0x66
+
+static struct gpu_space core_space = {
+	.name = "the 3D core", .context = 0, .mask = 0x401, .control = SMMU_SCTLR_SERVE_AFTER_FAULT,
+};
+static struct gpu_block core_ring, core_sqe, core_scratch;
+static bool core_space_is_on, core_runs, zap_is_loaded;
+static bool core_stuck;                 /* the 3D core has not finished what it was given, and is not waited for */
+#define RING_WORDS              (CORE_RING_SIZE / 4)
+static uint32_t ring_at, ring_sent;
+
+static uint32_t
+odd_parity(uint32_t v)
+{
+	return 0x9669 >> (0xf & (v ^ v >> 4 ^ v >> 8 ^ v >> 12 ^ v >> 16 ^ v >> 20 ^ v >> 24 ^ v >> 28)) & 1;
+}
+
+static void
+ring(uint32_t word)
+{
+	((uint32_t *)core_ring.memory)[ring_at] = word;
+	ring_at = (ring_at + 1) % RING_WORDS;
+}
+
+/* the header of a command with so many words after it */
+static void
+ring_command(uint32_t command, uint32_t words)
+{
+	ring(7u << 28 | words | odd_parity(words) << 15 | command << 16 | odd_parity(command) << 23);
+}
+
+static void
+ring_send(void)
+{
+	if (ring_at >= ring_sent) {
+		to_memory(core_ring.memory + 4 * ring_sent, 4 * (ring_at - ring_sent));
+	} else {
+		to_memory(core_ring.memory + 4 * ring_sent, 4 * (RING_WORDS - ring_sent));
+		to_memory(core_ring.memory, 4 * ring_at);
+	}
+	ring_sent = ring_at;
+	wr(gpu.base + CP_RB_WPTR, ring_at);
+}
+
+/* let the 3D core have what is in the ring, and wait until it has taken all of it and rests */
+static bool
+ring_run(const char *what)
+{
+	uint32_t taken = ~0u, status = ~0u;
+
+	say("apollo gpu: %u: about to have the 3D core %s: the ring up to word %u\n", step, what, ring_at);
+	hold();
+	ring_send();
+	for (int i = 0; i < 20000 && (taken != ring_at || (status & ~1u)); i++) {
+		sleep_us(100);
+		taken = rd(gpu.base + CP_RB_RPTR);
+		status = rd(gpu.base + RBBM_STATUS);
+	}
+	if (taken == ring_at && !(status & ~1u) && rd(gpu.base + CP_HW_FAULT) == 0 && !space_faulted(&core_space)) {
+		say("apollo gpu: %u: the 3D core has done it (ring read up to %u, status %#x)\n", step, taken, status);
+		return true;
+	}
+	say("apollo gpu: %u: the 3D core does not get through: ring read up to %u of %u, status %#x, interrupts %#x, "
+	    "command processor: fault %#x, interrupts %#x, protection %#x\n", step, taken, ring_at, status,
+	    rd(gpu.base + RBBM_INT_0_STATUS), rd(gpu.base + CP_HW_FAULT), rd(gpu.base + CP_INTERRUPT_STATUS),
+	    rd(gpu.base + CP_PROTECT_STATUS));
+	space_faulted(&core_space);
+	return false;
+}
+
+static void
+put64(struct block *b, const char *name, uint32_t offset, uint64_t value)
+{
+	put(b, name, offset, (uint32_t)value);
+	put(b, name, offset + 4, (uint32_t)(value >> 32));
+}
+
+static bool
+step_core_space(void)
+{
+	const uint8_t *microcode;
+	uint64_t size = 0;
+	uint32_t version;
+
+	if (!cx_ready() || !core_is_on) {
+		return false;
+	}
+	announce("make the 3D core's memory: its ring, its microcode (fw/a650_sqe.fw), a page to try writing to");
+	microcode = image_file("a650_sqe.fw", &size);
+	if (microcode == NULL || size < 8 || size > 0x40000 ||
+	    !block_new(&core_space, &core_ring, CORE_RING_ADDRESS, CORE_RING_SIZE, PTE_CORE_OWN) ||
+	    !block_new(&core_space, &core_sqe, CORE_SQE_ADDRESS, (uint32_t)size - 4, PTE_CORE | PTE_READ_ONLY) ||
+	    !block_new(&core_space, &core_scratch, CORE_SCRATCH_ADDRESS, 4096, PTE_CORE_OWN)) {
+		return false;
+	}
+	memcpy((void *)core_sqe.memory, microcode + 4, size - 4);       /* the file's first word is not microcode */
+	to_memory(core_sqe.memory, core_sqe.size);
+	memcpy(&version, microcode + 4, sizeof(version));
+	say("apollo gpu: %u: the microcode's version: %#x (Linux wants at least 0x095)\n", step, version & 0xfff);
+
+	announce("give the SMMU's context 0 these tables and send the 3D core's requests (stream 0) through it");
+	core_space_is_on = true;
+	if (!space_on(&core_space, CORE_MATCH, CORE_STREAM)) {
+		/* the 642L's SMMU takes no 0x401 (hakios.adreno.c: it reads back 0): then as the GMU's, 0x400 */
+		say("apollo gpu: %u: trying the stream with the mask 0x400 instead\n", step);
+		core_space.mask = 0x400;
+		if (!space_on(&core_space, CORE_MATCH, CORE_STREAM)) {
+			return false;
+		}
+	}
+	get(&gpu, "rbbm_status", RBBM_STATUS);
+	return !space_faulted(&core_space);
+}
+
+/* ---- step 19: the zap shader, loaded -------------------------------------------------------------------- */
+
+/*
+ * The rest of what Linux does with the zap shader (mdt_loader.c: qcom_mdt_pas_init, qcom_mdt_load;
+ * adreno_gpu.c: zap_shader_load_mdt): after the header (step 12), TrustZone is told where the image will
+ * be -- dt: reserved-memory pil_gpu_region@8681a000, 0x2000 (Linux's sm8250.dtsi gpu_mem) -- the image's
+ * one loadable segment (a650_zap.b02, 0x68c bytes at 0x5000 of the image, at the start of that memory:
+ * the span of its segments rounded to 4K) is put there, and TrustZone is asked to authenticate it and
+ * run it. Our kernels come and go without the phone restarting: a kernel gives the zap shader back when
+ * it gives the GPU back (gmu_stop()), and asks for that first here too, for one that did not end in order.
+ */
+#define ZAP_MEMORY              0x8681a000ull
+#define ZAP_MEMORY_SIZE         0x2000u
+#define SCM_PAS_MEM_SETUP       SCM_CALL(2, 2)
+#define SCM_PAS_SHUTDOWN        SCM_CALL(2, 6)
+#define SCM_THREE_VALUES        3
+
+static bool
+zap_unload(void)
+{
+	uint64_t answer = ~0ull;
+
+	return scm("to give up the zap shader", SCM_64 | SCM_SIP | SCM_PAS_SHUTDOWN, SCM_ONE_VALUE, PAS_GPU, 0, 0, &answer) == 0 &&
+	       answer == 0;
+}
+
+static bool
+step_zap_load(void)
+{
+	const uint8_t *segment;
+	volatile uint8_t *memory;
+	uint64_t size = 0, header = 0, answer = ~0ull;
+
+	if (!cx_ready() || !core_is_on) {
+		return false;
+	}
+	announce("ask TrustZone to give up a zap shader that a kernel before this one may have left");
+	say("apollo gpu: %u: %s\n", step, zap_unload() ? "TrustZone has given up what it had (it says so with none, too)" :
+	    "TRUSTZONE DOES NOT GIVE IT UP: the next answers tell whether it keeps one");
+	segment = image_file("a650_zap.b02", &size);
+	if (segment == NULL || size == 0 || size > 0x1000) {
+		return false;
+	}
+	announce("hand the zap shader's header to TrustZone, tell it where the image goes, put the image there, and ask "
+	    "TrustZone to authenticate and run it");
+	if (!zap_header(&header)) {
+		return false;
+	}
+	if (scm("to take the zap shader's signature", SCM_64 | SCM_SIP | SCM_PAS_INIT_IMAGE, SCM_VALUE_AND_BUFFER, PAS_GPU,
+	    header, 0, &answer) != 0 || answer != 0) {
+		say("apollo gpu: %u: TrustZone does not take the signature (%#llx): taken to mean that it keeps a zap shader "
+		    "from before, which is used as it is\n", step, answer);
+		zap_is_loaded = true;
+		return true;
+	}
+	if (scm("where the image will be", SCM_64 | SCM_SIP | SCM_PAS_MEM_SETUP, SCM_THREE_VALUES, PAS_GPU, ZAP_MEMORY, 0x1000,
+	    &answer) != 0 || answer != 0) {
+		say("apollo gpu: %u: TrustZone does not take the place (%#llx): taken to mean that it keeps a zap shader from "
+		    "before, which is used as it is\n", step, answer);
+		zap_is_loaded = true;
+		return true;
+	}
+	/* (the memory is looked at only now: TrustZone has just said that it is not its own) */
+	memory = (volatile uint8_t *)ml_io_map_wcomb(ZAP_MEMORY, ZAP_MEMORY_SIZE);
+	say("apollo gpu: %u: the reserved memory begins %02x %02x %02x %02x, the zap shader %02x %02x %02x %02x\n", step,
+	    memory[0], memory[1], memory[2], memory[3], segment[0], segment[1], segment[2], segment[3]);
+	say("apollo gpu: %u: about to write %llu bytes at %#llx\n", step, size, ZAP_MEMORY);
+	hold();
+	for (uint64_t i = 0; i < 0x1000; i++) {
+		memory[i] = i < size ? segment[i] : 0;
+	}
+	__asm__ volatile ("dsb sy");
+	if (scm("to authenticate the zap shader and run it", SCM_64 | SCM_SIP | SCM_PAS_AUTH_AND_RESET, SCM_ONE_VALUE, PAS_GPU, 0,
+	    0, &answer) != 0 || answer != 0) {
+		say("apollo gpu: %u: TrustZone does not authenticate the zap shader (%#llx)\n", step, answer);
+		return false;
+	}
+	say("apollo gpu: %u: TRUSTZONE HAS AUTHENTICATED AND STARTED THE ZAP SHADER\n", step);
+	zap_is_loaded = true;
+	return true;
+}
+
+/* ---- step 20: the 3D core's registers, its command processor started, its first command ------------------- */
+
+/*
+ * Linux's a6xx_gpu.c hw_init, the a650's branches, less what only matters once it draws (clock gating,
+ * counters' selection, interrupts): the values are checked against it one by one. The protection of
+ * registers against user programs' commands (a6xx_set_cp_protect) is in, unless gpu_protect=0: programs'
+ * command buffers reach the core, and without it they may write the registers that say where the ring,
+ * the microcode and the SMMU's tables are. UBWC (a6xx_set_ubwc_config with SM8250's ubwc_4_0_hbb16:
+ * UBWC 4.0, highest bank bit 16): the same values Mesa will be told.
+ */
+static bool
+step_core_start(void)
+{
+	static const uint32_t address_modes[] = { 0x0842, 0x0c01, 0x8601, 0x8e05, 0x9e01, 0xbe05, 0xa601, 0x9601, 0x0e00, 0xae01,
+		                                  0xb601, 0xf810 };
+
+	if (!cx_ready() || !core_is_on || !core_space_is_on) {
+		return false;
+	}
+	announce("write the 3D core's registers as Linux does for the a650 before it starts the command processor");
+	put(&gbif, "halt", GBIF_HALT, 0);
+	put(&gpu, "rbbm_gbif_halt", RBBM_GBIF_HALT, 0);
+	put(&gpu, "rbbm_secvid_tsb_cntl", RBBM_SECVID_TSB_CNTL, 0);
+	put64(&gpu, "rbbm_secvid_tsb_trusted_base", RBBM_SECVID_TSB_TRUSTED_BASE, 0);
+	put(&gpu, "rbbm_secvid_tsb_trusted_size", RBBM_SECVID_TSB_TRUSTED_SIZE, 0);
+	for (unsigned i = 0; i < sizeof(address_modes) / sizeof(address_modes[0]); i++) {
+		put(&gpu, "address mode: 64 bits", GPU_WORD(address_modes[i]), 1);
+	}
+	put(&gpu, "rbbm_gbif_client_qos_cntl", RBBM_GBIF_CLIENT_QOS_CNTL, 3);
+	put(&gpu, "rbbm_perfctr_gpu_busy_masked", RBBM_PERFCTR_GPU_BUSY_MASKED, 0xffffffff);
+	put64(&gpu, "uche_write_range_max", UCHE_WRITE_RANGE_MAX, 0x0001fffffffff000ull + 0xfc0);
+	put64(&gpu, "uche_trap_base", UCHE_TRAP_BASE, 0x0001fffffffff000ull);
+	put64(&gpu, "uche_write_thru_base", UCHE_WRITE_THRU_BASE, 0x0001fffffffff000ull);
+	put(&gpu, "uche_filter_cntl", UCHE_FILTER_CNTL, 0x804);
+	put(&gpu, "uche_cache_ways", UCHE_CACHE_WAYS, 0x4);
+	put(&gpu, "cp_roq_thresholds_2", CP_ROQ_THRESHOLDS_2, 0x02000140);
+	put(&gpu, "cp_roq_thresholds_1", CP_ROQ_THRESHOLDS_1, 0x8040362c);
+	put(&gpu, "cp_mem_pool_size", CP_MEM_POOL_SIZE, 128);
+	put(&gpu, "pc_dbg_eco_cntl", PC_DBG_ECO_CNTL, 0x00300200);     /* a6xx_catalog.c: the a650's prim_fifo_threshold */
+	put(&gpu, "cp_ahb_cntl", CP_AHB_CNTL, 1);
+	put(&gpu, "rbbm_perfctr_cntl", RBBM_PERFCTR_CNTL, 1);
+	put(&gpu, "rb_nc_mode_cntl", GPU_WORD(0x8e08), 1u << 11 | 1u << 4 | 3u << 1);     /* rgb565 predicator, amsbc, hbb 3 */
+	put(&gpu, "tpl1_nc_mode_cntl", GPU_WORD(0xb604), 3u << 1);
+	put(&gpu, "sp_nc_mode_cntl", GPU_WORD(0xae02), 2u << 4 | 3u << 1);              /* uavflagprd_inv 2: the a650 family */
+	put(&gpu, "uche_mode_cntl", GPU_WORD(0x0e01), 3u << 21);
+	put(&gpu, "rbbm_nc_mode_cntl", GPU_WORD(0x0534), 1);                             /* macrotile mode */
+	put(&gpu, "rbbm_interface_hang_int_cntl", RBBM_INTERFACE_HANG_INT_CNTL, 1u << 30 | 0x1fffff);
+	put(&gpu, "uche_client_pf", UCHE_CLIENT_PF, 1u << 7 | 1);
+	put(&gpu, "cp_apriv_cntl", CP_APRIV_CNTL, 1u << 6 | 1u << 5 | 1u << 3 | 1u << 2 | 1u << 1);
+	if (gpu_protect) {
+		/*
+		 * The ranges of registers a command buffer that is not the ring's may not write (and some not
+		 * read): Linux's a650_protect_regs (drivers/gpu/drm/msm/adreno/a6xx_catalog.c, before that
+		 * a6xx_gpu.c; "these are for a620 and a650"), written as a6xx_set_cp_protect writes them: the
+		 * last entry into the last register, its span to the end of the registers.
+		 */
+		static const uint32_t a650_protect[] = {
+			PROTECT_RDONLY(0x00000, 0x04ff), PROTECT_RDONLY(0x00501, 0x0005), PROTECT_RDONLY(0x0050b, 0x02f4),
+			PROTECT_NORDWR(0x0050e, 0x0000), PROTECT_NORDWR(0x00510, 0x0000), PROTECT_NORDWR(0x00534, 0x0000),
+			PROTECT_NORDWR(0x00800, 0x0082), PROTECT_NORDWR(0x008a0, 0x0008), PROTECT_NORDWR(0x008ab, 0x0024),
+			PROTECT_RDONLY(0x008de, 0x00ae), PROTECT_NORDWR(0x00900, 0x004d), PROTECT_NORDWR(0x0098d, 0x0272),
+			PROTECT_NORDWR(0x00e00, 0x0001), PROTECT_NORDWR(0x00e03, 0x000c), PROTECT_NORDWR(0x03c00, 0x00c3),
+			PROTECT_RDONLY(0x03cc4, 0x1fff), PROTECT_NORDWR(0x08630, 0x01cf), PROTECT_NORDWR(0x08e00, 0x0000),
+			PROTECT_NORDWR(0x08e08, 0x0000), PROTECT_NORDWR(0x08e50, 0x001f), PROTECT_NORDWR(0x08e80, 0x027f),
+			PROTECT_NORDWR(0x09624, 0x01db), PROTECT_NORDWR(0x09e60, 0x0011), PROTECT_NORDWR(0x09e78, 0x0187),
+			PROTECT_NORDWR(0x0a630, 0x01cf), PROTECT_NORDWR(0x0ae02, 0x0000), PROTECT_NORDWR(0x0ae50, 0x032f),
+			PROTECT_NORDWR(0x0b604, 0x0000), PROTECT_NORDWR(0x0b608, 0x0007), PROTECT_NORDWR(0x0be02, 0x0001),
+			PROTECT_NORDWR(0x0be20, 0x17df), PROTECT_NORDWR(0x0f000, 0x0bff), PROTECT_RDONLY(0x0fc00, 0x1fff),
+			PROTECT_NORDWR(0x18400, 0x1fff), PROTECT_NORDWR(0x1a800, 0x1fff), PROTECT_NORDWR(0x1f400, 0x0443),
+			PROTECT_RDONLY(0x1f844, 0x007b), PROTECT_NORDWR(0x1f887, 0x001b),
+			PROTECT_NORDWR(0x1f8c0, 0x0000),        /* the last: to the end of the registers */
+		};
+		const unsigned last = sizeof(a650_protect) / sizeof(a650_protect[0]) - 1;
+
+		put(&gpu, "cp_protect_cntl", CP_PROTECT_CNTL, CP_PROTECT_CNTL_ON);
+		for (unsigned i = 0; i < last; i++) {
+			wr(gpu.base + CP_PROTECT(i), a650_protect[i]);
+		}
+		wr(gpu.base + CP_PROTECT(CP_PROTECTS - 1), a650_protect[last]);
+		if (!quiet) {
+			say("apollo gpu: %u: %u ranges of the 3D core's registers protected from command buffers (cp_protect)\n", step,
+			    last + 1);
+		}
+	}
+	put64(&gpu, "cp_sqe_instr_base", CP_SQE_INSTR_BASE, CORE_SQE_ADDRESS);
+	put64(&gpu, "cp_rb_base", CP_RB_BASE, CORE_RING_ADDRESS);
+	put(&gpu, "cp_rb_cntl", CP_RB_CNTL, CP_RB_CNTL_VALUE);
+	get(&gpu, "cp_sqe_instr_base", CP_SQE_INSTR_BASE);
+	get(&gpu, "cp_rb_base", CP_RB_BASE);
+	get(&gpu, "cp_rb_cntl", CP_RB_CNTL);
+	get(&gpu, "rbbm_status", RBBM_STATUS);
+
+	announce("start the 3D core's command processor");
+	core_runs = true;
+	put(&gpu, "cp_sqe_cntl", CP_SQE_CNTL, 1);
+	sleep_ms(20);
+	say("apollo gpu: %u: alive after it; status %#x, interrupts %#x, command processor: fault %#x, interrupts %#x, "
+	    "protection %#x, ring read up to %u\n", step, rd(gpu.base + RBBM_STATUS), rd(gpu.base + RBBM_INT_0_STATUS),
+	    rd(gpu.base + CP_HW_FAULT), rd(gpu.base + CP_INTERRUPT_STATUS), rd(gpu.base + CP_PROTECT_STATUS),
+	    rd(gpu.base + CP_RB_RPTR));
+	get(&smmu, "sgfsr", SMMU_SGFSR);
+	if (space_faulted(&core_space)) {
+		return false;
+	}
+
+	announce("give the 3D core its first command, \"initialize\"");
+	ring_command(CP_ME_INIT, 8);            /* a6xx_cp_init */
+	ring(0x0000002f);
+	ring(0x00000003);                       /* several hardware contexts */
+	ring(0x20000000);                       /* error detection */
+	ring(0);
+	ring(0);
+	ring(0);
+	ring(0);
+	ring(0);
+	if (!ring_run("initialize its command processor")) {
+		return false;
+	}
+	say("apollo gpu: %u: THE 3D CORE TAKES COMMANDS\n", step);
+	return true;
+}
+
+/* ---- step 21: out of secure mode; a word written on command ------------------------------------------------ */
+
+static bool
+step_core_commands(void)
+{
+	volatile uint32_t *scratch = (volatile uint32_t *)core_scratch.memory;
+
+	if (!cx_ready() || !core_runs) {
+		return false;
+	}
+	announce("command the 3D core out of secure mode (it asks the zap shader), then to write a word into a page of ours");
+	ring_command(CP_SET_SECURE_MODE, 1);
+	ring(0);
+	if (!ring_run("leave secure mode")) {
+		return false;
+	}
+	ring_command(CP_MEM_WRITE, 3);
+	ring(CORE_SCRATCH_ADDRESS);
+	ring(0);
+	ring(0x600dc0de);
+	if (!ring_run("write a word to memory")) {
+		return false;
+	}
+	to_memory(core_scratch.memory, 64);
+	say("apollo gpu: %u: the page reads %#x: %s\n", step, scratch[0], scratch[0] == 0x600dc0de ?
+	    "THE 3D CORE WRITES OUR MEMORY ON COMMAND" : "not what it was told to write");
+	return scratch[0] == 0x600dc0de;
+}
+
+/* ---- step 22: a frame filled by the GPU, on the panel ------------------------------------------------------ */
+
+/*
+ * The simplest thing the 3D core draws: its 2D engine filling a rectangle with one colour (Mesa's
+ * fd6_blitter.cc: fd6_clear_surface; registers as Linux's a6xx.xml names them), three times for three
+ * bands. The picture is 32-bit pixels in rows of a multiple of 64 bytes, in memory of ours; the
+ * framebuffer driver copies it to the panel (MiniIOMobileFramebufferShow, shared). RB_CCU_CNTL: where the
+ * colour cache sits when drawing straight into memory, Mesa's ccu_offset_bypass for the a650 -- three
+ * CCUs of 64K (freedreno_devices.py num_ccu 3) -- and no concurrent resolve (that is the a660 family's).
+ */
+#define CP_NOP                  0x10
+#define CP_WAIT_FOR_IDLE        0x26
+#define CP_BLIT                 0x2c
+#define CP_EVENT_WRITE          0x46
+#define CP_SET_MARKER           0x65
+#define RB_CCU_CNTL             0x8e07          /* register numbers: these are written by command */
+#define RB_CCU_CNTL_BYPASS      ((3u * 0x10000 >> 12) << 23)
+#define GRAS_2D_BLIT_CNTL       0x8400
+#define GRAS_2D_DST_TL          0x8405
+#define GRAS_2D_DST_BR          0x8406
+#define RB_2D_BLIT_CNTL         0x8c00
+#define RB_2D_PIXEL_CNTL        0x8c01
+#define RB_2D_DST_INFO          0x8c17
+#define RB_2D_DST               0x8c18
+#define RB_2D_DST_PITCH         0x8c1a
+#define RB_2D_SRC_SOLID_C0      0x8c2c
+#define SP_2D_DST_FORMAT        0xacc0
+#define FORMAT_8888             0x30
+#define BLIT_SOLID_8888         (1u << 7 | FORMAT_8888 << 8 | 0xfu << 20 | 0x10u << 24) /* one colour; all channels; 8-bit */
+#define DST_BGRA_LINEAR         (FORMAT_8888 | 1u << 10)        /* rows of pixels, blue first in memory */
+#define EVENT_FLUSH_COLOR       0x1d
+#define EVENT_CACHE_FLUSH       0x04
+#define CORE_TARGET_ADDRESS     0x10000000u
+#define TARGET_WIDTH            1080            /* the Mi 10T's panel */
+#define TARGET_HEIGHT           2400
+#define TARGET_ROW              4352            /* 1088 pixels: the next multiple of 64 bytes */
+
+extern void MiniIOMobileFramebufferShow(const uint8_t *pixels, uint32_t width, uint32_t height, uint32_t row_bytes);
+
+static struct gpu_block core_target;
+
+/* a register of the 3D core (by its word number) written by command, in the order of the other commands */
+static void
+ring_register(uint32_t number, uint32_t value)
+{
+	ring(4u << 28 | 1 | odd_parity(1) << 7 | number << 8 | odd_parity(number) << 27);
+	ring(value);
+}
+
+static void
+ring_fill(uint32_t top, uint32_t bottom, uint32_t red, uint32_t green, uint32_t blue)
+{
+	ring_register(GRAS_2D_DST_TL, top << 16);
+	ring_register(GRAS_2D_DST_BR, (TARGET_WIDTH - 1) | (bottom - 1) << 16);
+	ring_register(RB_2D_SRC_SOLID_C0, red);         /* a register for each part of the colour, 0 to 255 */
+	ring_register(RB_2D_SRC_SOLID_C0 + 1, green);
+	ring_register(RB_2D_SRC_SOLID_C0 + 2, blue);
+	ring_register(RB_2D_SRC_SOLID_C0 + 3, 255);
+	ring_register(RB_2D_BLIT_CNTL, BLIT_SOLID_8888);
+	ring_register(GRAS_2D_BLIT_CNTL, BLIT_SOLID_8888);
+	ring_register(SP_2D_DST_FORMAT, 1 | FORMAT_8888 << 3 | 0xfu << 12);
+	ring_register(RB_2D_PIXEL_CNTL, 0);
+	ring_register(RB_2D_DST_INFO, DST_BGRA_LINEAR);
+	ring_register(RB_2D_DST, CORE_TARGET_ADDRESS);
+	ring_register(RB_2D_DST + 1, 0);
+	ring_register(RB_2D_DST_PITCH, TARGET_ROW >> 6);
+	ring_command(CP_WAIT_FOR_IDLE, 0);
+	ring_command(CP_BLIT, 1);
+	ring(3);                                /* "scale": the 2D engine's one operation */
+}
+
+static bool
+step_frame(void)
+{
+	const volatile uint8_t *pixel;
+
+	if (!cx_ready() || !core_runs) {
+		return false;
+	}
+	announce("make a picture's worth of memory for the 3D core (10 MB) and have it fill three bands of colour");
+	/* (PTE_CORE, not PTE_CORE_OWN: it is the 2D engine that writes it, and its writes are not privileged) */
+	if (!block_new(&core_space, &core_target, CORE_TARGET_ADDRESS, TARGET_ROW * TARGET_HEIGHT, PTE_CORE)) {
+		return false;
+	}
+	/* tables that the SMMU has in use have grown: it has not seen these addresses, so nothing stale to forget */
+	for (uint32_t i = 0; i < core_space.table_count; i++) {
+		to_memory((vm_offset_t)core_space.tables[i].table, 4096);
+	}
+	ring_command(CP_SET_MARKER, 1);
+	ring(12);                               /* "2D blits follow" */
+	ring_register(RB_CCU_CNTL, RB_CCU_CNTL_BYPASS);
+	ring_fill(0, 800, 255, 128, 0);         /* orange */
+	ring_fill(800, 1600, 255, 255, 255);
+	ring_fill(1600, TARGET_HEIGHT, 0, 128, 255);
+	/* what it has drawn, out of its caches into memory; each event writes a word when done (Linux's a6xx_submit) */
+	ring_command(CP_EVENT_WRITE, 4);
+	ring(EVENT_FLUSH_COLOR);
+	ring(CORE_SCRATCH_ADDRESS + 32);
+	ring(0);
+	ring(0x0c0c0c0c);
+	ring_command(CP_EVENT_WRITE, 4);
+	ring(EVENT_CACHE_FLUSH);
+	ring(CORE_SCRATCH_ADDRESS + 16);
+	ring(0);
+	ring(0x0d0e0d0e);
+	ring_command(CP_WAIT_FOR_IDLE, 0);
+	if (!ring_run("fill a picture")) {
+		return false;
+	}
+	to_memory(core_scratch.memory, 64);
+	say("apollo gpu: %u: the words it writes when its caches are in memory: %#x, %#x (told: 0xc0c0c0c, 0xd0e0d0e)\n", step,
+	    ((volatile uint32_t *)core_scratch.memory)[8], ((volatile uint32_t *)core_scratch.memory)[4]);
+	to_memory(core_target.memory, core_target.size);
+	pixel = (const volatile uint8_t *)core_target.memory;
+	say("apollo gpu: %u: the picture's first pixel is %02x %02x %02x %02x (blue green red alpha; told: 00 80 ff ff), one in "
+	    "the middle %02x %02x %02x %02x, one in the last row %02x %02x %02x %02x\n", step, pixel[0], pixel[1], pixel[2],
+	    pixel[3], pixel[1200 * TARGET_ROW + 2160], pixel[1200 * TARGET_ROW + 2161], pixel[1200 * TARGET_ROW + 2162],
+	    pixel[1200 * TARGET_ROW + 2163], pixel[2399 * TARGET_ROW + 4316], pixel[2399 * TARGET_ROW + 4317],
+	    pixel[2399 * TARGET_ROW + 4318], pixel[2399 * TARGET_ROW + 4319]);
+	if ((pixel[0] | pixel[1] | pixel[2]) == 0 || pixel[1200 * TARGET_ROW + 2160] == 0 || (pixel[2399 * TARGET_ROW + 4316] |
+	    pixel[2399 * TARGET_ROW + 4317] | pixel[2399 * TARGET_ROW + 4318]) == 0) {
+		say("apollo gpu: %u: the picture is not what the 3D core was told to draw\n", step);
+		return false;
+	}
+	MiniIOMobileFramebufferShow((const uint8_t *)core_target.memory, TARGET_WIDTH, TARGET_HEIGHT, TARGET_ROW);
+	say("apollo gpu: %u: A PICTURE DRAWN BY THE GPU IS ON THE PANEL: orange, white, blue from the top\n", step);
+	sleep_ms(3000);                         /* to be seen before the system draws over it */
+	return true;
+}
+
+/*
+ * The GPU block's bus interface told to let what is under way finish and start nothing more (Linux's
+ * a6xx_bus_clear_pending_transactions), before the core's context is taken away: `for_good` halts the
+ * core's own side too and leaves it so (a panic, a core that does not rest).
+ */
+static void
+core_bus_halt(bool for_good)
+{
+	if (for_good) {
+		wr(gpu.base + RBBM_GBIF_HALT, 1);
+		for (int i = 0; i < 100000 && !(rd(gpu.base + RBBM_GBIF_HALT_ACK) & 1); i++) {
+		}
+	}
+	wr(gbif.base + GBIF_HALT, 1);
+	for (int i = 0; i < 100000 && !(rd(gbif.base + GBIF_HALT_ACK) & 1); i++) {
+	}
+	wr(gbif.base + GBIF_HALT, 2);
+	for (int i = 0; i < 100000 && !(rd(gbif.base + GBIF_HALT_ACK) & 2); i++) {
+	}
+	if (!for_good) {
+		wr(gbif.base + GBIF_HALT, 0);
+	}
+}
+
+/*
+ * The GMU stopped again, before the registers the steps changed are put back (the clocks, CX): in the
+ * order of Linux's a6xx_gmu_shutdown, as far as these steps go -- the processor into reset, the 3D
+ * core's switch off should it have come on, the GMU's RPMh channel put to sleep (its votes dropped),
+ * its stream sent nowhere.
+ */
+static void
+gmu_stop(void)
+{
+	uint32_t slumber[3] = { 0, 0, 0 };
+
+	if (core_runs && core_is_on) {
+		say("apollo gpu: the 3D core before it is stopped: status %#x, ring read up to %u of %u\n", rd(gpu.base + RBBM_STATUS),
+		    rd(gpu.base + CP_RB_RPTR), ring_at);
+		core_bus_halt(core_stuck);
+	}
+	if (core_is_on) {
+		put(&gmu, "host2gmu_intr_set", GMU_HOST2GMU_INTR_SET, GMU_CORE_RELEASE);
+		core_is_on = false;
+	}
+	if (gmu_talks) {
+		/* a6xx_gmu_notify_slumber: the GMU drops its votes and the 3D core's power itself */
+		hfi_send("\"slumber\"", HFI_PREPARE_SLUMBER, slumber, 3);
+		if (!wait_for(&gmu, GMU_AO_GPU_CX_BUSY_STATUS, 1u << 23, 0, 100)) {
+			get(&gmu, "ao_gpu_cx_busy_status", GMU_AO_GPU_CX_BUSY_STATUS);
+		}
+		get(&gpucc, "gx_gdscr", GPUCC_GX_GDSCR);
+		gmu_talks = false;
+	}
+	if (gmu_runs) {
+		put(&gmu, "cm3_sysreset", GMU_CM3_SYSRESET, 1);
+		gmu_runs = gmu_talks = false;
+		if (rd(gpucc.base + GPUCC_GX_GDSCR) & GDSC_POWER_ON) {
+			put(&gpucc, "gx_gdscr", GPUCC_GX_GDSCR, rd(gpucc.base + GPUCC_GX_GDSCR) | GDSC_SW_COLLAPSE);
+			wait_for(&gpucc, GPUCC_GX_GDSCR, GDSC_POWER_ON, 0, 100);
+		}
+	}
+	if (zap_is_loaded) {
+		say("apollo gpu: the zap shader: %s\n", zap_unload() ? "TrustZone has given it up" :
+		    "TRUSTZONE DOES NOT GIVE IT UP; the next kernel will find it there");
+		zap_is_loaded = false;
+	}
+	if (rsc_awake) {
+		put(&gmu, "rscc_control_req", GMU_RSCC_CONTROL_REQ, 1);
+		if (!wait_for(&rscc, RSCC_RSC_STATUS0_DRV0, RSCC_ASLEEP, RSCC_ASLEEP, 100)) {
+			say("apollo gpu: the GMU's RPMh channel does not go to sleep\n");
+		}
+		get(&rscc, "rsc_status0_drv0", RSCC_RSC_STATUS0_DRV0);
+		put(&gmu, "rscc_control_req", GMU_RSCC_CONTROL_REQ, 0);
+		rsc_awake = false;
+	}
+	if (gmu_space_is_on) {
+		space_faulted(&gmu_space);
+		space_off(&gmu_space, GMU_MATCH);
+		gmu_space_is_on = false;
+	}
+	if (core_space_is_on) {
+		space_faulted(&core_space);
+		space_off(&core_space, CORE_MATCH);
+		core_space_is_on = core_runs = false;
+	}
+}
+
+static void put_back(void);
+bool apollo_gpu_done(uint32_t fence);
+
+/* ---- the GPU kept on, for the system to draw with --------------------------------------------------- */
+
+/*
+ * The service ApolloGPU (iokit/Kernel/hakios.apollo_gpu.cpp, a copy of hakios.gpu.cpp) keeps the buffers and the
+ * clients; what is the GPU's is here, as in hakios.adreno.c's section of the same name (which has the
+ * long explanations): addresses in the 3D core's SMMU context, the ring, and the word by which the core
+ * says how far it has got (a "fence": a submission's number, written by the core when it is through with
+ * it). The caller holds one lock around all of these.
+ */
+#define GPU_CHIP_ID             0x06050002ull   /* dt: qcom,chipid */
+#define GPU_GMEM_SIZE           0x120000u       /* a6xx_catalog.c: SZ_1M + SZ_128K */
+#define GPU_HIGHEST_BANK_BIT    16              /* ubwc_4_0_hbb16 */
+#define GPU_UBWC_SWIZZLE        6               /* UBWC_SWIZZLE_ENABLE_LVL2 | LVL3 */
+#define GPU_ADDRESSES_START     0x20000000ull   /* above everything the steps use; below 4 GB, as Linux keeps them */
+#define GPU_ADDRESSES_SIZE      0xe0000000ull
+#define GPU_ADDRESS_GRANULE     0x10000ull      /* what one allocation is rounded up to */
+/* every address handed out can be mapped: tables for all of them (the last level's 2 MB each, the next's 1 GB, the root) */
+_Static_assert(SPACE_TABLES >= ((GPU_ADDRESSES_START + GPU_ADDRESSES_SIZE) >> 21) + ((GPU_ADDRESSES_START + GPU_ADDRESSES_SIZE) >> 30) + 1,
+    "SPACE_TABLES does not cover GPU_ADDRESSES_START + GPU_ADDRESSES_SIZE");
+#define GPU_FENCE_AT            0x40            /* in the scratch page */
+#define GPU_TIMES_AT            0x400           /* ... and when the core began and ended each of its last submissions */
+#define GPU_TIMES               64
+#define CP_ALWAYS_ON_COUNTER    0x0980          /* ticks of the 19.2 MHz crystal, 64 bits: for the core to read itself */
+#define CP_REG_TO_MEM           0x3e
+#define CP_SCRATCH_REG2         0x0885
+#define CP_IB1_BASE             GPU_WORD(0x0928)
+#define CP_IB1_REM_SIZE         GPU_WORD(0x092a)
+#define CP_IB2_BASE             GPU_WORD(0x092b)
+#define CP_IB2_REM_SIZE         GPU_WORD(0x092d)
+#define CP_INDIRECT_BUFFER      0x3f
+#define EVENT_INVALIDATE_DEPTH  0x18
+#define EVENT_INVALIDATE_COLOR  0x19
+/* for a core that has stopped answering (gpu_recover=1: apollo_gpu_recover() below) */
+#define RBBM_SW_RESET_CMD       GPU_WORD(0x0043)        /* a6xx.xml; 1 holds the 3D core's own half (GX) in reset */
+#define RBBM_INT_CLEAR_CMD      GPU_WORD(0x0037)        /* the bits of rbbm_int_0_status written here are forgotten */
+#define GMU_PWR_COL_KEEPALIVE   GMU_WORD(0x50c3)        /* a6xx_gmu.xml; 1: the GMU keeps the core powered */
+#define GMU_AHB_FENCE_STATUS_CLR GMU_WORD(0x9314)
+#define GMU_AO_AHB_FENCE_CTRL   GMU_WORD(0x9310)
+#define GPU_RECOVERIES          64
+
+static bool gpu_kept;
+static lck_mtx_t *gpu_times_lock;       /* gpu_times(): the submitting thread, the governor's and apollo_gpu_worked() all add up */
+static lck_mtx_t *gpu_hfi_lock;         /* the GMU's message queue and the governor's vote: apart from the clients' lock, which a vote must not hold up */
+static uint32_t gpu_fence;              /* the number of the last submission */
+static uint32_t gpu_timed;              /* ... of the last whose times have been added up */
+static uint64_t gpu_ticks;              /* how long the core has worked on the submissions added up */
+static uint64_t gov_ticks;              /* ... and in the speed governor's window */
+static uint32_t gpu_timed_count;
+static uint32_t gpu_timed_by[7];        /* ... how many of them under 0.1, 0.25, 0.5, 1, 2, 4 ms, and longer */
+static uint32_t gpu_exact = 1;          /* boot-arg gpu_exact=0: the core does not wait to be idle before it notes the time */
+static uint32_t gpu_recover;            /* boot-arg gpu_recover=1: a core that has stopped answering is reset and given work again */
+static uint32_t gpu_recoveries;
+uint32_t apollo_gpu_log;                /* boot-arg gpu_log=1: a line for every submission and the time the core spent on it */
+uint32_t apollo_gpu_va;                 /* boot-arg gpu_va: 0 the default, 1 describe the addresses, 2 also a granule's guard after each buffer */
+extern void hakios_tl(const char *format, ...) __printflike(1, 2);
+static struct {
+	uint64_t start, size;
+} gpu_free[1024];                       /* the addresses not in use, in order */
+static unsigned gpu_free_count;
+static uint64_t gpu_va_used;
+static uint32_t gpu_va_live;
+static unsigned gpu_va_holes;
+static uint64_t gpu_va_lost;
+static uint32_t gpu_va_refused;
+
+static uint64_t
+gpu_address_span(uint64_t size)
+{
+	uint64_t span = (size + (GPU_ADDRESS_GRANULE - 1)) & ~(GPU_ADDRESS_GRANULE - 1);
+
+	return apollo_gpu_va >= 2 ? span + GPU_ADDRESS_GRANULE : span;
+}
+
+extern void ApolloGPUStart(void);
+extern void ApolloGPUStop(void);        /* takes the clients' lock, then calls apollo_gpu_stop() */
+
+bool
+apollo_gpu_ready(void)
+{
+	return gpu_kept;
+}
+
+/* a run that ends in order gives the GPU back (loader_return.c calls this first, from a thread that may wait) */
+void
+apollo_adreno_stop(void)
+{
+	if (gpu_kept) {
+		ApolloGPUStop();
+	}
+}
+
+void
+apollo_gpu_stop(void)
+{
+	uint32_t waited = 0;
+
+	if (!gpu_kept) {
+		return;
+	}
+	gpu_kept = false;                       /* (nothing more is taken) */
+	lck_mtx_lock(gpu_hfi_lock);             /* (a vote of the governor's that is on its way is let finish) */
+	lck_mtx_unlock(gpu_hfi_lock);
+	quiet = false;
+	/* what the core has been given, it finishes first: half a second at the most; then its bus is halted for good */
+	while (!apollo_gpu_done(gpu_fence) && waited < 5000) {
+		sleep_us(100);
+		waited++;
+	}
+	core_stuck = !apollo_gpu_done(gpu_fence);
+	say("apollo gpu: the run is about to end: the GPU is given back (%s after %u us)\n",
+	    core_stuck ? "STILL AT WORK" : "it had finished what it was given", 100 * waited);
+	put_back();
+}
+
+/* the answers to msm's GET_PARAM (Linux's adreno_get_param for this GPU; the numbers are msm_drm.h's) */
+bool
+apollo_gpu_parameter(uint32_t which, uint64_t *value)
+{
+	switch (which) {
+	case 0x01:                              /* GPU_ID: none, the chip ID says it */
+	case 0x06:                              /* GMEM_BASE */
+	case 0x08:                              /* PP_PGTABLE */
+	case 0x09:                              /* FAULTS */
+	case 0x0a:                              /* SUSPENDS */
+	case 0x11:                              /* RAYTRACING */
+		*value = 0;
+		return true;
+	case 0x02:                              /* GMEM_SIZE */
+		*value = GPU_GMEM_SIZE;
+		return true;
+	case 0x03:                              /* CHIP_ID */
+		*value = GPU_CHIP_ID;
+		return true;
+	case 0x04:                              /* MAX_FREQ */
+		*value = core_khz * 1000ull;
+		return true;
+	case 0x05:                              /* TIMESTAMP */
+		*value = mach_absolute_time();
+		return true;
+	case 0x07:                              /* PRIORITIES */
+		*value = 1;
+		return true;
+	case 0x10:                              /* HIGHEST_BANK_BIT */
+		*value = GPU_HIGHEST_BANK_BIT;
+		return true;
+	case 0x12:                              /* UBWC_SWIZZLE */
+		*value = GPU_UBWC_SWIZZLE;
+		return true;
+	case 0x13:                              /* MACROTILE_MODE */
+		*value = 1;
+		return true;
+	case 0x0e:                              /* VA_START */
+	case 0x0f:                              /* VA_SIZE */
+		if (apollo_gpu_va == 0) {
+			return false;                   /* msm refuses these to a client that shares the GPU's own page tables */
+		}
+		*value = which == 0x0e ? GPU_ADDRESSES_START : GPU_ADDRESSES_SIZE;
+		return true;
+	default:
+		return false;
+	}
+}
+
+/* addresses for a buffer of so many bytes; 0: none left. They are the buffer's until apollo_gpu_address_free(). */
+uint64_t
+apollo_gpu_address(uint64_t size)
+{
+	size = gpu_address_span(size);
+	for (unsigned i = 0; i < gpu_free_count; i++) {
+		if (gpu_free[i].size >= size) {
+			uint64_t address = gpu_free[i].start;
+
+			gpu_free[i].start += size;
+			gpu_free[i].size -= size;
+			if (gpu_free[i].size == 0) {
+				memmove(&gpu_free[i], &gpu_free[i + 1], (--gpu_free_count - i) * sizeof(gpu_free[0]));
+			}
+			gpu_va_used += size;
+			gpu_va_live++;
+			return address;
+		}
+	}
+	gpu_va_refused++;
+	return 0;
+}
+
+void
+apollo_gpu_address_free(uint64_t address, uint64_t size)
+{
+	unsigned at;
+
+	size = gpu_address_span(size);
+	gpu_va_used -= size;
+	gpu_va_live--;
+	for (at = 0; at < gpu_free_count && gpu_free[at].start < address; at++) {
+	}
+	if (at > 0 && gpu_free[at - 1].start + gpu_free[at - 1].size == address) {
+		gpu_free[at - 1].size += size;
+		if (at < gpu_free_count && address + size == gpu_free[at].start) {
+			gpu_free[at - 1].size += gpu_free[at].size;
+			memmove(&gpu_free[at], &gpu_free[at + 1], (--gpu_free_count - at) * sizeof(gpu_free[0]));
+		}
+	} else if (at < gpu_free_count && address + size == gpu_free[at].start) {
+		gpu_free[at].start = address;
+		gpu_free[at].size += size;
+	} else if (gpu_free_count < sizeof(gpu_free) / sizeof(gpu_free[0])) {
+		memmove(&gpu_free[at + 1], &gpu_free[at], (gpu_free_count++ - at) * sizeof(gpu_free[0]));
+		gpu_free[at].start = address;
+		gpu_free[at].size = size;
+	} else {
+		gpu_va_lost += size;            /* no room to remember the hole: counted, not handed out again */
+	}
+	if (gpu_free_count > gpu_va_holes) {
+		gpu_va_holes = gpu_free_count;
+	}
+}
+
+/* what the 3D core's address space holds, for whoever prints the GPU's numbers (gpu_va=1) */
+void
+apollo_gpu_space(uint64_t *used, uint32_t *live, uint64_t *largest, unsigned *holes, unsigned *most, uint64_t *lost,
+    uint32_t *refused)
+{
+	*largest = 0;
+	for (unsigned i = 0; i < gpu_free_count; i++) {
+		if (gpu_free[i].size > *largest) {
+			*largest = gpu_free[i].size;
+		}
+	}
+	*used = gpu_va_used;
+	*live = gpu_va_live;
+	*holes = gpu_free_count;
+	*most = gpu_va_holes;
+	*lost = gpu_va_lost;
+	*refused = gpu_va_refused;
+}
+
+/* one 4K page of ours at an address of the 3D core's; after the last of a buffer's, apollo_gpu_mapped() */
+bool
+apollo_gpu_map(uint64_t address, uint64_t phys, bool read_only)
+{
+	return space_map(&core_space, address, phys, PTE_CORE | (read_only ? PTE_READ_ONLY : 0));
+}
+
+void
+apollo_gpu_mapped(void)
+{
+	space_commit(&core_space);
+}
+
+/*
+ * The pages taken out of the 3D core's space, and the SMMU made to forget what it had of them. false: it has
+ * not said so within 10 ms -- it may still translate the addresses to the old pages, so the caller keeps the
+ * memory the GPU's for good (as it keeps a buffer the core is not done with) and the addresses unused.
+ */
+bool
+apollo_gpu_unmap(uint64_t address, uint64_t size)
+{
+	uint32_t context = smmu_context(&core_space);
+	uint64_t began, patience;
+
+	for (uint64_t offset = 0; offset < size; offset += 4096) {
+		space_map(&core_space, address + offset, 0, 0);
+	}
+	space_commit(&core_space);
+	wr(smmu.base + context + SMMU_CB_TLBIASID, core_space.context);
+	wr(smmu.base + context + SMMU_CB_TLBSYNC, 1);
+	nanoseconds_to_absolutetime(10 * NSEC_PER_MSEC, &patience);
+	began = mach_absolute_time();
+	while (rd(smmu.base + context + SMMU_CB_TLBSTATUS) & 1) {
+		if (mach_absolute_time() - began >= patience) {
+			say("apollo gpu: THE SMMU DOES NOT FINISH FORGETTING %#llx..%#llx (tlbstatus %#x): the memory stays the GPU's\n",
+			    address, address + size - 1, rd(smmu.base + context + SMMU_CB_TLBSTATUS));
+			return false;
+		}
+		sleep_us(1);
+	}
+	return true;
+}
+
+/* memory that the 3D core and a program see without this processor's cache in between: out of that cache */
+void
+apollo_gpu_to_memory(void *start, uint64_t size)
+{
+	to_memory((vm_offset_t)start, size);
+}
+
+bool
+apollo_gpu_done(uint32_t fence)
+{
+	volatile uint32_t *word = (volatile uint32_t *)(core_scratch.memory + GPU_FENCE_AT);
+
+	to_memory((vm_offset_t)word, 4);
+	return (int32_t)(*word - fence) >= 0;
+}
+
+uint32_t
+apollo_gpu_last(void)
+{
+	return gpu_fence;
+}
+
+/*
+ * The submissions given to the core and not done yet: the last one's number less the last done (the fence word the core
+ * writes). No lock, so it may be one off; for the hitch tracer (hakios.apollo_hitch.c), which calls it from a timer interrupt.
+ */
+uint32_t
+apollo_gpu_in_flight(void)
+{
+	volatile uint32_t *word;
+	int32_t ahead;
+
+	if (!gpu_kept || core_scratch.memory == 0) {
+		return 0;
+	}
+	word = (volatile uint32_t *)(core_scratch.memory + GPU_FENCE_AT);
+	to_memory((vm_offset_t)word, 4);
+	ahead = (int32_t)(gpu_fence - *word);
+	return ahead > 0 ? (uint32_t)ahead : 0;
+}
+
+/* the speed the 3D core was last asked for (the governor's, apollo_gpu_speed's), in MHz; 0 while the GPU is not kept on */
+uint32_t
+apollo_gpu_mhz(void)
+{
+	return gpu_kept ? core_khz / 1000 : 0;
+}
+
+/* the core is to write down what time it is: at one end of submission `fence` */
+static void
+ring_time(uint32_t fence, uint32_t end)
+{
+	ring_command(CP_REG_TO_MEM, 3);
+	ring(CP_ALWAYS_ON_COUNTER | 2u << 18 | 1u << 30);       /* two words, a 64-bit register */
+	ring(CORE_SCRATCH_ADDRESS + GPU_TIMES_AT + 16 * (fence % GPU_TIMES) + 8 * end);
+	ring(0);
+}
+
+
+/* add up the times of the submissions the core has finished since this was last done (gpu_times_lock held) */
+static void
+gpu_times_locked(void)
+{
+	volatile uint64_t *times = (volatile uint64_t *)(core_scratch.memory + GPU_TIMES_AT);
+	uint32_t done;
+
+	to_memory(core_scratch.memory, 4096);
+	done = *(volatile uint32_t *)(core_scratch.memory + GPU_FENCE_AT);
+	if (done - gpu_timed > GPU_TIMES) {
+		gpu_timed = done - GPU_TIMES;           /* (the older ones have been written over) */
+	}
+	while (gpu_timed != done) {
+		uint32_t slot = ++gpu_timed % GPU_TIMES;
+
+		if (gpu_timed != 0 && times[2 * slot + 1] > times[2 * slot]) {
+			static const uint32_t under[6] = { 1920, 4800, 9600, 19200, 38400, 76800 };     /* (19.2 ticks a microsecond) */
+			uint64_t ticks = times[2 * slot + 1] - times[2 * slot];
+			unsigned by = 0;
+
+			if (apollo_gpu_log) {
+				hakios_tl("tl: q %u took %llu\n", gpu_timed, ticks * 10 / 192);
+			}
+			while (by < 6 && ticks >= under[by]) {
+				by++;
+			}
+			gpu_timed_by[by]++;
+			gpu_ticks += ticks;
+			__atomic_fetch_add(&gov_ticks, ticks, __ATOMIC_RELAXED);
+			gpu_timed_count++;
+		}
+	}
+}
+
+static void
+gpu_times(void)
+{
+	lck_mtx_lock(gpu_times_lock);
+	gpu_times_locked();
+	lck_mtx_unlock(gpu_times_lock);
+}
+
+/* how long the 3D core has worked since this was last asked, on how many submissions, and how many took under ... */
+void
+apollo_gpu_worked(uint64_t *microseconds, uint32_t *submissions, uint32_t by[7])
+{
+	lck_mtx_lock(gpu_times_lock);
+	gpu_times_locked();
+	*microseconds = gpu_ticks * 10 / 192;
+	*submissions = gpu_timed_count;
+	memcpy(by, gpu_timed_by, sizeof(gpu_timed_by));
+	bzero(gpu_timed_by, sizeof(gpu_timed_by));
+	gpu_ticks = 0;
+	gpu_timed_count = 0;
+	lck_mtx_unlock(gpu_times_lock);
+}
+
+/*
+ * The speed governor (apollo_gpu_dcvs, on by default): the 3D core works on the window server's frames in bursts,
+ * and how much of each tenth of a second it spent working is known from the times it writes down itself (ring_time()).
+ * Over 65% of a window busy: straight to the step that would make it ~60% busy (the next frame must not wait); under
+ * 30% for three windows running: one step down, but not below apollo_gpu_floor (default 3) while 30+ submissions a
+ * second come (the floor goes 300 ms after the last one); GPU sensor 70 C or more: top step 4. A step is the GMU's perf table (step_core_power(): 305, 400, 441.6, 490, 525, 587 MHz),
+ * asked for as Linux does (HFI GX_BW_PERF_VOTE), from the submitting thread, with the caller's lock held.
+ */
+#define GOV_WINDOW_US           100000
+#define GOV_UP_PERCENT          65
+#define GOV_DOWN_PERCENT        30
+#define GOV_DOWN_WINDOWS        3
+#define GOV_TARGET_PERCENT      60              /* a jump up aims at this much busy at the new speed */
+#define GOV_ACTIVE_SUBMITS      30              /* submissions a second that count as frames being drawn */
+#define GOV_IDLE_US             300000          /* this long without a submission drops the floor */
+#define GOV_HOT                 700             /* tenths of a degree: from here the top step is 4 */
+#define GOV_HOT_LEVEL           4
+#define GOV_TSENS0_PHYS         0x0c263000UL    /* as hakios.apollo_cpufreq.c: tsens@c263000, sensor 15 the GPU */
+#define GOV_TSENS_STATUS(n)     (0xa0 + 4 * (n))
+#define GOV_TSENS_VALID         (1u << 21)
+
+static uint32_t gpu_dcvs = 1, gpu_max_level = 6, gpu_floor = 3, gov_level, gov_low, gov_changes, gov_submits;
+static uint64_t gov_since, gov_last_submit, gov_temp_at;
+static bool gov_floor_on;
+static int32_t gov_temp = -2730;
+static vm_offset_t gov_tm0;
+static const uint32_t gov_khz[7] = { 0, 305000, 400000, 441600, 490000, 525000, 587000 };
+
+/* the GPU sensor in tenths of a degree, read at most once a second (-2730: none) */
+static int32_t
+gov_gpu_temp(uint64_t now)
+{
+	uint64_t ns;
+
+	if (gov_tm0 == 0) {
+		return -2730;
+	}
+	absolutetime_to_nanoseconds(now - gov_temp_at, &ns);
+	if (gov_temp_at != 0 && ns < 1000000000ull) {
+		return gov_temp;
+	}
+	gov_temp_at = now;
+	gov_temp = -2730;
+	for (unsigned again = 0; again < 16; again++) {
+		uint32_t status = *(volatile uint32_t *)(gov_tm0 + GOV_TSENS_STATUS(15));
+
+		if (status & GOV_TSENS_VALID) {
+			int32_t tenths = (int32_t)(status << 20) >> 20;
+
+			gov_temp = tenths > 1500 || tenths < -400 ? -2730 : tenths;
+			break;
+		}
+	}
+	return gov_temp;
+}
+
+/*
+ * One evaluation of the governor, from its own thread every GOV_WINDOW_US (gpu_governor_thread): the submit path only
+ * notes that a submission came (gov_last_submit, gov_submits) and the core's busy ticks are added to gov_ticks by
+ * gpu_times(); the decision and the HFI vote, which waits for the GMU's answer, are made here. gpu_hfi_lock held.
+ */
+static void
+gpu_governor(void)
+{
+	uint64_t now = mach_absolute_time(), nanos, gap, last = __atomic_load_n(&gov_last_submit, __ATOMIC_RELAXED);
+	uint32_t busy, level, top, floor_level, submits, vote[4] = { 0, 1, 0, HFI_NO_INDEX };
+	uint64_t ticks;
+
+	gpu_times();            /* (the busy ticks of what the core has finished) */
+	/* frames are being drawn while submissions keep coming; 300 ms without one and the floor is gone */
+	if (last) {
+		absolutetime_to_nanoseconds(now - last, &gap);
+		if (gap > GOV_IDLE_US * 1000ull) {
+			gov_floor_on = false;
+		}
+	}
+	submits = __atomic_exchange_n(&gov_submits, 0, __ATOMIC_RELAXED);
+	ticks = __atomic_exchange_n(&gov_ticks, 0, __ATOMIC_RELAXED);
+	if (gov_since == 0) {
+		gov_since = now;
+		return;
+	}
+	absolutetime_to_nanoseconds(now - gov_since, &nanos);
+	if (nanos == 0) {
+		return;
+	}
+	busy = (uint32_t)(ticks * 10 / 192 * 100 / (nanos / 1000 + 1));        /* ticks of 19.2 MHz: microseconds */
+	if (gpu_floor && (uint64_t)submits * 1000000000ull >= (uint64_t)GOV_ACTIVE_SUBMITS * nanos) {
+		gov_floor_on = true;
+	}
+	gov_since = now;
+
+	top = gpu_max_level;
+	if (gov_gpu_temp(now) >= GOV_HOT && top > GOV_HOT_LEVEL) {
+		top = GOV_HOT_LEVEL;
+	}
+	floor_level = gov_floor_on ? (gpu_floor < top ? gpu_floor : top) : 1;
+	level = gov_level;
+	if (busy > GOV_UP_PERCENT && level < top) {
+		/* the speed at which this much work would take about 60% of a window, the next step up from it */
+		uint64_t want = (uint64_t)gov_khz[level] * busy / GOV_TARGET_PERCENT;
+		uint32_t n = level + 1;
+
+		while (n < top && gov_khz[n] < want) {
+			n++;
+		}
+		level = n;
+		gov_low = 0;
+	} else if (busy < GOV_DOWN_PERCENT && level > floor_level && ++gov_low >= GOV_DOWN_WINDOWS) {
+		level--;
+		gov_low = 0;
+	} else if (busy >= GOV_DOWN_PERCENT) {
+		gov_low = 0;
+	}
+	if (level > top) {
+		level = top;
+	}
+	if (level < floor_level) {
+		level = floor_level;
+	}
+	if (level == gov_level) {
+		return;
+	}
+	vote[2] = level;
+	if (hfi_send("the speed wanted", HFI_GX_BW_PERF_VOTE, vote, 4)) {
+		if (gov_changes++ < 20 || gov_changes % 200 == 0) {
+			say("apollo gpu: the 3D core %s to %u MHz (%u%% busy%s; change %u)\n", level > gov_level ? "up" : "down",
+			    gov_khz[level] / 1000, busy, gov_floor_on ? ", floor on" : "", gov_changes);
+		}
+		gov_level = level;
+		core_khz = gov_khz[level];
+	}
+}
+
+static void
+gpu_governor_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	for (;;) {
+		delay_for_interval(GOV_WINDOW_US, NSEC_PER_USEC);
+		if (!gpu_kept || !gpu_dcvs) {
+			continue;               /* (a thread of the kernel does not end: it waits for the next run) */
+		}
+		lck_mtx_lock(gpu_hfi_lock);
+		if (gpu_kept && !core_stuck) {          /* (apollo_gpu_stop() and the recovery take this lock too) */
+			gpu_governor();
+		}
+		lck_mtx_unlock(gpu_hfi_lock);
+	}
+}
+
+uint64_t apollo_gpu_phase[4];           /* the last submission's ticks: waiting for ring room, adding up times, writing the ring, the doorbell */
+
+/*
+ * Command buffers for the 3D core to run, in order: each an address and a count of words. As Linux's
+ * a6xx_submit puts them in the ring. Returns the submission's number; 0: the ring is full and the core is
+ * not reading it.
+ *
+ * The caller holds the clients' lock (ApolloGPU's gGPULock) all the while, so a full ring holds up every
+ * other client, and the display's driver's waits, until there is room: that wait is a second at the most
+ * (it was two), the same second after which a wait for a submission takes the core to have stopped
+ * answering (gpuWait()); a ring that is still full after it is taken the same way. Letting go of the lock
+ * while waiting would mean checking the submission's buffers again afterwards (they may have been given
+ * back meanwhile): not done.
+ */
+uint32_t
+apollo_gpu_submit(const uint64_t *addresses, const uint32_t *words, uint32_t count)
+{
+	uint32_t wanted = 26 + 4 * count, room = 0;
+	uint64_t t0 = mach_absolute_time(), t1, t2, t3;
+
+	for (int i = 0; i < 10000; i++) {
+		room = (rd(gpu.base + CP_RB_RPTR) + RING_WORDS - ring_at - 1) % RING_WORDS;
+		if (room >= wanted) {
+			break;
+		}
+		sleep_us(100);
+	}
+	t1 = mach_absolute_time();
+	if (room < wanted) {
+		apollo_gpu_phase[0] = t1 - t0;
+		return 0;
+	}
+	gpu_times();
+	t2 = mach_absolute_time();
+	/* the governor is not run from here (it waits for the GMU): the thread notes what it needs */
+	__atomic_store_n(&gov_last_submit, t2, __ATOMIC_RELAXED);
+	__atomic_fetch_add(&gov_submits, 1, __ATOMIC_RELAXED);
+	if (++gpu_fence == 0) {
+		gpu_fence = 1;
+	}
+	ring_time(gpu_fence, 0);
+	ring_command(CP_EVENT_WRITE, 1);
+	ring(EVENT_INVALIDATE_DEPTH);
+	ring_command(CP_EVENT_WRITE, 1);
+	ring(EVENT_INVALIDATE_COLOR);
+	for (uint32_t i = 0; i < count; i++) {
+		ring_command(CP_INDIRECT_BUFFER, 3);
+		ring((uint32_t)addresses[i]);
+		ring((uint32_t)(addresses[i] >> 32));
+		ring(words[i]);
+	}
+	if (gpu_exact) {
+		ring_command(CP_WAIT_FOR_IDLE, 0);      /* the time is the pipeline's, not the command processor's, which is ahead of it */
+	}
+	ring_time(gpu_fence, 1);
+	ring_register(CP_SCRATCH_REG2, gpu_fence);
+	ring_command(CP_EVENT_WRITE, 4);
+	ring(EVENT_CACHE_FLUSH);
+	ring(CORE_SCRATCH_ADDRESS + GPU_FENCE_AT);
+	ring(0);
+	ring(gpu_fence);
+	t3 = mach_absolute_time();
+	ring_send();
+	apollo_gpu_phase[0] = t1 - t0;
+	apollo_gpu_phase[1] = t2 - t1;
+	apollo_gpu_phase[2] = t3 - t2;
+	apollo_gpu_phase[3] = mach_absolute_time() - t3;
+	return gpu_fence;
+}
+
+/* a submission does not come back: what the 3D core and its SMMU context say */
+void
+apollo_gpu_report(const char *why)
+{
+	uint32_t context = smmu_context(&core_space);
+
+	say("apollo gpu: %s: submission %u is the last, the core has done %u; ring: read up to %u, written up to %u; status "
+	    "%#x, interrupts %#x; command processor: fault %#x, interrupts %#x, protection %#x\n", why, gpu_fence,
+	    *(volatile uint32_t *)(core_scratch.memory + GPU_FENCE_AT), rd(gpu.base + CP_RB_RPTR), ring_at,
+	    rd(gpu.base + RBBM_STATUS), rd(gpu.base + RBBM_INT_0_STATUS), rd(gpu.base + CP_HW_FAULT),
+	    rd(gpu.base + CP_INTERRUPT_STATUS), rd(gpu.base + CP_PROTECT_STATUS));
+	say("apollo gpu:   in the first command buffer at %#llx, %u words to go; in the second at %#llx, %u to go\n",
+	    (uint64_t)rd(gpu.base + CP_IB1_BASE + 4) << 32 | rd(gpu.base + CP_IB1_BASE), rd(gpu.base + CP_IB1_REM_SIZE),
+	    (uint64_t)rd(gpu.base + CP_IB2_BASE + 4) << 32 | rd(gpu.base + CP_IB2_BASE), rd(gpu.base + CP_IB2_REM_SIZE));
+	step = 0;
+	if (space_faulted(&core_space)) {
+		wr(smmu.base + context + SMMU_CB_FSR, SMMU_FSR_ALL);    /* so that the next one shows */
+	}
+}
+
+/*
+ * boot-arg gpu_recover=1: the 3D core is put back where steps 20 and 21 left it, and everything it had been
+ * given is given up, so that the next submission is its own again (hakios.adreno.c's hakios_gpu_recover()
+ * has the sources and the reasons; the a650's GMU is the same kind of GMU, and the sequence is the same):
+ * the command processor halted, the GMU told to keep the core powered, the bus halted, the reset line of the
+ * core's own half (GX) pulled and let go, the ring emptied, and steps 20 and 21 again. Not Linux's, which
+ * takes the whole CX half down for a part with a real GMU; so it is behind a boot-arg.
+ */
+static bool apollo_gpu_recover_locked(void);
+
+bool
+apollo_gpu_recover(void)
+{
+	bool ok;
+
+	if (!gpu_kept) {
+		return false;
+	}
+	lck_mtx_lock(gpu_hfi_lock);             /* (no vote of the governor's while the GMU is being started again) */
+	lck_mtx_lock(gpu_times_lock);
+	ok = apollo_gpu_recover_locked();
+	lck_mtx_unlock(gpu_times_lock);
+	lck_mtx_unlock(gpu_hfi_lock);
+	return ok;
+}
+
+static bool
+apollo_gpu_recover_locked(void)
+{
+	uint32_t fence_status;
+
+	if (!gpu_kept || !gpu_recover) {
+		return false;
+	}
+	if (gpu_recoveries >= GPU_RECOVERIES) {
+		say("apollo gpu: the 3D core has been recovered %u times in this run already: no more\n", gpu_recoveries);
+		return false;
+	}
+	gpu_recoveries++;
+	step = 0;
+	last_step = 0;                          /* (no line of the steps' waits for the loader any more) */
+
+	wr(gpu.base + CP_SQE_CNTL, 3);
+	wr(gmu.base + GMU_PWR_COL_KEEPALIVE, 1);
+	core_bus_halt(true);
+	wr(gpu.base + RBBM_SW_RESET_CMD, 1);
+	rd(gpu.base + RBBM_SW_RESET_CMD);
+	sleep_us(101);
+	wr(gpu.base + RBBM_SW_RESET_CMD, 0);
+	rd(gpu.base + RBBM_SW_RESET_CMD);
+	sleep_us(1);
+	fence_status = rd(gmu.base + GMU_AHB_FENCE_STATUS);
+	wr(gmu.base + GMU_AHB_FENCE_STATUS_CLR, 7);
+	wr(gmu.base + GMU_AO_AHB_FENCE_CTRL, 0);
+	ring_at = ring_sent = rd(gpu.base + CP_RB_RPTR) % RING_WORDS;
+	wr(gpu.base + CP_RB_WPTR, ring_at);
+	wr(gpu.base + RBBM_INT_CLEAR_CMD, rd(gpu.base + RBBM_INT_0_STATUS));
+	say("apollo gpu: the 3D core's half has been reset: status %#x, interrupts %#x, ring at %u; the GMU sees it busy: "
+	    "%#x, and powered: %#x (bits 6 and 7 clear); it had dropped writes of ours: %#x\n", rd(gpu.base + RBBM_STATUS),
+	    rd(gpu.base + RBBM_INT_0_STATUS), ring_at, rd(gmu.base + GMU_AO_GPU_CX_BUSY_STATUS),
+	    rd(gmu.base + GMU_SPTPRAC_PWR_CLK_STATUS), fence_status);
+
+	quiet = false;
+	if (!step_core_start() || !step_core_commands()) {
+		say("apollo gpu: THE 3D CORE DOES NOT TAKE COMMANDS AGAIN after the reset: it is given up for this run\n");
+		wr(gmu.base + GMU_PWR_COL_KEEPALIVE, 0);
+		quiet = true;
+		return false;
+	}
+	wr(gmu.base + GMU_PWR_COL_KEEPALIVE, 0);
+	quiet = true;
+
+	/* everything the core had been given is given up: its word for how far it has got is the last submission's */
+	bzero((void *)core_scratch.memory, 4096);
+	*(volatile uint32_t *)(core_scratch.memory + GPU_FENCE_AT) = gpu_fence;
+	to_memory(core_scratch.memory, 4096);
+	gpu_timed = gpu_fence;
+	say("apollo gpu: THE 3D CORE IS RECOVERED (%u time%s in this run); submissions up to %u are given up as done\n",
+	    gpu_recoveries, gpu_recoveries == 1 ? "" : "s", gpu_fence);
+	return true;
+}
+
+/*
+ * The same when there is no time for asking: the kernel is on its way back to the loader (a panic, or an end
+ * that did not go through apollo_adreno_stop()). Only the writes that keep the GPU block out of memory that is
+ * no longer its to use.
+ */
+void
+apollo_adreno_quiesce(void)
+{
+	if (gmu_runs && gmu.base != 0) {
+		wr(gmu.base + GMU_CM3_SYSRESET, 1);
+		gmu_runs = false;
+	}
+	if (core_runs && gbif.base != 0 && gpu.base != 0) {
+		core_bus_halt(true);
+		core_runs = false;
+	}
+	if (smmu.base != 0 && smmu_page != 0) {
+		if (gmu_space_is_on) {
+			wr(smmu.base + smmu_context(&gmu_space) + SMMU_CB_SCTLR, 0);
+			gmu_space_is_on = false;
+		}
+		if (core_space_is_on) {
+			wr(smmu.base + smmu_context(&core_space) + SMMU_CB_SCTLR, 0);
+			core_space_is_on = false;
+		}
+	}
+}
+
+/* ---- the sequence ----------------------------------------------------------------------------------------- */
+
+static bool (*const steps[])(void) = {
+	NULL, step_outside, step_fuses, step_gpucc, step_cx_power, step_clocks, step_first_words,
+	step_rscc, step_smmu, step_smmu_context, step_gmu_memory, step_trustzone, step_zap_signature,
+	step_gmu_space, step_gmu_firmware, step_gmu_start, step_gmu_queues, step_core_power,
+	step_core_space, step_zap_load, step_core_start, step_core_commands, step_frame,
+};
+#define STEPS ((uint32_t)(sizeof(steps) / sizeof(steps[0]) - 1))
+
+/* everything the steps changed, back as it was found, in reverse (CX last: the clocks before their power) */
+static void
+put_back(void)
+{
+	step = 0;
+	gmu_stop();
+	if (undo_count == 0) {
+		return;
+	}
+	say("apollo gpu: putting back the %u registers the steps changed\n", undo_count);
+	while (undo_count > 0) {
+		struct undo *u = &undo[--undo_count];
+
+		put(u->b, u->name, u->offset, u->value);
+		if (u->b == &gpucc && u->offset == GPUCC_CX_GDSCR) {
+			for (int i = 0; i < 500 && (rd(gpucc.base + GPUCC_CX_GDSCR) & GDSC_POWER_ON); i++) {
+				sleep_us(100);
+			}
+			say("apollo gpu: CX is %s\n", rd(gpucc.base + GPUCC_CX_GDSCR) & GDSC_POWER_ON ? "still on" : "off again");
+		}
+	}
+}
+
+void
+apollo_adreno_init(void)
+{
+	uint32_t done = 0;
+
+	if (!PE_parse_boot_argn("apollo_gpu", &last_step, sizeof(last_step)) || last_step == 0) {
+		return;
+	}
+	PE_parse_boot_argn("apollo_gpu_pause", &pause_ms, sizeof(pause_ms));
+	PE_parse_boot_argn("apollo_gpu_keep", &keep, sizeof(keep));
+	PE_parse_boot_argn("apollo_gpu_speed", &speed_index, sizeof(speed_index));
+	PE_parse_boot_argn("apollo_gpu_use", &use, sizeof(use));
+	PE_parse_boot_argn("gpu_protect", &gpu_protect, sizeof(gpu_protect));    /* before step 18 maps the ring */
+	if (last_step > STEPS) {
+		say("apollo gpu: apollo_gpu=%u: there are %u steps so far\n", last_step, STEPS);
+		last_step = STEPS;
+	}
+	if (use) {
+		pause_ms = 0;                   /* nothing here is new any more: no waiting for the loader's notes */
+		if (last_step > 21) {
+			last_step = 21;         /* (no picture: the system draws) */
+		}
+	}
+	say("apollo gpu: the Adreno 650, steps 1 to %u\n", last_step);
+	for (step = 1; step <= last_step; step++) {
+		if (!steps[step]()) {
+			say("apollo gpu: STEP %u FAILED: stopping there\n", step);
+			break;
+		}
+		say("apollo gpu: step %u done\n", step);
+		done = step;
+	}
+	say("apollo gpu: %s: steps 1 to %u done\n", done == last_step ? "ALL DONE" : "stopped", done);
+	if (use && done >= 21 && core_runs) {
+		gpu_free[0].start = GPU_ADDRESSES_START;
+		gpu_free[0].size = GPU_ADDRESSES_SIZE;
+		gpu_free_count = 1;
+		bzero((void *)core_scratch.memory, 4096);
+		to_memory(core_scratch.memory, 4096);
+		PE_parse_boot_argn("gpu_exact", &gpu_exact, sizeof(gpu_exact));
+		PE_parse_boot_argn("gpu_log", &apollo_gpu_log, sizeof(apollo_gpu_log));
+		PE_parse_boot_argn("gpu_recover", &gpu_recover, sizeof(gpu_recover));
+		PE_parse_boot_argn("gpu_va", &apollo_gpu_va, sizeof(apollo_gpu_va));    /* before any client exists */
+		PE_parse_boot_argn("apollo_gpu_dcvs", &gpu_dcvs, sizeof(gpu_dcvs));
+		PE_parse_boot_argn("apollo_gpu_max", &gpu_max_level, sizeof(gpu_max_level));
+		gpu_max_level = gpu_max_level < 1 ? 1 : gpu_max_level > 6 ? 6 : gpu_max_level;
+		PE_parse_boot_argn("apollo_gpu_floor", &gpu_floor, sizeof(gpu_floor));    /* 0: no floor while frames come */
+		gpu_floor = gpu_floor > 6 ? 6 : gpu_floor;
+		gov_tm0 = ml_io_map(GOV_TSENS0_PHYS, 0x1000);
+		gov_level = speed_index >= 1 && speed_index <= 6 ? speed_index : 2;
+		{
+			lck_grp_t *group = lck_grp_alloc_init("apollo_gpu", LCK_GRP_ATTR_NULL);
+
+			gpu_times_lock = lck_mtx_alloc_init(group, LCK_ATTR_NULL);
+			gpu_hfi_lock = lck_mtx_alloc_init(group, LCK_ATTR_NULL);
+		}
+		gpu_kept = true;
+		if (gpu_dcvs) {
+			thread_t governor;
+
+			if (kernel_thread_start(gpu_governor_thread, NULL, &governor) == KERN_SUCCESS) {
+				thread_set_thread_name(governor, "apollo gpu governor");
+				thread_deallocate(governor);
+			}
+		}
+		quiet = true;
+		step = 0;
+		say("apollo gpu: THE GPU STAYS ON for the system to draw with: the service ApolloGPU\n");
+		ApolloGPUStart();
+		return;
+	}
+	if (use) {
+		say("apollo gpu: not kept: the steps did not get as far as a 3D core that takes commands; the system draws "
+		    "with its software renderer\n");
+	}
+	if (keep) {
+		say("apollo gpu: apollo_gpu_keep=1: what the steps turned on stays on (but the GMU is stopped)\n");
+		step = 0;
+		gmu_stop();
+	} else {
+		put_back();
+	}
+}
diff --git a/bsd/dev/hakios.apollo_adsp.c b/bsd/dev/hakios.apollo_adsp.c
new file mode 100644
index 000000000000..70cf12958b62
--- /dev/null
+++ b/bsd/dev/hakios.apollo_adsp.c
@@ -0,0 +1,3391 @@
+/*
+ * The audio DSP of the Xiaomi Mi 10T (apollo, SM8250), started, and spoken to: step 1 of the phone's sound. A copy of
+ * bsd/dev/hakios.adsp.c (the POCO X5 Pro's), kept apart from it, with apollo's numbers; nothing here runs unless the
+ * loader says the phone is apollo (device=apollo) and boot-arg apollo_audio=N or apollo_adsp_step=N asks for it.
+ *
+ * From the phone's own device tree, apollo differs from redwood in little on this side:
+ *   - the DSP's memory: reserved-memory pil_adsp_region@8bb00000, 0x2500000 (37 MB), memory-region of
+ *     qcom,lpass@17300000 (qcom,pas-id 1, qcom,smem-id 423, qcom,firmware-name "adsp")
+ *   - the channel apr_audio_svc of qcom,glink/adsp: intents of 0x200 bytes, 20 of them
+ * and is the same in the rest: SMEM at 0x80900000 (host 2 for the DSP), SMP2P items 443 (its) and 429 (ours) with
+ * "master-kernel"/"slave-kernel" bits as redwood's, the doorbells IPCC 0x408000 client 3 (signal 0 GLINK, 2 SMP2P),
+ * the always-on processor's mailbox qcom,qmp-aop@c300000 ("adsp-pil"), cmd-db at 0x80860000, the rails LCX and LMX
+ * at level 384 (pm8150 l11/l4 level), and the TCSR mutex 3 for the shared memory's allocations.
+ * The firmware is the phone's own, adsp.mdt and adsp.bNN from /vendor/firmware_mnt/image of its Android, in fw/ of the
+ * small image (fw-audio-apollo/ when it is built; never in the repository).
+ *
+ * What is the same as redwood's -- and that is all the rest -- is described below as hakios.adsp.c describes it,
+ * with the boot-args renamed: adsp_* is apollo_adsp_*, adsp=1 is apollo_audio=N (N >= 1).
+ *
+ * Boot-arg adsp_step=N performs steps 1 to N and stops; as with wifi_step, a step says what it is
+ * about to touch before it touches it, and a step that does not find what it needs ends the
+ * sequence. adsp=1 is all of them, on a thread beside the system's start.
+ *
+ *   1  reads   the shared memory: our partition with the DSP, its items, whether it has run
+ *              since the phone was started (its SMP2P item is there if so), its last words
+ *   2  reads   the firmware in the small image: is it whole, does it fit the reserved memory
+ *   3  writes  the always-on processor's mailbox open, unless it is (the Wi-Fi may have opened it)
+ *   4  asks    TrustZone to take the image's header (image 1) and where the image will be; a
+ *              DSP that a kernel before this one left running is asked to stop and shut down first
+ *   5  writes  the image into the DSP's memory, and reads it back
+ *   6  writes  our SMP2P item (429) into the shared memory, and our two marks of GLINK to zero
+ *   7  asks    RPMh for the DSP's rails, writes "apollo adsp: on" to the always-on processor, asks
+ *              TrustZone to authenticate and start the DSP, and watches for its first words
+ *              (answering in our item what SMP2P has us answer)
+ *   8  reads   GLINK's queues
+ *   9  writes  our side of GLINK: the versions, the channel "IPCRTR" opened both ways, our intents;
+ *              from here a thread of ours listens to the DSP
+ *  10  talks   QRTR on that channel: hello both ways, and the services the DSP tells of, written
+ *              down for adsp_listen seconds (default 3)
+ *  11  talks   APR, on the channel apr_audio_svc that the DSP opens and we answer as well: whether
+ *              the audio services are up, and which there are (see step_apr())
+ *
+ * Once everything is up with adsp=1, the sound's path takes over (hakios.sound.c, boot-arg sound=N):
+ * apollo_adsp_apr() is how it speaks to the audio services (any service, port and token; what
+ * nobody waits for goes to its handler of events), and it is stopped before the DSP is.
+ *
+ * What is started is stopped: when the steps are over (unless adsp_keep=1, and then when the run
+ * ends), and on a panic's way back to the loader. The DSP is asked first (bit 0 of our entry
+ * "master-kernel"), then TrustZone shuts it down, then the always-on processor hears "apollo adsp: off".
+ * A DSP that a kernel before this one left running is found by its item and treated the same way
+ * before this one is started; one that was shut down without having said it stopped is not
+ * started again unless adsp_again=1 (the Wi-Fi DSP reset the phone, twice, when that was tried).
+ *
+ * More boot-args: adsp_new=K (steps K on have not been seen to work, and wait adsp_pause=MS after
+ * each announcement, default 2200: what the loader needs to note the end of the log), adsp_wait=S
+ * (how long step 7 watches for "up", default 10), adsp_keep=1, adsp_again=1, adsp_return=1 (back
+ * to the loader when the steps are over).
+ *
+ * Nothing here writes a clock or changes a pin. One request goes to RPMh, as Linux makes it: the
+ * DSP's two rails, LCX and LMX, at level 384 while it boots, given back when it says it has asked
+ * for its own (see rails()).
+ *
+ * Addresses are from the phone's own device tree (qcom,lpass@17300000, qcom,smp2p-adsp,
+ * qcom,glink/adsp, qcom,ipcc@408000, power-controller@c300000, reserved-memory), layouts from
+ * Linux (see hakios.wifi.c for the files).
+ */
+#include <kern/clock.h>
+#include <kern/kalloc.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <os/atomic_private.h>
+#include <mach/mach_types.h>
+#include <mach/vm_param.h>
+#include <vm/memory_types.h>
+#include <pexpert/pexpert.h>
+#include <sys/errno.h>
+#include <sys/kauth.h>
+#include <sys/stat.h>
+#include <sys/systm.h>
+#include <sys/vnode.h>
+#include <sys/vnode_internal.h>
+#include <vm/vm_kern.h>
+#include <sys/hakios.audio.h>
+#include <sys/hakios.input.h>
+#include <sys/hakios.apollo_input.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t phys_addr, vm_size_t size, unsigned int flags);
+extern void ml_io_unmap(vm_offset_t addr, vm_size_t sz);
+extern uint64_t kvtophys(vm_offset_t va);
+extern void loader_return(void);
+extern kern_return_t thread_terminate(thread_t thread);
+extern vm_offset_t pe_arm_get_soc_base_phys(void);
+extern dev_t mdevlookup(int devid);
+extern int mdevgetkernelrange(dev_t dev, vm_offset_t *base, uint64_t *size);
+
+static LCK_GRP_DECLARE(adsp_lock_group, "apollo-adsp");
+
+/* (redwood shares these two with its Wi-Fi DSP, hakios.wifi.c; apollo's are its own) */
+static LCK_MTX_DECLARE(apollo_aop_mailbox_lock, &adsp_lock_group);
+static LCK_MTX_DECLARE(apollo_smem_alloc_lock, &adsp_lock_group);
+
+#define STEPS                   11
+
+static uint32_t last_step, pause_ms = 2200, listen_seconds = 3;
+static uint32_t step;                   /* the one being performed */
+static uint32_t new_from;               /* the first of the steps that have not been seen to work: they wait */
+static char last_write[96] = "nothing written";
+static bool leaving;                    /* on the way back to the loader after a panic: no lock is taken, nothing sleeps */
+
+/*
+ * Every line goes to the log the loader reads from another core as well (as in hakios.wifi.c);
+ * with adsp=1 only the few that say how it went (tell()), the rest to the kernel's own log.
+ */
+extern void loader_log_putc(char c);
+
+static LCK_MTX_DECLARE(say_lock, &adsp_lock_group);
+static bool quiet;
+
+static void
+say_line(const char *line, bool aloud)
+{
+	if (leaving) {
+		for (const char *c = line; *c != 0; c++) {
+			loader_log_putc(*c);
+		}
+		return;
+	}
+	lck_mtx_lock(&say_lock);
+	if (!quiet || aloud) {
+		for (const char *c = line; *c != 0; c++) {
+			loader_log_putc(*c);
+		}
+	}
+	printf("%s", line);
+	lck_mtx_unlock(&say_lock);
+}
+
+static int say(const char *format, ...) __printflike(1, 2);
+static int tell(const char *format, ...) __printflike(1, 2);
+
+static int
+say(const char *format, ...)
+{
+	char line[400];
+	va_list list;
+	int length;
+
+	va_start(list, format);
+	length = vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
+	say_line(line, false);
+	return length;
+}
+
+static int
+tell(const char *format, ...)
+{
+	char line[400];
+	va_list list;
+	int length;
+
+	va_start(list, format);
+	length = vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
+	say_line(line, true);
+	return length;
+}
+#define printf say
+
+static void
+sleep_us(uint32_t us)
+{
+	delay_for_interval(us, NSEC_PER_USEC);
+}
+
+static void
+sleep_ms(uint32_t ms)
+{
+	delay_for_interval(ms, NSEC_PER_MSEC);
+}
+
+static uint64_t
+now_us(void)
+{
+	uint64_t nanoseconds;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &nanoseconds);
+	return nanoseconds / 1000;
+}
+
+/* Until every write to memory so far has been carried out. */
+static void
+settle(void)
+{
+	__asm__ volatile ("dsb sy");
+}
+
+static bool
+option(const char *name)
+{
+	uint32_t value = 0;
+
+	return PE_parse_boot_argn(name, &value, sizeof(value)) && value != 0;
+}
+
+/* ---- register access (as in hakios.wifi.c) ------------------------------------------------------- */
+
+static uint32_t __attribute__((noinline))
+rd(vm_offset_t address)
+{
+	uint32_t value;
+
+	__asm__ volatile ("ldr %w0, [%1]" : "=r" (value) : "r" (address) : "memory");
+	return value;
+}
+
+static void __attribute__((noinline))
+wr(vm_offset_t address, uint32_t value)
+{
+	__asm__ volatile ("str %w0, [%1]" : : "r" (value), "r" (address) : "memory");
+}
+
+struct block {
+	const char *name;
+	uint32_t phys, size;
+	vm_offset_t base;
+};
+
+static void
+need(struct block *b)
+{
+	if (b->base == 0) {
+		b->base = ml_io_map(b->phys, b->size);
+	}
+}
+
+/* Time for the loader to note what has just been said, where it is not yet known to be harmless. */
+static void
+hold(void)
+{
+	if (step >= new_from && pause_ms && !leaving) {
+		sleep_ms(pause_ms);
+	}
+}
+
+static void
+announce(const char *what)
+{
+	printf("apollo adsp: step %u: %s\n", step, what);
+	hold();
+}
+
+static uint32_t
+get(struct block *b, const char *name, uint32_t offset)
+{
+	uint32_t value;
+
+	need(b);
+	value = rd(b->base + offset);
+	printf("apollo adsp: %u: %s %s (%#x) = %#x\n", step, b->name, name, b->phys + offset, value);
+	return value;
+}
+
+static void
+put(struct block *b, const char *name, uint32_t offset, uint32_t value)
+{
+	need(b);
+	printf("apollo adsp: %u: about to write %s %s at %#x: %#x\n", step, b->name, name, b->phys + offset, value);
+	snprintf(last_write, sizeof(last_write), "step %u wrote %#x to %s %s at %#x", step, value, b->name, name, b->phys + offset);
+	wr(b->base + offset, value);
+}
+
+/* ---- the shared memory (hakios.wifi.c, step 1) --------------------------------------------------- */
+
+#define SMEM_PHYS               0x80900000UL
+#define SMEM_SIZE               0x00200000u
+#define SMEM_US                 0
+#define SMEM_ADSP               2               /* dt: qcom,remote-pid of qcom,smp2p-adsp and qcom,glink/adsp */
+#define SMEM_GLOBAL             0xfffe
+#define SMEM_CANARY             0xa5a5
+
+struct smem_table_entry {
+	uint32_t offset, size, flags;
+	uint16_t host0, host1;
+	uint32_t cacheline, reserved[7];
+};
+struct smem_table {
+	uint8_t magic[4];
+	uint32_t version, count, reserved[5];
+};
+struct smem_partition {
+	uint8_t magic[4];
+	uint16_t host0, host1;
+	uint32_t size, free_uncached, free_cached, reserved[3];
+};
+struct smem_entry {
+	uint16_t canary, item;
+	uint32_t size;
+	uint16_t padding_data, padding_header;
+	uint32_t reserved;
+};
+struct smem_item {
+	uint32_t item, offset, size;
+};
+
+/*
+ * The DSP's items (dt: qcom,smem of qcom,smp2p-adsp, <443 429>: the item the DSP writes first, then
+ * ours -- the Wi-Fi's <617 616> are in the same order; taken the other way round, the DSP made
+ * our item its own and never said "up" --, and qcom,smem-id of qcom,lpass@17300000).
+ */
+#define ITEM_SMP2P_OURS         429
+#define ITEM_SMP2P_THEIRS       443
+#define ITEM_CRASH_REASON       423
+
+static const volatile uint8_t *smem;
+
+static bool
+smem_peek(uint64_t offset, void *to, uint32_t size)
+{
+	if (smem == NULL) {
+		smem = (const volatile uint8_t *)ml_io_map_unmappable(SMEM_PHYS, SMEM_SIZE, VM_WIMG_WCOMB);
+	}
+	if (offset + size > SMEM_SIZE) {
+		return false;
+	}
+	for (uint32_t i = 0; i < size; i++) {
+		((uint8_t *)to)[i] = smem[offset + i];
+	}
+	return true;
+}
+
+static void
+smem_poke(uint32_t offset, uint32_t value)
+{
+	wr((vm_offset_t)smem + offset, value);
+}
+
+static uint32_t
+smem_word(uint32_t offset)
+{
+	return rd((vm_offset_t)smem + offset);
+}
+
+static uint32_t
+smem_partition(uint16_t one, uint16_t other, uint32_t *cacheline, uint32_t *size)
+{
+	struct smem_table table;
+	struct smem_table_entry entry;
+	struct smem_partition header;
+
+	if (!smem_peek(SMEM_SIZE - 0x1000, &table, sizeof(table)) || memcmp(table.magic, "$TOC", 4) != 0 || table.version != 1 ||
+	    table.count > 64) {
+		return 0;
+	}
+	for (uint32_t i = 0; i < table.count; i++) {
+		if (!smem_peek(SMEM_SIZE - 0x1000 + sizeof(table) + i * sizeof(entry), &entry, sizeof(entry)) || entry.offset == 0 ||
+		    entry.size == 0) {
+			continue;
+		}
+		if (!((entry.host0 == one && entry.host1 == other) || (entry.host0 == other && entry.host1 == one))) {
+			continue;
+		}
+		if ((uint64_t)entry.offset + entry.size > SMEM_SIZE - 0x1000 || !smem_peek(entry.offset, &header, sizeof(header)) ||
+		    memcmp(header.magic, "$PRT", 4) != 0 || header.size != entry.size) {
+			return 0;
+		}
+		*cacheline = entry.cacheline;
+		*size = entry.size;
+		return entry.offset;
+	}
+	return 0;
+}
+
+static unsigned
+smem_items(uint32_t partition, uint32_t cacheline, struct smem_item *found, unsigned max)
+{
+	struct smem_partition header;
+	struct smem_entry entry;
+	uint32_t at, step_back;
+	unsigned count = 0;
+
+	if (partition == 0 || !smem_peek(partition, &header, sizeof(header)) || header.free_uncached > header.size ||
+	    header.free_cached > header.size) {
+		return 0;
+	}
+	for (at = sizeof(header); at + sizeof(entry) <= header.free_uncached;) {
+		if (!smem_peek(partition + at, &entry, sizeof(entry)) || entry.canary != SMEM_CANARY || entry.size > header.size ||
+		    entry.padding_data > entry.size) {
+			break;          /* (a padding larger than the item: not an entry; its size would wrap) */
+		}
+		if (count < max) {
+			found[count].item = entry.item;
+			found[count].offset = partition + at + sizeof(entry) + entry.padding_header;
+			found[count].size = entry.size - entry.padding_data;
+		}
+		count++;
+		at += sizeof(entry) + entry.padding_header + entry.size;
+	}
+	if (cacheline == 0 || (cacheline & (cacheline - 1))) {
+		return count;
+	}
+	step_back = ((uint32_t)sizeof(entry) + cacheline - 1) & ~(cacheline - 1);
+	for (at = header.size - step_back; at > header.free_cached && at < header.size;) {
+		if (!smem_peek(partition + at, &entry, sizeof(entry)) || entry.canary != SMEM_CANARY || entry.size > at ||
+		    entry.padding_data > entry.size) {
+			break;
+		}
+		if (count < max) {
+			found[count].item = entry.item;
+			found[count].offset = partition + at - entry.size;
+			found[count].size = entry.size - entry.padding_data;
+		}
+		count++;
+		if (entry.size + step_back > at) {
+			break;
+		}
+		at -= entry.size + step_back;
+	}
+	return count;
+}
+
+/* An item the DSP and we share: in the partition of the two, or else in the global one. Where it is; 0: nowhere. */
+static uint32_t
+smem_item(uint32_t item, uint32_t *size)
+{
+	static struct smem_item found[256];
+	static const uint16_t hosts[2][2] = { { SMEM_US, SMEM_ADSP }, { SMEM_GLOBAL, SMEM_GLOBAL } };
+
+	for (unsigned h = 0; h < 2; h++) {
+		uint32_t cacheline = 0, partition_size = 0;
+		uint32_t partition = smem_partition(hosts[h][0], hosts[h][1], &cacheline, &partition_size);
+		unsigned count = smem_items(partition, cacheline, found, 256);
+
+		for (unsigned i = 0; i < count && i < 256; i++) {
+			if (found[i].item == item) {
+				if ((uint64_t)found[i].offset + found[i].size > SMEM_SIZE) {
+					return 0;       /* (an item said to reach past the shared memory: not trusted) */
+				}
+				*size = found[i].size;
+				return found[i].offset;
+			}
+		}
+	}
+	return 0;
+}
+
+static void
+show_partition(void)
+{
+	static struct smem_item found[256];
+	struct smem_partition header;
+	uint32_t cacheline = 0, size = 0, partition = smem_partition(SMEM_US, SMEM_ADSP, &cacheline, &size);
+	unsigned count;
+	char line[320];
+
+	if (partition == 0 || !smem_peek(partition, &header, sizeof(header))) {
+		printf("apollo adsp: %u: there is no partition for us and the audio DSP (0 and 2)\n", step);
+		return;
+	}
+	count = smem_items(partition, cacheline, found, 256);
+	printf("apollo adsp: %u: the partition for us and the audio DSP (0 and 2): at %#lx, %#x bytes, of which %#x free; %u items\n", step,
+	    SMEM_PHYS + partition, size, header.free_cached - header.free_uncached, count);
+	for (unsigned i = 0; i < count && i < 256;) {
+		int at = 0;
+
+		for (unsigned n = 0; n < 12 && i < count && i < 256; n++, i++) {
+			at += snprintf(line + at, sizeof(line) - (size_t)at, " %u (%u)", found[i].item, found[i].size);
+		}
+		printf("apollo adsp: %u:   items (bytes):%s\n", step, line);
+	}
+}
+
+/* ---- SMP2P ---------------------------------------------------------------------------------------- */
+
+struct smp2p {
+	uint32_t magic;
+	uint32_t version;
+	uint16_t local, remote, total, valid;
+	uint32_t flags;
+	struct {
+		char name[16];
+		uint32_t value;
+	} entry[16];
+};
+#define SMP2P_MAGIC             0x504d5324
+#define SMP2P_VERSION           1
+#define SMP2P_RESTART_ACKS      1u
+#define SMP2P_RESTART_DONE      (1u << 0)
+#define SMP2P_RESTART_ACK       (1u << 1)
+#define SMP2P_AT_VERSION        4
+#define SMP2P_AT_PROCESSORS     8
+#define SMP2P_AT_COUNTS         12
+#define SMP2P_AT_FLAGS          16
+#define SMP2P_AT_NAME(i)        (20 + 20 * (i))
+#define SMP2P_AT_VALUE(i)       (36 + 20 * (i))
+
+/* The bits of the DSP's entry "slave-kernel" (dt: the interrupts of qcom,lpass@17300000). */
+#define DSP_FATAL               (1u << 0)
+#define DSP_READY               (1u << 1)
+#define DSP_HANDOVER            (1u << 2)
+#define DSP_STOP_ACK            (1u << 3)
+#define DSP_SHUTDOWN_ACK        (1u << 7)
+
+/* Our entry (dt: the child "master-kernel" of qcom,smp2p-adsp; "qcom,force-stop" of qcom,lpass@17300000). */
+#define OUR_ENTRY_STOP          "master-kernel"
+#define DSP_STOP                (1u << 0)
+
+static bool
+dsp_words(struct smp2p *words)
+{
+	static uint32_t at;
+	uint32_t size = 0;
+
+	if (at == 0) {
+		at = smem_item(ITEM_SMP2P_THEIRS, &size);
+		if (at == 0 || size < sizeof(*words)) {
+			at = 0;
+			return false;
+		}
+	}
+	return smem_peek(at, words, sizeof(*words)) && words->magic == SMP2P_MAGIC;
+}
+
+static int
+smp2p_entry(const struct smp2p *words, const char *name)
+{
+	for (unsigned i = 0; i < words->valid && i < 16; i++) {
+		if (strncmp(words->entry[i].name, name, sizeof(words->entry[i].name)) == 0) {
+			return (int)i;
+		}
+	}
+	return -1;
+}
+
+static uint32_t
+dsp_state(const struct smp2p *words)
+{
+	int entry = smp2p_entry(words, "slave-kernel");
+
+	return entry < 0 ? 0 : words->entry[entry].value;
+}
+
+static void
+show_words(const char *prefix, const struct smp2p *words)
+{
+	char line[320];
+	int at = 0;
+
+	line[0] = 0;
+	for (unsigned i = 0; i < words->valid && i < 16 && at < (int)sizeof(line) - 40; i++) {
+		at += snprintf(line + at, sizeof(line) - (size_t)at, " %.16s = %#x;", words->entry[i].name, words->entry[i].value);
+	}
+	printf("apollo adsp: %u: %s: SMP2P version %u, features %#x, from processor %u to %u, flags %#x, %u of %u entries:%s\n", step, prefix,
+	    words->version & 0xff, words->version >> 8, words->local, words->remote, words->flags, words->valid, words->total, line);
+}
+
+static void
+show_crash_reason(void)
+{
+	char text[81];
+	uint32_t size = 0, at = smem_item(ITEM_CRASH_REASON, &size);
+
+	if (at == 0 || size == 0) {
+		printf("apollo adsp: %u: item %u, the DSP's last words: not there\n", step, ITEM_CRASH_REASON);
+		return;
+	}
+	bzero(text, sizeof(text));
+	smem_peek(at, text, size < sizeof(text) - 1 ? size : sizeof(text) - 1);
+	if (text[0] == 0) {
+		printf("apollo adsp: %u: item %u, the DSP's last words (%u bytes): none\n", step, ITEM_CRASH_REASON, size);
+	} else {
+		printf("apollo adsp: %u: THE AUDIO DSP'S LAST WORDS (item %u, %u bytes): \"%s\"\n", step, ITEM_CRASH_REASON, size, text);
+	}
+}
+
+/* ---- the doorbells, and the mailbox to the always-on processor (hakios.wifi.c, steps 2 and 7) ------ */
+
+#define QMP_MAGIC               0x00
+#define QMP_MAGIC_VALUE         0x4d41494c
+#define QMP_VERSION             0x04
+#define QMP_THEIR_LINK          0x0c
+#define QMP_THEIR_LINK_ACK      0x10
+#define QMP_THEIR_CHANNEL       0x14
+#define QMP_THEIR_CHANNEL_ACK   0x18
+#define QMP_OUR_LINK            0x24
+#define QMP_OUR_LINK_ACK        0x28
+#define QMP_OUR_CHANNEL         0x2c
+#define QMP_OUR_CHANNEL_ACK     0x30
+#define QMP_OUR_BOX_SIZE        0x34
+#define QMP_OUR_BOX             0x38
+#define QMP_UP                  0x0000ffffu
+#define QMP_DOWN                0xffff0000u
+#define QMP_MESSAGE             64
+
+static struct block aoss = { "mailbox", 0x0c300000, 0x400 };
+
+#define IPCC_SEND               0x0c
+#define IPCC_RECEIVED           0x10
+#define IPCC_ENABLE             0x14
+#define IPCC_DISABLE            0x18
+#define IPCC_CLEAR              0x1c
+#define IPCC_NOBODY             0xffffffffu
+#define IPCC_AOP                0u
+#define IPCC_LPASS              3u              /* dt: mboxes of qcom,smp2p-adsp and qcom,glink/adsp */
+#define IPCC_GLINK              0u
+#define IPCC_SMP2P              2u
+
+static struct block ipcc = { "ipcc", 0x00408000, 0x1000 };
+
+static struct {
+	uint32_t glink, smp2p, said;
+	uint64_t since;
+} doorbell;
+
+/*
+ * The audio DSP's rings, counted and cleared. Another's ring (the Wi-Fi DSP's, the always-on
+ * processor's) is left for whoever listens for it: IPCC names the same one until it is cleared,
+ * so the look ends there.
+ */
+static void
+doorbells(void)
+{
+	for (unsigned i = 0; i < 8; i++) {
+		uint32_t who = rd(ipcc.base + IPCC_RECEIVED);
+
+		if (who == IPCC_NOBODY || who >> 16 != IPCC_LPASS) {
+			return;
+		}
+		wr(ipcc.base + IPCC_CLEAR, who);
+		doorbell.glink += (who & 0xffff) == IPCC_GLINK;
+		doorbell.smp2p += (who & 0xffff) == IPCC_SMP2P;
+		if (doorbell.said < 24) {
+			uint64_t now = now_us() - doorbell.since;
+
+			doorbell.said++;
+			printf("apollo adsp: doorbell: +%llu.%03llu ms: signal %u of the audio DSP; heard and cleared\n", now / 1000, now % 1000,
+			    who & 0xffff);
+		}
+	}
+}
+
+static uint32_t our_box;                /* where in the message memory our mailbox is; 0: not open */
+
+static bool
+mailbox_wait(uint32_t offset, uint32_t value, uint32_t ms)
+{
+	for (uint32_t i = 0; i < ms * 10; i++) {
+		if (rd(aoss.base + offset) == value) {
+			return true;
+		}
+		sleep_us(100);
+	}
+	return rd(aoss.base + offset) == value;
+}
+
+static void
+ring_aop(void)
+{
+	wr(ipcc.base + IPCC_SEND, IPCC_AOP << 16 | 0);
+}
+
+/* Linux's qmp_open(), as hakios.wifi.c does it; what is done already is found done. Under the mailbox's lock. */
+static bool
+mailbox_open(void)
+{
+	uint32_t box, size;
+
+	need(&aoss);
+	need(&ipcc);
+	if (get(&aoss, "magic", QMP_MAGIC) != QMP_MAGIC_VALUE || get(&aoss, "version", QMP_VERSION) != 1) {
+		printf("apollo adsp: %u: not a mailbox this knows\n", step);
+		return false;
+	}
+	box = get(&aoss, "our mailbox", QMP_OUR_BOX);
+	size = get(&aoss, "our mailbox's size", QMP_OUR_BOX_SIZE);
+	if (size < QMP_MESSAGE + 4 || box < 0x3c || box + size > aoss.size || (box & 3)) {
+		printf("apollo adsp: %u: our mailbox is not where a message fits\n", step);
+		return false;
+	}
+	if (rd(aoss.base + QMP_OUR_LINK) == QMP_UP && rd(aoss.base + QMP_OUR_LINK_ACK) == QMP_UP &&
+	    rd(aoss.base + QMP_OUR_CHANNEL) == QMP_UP && rd(aoss.base + QMP_THEIR_CHANNEL) == QMP_UP &&
+	    rd(aoss.base + QMP_OUR_CHANNEL_ACK) == QMP_UP) {
+		printf("apollo adsp: %u: the mailbox is open already (the Wi-Fi's start, or a kernel before this one, opened it)\n", step);
+		our_box = box;
+		return true;
+	}
+	put(&aoss, "their link, seen by us", QMP_THEIR_LINK_ACK, rd(aoss.base + QMP_THEIR_LINK));
+	put(&aoss, "our link", QMP_OUR_LINK, QMP_UP);
+	ring_aop();
+	if (!mailbox_wait(QMP_OUR_LINK_ACK, QMP_UP, 1000)) {
+		printf("apollo adsp: %u: THE ALWAYS-ON PROCESSOR DOES NOT ACKNOWLEDGE OUR LINK within a second; taken down again\n", step);
+		put(&aoss, "our link", QMP_OUR_LINK, QMP_DOWN);
+		ring_aop();
+		return false;
+	}
+	put(&aoss, "our channel", QMP_OUR_CHANNEL, QMP_UP);
+	ring_aop();
+	if (!mailbox_wait(QMP_THEIR_CHANNEL, QMP_UP, 1000)) {
+		printf("apollo adsp: %u: THE ALWAYS-ON PROCESSOR DOES NOT OPEN ITS CHANNEL within a second; ours is taken down again\n", step);
+		put(&aoss, "our channel", QMP_OUR_CHANNEL, QMP_DOWN);
+		put(&aoss, "our link", QMP_OUR_LINK, QMP_DOWN);
+		ring_aop();
+		return false;
+	}
+	put(&aoss, "their channel, seen by us", QMP_THEIR_CHANNEL_ACK, QMP_UP);
+	ring_aop();
+	if (!mailbox_wait(QMP_OUR_CHANNEL_ACK, QMP_UP, 1000)) {
+		printf("apollo adsp: %u: THE ALWAYS-ON PROCESSOR DOES NOT ACKNOWLEDGE OUR CHANNEL within a second; taken down again\n", step);
+		put(&aoss, "our channel", QMP_OUR_CHANNEL, QMP_DOWN);
+		put(&aoss, "our link", QMP_OUR_LINK, QMP_DOWN);
+		ring_aop();
+		return false;
+	}
+	printf("apollo adsp: %u: THE MAILBOX TO THE ALWAYS-ON PROCESSOR IS OPEN\n", step);
+	our_box = box;
+	return true;
+}
+
+/* A message to the always-on processor (Linux's qmp_send()), under the lock the Wi-Fi's start takes too. */
+static bool
+mailbox_send(const char *text)
+{
+	uint32_t words[QMP_MESSAGE / 4] = { 0 };
+	bool sent = false;
+
+	if (!leaving) {
+		lck_mtx_lock(&apollo_aop_mailbox_lock);
+	}
+	if (our_box == 0 && (leaving || !mailbox_open())) {
+		goto out;
+	}
+	strlcpy((char *)words, text, sizeof(words));
+	printf("apollo adsp: %u: about to tell the always-on processor \"%s\"\n", step, text);
+	snprintf(last_write, sizeof(last_write), "step %u sent the always-on processor a message", step);
+	if (rd(aoss.base + our_box) != 0) {
+		printf("apollo adsp: %u: our mailbox still holds a message of %u bytes: not sent\n", step, rd(aoss.base + our_box));
+		goto out;
+	}
+	for (unsigned i = 0; i < QMP_MESSAGE / 4; i++) {
+		wr(aoss.base + our_box + 4 + 4 * i, words[i]);
+	}
+	wr(aoss.base + our_box, QMP_MESSAGE);
+	(void)rd(aoss.base + our_box);
+	ring_aop();
+	if (!mailbox_wait(our_box, 0, 1000)) {
+		printf("apollo adsp: %u: THE ALWAYS-ON PROCESSOR DOES NOT TAKE THE MESSAGE within a second; it is taken back\n", step);
+		wr(aoss.base + our_box, 0);
+		goto out;
+	}
+	printf("apollo adsp: %u: the always-on processor has taken it\n", step);
+	sent = true;
+out:
+	if (!leaving) {
+		lck_mtx_unlock(&apollo_aop_mailbox_lock);
+	}
+	return sent;
+}
+
+/* ---- RPMh: the DSP's two rails, asked for while it boots ------------------------------------------------ */
+
+/*
+ * The audio DSP's logic and memories run from LPASS's own rails, LCX and LMX (dt: vdd_cx and
+ * vdd_mx of qcom,lpass@17300000 are PM8150 L11 and L4 "level" regulators, RPMh resources lcx.lvl and
+ * lmx.lvl), which the boot loader leaves at retention (16). Linux and Android ask for level 384
+ * while the DSP boots, until it says it has asked for its own (bit 2, "proxy-unvote"); without it
+ * the DSP rang once and left "SFR Init: wdog or kernel error suspected." in its last words.
+ *
+ * A request goes to RPMh through the application processor's sequencer (dt: rsc@18200000, DRV 2,
+ * qcom,tcs-offset 0xd00, qcom,tcs-config: TCSs 0 and 1 are for requests made at once), as Linux's
+ * rpmh-rsc.c writes one: the command's message id, address and value into a TCS that is idle, the
+ * command enabled and marked to be waited for, the TCS put in "active" mode and triggered, and its
+ * bit in the status of completions looked for. A rail asked for by level is asked by position in
+ * the list of its levels that the boot loader's command database keeps (cmd-db.c), the first
+ * position at or above the level wanted.
+ */
+#define CMD_DB_PHYS             0x80860000UL
+#define CMD_DB_SIZE             0x20000UL
+
+struct cmd_db_slave {
+	uint16_t id, header_offset, data_offset, count, version, reserved[3];
+};
+struct cmd_db_header {
+	uint32_t version;
+	uint8_t magic[4];
+	struct cmd_db_slave slave[8];
+	uint32_t checksum, reserved;
+	uint8_t data[];
+};
+struct cmd_db_entry {
+	char id[8];
+	uint32_t priority[2];
+	uint32_t address;
+	uint16_t length, offset;
+};
+
+static const struct cmd_db_header *cmd_db;
+
+static struct block rsc = { "rsc", 0x18220000, 0x10000 };
+#define RSC_TCS_BASE            0xd00
+#define RSC_IRQ_STATUS          (RSC_TCS_BASE + 0x04)   /* a bit per TCS: done */
+#define RSC_IRQ_CLEAR           (RSC_TCS_BASE + 0x08)
+#define RSC_TCS(n)              (RSC_TCS_BASE + 672 * (n))
+#define TCS_WAIT_FOR_DONE       0x10
+#define TCS_CONTROL             0x14
+#define TCS_STATUS              0x18                    /* not zero: idle */
+#define TCS_ENABLED             0x1c
+#define TCS_COMMAND(c)          (0x30 + 20 * (c))       /* message id, address, value, status */
+#define TCS_ACTIVE_MODE         (1u << 16)
+#define TCS_TRIGGER             (1u << 24)
+#define MSGID_WRITE_WAITED      (8u | 1u << 8 | 1u << 16)       /* four bytes, an answer wanted, a write */
+#define RPMH_TCS                0                       /* the first of the two for requests made at once */
+
+/* The level position RPMh takes for that rail and level; -1: not found. */
+static int
+rail_position(const char *name, uint32_t level, uint32_t *address)
+{
+	char id[8] = { 0 };
+
+	if (cmd_db == NULL) {
+		cmd_db = (const struct cmd_db_header *)ml_io_map_unmappable(CMD_DB_PHYS, CMD_DB_SIZE, VM_WIMG_WCOMB);
+	}
+	if (!(cmd_db->magic[0] == 0xdb && cmd_db->magic[1] == 0x30 && cmd_db->magic[2] == 0x03 && cmd_db->magic[3] == 0x0c)) {
+		printf("apollo adsp: %u: the boot loader's command database is not there\n", step);
+		return -1;
+	}
+	strlcpy(id, name, sizeof(id));
+	for (unsigned s = 0; s < 8; s++) {
+		const struct cmd_db_slave *slave = &cmd_db->slave[s];
+		const struct cmd_db_entry *entry = (const struct cmd_db_entry *)(cmd_db->data + slave->header_offset);
+
+		if (slave->id == 0 || slave->count > 512) {
+			continue;
+		}
+		for (unsigned i = 0; i < slave->count; i++) {
+			const uint8_t *data;
+			char levels[160];
+			int at;
+
+			if (memcmp(entry[i].id, id, sizeof(id)) != 0) {
+				continue;
+			}
+			if ((unsigned)slave->data_offset + entry[i].offset + entry[i].length > CMD_DB_SIZE - 0x1000) {
+				return -1;
+			}
+			data = cmd_db->data + slave->data_offset + entry[i].offset;
+			at = snprintf(levels, sizeof(levels), "%s at %#x, levels:", name, entry[i].address);
+			for (unsigned l = 0; l < entry[i].length / 2u && l < 16; l++) {
+				unsigned value = data[2 * l] | data[2 * l + 1] << 8;
+
+				if (l > 0 && value == 0) {
+					break;
+				}
+				at += snprintf(levels + at, sizeof(levels) - (size_t)at, " %u", value);
+			}
+			printf("apollo adsp: %u: RPMh has %s\n", step, levels);
+			for (unsigned l = 0; l < entry[i].length / 2u && l < 16; l++) {
+				if ((uint32_t)(data[2 * l] | data[2 * l + 1] << 8) >= level) {
+					*address = entry[i].address;
+					return (int)l;
+				}
+			}
+			return -1;
+		}
+	}
+	printf("apollo adsp: %u: RPMh has no \"%s\"\n", step, name);
+	return -1;
+}
+
+/* The two rails at that level (Linux's proxy request), or given back (level 0). True: RPMh has said done. */
+static bool
+rails(uint32_t level)
+{
+	static const char *const names[2] = { "lcx.lvl", "lmx.lvl" };
+	uint32_t addresses[2] = { 0, 0 }, values[2] = { 0, 0 }, done = 0;
+	uint64_t began;
+
+	for (unsigned r = 0; r < 2; r++) {
+		int position = level == 0 ? 0 : rail_position(names[r], level, &addresses[r]);
+
+		if (level == 0) {
+			rail_position(names[r], 0, &addresses[r]);
+		}
+		if (position < 0 || addresses[r] == 0) {
+			printf("apollo adsp: %u: no position for %s at level %u: the rails are not asked\n", step, names[r], level);
+			return false;
+		}
+		values[r] = (uint32_t)position;
+	}
+	need(&rsc);
+	/* (the boot loader leaves the trigger set after its last request, done: idle is what the status says) */
+	if (rd(rsc.base + RSC_TCS(RPMH_TCS) + TCS_STATUS) == 0) {
+		printf("apollo adsp: %u: TCS %u of the sequencer is busy (status %#x, control %#x): the rails are not asked\n", step, RPMH_TCS,
+		    rd(rsc.base + RSC_TCS(RPMH_TCS) + TCS_STATUS), rd(rsc.base + RSC_TCS(RPMH_TCS) + TCS_CONTROL));
+		return false;
+	}
+	printf("apollo adsp: %u: about to ask RPMh, through TCS %u, for lcx.lvl (%#x) = %u and lmx.lvl (%#x) = %u (level %u%s)\n", step,
+	    RPMH_TCS, addresses[0], values[0], addresses[1], values[1], level, level == 0 ? ": given back" : "");
+	snprintf(last_write, sizeof(last_write), "step %u asked RPMh for the audio DSP's rails at level %u", step, level);
+	hold();
+	wr(rsc.base + RSC_IRQ_CLEAR, 1u << RPMH_TCS);
+	for (unsigned r = 0; r < 2; r++) {
+		wr(rsc.base + RSC_TCS(RPMH_TCS) + TCS_COMMAND(r), MSGID_WRITE_WAITED);
+		wr(rsc.base + RSC_TCS(RPMH_TCS) + TCS_COMMAND(r) + 4, addresses[r]);
+		wr(rsc.base + RSC_TCS(RPMH_TCS) + TCS_COMMAND(r) + 8, values[r]);
+	}
+	wr(rsc.base + RSC_TCS(RPMH_TCS) + TCS_WAIT_FOR_DONE, 3);
+	wr(rsc.base + RSC_TCS(RPMH_TCS) + TCS_ENABLED, 3);
+	settle();
+	wr(rsc.base + RSC_TCS(RPMH_TCS) + TCS_CONTROL, rd(rsc.base + RSC_TCS(RPMH_TCS) + TCS_CONTROL) & ~TCS_TRIGGER);
+	wr(rsc.base + RSC_TCS(RPMH_TCS) + TCS_CONTROL, rd(rsc.base + RSC_TCS(RPMH_TCS) + TCS_CONTROL) | TCS_ACTIVE_MODE);
+	wr(rsc.base + RSC_TCS(RPMH_TCS) + TCS_CONTROL, rd(rsc.base + RSC_TCS(RPMH_TCS) + TCS_CONTROL) | TCS_TRIGGER);
+	began = now_us();
+	while (now_us() - began < 100000) {
+		done = rd(rsc.base + RSC_IRQ_STATUS) & (1u << RPMH_TCS);
+		if (done) {
+			break;
+		}
+		sleep_us(50);
+	}
+	printf("apollo adsp: %u: RPMh %s after %llu us; the commands' status %#x %#x, the TCS's %#x\n", step, done ? "HAS DONE IT" :
+	    "HAS NOT SAID DONE", now_us() - began, rd(rsc.base + RSC_TCS(RPMH_TCS) + TCS_COMMAND(0) + 12),
+	    rd(rsc.base + RSC_TCS(RPMH_TCS) + TCS_COMMAND(1) + 12), rd(rsc.base + RSC_TCS(RPMH_TCS) + TCS_STATUS));
+	wr(rsc.base + RSC_IRQ_CLEAR, 1u << RPMH_TCS);
+	wr(rsc.base + RSC_TCS(RPMH_TCS) + TCS_CONTROL, rd(rsc.base + RSC_TCS(RPMH_TCS) + TCS_CONTROL) & ~(TCS_TRIGGER | TCS_ACTIVE_MODE));
+	wr(rsc.base + RSC_TCS(RPMH_TCS) + TCS_ENABLED, 0);
+	return done != 0;
+}
+
+/* ---- step 1: the shared memory --------------------------------------------------------------------- */
+
+static bool
+step_survey(void)
+{
+	struct smp2p words;
+	uint32_t size = 0;
+
+	announce("read our partition with the audio DSP in the shared memory (0x80900000), and its items");
+	show_partition();
+	if (dsp_words(&words)) {
+		show_words("the DSP's item (443) is there: it has run since the phone was started", &words);
+	} else {
+		printf("apollo adsp: %u: the DSP's SMP2P item (443) is not there: it has not run since the phone was started\n", step);
+	}
+	printf("apollo adsp: %u: our SMP2P item (429): %s; GLINK's descriptor (478): %s, our queue (479): %s, the DSP's (480): %s\n", step,
+	    smem_item(ITEM_SMP2P_OURS, &size) ? "there" : "not there", smem_item(478, &size) ? "there" : "NOT THERE",
+	    smem_item(479, &size) ? "there" : "NOT THERE", smem_item(480, &size) ? "there" : "not there (the DSP makes it)");
+	show_crash_reason();
+	need(&ipcc);
+	printf("apollo adsp: %u: the doorbells say %#x\n", step, rd(ipcc.base + IPCC_RECEIVED));
+	return smem_partition(SMEM_US, SMEM_ADSP, &size, &size) != 0;
+}
+
+/* ---- step 2: the firmware -------------------------------------------------------------------------- */
+
+#define ADSP_MEMORY             0x8bb00000u     /* dt: pil_adsp_region@8bb00000, memory-region of qcom,lpass@17300000 */
+#define ADSP_MEMORY_SIZE        0x02500000u
+#define PAS_ADSP                1               /* dt: qcom,pas-id */
+
+
+/*
+ * A file of /fw on the root file system, read whole into memory of ours: the system image, where
+ * userland/build.sh puts fw-audio/ when it makes that image. It is compressed there, which the file
+ * system undoes and the reading of the small image's memory below does not; and it is there only
+ * once the root is mounted, so only adsp=1, which waits for that on its own thread, finds it so.
+ */
+static const uint8_t *
+root_file(const char *name, uint64_t *size)
+{
+	char path[64];
+	vfs_context_t context = vfs_context_kernel();
+	vnode_t vnode = NULLVP;
+	struct vnode_attr attributes;
+	uint8_t *data;
+	int left = 0, error;
+
+	if (rootvnode == NULLVP) {
+		return NULL;
+	}
+	snprintf(path, sizeof(path), "/fw/%s", name);
+	if (vnode_lookup(path, 0, &vnode, context) != 0) {
+		return NULL;
+	}
+	VATTR_INIT(&attributes);
+	VATTR_WANTED(&attributes, va_data_size);
+	if (vnode_getattr(vnode, &attributes, context) != 0 || attributes.va_data_size == 0 ||
+	    attributes.va_data_size > ADSP_MEMORY_SIZE) {
+		vnode_put(vnode);
+		return NULL;
+	}
+	data = kalloc_data(attributes.va_data_size, Z_WAITOK);
+	if (data == NULL) {
+		vnode_put(vnode);
+		return NULL;
+	}
+	error = vn_rdwr(UIO_READ, vnode, (caddr_t)data, (int)attributes.va_data_size, 0, UIO_SYSSPACE, 0,
+	    vfs_context_ucred(context), &left, vfs_context_proc(context));
+	vnode_put(vnode);
+	if (error != 0 || left != 0) {
+		printf("apollo adsp: %u: %s: read error %d, %d bytes left\n", step, path, error, left);
+		kfree_data(data, attributes.va_data_size);
+		return NULL;
+	}
+	*size = attributes.va_data_size;
+	return data;
+}
+
+/* For the sound (hakios.sound.c): a file of /fw on the root, read whole into memory of ours, and given back. */
+const uint8_t *
+apollo_adsp_fw_file(const char *name, uint64_t *size)
+{
+	return root_file(name, size);
+}
+
+void
+apollo_adsp_fw_free(const uint8_t *data, uint64_t size)
+{
+	uint8_t *ours = __DECONST(uint8_t *, data);
+
+	kfree_data(ours, size);
+}
+
+/*
+ * A file of fw/ in the small image (ADSP=1 userland/build.sh puts fw-audio/ there), else of /fw on the root (above).
+ * *ours says which: a file of the root is in memory of ours, of *size bytes, to be given back once written; one of the
+ * small image is the small image's own memory, never given back. (Each file says so for itself: the header may be of
+ * the one and a segment of the other.)
+ */
+extern const uint8_t *hakios_image_file(const char *dir, const char *name, uint64_t *size, int *disk_out);
+static const uint8_t *
+image_file(const char *name, uint64_t *size, bool *ours)
+{
+	*ours = false;
+	{
+		const uint8_t *data = hakios_image_file("fw", name, size, NULL);  /* (hakios.image.c) */
+
+		if (data != NULL) {
+			return data;
+		}
+	}
+	{
+		const uint8_t *data = root_file(name, size);
+
+		if (data != NULL) {
+			*ours = true;
+			return data;
+		}
+	}
+	printf("apollo adsp: %u: no fw/%s in the small image nor on the root: put the phone's /vendor/firmware_mnt/image/%s into "
+	    "fw-audio/ and run SYSTEM=1 userland/build.sh (or ADSP=1, for the small image)\n", step, name, name);
+	return NULL;
+}
+
+
+#define MDT_HASH(flags)         (((flags) >> 24 & 7) == 2)
+#define MAX_SEGMENTS            48
+
+struct elf_segment {
+	uint32_t type, offset, vaddr, paddr, file_size, memory_size, flags, align;
+};
+
+static struct {
+	const uint8_t *header;
+	uint64_t header_size;
+	bool header_ours;               /* read from the root into memory of ours (image_file()): given back, header_size bytes */
+	struct {
+		uint32_t at;
+		uint32_t file_size, memory_size;
+		const uint8_t *file;
+		bool ours;              /* as header_ours, of read bytes (what was allocated, not what the header says) */
+		uint64_t read;
+	} segment[MAX_SEGMENTS];
+	unsigned segments;
+	uint32_t size;
+} image;
+
+/* The image's files given back, those that were read into memory of ours (the small image's are its own). */
+static void
+image_forget(void)
+{
+	if (image.header != NULL && image.header_ours) {
+		void *data = (void *)(uintptr_t)image.header;
+
+		kfree_data(data, image.header_size);
+	}
+	for (unsigned s = 0; s < image.segments && s < MAX_SEGMENTS; s++) {
+		if (image.segment[s].file != NULL && image.segment[s].ours) {
+			void *data = (void *)(uintptr_t)image.segment[s].file;
+
+			kfree_data(data, image.segment[s].read);
+		}
+	}
+	bzero(&image, sizeof(image));
+}
+
+static bool
+step_firmware(void)
+{
+	struct elf_segment segment;
+	const uint8_t *header;
+	uint64_t size = 0, files = 0;
+	uint32_t count, hashes = 0, lowest = ~0u, highest = 0, base = ADSP_MEMORY, linked = ~0u;
+	bool relocatable = false;
+
+	announce("find the audio DSP's image in the small image or on the root, and check it against its own header");
+	image_forget();
+	image.segments = 0;
+	header = image_file("adsp.mdt", &size, &image.header_ours);
+	if (header == NULL) {
+		return false;
+	}
+	image.header = header;
+	image.header_size = size;
+	count = size >= 52 + 2 * 32 ? header[44] | header[45] << 8 : 0;
+	if (memcmp(header, "\177ELF\1", 5) != 0 || count < 3 || count > MAX_SEGMENTS || 52 + 32 * count > size || size > PAGE_SIZE) {
+		printf("apollo adsp: %u: fw/adsp.mdt is not such a header (%02x %02x %02x %02x, %u segments, %llu bytes)\n", step, header[0],
+		    header[1], header[2], header[3], count, size);
+		goto fail;
+	}
+	/*
+	 * Apollo's image is linked at 0x89500000 and the DSP's memory is at 0x8bb00000: its loadable segments say they are
+	 * relocatable (bit 27 of their flags, Linux mdt_loader.c's QCOM_MDT_RELOCATABLE), and go where the memory is, each
+	 * at the same distance from the lowest of them as it was linked (qcom_mdt_load(): mem_reloc).
+	 */
+	for (uint32_t i = 0; i < count; i++) {
+		memcpy(&segment, header + 52 + 32 * i, sizeof(segment));
+		if (segment.type == 1 && !MDT_HASH(segment.flags) && segment.memory_size != 0) {
+			relocatable |= (segment.flags & (1u << 27)) != 0;
+			linked = segment.paddr < linked ? segment.paddr : linked;
+		}
+	}
+	if (relocatable) {
+		base = linked;
+	}
+	for (uint32_t i = 0; i < count; i++) {
+		char name[16];
+
+		memcpy(&segment, header + 52 + 32 * i, sizeof(segment));
+		if (MDT_HASH(segment.flags)) {
+			hashes = segment.file_size;
+		}
+		if (segment.type != 1 || MDT_HASH(segment.flags) || segment.memory_size == 0) {
+			continue;
+		}
+		if (segment.paddr < base || segment.file_size > segment.memory_size ||
+		    (uint64_t)segment.paddr - base + segment.memory_size > ADSP_MEMORY_SIZE) {
+			printf("apollo adsp: %u: segment %u (%#x, %#x bytes) is not within the DSP's memory\n", step, i, segment.paddr,
+			    segment.memory_size);
+			goto fail;
+		}
+		image.segment[image.segments].at = segment.paddr - base;
+		image.segment[image.segments].file_size = segment.file_size;
+		image.segment[image.segments].memory_size = segment.memory_size;
+		image.segment[image.segments].file = NULL;
+		image.segment[image.segments].ours = false;
+		image.segment[image.segments].read = 0;
+		if (segment.file_size != 0) {
+			uint64_t file_size = 0;
+
+			snprintf(name, sizeof(name), "adsp.b%02u", i);
+			image.segment[image.segments].file = image_file(name, &file_size, &image.segment[image.segments].ours);
+			if (image.segment[image.segments].file == NULL) {
+				goto fail;
+			}
+			image.segment[image.segments].read = file_size;
+			if (file_size != segment.file_size) {
+				printf("apollo adsp: %u: fw/%s has %llu bytes, the header says %u\n", step, name, file_size, segment.file_size);
+				image.segments++;               /* (for its file to be given back, of the bytes read) */
+				goto fail;
+			}
+			files += file_size;
+		}
+		lowest = segment.paddr < lowest ? segment.paddr : lowest;
+		highest = segment.paddr + segment.memory_size > highest ? segment.paddr + segment.memory_size : highest;
+		image.segments++;
+	}
+	if (image.segments == 0 || lowest != base || 52 + 32 * count + (uint64_t)hashes != size) {
+		printf("apollo adsp: %u: not what TrustZone takes: %u segments to load, the lowest at %#x; the header file has %llu bytes, "
+		    "the header %u and the hashes %u\n", step, image.segments, lowest, size, 52 + 32 * count, hashes);
+		goto fail;
+	}
+	image.header = header;
+	image.header_size = size;
+	image.size = ((highest + 0xfff) & ~0xfffu) - base;
+	if (relocatable) {
+		printf("apollo adsp: %u: the image is relocatable: linked at %#x, put at %#x\n", step, base, ADSP_MEMORY);
+	}
+	printf("apollo adsp: %u: the image is whole (%s): a header of %llu bytes (%u of hashes), %u segments, %llu bytes of files, %#x "
+	    "bytes of the DSP's %#x from %#x\n", step, image.header_ours ? "from /fw on the root" : "from the small image", size, hashes,
+	    image.segments, files, image.size, ADSP_MEMORY_SIZE, ADSP_MEMORY);
+	return true;
+fail:
+	image_forget();
+	image.segments = 0;
+	return false;
+}
+
+/* ---- step 3: the mailbox --------------------------------------------------------------------------- */
+
+static bool
+step_mailbox(void)
+{
+	bool open;
+
+	announce("open the mailbox to the always-on processor, unless it is open: words of its message memory, and its doorbell");
+	lck_mtx_lock(&apollo_aop_mailbox_lock);
+	open = mailbox_open();
+	lck_mtx_unlock(&apollo_aop_mailbox_lock);
+	return open;
+}
+
+/* ---- TrustZone, and stopping the DSP --------------------------------------------------------------- */
+
+#define SCM_64                  (1ull << 30)
+#define SCM_SIP                 (2ull << 24)
+#define SCM_CALL(service, command) ((uint64_t)(service) << 8 | (command))
+#define SCM_PAS_INIT_IMAGE      SCM_CALL(2, 1)
+#define SCM_PAS_MEM_SETUP       SCM_CALL(2, 2)
+#define SCM_PAS_AUTH_AND_RESET  SCM_CALL(2, 5)
+#define SCM_PAS_SHUTDOWN        SCM_CALL(2, 6)
+#define SCM_ONE_VALUE           1
+#define SCM_THREE_VALUES        3
+#define SCM_VALUE_AND_BUFFER    (2 | 2 << 6)
+#define SCM_INTERRUPTED         1
+
+static LCK_MTX_DECLARE(dsp_lock, &adsp_lock_group);     /* the DSP being started or stopped */
+static bool rails_asked;                /* our request for its rails stands (until it asks for its own, or is shut down) */
+static bool dsp_started;
+static bool image_taken;                /* TrustZone holds the image's header (step 4): given back (PAS shutdown) if never started */
+static bool stopped_by_its_word;
+static uint32_t our_item;
+static bool smp2p_agreed, smp2p_restart_acks, smp2p_restart_acked;
+
+static int32_t
+scm(const char *what, uint64_t function, uint64_t arguments, uint64_t first, uint64_t second, uint64_t third, uint64_t *answer)
+{
+	uint64_t session = 0;
+
+	function |= SCM_64 | SCM_SIP;
+	printf("apollo adsp: %u: about to ask TrustZone %s: smc %#llx, arguments %#llx, %#llx, %#llx\n", step, what, function, first,
+	    second, third);
+	snprintf(last_write, sizeof(last_write), "step %u asked TrustZone %#llx(%#llx, %#llx)", step, function, first, second);
+	for (int i = 0; i < 100; i++) {
+		register uint64_t x0 __asm__("x0") = i == 0 ? function : SCM_INTERRUPTED;
+		register uint64_t x1 __asm__("x1") = arguments;
+		register uint64_t x2 __asm__("x2") = first;
+		register uint64_t x3 __asm__("x3") = second;
+		register uint64_t x4 __asm__("x4") = third;
+		register uint64_t x5 __asm__("x5") = 0;
+		register uint64_t x6 __asm__("x6") = session;
+		register uint64_t x7 __asm__("x7") = 0;
+
+		__asm__ volatile ("smc #0" : "+r" (x0), "+r" (x1), "+r" (x2), "+r" (x3), "+r" (x4), "+r" (x5), "+r" (x6),
+		    "+r" (x7) : : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+		session = x6;
+		if (x0 != SCM_INTERRUPTED) {
+			printf("apollo adsp: %u: TrustZone returns %d, answer %#llx\n", step, (int32_t)x0, x1);
+			*answer = x1;
+			return (int32_t)x0;
+		}
+	}
+	printf("apollo adsp: %u: TrustZone keeps saying the call was interrupted\n", step);
+	return -1;
+}
+
+static uint32_t
+our_item_find(void)
+{
+	uint32_t size = 0, at = smem_item(ITEM_SMP2P_OURS, &size);
+
+	return at != 0 && size >= sizeof(struct smp2p) ? at : 0;
+}
+
+/* What Linux does when the DSP rings for SMP2P: agree on the features once, and answer a restart. */
+static void
+dsp_listen(const struct smp2p *theirs)
+{
+	struct smp2p ours;
+
+	if (our_item == 0 || !smem_peek(our_item, &ours, sizeof(ours)) || ours.magic != SMP2P_MAGIC) {
+		return;
+	}
+	if (!smp2p_agreed) {
+		uint32_t features = (ours.version >> 8) & (theirs->version >> 8);
+
+		if ((theirs->version & 0xff) != (ours.version & 0xff)) {
+			return;
+		}
+		if (features != ours.version >> 8) {
+			smem_poke(our_item + SMP2P_AT_VERSION, features << 8 | (ours.version & 0xff));
+		}
+		smp2p_restart_acks = features & SMP2P_RESTART_ACKS;
+		smp2p_agreed = true;
+		printf("apollo adsp: %u: the DSP and we agree on SMP2P: version %u, features %#x\n", step, ours.version & 0xff, features);
+	}
+	if (smp2p_restart_acks && ((theirs->flags & SMP2P_RESTART_DONE) != 0) != smp2p_restart_acked) {
+		smp2p_restart_acked = !smp2p_restart_acked;
+		printf("apollo adsp: %u: the DSP's flags say it has restarted (%#x): answered in our flags (bit 1 = %u), and its SMP2P doorbell\n",
+		    step, theirs->flags, smp2p_restart_acked);
+		smem_poke(our_item + SMP2P_AT_FLAGS, (ours.flags & ~SMP2P_RESTART_ACK) | (smp2p_restart_acked ? SMP2P_RESTART_ACK : 0));
+		settle();
+		wr(ipcc.base + IPCC_SEND, IPCC_LPASS << 16 | IPCC_SMP2P);
+	}
+}
+
+/* Linux's qcom_q6v5_request_stop(): our bit "stop", the DSP's "stop ack" waited for, our bit taken back. */
+static bool
+dsp_ask_to_stop(uint32_t bound_ms)
+{
+	struct smp2p ours, theirs;
+	uint32_t at = our_item_find(), state, value_at;
+	uint64_t asked, now;
+	int entry = -1;
+
+	if (at == 0 || !smem_peek(at, &ours, sizeof(ours)) || ours.magic != SMP2P_MAGIC || (ours.version & 0xff) != SMP2P_VERSION ||
+	    (entry = smp2p_entry(&ours, OUR_ENTRY_STOP)) < 0) {
+		printf("apollo adsp: %u: the DSP is not asked to stop first: there is no SMP2P item of ours to ask it with\n", step);
+		return false;
+	}
+	if (!dsp_words(&theirs) || smp2p_entry(&theirs, "slave-kernel") < 0) {
+		printf("apollo adsp: %u: the DSP is not asked to stop first: its item has no entry to answer in\n", step);
+		return false;
+	}
+	state = dsp_state(&theirs);
+	if (state & DSP_STOP_ACK) {
+		printf("apollo adsp: %u: the DSP is not asked to stop: its entry says %#x, that it has stopped when asked before\n", step, state);
+		return true;
+	}
+	if (!(state & DSP_READY) || (state & DSP_FATAL)) {
+		printf("apollo adsp: %u: the DSP is not asked to stop first: its entry says %#x, not \"up\"\n", step, state);
+		return false;
+	}
+	need(&ipcc);
+	value_at = at + SMP2P_AT_VALUE((uint32_t)entry);
+	printf("apollo adsp: %u: about to ask the DSP to stop: bit 0 of our entry \"%s\" at %#lx, and its SMP2P doorbell\n", step,
+	    OUR_ENTRY_STOP, SMEM_PHYS + value_at);
+	snprintf(last_write, sizeof(last_write), "step %u asked the audio DSP to stop", step);
+	smem_poke(value_at, ours.entry[entry].value | DSP_STOP);
+	settle();
+	wr(ipcc.base + IPCC_SEND, IPCC_LPASS << 16 | IPCC_SMP2P);
+	asked = now = now_us();
+	while (now - asked < bound_ms * 1000ull) {
+		if (dsp_words(&theirs) && (dsp_state(&theirs) & (DSP_STOP_ACK | DSP_FATAL))) {
+			break;
+		}
+		sleep_us(200);
+		now = now_us();
+	}
+	state = dsp_words(&theirs) ? dsp_state(&theirs) : 0;
+	printf("apollo adsp: %u: %s after %llu.%03llu ms; its entry says %#x\n", step, state & DSP_STOP_ACK ?
+	    "THE AUDIO DSP ACKNOWLEDGES THE STOP" : "THE AUDIO DSP DOES NOT ACKNOWLEDGE THE STOP", (now - asked) / 1000,
+	    (now - asked) % 1000, state);
+	smem_poke(value_at, ours.entry[entry].value & ~DSP_STOP);
+	settle();
+	wr(ipcc.base + IPCC_SEND, IPCC_LPASS << 16 | IPCC_SMP2P);
+	return (state & DSP_STOP_ACK) != 0;
+}
+
+static void link_stop(void);
+
+/* Asked to stop, then shut down by TrustZone, then the always-on processor told that the image is gone. */
+static bool
+dsp_shutdown(const char *why)
+{
+	uint64_t answer = ~0ull;
+	int32_t result;
+
+	printf("apollo adsp: %u: %s: the audio DSP is asked to stop, then TrustZone to shut it down\n", step, why);
+	if (!leaving) {
+		link_stop();
+	}
+	stopped_by_its_word = dsp_ask_to_stop(leaving ? 2000 : 5000);
+	result = scm("to shut the audio DSP down", SCM_PAS_SHUTDOWN, SCM_ONE_VALUE, PAS_ADSP, 0, 0, &answer);
+	if (result != 0 || answer != 0) {
+		printf("apollo adsp: %u: TRUSTZONE DOES NOT SHUT THE AUDIO DSP DOWN: the call returns %d, its answer is %#llx\n", step, result,
+		    answer);
+		return false;
+	}
+	printf("apollo adsp: %u: THE AUDIO DSP IS SHUT DOWN\n", step);
+	image_taken = false;
+	need(&ipcc);
+	wr(ipcc.base + IPCC_DISABLE, IPCC_LPASS << 16 | IPCC_SMP2P);
+	doorbells();
+	dsp_started = false;
+	mailbox_send("{class: image, res: load_state, name: adsp, val: off}");
+	if (rails_asked) {
+		rails(0);
+		rails_asked = false;
+	}
+	return true;
+}
+
+/* ---- step 4: TrustZone takes the header ------------------------------------------------------------ */
+
+static bool
+step_header(void)
+{
+	struct smp2p words;
+	vm_offset_t page = 0;
+	uint64_t answer = ~0ull;
+	int32_t result;
+
+	if (image.segments == 0) {
+		return false;
+	}
+	if (dsp_words(&words)) {
+		show_words("the DSP has left words in the shared memory", &words);
+		announce("ask TrustZone to shut down an audio DSP that a kernel before this one may have left running");
+		if (!dsp_shutdown("it may be running")) {
+			return false;
+		}
+		if (!stopped_by_its_word && !option("apollo_adsp_again")) {
+			printf("apollo adsp: %u: THE AUDIO DSP IS NOT STARTED AGAIN: it was shut down without having acknowledged a stop, and "
+			    "with the Wi-Fi's DSP a start after that reset the phone (adsp_again=1 to try all the same)\n", step);
+			return false;
+		}
+	} else {
+		printf("apollo adsp: %u: the DSP has left nothing in the shared memory: it has not run since the phone was started\n", step);
+	}
+
+	announce("hand the image's header to TrustZone to check its signature (image 1), in a page of ours");
+	if (kmem_alloc(kernel_map, &page, PAGE_SIZE, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("apollo adsp: %u: no memory\n", step);
+		return false;
+	}
+	memcpy((void *)page, image.header, image.header_size);
+	for (vm_offset_t line = page; line < page + PAGE_SIZE; line += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (line));
+	}
+	settle();
+	result = scm("to take the audio DSP's header", SCM_PAS_INIT_IMAGE, SCM_VALUE_AND_BUFFER, PAS_ADSP, kvtophys(page), 0, &answer);
+	/* (TrustZone has copied what it keeps of the header by now, as the boot loader's PIL frees it then too: the page given back) */
+	kmem_free(kernel_map, page, PAGE_SIZE);
+	if (result != 0 || answer != 0) {
+		printf("apollo adsp: %u: TRUSTZONE DOES NOT TAKE THE HEADER: the call returns %d, its answer is %#llx\n", step, result, answer);
+		return false;
+	}
+	printf("apollo adsp: %u: TRUSTZONE ACCEPTS THE AUDIO DSP'S SIGNATURE FROM THIS KERNEL\n", step);
+	image_taken = true;                     /* (from here, a DSP that is not started is given back to TrustZone: steps_over()) */
+
+	announce("tell TrustZone where the image will be");
+	result = scm("where the image will be", SCM_PAS_MEM_SETUP, SCM_THREE_VALUES, PAS_ADSP, ADSP_MEMORY, image.size, &answer);
+	if (result != 0 || answer != 0) {
+		printf("apollo adsp: %u: TRUSTZONE DOES NOT TAKE THE PLACE: the call returns %d, its answer is %#llx\n", step, result, answer);
+		return false;
+	}
+	printf("apollo adsp: %u: TrustZone takes the place: %#x bytes at %#x\n", step, image.size, ADSP_MEMORY);
+	return true;
+}
+
+/* ---- step 5: the image, in the DSP's memory --------------------------------------------------------- */
+
+static bool image_written;
+
+static uint64_t
+segment_word(unsigned s, uint32_t at)
+{
+	uint64_t word = 0;
+
+	for (unsigned b = 0; b < 8 && at + b < image.segment[s].file_size; b++) {
+		word |= (uint64_t)image.segment[s].file[at + b] << (8 * b);
+	}
+	return word;
+}
+
+static bool
+step_image(void)
+{
+	volatile uint64_t *dsp_memory;
+	uint64_t written = 0, cleared = 0, wrong = 0;
+
+	if (image.segments == 0) {
+		return false;
+	}
+	announce("put the image's segments into the audio DSP's memory (0x8bb00000, 37 MB: memory of nobody's until TrustZone "
+	    "starts the DSP), with zeroes where a segment is longer than its file, and read them back");
+	dsp_memory = (volatile uint64_t *)ml_io_map_unmappable(ADSP_MEMORY, ADSP_MEMORY_SIZE, VM_WIMG_WCOMB);
+	snprintf(last_write, sizeof(last_write), "step %u wrote the image at %#x", step, ADSP_MEMORY);
+	for (unsigned s = 0; s < image.segments; s++) {
+		volatile uint64_t *to = dsp_memory + image.segment[s].at / 8;
+
+		/* (a segment's end is rounded up to eight bytes, zeroes: apollo's last one with a file is 0x7c bytes long) */
+		if (image.segment[s].at & 7) {
+			printf("apollo adsp: %u: a segment that does not begin at a multiple of eight bytes: not written\n", step);
+			ml_io_unmap((vm_offset_t)dsp_memory, ADSP_MEMORY_SIZE);
+			return false;
+		}
+		for (uint32_t i = 0; i < image.segment[s].memory_size; i += 8) {
+			to[i / 8] = segment_word(s, i);         /* (i < memory_size: the last word may reach past it, by up to 7) */
+		}
+		written += image.segment[s].file_size;
+		cleared += image.segment[s].memory_size - image.segment[s].file_size;
+	}
+	settle();
+	for (unsigned s = 0; s < image.segments; s++) {
+		volatile uint64_t *from = dsp_memory + image.segment[s].at / 8;
+
+		for (uint32_t i = 0; i < image.segment[s].memory_size; i += 8) {
+			wrong += from[i / 8] != segment_word(s, i);
+		}
+	}
+	printf("apollo adsp: %u: %u segments, %llu bytes written and %llu cleared; read back, %llu words of eight bytes differ\n", step,
+	    image.segments, written, cleared, wrong);
+	settle();
+	ml_io_unmap((vm_offset_t)dsp_memory, ADSP_MEMORY_SIZE);
+	image_written = wrong == 0;
+	image_forget();                         /* (it is in the DSP's memory now: what was read of the root, given back) */
+	return image_written;
+}
+
+/* ---- step 6: our SMP2P item ------------------------------------------------------------------------ */
+
+static struct block smem_lock = { "shared memory's lock", 0x01f43000, 0x1000 };
+#define LOCK_OWNER              0x000
+#define LOCK_US                 1u
+
+/* Our item made in the partition, as Linux's qcom_smem_alloc_private() makes one (hakios.wifi.c: our_item_make()). */
+static bool
+item_make(uint32_t partition, uint32_t item, uint32_t wanted)
+{
+	struct smem_partition header;
+	struct smem_entry entry;
+	const uint32_t item_size = (wanted + 7) & ~7u, need_bytes = sizeof(entry) + item_size;
+	uint32_t owner = ~0u, at;
+	bool made = false;
+
+	lck_mtx_lock(&apollo_smem_alloc_lock);         /* (the Wi-Fi's start allocates under the same hardware lock) */
+	need(&smem_lock);
+	printf("apollo adsp: %u: about to take the lock (%#x), write an entry for item %u with %u bytes behind it at the partition's mark, "
+	    "move the mark by %u, and release the lock\n", step, smem_lock.phys + LOCK_OWNER, item, item_size, need_bytes);
+	snprintf(last_write, sizeof(last_write), "step %u took the shared memory's lock", step);
+	for (uint32_t ms = 0; ms <= 1000; ms++) {
+		wr(smem_lock.base + LOCK_OWNER, LOCK_US);
+		owner = rd(smem_lock.base + LOCK_OWNER);
+		if (owner == LOCK_US) {
+			break;
+		}
+		sleep_ms(1);
+	}
+	if (owner != LOCK_US) {
+		printf("apollo adsp: %u: THE LOCK IS HELD BY PROCESSOR %u AND STAYS SO FOR A SECOND: nothing is written\n", step, owner);
+		lck_mtx_unlock(&apollo_smem_alloc_lock);
+		return false;
+	}
+	if (!smem_peek(partition, &header, sizeof(header)) || header.free_uncached > header.free_cached ||
+	    header.free_cached > header.size) {
+		printf("apollo adsp: %u: the partition's marks make no sense: nothing is written\n", step);
+		goto out;
+	}
+	for (at = sizeof(header); at < header.free_uncached;) {
+		if (!smem_peek(partition + at, &entry, sizeof(entry)) || entry.canary != SMEM_CANARY || entry.item == item ||
+		    entry.size > header.size) {
+			break;
+		}
+		at += sizeof(entry) + entry.padding_header + entry.size;
+	}
+	if (at != header.free_uncached) {
+		printf("apollo adsp: %u: the partition's entries do not end at its mark (+%#x, the mark is +%#x), or the item has appeared: "
+		    "nothing is written\n", step, at, header.free_uncached);
+		goto out;
+	}
+	if (at + need_bytes > header.free_cached) {
+		printf("apollo adsp: %u: no room: %u bytes wanted, %u free: nothing is written\n", step, need_bytes, header.free_cached - at);
+		goto out;
+	}
+	smem_poke(partition + at, SMEM_CANARY | item << 16);
+	smem_poke(partition + at + 4, item_size);
+	smem_poke(partition + at + 8, item_size - wanted);
+	smem_poke(partition + at + 12, 0);
+	settle();
+	smem_poke(partition + __offsetof(struct smem_partition, free_uncached), at + need_bytes);
+	settle();
+	made = true;
+out:
+	wr(smem_lock.base + LOCK_OWNER, 0);
+	printf("apollo adsp: %u: the lock is released (it reads %u)\n", step, rd(smem_lock.base + LOCK_OWNER));
+	lck_mtx_unlock(&apollo_smem_alloc_lock);
+	return made;
+}
+
+static bool
+our_item_make(uint32_t partition)
+{
+	return item_make(partition, ITEM_SMP2P_OURS, sizeof(struct smp2p));
+}
+
+static void glink_reset(void);
+
+static bool
+step_our_item(void)
+{
+	struct smem_partition header;
+	struct smp2p ours;
+	uint32_t cacheline = 0, size = 0, partition, name[4] = { 0 };
+
+	announce("look for an SMP2P item of ours (429) in our partition with the audio DSP, make it if there is none, and fill it in");
+	partition = smem_partition(SMEM_US, SMEM_ADSP, &cacheline, &size);
+	if (partition == 0 || !smem_peek(partition, &header, sizeof(header))) {
+		printf("apollo adsp: %u: there is no such partition\n", step);
+		return false;
+	}
+	our_item = our_item_find();
+	if (our_item != 0) {
+		printf("apollo adsp: %u: item %u is there, at %#lx: a kernel before this one made it, and it is used again\n", step,
+		    ITEM_SMP2P_OURS, SMEM_PHYS + our_item);
+	} else {
+		if (!our_item_make(partition)) {
+			return false;
+		}
+		our_item = our_item_find();
+		if (our_item == 0) {
+			printf("apollo adsp: %u: THE ITEM IS NOT FOUND where it was just made\n", step);
+			return false;
+		}
+		printf("apollo adsp: %u: item %u made, at %#lx\n", step, ITEM_SMP2P_OURS, SMEM_PHYS + our_item);
+	}
+	/* zeroes; from processor 0 to 2, room for 16 entries, "master-kernel" at zero, feature bit 0; last the version */
+	snprintf(last_write, sizeof(last_write), "step %u filled in our SMP2P item", step);
+	for (uint32_t at = 0; at < sizeof(ours); at += 4) {
+		smem_poke(our_item + at, 0);
+	}
+	settle();
+	smem_poke(our_item, SMP2P_MAGIC);
+	smem_poke(our_item + SMP2P_AT_PROCESSORS, SMEM_US | SMEM_ADSP << 16);
+	strlcpy((char *)name, OUR_ENTRY_STOP, sizeof(name));
+	for (uint32_t word = 0; word < 4; word++) {
+		smem_poke(our_item + SMP2P_AT_NAME(0) + 4 * word, name[word]);
+	}
+	smem_poke(our_item + SMP2P_AT_COUNTS, 16 | 1u << 16);
+	smem_poke(our_item + SMP2P_AT_VERSION, SMP2P_RESTART_ACKS << 8);
+	settle();
+	smem_poke(our_item + SMP2P_AT_VERSION, SMP2P_RESTART_ACKS << 8 | SMP2P_VERSION);
+	settle();
+	smp2p_agreed = smp2p_restart_acks = smp2p_restart_acked = false;
+	need(&ipcc);
+	wr(ipcc.base + IPCC_SEND, IPCC_LPASS << 16 | IPCC_SMP2P);
+	if (!smem_peek(our_item, &ours, sizeof(ours)) || ours.magic != SMP2P_MAGIC || smp2p_entry(&ours, OUR_ENTRY_STOP) < 0) {
+		printf("apollo adsp: %u: OUR ITEM DOES NOT READ BACK AS WRITTEN\n", step);
+		return false;
+	}
+	show_words("our item reads back", &ours);
+	glink_reset();
+	return true;
+}
+
+/* ---- step 7: the DSP, started ---------------------------------------------------------------------- */
+
+/*
+ * Android's kernel (this phone, dmesg): the image loaded at 8.92 s, "brought out of reset" at
+ * 9.10, "error ready" 40 ms later; the audio services' protection domain up at 9.39.
+ * Here (runs 085341 and later): the DSP's SMP2P item appears 17 ms after TrustZone returns, with
+ * a ring of its SMP2P and GLINK doorbells; at 41 ms "slave-kernel" says 6, up and asking for its
+ * own power, and our request for the rails is given back; at 2.2 s it adds "sleepstate_see".
+ * Asked to stop, it acknowledges within 25 ms (0x10e), and it starts again in the same session.
+ */
+static bool
+step_start(void)
+{
+	struct smp2p words, last;
+	uint64_t answer = ~0ull, started, now, ready_at = 0, limit;
+	uint32_t state = 0, rang, changes = 0, wait_seconds = 10;
+	int32_t result;
+	bool have, spoke = false, handed_over = false;
+
+	if (!image_written) {
+		printf("apollo adsp: %u: the image is not in place\n", step);
+		return false;
+	}
+	PE_parse_boot_argn("apollo_adsp_wait", &wait_seconds, sizeof(wait_seconds));
+	bzero(&last, sizeof(last));
+	have = dsp_words(&last);
+	announce("listen for the audio DSP's doorbells, ask RPMh for its rails, tell the always-on processor that its image is "
+	    "loaded, and ask TrustZone to authenticate the image and let the DSP out of reset");
+	need(&ipcc);
+	for (unsigned i = 0; i < 8 && (rang = rd(ipcc.base + IPCC_RECEIVED)) != IPCC_NOBODY && rang >> 16 == IPCC_LPASS; i++) {
+		put(&ipcc, "heard", IPCC_CLEAR, rang);
+	}
+	put(&ipcc, "listened for", IPCC_ENABLE, IPCC_LPASS << 16 | IPCC_SMP2P);
+	put(&ipcc, "listened for", IPCC_ENABLE, IPCC_LPASS << 16 | IPCC_GLINK);
+	bzero(&doorbell, sizeof(doorbell));
+	lck_mtx_lock(&dsp_lock);
+	if (!rails(384)) {
+		lck_mtx_unlock(&dsp_lock);
+		return false;
+	}
+	rails_asked = true;
+	if (!mailbox_send("{class: image, res: load_state, name: adsp, val: on}")) {
+		rails(0);
+		rails_asked = false;
+		lck_mtx_unlock(&dsp_lock);
+		return false;
+	}
+	result = scm("to authenticate the audio DSP's image and start it", SCM_PAS_AUTH_AND_RESET, SCM_ONE_VALUE, PAS_ADSP, 0, 0,
+	    &answer);
+	doorbell.since = started = now_us();
+	image_written = false;
+	if (result != 0 || answer != 0) {
+		printf("apollo adsp: %u: TRUSTZONE DOES NOT START THE AUDIO DSP: the call returns %d, its answer is %#llx\n", step, result,
+		    answer);
+		mailbox_send("{class: image, res: load_state, name: adsp, val: off}");
+		rails(0);
+		rails_asked = false;
+		lck_mtx_unlock(&dsp_lock);
+		return false;
+	}
+	dsp_started = true;
+	lck_mtx_unlock(&dsp_lock);
+	printf("apollo adsp: %u: TRUSTZONE HAS AUTHENTICATED THE IMAGE AND LET THE AUDIO DSP OUT OF RESET; watching for %u s\n", step,
+	    wait_seconds);
+	limit = started + wait_seconds * 1000000ull;
+	for (;;) {
+		now = now_us();
+		if (now >= limit || !dsp_started) {
+			break;
+		}
+		doorbells();
+		spoke = spoke || doorbell.glink + doorbell.smp2p != 0;
+		if (dsp_words(&words) && (!have || memcmp(&words, &last, sizeof(words)) != 0)) {
+			char when[64];
+
+			snprintf(when, sizeof(when), "+%llu.%03llu ms: the DSP's item %s", (now - started) / 1000, (now - started) % 1000,
+			    have ? "changes" : "APPEARS");
+			if (changes++ < 40) {
+				show_words(when, &words);
+			}
+			last = words;
+			have = spoke = true;
+			dsp_listen(&words);
+			state = dsp_state(&words);
+			if ((state & DSP_READY) && ready_at == 0) {
+				ready_at = now;
+				limit = now + 3000000ull;
+				printf("apollo adsp: %u: THE AUDIO DSP SAYS IT IS UP: \"slave-kernel\" says %#x, %llu.%03llu ms after TrustZone started "
+				    "it\n", step, state, (now - started) / 1000, (now - started) % 1000);
+			}
+			if ((state & DSP_HANDOVER) && !handed_over) {
+				handed_over = true;
+				printf("apollo adsp: %u: the DSP says it has asked for its own power (bit 2), %llu.%03llu ms after the start: ours is "
+				    "given back\n", step, (now - started) / 1000, (now - started) % 1000);
+				lck_mtx_lock(&dsp_lock);
+				if (rails_asked) {
+					rails(0);
+					rails_asked = false;
+				}
+				lck_mtx_unlock(&dsp_lock);
+			}
+			if (state & DSP_FATAL) {
+				printf("apollo adsp: %u: THE AUDIO DSP SAYS IT HAS GIVEN UP\n", step);
+				show_crash_reason();
+				break;
+			}
+		}
+		sleep_us(200);
+	}
+	printf("apollo adsp: %u: the watch is over after %llu ms; its doorbells heard: GLINK %u, SMP2P %u\n", step,
+	    (now_us() - started) / 1000, doorbell.glink, doorbell.smp2p);
+	show_partition();
+	if (our_item != 0 && smem_peek(our_item, &words, sizeof(words))) {
+		show_words("our item (429) now", &words);
+	}
+	{
+		/* (what is at the bottom of our partition, entry by entry, as it is now) */
+		uint32_t cacheline = 0, size = 0, partition = smem_partition(SMEM_US, SMEM_ADSP, &cacheline, &size);
+		struct smem_partition header;
+		struct smem_entry entry;
+
+		if (partition != 0 && smem_peek(partition, &header, sizeof(header))) {
+			printf("apollo adsp: %u: the partition's header: hosts %u and %u, size %#x, free from the bottom at +%#x, from the top at "
+			    "+%#x; the table's line size %u\n", step, header.host0, header.host1, header.size, header.free_uncached,
+			    header.free_cached, cacheline);
+			for (uint32_t at = sizeof(header), n = 0; at + sizeof(entry) <= header.size && n < 8; n++) {
+				smem_peek(partition + at, &entry, sizeof(entry));
+				printf("apollo adsp: %u:   +%#x: canary %#x item %u size %u padding %u/%u\n", step, at, entry.canary, entry.item,
+				    entry.size, entry.padding_data, entry.padding_header);
+				if (entry.canary != SMEM_CANARY) {
+					break;
+				}
+				at += sizeof(entry) + entry.padding_header + entry.size;
+			}
+		}
+	}
+	if (state & DSP_FATAL) {
+		return false;
+	}
+	if (ready_at == 0) {
+		printf("apollo adsp: %u: %s\n", step, spoke ? "THE AUDIO DSP RUNS BUT HAS NOT SAID \"UP\"" : "NOT A WORD FROM THE AUDIO DSP");
+		show_crash_reason();
+	}
+	return ready_at != 0;
+}
+
+/* ---- GLINK (hakios.wifi.c; items 478 to 480 of our partition with the audio DSP) ------------------- */
+
+#define ITEM_GLINK_DESCRIPTOR   478
+#define ITEM_GLINK_OUR_QUEUE    479
+#define ITEM_GLINK_THEIR_QUEUE  480
+#define GLINK_OUR_TAIL          0
+#define GLINK_OUR_HEAD          4
+#define GLINK_THEIR_TAIL        8
+#define GLINK_THEIR_HEAD        12
+#define GLINK_RESERVE           16
+
+enum {
+	GLINK_VERSION = 0, GLINK_VERSION_ACK = 1, GLINK_OPEN = 2, GLINK_CLOSE = 3, GLINK_OPEN_ACK = 4, GLINK_INTENT = 5,
+	GLINK_DONE = 6, GLINK_INTENT_REQUEST = 7, GLINK_INTENT_REQUEST_ACK = 8, GLINK_DATA = 9, GLINK_CLOSE_ACK = 11,
+	GLINK_DATA_MORE = 12, GLINK_READ_NOTIFY = 13, GLINK_DONE_REUSE = 14, GLINK_SIGNALS = 15,
+};
+#define GLINK_VERSION_1         1
+#define GLINK_INTENT_REUSE      1u
+
+struct glink_message {
+	uint16_t command, param1;
+	uint32_t param2;
+};
+struct glink_packet {
+	struct glink_packet *next;
+	uint32_t length;
+	uint8_t data[];
+};
+
+/*
+ * The channels we answer when the DSP opens them, each with our number for it and the intents
+ * we give it when it is open both ways (how many buffers of which size the DSP may send into):
+ * IPCRTR, which carries QRTR (dt: qcom,intents of qcom,adsp_qrtr), and apr_audio_svc, which
+ * carries APR, the audio services' own protocol (below; Android's apr_tal_rpmsg.c asks for no
+ * particular intents: what the DSP sends there is a few hundred bytes, up to a few kilobytes).
+ */
+enum { CHANNEL_QRTR, CHANNEL_APR, CHANNEL_PMIC, CHANNELS };
+
+struct glink_channel {
+	const char *name;
+	uint32_t ours;                          /* our number for it */
+	struct {
+		uint32_t size, count;
+	} intents[3];
+	uint32_t theirs;                        /* the DSP's number for it; 0: it has not opened it */
+	bool asked, acknowledged, open;         /* our open sent; acknowledged; both ways done and our intents told */
+	bool request_answered, request_granted; /* our last request for an intent */
+	struct {
+		uint32_t id, size;
+		bool there, in_use;
+	} their_intents[64];                    /* what we may send into */
+	struct {
+		uint32_t size, fill;
+		uint8_t *data;
+	} our_intents[32];                      /* what the DSP may send into; an intent's number is its place here + 1 (apr_audio_svc's
+	                                         * table below offers 26, and the DSP may ask for a few more) */
+	uint32_t our_intent_count;
+	struct glink_packet *first, *last;      /* received, in order */
+};
+
+static LCK_MTX_DECLARE(glink_lock, &adsp_lock_group);
+static struct {
+	uint32_t descriptor, ours, ours_size, theirs, theirs_size;
+	bool up, broken;
+	uint32_t features;
+	bool agreed;
+	struct glink_channel channel[CHANNELS];
+	uint32_t said, heard, trace;
+	char others[4][33];                     /* the channels the DSP opens that nobody here speaks (for the log) */
+} glink = {
+	.channel = {
+		[CHANNEL_QRTR] = { .name = "IPCRTR", .ours = 1, .intents = { { 0x800, 5 }, { 0x2000, 3 }, { 0x4400, 2 } } },
+		[CHANNEL_APR] = { .name = "apr_audio_svc", .ours = 2, .intents = { { 0x200, 20 }, { 0x1000, 4 }, { 0x2000, 2 } } },
+		/* the battery manager's (battmgr below): answers of a few dozen bytes, a name of 128 */
+		[CHANNEL_PMIC] = { .name = "PMIC_RTR_ADSP_APPS", .ours = 3, .intents = { { 0x200, 6 }, { 0x1000, 2 }, { 0, 0 } } },
+	},
+};
+
+static struct glink_channel *
+glink_theirs(uint32_t theirs)
+{
+	for (unsigned c = 0; c < CHANNELS; c++) {
+		if (glink.channel[c].theirs != 0 && glink.channel[c].theirs == theirs) {
+			return &glink.channel[c];
+		}
+	}
+	return NULL;
+}
+
+static bool
+glink_find(void)
+{
+	uint32_t size = 0;
+
+	glink.descriptor = smem_item(ITEM_GLINK_DESCRIPTOR, &size);
+	if (glink.descriptor == 0 || size != 32) {
+		return false;
+	}
+	glink.ours = smem_item(ITEM_GLINK_OUR_QUEUE, &glink.ours_size);
+	glink.theirs = smem_item(ITEM_GLINK_THEIR_QUEUE, &glink.theirs_size);
+	return glink.ours != 0 && glink.theirs != 0 && glink.ours_size >= 1024 && glink.theirs_size >= 1024 &&
+	       !(glink.ours_size & 7) && !(glink.theirs_size & 7);
+}
+
+static void
+glink_reset(void)
+{
+	uint32_t size = 0, descriptor = smem_item(ITEM_GLINK_DESCRIPTOR, &size);
+
+	if (descriptor == 0 || size != 32) {
+		printf("apollo adsp: %u: GLINK's descriptor (item %u) is not there: nothing to reset\n", step, ITEM_GLINK_DESCRIPTOR);
+		return;
+	}
+	printf("apollo adsp: %u: GLINK's descriptor at %#lx: our queue read to %#x and written to %#x, the DSP's read to %#x and written "
+	    "to %#x\n", step, SMEM_PHYS + descriptor, smem_word(descriptor + GLINK_OUR_TAIL), smem_word(descriptor + GLINK_OUR_HEAD),
+	    smem_word(descriptor + GLINK_THEIR_TAIL), smem_word(descriptor + GLINK_THEIR_HEAD));
+	if (smem_word(descriptor + GLINK_OUR_HEAD) != 0 || smem_word(descriptor + GLINK_THEIR_TAIL) != 0) {
+		printf("apollo adsp: %u: about to write our two marks there (+4, +8): 0\n", step);
+		smem_poke(descriptor + GLINK_OUR_HEAD, 0);
+		smem_poke(descriptor + GLINK_THEIR_TAIL, 0);
+		settle();
+	}
+}
+
+static uint32_t
+glink_waiting(void)
+{
+	uint32_t head = smem_word(glink.descriptor + GLINK_THEIR_HEAD), tail = smem_word(glink.descriptor + GLINK_THEIR_TAIL);
+
+	if (head >= glink.theirs_size || tail >= glink.theirs_size) {
+		return 0;
+	}
+	return head >= tail ? head - tail : glink.theirs_size - tail + head;
+}
+
+static void
+glink_peek(void *to, uint32_t offset, uint32_t count)
+{
+	uint32_t at = (smem_word(glink.descriptor + GLINK_THEIR_TAIL) + offset) % glink.theirs_size;
+
+	for (uint32_t i = 0; i < count; i++) {
+		((uint8_t *)to)[i] = smem[glink.theirs + (at + i) % glink.theirs_size];
+	}
+}
+
+static void
+glink_advance(uint32_t count)
+{
+	smem_poke(glink.descriptor + GLINK_THEIR_TAIL, (smem_word(glink.descriptor + GLINK_THEIR_TAIL) + count) % glink.theirs_size);
+}
+
+static uint32_t
+glink_room(void)
+{
+	uint32_t head = smem_word(glink.descriptor + GLINK_OUR_HEAD), tail = smem_word(glink.descriptor + GLINK_OUR_TAIL), room;
+
+	if (head >= glink.ours_size || tail >= glink.ours_size) {
+		return 0;
+	}
+	room = tail <= head ? glink.ours_size - head + tail : tail - head;
+	return room < GLINK_RESERVE ? 0 : room - GLINK_RESERVE;
+}
+
+static bool
+glink_put(const void *first, uint32_t first_length, const void *second, uint32_t second_length)
+{
+	volatile uint8_t *queue = (volatile uint8_t *)(uintptr_t)smem + glink.ours;
+	uint32_t head = smem_word(glink.descriptor + GLINK_OUR_HEAD), length = first_length + second_length;
+	uint32_t padded = (length + 7) & ~7u;
+
+	if (!glink.up || glink_room() < padded) {
+		return false;
+	}
+	for (uint32_t i = 0; i < padded; i++) {
+		queue[(head + i) % glink.ours_size] = i < first_length ? ((const uint8_t *)first)[i] :
+		    i < length ? ((const uint8_t *)second)[i - first_length] : 0;
+	}
+	settle();
+	smem_poke(glink.descriptor + GLINK_OUR_HEAD, (head + padded) % glink.ours_size);
+	settle();
+	wr(ipcc.base + IPCC_SEND, IPCC_LPASS << 16 | IPCC_GLINK);
+	glink.said++;
+	return true;
+}
+
+static const char *
+glink_name(unsigned command)
+{
+	static const char *const names[] = {
+		"version", "version-ack", "open", "close", "open-ack", "intent", "done", "intent-request", "intent-request-ack",
+		"data", "10", "close-ack", "data-more", "read-notify", "done-reuse", "signals"
+	};
+
+	return command < sizeof(names) / sizeof(names[0]) ? names[command] : "?";
+}
+
+static void
+glink_say(unsigned command, uint32_t param1, uint32_t param2, const void *more, uint32_t more_length)
+{
+	struct glink_message message = { .command = (uint16_t)command, .param1 = (uint16_t)param1, .param2 = param2 };
+	bool sent = glink_put(&message, sizeof(message), more, more_length);
+
+	if (glink.trace > 0 || !sent) {
+		glink.trace -= glink.trace > 0;
+		printf("apollo adsp: glink: > %s %u %#x%s\n", glink_name(command), param1, param2, sent ? "" : ": NO ROOM IN OUR QUEUE, not sent");
+	}
+}
+
+static bool
+glink_offer(struct glink_channel *channel, uint32_t size)
+{
+	uint32_t words[2] = { size, channel->our_intent_count + 1 }, i = channel->our_intent_count;
+
+	if (i >= sizeof(channel->our_intents) / sizeof(channel->our_intents[0]) || size == 0 || size > 0x10000) {
+		return false;
+	}
+	if (channel->our_intents[i].data != NULL && channel->our_intents[i].size != size) {
+		kfree_data(channel->our_intents[i].data, channel->our_intents[i].size);  /* (a place used again, for another size) */
+		channel->our_intents[i].data = NULL;
+	}
+	if (channel->our_intents[i].data == NULL) {
+		channel->our_intents[i].data = kalloc_data(size, Z_WAITOK | Z_ZERO);
+	}
+	if (channel->our_intents[i].data == NULL) {
+		return false;
+	}
+	channel->our_intents[i].size = size;
+	channel->our_intents[i].fill = 0;
+	channel->our_intent_count++;
+	glink_say(GLINK_INTENT, channel->ours, 1, words, sizeof(words));
+	return true;
+}
+
+/* Everything the DSP has put into its queue, taken out and acted on (Linux's qcom_glink_native_rx()). With glink_lock held. */
+static void
+glink_pump(void)
+{
+	struct glink_message message;
+	struct glink_channel *channel;
+	uint32_t words[4];
+	char name[33];
+
+	while (glink.up && !glink.broken) {
+		uint32_t waiting = glink_waiting(), length;
+		uint64_t wide = sizeof(message);        /* (summed in 64 bits: the DSP's numbers must not wrap it to nothing) */
+
+		if (waiting < sizeof(message)) {
+			return;
+		}
+		glink_peek(&message, 0, sizeof(message));
+		if (message.command == GLINK_OPEN) {
+			wide += message.param2;
+		} else if (message.command == GLINK_INTENT) {
+			wide += 8ull * message.param2;
+		} else if (message.command == GLINK_DATA || message.command == GLINK_DATA_MORE) {
+			if (waiting < 16) {
+				return;
+			}
+			glink_peek(words, 8, 8);
+			wide = 16ull + words[0];
+		}
+		wide = (wide + 7) & ~7ull;
+		if (wide == 0 || wide > glink.theirs_size - 8 ||
+		    (message.command == GLINK_INTENT && message.param2 > sizeof(channel->their_intents) / sizeof(channel->their_intents[0]))) {
+			printf("apollo adsp: glink: A MESSAGE OF %llu BYTES (%s %u %#x): not believed, and nothing more is read\n", wide,
+			    glink_name(message.command), message.param1, message.param2);
+			glink.broken = true;
+			return;
+		}
+		length = (uint32_t)wide;
+		if (waiting < length) {
+			return;
+		}
+		glink.heard++;
+		if (glink.trace > 0 && message.command != GLINK_DATA && message.command != GLINK_DATA_MORE &&
+		    message.command != GLINK_INTENT && message.command != GLINK_DONE_REUSE) {
+			glink.trace--;
+			printf("apollo adsp: glink: < %s %u %#x\n", glink_name(message.command), message.param1, message.param2);
+		}
+		switch (message.command) {
+		case GLINK_VERSION:
+			if (message.param1 == GLINK_VERSION_1) {
+				glink.features &= message.param2;
+			}
+			glink_advance(length);
+			glink_say(GLINK_VERSION_ACK, GLINK_VERSION_1, glink.features, NULL, 0);
+			break;
+		case GLINK_VERSION_ACK:
+			glink_advance(length);
+			if (message.param1 == GLINK_VERSION_1 && message.param2 == glink.features) {
+				glink.agreed = true;
+			} else if (message.param1 != 0) {
+				glink.features &= message.param2;
+				glink_say(GLINK_VERSION, GLINK_VERSION_1, glink.features, NULL, 0);
+			}
+			break;
+		case GLINK_OPEN:
+			bzero(name, sizeof(name));
+			glink_peek(name, sizeof(message), message.param2 < sizeof(name) - 1 ? message.param2 : sizeof(name) - 1);
+			glink_advance(length);
+			channel = NULL;
+			for (unsigned c = 0; c < CHANNELS; c++) {
+				if (strcmp(name, glink.channel[c].name) == 0) {
+					channel = &glink.channel[c];
+				}
+			}
+			if (channel == NULL) {
+				printf("apollo adsp: glink: the DSP opens \"%s\" as its channel %u: left unanswered, nobody here speaks it\n", name,
+				    message.param1);
+				for (unsigned i = 0; i < 4; i++) {
+					if (glink.others[i][0] == 0) {
+						strlcpy(glink.others[i], name, sizeof(glink.others[i]));
+						break;
+					}
+				}
+				break;
+			}
+			printf("apollo adsp: glink: the DSP opens \"%s\" as its channel %u: acknowledged, and opened from our side as channel %u\n",
+			    name, message.param1, channel->ours);
+			channel->theirs = message.param1;
+			glink_say(GLINK_OPEN_ACK, channel->theirs, 0, NULL, 0);
+			if (!channel->asked) {
+				uint32_t size = (uint32_t)strlen(channel->name) + 1;
+
+				bzero(name, sizeof(name));
+				strlcpy(name, channel->name, sizeof(name));
+				glink_say(GLINK_OPEN, channel->ours, size, name, (size + 7) & ~7u);
+				channel->asked = true;
+			}
+			break;
+		case GLINK_OPEN_ACK:
+			glink_advance(length);
+			for (unsigned c = 0; c < CHANNELS; c++) {
+				if (message.param1 == glink.channel[c].ours) {
+					glink.channel[c].acknowledged = true;
+				}
+			}
+			break;
+		case GLINK_INTENT:
+			channel = glink_theirs(message.param1);
+			for (uint32_t i = 0; channel != NULL && i < message.param2; i++) {
+				static unsigned intents_said[CHANNELS];
+
+				glink_peek(words, 8 + 8 * i, 8);
+				/* (the DSP's intents, the first 32 of each channel: what we may send it, and how big) */
+				if (intents_said[channel - glink.channel] < 32) {
+					intents_said[channel - glink.channel]++;
+					printf("apollo adsp: glink: the DSP offers an intent on \"%s\": %u bytes (id %u)\n", channel->name, words[0],
+					    words[1]);
+				}
+				for (unsigned n = 0; n < sizeof(channel->their_intents) / sizeof(channel->their_intents[0]); n++) {
+					if (!channel->their_intents[n].there || channel->their_intents[n].id == words[1]) {
+						channel->their_intents[n].there = true;
+						channel->their_intents[n].in_use = false;
+						channel->their_intents[n].size = words[0];
+						channel->their_intents[n].id = words[1];
+						break;
+					}
+				}
+			}
+			glink_advance(length);
+			break;
+		case GLINK_DONE:
+		case GLINK_DONE_REUSE:
+			channel = glink_theirs(message.param1);
+			for (unsigned n = 0; channel != NULL && n < sizeof(channel->their_intents) / sizeof(channel->their_intents[0]); n++) {
+				if (channel->their_intents[n].there && channel->their_intents[n].id == message.param2) {
+					channel->their_intents[n].in_use = false;
+					channel->their_intents[n].there = message.command == GLINK_DONE_REUSE;
+				}
+			}
+			glink_advance(length);
+			break;
+		case GLINK_INTENT_REQUEST:
+			glink_advance(length);
+			if ((channel = glink_theirs(message.param1)) != NULL) {
+				bool granted = glink_offer(channel, message.param2);
+
+				glink_say(GLINK_INTENT_REQUEST_ACK, channel->ours, granted, NULL, 0);
+			}
+			break;
+		case GLINK_INTENT_REQUEST_ACK:
+			glink_advance(length);
+			for (unsigned c = 0; c < CHANNELS; c++) {
+				if (message.param1 == glink.channel[c].theirs || message.param1 == glink.channel[c].ours) {
+					glink.channel[c].request_answered = true;
+					glink.channel[c].request_granted = message.param2 != 0;
+				}
+			}
+			break;
+		case GLINK_DATA:
+		case GLINK_DATA_MORE: {
+			uint32_t intent = message.param2 - 1;
+
+			channel = glink_theirs(message.param1);
+			if (channel == NULL || intent >= channel->our_intent_count ||
+			    words[0] > channel->our_intents[intent].size - channel->our_intents[intent].fill) {
+				printf("apollo adsp: glink: < data of %u bytes on channel %u for intent %u: NOT OURS OR TOO MUCH, dropped\n", words[0],
+				    message.param1, message.param2);
+				glink_advance(length);
+				break;
+			}
+			glink_peek(channel->our_intents[intent].data + channel->our_intents[intent].fill, 16, words[0]);
+			channel->our_intents[intent].fill += words[0];
+			glink_advance(length);
+			if (words[1] == 0) {
+				struct glink_packet *packet = kalloc_data(sizeof(*packet) + channel->our_intents[intent].fill, Z_WAITOK);
+
+				if (packet != NULL) {
+					packet->next = NULL;
+					packet->length = channel->our_intents[intent].fill;
+					memcpy(packet->data, channel->our_intents[intent].data, packet->length);
+					if (channel->last != NULL) {
+						channel->last->next = packet;
+					} else {
+						channel->first = packet;
+					}
+					channel->last = packet;
+				}
+				channel->our_intents[intent].fill = 0;
+				glink_say(GLINK_DONE_REUSE, channel->ours, message.param2, NULL, 0);
+			}
+			break;
+		}
+		case GLINK_READ_NOTIFY:
+			glink_advance(length);
+			wr(ipcc.base + IPCC_SEND, IPCC_LPASS << 16 | IPCC_GLINK);
+			break;
+		case GLINK_CLOSE:
+			glink_advance(length);
+			glink_say(GLINK_CLOSE_ACK, message.param1, 0, NULL, 0);
+			if ((channel = glink_theirs(message.param1)) != NULL) {
+				printf("apollo adsp: glink: THE DSP CLOSES \"%s\": closed from our side too, for it to be opened again\n",
+				    channel->name);
+				/*
+				 * (as Linux's qcom_glink_rx_close(): our side closed as well, and everything of the channel forgotten, so
+				 * that the DSP's next open is answered with our open and our intents again, numbered from 1; the buffers
+				 * of our intents stay, for glink_offer() to use again)
+				 */
+				if (channel->asked) {
+					glink_say(GLINK_CLOSE, channel->ours, 0, NULL, 0);
+				}
+				channel->open = channel->asked = channel->acknowledged = false;
+				channel->theirs = 0;
+				channel->our_intent_count = 0;
+				for (unsigned i = 0; i < sizeof(channel->our_intents) / sizeof(channel->our_intents[0]); i++) {
+					channel->our_intents[i].fill = 0;
+				}
+				bzero(channel->their_intents, sizeof(channel->their_intents));
+			}
+			break;
+		case GLINK_CLOSE_ACK:
+		case GLINK_SIGNALS:
+			glink_advance(length);
+			break;
+		default:
+			printf("apollo adsp: glink: A MESSAGE THIS DOES NOT KNOW (%u, %u, %#x): nothing more is read\n", message.command,
+			    message.param1, message.param2);
+			glink.broken = true;
+			return;
+		}
+		for (unsigned c = 0; c < CHANNELS; c++) {
+			channel = &glink.channel[c];
+			if (channel->theirs != 0 && channel->acknowledged && !channel->open) {
+				channel->open = true;
+				printf("apollo adsp: glink: THE CHANNEL \"%s\" IS OPEN both ways (ours %u, the DSP's %u); telling the DSP our intents\n",
+				    channel->name, channel->ours, channel->theirs);
+				for (unsigned i = 0; i < 3; i++) {
+					for (unsigned n = 0; n < channel->intents[i].count; n++) {
+						glink_offer(channel, channel->intents[i].size);
+					}
+				}
+			}
+		}
+	}
+}
+
+/*
+ * A message that could not be sent for want of an intent of the DSP's: what the DSP had offered on that channel,
+ * and what became of our request for one, said once per channel and size (with glink_lock held).
+ */
+static void
+glink_send_failed(struct glink_channel *channel, uint32_t length, bool asked, bool fits, int found)
+{
+	static struct {
+		uint32_t ours, length;
+	} said[16];
+	static unsigned said_count;
+	unsigned there = 0, in_use = 0, largest = 0;
+
+	for (unsigned i = 0; i < said_count; i++) {
+		if (said[i].ours == channel->ours && said[i].length == length) {
+			return;
+		}
+	}
+	if (said_count < sizeof(said) / sizeof(said[0])) {
+		said[said_count].ours = channel->ours;
+		said[said_count++].length = length;
+	}
+	printf("apollo adsp: glink: %u bytes on \"%s\" NOT SENT: %s; our request for an intent %s%s\n", length, channel->name,
+	    found >= 0 ? "the intents it fits stayed in use" : fits ? "no free intent it fits" : "no intent of the DSP's is that big",
+	    !asked ? "was not made" : !channel->request_answered ? "was NOT ANSWERED" : "was answered, ",
+	    !asked || !channel->request_answered ? "" : channel->request_granted ? "GRANTED (no fitting intent came)" : "REFUSED");
+	for (unsigned n = 0; n < sizeof(channel->their_intents) / sizeof(channel->their_intents[0]); n++) {
+		if (channel->their_intents[n].there) {
+			there++;
+			in_use += channel->their_intents[n].in_use;
+			largest = channel->their_intents[n].size > largest ? channel->their_intents[n].size : largest;
+			printf("apollo adsp: glink:   the DSP's intent %u: %u bytes%s\n", channel->their_intents[n].id,
+			    channel->their_intents[n].size, channel->their_intents[n].in_use ? ", in use" : "");
+		}
+	}
+	printf("apollo adsp: glink:   %u intents of the DSP's on \"%s\", %u in use, the largest %u bytes\n", there, channel->name, in_use,
+	    largest);
+}
+
+/* One whole message to the DSP on a channel; waits up to five seconds for an intent of the DSP's that it fits. */
+static int
+glink_send(struct glink_channel *channel, const void *data, uint32_t length)
+{
+	struct {
+		struct glink_message message;
+		uint32_t size, left;
+	} header = { { GLINK_DATA, (uint16_t)channel->ours, 0 }, length, 0 };
+	bool asked = false, fits;
+	int found = -1;
+
+	lck_mtx_lock(&glink_lock);
+	if (glink.up && length + sizeof(header) + 8 > glink.ours_size - GLINK_RESERVE) {
+		lck_mtx_unlock(&glink_lock);
+		return EMSGSIZE;
+	}
+	for (unsigned waited = 0;; waited++) {
+		glink_pump();
+		if (!glink.up || !channel->open || glink.broken) {
+			lck_mtx_unlock(&glink_lock);
+			return ENOTCONN;
+		}
+		found = -1;
+		fits = false;
+		for (unsigned n = 0; n < sizeof(channel->their_intents) / sizeof(channel->their_intents[0]); n++) {
+			if (!channel->their_intents[n].there || channel->their_intents[n].size < length) {
+				continue;
+			}
+			fits = true;
+			if (!channel->their_intents[n].in_use &&
+			    (found < 0 || channel->their_intents[n].size < channel->their_intents[found].size)) {
+				found = (int)n;
+			}
+		}
+		if (found >= 0 && glink_room() >= ((length + sizeof(header) + 7) & ~7u)) {
+			break;
+		}
+		if (!fits && !asked) {
+			channel->request_answered = false;
+			glink_say(GLINK_INTENT_REQUEST, channel->ours, length, NULL, 0);
+			asked = true;
+		}
+		if (waited >= 5000 || (!fits && asked && channel->request_answered && !channel->request_granted)) {
+			glink_send_failed(channel, length, asked, fits, found);
+			lck_mtx_unlock(&glink_lock);
+			return found < 0 ? ENOBUFS : EAGAIN;
+		}
+		lck_mtx_unlock(&glink_lock);
+		sleep_ms(1);
+		lck_mtx_lock(&glink_lock);
+	}
+	channel->their_intents[found].in_use = true;
+	header.message.param2 = channel->their_intents[found].id;
+	glink_put(&header, sizeof(header), data, length);
+	lck_mtx_unlock(&glink_lock);
+	return 0;
+}
+
+/* ---- QRTR: hello, and the services the DSP tells of (hakios.wifi.c, without ports of our own yet) ---- */
+
+#define QRTR_US                 1u
+#define QRTR_CONTROL            0xfffffffeu
+enum { QRTR_DATA = 1, QRTR_HELLO = 2, QRTR_BYE = 3, QRTR_NEW_SERVER = 4, QRTR_DEL_SERVER = 5, QRTR_DEL_CLIENT = 6, QRTR_RESUME_TX = 7,
+       QRTR_NEW_LOOKUP = 10, QRTR_DEL_LOOKUP = 11 };
+
+struct qrtr_header {
+	uint32_t version, type, from_node, from_port, confirm, size, to_node, to_port;
+};
+struct qrtr_control {
+	uint32_t command;
+	uint32_t words[4];
+};
+
+static struct {
+	uint32_t service, instance, node, port;
+	bool there;
+} qrtr_servers[64];
+static uint32_t qrtr_peer, qrtr_in, qrtr_out, qrtr_hellos, qrtr_lookups;
+
+static int
+qrtr_out_packet(uint32_t type, uint32_t from_port, uint32_t to_node, uint32_t to_port, const void *data, uint32_t length)
+{
+	uint32_t padded = (length + 3) & ~3u;
+	struct qrtr_header *packet;
+	int error;
+
+	packet = kalloc_data(sizeof(*packet) + padded, Z_WAITOK | Z_ZERO);
+	if (packet == NULL) {
+		return ENOMEM;
+	}
+	packet->version = 1;
+	packet->type = type;
+	packet->from_node = QRTR_US;
+	packet->from_port = from_port;
+	packet->size = length;
+	packet->to_node = to_node;
+	packet->to_port = to_port;
+	memcpy(packet + 1, data, length);
+	error = glink_send(&glink.channel[CHANNEL_QRTR], packet, (uint32_t)sizeof(*packet) + padded);
+	kfree_data(packet, sizeof(*packet) + padded);
+	qrtr_out += error == 0;
+	return error;
+}
+
+static void
+qrtr_control(const struct qrtr_header *header, const struct qrtr_control *control)
+{
+	struct qrtr_control hello = { .command = QRTR_HELLO };
+	int found = -1, error;
+
+	switch (control->command) {
+	case QRTR_HELLO:
+		if (qrtr_hellos++ != 0) {
+			break;
+		}
+		error = qrtr_out_packet(QRTR_HELLO, QRTR_CONTROL, header->from_node, QRTR_CONTROL, &hello, sizeof(hello));
+		printf("apollo adsp: qrtr: HELLO FROM NODE %u; ours to it: %s\n", header->from_node, error == 0 ? "SENT" : "NOT SENT");
+		break;
+	case QRTR_NEW_SERVER:
+		for (unsigned i = 0; i < sizeof(qrtr_servers) / sizeof(qrtr_servers[0]); i++) {
+			if (qrtr_servers[i].there && qrtr_servers[i].node == control->words[2] && qrtr_servers[i].port == control->words[3]) {
+				found = (int)i;
+				break;
+			}
+			if (!qrtr_servers[i].there && found < 0) {
+				found = (int)i;
+			}
+		}
+		if (found >= 0) {
+			qrtr_servers[found].there = true;
+			qrtr_servers[found].service = control->words[0];
+			qrtr_servers[found].instance = control->words[1];
+			qrtr_servers[found].node = control->words[2];
+			qrtr_servers[found].port = control->words[3];
+		}
+		printf("apollo adsp: qrtr: a service: %u (%#x), version %u, instance %u, at node %u port %u\n", control->words[0],
+		    control->words[0], control->words[1] & 0xff, control->words[1] >> 8, control->words[2], control->words[3]);
+		break;
+	case QRTR_DEL_SERVER:
+		printf("apollo adsp: qrtr: service %u at node %u port %u has gone\n", control->words[0], control->words[2], control->words[3]);
+		for (unsigned i = 0; i < sizeof(qrtr_servers) / sizeof(qrtr_servers[0]); i++) {
+			if (qrtr_servers[i].there && qrtr_servers[i].node == control->words[2] && qrtr_servers[i].port == control->words[3]) {
+				qrtr_servers[i].there = false;
+			}
+		}
+		break;
+	case QRTR_NEW_LOOKUP:
+		/* the DSP looks for a service of ours (a protection domain's locator, say): there are none yet */
+		if (qrtr_lookups++ < 16) {
+			printf("apollo adsp: qrtr: the DSP looks for service %u (%#x), instance %u: nobody here offers it\n", control->words[0],
+			    control->words[0], control->words[1]);
+		}
+		break;
+	case QRTR_BYE:
+		printf("apollo adsp: qrtr: BYE from node %u\n", header->from_node);
+		bzero(qrtr_servers, sizeof(qrtr_servers));
+		break;
+	default:
+		break;
+	}
+}
+
+static void
+qrtr_input(const uint8_t *data, uint32_t length)
+{
+	struct qrtr_header header;
+	uint32_t at;
+
+	if (length >= sizeof(header) && data[0] == 1) {
+		memcpy(&header, data, sizeof(header));
+		at = sizeof(header);
+	} else if (length >= 16 && data[0] == 3) {
+		bzero(&header, sizeof(header));
+		header.type = data[1];
+		header.confirm = data[2] & 1;
+		memcpy(&header.size, data + 4, 4);
+		header.from_node = (uint32_t)(data[8] | data[9] << 8);
+		header.from_port = (uint32_t)(data[10] | data[11] << 8);
+		header.to_node = (uint32_t)(data[12] | data[13] << 8);
+		header.to_port = (uint32_t)(data[14] | data[15] << 8);
+		header.from_port = header.from_port == 0xfffe ? QRTR_CONTROL : header.from_port;
+		header.to_port = header.to_port == 0xfffe ? QRTR_CONTROL : header.to_port;
+		at = 16 + data[3];
+	} else {
+		printf("apollo adsp: qrtr: %u bytes that are no datagram (they begin %#x)\n", length, length ? data[0] : 0);
+		return;
+	}
+	if (header.size == 0 || at > length || header.size > length - at) {    /* (not at + size: the DSP's size may wrap it) */
+		printf("apollo adsp: qrtr: a datagram of %u bytes in a message of %u: dropped\n", header.size, length);
+		return;
+	}
+	qrtr_in++;
+	if (qrtr_peer == 0) {
+		qrtr_peer = header.from_node;
+	}
+	if (header.type == QRTR_RESUME_TX) {
+		return;
+	}
+	if (header.confirm) {
+		struct qrtr_control resume = { .command = QRTR_RESUME_TX, .words = { header.to_node, header.to_port } };
+
+		qrtr_out_packet(QRTR_RESUME_TX, header.to_port, header.from_node, header.from_port, &resume, sizeof(resume));
+	}
+	if (header.to_port == QRTR_CONTROL || header.type == QRTR_HELLO || header.type == QRTR_BYE ||
+	    header.type == QRTR_NEW_SERVER || header.type == QRTR_DEL_SERVER || header.type == QRTR_NEW_LOOKUP) {
+		struct qrtr_control control = { 0 };
+
+		memcpy(&control, data + at, header.size < sizeof(control) ? header.size : sizeof(control));
+		qrtr_control(&header, &control);
+		return;
+	}
+	printf("apollo adsp: qrtr: a datagram of %u bytes from node %u port %u to our port %u: nobody here listens there\n", header.size,
+	    header.from_node, header.from_port, header.to_port);
+}
+
+/* ---- APR: the audio services' protocol, on the channel apr_audio_svc ------------------------------------- */
+
+/*
+ * What Android's audio drivers say to the DSP's audio services (Linux: drivers/soc/qcom/apr.c,
+ * include/linux/soc/qcom/apr.h; Android's q6core.c): a packet of a header of eight words -- a
+ * word of kind, header length and version and the packet's length, who it is from and to (a
+ * service, a domain, a port each: we are domain 5, the DSP 4), a token the answer carries back,
+ * an opcode -- and what the opcode takes. The DSP's core service (3) answers whether the audio
+ * services are up (AVCS_CMD_ADSP_EVENT_GET_STATE, which Android asks again and again after the DSP
+ * has started, until the answer is 1) and which services it has and in which versions.
+ */
+#define APR_DOMAIN_ADSP                 4
+#define APR_DOMAIN_APPS                 5
+#define APR_SVC_ADSP_CORE               3
+#define APR_MSG_TYPE_SEQ_CMD            2
+#define APR_HDR_FIELD(type, bytes)      ((uint16_t)((type) << 8 | ((bytes) / 4) << 4))      /* version 0 */
+#define APR_BASIC_RSP_RESULT            0x000110e8u
+#define AVCS_GET_VERSIONS               0x00012905u
+#define AVCS_GET_VERSIONS_RSP           0x00012906u
+#define AVCS_CMD_ADSP_EVENT_GET_STATE   0x0001290cu
+#define AVCS_CMDRSP_ADSP_EVENT_GET_STATE 0x0001290du
+
+struct apr_header {
+	uint16_t field, size;
+	uint8_t from_service, from_domain;
+	uint16_t from_port;
+	uint8_t to_service, to_domain;
+	uint16_t to_port;
+	uint32_t token, opcode;
+};
+
+/* The last packet of the audio services: written by the link's thread, read by who waits for it, both under apr_answer_lock. */
+static struct {
+	uint32_t opcode, token, length;
+	uint32_t words[64];
+	bool there;
+} apr_answer;
+static LCK_SPIN_DECLARE(apr_answer_lock, &adsp_lock_group);
+static struct hakios_apr_answer apr_reply;     /* the answer apr_ask() waited for (step 11's), copied out of apr_answer */
+static uint32_t apr_in, apr_out, apr_next_token = 1;
+static bool audio_up;                   /* the core service has said that the audio services are up (step 11) */
+static uint32_t apr_waited_for;         /* the token a question waits for the answer to; 0: none */
+static hakios_apr_events_t apr_events; /* the sound's (hakios.sound.c): what nobody waits for */
+static hakios_apr_events_t apr_events_second;  /* the microphone's (hakios.apollo_mic.c) */
+static LCK_MTX_DECLARE(apr_lock, &adsp_lock_group);     /* one question at a time */
+
+/* A packet from the DSP's audio services. From the link's thread. */
+static void
+apr_input(const uint8_t *data, uint32_t length)
+{
+	struct apr_header header;
+	uint32_t header_length, payload;
+
+	if (length < sizeof(header)) {
+		printf("apollo adsp: apr: %u bytes, no APR packet\n", length);
+		return;
+	}
+	memcpy(&header, data, sizeof(header));
+	header_length = ((header.field >> 4) & 0xf) * 4;
+	if (header_length < sizeof(header) || header_length > length) {
+		printf("apollo adsp: apr: a header of %u bytes in a packet of %u: dropped\n", header_length, length);
+		return;
+	}
+	if (header.size < header_length) {
+		/* (the packet's own length shorter than its header: what is after the header would be a wrapped length) */
+		printf("apollo adsp: apr: a packet that says it has %u bytes, with a header of %u: dropped\n", header.size, header_length);
+		return;
+	}
+	payload = (header.size < length ? header.size : length) - header_length;
+	apr_in++;
+	if (header.token != apr_waited_for || apr_waited_for == 0) {
+		hakios_apr_events_t events = apr_events;
+		uint32_t words[64];
+
+		bzero(words, sizeof(words));
+		memcpy(words, data + header_length, payload < sizeof(words) ? payload : sizeof(words));
+		if (events != NULL && events(header.from_service, header.from_port, header.opcode, header.token, words,
+		    payload < sizeof(words) ? payload : sizeof(words))) {
+			return;
+		}
+		events = apr_events_second;
+		if (events != NULL && events(header.from_service, header.from_port, header.opcode, header.token, words,
+		    payload < sizeof(words) ? payload : sizeof(words))) {
+			return;
+		}
+	}
+	if (apr_in <= 40) {
+		uint32_t w[4] = { 0, 0, 0, 0 };
+
+		memcpy(w, data + header_length, payload < sizeof(w) ? payload : sizeof(w));
+		printf("apollo adsp: apr: < from service %u of domain %u (port %u) to %u of %u (port %u): opcode %#x, token %u, %u bytes: %#x %#x "
+		    "%#x %#x\n", header.from_service, header.from_domain, header.from_port, header.to_service, header.to_domain,
+		    header.to_port, header.opcode, header.token, payload, w[0], w[1], w[2], w[3]);
+	}
+	lck_spin_lock(&apr_answer_lock);
+	bzero(apr_answer.words, sizeof(apr_answer.words));
+	memcpy(apr_answer.words, data + header_length, payload < sizeof(apr_answer.words) ? payload : sizeof(apr_answer.words));
+	apr_answer.length = payload;
+	apr_answer.opcode = header.opcode;
+	apr_answer.token = header.token;
+	apr_answer.there = true;
+	lck_spin_unlock(&apr_answer_lock);
+}
+
+/*
+ * A command to one of the DSP's services (and its answer waited for, with ms): true when it was
+ * sent and, if waited for, answered; the answer, if asked for, in *answer.
+ * The port is the service's own numbering of what the command is for (ASM: session << 8 | stream).
+ */
+bool
+apollo_adsp_apr(uint8_t service, uint16_t port, uint32_t token, uint32_t opcode, const void *payload, uint32_t length,
+    uint32_t ms, struct hakios_apr_answer *answer)
+{
+	uint8_t packet[sizeof(struct apr_header) + 256];
+	struct apr_header *header = (struct apr_header *)packet;
+	bool answered = false;
+	int error;
+
+	if (length > sizeof(packet) - sizeof(*header) || !glink.channel[CHANNEL_APR].open) {
+		return false;
+	}
+	bzero(packet, sizeof(packet));
+	header->field = APR_HDR_FIELD(APR_MSG_TYPE_SEQ_CMD, sizeof(*header));
+	header->size = (uint16_t)(sizeof(*header) + length);
+	header->from_service = service;
+	header->from_domain = APR_DOMAIN_APPS;
+	header->from_port = port;
+	header->to_service = service;
+	header->to_domain = APR_DOMAIN_ADSP;
+	header->to_port = port;
+	header->opcode = opcode;
+	if (length != 0) {
+		memcpy(packet + sizeof(*header), payload, length);
+	}
+	if (ms == 0) {
+		/* (sent and not waited for: what comes back is the events' handler's) */
+		header->token = token;
+		error = glink_send(&glink.channel[CHANNEL_APR], packet, (uint32_t)sizeof(*header) + length);
+		apr_out += error == 0;
+		return error == 0;
+	}
+	lck_mtx_lock(&apr_lock);
+	if (token == 0) {
+		token = apr_next_token++;
+		if (apr_next_token >= 0x01000000u) {
+			apr_next_token = 1;
+		}
+	}
+	header->token = token;
+	lck_spin_lock(&apr_answer_lock);
+	apr_answer.there = false;
+	lck_spin_unlock(&apr_answer_lock);
+	apr_waited_for = token;
+	error = glink_send(&glink.channel[CHANNEL_APR], packet, (uint32_t)sizeof(*header) + length);
+	if (error != 0) {
+		printf("apollo adsp: apr: > opcode %#x to service %u: NOT SENT (%d)\n", opcode, service, error);
+	} else {
+		apr_out++;
+		for (uint32_t waited = 0; waited < ms && !answered; waited++) {
+			lck_spin_lock(&apr_answer_lock);
+			if (apr_answer.there && apr_answer.token == token) {
+				answered = true;
+				if (answer != NULL) {
+					answer->opcode = apr_answer.opcode;
+					answer->token = apr_answer.token;
+					answer->length = apr_answer.length;
+					memcpy(answer->words, apr_answer.words, sizeof(answer->words));
+				}
+			}
+			lck_spin_unlock(&apr_answer_lock);
+			if (answered) {
+				break;
+			}
+			sleep_ms(1);
+		}
+	}
+	apr_waited_for = 0;
+	lck_mtx_unlock(&apr_lock);
+	return answered;
+}
+
+void
+apollo_adsp_apr_events(hakios_apr_events_t handler)
+{
+	apr_events = handler;
+}
+
+void
+apollo_adsp_apr_events_second(hakios_apr_events_t handler)
+{
+	apr_events_second = handler;
+}
+
+/* A command to one of the DSP's services, and its answer waited for: true, and the answer in apr_reply, if it came. */
+static bool
+apr_ask(uint8_t service, uint32_t opcode, const void *payload, uint32_t length, uint32_t ms)
+{
+	return apollo_adsp_apr(service, 0, 0, opcode, payload, length, ms, &apr_reply);
+}
+
+/* ---- the battery manager, on the channel PMIC_RTR_ADSP_APPS ------------------------------------------ */
+
+/*
+ * On this SoC the audio DSP also runs the battery's and the charger's management -- the fuel gauge,
+ * the charging -- and the operating system only asks it how things are: Android's
+ * qti_battery_charger.c, Linux's qcom_battmgr.c over pmic_glink.c, on the channel PMIC_RTR_ADSP_APPS
+ * that the DSP opens. A message is a header (owner 32778, the battery manager; type 1, request and
+ * answer, or 2, a notice; an opcode) and its words; a property is asked for with opcode 0x30 (the
+ * battery's) or 0x32 (the USB port's), the battery's number (0), the property's number and a word
+ * that a get does not use, and is answered with the property's number, its value and a result (0:
+ * good). Only gets are sent from here: nothing is set, no limit, no current, no notice asked for.
+ * On apollo it is asked only with boot-arg apollo_battmgr=1 (the default, 0, leaves the battery to
+ * the UEFI's charger drivers, hakios.apollo_battery.c), with apollo_audio=N once the DSP is up: then
+ * every BATTMGR_SECONDS while the DSP runs, and what it says goes to bsd/dev/hakios.battery.c
+ * (hakios_battery_report()), and from there to the power source that iOS reads
+ * (iokit/Kernel/hakios.battery.cpp). apollo_battmgr=2: every property once, for the log, first.
+ * Units: capacity in hundredths of a percent, voltage in uV, current in uA (more than 0 while the
+ * battery takes charge), the temperature in hundredths of a degree, charges in uAh.
+ * The properties' numbers are redwood's firmware's (hakios.adsp.c), read with its battmgr=2 and checked against what
+ * Android shows at the same moment (dumpsys battery, /sys/class/power_supply/battery): up to 9 they
+ * are those of Linux's qcom_battmgr.c (sm8350), from there on one more property comes before the
+ * temperature, so the temperature is 13, not 12, and the charge counter, the cycles, the designed and
+ * the learnt full charge are 15 to 18.
+ */
+#define BATTMGR_OWNER           32778
+#define BATTMGR_REQUEST         1
+#define BATTMGR_NOTICE          2
+#define BATTMGR_BATTERY_GET     0x30
+#define BATTMGR_USB_GET         0x32
+#define BATT_STATUS             0               /* Linux's POWER_SUPPLY_STATUS_*: 1 charging, 2 discharging, 3 not charging, 4 full */
+#define BATT_HEALTH             1
+#define BATT_PRESENT            2
+#define BATT_CAPACITY           4
+#define BATT_VOLT_NOW           7
+#define BATT_CURR_NOW           9
+#define BATT_TEMP               13              /* hundredths of a degree: 3900 when Android says 39.0 */
+#define BATT_CHG_COUNTER        15              /* the charge in the battery now, uAh */
+#define BATT_CYCLE_COUNT        16
+#define BATT_CHG_FULL_DESIGN    17              /* 5000000 uAh */
+#define BATT_CHG_FULL           18              /* the full charge as the fuel gauge has learnt it, uAh */
+#define USB_VOLT_NOW            1               /* uV */
+#define USB_CURR_NOW            3               /* uA, what the port gives */
+#define USB_TYPE                6               /* Linux's POWER_SUPPLY_USB_TYPE_*: 1 here, a computer's port */
+#define USB_ONLINE              0
+#define BATTMGR_SECONDS         10
+
+struct battmgr_message {
+	uint32_t owner, type, opcode;
+	uint32_t words[3];                      /* asked: battery, property, value; answered: property, value, result */
+};
+
+static struct {
+	volatile uint32_t answers, notices;
+	uint32_t opcode, property, value, result, length;
+	bool wanted;
+	volatile bool runs;
+} battmgr;
+
+static void
+battmgr_input(const uint8_t *data, uint32_t length)
+{
+	struct battmgr_message m;
+
+	bzero(&m, sizeof(m));
+	memcpy(&m, data, length < sizeof(m) ? length : sizeof(m));
+	if (m.owner != BATTMGR_OWNER || length < 12) {
+		printf("apollo adsp: battmgr: < %u bytes of owner %u, type %u, opcode %#x: not the battery manager's\n", length, m.owner,
+		    m.type, m.opcode);
+		return;
+	}
+	if (m.type == BATTMGR_NOTICE) {
+		if (battmgr.notices++ < 8) {
+			tell("apollo adsp: battmgr: < a notice, opcode %#x, %u bytes (%#x %#x %#x)\n", m.opcode, length, m.words[0], m.words[1],
+			    m.words[2]);
+		}
+		return;
+	}
+	battmgr.opcode = m.opcode;
+	battmgr.property = m.words[0];
+	battmgr.value = m.words[1];
+	battmgr.result = m.words[2];
+	battmgr.length = length;
+	os_atomic_inc(&battmgr.answers, release);
+}
+
+/* One property asked for and its answer waited for (a second at most); one thread asks at a time (battmgr_thread). */
+static bool
+battmgr_get(uint32_t opcode, uint32_t property, uint32_t *value)
+{
+	struct battmgr_message q = { BATTMGR_OWNER, BATTMGR_REQUEST, opcode, { 0, property, 0 } };
+	uint32_t before = os_atomic_load(&battmgr.answers, acquire);
+
+	if (glink_send(&glink.channel[CHANNEL_PMIC], &q, sizeof(q)) != 0) {
+		return false;
+	}
+	for (unsigned ms = 0; ms < 1000; ms++) {
+		if (os_atomic_load(&battmgr.answers, acquire) != before) {
+			if (battmgr.opcode != opcode || battmgr.property != property || battmgr.length < sizeof(struct battmgr_message)) {
+				before = battmgr.answers;       /* (somebody else's answer: wait on) */
+				continue;
+			}
+			if (battmgr.result != 0) {
+				return false;
+			}
+			*value = battmgr.value;
+			return true;
+		}
+		sleep_ms(1);
+	}
+	return false;
+}
+
+static void
+battmgr_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	battmgr.runs = true;
+	for (unsigned ms = 0; ms < 15000 && battmgr.wanted && !glink.channel[CHANNEL_PMIC].open; ms += 10) {
+		sleep_ms(10);
+	}
+	if (!glink.channel[CHANNEL_PMIC].open) {
+		tell("apollo adsp: battmgr: the DSP has not opened PMIC_RTR_ADSP_APPS: nothing is asked\n");
+		battmgr.runs = false;
+		thread_terminate(current_thread());
+	}
+	{
+		/* boot-arg apollo_battmgr=2: every property once, for the log (which number is which on this phone's firmware) */
+		uint32_t mode = 1;
+
+		PE_parse_boot_argn("apollo_battmgr", &mode, sizeof(mode));
+		for (uint32_t p = 0; mode == 2 && p < 32; p++) {
+			uint32_t v = 0;
+			bool ok = battmgr_get(BATTMGR_BATTERY_GET, p, &v);
+
+			tell("apollo adsp: battmgr: battery property %u: %s %u (%d)\n", p, ok ? "" : "NO ANSWER", v, (int)v);
+		}
+		for (uint32_t p = 0; mode == 2 && p < 12; p++) {
+			uint32_t v = 0;
+			bool ok = battmgr_get(BATTMGR_USB_GET, p, &v);
+
+			tell("apollo adsp: battmgr: USB property %u: %s %u (%d)\n", p, ok ? "" : "NO ANSWER", v, (int)v);
+		}
+	}
+	for (unsigned round = 0; battmgr.wanted && glink.up && glink.channel[CHANNEL_PMIC].open; round++) {
+		struct hakios_battery_state b = { .size = sizeof(b) };
+		uint32_t capacity = 0, status = 0, present = 0, volt = 0, curr = 0, temp = 0, usb = 0;
+		uint32_t usb_type = 0, usb_volt = 0, usb_curr = 0, charge = 0;
+		static uint32_t full, design, cycles;
+		bool good = battmgr_get(BATTMGR_BATTERY_GET, BATT_CAPACITY, &capacity) &&
+		    battmgr_get(BATTMGR_BATTERY_GET, BATT_STATUS, &status) &&
+		    battmgr_get(BATTMGR_BATTERY_GET, BATT_PRESENT, &present) &&
+		    battmgr_get(BATTMGR_BATTERY_GET, BATT_VOLT_NOW, &volt) &&
+		    battmgr_get(BATTMGR_BATTERY_GET, BATT_CURR_NOW, &curr) &&
+		    battmgr_get(BATTMGR_BATTERY_GET, BATT_TEMP, &temp) &&
+		    battmgr_get(BATTMGR_USB_GET, USB_ONLINE, &usb);
+
+		if (good) {
+			/* (what may be missing without harm, and the capacities and the cycles only now and then: they hardly change) */
+			(void)battmgr_get(BATTMGR_BATTERY_GET, BATT_CHG_COUNTER, &charge);
+			if (usb) {
+				(void)battmgr_get(BATTMGR_USB_GET, USB_TYPE, &usb_type);
+				(void)battmgr_get(BATTMGR_USB_GET, USB_VOLT_NOW, &usb_volt);
+				(void)battmgr_get(BATTMGR_USB_GET, USB_CURR_NOW, &usb_curr);
+			}
+			if (round % 30 == 0 || full == 0) {
+				(void)battmgr_get(BATTMGR_BATTERY_GET, BATT_CHG_FULL, &full);
+				(void)battmgr_get(BATTMGR_BATTERY_GET, BATT_CHG_FULL_DESIGN, &design);
+				(void)battmgr_get(BATTMGR_BATTERY_GET, BATT_CYCLE_COUNT, &cycles);
+			}
+			b.percent_hundredths = (int32_t)capacity;
+			b.voltage_uv = (int32_t)volt;
+			b.current_ua = (int32_t)curr;
+			b.temperature_hundredths = (int32_t)temp;
+			b.present = present != 0;
+			b.external = usb != 0;
+			b.status = (int32_t)status;
+			b.charge_uah = (int32_t)charge;
+			b.full_uah = (int32_t)full;
+			b.design_uah = (int32_t)design;
+			b.cycles = (int32_t)cycles;
+			b.usb_type = (int32_t)usb_type;
+			b.usb_voltage_uv = (int32_t)usb_volt;
+			b.usb_current_ua = (int32_t)usb_curr;
+			hakios_battery_report(&b);
+		}
+		if (round < 3 || round % 6 == 0 || !good) {
+			tell("apollo adsp: battmgr: %s capacity %u (hundredths of a percent), status %u, present %u, %d uV, %d uA, temperature %d "
+			    "(hundredths of a degree), charge %u uAh, USB online %u (type %u, %u uV, %u uA)\n",
+			    good ? "the DSP says:" : "NO ANSWER to all of", capacity, status, present, (int)volt, (int)curr, (int)temp,
+			    charge, usb, usb_type, usb_volt, usb_curr);
+			if (round % 30 == 0 && good) {
+				tell("apollo adsp: battmgr: full charge %u uAh, as designed %u uAh, %u cycles\n", full, design, cycles);
+			}
+		}
+		for (unsigned ms = 0; ms < BATTMGR_SECONDS * 1000 && battmgr.wanted && glink.up; ms += 50) {
+			sleep_ms(50);
+		}
+	}
+	battmgr.runs = false;
+	thread_terminate(current_thread());
+}
+
+static void
+battmgr_start(void)
+{
+	thread_t thread;
+
+	uint32_t wanted = 0;            /* (apollo: the battery comes from the UEFI's charger drivers, hakios.apollo_battery.c) */
+
+	PE_parse_boot_argn("apollo_battmgr", &wanted, sizeof(wanted));
+	if (wanted == 0 || battmgr.runs) {
+		return;
+	}
+	if (option("battery")) {
+		/* (the loader's way, through Qualcomm's UEFI charger drivers: one way to the battery at a time) */
+		tell("apollo adsp: battmgr: not with battery=1: the battery is asked about the loader's way\n");
+		return;
+	}
+	battmgr.wanted = true;
+	if (kernel_thread_start(battmgr_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_set_thread_name(thread, "apollo battmgr");
+		thread_deallocate(thread);
+	}
+}
+
+static void
+battmgr_stop(void)
+{
+	battmgr.wanted = false;
+	for (unsigned ms = 0; ms < 2000 && battmgr.runs; ms++) {
+		sleep_ms(1);
+	}
+}
+
+/* ---- the link's thread ----------------------------------------------------------------------------- */
+
+static volatile bool link_wanted, link_runs;
+
+static void
+link_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	struct smp2p words, last;
+	struct glink_packet *packet;
+	bool gave_up = false;
+
+	bzero(&last, sizeof(last));
+	dsp_words(&last);
+	while (link_wanted) {
+		sleep_us(1000);
+		doorbells();
+		if (dsp_words(&words) && memcmp(&words, &last, sizeof(words)) != 0) {
+			last = words;
+			dsp_listen(&words);
+			if ((dsp_state(&words) & DSP_FATAL) && !gave_up) {
+				gave_up = true;
+				printf("apollo adsp: link: THE AUDIO DSP SAYS IT HAS GIVEN UP (\"slave-kernel\" = %#x)\n", dsp_state(&words));
+				show_crash_reason();
+			}
+		}
+		for (;;) {
+			unsigned from = CHANNELS;
+
+			lck_mtx_lock(&glink_lock);
+			glink_pump();
+			packet = NULL;
+			for (unsigned c = 0; c < CHANNELS && packet == NULL; c++) {
+				struct glink_channel *channel = &glink.channel[c];
+
+				if ((packet = channel->first) != NULL) {
+					channel->first = packet->next;
+					channel->last = channel->first == NULL ? NULL : channel->last;
+					from = c;
+				}
+			}
+			lck_mtx_unlock(&glink_lock);
+			if (packet == NULL) {
+				break;
+			}
+			if (from == CHANNEL_QRTR) {
+				qrtr_input(packet->data, packet->length);
+			} else if (from == CHANNEL_PMIC) {
+				battmgr_input(packet->data, packet->length);
+			} else {
+				apr_input(packet->data, packet->length);
+			}
+			kfree_data(packet, sizeof(*packet) + packet->length);
+		}
+	}
+	link_runs = false;
+	thread_terminate(current_thread());
+}
+
+static void
+link_stop(void)
+{
+	struct glink_packet *packet;
+
+	if (link_runs) {
+		link_wanted = false;
+		for (unsigned ms = 0; ms < 2000 && link_runs; ms++) {
+			sleep_ms(1);
+		}
+		printf("apollo adsp: link: %s; GLINK said %u and heard %u messages, QRTR sent %u and received %u datagrams, APR %u and %u "
+		    "packets; its doorbells heard: GLINK %u, SMP2P %u\n", link_runs ? "THE THREAD DOES NOT END" : "down", glink.said,
+		    glink.heard, qrtr_out, qrtr_in, apr_out, apr_in, doorbell.glink, doorbell.smp2p);
+	}
+	lck_mtx_lock(&glink_lock);
+	glink.up = false;
+	for (unsigned c = 0; c < CHANNELS; c++) {
+		struct glink_channel *channel = &glink.channel[c];
+
+		channel->open = false;
+		while ((packet = channel->first) != NULL) {
+			channel->first = packet->next;
+			kfree_data(packet, sizeof(*packet) + packet->length);
+		}
+		channel->last = NULL;
+	}
+	lck_mtx_unlock(&glink_lock);
+	bzero(qrtr_servers, sizeof(qrtr_servers));
+	qrtr_peer = 0;
+}
+
+/* ---- step 8: GLINK's queues, looked at -------------------------------------------------------------- */
+
+static bool
+step_queues(void)
+{
+	struct glink_message message;
+	uint32_t head, tail;
+
+	announce("find GLINK's descriptor and the two queues, and read what the audio DSP has put into its own");
+	/*
+	 * Apollo's DSP makes the descriptor (478) and its own queue (480) but leaves ours (479) to us, as Linux expects
+	 * (qcom_glink_smem_register(): qcom_smem_alloc() of FIFO_0, 16 KB): made here when it is not there.
+	 */
+	if (!glink_find() && glink.descriptor != 0 && glink.theirs != 0 && glink.ours == 0) {
+		uint32_t cacheline = 0, size = 0, partition = smem_partition(SMEM_US, SMEM_ADSP, &cacheline, &size);
+
+		printf("apollo adsp: %u: our GLINK queue (item %u) is not there: it is ours to make, 16384 bytes\n", step,
+		    ITEM_GLINK_OUR_QUEUE);
+		if (partition == 0 || !item_make(partition, ITEM_GLINK_OUR_QUEUE, 16384)) {
+			return false;
+		}
+		glink_reset();          /* our write mark and our read mark of the DSP's queue at zero, as Linux sets them */
+	}
+	if (!glink_find()) {
+		printf("apollo adsp: %u: GLINK's items are not all there, or not of a shape this knows (descriptor %#x, ours %#x of %u bytes, "
+		    "the DSP's %#x of %u)\n", step, glink.descriptor, glink.ours, glink.ours_size, glink.theirs, glink.theirs_size);
+		return false;
+	}
+	head = smem_word(glink.descriptor + GLINK_THEIR_HEAD);
+	tail = smem_word(glink.descriptor + GLINK_THEIR_TAIL);
+	printf("apollo adsp: %u: our queue: %u bytes at %#lx, written to %#x, read by the DSP to %#x; the DSP's: %u bytes at %#lx, written "
+	    "to %#x, read by us to %#x\n", step, glink.ours_size, SMEM_PHYS + glink.ours, smem_word(glink.descriptor + GLINK_OUR_HEAD),
+	    smem_word(glink.descriptor + GLINK_OUR_TAIL), glink.theirs_size, SMEM_PHYS + glink.theirs, head, tail);
+	for (uint32_t at = 0, shown = 0; at + sizeof(message) <= head && head < glink.theirs_size && tail == 0 && shown < 8; shown++) {
+		char name[33] = "";
+		uint32_t length = sizeof(message);
+
+		glink_peek(&message, at, sizeof(message));
+		if (message.command == GLINK_OPEN) {
+			glink_peek(name, at + 8, message.param2 < 32 ? message.param2 : 32);
+			length += message.param2;
+		}
+		printf("apollo adsp: %u:   in the DSP's queue at %#x: %s %u %#x %s\n", step, at, glink_name(message.command), message.param1,
+		    message.param2, name);
+		if (message.command != GLINK_VERSION && message.command != GLINK_OPEN) {
+			break;
+		}
+		at += (length + 7) & ~7u;
+	}
+	return true;
+}
+
+/* ---- step 9: GLINK, spoken -------------------------------------------------------------------------- */
+
+static bool
+step_link(void)
+{
+	thread_t thread;
+	uint64_t began;
+
+	if (!dsp_started || glink.descriptor == 0) {
+		return false;
+	}
+	announce("take up GLINK with the audio DSP: our version, then whatever its messages call for; a thread of ours listens "
+	    "from here on, every millisecond");
+	snprintf(last_write, sizeof(last_write), "step %u took up GLINK", step);
+	lck_mtx_lock(&glink_lock);
+	glink.features = GLINK_INTENT_REUSE;
+	glink.agreed = glink.broken = false;
+	glink.said = glink.heard = 0;
+	for (unsigned c = 0; c < CHANNELS; c++) {
+		struct glink_channel *channel = &glink.channel[c];
+
+		channel->asked = channel->acknowledged = channel->open = false;
+		channel->theirs = channel->our_intent_count = 0;
+		bzero(channel->their_intents, sizeof(channel->their_intents));
+	}
+	apr_in = apr_out = 0;
+	audio_up = false;
+	bzero(glink.others, sizeof(glink.others));
+	glink.trace = 60;
+	glink.up = true;
+	qrtr_hellos = qrtr_in = qrtr_out = qrtr_lookups = 0;
+	doorbell.since = began = now_us();
+	glink_say(GLINK_VERSION, GLINK_VERSION_1, glink.features, NULL, 0);
+	lck_mtx_unlock(&glink_lock);
+	link_wanted = link_runs = true;
+	if (kernel_thread_start(link_thread, NULL, &thread) != KERN_SUCCESS) {
+		link_wanted = link_runs = false;
+		printf("apollo adsp: %u: no thread\n", step);
+		return false;
+	}
+	thread_set_thread_name(thread, "apollo adsp link");
+	thread_deallocate(thread);
+	for (unsigned ms = 0; ms < 5000 && !glink.channel[CHANNEL_QRTR].open && !glink.broken; ms++) {
+		sleep_ms(1);
+	}
+	sleep_ms(50);
+	printf("apollo adsp: %u: %llu ms after our version: versions %s (features %#x); the channel \"IPCRTR\" is %s, \"apr_audio_svc\" %s; "
+	    "the DSP also opened \"%s\" \"%s\" \"%s\" \"%s\"\n", step, (now_us() - began) / 1000, glink.agreed ? "agreed" :
+	    "NOT AGREED", glink.features, glink.channel[CHANNEL_QRTR].open ? "OPEN" : "NOT OPEN",
+	    glink.channel[CHANNEL_APR].open ? "OPEN" : "NOT OPEN", glink.others[0], glink.others[1], glink.others[2], glink.others[3]);
+	return glink.channel[CHANNEL_QRTR].open;
+}
+
+/* ---- step 10: QRTR ---------------------------------------------------------------------------------- */
+
+static bool
+step_qrtr(void)
+{
+	unsigned services = 0;
+
+	if (!glink.channel[CHANNEL_QRTR].open) {
+		return false;
+	}
+	PE_parse_boot_argn("apollo_adsp_listen", &listen_seconds, sizeof(listen_seconds));
+	announce("listen to QRTR on the channel: the DSP's hello (answered from the link's thread), and the services it tells of");
+	for (unsigned ms = 0; ms < listen_seconds * 1000; ms++) {
+		sleep_ms(1);
+	}
+	for (unsigned i = 0; i < sizeof(qrtr_servers) / sizeof(qrtr_servers[0]); i++) {
+		services += qrtr_servers[i].there;
+	}
+	printf("apollo adsp: %u: after %u s: %s; the DSP is node %u and has told of %u services; it looked for %u of ours; QRTR received %u "
+	    "and sent %u datagrams\n", step, listen_seconds, qrtr_hellos ? "HELLO BOTH WAYS" : "NO HELLO FROM THE DSP", qrtr_peer,
+	    services, qrtr_lookups, qrtr_in, qrtr_out);
+	return qrtr_hellos != 0;
+}
+
+/* ---- step 11: APR ---------------------------------------------------------------------------------- */
+
+static bool
+step_apr(void)
+{
+	uint32_t wait_seconds = 10, asked = 0, state = 0;
+	uint64_t began = now_us();
+
+	PE_parse_boot_argn("apollo_adsp_apr_wait", &wait_seconds, sizeof(wait_seconds));
+	announce("ask the audio DSP's core service over APR whether the audio services are up (again and again, as Android "
+	    "does), then which services it has");
+	for (unsigned ms = 0; ms < 3000 && !glink.channel[CHANNEL_APR].open; ms++) {
+		sleep_ms(1);
+	}
+	if (!glink.channel[CHANNEL_APR].open) {
+		printf("apollo adsp: %u: the channel \"apr_audio_svc\" is not open: the DSP has not opened it\n", step);
+		return false;
+	}
+	while (now_us() - began < wait_seconds * 1000000ull) {
+		asked++;
+		if (apr_ask(APR_SVC_ADSP_CORE, AVCS_CMD_ADSP_EVENT_GET_STATE, NULL, 0, 500) &&
+		    apr_reply.opcode == AVCS_CMDRSP_ADSP_EVENT_GET_STATE) {
+			state = apr_reply.words[0];
+			if (state == 1) {
+				break;
+			}
+		}
+		sleep_ms(200);
+	}
+	audio_up = state == 1;
+	printf("apollo adsp: %u: %s after %llu ms and %u questions (the last answer: opcode %#x, %u bytes, %#x)\n", step, state == 1 ?
+	    "THE AUDIO SERVICES ARE UP" : "THE AUDIO SERVICES DO NOT SAY THEY ARE UP", (now_us() - began) / 1000, asked,
+	    apr_reply.opcode, apr_reply.length, apr_reply.words[0]);
+	if (apr_ask(APR_SVC_ADSP_CORE, AVCS_GET_VERSIONS, NULL, 0, 1000)) {
+		char line[400];
+		int at = 0;
+
+		line[0] = 0;
+		for (uint32_t i = 0; i < apr_reply.length / 4 && i < 64 && at < (int)sizeof(line) - 12; i++) {
+			at += snprintf(line + at, sizeof(line) - (size_t)at, " %#x", apr_reply.words[i]);
+		}
+		printf("apollo adsp: %u: the services and their versions (opcode %#x, %u bytes):%s\n", step, apr_reply.opcode,
+		    apr_reply.length, line);
+	} else {
+		printf("apollo adsp: %u: no answer to the question of the services' versions\n", step);
+	}
+	return state == 1;
+}
+
+/* ---- the steps, and their end ----------------------------------------------------------------------- */
+
+static bool (*const steps[STEPS])(void) = {
+	step_survey, step_firmware, step_mailbox, step_header, step_image, step_our_item, step_start, step_queues, step_link,
+	step_qrtr, step_apr,
+};
+
+static bool keep;                       /* the DSP and the link stay up while the system runs (adsp_keep, adsp=1) */
+
+static void
+steps_over(uint32_t done)
+{
+	lck_mtx_lock(&dsp_lock);
+	if (dsp_started && done == last_step && keep) {
+		printf("apollo adsp: THE AUDIO DSP STAYS ON while the system runs%s\n", link_runs ? ", and the link with it" : "");
+	} else if (dsp_started) {
+		dsp_shutdown("the steps are over");
+	}
+	if (!dsp_started && image_taken) {
+		/* (TrustZone took the header, step 4, and the DSP was not started after it: what it holds of the image, given back) */
+		uint64_t answer = ~0ull;
+		int32_t result = scm("to forget the audio DSP's image, never started", SCM_PAS_SHUTDOWN, SCM_ONE_VALUE, PAS_ADSP, 0, 0,
+		    &answer);
+
+		printf("apollo adsp: %u: TrustZone %s the image it was given (the call returns %d, its answer is %#llx)\n", step,
+		    result == 0 && answer == 0 ? "forgets" : "DOES NOT FORGET", result, answer);
+		image_taken = false;
+		image_written = false;
+	}
+	image_forget();                         /* (what was read of the root and not yet written, step 5, given back) */
+	lck_mtx_unlock(&dsp_lock);
+}
+
+/* When the run ends in order: a DSP that runs is shut down, for the next kernel to start again. */
+void
+apollo_adsp_stop(void)
+{
+	battmgr_stop();
+	apollo_sound_dsp_down();                /* the amplifiers, the stream and the port first, while the DSP still listens */
+	apollo_mic_dsp_down();                  /* and what the microphone's path has asked for */
+	lck_mtx_lock(&dsp_lock);
+	if (dsp_started) {
+		unsigned services = 0;
+		uint32_t node = qrtr_peer;
+		bool down;
+
+		for (unsigned i = 0; i < sizeof(qrtr_servers) / sizeof(qrtr_servers[0]); i++) {
+			services += qrtr_servers[i].there;
+		}
+		down = dsp_shutdown("the run is about to end");
+		/* (said again at the end: a long run's log keeps its beginning and its end, and the middle may be gone) */
+		tell("apollo adsp: the audio DSP is off: it had been up%s (node %u, %u services; audio services %s), it %s, and TrustZone %s\n",
+		    node ? " and linked" : ", NOT LINKED", node, services, audio_up ? "up" : "NOT UP", stopped_by_its_word ?
+		    "stopped when asked" : "DID NOT SAY IT HAD STOPPED", down ? "has shut it down" : "DID NOT SHUT IT DOWN");
+	}
+	lck_mtx_unlock(&dsp_lock);
+}
+
+/* The same on a panic's way back to the loader: one processor, interrupts off, no lock, no sleep. */
+void
+apollo_adsp_quiesce(void)
+{
+	apollo_sound_quiesce();                 /* the amplifiers off, whatever the DSP's state */
+	apollo_mic_quiesce();                   /* the codec into reset, if it was let out; the microphone's lines said again */
+	if (!dsp_started) {
+		return;
+	}
+	leaving = true;
+	new_from = ~0u;
+	dsp_shutdown("the kernel is on its way back to the loader");
+}
+
+static void
+run_steps(void)
+{
+	uint32_t done = 0;
+
+	for (step = 1; step <= last_step; step++) {
+		if (!steps[step - 1]()) {
+			printf("apollo adsp: step %u: FAILED; the steps after it are not attempted\n", step);
+			break;
+		}
+		printf("apollo adsp: step %u: done\n", step);
+		done = step;
+	}
+	step = done;
+	new_from = STEPS + 1;
+	steps_over(done);
+	printf("apollo adsp: over after step %u; %s\n", done, last_write);
+}
+
+static void
+whole_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	uint64_t began = now_us();
+	unsigned services = 0;
+
+	/* (the firmware may be on the root file system, which is not mounted yet when this begins: a minute at most) */
+	for (unsigned waited = 0; waited < 300 && rootvnode == NULLVP; waited++) {
+		sleep_ms(200);
+	}
+	run_steps();
+	for (unsigned i = 0; i < sizeof(qrtr_servers) / sizeof(qrtr_servers[0]); i++) {
+		services += qrtr_servers[i].there;
+	}
+	if (step == STEPS && dsp_started) {
+		tell("apollo adsp: THE AUDIO DSP IS UP AND LINKED, its audio services up (APR), %llu ms after the kernel began on it (the "
+		    "root's waited for included): node %u, %u services; it stays on\n", (now_us() - began) / 1000, qrtr_peer, services);
+		apollo_sound_dsp_up();          /* (apollo_audio=2 and up: the speakers' path, hakios.apollo_sound.c) */
+		apollo_mic_dsp_up();            /* (apollo_mic=N: the main microphone's path, hakios.apollo_mic.c) */
+		battmgr_start();                /* (how the battery is, from the DSP: only with apollo_battmgr=1 or 2) */
+	} else {
+		tell("apollo adsp: THE AUDIO DSP DID NOT COME UP: step %u failed (%s); see the kernel's own log for the steps\n", step + 1,
+		    last_write);
+	}
+	thread_terminate(current_thread());
+}
+
+/* Called while the system starts (bsd/dev/hakios.apollo_input.c). */
+void
+apollo_adsp_init(void)
+{
+	uint32_t on = 0;
+	thread_t thread;
+
+	char device[24] = "";
+
+	/* (hakios.apollo_input.c calls this only on device=apollo; said again here, as the SoC base is redwood's too) */
+	if (!PE_parse_boot_argn("device", device, sizeof(device)) || strcmp(device, "apollo") != 0) {
+		return;
+	}
+	PE_parse_boot_argn("apollo_adsp_step", &last_step, sizeof(last_step));
+	if (last_step == 0 && (!PE_parse_boot_argn("apollo_audio", &on, sizeof(on)) || on == 0)) {
+		return;
+	}
+	if (last_step == 0) {
+		/* all of it, on a thread of its own, and left up */
+		last_step = STEPS;
+		keep = true;
+		quiet = false;          /* (apollo: every step into the loader's log too, while it is being brought up) */
+		pause_ms = 0;
+		listen_seconds = 1;
+		new_from = STEPS + 1;
+		if (kernel_thread_start(whole_thread, NULL, &thread) != KERN_SUCCESS) {
+			printf("apollo adsp: no thread: the audio DSP is not brought up\n");
+			return;
+		}
+		thread_set_thread_name(thread, "apollo adsp start");
+		thread_deallocate(thread);
+		tell("apollo adsp: the audio DSP is being brought up beside the system's start (apollo_audio=%u)\n", on);
+		return;
+	}
+	if (last_step > STEPS) {
+		last_step = STEPS;
+	}
+	keep = option("apollo_adsp_keep");
+	new_from = last_step;
+	PE_parse_boot_argn("apollo_adsp_new", &new_from, sizeof(new_from));
+	PE_parse_boot_argn("apollo_adsp_pause", &pause_ms, sizeof(pause_ms));
+	printf("apollo adsp: steps up to %u; those from %u on are new and wait %u ms after each announcement\n", last_step, new_from,
+	    pause_ms);
+	run_steps();
+	if (option("apollo_adsp_return")) {
+		printf("apollo adsp: back to the loader (adsp_return)\n");
+		loader_return();
+	}
+	printf("apollo adsp: the system goes on starting\n");
+}
diff --git a/bsd/dev/hakios.apollo_audio.c b/bsd/dev/hakios.apollo_audio.c
new file mode 100644
index 000000000000..5dcfe3a50961
--- /dev/null
+++ b/bsd/dev/hakios.apollo_audio.c
@@ -0,0 +1,322 @@
+/*
+ * /dev/apollo-audio: what iOS plays, for the Xiaomi Mi 10T (apollo). A copy of bsd/dev/hakios.audio.c without its
+ * recording and without the redwood drivers it starts; the plug-in's protocol is the same (sys/hakios.apollo_audio.h).
+ * hakios.apollo_sound.c takes the frames (apollo_audio=5).
+ */
+/*
+ * /dev/apollo-audio: the sound that iOS plays (see sys/hakios.audio.h).
+ *
+ * What is written goes to a sink, a driver that plays it: on apollo the speakers, through the
+ * audio DSP (hakios.apollo_sound.c, apollo_audio=5), when it is up; else nowhere.
+ *
+ * (redwood's copy also keeps a recording, boot-arg rec_sound=N, for the loader to hand to the host.
+ * Here that is NOT there yet: nothing takes the recording's memory -- rec_base stays NULL --, so
+ * rec_sound, rec_sound_fed and rec_sound_mic do nothing, and audio_record() below returns at once.
+ * Its code is kept as redwood's is, for when it is brought over.)
+ *
+ * When the writer has stopped, a line in the log says how long it wrote, at what rate, how much
+ * of it was not silence and how loud: the only way to "hear" a machine one cannot listen to.
+ * (The audio server writes for as long as its device runs, a second or two beyond the sound.)
+ */
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread_call.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <mach/vm_param.h>
+#include <miscfs/devfs/devfs.h>
+#include <pexpert/pexpert.h>
+#include <sys/conf.h>
+#include <sys/errno.h>
+#include <sys/proc.h>
+#include <sys/hakios.apollo_audio.h>
+#include <sys/hakios.apollo_input.h>
+
+/* into the loader's log as well (as the other apollo drivers): whether iOS writes is to be seen during a run */
+extern void loader_log_putc(char c);
+
+static int say(const char *format, ...) __printflike(1, 2);
+
+static int
+say(const char *format, ...)
+{
+	char line[300];
+	va_list list;
+
+	va_start(list, format);
+	vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
+	for (const char *c = line; *c != 0; c++) {
+		loader_log_putc(*c);
+	}
+	return printf("%s", line);
+}
+#include <sys/systm.h>
+#include <sys/uio.h>
+#include <vm/vm_kern.h>
+
+extern uint64_t kvtophys(vm_offset_t va);       /* pmap_paddr_t */
+
+#define CHUNK_FRAMES    1024            /* what one pass of write() moves */
+#define QUIET_MS        500             /* no write for this long: the writer has stopped */
+#define SILENCE         8               /* samples no larger than this are silence */
+#define REC_MAX_SECONDS 1200            /* 220 MB */
+#define MAX_BELOW       (102 * 8)       /* the most iOS's volume may be under the loudest: 102 dB, in eighths */
+
+struct rec_header {
+	char     magic[8];              /* "RWSND001" */
+	uint32_t rate, channels;        /* APOLLO_AUDIO_RATE, HAKIOS_AUDIO_CHANNELS; the samples are 16-bit */
+	uint32_t blocks;
+	uint32_t reserved;
+};
+struct rec_block {
+	uint64_t nanoseconds;           /* when it was written, since the kernel started */
+	uint32_t frames;
+	uint32_t reserved;
+};
+
+/* { physical address, bytes, kernel address } of the recording, for the loader: osfmk/arm64/loader_return.c */
+extern uint64_t loader_sound[3];
+
+static LCK_GRP_DECLARE(audio_lck_grp, "apollo-audio");
+static LCK_MTX_DECLARE(audio_lock, &audio_lck_grp);
+static LCK_MTX_DECLARE(audio_write_lock, &audio_lck_grp);      /* one write() at a time: write_frames is its */
+
+static apollo_audio_sink_t audio_sink;
+
+static uint8_t *rec_base;
+static bool rec_fed;                    /* boot-arg rec_sound_fed=1: what the guard let through is recorded, not what was written */
+static bool rec_mic;                    /* boot-arg rec_sound_mic=1: what the microphone hears (hakios.mic.c) */
+static uint64_t rec_size, rec_used;
+static uint64_t rec_frames, rec_frames_max;
+
+/* the stretch of writing in progress */
+static uint64_t stretch_first, stretch_last;    /* mach_absolute_time() of its first and its latest write */
+static uint64_t stretch_frames, stretch_latest; /* frames written, and how many of them by the latest write */
+static uint64_t stretch_sound, stretch_lost;    /* frames in writes that were not silence; frames the sink did not take */
+static uint32_t stretch_peak;                   /* the largest sample, as an absolute value */
+static thread_call_t report_call;
+static bool report_armed;
+
+static void
+audio_report(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	uint64_t frames, latest, sound, lost, deadline, since = 0, lasted = 0;
+	uint32_t loudest;
+
+	lck_mtx_lock(&audio_lock);
+	absolutetime_to_nanoseconds(mach_absolute_time() - stretch_last, &since);
+	if (since < QUIET_MS * NSEC_PER_MSEC) {
+		/* still writing: look again later */
+		clock_interval_to_deadline(2 * QUIET_MS, NSEC_PER_MSEC, &deadline);
+		thread_call_enter_delayed(report_call, deadline);
+		lck_mtx_unlock(&audio_lock);
+		return;
+	}
+	absolutetime_to_nanoseconds(stretch_last - stretch_first, &lasted);
+	frames = stretch_frames;
+	latest = stretch_latest;
+	sound = stretch_sound;
+	lost = stretch_lost;
+	loudest = stretch_peak;
+	stretch_frames = stretch_sound = stretch_lost = 0;
+	stretch_peak = 0;
+	report_armed = false;
+	lck_mtx_unlock(&audio_lock);
+
+	say("apollo-audio: %llu.%02llu s written", frames / APOLLO_AUDIO_RATE,
+	    frames % APOLLO_AUDIO_RATE * 100 / APOLLO_AUDIO_RATE);
+	if (lasted >= NSEC_PER_SEC) {
+		/* what was written before the latest write took the time between the first and the latest */
+		printf(" at %llu frames a second", (frames - latest) * NSEC_PER_SEC / lasted);
+	}
+	printf(", %llu.%02llu s of it sound, peak %u%% of full scale", sound / APOLLO_AUDIO_RATE,
+	    sound % APOLLO_AUDIO_RATE * 100 / APOLLO_AUDIO_RATE, loudest * 100 / 32768);
+	if (lost) {
+		printf(", %llu ms lost (the sink was full)", lost * 1000 / APOLLO_AUDIO_RATE);
+	}
+	printf("\n");
+}
+
+/* With audio_lock held. */
+static void
+audio_record(const int16_t *frames, uint32_t count)
+{
+	struct rec_header *header = (struct rec_header *)rec_base;
+	struct rec_block *block;
+	uint64_t bytes = (uint64_t)count * HAKIOS_AUDIO_FRAME;
+
+	if (rec_base == NULL || rec_frames >= rec_frames_max || rec_used + sizeof(*block) + bytes > rec_size) {
+		return;
+	}
+	block = (struct rec_block *)(rec_base + rec_used);
+	absolutetime_to_nanoseconds(mach_absolute_time(), &block->nanoseconds);
+	block->frames = count;
+	block->reserved = 0;
+	memcpy(block + 1, frames, bytes);
+	rec_used += sizeof(*block) + bytes;
+	rec_frames += count;
+	header->blocks++;
+	loader_sound[1] = rec_used;
+	if (rec_frames >= rec_frames_max) {
+		say("apollo-audio: recording finished: %llu s in %u writes\n", rec_frames / APOLLO_AUDIO_RATE, header->blocks);
+	}
+}
+
+bool
+apollo_audio_recording_fed(void)
+{
+	return false;                  /* (no recording on apollo yet) */
+}
+
+
+/* From the speakers' feeder: what the guard let through, into the recording (rec_sound_fed=1). */
+void
+apollo_audio_record_fed(__unused const int16_t *frames, __unused uint32_t count)
+{
+}
+
+static void
+audio_play(const int16_t *frames, uint32_t count)
+{
+	uint32_t loudest = 0, taken = 0;
+	uint64_t deadline;
+
+	for (uint32_t i = 0; i < count * HAKIOS_AUDIO_CHANNELS; i++) {
+		uint32_t level = frames[i] < 0 ? -(int32_t)frames[i] : frames[i];
+
+		if (level > loudest) {
+			loudest = level;
+		}
+	}
+	lck_mtx_lock(&audio_lock);
+	if (!rec_fed && !rec_mic) {
+		audio_record(frames, count);
+	}
+	if (audio_sink != NULL) {
+		taken = audio_sink(frames, count);
+		stretch_lost += count - taken;
+	}
+	stretch_last = mach_absolute_time();
+	if (stretch_frames == 0) {
+		stretch_first = stretch_last;
+	}
+	stretch_frames += count;
+	stretch_latest = count;
+	if (loudest > SILENCE) {
+		stretch_sound += count;
+	}
+	if (loudest > stretch_peak) {
+		stretch_peak = loudest;
+	}
+	if (!report_armed && report_call != NULL) {
+		report_armed = true;
+		clock_interval_to_deadline(2 * QUIET_MS, NSEC_PER_MSEC, &deadline);
+		thread_call_enter_delayed(report_call, deadline);
+	}
+	lck_mtx_unlock(&audio_lock);
+}
+
+void
+apollo_audio_set_sink(const char *name, apollo_audio_sink_t sink)
+{
+	lck_mtx_lock(&audio_lock);
+	audio_sink = sink;
+	lck_mtx_unlock(&audio_lock);
+	say("apollo-audio: sound goes to %s\n", name);
+}
+
+static int
+audio_open(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static int
+audio_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+/* (4 KB: not on the kernel's stack; audio_write_lock is held while it is used, as uiomove() may sleep and audio_lock is not) */
+static int16_t write_frames[CHUNK_FRAMES * HAKIOS_AUDIO_CHANNELS];
+
+static int
+audio_write(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	int16_t *frames = write_frames;
+	int error = 0;
+
+	lck_mtx_lock(&audio_write_lock);
+	while (uio_resid(uio) >= HAKIOS_AUDIO_FRAME) {
+		user_ssize_t bytes = uio_resid(uio);
+
+		if (bytes > (user_ssize_t)sizeof(write_frames)) {
+			bytes = sizeof(write_frames);
+		}
+		bytes -= bytes % HAKIOS_AUDIO_FRAME;
+		error = uiomove((caddr_t)frames, (int)bytes, uio);
+		if (error) {
+			break;
+		}
+		audio_play(frames, (uint32_t)(bytes / HAKIOS_AUDIO_FRAME));
+	}
+	lck_mtx_unlock(&audio_write_lock);
+	return error;
+}
+
+/* the speakers' volume, as iOS sets it (sys/hakios.audio.h): kept for the sink's driver to look at */
+static uint32_t volume_below, volume_generation;
+static bool volume_muted;
+
+static int
+audio_ioctl(__unused dev_t dev, u_long command, caddr_t data, __unused int flags, __unused struct proc *p)
+{
+	const struct apollo_audio_volume *volume = (const struct apollo_audio_volume *)data;
+	uint32_t below;
+
+	if (command != APOLLO_AUDIO_SET_VOLUME) {
+		return ENOTTY;
+	}
+	/* (whoever opens the device may say anything: no more than MAX_BELOW, for the sink's sums not to wrap) */
+	below = volume->below > MAX_BELOW ? MAX_BELOW : volume->below;
+	lck_mtx_lock(&audio_lock);
+	volume_below = below;
+	volume_muted = volume->muted != 0;
+	volume_generation++;
+	lck_mtx_unlock(&audio_lock);
+	say("apollo-audio: the volume: %s%u.%03u dB under the loudest\n", volume->muted ? "muted; " : "", below / 8,
+	    below % 8 * 125);
+	return 0;
+}
+
+bool
+apollo_audio_volume(uint32_t *below, bool *muted, uint32_t *generation)
+{
+	lck_mtx_lock(&audio_lock);
+	*below = volume_below;
+	*muted = volume_muted;
+	*generation = volume_generation;
+	lck_mtx_unlock(&audio_lock);
+	return *generation != 0;
+}
+
+static const struct cdevsw audio_cdevsw = {
+	.d_open = audio_open, .d_close = audio_close, .d_read = eno_rdwrt, .d_write = audio_write,
+	.d_ioctl = audio_ioctl, .d_stop = eno_stop, .d_reset = eno_reset, .d_select = eno_select,
+	.d_mmap = eno_mmap, .d_strategy = eno_strat, .d_type = 0
+};
+
+
+void
+apollo_audio_init(void)
+{
+	int major = cdevsw_add(-1, &audio_cdevsw);
+
+	if (major < 0 || devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "apollo-audio") == NULL) {
+		say("apollo-audio: cannot create the device\n");
+		return;
+	}
+	report_call = thread_call_allocate(audio_report, NULL);
+	say("apollo-audio: /dev/apollo-audio is there for iOS's audio plug-in\n");
+}
diff --git a/bsd/dev/hakios.apollo_backlight.c b/bsd/dev/hakios.apollo_backlight.c
new file mode 100644
index 000000000000..b6021c7b8030
--- /dev/null
+++ b/bsd/dev/hakios.apollo_backlight.c
@@ -0,0 +1,475 @@
+/*
+ * The backlight of the Xiaomi Mi 10T (apollo), with boot-arg apollo_backlight=P (1 to 100: the brightness the run starts
+ * with; without it the level the firmware left stays until iOS sets another) -- bsd/dev/hakios.apollo_input.c.
+ *
+ * The Mi 10T's panel is an LCD whose light is the PM8150L's WLED (the device tree's panel mdss_dsi_j3s_37_02_0a_dsc_video:
+ * qcom,mdss-dsi-bl-pmic-control-type "bl_ctrl_wled", levels 2 to 0xfff; the node qcom,wled@d800 of the pmic at SPMI
+ * slave 5, "qcom,pm8150l-spmi-wled": the control block at 0xd800 and the sink block at 0xd900, strings 0 to 2). It is a
+ * WLED of the fifth kind, whose registers are those of Linux's drivers/video/backlight/qcom-wled.c (WLED5): the
+ * brightness of module A (or B, whichever the first string takes its current from) is a 12-bit (or 15-bit) value at
+ * sink +0x53/+0x54 (+0x63/+0x64), taken over when the sync register (+0x65) is toggled; the module's enable is bit 7
+ * of the control block's register 0x46. The firmware has set all of that up, because it had the panel lit: only the
+ * brightness and the enable are written here, and the registers are read and logged first, so that a run says what
+ * it found.
+ *
+ * What the driver gives iOS: the brightness (iOS's 16.16 fixed-point IOMFBBrightnessLevel, set through
+ * IOMobileFramebuffer's properties: iokit/Kernel/MiniIOMobileFramebuffer.cpp) and the display's power (its request for
+ * power change: off dims the light to nothing, on gives it back). And for a look from outside, the sysctls
+ * kern.apollo.backlight (percent) and kern.apollo.backlight_raw.
+ *
+ * The SPMI arbiter is the one hakios.apollo_buttons.c reads through (version 5, 0xc440000); writes go through the channel
+ * region (the device tree's "chnls", 0xc600000: in version 5 a page of 0x10000 for each channel, pmic_arb_offset_v5; the
+ * first tries wrote elsewhere and hung the phone), reads through the observer (0xe600000): Linux's
+ * drivers/spmi/spmi-pmic-arb.c.
+ */
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include <sys/hakios.apollo_input.h>
+#include <sys/sysctl.h>
+#include <sys/systm.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+/* into the loader's log as well (as the other apollo drivers) */
+extern void loader_log_putc(char c);
+
+static int say(const char *format, ...) __printflike(1, 2);
+
+static int
+say(const char *format, ...)
+{
+	char line[300];
+	va_list list;
+
+	va_start(list, format);
+	vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
+	for (const char *c = line; *c != 0; c++) {
+		loader_log_putc(*c);
+	}
+	return printf("%s", line);
+}
+
+static inline uint32_t
+rd(vm_offset_t address)
+{
+	return *(volatile uint32_t *)address;
+}
+
+static inline void
+wr(vm_offset_t address, uint32_t value)
+{
+	*(volatile uint32_t *)address = value;
+}
+
+/* ---- the SPMI arbiter ------------------------------------------------------------------------------- */
+
+#define ARB_CORE_PHYS           0x0c440000UL
+#define ARB_CORE_SIZE           0x1100UL
+#define ARB_CNFG_PHYS           0x0c40a000UL
+#define ARB_CNFG_SIZE           0x1000UL
+#define ARB_CHANNELS_PHYS       0x0c600000UL    /* the device tree's "chnls": 0x10000 per channel (v5: not per system) */
+#define ARB_OBSERVER_PHYS       0x0e600000UL    /* reads only: 0x10000 per system, 0x80 per channel */
+#define ARB_REGION_SIZE         0x10000UL
+#define ARB_SYSTEM              0
+#define ARB_FEATURES            0x004           /* [10:0] channels */
+#define ARB_CHANNEL(n)          (0x900 + 4 * (n))       /* [19:8] slave << 8 | peripheral */
+#define ARB_OWNER(n)            (0x700 + 4 * (n))       /* [2:0] the system that owns channel n */
+#define ARB_MAX_CHANNELS        512
+
+#define CHANNEL_COMMAND         0x00
+#define CHANNEL_STATUS          0x08
+#define CHANNEL_RDATA0          0x18
+#define CHANNEL_WDATA0          0x10
+#define STATUS_DONE             0x1
+#define STATUS_FAILURE          0x2
+#define STATUS_DENIED           0x4
+#define STATUS_DROPPED          0x8
+#define OP_EXT_WRITEL           0u              /* a register of 8 bits of address, 1 to 8 bytes */
+#define OP_EXT_READL            1u
+#define TRANSFER_TIMEOUT_US     2000
+
+static vm_offset_t arb_core, arb_cnfg, arb_observer;
+static LCK_GRP_DECLARE(apollo_backlight_grp, "apollo-backlight");
+/*
+ * The brightness's state (level, lit, wanted_fraction, what the sysctls show) and the writes that change it: iOS's
+ * brightness (IOMFB's property, or the sysctl from backboardd), the display's power and the run's end come from
+ * different threads, each through write_level() under this. (apollo_spmi_bus_lock, the arbiter's, is only around one transfer.)
+ */
+static LCK_MTX_DECLARE(apollo_backlight_state_lock, &apollo_backlight_grp);
+
+struct peripheral {
+	const char *name;
+	uint16_t id;                    /* slave << 8 | peripheral */
+	uint16_t channel;
+	bool found;
+	vm_offset_t writes;             /* its page of the channel region */
+};
+static struct peripheral ctrl = { .name = "the WLED's control block", .id = 0x5d8 };    /* slave 5, registers 0xd800 */
+static struct peripheral sink = { .name = "the WLED's sink block", .id = 0x5d9 };       /* slave 5, registers 0xd900 */
+
+static const char *
+spmi_status_text(uint32_t status)
+{
+	return !(status & STATUS_DONE) ? "no answer from the arbiter" : (status & STATUS_DENIED) ? "the arbiter refuses" :
+	       (status & STATUS_FAILURE) ? "the transfer failed" : "the transfer was dropped";
+}
+
+/* `count` (1 to 4) registers from `reg` on; NULL, or what went wrong */
+static const char *
+spmi_read(const struct peripheral *p, uint8_t reg, uint8_t *bytes, uint32_t count)
+{
+	vm_offset_t channel = arb_observer + 0x10000UL * ARB_SYSTEM + 0x80UL * p->channel;
+	uint64_t start = mach_absolute_time(), interval;
+	uint32_t status, data;
+
+	nanoseconds_to_absolutetime(TRANSFER_TIMEOUT_US * (uint64_t)NSEC_PER_USEC, &interval);
+	lck_spin_lock(&apollo_spmi_bus_lock);  /* (one lock for the arbiter, shared with the battery and buttons drivers) */
+	wr(channel + CHANNEL_COMMAND, OP_EXT_READL << 27 | (uint32_t)reg << 4 | (count - 1));
+	do {
+		status = rd(channel + CHANNEL_STATUS);
+	} while (!(status & STATUS_DONE) && mach_absolute_time() - start < interval);
+	data = rd(channel + CHANNEL_RDATA0);
+	lck_spin_unlock(&apollo_spmi_bus_lock);
+	if (!(status & STATUS_DONE) || (status & (STATUS_DENIED | STATUS_FAILURE | STATUS_DROPPED))) {
+		return spmi_status_text(status);
+	}
+	for (uint32_t i = 0; i < count; i++) {
+		bytes[i] = (uint8_t)(data >> (8 * i));
+	}
+	return NULL;
+}
+
+/* `count` (1 to 4) bytes into the registers from `reg` on; NULL, or what went wrong */
+static const char *
+spmi_write(const struct peripheral *p, uint8_t reg, const uint8_t *bytes, uint32_t count)
+{
+	vm_offset_t channel = p->writes;
+	uint64_t start = mach_absolute_time(), interval;
+	uint32_t status, data = 0;
+
+	for (uint32_t i = 0; i < count; i++) {
+		data |= (uint32_t)bytes[i] << (8 * i);
+	}
+	nanoseconds_to_absolutetime(TRANSFER_TIMEOUT_US * (uint64_t)NSEC_PER_USEC, &interval);
+	lck_spin_lock(&apollo_spmi_bus_lock);  /* (one lock for the arbiter, shared with the battery and buttons drivers) */
+	wr(channel + CHANNEL_WDATA0, data);
+	wr(channel + CHANNEL_COMMAND, OP_EXT_WRITEL << 27 | (uint32_t)reg << 4 | (count - 1));
+	do {
+		status = rd(channel + CHANNEL_STATUS);
+	} while (!(status & STATUS_DONE) && mach_absolute_time() - start < interval);
+	lck_spin_unlock(&apollo_spmi_bus_lock);
+	if (!(status & STATUS_DONE) || (status & (STATUS_DENIED | STATUS_FAILURE | STATUS_DROPPED))) {
+		return spmi_status_text(status);
+	}
+	return NULL;
+}
+
+/* the peripheral's channel: the first, unless a later one is this system's (as Linux chooses) */
+static bool
+find_channel(struct peripheral *p, uint32_t channels)
+{
+	for (uint32_t n = 0; n < channels; n++) {
+		uint32_t map = rd(arb_core + ARB_CHANNEL(n));
+
+		if (map == 0 || ((map >> 8) & 0xfff) != p->id) {
+			continue;
+		}
+		if (!p->found || (rd(arb_cnfg + ARB_OWNER(n)) & 7) == ARB_SYSTEM) {
+			p->found = true;
+			p->channel = (uint16_t)n;
+		}
+	}
+	if (p->found) {
+		say("apollo backlight: %s is channel %u (owned by system %u)\n", p->name, p->channel,
+		    rd(arb_cnfg + ARB_OWNER(p->channel)) & 7);
+	} else {
+		say("apollo backlight: no channel is %s\n", p->name);
+	}
+	return p->found;
+}
+
+/* ---- the WLED (Linux's qcom-wled.c, WLED5) ---------------------------------------------------------- */
+
+#define WLED_CTRL_TYPE          0x04
+#define WLED_CTRL_SUBTYPE       0x05
+#define WLED_CTRL_MOD_EN        0x46            /* bit 7: the module on */
+#define WLED_CTRL_MOD_EN_BIT    0x80
+#define WLED5_SINK_MOD_EN(m)    ((m) ? 0x60 : 0x50)             /* bit 7 */
+#define WLED5_SINK_SRC_SEL(m)   ((m) ? 0x61 : 0x51)
+#define WLED5_SINK_WIDTH(m)     ((m) ? 0x62 : 0x52)             /* 0: 12 bits, 1: 15 bits */
+#define WLED5_SINK_BRIGHT(m)    ((m) ? 0x63 : 0x53)             /* low byte; the high byte follows */
+#define WLED5_SINK_SYNC         0x65                            /* bit 0: module A, bit 1: module B */
+#define WLED5_SINK_STR_SRC(n)   (0x73 + 0x10 * (n))             /* 0: module A, 1: module B */
+#define WLED5_LOW_LIMIT_PERMILLE 1                              /* the lower limit of a lit WLED5: 0.1% */
+
+static bool ready;                      /* the WLED was read and is as expected: brightness may be written */
+static uint32_t module;                 /* 0: A, 1: B: the module the first string takes its current from */
+static uint32_t maximum = 0xfff;        /* the brightness register's top: 12 or 15 bits */
+static uint32_t level;                  /* the brightness register's value now */
+static bool lit = true;                 /* the module is enabled */
+static uint32_t wanted_fraction = 0x8000;       /* the last brightness iOS asked for, 16.16: what a power-on gives back */
+static int raw_shown, percent_shown;    /* the sysctls */
+
+static void
+log_registers(void)
+{
+	static const uint8_t ctrl_regs[] = { 0x04, 0x05, 0x08, 0x10, 0x46, 0x48, 0x4c, 0x4d, 0x4e, 0x5f };
+	static const uint8_t sink_regs[] = { 0x46, 0x47, 0x4f, 0x50, 0x51, 0x52, 0x53, 0x54, 0x60, 0x61, 0x62, 0x63, 0x64, 0x65,
+		0x72, 0x73, 0x82, 0x83, 0x92, 0x93, 0xa2, 0xa3 };
+	char line[200];
+	int at;
+	uint8_t value;
+
+	at = snprintf(line, sizeof(line), "apollo backlight: control block:");
+	for (unsigned i = 0; i < sizeof(ctrl_regs); i++) {
+		at += snprintf(line + at, sizeof(line) - (size_t)at, " %02x=", ctrl_regs[i]);
+		if (spmi_read(&ctrl, ctrl_regs[i], &value, 1) == NULL) {
+			at += snprintf(line + at, sizeof(line) - (size_t)at, "%02x", value);
+		} else {
+			at += snprintf(line + at, sizeof(line) - (size_t)at, "??");
+		}
+	}
+	say("%s\n", line);
+	at = snprintf(line, sizeof(line), "apollo backlight: sink block:");
+	for (unsigned i = 0; i < sizeof(sink_regs); i++) {
+		at += snprintf(line + at, sizeof(line) - (size_t)at, " %02x=", sink_regs[i]);
+		if (spmi_read(&sink, sink_regs[i], &value, 1) == NULL) {
+			at += snprintf(line + at, sizeof(line) - (size_t)at, "%02x", value);
+		} else {
+			at += snprintf(line + at, sizeof(line) - (size_t)at, "??");
+		}
+	}
+	say("%s\n", line);
+}
+
+/* the brightness register as the hardware has it */
+static bool
+read_level(uint32_t *value)
+{
+	uint8_t bytes[2];
+
+	if (spmi_read(&sink, WLED5_SINK_BRIGHT(module), bytes, 2) != NULL) {
+		return false;
+	}
+	*value = (uint32_t)bytes[0] | (uint32_t)bytes[1] << 8;
+	return true;
+}
+
+static void
+publish(void)
+{
+	raw_shown = (int)level;
+	percent_shown = lit ? (int)((uint64_t)level * 100 / maximum) : 0;
+}
+
+/* Linux's wled5_set_brightness, wled5_mod_sync_toggle and wled_module_enable, in the order wled_update_status has them */
+static bool
+write_level(uint32_t brightness)
+{
+	uint8_t bytes[2], sync;
+	const char *problem;
+	uint32_t low = maximum * WLED5_LOW_LIMIT_PERMILLE / 1000;
+
+	if (brightness > maximum) {
+		brightness = maximum;
+	}
+	if (brightness != 0 && brightness < low) {
+		brightness = low;
+	}
+	if (brightness != 0) {
+		bytes[0] = (uint8_t)brightness;
+		bytes[1] = (uint8_t)(brightness >> 8);
+		if ((problem = spmi_write(&sink, WLED5_SINK_BRIGHT(module), bytes, 2)) != NULL) {
+			say("apollo backlight: the brightness is not taken: %s\n", problem);
+			return false;
+		}
+		sync = (uint8_t)(1u << module);
+		if ((problem = spmi_write(&sink, WLED5_SINK_SYNC, &sync, 1)) != NULL) {
+			say("apollo backlight: the sync is not taken: %s\n", problem);
+			return false;
+		}
+		sync = 0;
+		spmi_write(&sink, WLED5_SINK_SYNC, &sync, 1);
+		level = brightness;
+	}
+	if ((brightness != 0) != lit) {
+		uint8_t enable;
+
+		if (spmi_read(&ctrl, WLED_CTRL_MOD_EN, &enable, 1) != NULL) {
+			return false;
+		}
+		enable = (uint8_t)((enable & ~WLED_CTRL_MOD_EN_BIT) | (brightness != 0 ? WLED_CTRL_MOD_EN_BIT : 0));
+		if ((problem = spmi_write(&ctrl, WLED_CTRL_MOD_EN, &enable, 1)) != NULL) {
+			say("apollo backlight: the module's enable is not taken: %s\n", problem);
+			return false;
+		}
+		lit = brightness != 0;
+	}
+	publish();
+	return true;
+}
+
+/*
+ * iOS's brightness is 0 to 1 (16.16 fixed point) and perceived, the register's value is a current: the register is
+ * taken as the square of the brightness (a power of 2.0 for 2.2), never under 8 of 4095 so that the lowest setting
+ * still shows something.
+ */
+static uint32_t
+level_for(uint32_t fraction)
+{
+	uint64_t square;
+	uint32_t floor = maximum * 8 / 0xfff;
+
+	if (fraction > 0x10000) {
+		fraction = 0x10000;
+	}
+	square = ((uint64_t)fraction * fraction) >> 16;
+	square = square * maximum >> 16;
+	return square < floor ? floor : (uint32_t)square;
+}
+
+/* iOS asks for a brightness: 0 (dark) to 0x10000 (full), as IOMFBBrightnessLevel has it */
+void
+apollo_backlight_set(uint32_t fraction)
+{
+	if (!ready) {
+		return;
+	}
+	lck_mtx_lock(&apollo_backlight_state_lock);
+	wanted_fraction = fraction > 0x10000 ? 0x10000 : fraction;
+	if (lit) {
+		write_level(level_for(wanted_fraction));
+	}
+	lck_mtx_unlock(&apollo_backlight_state_lock);
+}
+
+/* the display is switched off (the light with it) or on again (at the brightness that was last asked for) */
+void
+apollo_backlight_power(bool on)
+{
+	lck_mtx_lock(&apollo_backlight_state_lock);
+	apollo_touch_screen(on);        /* the touch follows the screen, with or without the backlight driver */
+	apollo_cpufreq_screen(on);      /* and the cores slow down while it is off */
+	if (!ready || on == lit) {
+		lck_mtx_unlock(&apollo_backlight_state_lock);
+		return;
+	}
+	if (on) {
+		write_level(level_for(wanted_fraction));
+	} else {
+		write_level(0);
+	}
+	lck_mtx_unlock(&apollo_backlight_state_lock);
+	say("apollo backlight: the display is %s\n", on ? "on" : "off");
+}
+
+/* for the run's end: the light as the firmware had it (on, at the level it was at), whatever iOS did */
+static uint32_t level_found;
+
+void
+apollo_backlight_stop(void)
+{
+	if (ready) {
+		lck_mtx_lock(&apollo_backlight_state_lock);
+		write_level(level_found != 0 ? level_found : maximum / 2);
+		lck_mtx_unlock(&apollo_backlight_state_lock);
+	}
+}
+
+/* ---- sysctls ----------------------------------------------------------------------------------------- */
+
+SYSCTL_DECL(_kern_apollo);
+SYSCTL_INT(_kern_apollo, OID_AUTO, backlight_raw, CTLFLAG_RD | CTLFLAG_LOCKED, &raw_shown, 0,
+    "the WLED's brightness register: 0 to 4095 (or 32767)");
+
+static int
+sysctl_backlight_percent(__unused struct sysctl_oid *oid, __unused void *arg1, __unused int arg2,
+    struct sysctl_req *req)
+{
+	int value, error;
+
+	/*
+	 * The sysctl is compiled into every phone's kernel: where the Mi 10T's backlight is not driven (another phone, or
+	 * the WLED not as expected) it says so, read or written -- userland/src/inject.c's brightness_slider() takes any
+	 * error from reading it as "no backlight of ours" and installs nothing.
+	 */
+	if (!ready) {
+		return ENODEV;
+	}
+	value = percent_shown;
+	error = sysctl_handle_int(oid, &value, 0, req);
+	if (error == 0 && req->newptr != USER_ADDR_NULL) {
+		if (value < 0 || value > 100) {
+			return EINVAL;
+		}
+		apollo_backlight_set((uint32_t)value * 0x10000 / 100);
+	}
+	return error;
+}
+/* (anybody may set it: the brightness slider is backboardd's, which runs as mobile -- userland/src/inject.c) */
+SYSCTL_PROC(_kern_apollo, OID_AUTO, backlight, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_ANYBODY | CTLFLAG_LOCKED, 0, 0,
+    sysctl_backlight_percent, "I", "the backlight, 0 to 100 percent (a perceived scale)");
+
+/* ---- start ------------------------------------------------------------------------------------------- */
+
+void
+apollo_backlight_init(void)
+{
+	uint32_t percent = 0, channels;
+	uint8_t id[2], enable, source;
+	uint32_t now = 0;
+	const char *problem;
+
+	if (!PE_parse_boot_argn("apollo_backlight", &percent, sizeof(percent)) || percent == 0) {
+		return;
+	}
+	arb_core = ml_io_map(ARB_CORE_PHYS, ARB_CORE_SIZE);
+	arb_cnfg = ml_io_map(ARB_CNFG_PHYS, ARB_CNFG_SIZE);
+	arb_observer = ml_io_map(ARB_OBSERVER_PHYS, ARB_REGION_SIZE);
+	channels = rd(arb_core + ARB_FEATURES) & 0x7ff;
+	if (channels > ARB_MAX_CHANNELS) {
+		channels = ARB_MAX_CHANNELS;
+	}
+	if (!find_channel(&ctrl, channels) || !find_channel(&sink, channels)) {
+		return;
+	}
+	ctrl.writes = ml_io_map(ARB_CHANNELS_PHYS + 0x10000UL * ctrl.channel, 0x1000);
+	sink.writes = ml_io_map(ARB_CHANNELS_PHYS + 0x10000UL * sink.channel, 0x1000);
+	if ((problem = spmi_read(&ctrl, WLED_CTRL_TYPE, id, 2)) != NULL) {
+		say("apollo backlight: cannot read the WLED: %s\n", problem);
+		return;
+	}
+	say("apollo backlight: the WLED's control block is type %#x, subtype %#x\n", id[0], id[1]);
+	log_registers();
+
+	/* the module the first string takes its current from, and how wide its brightness is */
+	if (spmi_read(&sink, WLED5_SINK_STR_SRC(0), &source, 1) != NULL) {
+		return;
+	}
+	module = (source & 1) ? 1 : 0;
+	if (spmi_read(&sink, WLED5_SINK_WIDTH(module), &source, 1) != NULL) {
+		return;
+	}
+	maximum = (source & 1) ? 0x7fff : 0xfff;
+	if (!read_level(&level) || spmi_read(&ctrl, WLED_CTRL_MOD_EN, &enable, 1) != NULL) {
+		return;
+	}
+	lit = (enable & WLED_CTRL_MOD_EN_BIT) != 0;
+	level_found = level;
+	publish();
+	say("apollo backlight: module %c, %u bits: the firmware left it %s at %u of %u (%u%%)\n", 'A' + module,
+	    maximum == 0x7fff ? 15 : 12, lit ? "on" : "OFF", level, maximum, (uint32_t)((uint64_t)level * 100 / maximum));
+	if (!lit) {
+		say("apollo backlight: the WLED is off: left alone\n");
+		return;
+	}
+	ready = true;
+	/* P percent of perceived brightness */
+	apollo_backlight_set((percent > 100 ? 100 : percent) * 0x10000 / 100);
+	say("apollo backlight: set to %u%%: the register reads %u now (wrote %u)\n", percent > 100 ? 100 : percent,
+	    read_level(&now) ? now : 0, level);
+}
diff --git a/bsd/dev/hakios.apollo_battery.c b/bsd/dev/hakios.apollo_battery.c
new file mode 100644
index 000000000000..ef1e8e8644ab
--- /dev/null
+++ b/bsd/dev/hakios.apollo_battery.c
@@ -0,0 +1,1203 @@
+/*
+ * The battery of the Xiaomi Mi 10T (apollo), with boot-arg apollo_battery=1 (bsd/dev/hakios.apollo_input.c).
+ *
+ * By default (apollo_battery_source=spmi) the battery is read from the PMIC itself, every five seconds, through the
+ * SPMI arbiter's observer channels -- reads only. The PM8150B (SPMI slave 2) has the fuel gauge of the fourth kind
+ * (Linux's qpnp-fg-gen4, not the QG of the smaller PMICs: arch/arm64/boot/dts/venor/qcom/pm8150b.dtsi has
+ * "qcom,fg-gen4" with BATT_SOC at 0x4000, BATT_INFO at 0x4100, RRADC at 0x4200, MEM_IF at 0x4300), which runs its
+ * own algorithm (coulomb counting blended with the OCV of the battery profile the UEFI loaded into it) inside the PMIC;
+ * its monotonic SOC, the battery's voltage and current are plain registers (gauge_read()). The charger's own state
+ * (charging, terminated, a cable in) comes from the PM8150B's charger (qpnp-smb5), the temperature from the gauge's
+ * thermistor ADC (temperature_choose()). Nothing of the firmware is asked, and the loader need not poll.
+ *
+ * With apollo_battery_source=loader, the older way: the phone's own UEFI talks to the gauge, with Xiaomi's Qualcomm
+ * charger drivers (ChargerExDxe and QcomChargerDxeLA, in uefi/files/Binaries/apollo). The loader, which stays on the
+ * first core, asks them every few seconds and keeps the answer on a page of its own (xnuloader/loader.c,
+ * charger_poll(): read only, no charging action taken) whose address it gives as battery_shared_pa, and that page is
+ * read here every five seconds. That has the UEFI's charger driver and this kernel's SPMI users drive the one arbiter
+ * from two systems at once, which is suspected of wedging it (and the loader's core with it).
+ *
+ * Either way the result goes to the power source iOS reads (iokit/Kernel/hakios.battery.cpp, HakiosBatteryReport(),
+ * shared), and to the sysctls kern.apollo.battery_*.
+ *
+ * Boot-arg apollo_charger=N (the PM8150B's charger itself, SPMI slave 2: peripherals 0x10 to 0x16, through the arbiter
+ * as hakios.apollo_backlight.c reaches it; a write only goes through a channel that system 0 owns): 1 logs its registers
+ * (charge state, limits, power path, APSD, USBIN) once a minute and when the loader's charger_present changes; 2 also,
+ * every five seconds while a cable is in, pets its watchdog (whose bite disables charging) and clears a USBIN suspend,
+ * a disabled charge enable and a charge pause; 3 also sets the input and charge currents (chg_currents()). None of
+ * that is written unless the loader's page is fresh (its `polls` advanced within CHG_FRESH_SECONDS) and the battery's
+ * temperature it gives is a real one: a loader that has stopped polling, or a gauge that gives no temperature, leaves
+ * the charger to its own watchdog, whose bite stops the charging. From the PMIC itself (the default), "fresh" is that
+ * a read of the gauge succeeded within CHG_FRESH_SECONDS, and the temperature is this tick's own, read and believed.
+ */
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include <sys/hakios.apollo_input.h>
+#include <sys/hakios.input.h>          /* struct hakios_battery_state: the power source's report, shared */
+#include <sys/sysctl.h>
+#include <sys/systm.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+/* into the loader's log as well (as the other apollo drivers): the level's changes are to be seen during a run */
+extern void loader_log_putc(char c);
+
+static int say(const char *format, ...) __printflike(1, 2);
+
+static int
+say(const char *format, ...)
+{
+	char line[300];
+	va_list list;
+
+	va_start(list, format);
+	vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
+	for (const char *c = line; *c != 0; c++) {
+		loader_log_putc(*c);
+	}
+	return printf("%s", line);
+}
+extern void HakiosBatteryReport(const void *state, unsigned size);     /* iokit/Kernel/hakios.battery.cpp */
+
+/* the loader's page (xnuloader/loader.c: struct loader_battery) */
+#define LOADER_BATTERY_MAGIC            0x2154544142574452ULL           /* "RDWBATT!" */
+#define LOADER_BATTERY_VERSION          1
+#define LOADER_BATTERY_VALID            (1u << 0)
+#define LOADER_BATTERY_PRESENT          (1u << 1)
+#define LOADER_BATTERY_CHARGER_PRESENT  (1u << 2)
+#define LOADER_BATTERY_VOLTAGE_VALID    (1u << 3)
+#define LOADER_BATTERY_CHARGING         (1u << 4)
+#define LOADER_BATTERY_SOC_ESTIMATED    (1u << 5)
+#define LOADER_PAGE_SIZE                0x4000UL
+
+struct loader_battery {
+	uint64_t magic;
+	uint32_t version, size;
+	volatile uint32_t sequence;     /* odd while the loader writes */
+	uint32_t flags;
+	int32_t soc_percent, voltage_mv, current_ma, temperature_c;
+	uint32_t charger_action, polls, failures, reserved;
+};
+
+static volatile struct loader_battery *shared;
+
+static int apollo_battery_soc = -1, apollo_battery_voltage_mv = -1, apollo_battery_current_ma;
+static int apollo_battery_temperature_c = -273, apollo_battery_present, apollo_battery_charger;
+static int apollo_battery_charging, apollo_battery_estimated, apollo_battery_from_pmic;
+
+SYSCTL_NODE(_kern, OID_AUTO, apollo, CTLFLAG_RW | CTLFLAG_LOCKED, 0, "the Mi 10T's own drivers");
+SYSCTL_INT(_kern_apollo, OID_AUTO, battery_soc, CTLFLAG_RD | CTLFLAG_LOCKED, &apollo_battery_soc, 0,
+    "battery charge, 0..100 percent, or -1 if unknown");
+SYSCTL_INT(_kern_apollo, OID_AUTO, battery_voltage_mv, CTLFLAG_RD | CTLFLAG_LOCKED, &apollo_battery_voltage_mv, 0,
+    "battery voltage in millivolts, or -1 if unknown");
+SYSCTL_INT(_kern_apollo, OID_AUTO, battery_current_ma, CTLFLAG_RD | CTLFLAG_LOCKED, &apollo_battery_current_ma, 0,
+    "battery current in milliamps: the gauge's (more than 0 while discharging), or as the UEFI's charger driver gives it");
+SYSCTL_INT(_kern_apollo, OID_AUTO, battery_temperature_c, CTLFLAG_RD | CTLFLAG_LOCKED, &apollo_battery_temperature_c, 0,
+    "battery temperature in degrees Celsius, or -273 if unknown");
+SYSCTL_INT(_kern_apollo, OID_AUTO, battery_present, CTLFLAG_RD | CTLFLAG_LOCKED, &apollo_battery_present, 0,
+    "1 if the charger driver sees a battery");
+SYSCTL_INT(_kern_apollo, OID_AUTO, battery_charger_present, CTLFLAG_RD | CTLFLAG_LOCKED, &apollo_battery_charger, 0,
+    "1 if something is plugged into the USB port");
+SYSCTL_INT(_kern_apollo, OID_AUTO, battery_charging, CTLFLAG_RD | CTLFLAG_LOCKED, &apollo_battery_charging, 0,
+    "1 while the battery is charging");
+SYSCTL_INT(_kern_apollo, OID_AUTO, battery_soc_estimated, CTLFLAG_RD | CTLFLAG_LOCKED, &apollo_battery_estimated, 0,
+    "1 when the charge is estimated from the voltage (the fuel gauge has not answered)");
+SYSCTL_INT(_kern_apollo, OID_AUTO, battery_from_pmic, CTLFLAG_RD | CTLFLAG_LOCKED, &apollo_battery_from_pmic, 0,
+    "1 when the battery is read from the PMIC over SPMI, 0 when from the loader's page");
+
+/* a consistent copy of the page: the loader makes the sequence odd while it writes */
+static bool
+snapshot(struct loader_battery *out)
+{
+	for (int i = 0; i < 8; i++) {
+		uint32_t before = shared->sequence, after;
+
+		if (before & 1) {
+			delay_for_interval(1, NSEC_PER_MSEC);
+			continue;
+		}
+		__asm__ volatile ("dmb ish" ::: "memory");
+		memcpy(out, (const void *)(uintptr_t)shared, sizeof(*out));
+		__asm__ volatile ("dmb ish" ::: "memory");
+		after = shared->sequence;
+		if (before == after) {
+			return true;
+		}
+	}
+	return false;
+}
+
+static int32_t
+clamp32(int64_t value)
+{
+	return value > 0x7fffffffLL ? 0x7fffffff : value < -0x80000000LL ? (int32_t)(-0x7fffffff - 1) : (int32_t)value;
+}
+
+/* ---- the PM8150B's charger (Linux's qcom-smb5; boot-arg apollo_charger=N) -------------------------------- */
+
+#define CHG_FRESH_SECONDS       15ULL           /* three of the loader's polls, or of this driver's own reads */
+
+/*
+ * The charger is SPMI slave 2 (the PM8150B): peripherals 0x10 CHGR, 0x11 DCDC, 0x13 USBIN, 0x14 DCIN, 0x15 TYPEC and
+ * 0x16 MISC, registers as drivers/power/supply/qcom_smbx.c / Xiaomi's smb5-lib have them. The arbiter and the way
+ * of reading and writing it are those of hakios.apollo_backlight.c (version 5: reads through the observer at 0xe600000 +
+ * 0x80 per channel, writes through the channel region at 0xc600000 + 0x10000 per channel), copied here.
+ * apollo_charger=1 reads and logs the registers; =2 also does the minimal repairs of chg_fix(); =3 also sets the input
+ * and charge currents from what the source says it can give (chg_currents()).
+ */
+#define ARB_CORE_PHYS           0x0c440000UL
+#define ARB_CORE_SIZE           0x1100UL
+#define ARB_CNFG_PHYS           0x0c40a000UL
+#define ARB_CNFG_SIZE           0x1000UL
+#define ARB_CHANNELS_PHYS       0x0c600000UL    /* the device tree's "chnls": 0x10000 per channel (v5) */
+#define ARB_OBSERVER_PHYS       0x0e600000UL    /* reads only: 0x10000 per system, 0x80 per channel */
+#define ARB_REGION_SIZE         0x10000UL
+#define ARB_SYSTEM              0
+#define ARB_FEATURES            0x004           /* [10:0] channels */
+#define ARB_CHANNEL(n)          (0x900 + 4 * (n))       /* [19:8] slave << 8 | peripheral */
+#define ARB_OWNER(n)            (0x700 + 4 * (n))       /* [2:0] the system that owns channel n */
+#define ARB_MAX_CHANNELS        512
+
+#define CHANNEL_COMMAND         0x00
+#define CHANNEL_STATUS          0x08
+#define CHANNEL_RDATA0          0x18
+#define CHANNEL_WDATA0          0x10
+#define STATUS_DONE             0x1
+#define STATUS_FAILURE          0x2
+#define STATUS_DENIED           0x4
+#define STATUS_DROPPED          0x8
+#define OP_EXT_WRITEL           0u
+#define OP_EXT_READL            1u
+#define TRANSFER_TIMEOUT_US     2000
+
+static inline uint32_t
+rd(vm_offset_t address)
+{
+	return *(volatile uint32_t *)address;
+}
+
+static inline void
+wr(vm_offset_t address, uint32_t value)
+{
+	*(volatile uint32_t *)address = value;
+}
+
+static vm_offset_t arb_core, arb_cnfg, arb_observer;
+
+/*
+ * One SPMI transfer at a time through the arbiter, for every apollo driver (Linux's spmi-pmic-arb.c holds one lock,
+ * pmic_arb->lock, around every transfer of the bus, whatever the channel). Declared here, extern in
+ * sys/hakios.apollo_input.h: hakios.apollo_buttons.c and hakios.apollo_backlight.c each still have a lock of their own
+ * and are to take this one instead. A spin lock: a transfer is polled for at most TRANSFER_TIMEOUT_US.
+ */
+static LCK_GRP_DECLARE(apollo_spmi_bus_grp, "apollo-spmi-bus");
+LCK_SPIN_DECLARE(apollo_spmi_bus_lock, &apollo_spmi_bus_grp);
+
+struct chg_peripheral {
+	const char *name;
+	uint16_t id;                    /* slave << 8 | peripheral */
+	uint16_t channel;
+	bool found;
+	bool writable;                  /* the channel is owned by system 0 (this one) */
+	bool gauge;                     /* the fuel gauge's: never written here, whoever owns it */
+	bool refused_said;
+	vm_offset_t writes;             /* its page of the channel region */
+};
+static struct chg_peripheral chg_periph[] = {
+	{ .name = "CHGR", .id = 0x210 }, { .name = "DCDC", .id = 0x211 }, { .name = "USBIN", .id = 0x213 },
+	{ .name = "DCIN", .id = 0x214 }, { .name = "TYPEC", .id = 0x215 }, { .name = "MISC", .id = 0x216 },
+	/* the fuel gauge (qpnp-fg-gen4: pm8150b.dtsi's qcom,fg-batt-soc@4000, -batt-info@4100, -rradc@4200) */
+	{ .name = "FG_BATT_SOC", .id = 0x240, .gauge = true }, { .name = "FG_BATT_INFO", .id = 0x241, .gauge = true },
+	{ .name = "FG_RRADC", .id = 0x242, .gauge = true },
+};
+#define CHG_PERIPHERALS (sizeof(chg_periph) / sizeof(chg_periph[0]))
+
+static uint32_t chg_level;              /* apollo_charger: 0 nothing, 1 read, 2 read and repair */
+static bool chg_ready;
+static uint32_t chg_writes, chg_write_failures;
+static struct {
+	uint64_t reads, failed;
+} bus;
+
+static const char *
+chg_status_text(uint32_t status)
+{
+	return !(status & STATUS_DONE) ? "no answer from the arbiter" : (status & STATUS_DENIED) ? "the arbiter refuses" :
+	       (status & STATUS_FAILURE) ? "the transfer failed" : "the transfer was dropped";
+}
+
+static struct chg_peripheral *
+chg_for(uint16_t address)
+{
+	for (unsigned i = 0; i < CHG_PERIPHERALS; i++) {
+		if ((chg_periph[i].id & 0xff) == (address >> 8)) {
+			return &chg_periph[i];
+		}
+	}
+	return NULL;
+}
+
+/*
+ * `count` (1 to 4) bytes from `address` on (peripheral << 8 | offset, slave 2), through this system's observer channel
+ * of the peripheral: a read only, whoever owns the channel. NULL, or what went wrong.
+ */
+static const char *
+spmi_read(uint16_t address, uint8_t *bytes, uint32_t count)
+{
+	struct chg_peripheral *p = chg_for(address);
+	vm_offset_t channel;
+	uint64_t start, interval;
+	uint32_t status, data;
+
+	if (p == NULL || !p->found) {
+		return "no channel";
+	}
+	if (count < 1 || count > 4 || (address & 0xff) + count > 0x100) {
+		return "a read the arbiter cannot do";
+	}
+	channel = arb_observer + 0x10000UL * ARB_SYSTEM + 0x80UL * p->channel;
+	nanoseconds_to_absolutetime(TRANSFER_TIMEOUT_US * (uint64_t)NSEC_PER_USEC, &interval);
+	lck_spin_lock(&apollo_spmi_bus_lock);
+	start = mach_absolute_time();
+	wr(channel + CHANNEL_COMMAND, OP_EXT_READL << 27 | (uint32_t)(address & 0xff) << 4 | (count - 1));
+	do {
+		status = rd(channel + CHANNEL_STATUS);
+	} while (!(status & STATUS_DONE) && mach_absolute_time() - start < interval);
+	data = rd(channel + CHANNEL_RDATA0);
+	lck_spin_unlock(&apollo_spmi_bus_lock);
+	bus.reads++;
+	if (!(status & STATUS_DONE) || (status & (STATUS_DENIED | STATUS_FAILURE | STATUS_DROPPED))) {
+		bus.failed++;
+		return chg_status_text(status);
+	}
+	for (uint32_t i = 0; i < count; i++) {
+		bytes[i] = (uint8_t)(data >> (8 * i));
+	}
+	return NULL;
+}
+
+/* one byte at `address`; NULL, or what went wrong */
+static const char *
+chg_read(uint16_t address, uint8_t *value)
+{
+	return spmi_read(address, value, 1);
+}
+
+/* one byte into `address`: only through a channel that system 0 owns; NULL, or what went wrong */
+static const char *
+chg_write(uint16_t address, uint8_t value)
+{
+	struct chg_peripheral *p = chg_for(address);
+	vm_offset_t channel;
+	uint64_t start, interval;
+	uint32_t status;
+
+	if (p != NULL && p->gauge) {
+		chg_write_failures++;
+		return "the gauge is only read";
+	}
+	if (p == NULL || !p->found || !p->writable) {
+		if (p != NULL && !p->refused_said) {
+			p->refused_said = true;
+			say("apollo charger: not writing %s (%04x): its channel is not owned by system 0\n", p->name, address);
+		}
+		chg_write_failures++;
+		return "channel not ours";
+	}
+	channel = p->writes;
+	nanoseconds_to_absolutetime(TRANSFER_TIMEOUT_US * (uint64_t)NSEC_PER_USEC, &interval);
+	lck_spin_lock(&apollo_spmi_bus_lock);
+	start = mach_absolute_time();
+	wr(channel + CHANNEL_WDATA0, value);
+	wr(channel + CHANNEL_COMMAND, OP_EXT_WRITEL << 27 | (uint32_t)(address & 0xff) << 4 | 0);
+	do {
+		status = rd(channel + CHANNEL_STATUS);
+	} while (!(status & STATUS_DONE) && mach_absolute_time() - start < interval);
+	lck_spin_unlock(&apollo_spmi_bus_lock);
+	chg_writes++;
+	if (!(status & STATUS_DONE) || (status & (STATUS_DENIED | STATUS_FAILURE | STATUS_DROPPED))) {
+		chg_write_failures++;
+		return chg_status_text(status);
+	}
+	return NULL;
+}
+
+/* the peripheral's channel: the first, unless a later one is this system's (as Linux chooses) */
+static bool
+chg_find_channel(struct chg_peripheral *p, uint32_t channels)
+{
+	uint32_t owner;
+
+	for (uint32_t n = 0; n < channels; n++) {
+		uint32_t map = rd(arb_core + ARB_CHANNEL(n));
+
+		if (map == 0 || ((map >> 8) & 0xfff) != p->id) {
+			continue;
+		}
+		if (!p->found || (rd(arb_cnfg + ARB_OWNER(n)) & 7) == ARB_SYSTEM) {
+			p->found = true;
+			p->channel = (uint16_t)n;
+		}
+	}
+	if (!p->found) {
+		say("apollo battery: no channel is %s (slave 2, peripheral %#x)\n", p->name, p->id & 0xff);
+		return false;
+	}
+	owner = rd(arb_cnfg + ARB_OWNER(p->channel)) & 7;
+	p->writable = owner == ARB_SYSTEM && !p->gauge;
+	say("apollo battery: %s is channel %u (owned by system %u%s)\n", p->name, p->channel, owner,
+	    p->gauge ? ": only read" : p->writable ? "" : ": read only");
+	if (p->writable) {
+		p->writes = ml_io_map(ARB_CHANNELS_PHYS + 0x10000UL * p->channel, 0x1000);
+	}
+	return true;
+}
+
+/* the registers logged, each as peripheral << 8 | offset */
+static const uint16_t chg_regs[] = {
+	0x1006, 0x1007, 0x100b, 0x100d, 0x1042, 0x1043, 0x1061, 0x1070,
+	0x1106, 0x1107, 0x1108, 0x110a, 0x110b,
+	0x1307, 0x1308, 0x1309, 0x1310, 0x1340, 0x1342, 0x1362, 0x1365, 0x1366, 0x1370, 0x1380,
+	0x1410, 0x1440, 0x1506, 0x1509, 0x150b, 0x1606, 0x1651, 0x1653,
+};
+#define CHG_REG_COUNT (sizeof(chg_regs) / sizeof(chg_regs[0]))
+
+static void
+chg_log(void)
+{
+	static const char *const states[8] = { "inhibit", "trickle", "pre", "fullon", "taper", "term", "pause", "disabled" };
+	static const char *const apsd[7] = { "SDP", "OCP", "CDP", "DCP", "FLOAT", "QC2", "QC3" };
+	uint8_t v[CHG_REG_COUNT];
+	bool ok[CHG_REG_COUNT];
+	const char *problem = NULL, *first_problem = NULL;
+	char line[200], names[48];
+	int at;
+
+	for (unsigned i = 0; i < CHG_REG_COUNT; i++) {
+		ok[i] = (problem = chg_read(chg_regs[i], &v[i])) == NULL;
+		if (!ok[i] && first_problem == NULL) {
+			first_problem = problem;
+		}
+	}
+	for (unsigned i = 0; i < CHG_REG_COUNT; i += 8) {
+		at = snprintf(line, sizeof(line), "apollo charger:");
+		for (unsigned j = i; j < i + 8 && j < CHG_REG_COUNT; j++) {
+			if (ok[j]) {
+				at += snprintf(line + at, sizeof(line) - (size_t)at, " %04x=%02x", chg_regs[j], v[j]);
+			} else {
+				at += snprintf(line + at, sizeof(line) - (size_t)at, " %04x=??", chg_regs[j]);
+			}
+		}
+		say("%s\n", line);
+	}
+	if (first_problem != NULL) {
+		say("apollo charger: a read failed: %s\n", first_problem);
+	}
+	/* indexes into chg_regs: 0 1006, 6 1061, 7 1070, 10 1108, 12 110b, 14 1308, 16 1310, 22 1370 */
+	at = snprintf(line, sizeof(line), "apollo charger: state %s",
+	    ok[0] ? states[v[0] & 7] : "??");
+	if (ok[6]) {
+		at += snprintf(line + at, sizeof(line) - (size_t)at, ", FCC %u mA", v[6] * 50u);
+	}
+	if (ok[7]) {
+		at += snprintf(line + at, sizeof(line) - (size_t)at, ", FV %u mV", 3600u + v[7] * 10u);
+	}
+	if (ok[10]) {
+		at += snprintf(line + at, sizeof(line) - (size_t)at, ", ICL %u mA", v[10] * 50u);
+	}
+	if (ok[22]) {
+		at += snprintf(line + at, sizeof(line) - (size_t)at, ", USB ICL cfg %u mA", v[22] * 50u);
+	}
+	if (ok[12]) {
+		at += snprintf(line + at, sizeof(line) - (size_t)at, ", path: usbin %s%s%s", (v[12] & 0x40) ? "SUSPENDED" : "active",
+		    (v[12] & 0x10) ? " used" : "", (v[12] & 1) ? " valid" : " not valid");
+	}
+	if (ok[16]) {
+		at += snprintf(line + at, sizeof(line) - (size_t)at, ", plugin %d", (v[16] >> 4) & 1);
+	}
+	if (ok[14]) {
+		names[0] = 0;
+		for (unsigned b = 0, n = 0; b < 7; b++) {
+			if (v[14] & (1u << b)) {
+				n += (unsigned)snprintf(names + n, sizeof(names) - n, "%s%s", n ? "+" : "", apsd[b]);
+			}
+		}
+		at += snprintf(line + at, sizeof(line) - (size_t)at, ", APSD %s", names[0] ? names : "none");
+	}
+	snprintf(line + at, sizeof(line) - (size_t)at, ", writes %u (%u failed)", chg_writes, chg_write_failures);
+	say("%s\n", line);
+}
+
+/*
+ * apollo_charger=3: the currents. The phone's UEFI leaves the USB input at 500 mA (USBIN_CURRENT_LIMIT_CFG 0x1370 = 0x0a)
+ * and the battery at 1.5 A (CHGR_FAST_CHARGE_CURRENT_CFG 0x1061 = 0x1e), whatever is plugged in, and nothing here runs
+ * Xiaomi's charger driver, which would raise them. The input limit is set from what the source says (Xiaomi's
+ * smb5-lib.c: smblib_get_prop_ufp_mode() reads TYPE_C_SNK_STATUS 0x1506 -- bit 1 Rp 3.0 A, bit 2 Rp 1.5 A, bit 3 default
+ * USB; APSD_RESULT_STATUS 0x1308 bit 2 CDP, bit 3 DCP), at most the device tree's qcom,usb-icl-ua (3 A); the charger is in
+ * the mode where that register is the limit after APSD already (smblib_icl_override(SW_OVERRIDE_HC_MODE): ICL_OPTIONS
+ * 0x1366 bit 0 set, CMD_ICL_OVERRIDE 0x1342 bit 0 clear, USBIN_LOAD_CFG 0x1365 bit 4 set -- as found), and the
+ * hardware's AICL (USBIN_AICL_OPTIONS 0x1380 bit 2, on) still backs off on a source that sags. The battery's current
+ * goes to 2 A: Xiaomi's own limit for a battery it has not authenticated (mi,fcc-batt-unverify-ua), which is what it is
+ * here. Both go back down when the battery is warm: at 45 degrees 1 A in and 1 A to the battery, at 50 the UEFI's 500 mA.
+ * The float voltage stays as the UEFI set it (4.40 V; the tree allows 4.48).
+ */
+#define CHG_ICL_STEP_MA         50              /* USBIN_CURRENT_LIMIT_CFG and CHGR_FAST_CHARGE_CURRENT_CFG: 50 mA a step */
+#define CHG_ICL_MAX_MA          3000            /* qcom,usb-icl-ua */
+#define CHG_FCC_MA              2000            /* mi,fcc-batt-unverify-ua */
+
+/*
+ * What the charger may be told depends on the battery's temperature, JEITA-like (the cell's own limits are not known
+ * here; these are the usual ones for a phone's Li-ion cell): under 0 degrees no charging should happen at all, so
+ * chg_fix() does not re-enable it and chg_currents() puts both currents at the floor (500 mA); 0..9 degrees the
+ * battery's current is held to 1 A (a cool cell takes less); 10..44 the full currents; from 45 the reduced ones below,
+ * and above 45 chg_fix() no longer re-enables charging or pets the watchdog either -- the charger's own protection
+ * decides. A temperature outside CHG_TEMP_SANE_* (the loader's -273 "unknown", or garbage) is no temperature: then
+ * the currents go to the floor and chg_fix() does nothing.
+ */
+#define CHG_TEMP_SANE_MIN       (-40)
+#define CHG_TEMP_SANE_MAX       100
+#define CHG_TEMP_COLD           0               /* below: no charging */
+#define CHG_TEMP_COOL           10              /* below: the battery's current at most 1 A */
+#define CHG_TEMP_WARM           45              /* from: reduced currents; above: no repairs */
+#define CHG_FLOOR_MA            500
+
+static void
+chg_currents(bool temperature_valid, int temperature_c)
+{
+	static uint32_t told_icl = ~0u, told_fcc = ~0u;
+	uint8_t snk = 0, apsd = 0, raw = 0;
+	uint32_t icl, fcc = CHG_FCC_MA;
+	const char *why;
+
+	if (chg_read(0x1506, &snk) != NULL || chg_read(0x1308, &apsd) != NULL) {
+		return;
+	}
+	if (snk & 0x02) {
+		icl = 3000, why = "USB-C Rp 3.0 A";
+	} else if (snk & 0x04) {
+		icl = 1500, why = "USB-C Rp 1.5 A";
+	} else if (apsd & 0x08) {
+		icl = 1500, why = "a dedicated charger (BC 1.2 DCP)";
+	} else if (apsd & 0x04) {
+		icl = 1500, why = "a charging downstream port (CDP)";
+	} else {
+		icl = 500, why = "a plain USB port";
+	}
+	if (!temperature_valid) {
+		icl = CHG_FLOOR_MA, fcc = CHG_FLOOR_MA, why = "THE BATTERY'S TEMPERATURE IS NOT KNOWN";
+	} else if (temperature_c < CHG_TEMP_COLD) {
+		icl = CHG_FLOOR_MA, fcc = CHG_FLOOR_MA, why = "THE BATTERY IS BELOW 0 DEGREES";
+	} else if (temperature_c >= 50) {
+		icl = 500, fcc = 1000, why = "THE BATTERY IS AT 50 DEGREES OR MORE";
+	} else if (temperature_c >= CHG_TEMP_WARM) {
+		icl = icl > 1000 ? 1000 : icl, fcc = 1000, why = "the battery is at 45 degrees or more";
+	} else if (temperature_c < CHG_TEMP_COOL) {
+		fcc = 1000, why = "the battery is below 10 degrees";
+	}
+	icl = icl > CHG_ICL_MAX_MA ? CHG_ICL_MAX_MA : icl;
+	if (chg_read(0x1370, &raw) == NULL && raw != icl / CHG_ICL_STEP_MA) {
+		if (chg_write(0x1370, (uint8_t)(icl / CHG_ICL_STEP_MA)) == NULL && told_icl != icl) {
+			say("apollo charger: the input limit %u -> %u mA (%s)\n", raw * CHG_ICL_STEP_MA, icl, why);
+			told_icl = icl;
+		}
+	}
+	if (chg_read(0x1061, &raw) == NULL && raw != fcc / CHG_ICL_STEP_MA) {
+		if (chg_write(0x1061, (uint8_t)(fcc / CHG_ICL_STEP_MA)) == NULL && told_fcc != fcc) {
+			say("apollo charger: the battery's current %u -> %u mA (battery at %d degrees%s)\n", raw * CHG_ICL_STEP_MA, fcc,
+			    temperature_c, temperature_valid ? "" : ", not a real temperature");
+			told_fcc = fcc;
+		}
+	}
+}
+
+/* apollo_charger=2: the minimal repairs, while a cable is in */
+static void
+chg_fix(void)
+{
+	static bool suspend_said, enable_said, pause_said;
+	uint8_t v;
+	const char *problem;
+
+	if (chg_read(0x1310, &v) != NULL || !(v & 0x10)) {
+		return;
+	}
+	/* BARK_BITE_WDOG_PET: nothing here services the bark, and the bite disables charging */
+	if ((problem = chg_write(0x1643, 0x01)) != NULL && strcmp(problem, "channel not ours") != 0) {
+		say("apollo charger: the watchdog pet failed: %s\n", problem);
+	}
+	if (chg_read(0x1340, &v) == NULL) {
+		if (v & 1) {
+			if (!suspend_said) {
+				say("apollo charger: USBIN is suspended (%02x): clearing it\n", v);
+				suspend_said = true;
+			}
+			chg_write(0x1340, (uint8_t)(v & ~1));
+		} else {
+			suspend_said = false;
+		}
+	}
+	if (chg_read(0x1042, &v) == NULL) {
+		if (!(v & 1)) {
+			if (!enable_said) {
+				say("apollo charger: charging is not enabled (%02x): enabling it\n", v);
+				enable_said = true;
+			}
+			chg_write(0x1042, (uint8_t)(v | 1));
+		} else {
+			enable_said = false;
+		}
+	}
+	if (chg_read(0x1043, &v) == NULL) {
+		if (v & 1) {
+			if (!pause_said) {
+				say("apollo charger: charging is paused (%02x): resuming it\n", v);
+				pause_said = true;
+			}
+			chg_write(0x1043, (uint8_t)(v & ~1));
+		} else {
+			pause_said = false;
+		}
+	}
+}
+/* the arbiter mapped and every peripheral's channel found: for the gauge's reads and for apollo_charger=N */
+static bool
+spmi_init(void)
+{
+	uint32_t channels;
+
+	arb_core = ml_io_map(ARB_CORE_PHYS, ARB_CORE_SIZE);
+	arb_cnfg = ml_io_map(ARB_CNFG_PHYS, ARB_CNFG_SIZE);
+	arb_observer = ml_io_map(ARB_OBSERVER_PHYS, ARB_REGION_SIZE);
+	if (arb_core == 0 || arb_cnfg == 0 || arb_observer == 0) {
+		say("apollo battery: cannot map the SPMI arbiter\n");
+		return false;
+	}
+	channels = rd(arb_core + ARB_FEATURES) & 0x7ff;
+	if (channels > ARB_MAX_CHANNELS) {
+		channels = ARB_MAX_CHANNELS;
+	}
+	for (unsigned i = 0; i < CHG_PERIPHERALS; i++) {
+		chg_find_channel(&chg_periph[i], channels);
+	}
+	return true;
+}
+
+static void
+chg_init(void)
+{
+	chg_ready = true;
+	say("apollo charger: level %u (%s)\n", chg_level, chg_level >= 3 ? "reads, repairs, and the currents from the source" : chg_level >= 2 ? "reads, and the minimal repairs" : "reads only");
+}
+
+/* apollo_charger=N, once a tick of either source: `fresh` and the temperature as that source has them */
+static void
+chg_tick(unsigned tick, bool fresh, bool temperature_valid, int temperature_c, int charger)
+{
+	static int last_charger = -1;
+
+	if (!chg_ready) {
+		return;
+	}
+	if (tick % 12 == 0 || charger != last_charger) {
+		chg_log();
+	}
+	last_charger = charger;
+	/* stale: nothing written at all, and the watchdog left to bite */
+	if (chg_level >= 2 && fresh && temperature_valid && temperature_c >= CHG_TEMP_COLD &&
+	    temperature_c <= CHG_TEMP_WARM) {
+		chg_fix();
+	}
+	if (chg_level >= 3 && fresh && charger) {
+		chg_currents(temperature_valid, temperature_c);
+	}
+}
+
+/* ---- the PM8150B's fuel gauge, read over SPMI (apollo_battery_source=spmi, the default) ---------------------- */
+
+/*
+ * Registers of Xiaomi's kernel (kernel-apollo: drivers/power/supply/qcom/fg-reg.h, read as fg-util.c reads them),
+ * each as peripheral << 8 | offset of slave 2:
+ *   BATT_SOC_FG_MONOTONIC_SOC 0x4009 and its copy 0x400a: the gauge's own state of charge, 0..255 (fg_get_msoc_raw():
+ *     believed when the two agree), as Android shows it after fg_get_msoc()'s scaling, msoc_percent() here;
+ *   BATT_SOC_EN_CTL 0x4046 bit 7: the gauge's algorithm runs; BATT_SOC_INT_RT_STS 0x4010 bit 1: "soc-ready";
+ *   BATT_INFO_VBATT 0x41a0..a1, IBATT 0x41a2..a3 and their copies 0x41a6..a9 (fg_get_battery_voltage() and
+ *     _current(): 122.07 uV a step; 488.281 uA a step, signed, more than 0 while the battery discharges);
+ *   ADC_RR_INT_RT_STS 0x4210 bit 0: the battery is missing (the gauge's own test);
+ *   ADC_RR_BATT_TEMP 0x4288..89: the thermistor's reading, 10 bits; BATT_INFO_BATT_TEMP 0x4150..51, 11 bits, and
+ *     BATT_INFO_BATT_TEMP_STS 0x4106 (bit 0 "available"). Xiaomi's gen4 driver reads neither for the temperature
+ *     (it takes the gauge's memory, BATT_TEMP_WORD, through MEM_IF -- writes, which are not done here): the formats are
+ *     whole degrees for the first (signed, 10 bits: seen on the phone, 0x21 = 33 C where Android said 35.5 C), and gen3's
+ *     (quarter kelvin, 11 bits: fg_get_battery_temp() of qpnp-fg-gen3) for the second, which reads 0 here; see
+ *     temperature_choose() for how they are trusted.
+ * And of the charger (smb5-reg.h): BATTERY_CHARGER_STATUS_1 0x1006 [2:0] its state, BATTERY_CHARGER_STATUS_7 0x100d
+ * its own comparators on the battery's thermistor (JEITA: bit 5 hot, 4 cold, 3 too hot, 2 too cold, 1/0 the same,
+ * "AFP"), USBIN_INT_RT_STS 0x1310 bit 4 a cable in.
+ */
+#define FG_SOC_MONOTONIC        0x4009
+#define FG_SOC_INT_RT_STS       0x4010
+#define FG_SOC_READY            0x02
+#define FG_SOC_EN_CTL           0x4046
+#define FG_ALGORITHM_EN         0x80
+#define FG_INFO_TEMP_STS        0x4106
+#define FG_INFO_BATT_TEMP       0x4150
+#define FG_INFO_VBATT_IBATT     0x41a0
+#define FG_INFO_VBATT_IBATT_CP  0x41a6
+#define FG_RR_INT_RT_STS        0x4210
+#define FG_RR_BATT_MISSING      0x01
+#define FG_RR_BATT_TEMP         0x4288
+#define FG_READ_TRIES           5               /* fg-util.c's MAX_READ_TRIES */
+#define CHGR_STATUS_1           0x1006
+#define CHGR_STATUS_7           0x100d
+#define CHGR_JEITA_HOT          0x2a            /* hot (soft), too hot, too hot (AFP) */
+#define CHGR_JEITA_TOO_COLD     0x05            /* too cold, too cold (AFP) */
+#define USBIN_INT_RT_STS        0x1310
+#define USBIN_PLUGIN            0x10
+enum { CHG_STATE_TRICKLE = 1, CHG_STATE_TAPER = 4, CHG_STATE_TERMINATED = 5 };
+
+/*
+ * The battery (fg-gen4-batterydata-apollo-sun-5000mah.dtsi: qcom,nom-batt-capacity-mah 5000), for counting the charge
+ * when the gauge gives no SOC; and the resistance that the estimate from the voltage takes the load out with (the
+ * cell's and the path's, typical of such a cell: not measured on this phone).
+ */
+#define BATTERY_CAPACITY_MAH    5000
+#define BATTERY_RESISTANCE_MOHM 100
+#define TEMP_AGREE_QUARTERS     20              /* the two thermistor readings within 5 degrees of each other */
+
+struct gauge {
+	bool ok;                        /* the voltage and the current, each as its copy */
+	const char *problem;
+	int32_t voltage_mv, current_ma; /* the gauge's sign: more than 0 while the battery discharges */
+	bool msoc_ok;                   /* the monotonic SOC and its copy agree */
+	uint8_t msoc_raw, msoc_copy;
+	bool en_ok, soc_rt_ok, missing_ok;
+	uint8_t en_ctl, soc_rt, rr_rt;
+	bool rr_temp_ok, info_temp_ok, temp_sts_ok;
+	uint16_t rr_temp_raw, info_temp_raw;
+	uint8_t temp_sts;
+	int32_t rr_temp_q, info_temp_q;         /* in quarters of a degree Celsius */
+	bool chg_ok, jeita_ok;
+	uint8_t status1, status7, usbin;
+};
+
+static void
+gauge_read(struct gauge *g)
+{
+	uint8_t a[4], b[4], t[2];
+	const char *problem = NULL;
+
+	memset(g, 0, sizeof(*g));
+	for (int i = 0; i < FG_READ_TRIES && !g->ok; i++) {
+		if ((problem = spmi_read(FG_INFO_VBATT_IBATT, a, 4)) != NULL ||
+		    (problem = spmi_read(FG_INFO_VBATT_IBATT_CP, b, 4)) != NULL) {
+			break;
+		}
+		g->ok = memcmp(a, b, sizeof(a)) == 0;
+	}
+	if (g->ok) {
+		uint32_t v = (uint32_t)a[1] << 8 | a[0];
+		int32_t i = (int16_t)((uint16_t)a[3] << 8 | a[2]);
+
+		g->voltage_mv = (int32_t)((uint64_t)v * 122070 / 1000000);
+		g->current_ma = (int32_t)((int64_t)i * 488281 / 1000000);
+	} else {
+		g->problem = problem != NULL ? problem : "the voltage and current do not agree with their copies";
+	}
+	for (int i = 0; i < FG_READ_TRIES; i++) {
+		if (spmi_read(FG_SOC_MONOTONIC, t, 2) != NULL) {
+			break;
+		}
+		g->msoc_raw = t[0];
+		g->msoc_copy = t[1];
+		if (t[0] == t[1]) {
+			g->msoc_ok = true;
+			break;
+		}
+	}
+	g->en_ok = spmi_read(FG_SOC_EN_CTL, &g->en_ctl, 1) == NULL;
+	g->soc_rt_ok = spmi_read(FG_SOC_INT_RT_STS, &g->soc_rt, 1) == NULL;
+	g->missing_ok = spmi_read(FG_RR_INT_RT_STS, &g->rr_rt, 1) == NULL;
+	if (spmi_read(FG_RR_BATT_TEMP, t, 2) == NULL) {
+		g->rr_temp_ok = true;
+		g->rr_temp_raw = (uint16_t)((t[1] & 0x03) << 8 | t[0]);
+		/*
+		 * whole degrees, not quarters: it read 0x21 (33) on a phone charging indoors, where Android said 35.5 C a few
+		 * minutes later (28 October); as quarter degrees that was 8 C, and the cold-charging rule held the charger at 1 A
+		 */
+		g->rr_temp_q = 4 * (g->rr_temp_raw >= 0x200 ? (int32_t)g->rr_temp_raw - 0x400 : (int32_t)g->rr_temp_raw);
+	}
+	if (spmi_read(FG_INFO_BATT_TEMP, t, 2) == NULL) {
+		g->info_temp_ok = true;
+		g->info_temp_raw = (uint16_t)((t[1] & 0x07) << 8 | t[0]);
+		g->info_temp_q = (int32_t)g->info_temp_raw - 1093;      /* 273.15 kelvin, in quarters */
+	}
+	g->temp_sts_ok = spmi_read(FG_INFO_TEMP_STS, &g->temp_sts, 1) == NULL;
+	g->chg_ok = spmi_read(CHGR_STATUS_1, &g->status1, 1) == NULL &&
+	    spmi_read(USBIN_INT_RT_STS, &g->usbin, 1) == NULL;
+	g->jeita_ok = spmi_read(CHGR_STATUS_7, &g->status7, 1) == NULL;
+}
+
+/* the gauge's SOC is believed: read whole, the algorithm running, a battery there */
+static bool
+gauge_soc_valid(const struct gauge *g)
+{
+	return g->msoc_ok && g->en_ok && (g->en_ctl & FG_ALGORITHM_EN) && g->missing_ok &&
+	       !(g->rr_rt & FG_RR_BATT_MISSING);
+}
+
+/* fg_get_msoc() as Xiaomi's kernel has it for apollo (no qcom,fg-increase-100soc-time-2; report_full not known here) */
+static int
+msoc_percent(uint8_t raw)
+{
+	if (raw == 0xff) {
+		return 100;
+	}
+	if (raw == 0) {
+		return 0;
+	}
+	return ((raw - 1) * 98 + 253 / 2) / 253 + 1;
+}
+
+static bool
+temp_sane(int32_t quarters)
+{
+	return quarters >= CHG_TEMP_SANE_MIN * 4 && quarters <= CHG_TEMP_SANE_MAX * 4;
+}
+
+/*
+ * The battery's temperature, whole degrees, or false. Two readings of the one thermistor, in two formats neither of
+ * which has been checked on this phone: a reading in range is used; when both are, they must agree within 5 degrees,
+ * or neither is believed. The charger's own comparators on the same thermistor (BATTERY_CHARGER_STATUS_7, the limits
+ * the firmware gave it) have the last word: a "hot" from the charger with a reading under CHG_TEMP_WARM, or a "too
+ * cold" with one from CHG_TEMP_COOL, and the reading is wrong. A temperature not believed is no temperature: the
+ * charger's currents go to the floor and nothing is repaired (chg_tick()).
+ */
+static bool
+temperature_choose(const struct gauge *g, int *celsius, const char **source)
+{
+	bool rr = g->rr_temp_ok && temp_sane(g->rr_temp_q), info = g->info_temp_ok && temp_sane(g->info_temp_q);
+	int32_t q;
+
+	if (rr && info) {
+		if (g->rr_temp_q - g->info_temp_q > TEMP_AGREE_QUARTERS || g->info_temp_q - g->rr_temp_q > TEMP_AGREE_QUARTERS) {
+			*source = "the two readings disagree";
+			return false;
+		}
+		q = g->rr_temp_q, *source = "the gauge's thermistor ADC (BATT_INFO agrees)";
+	} else if (rr) {
+		q = g->rr_temp_q, *source = "the gauge's thermistor ADC";
+	} else if (info) {
+		q = g->info_temp_q, *source = "the gauge's BATT_INFO";
+	} else {
+		*source = "no reading in range";
+		return false;
+	}
+	*celsius = q >= 0 ? q / 4 : -((-q + 3) / 4);
+	if (g->jeita_ok && (g->status7 & CHGR_JEITA_HOT) && *celsius < CHG_TEMP_WARM) {
+		*source = "the charger says hot, the reading does not";
+		return false;
+	}
+	if (g->jeita_ok && (g->status7 & CHGR_JEITA_TOO_COLD) && *celsius >= CHG_TEMP_COOL) {
+		*source = "the charger says too cold, the reading does not";
+		return false;
+	}
+	return true;
+}
+
+/* the loader's soc_from_voltage() (xnuloader/loader.c), in thousandths of a percent */
+static int32_t
+soc_from_voltage(int32_t mv)
+{
+	if (mv <= 3300) {
+		return 0;
+	}
+	if (mv < 3700) {
+		return (mv - 3300) * 10000 / 400;
+	}
+	if (mv < 3900) {
+		return 10000 + (mv - 3700) * 40000 / 200;
+	}
+	if (mv < 4200) {
+		return 50000 + (mv - 3900) * 40000 / 300;
+	}
+	if (mv < 4400) {
+		return 90000 + (mv - 4200) * 10000 / 200;
+	}
+	return 100000;
+}
+
+/*
+ * The charge, in thousandths of a percent. The gauge's own SOC whenever it is believed (gauge_soc_valid()): it is the
+ * PMIC's coulomb counter, corrected by the OCV of the profile the UEFI loaded, the number Android shows. When it is
+ * not: from the gauge's last SOC if there was one, else from the voltage (the load taken out: the open-circuit
+ * voltage is the terminal one plus the current times BATTERY_RESISTANCE_MOHM), the current counted from there on
+ * (trapezoids between two reads, over BATTERY_CAPACITY_MAH), and pulled slowly toward the voltage's estimate --
+ * by a sixtieth a tick (a time constant of five minutes) when the gauge never answered, a 720th (an hour) after it had.
+ * A charger that has terminated says full.
+ */
+static int32_t soc_milli = -1;
+static bool soc_had_gauge;
+
+static const char *
+soc_update(const struct gauge *g, int32_t previous_ma, uint64_t elapsed_ms, bool terminated)
+{
+	int32_t ocv = g->voltage_mv + g->current_ma * BATTERY_RESISTANCE_MOHM / 1000, estimate = soc_from_voltage(ocv);
+
+	if (gauge_soc_valid(g)) {
+		soc_milli = msoc_percent(g->msoc_raw) * 1000;
+		soc_had_gauge = true;
+		return "the gauge";
+	}
+	if (soc_milli < 0) {
+		soc_milli = estimate;
+		return "the voltage";
+	}
+	if (elapsed_ms > 10 * 60 * 1000) {
+		elapsed_ms = 10 * 60 * 1000;
+	}
+	soc_milli -= (int32_t)(((int64_t)previous_ma + g->current_ma) * (int64_t)elapsed_ms / 2 /
+	    (36 * BATTERY_CAPACITY_MAH));
+	soc_milli += (estimate - soc_milli) / (soc_had_gauge ? 720 : 60);
+	if (terminated) {
+		soc_milli = 100000;
+	}
+	soc_milli = soc_milli < 0 ? 0 : soc_milli > 100000 ? 100000 : soc_milli;
+	return soc_had_gauge ? "the gauge's last SOC and the current since" : "the voltage and the current since";
+}
+
+/* the first look, said whole: what the gauge is and what it gives */
+static void
+gauge_describe(void)
+{
+	static const char *const states[8] = { "inhibit", "trickle", "pre", "fullon", "taper", "term", "pause", "disabled" };
+	struct gauge g;
+	uint8_t id[2];
+	const char *source = NULL;
+	int celsius = -273;
+	bool believed;
+
+	for (unsigned i = 0; i < CHG_PERIPHERALS; i++) {
+		if (chg_periph[i].gauge && chg_periph[i].found) {
+			const char *problem = spmi_read((uint16_t)((chg_periph[i].id & 0xff) << 8 | 0x04), id, 2);
+
+			if (problem == NULL) {
+				say("apollo battery: %s: type %#x subtype %#x\n", chg_periph[i].name, id[0], id[1]);
+			} else {
+				say("apollo battery: %s: %s\n", chg_periph[i].name, problem);
+			}
+		}
+	}
+	gauge_read(&g);
+	say("apollo battery: gauge: %s%d mV, %d mA (VBATT/IBATT 0x41a0, copies 0x41a6)\n",
+	    g.ok ? "" : "NOT READ: ", g.voltage_mv, g.current_ma);
+	if (!g.ok) {
+		say("apollo battery: gauge: %s\n", g.problem);
+	}
+	say("apollo battery: gauge: monotonic SOC 0x4009 %#x, copy %#x (%s; %d%%), EN_CTL %#x (algorithm %s), "
+	    "SOC_INT_RT_STS %#x (soc-ready %d), RR_INT_RT_STS %#x (battery %s): its SOC is %s\n", g.msoc_raw, g.msoc_copy,
+	    g.msoc_ok ? "agree" : "DIFFER", msoc_percent(g.msoc_raw), g.en_ctl, !g.en_ok ? "??" :
+	    (g.en_ctl & FG_ALGORITHM_EN) ? "runs" : "STOPPED", g.soc_rt, (g.soc_rt & FG_SOC_READY) != 0, g.rr_rt,
+	    !g.missing_ok ? "??" : (g.rr_rt & FG_RR_BATT_MISSING) ? "MISSING" : "present",
+	    gauge_soc_valid(&g) ? "VALID" : "NOT VALID (the voltage and the current are used)");
+	believed = temperature_choose(&g, &celsius, &source);
+	say("apollo battery: temperature: RRADC 0x4288 %s%#x (%d.%02d C as whole degrees), BATT_INFO 0x4150 %s%#x "
+	    "(%d.%02d C as quarter kelvin), TEMP_STS %#x, the charger's JEITA %#x: %s %d C, from %s\n",
+	    g.rr_temp_ok ? "" : "unread ", g.rr_temp_raw, g.rr_temp_q / 4, (g.rr_temp_q < 0 ? -g.rr_temp_q : g.rr_temp_q) % 4 * 25,
+	    g.info_temp_ok ? "" : "unread ", g.info_temp_raw, g.info_temp_q / 4,
+	    (g.info_temp_q < 0 ? -g.info_temp_q : g.info_temp_q) % 4 * 25, g.temp_sts, g.status7,
+	    believed ? "believed:" : "NOT BELIEVED:", celsius, source);
+	say("apollo battery: charger: %s, state %s, USBIN_INT_RT_STS %#x (a cable %s)\n", g.chg_ok ? "read" : "NOT READ",
+	    states[g.status1 & 7], g.usbin, (g.usbin & USBIN_PLUGIN) ? "in" : "out");
+}
+
+static void
+report(const struct hakios_battery_state *state)
+{
+	HakiosBatteryReport(state, sizeof(*state));
+}
+
+static void
+apollo_battery_pmic_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	static const char *const states[8] = { "inhibit", "trickle", "pre", "fullon", "taper", "term", "pause", "disabled" };
+	struct gauge g;
+	struct hakios_battery_state state;
+	uint64_t reports = 0, misses = 0, fresh_interval, last_ok = 0, last_time = 0, now, ms;
+	int32_t previous_ma = 0;
+	int shown = -1, temperature_c = -273;
+	bool fresh, was_fresh = true, temperature_valid, was_valid = true, was_gauge = true;
+	const char *soc_source = "nothing yet", *temperature_source = "nothing yet", *last_problem = NULL;
+
+	nanoseconds_to_absolutetime(CHG_FRESH_SECONDS * NSEC_PER_SEC, &fresh_interval);
+	gauge_describe();
+	for (unsigned tick = 0;; tick++) {
+		gauge_read(&g);
+		now = mach_absolute_time();
+		temperature_valid = false;
+		if (!g.ok) {
+			misses++;
+			if (g.problem != last_problem) {
+				say("apollo battery: the gauge is not read: %s\n", g.problem);
+				last_problem = g.problem;
+			}
+		} else {
+			bool charger = g.chg_ok ? (g.usbin & USBIN_PLUGIN) != 0 : g.current_ma < -50;
+			uint8_t chg_state = g.status1 & 7;
+			bool charging = g.chg_ok ? chg_state >= CHG_STATE_TRICKLE && chg_state <= CHG_STATE_TAPER : g.current_ma < -50;
+			bool terminated = g.chg_ok && charger && chg_state == CHG_STATE_TERMINATED;
+			int celsius = -273;
+
+			last_problem = NULL;
+			absolutetime_to_nanoseconds(last_time != 0 ? now - last_time : 0, &ms);
+			ms /= NSEC_PER_MSEC;
+			soc_source = soc_update(&g, last_time != 0 ? previous_ma : g.current_ma, ms, terminated);
+			previous_ma = g.current_ma;
+			last_time = last_ok = now;
+			if (gauge_soc_valid(&g) != was_gauge) {
+				was_gauge = !was_gauge;
+				say("apollo battery: the gauge's SOC %s (raw %#x/%#x, EN_CTL %#x, RR_INT_RT_STS %#x)%s\n",
+				    was_gauge ? "is valid again" : "IS NOT VALID", g.msoc_raw, g.msoc_copy, g.en_ctl, g.rr_rt,
+				    was_gauge ? "" : soc_had_gauge ? ": its last value and the current counted on" :
+				    ": from the voltage and the current");
+			}
+			temperature_valid = temperature_choose(&g, &celsius, &temperature_source);
+			temperature_c = temperature_valid ? celsius : -273;
+			if (temperature_valid != was_valid) {
+				was_valid = temperature_valid;
+				say("apollo battery: the temperature is %s (%s; RRADC %#x, BATT_INFO %#x, JEITA %#x)\n",
+				    temperature_valid ? "believed again" : "NOT BELIEVED", temperature_source, g.rr_temp_raw,
+				    g.info_temp_raw, g.status7);
+			}
+
+			apollo_battery_soc = (soc_milli + 500) / 1000;
+			apollo_battery_voltage_mv = g.voltage_mv >= 2500 && g.voltage_mv <= 5000 ? g.voltage_mv : -1;
+			apollo_battery_current_ma = g.current_ma;
+			apollo_battery_temperature_c = temperature_c;
+			apollo_battery_present = !g.missing_ok || !(g.rr_rt & FG_RR_BATT_MISSING);
+			apollo_battery_charger = charger;
+			apollo_battery_charging = charging;
+			apollo_battery_estimated = !gauge_soc_valid(&g);
+
+			memset(&state, 0, sizeof(state));
+			state.size = sizeof(state);
+			state.percent_hundredths = apollo_battery_soc * 100;
+			state.voltage_uv = apollo_battery_voltage_mv > 0 ? apollo_battery_voltage_mv * 1000 : 0;
+			/* the power source wants more than 0 while charging: the gauge's sign is the other way */
+			state.current_ua = clamp32(-(int64_t)g.current_ma * 1000);
+			state.temperature_hundredths = clamp32((int64_t)apollo_battery_temperature_c * 100);
+			state.present = apollo_battery_present;
+			state.external = apollo_battery_charger;
+			state.status = apollo_battery_charging ? 1 : apollo_battery_charger ?
+			    (apollo_battery_soc >= 100 || terminated ? 4 : 3) : 2;
+			state.design_uah = BATTERY_CAPACITY_MAH * 1000;
+			report(&state);
+			reports++;
+			if (apollo_battery_soc != shown) {
+				say("apollo battery: iOS is told %d%% (was %d%%; from %s; %d mV, %d mA, %d C, charger %d)\n",
+				    apollo_battery_soc, shown, soc_source, apollo_battery_voltage_mv, g.current_ma, temperature_c,
+				    apollo_battery_charger);
+				shown = apollo_battery_soc;
+			}
+		}
+		fresh = last_ok != 0 && now - last_ok < fresh_interval;
+		if (chg_ready && chg_level >= 2 && fresh != was_fresh) {
+			say("apollo charger: the gauge's readings are %s\n", fresh ? "fresh again: repairs resume" :
+			    "STALE (no SPMI read of the gauge for 15 seconds): no writes to the charger, its watchdog is no longer petted");
+		}
+		was_fresh = fresh;
+		if (tick % 12 == 0) {      /* once a minute */
+			absolutetime_to_nanoseconds(last_ok != 0 ? now - last_ok : 0, &ms);
+			say("apollo battery: %d%% (from %s), %d mV, %d mA, %d C (%s), battery %d, charger %d, charging %d, "
+			    "charger state %s, gauge raw %#x (%llu reports, %llu misses; SPMI %llu reads, %llu failed; last good read %llu s ago)\n",
+			    apollo_battery_soc, soc_source, apollo_battery_voltage_mv, apollo_battery_current_ma,
+			    apollo_battery_temperature_c, temperature_source, apollo_battery_present, apollo_battery_charger,
+			    apollo_battery_charging, g.chg_ok ? states[g.status1 & 7] : "??", g.msoc_raw, reports, misses,
+			    bus.reads, bus.failed, last_ok != 0 ? ms / NSEC_PER_SEC : 0);
+		}
+		chg_tick(tick, fresh, fresh && temperature_valid, temperature_c, apollo_battery_charger);
+		delay_for_interval(5000, NSEC_PER_MSEC);
+	}
+}
+
+/* ---- the loader's page (apollo_battery_source=loader) ------------------------------------------------------ */
+
+static void
+apollo_battery_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	struct loader_battery b;
+	struct hakios_battery_state state;
+	uint64_t reports = 0, misses = 0;
+	int gauge = -1, shown = -1;     /* the fuel gauge's last own answer; what iOS was last given */
+	bool was_estimate = false;
+	/*
+	 * Whether the loader still polls: its `polls` must have advanced within CHG_FRESH_SECONDS (it polls every five
+	 * seconds while the UEFI's storage stack is in) for anything to be written to the charger. Until it is first seen
+	 * to advance, the page counts as stale.
+	 */
+	uint32_t last_polls = shared->polls;
+	uint64_t last_advance = 0, fresh_interval;
+	bool fresh = false, was_fresh = false;
+	bool temperature_valid = false;         /* from this tick's snapshot only: never an old value */
+	int temperature_c = -273;
+
+	nanoseconds_to_absolutetime(CHG_FRESH_SECONDS * NSEC_PER_SEC, &fresh_interval);
+	for (unsigned tick = 0;; tick++) {
+		bool got = snapshot(&b);
+
+		temperature_valid = false;
+		if (got && b.polls != last_polls) {
+			last_polls = b.polls;
+			last_advance = mach_absolute_time();
+		}
+		fresh = last_advance != 0 && mach_absolute_time() - last_advance < fresh_interval;
+		if (chg_ready && chg_level >= 2 && fresh != was_fresh) {
+			say("apollo charger: the loader's page is %s\n", fresh ? "fresh again: repairs resume" :
+			    "STALE (the loader has stopped polling): no writes to the charger, its watchdog is no longer petted");
+		}
+		was_fresh = fresh;
+		if (!got || !(b.flags & LOADER_BATTERY_VALID)) {
+			misses++;
+		} else {
+			apollo_battery_soc = b.soc_percent < 0 ? 0 : b.soc_percent > 100 ? 100 : b.soc_percent;
+			/*
+			 * When the fuel gauge has not answered, the loader estimates the charge from the voltage
+			 * (soc_from_voltage()), which follows the load: 59% one moment and 73% the next under a busy
+			 * processor. Once the gauge has answered, its last answer stands in for such an estimate.
+			 */
+			if (!(b.flags & LOADER_BATTERY_SOC_ESTIMATED)) {
+				gauge = apollo_battery_soc;
+			} else if (gauge >= 0) {
+				apollo_battery_soc = gauge;
+			}
+			if (((b.flags & LOADER_BATTERY_SOC_ESTIMATED) != 0) != was_estimate) {
+				was_estimate = !was_estimate;
+				say("apollo battery: the fuel gauge %s (the loader's estimate from %d mV: %d%%)%s\n",
+				    was_estimate ? "HAS STOPPED ANSWERING" : "answers again", b.voltage_mv, b.soc_percent,
+				    was_estimate && gauge >= 0 ? "; its last answer stands" : "");
+			}
+			apollo_battery_voltage_mv = (b.flags & LOADER_BATTERY_VOLTAGE_VALID) ? b.voltage_mv : -1;
+			apollo_battery_current_ma = b.current_ma;
+			apollo_battery_temperature_c = b.temperature_c;
+			temperature_valid = fresh && b.temperature_c >= CHG_TEMP_SANE_MIN && b.temperature_c <= CHG_TEMP_SANE_MAX;
+			temperature_c = b.temperature_c;
+			apollo_battery_present = (b.flags & LOADER_BATTERY_PRESENT) != 0;
+			apollo_battery_charger = (b.flags & LOADER_BATTERY_CHARGER_PRESENT) != 0;
+			apollo_battery_charging = (b.flags & LOADER_BATTERY_CHARGING) != 0;
+			apollo_battery_estimated = (b.flags & LOADER_BATTERY_SOC_ESTIMATED) != 0;
+
+			memset(&state, 0, sizeof(state));
+			state.size = sizeof(state);
+			state.percent_hundredths = apollo_battery_soc * 100;
+			state.voltage_uv = apollo_battery_voltage_mv > 0 ? apollo_battery_voltage_mv * 1000 : 0;
+			/*
+			 * The power source wants more than 0 while charging. Which sign Qualcomm's driver gives a charging current
+			 * is not settled on this phone: while charging, its magnitude is taken; otherwise its negative.
+			 */
+			state.current_ua = clamp32((apollo_battery_charging ? 1 : -1) *
+			    (b.current_ma < 0 ? -(int64_t)b.current_ma : (int64_t)b.current_ma) * 1000);
+			state.temperature_hundredths = clamp32((int64_t)b.temperature_c * 100);
+			/* the firmware's charger driver answered: there is a battery, whatever its presence call said */
+			state.present = 1;
+			state.external = apollo_battery_charger;
+			state.status = apollo_battery_charging ? 1 : apollo_battery_charger ? (apollo_battery_soc >= 100 ? 4 : 3) : 2;
+			report(&state);
+			reports++;
+			if (apollo_battery_soc != shown) {
+				say("apollo battery: iOS is told %d%% (was %d%%; %d mV, %d mA, %d C, charger %d)\n", apollo_battery_soc, shown,
+				    apollo_battery_voltage_mv, b.current_ma, b.temperature_c, apollo_battery_charger);
+				shown = apollo_battery_soc;
+			}
+		}
+		if (tick % 12 == 0) {      /* once a minute */
+			printf("apollo battery: %d%%%s, %d mV, %d mA, %d C, battery %d, charger %d, charging %d "
+			    "(%llu reports, %llu misses; the loader polled %u times, %u failed)\n", apollo_battery_soc,
+			    apollo_battery_estimated ? " (from the voltage)" : "", apollo_battery_voltage_mv,
+			    apollo_battery_current_ma, apollo_battery_temperature_c, apollo_battery_present, apollo_battery_charger,
+			    apollo_battery_charging, reports, misses, shared->polls, shared->failures);
+		}
+		chg_tick(tick, fresh, temperature_valid, temperature_c, apollo_battery_charger);
+		delay_for_interval(5000, NSEC_PER_MSEC);
+	}
+}
+
+/* apollo_battery_source=loader: the loader's page mapped and checked */
+static bool
+loader_page_init(void)
+{
+	uint64_t pa = 0;
+	vm_offset_t page;
+
+	if (!PE_parse_boot_argn("battery_shared_pa", &pa, sizeof(pa)) || pa == 0) {
+		printf("apollo battery: the loader gave no battery_shared_pa (is it a loader that knows apollo_battery=1?)\n");
+		return false;
+	}
+	if ((pa & (LOADER_PAGE_SIZE - 1)) + sizeof(struct loader_battery) > LOADER_PAGE_SIZE) {
+		printf("apollo battery: battery_shared_pa %#llx: the page's struct would run past its 16 KB mapping\n", pa);
+		return false;
+	}
+	page = ml_io_map((vm_offset_t)(pa & ~(LOADER_PAGE_SIZE - 1)), LOADER_PAGE_SIZE);
+	shared = (volatile struct loader_battery *)(page + (pa & (LOADER_PAGE_SIZE - 1)));
+	if (shared->magic != LOADER_BATTERY_MAGIC || shared->version != LOADER_BATTERY_VERSION ||
+	    shared->size < sizeof(struct loader_battery)) {
+		printf("apollo battery: no loader battery page at %#llx (magic %#llx, version %u, size %u)\n", pa, shared->magic,
+		    shared->version, shared->size);
+		return false;
+	}
+	printf("apollo battery: the UEFI charger drivers' state at pa %#llx, read every 5 seconds\n", pa);
+	return true;
+}
+
+void
+apollo_battery_init(void)
+{
+	uint32_t enabled = 0;
+	char source[16] = "spmi";
+	bool from_loader;
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("apollo_battery", &enabled, sizeof(enabled)) || !enabled) {
+		return;
+	}
+	(void)PE_parse_boot_arg_str("apollo_battery_source", source, sizeof(source));
+	from_loader = strcmp(source, "loader") == 0;
+	if (!from_loader && strcmp(source, "spmi") != 0) {
+		say("apollo battery: apollo_battery_source=%s is not known (spmi or loader): spmi\n", source);
+	}
+	(void)PE_parse_boot_argn("apollo_charger", &chg_level, sizeof(chg_level));
+	if (from_loader) {
+		if (!loader_page_init()) {
+			return;
+		}
+		if (chg_level != 0 && spmi_init()) {
+			chg_init();
+		}
+	} else {
+		bool gauge = true;
+
+		if (!spmi_init()) {
+			return;
+		}
+		for (unsigned i = 0; i < CHG_PERIPHERALS; i++) {
+			gauge &= !chg_periph[i].gauge || chg_periph[i].found;
+		}
+		if (!gauge) {
+			say("apollo battery: the PM8150B's fuel gauge has no channel: no battery (apollo_battery_source=loader for the old way)\n");
+			return;
+		}
+		apollo_battery_from_pmic = 1;
+		say("apollo battery: from the PM8150B's fuel gauge itself (FG gen4, slave 2: BATT_SOC 0x4000, BATT_INFO 0x4100, "
+		    "RRADC 0x4200) and its charger, read over SPMI every 5 seconds; the loader's page is not used\n");
+		if (chg_level != 0) {
+			chg_init();
+		}
+	}
+	if (kernel_thread_start(from_loader ? apollo_battery_thread : apollo_battery_pmic_thread, NULL, &thread) ==
+	    KERN_SUCCESS) {
+		thread_set_thread_name(thread, "apollo battery");
+		thread_deallocate(thread);
+	}
+}
diff --git a/bsd/dev/hakios.apollo_buttons.c b/bsd/dev/hakios.apollo_buttons.c
new file mode 100644
index 000000000000..a5945e84e1b6
--- /dev/null
+++ b/bsd/dev/hakios.apollo_buttons.c
@@ -0,0 +1,332 @@
+/*
+ * The keys of the Xiaomi Mi 10T (apollo), with boot-arg apollo_buttons=1 (bsd/dev/hakios.apollo_input.c): power and volume
+ * down are inputs of the PM8150's power-on block, volume up is the PM8150's GPIO6. All three are read through the
+ * SPMI arbiter every 16 ms and handed to backboardd as button records through /dev/hakios-touch.
+ *
+ * From the phone's device tree: qcom,power-on@800 of the pm8150 (slave 0) has "kpdpwr" as interrupt 0 and "resin" as
+ * interrupt 1 -- the power-on block of the first kind (Linux qpnp-power-on, gen1/gen2), whose status register has
+ * power in bit 0 and volume down (RESIN) in bit 1; and gpio_keys/vol_up is GPIO6 of that PMIC, low while it is held.
+ * The arbiter is the one at 0xc440000 (version 5, "qcom,spmi-pmic-arb"), this system being 0 ("qcom,ee").
+ *
+ * Read only: nothing is written to the PMIC, the way the firmware left it is the way it stays.
+ */
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include <sys/hakios.apollo_input.h>
+#include <sys/hakios.input.h>          /* hakios_touch_post(): the queue backboardd reads, shared */
+#include <sys/systm.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern kern_return_t thread_terminate(thread_t thread);
+
+/* Into the loader's log as well: a phone that resets keeps only that (as in bsd/dev/hakios.apollo_touch.c). */
+extern void loader_log_putc(char c);
+
+static int say(const char *format, ...) __printflike(1, 2);
+
+static int
+say(const char *format, ...)
+{
+	char line[300];
+	va_list list;
+
+	va_start(list, format);
+	vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
+	for (const char *c = line; *c != 0; c++) {
+		loader_log_putc(*c);
+	}
+	return printf("%s", line);
+}
+
+static inline uint32_t
+rd(vm_offset_t address)
+{
+	return *(volatile uint32_t *)address;
+}
+
+static inline void
+wr(vm_offset_t address, uint32_t value)
+{
+	*(volatile uint32_t *)address = value;
+}
+
+/* ---- the SPMI arbiter (Linux drivers/spmi/spmi-pmic-arb.c, version 5) ------------------------------ */
+
+#define ARB_CORE_PHYS           0x0c440000UL    /* the version, and which peripheral each channel is */
+#define ARB_CORE_SIZE           0x1100UL
+#define ARB_CNFG_PHYS           0x0c40a000UL    /* which system owns each channel */
+#define ARB_CNFG_SIZE           0x1000UL
+#define ARB_OBSERVER_PHYS       0x0e600000UL    /* 0x10000 per system, 0x80 per channel: reads only */
+#define ARB_OBSERVER_SIZE       0x10000UL
+#define ARB_SYSTEM              0
+
+#define ARB_VERSION             0x000
+#define ARB_FEATURES            0x004           /* [10:0] channels */
+#define ARB_CHANNEL(n)          (0x900 + 4 * (n))       /* [19:8] slave << 8 | peripheral */
+#define ARB_OWNER(n)            (0x700 + 4 * (n))       /* [2:0] the system that owns channel n */
+#define ARB_MAX_CHANNELS        512
+
+#define OBSERVER_COMMAND        0x00
+#define OBSERVER_STATUS         0x08
+#define OBSERVER_DATA0          0x18
+#define STATUS_DONE             0x1
+#define STATUS_FAILURE          0x2
+#define STATUS_DENIED           0x4
+#define STATUS_DROPPED          0x8
+#define COMMAND_READ            (1u << 27)      /* [11:4] register, [2:0] bytes - 1 */
+#define READ_TIMEOUT_US         2000
+
+static vm_offset_t arb_core, arb_cnfg, arb_observer;
+
+/* one transfer at a time on the arbiter, for all the apollo drivers that use it: apollo_spmi_bus_lock (hakios.apollo_battery.c; Linux: one lock for the bus) */
+
+struct peripheral {
+	const char *name;
+	uint16_t id;                    /* slave << 8 | peripheral */
+	uint16_t channel;
+	bool found;
+};
+static struct peripheral pon = { .name = "the PM8150's power-on block", .id = 0x008 };   /* registers 0x0800, slave 0 */
+static struct peripheral pin = { .name = "GPIO6 of the PM8150", .id = 0x0c5 };           /* registers 0xc500, slave 0 */
+
+static struct {
+	uint64_t reads, failed;
+} bus;
+
+/* `count` (1 to 4) registers from `reg` on; NULL, or what went wrong */
+static const char *
+spmi_read(const struct peripheral *p, uint8_t reg, uint8_t *bytes, uint32_t count)
+{
+	vm_offset_t channel = arb_observer + 0x10000UL * ARB_SYSTEM + 0x80UL * p->channel;
+	uint64_t start = mach_absolute_time(), interval;
+	uint32_t status, data;
+
+	nanoseconds_to_absolutetime(READ_TIMEOUT_US * (uint64_t)NSEC_PER_USEC, &interval);
+	lck_spin_lock(&apollo_spmi_bus_lock);       /* (one lock for the arbiter: hakios.apollo_battery.c, hakios.apollo_backlight.c) */
+	wr(channel + OBSERVER_COMMAND, COMMAND_READ | (uint32_t)reg << 4 | (count - 1));
+	do {
+		status = rd(channel + OBSERVER_STATUS);
+	} while (!(status & STATUS_DONE) && mach_absolute_time() - start < interval);
+	data = rd(channel + OBSERVER_DATA0);
+	lck_spin_unlock(&apollo_spmi_bus_lock);
+
+	bus.reads++;
+	if (!(status & STATUS_DONE) || (status & (STATUS_DENIED | STATUS_FAILURE | STATUS_DROPPED))) {
+		bus.failed++;
+		return !(status & STATUS_DONE) ? "no answer from the arbiter" : (status & STATUS_DENIED) ? "the arbiter refuses" :
+		       (status & STATUS_FAILURE) ? "the transfer failed" : "the transfer was dropped";
+	}
+	for (uint32_t i = 0; i < count; i++) {
+		bytes[i] = (uint8_t)(data >> (8 * i));
+	}
+	return NULL;
+}
+
+/* the peripheral's channel: the first, unless a later one is this system's (as Linux chooses) */
+static bool
+find_channel(struct peripheral *p, uint32_t channels)
+{
+	for (uint32_t n = 0; n < channels; n++) {
+		uint32_t map = rd(arb_core + ARB_CHANNEL(n));
+
+		if (map == 0 || ((map >> 8) & 0xfff) != p->id) {
+			continue;
+		}
+		if (!p->found || (rd(arb_cnfg + ARB_OWNER(n)) & 7) == ARB_SYSTEM) {
+			p->found = true;
+			p->channel = (uint16_t)n;
+		}
+	}
+	if (p->found) {
+		say("apollo buttons: %s is channel %u\n", p->name, p->channel);
+	} else {
+		say("apollo buttons: no channel is %s\n", p->name);
+	}
+	return p->found;
+}
+
+/* ---- the keys ----------------------------------------------------------------------------------------- */
+
+#define REG_TYPE                0x04
+#define REG_SUBTYPE             0x05
+#define REG_RT_STATUS           0x10
+#define PON_TYPE                0x01
+#define PON_KPDPWR              0x01            /* gen1/gen2 power-on block: power in bit 0 ... */
+#define PON_RESIN               0x02            /* ... and volume down in bit 1 */
+#define REG_INT_LATCHED         0x18            /* the interrupts latched since they were last cleared (read only here) */
+#define REG_PULL_CTL            0x70            /* the power-on block's pull-ups: */
+#define PON_RESIN_PULL_UP       0x01            /* volume down's ... */
+#define PON_KPDPWR_PULL_UP      0x02            /* ... and power's */
+#define GPIO_TYPE               0x10
+#define GPIO_LEVEL              0x01
+#define GPIO_REG_MODE           0x40            /* [1:0] 0 input */
+#define GPIO_REG_ENABLE         0x46            /* [7] */
+#define POLL_MS                 16
+#define MINUTE_TICKS            (60 * 1000 / POLL_MS)
+
+static struct key {
+	const char *name;
+	uint32_t record;                /* HAKIOS_BUTTON_* */
+	bool usable, live, last, down;
+	uint32_t presses;
+} power = { .name = "power", .record = HAKIOS_BUTTON_LOCK },
+    volume_up = { .name = "volume up", .record = HAKIOS_BUTTON_VOLUME_UP },
+    volume_down = { .name = "volume down", .record = HAKIOS_BUTTON_VOLUME_DOWN };
+
+/*
+ * One look at a key: a change counts once it has read the same twice (16 ms apart), and a key that was held when the
+ * driver started is believed only after it has been seen released.
+ */
+static void
+key_look(struct key *k, bool pressed)
+{
+	bool steady = pressed == k->last;
+
+	k->last = pressed;
+	if (!k->usable || !steady) {
+		return;
+	}
+	if (!k->live) {
+		k->live = !pressed;
+		return;
+	}
+	if (pressed == k->down) {
+		return;
+	}
+	k->down = pressed;
+	if (pressed) {
+		k->presses++;
+	}
+	say("apollo buttons: %s %s\n", k->name, pressed ? "pressed" : "released");
+	hakios_touch_post(pressed ? HAKIOS_BUTTON_DOWN : HAKIOS_BUTTON_UP, k->record, 0, 0);
+}
+
+static void
+apollo_buttons_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	uint8_t id[2], status = 0, gpio[7];
+	uint32_t channels;
+	const char *problem;
+
+	arb_core = ml_io_map(ARB_CORE_PHYS, ARB_CORE_SIZE);
+	arb_cnfg = ml_io_map(ARB_CNFG_PHYS, ARB_CNFG_SIZE);
+	arb_observer = ml_io_map(ARB_OBSERVER_PHYS, ARB_OBSERVER_SIZE);
+	if (arb_core == 0 || arb_cnfg == 0 || arb_observer == 0) {
+		say("apollo buttons: cannot map the SPMI arbiter\n");
+		goto out;
+	}
+	channels = rd(arb_core + ARB_FEATURES) & 0x7ff;
+	if (channels > ARB_MAX_CHANNELS) {
+		channels = ARB_MAX_CHANNELS;
+	}
+	say("apollo buttons: SPMI arbiter version %#x, %u channels\n", rd(arb_core + ARB_VERSION), channels);
+
+	/* power and volume down: a power-on block, of any subtype (the PM8150's says 4) */
+	if (find_channel(&pon, channels)) {
+		problem = spmi_read(&pon, REG_TYPE, id, 2);
+		if (problem == NULL && id[0] == PON_TYPE) {
+			problem = spmi_read(&pon, REG_RT_STATUS, &status, 1);
+		}
+		if (problem == NULL && id[0] == PON_TYPE) {
+			uint8_t pull = 0xff;
+
+			/* (Linux qpnp-power-on: PULL_CTL at +0x70, bit 0 RESIN's pull-up, bit 1 KPDPWR's; Android sets both, qcom,pull-up) */
+			(void)spmi_read(&pon, REG_PULL_CTL, &pull, 1);
+			say("apollo buttons: power-on block: type %#x subtype %#x, status %#x (power %s, volume down %s), pull-ups %#x "
+			    "(volume down's %s, power's %s)\n", id[0], id[1], status, (status & PON_KPDPWR) ? "held" : "released",
+			    (status & PON_RESIN) ? "held" : "released", pull, (pull & PON_RESIN_PULL_UP) ? "on" : "OFF",
+			    (pull & PON_KPDPWR_PULL_UP) ? "on" : "OFF");
+			power.usable = volume_down.usable = true;
+			power.last = status & PON_KPDPWR;
+			volume_down.last = status & PON_RESIN;
+		} else {
+			say("apollo buttons: %s: %s\n", pon.name, problem != NULL ? problem : "not a power-on block");
+		}
+	}
+	/* volume up: an enabled input */
+	if (find_channel(&pin, channels)) {
+		problem = spmi_read(&pin, REG_TYPE, id, 2);
+		if (problem == NULL) {
+			problem = spmi_read(&pin, GPIO_REG_MODE, gpio, 4);
+		}
+		if (problem == NULL) {
+			problem = spmi_read(&pin, GPIO_REG_ENABLE, &gpio[6], 1);
+		}
+		if (problem == NULL) {
+			problem = spmi_read(&pin, REG_RT_STATUS, &status, 1);
+		}
+		if (problem == NULL && id[0] == GPIO_TYPE && (gpio[0] & 3) == 0 && (gpio[6] & 0x80)) {
+			say("apollo buttons: volume up's pin: an enabled input, level %s\n", (status & GPIO_LEVEL) ? "high (released)" :
+			    "low (held)");
+			volume_up.usable = true;
+			volume_up.last = !(status & GPIO_LEVEL);
+		} else {
+			say("apollo buttons: volume up's pin: %s (type %#x, mode %#x, enable %#x)\n",
+			    problem != NULL ? problem : "not an enabled input", id[0], gpio[0], gpio[6]);
+		}
+	}
+	if (!power.usable && !volume_up.usable) {
+		say("apollo buttons: no key can be read\n");
+		goto out;
+	}
+	power.live = power.usable && !power.last;
+	volume_down.live = volume_down.usable && !volume_down.last;
+	volume_up.live = volume_up.usable && !volume_up.last;
+	say("apollo buttons: watching%s%s%s every %u ms\n", power.usable ? " power" : "", volume_up.usable ? " volume-up" : "",
+	    volume_down.usable ? " volume-down" : "", POLL_MS);
+
+	for (unsigned tick = 1, seen_status = ~0u, seen_latched = ~0u, told = 0;; tick++) {
+		if (power.usable && spmi_read(&pon, REG_RT_STATUS, &status, 1) == NULL) {
+			uint8_t latched = 0;
+
+			key_look(&power, status & PON_KPDPWR);
+			key_look(&volume_down, status & PON_RESIN);
+			/*
+			 * Volume down is not seen on the phone (27 October: 6 presses of volume up, none of volume down, with RESIN's
+			 * pull-up on): every change of the whole status and of the latched interrupts is said, so that a press shows
+			 * wherever it is. At most 64 lines.
+			 */
+			(void)spmi_read(&pon, REG_INT_LATCHED, &latched, 1);
+			if ((status != seen_status || latched != seen_latched) && told < 64) {
+				say("apollo buttons: power-on block status %#x, latched %#x\n", status, latched);
+				seen_status = status;
+				seen_latched = latched;
+				told++;
+			}
+		}
+		if (volume_up.usable && spmi_read(&pin, REG_RT_STATUS, &status, 1) == NULL) {
+			key_look(&volume_up, !(status & GPIO_LEVEL));
+		}
+		if (tick % MINUTE_TICKS == 0) {
+			say("apollo buttons: %u presses of power, %u of volume up, %u of volume down; %llu reads, %llu failed\n",
+			    power.presses, volume_up.presses, volume_down.presses, bus.reads, bus.failed);
+		}
+		if (bus.failed >= 1000 && bus.failed * 2 > bus.reads) {
+			say("apollo buttons: more than half of %llu reads have failed: giving up\n", bus.reads);
+			break;
+		}
+		delay_for_interval(POLL_MS, NSEC_PER_MSEC);
+	}
+out:
+	thread_terminate(current_thread());
+}
+
+void
+apollo_buttons_init(void)
+{
+	uint32_t enabled = 0;
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("apollo_buttons", &enabled, sizeof(enabled)) || !enabled) {
+		return;
+	}
+	if (kernel_thread_start(apollo_buttons_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_set_thread_name(thread, "apollo buttons");
+		thread_deallocate(thread);
+	}
+}
diff --git a/bsd/dev/hakios.apollo_cpufreq.c b/bsd/dev/hakios.apollo_cpufreq.c
new file mode 100644
index 000000000000..d4b66c10d077
--- /dev/null
+++ b/bsd/dev/hakios.apollo_cpufreq.c
@@ -0,0 +1,557 @@
+/*
+ * The Xiaomi Mi 10T's (apollo, SM8250) processor at its top speed, with boot-arg apollo_cpufreq=1
+ * (bsd/dev/hakios.apollo_input.c). Everything this kernel draws, it draws on the processor (there is no GPU driver for the
+ * Adreno 650 yet), so the speed the firmware left the cores at is what the user interface feels like.
+ *
+ * The phone's device tree: qcom,cpufreq-hw-epss with three frequency domains at 0x18591000, 0x18592000 and
+ * 0x18593000 -- cores 0 to 3, 4 to 6, and 7. As Linux drivers/cpufreq/qcom-cpufreq-hw.c (its EPSS layout): the table
+ * of frequencies at 0x100, a word a row ([31:30] source, 0 being the fixed 300 MHz; [7:0] multiple of 19.2 MHz), the
+ * table ending where a row repeats; and the row wanted, written to 0x320. The firmware then sets the clock and the
+ * voltage itself.
+ */
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <mach/vm_param.h>
+#include <vm/memory_types.h>
+#include <kern/kalloc.h>
+#include <pexpert/pexpert.h>
+#include <sys/hakios.apollo_input.h>
+#include <sys/systm.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+/* into the loader's log as well: the kernel's own message buffer keeps only the end of a long run */
+extern void loader_log_putc(char c);
+
+static int say(const char *format, ...) __printflike(1, 2);
+
+static int
+say(const char *format, ...)
+{
+	char line[200];
+	va_list list;
+
+	va_start(list, format);
+	vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
+	for (const char *c = line; *c != 0; c++) {
+		loader_log_putc(*c);
+	}
+	return printf("%s", line);
+}
+
+#define EPSS_PHYS               0x18591000UL
+#define EPSS_DOMAIN_SIZE        0x1000UL
+#define EPSS_DOMAINS            3
+#define EPSS_FREQ_TABLE         0x100
+#define EPSS_TABLE_ROWS         40
+#define EPSS_PERF_STATE         0x320
+#define EPSS_DOMAIN_STATE       0x20            /* [7:0]: the speed the firmware has set now, in 19.2 MHz (Linux's reg_domain_state) */
+#define XO_KHZ                  19200
+#define ALTERNATE_KHZ           300000
+
+/* ---- the memory's bandwidth (boot-arg apollo_ddr=1, with apollo_cpufreq=1) -------------------------------------
+ *
+ * Every frame is drawn by the processor, and drawing is mostly copying: the memory bus's clock matters as much as
+ * the cores'. Left alone it stays where the boot chain put it. A vote for it goes to RPMh as Linux's interconnect
+ * driver makes one (drivers/interconnect/qcom/bcm-voter.c): the BCMs of the memory controller (MC0) and its shared
+ * cache (SH0) at their top, and ACV with the application processor's bit -- the same three hakios.cpufreq.c votes
+ * for with ddr=2, through TCS 1 of the sequencer (TCS 0 is hakios.apollo_adsp.c's; TCS 1 is shared with
+ * hakios.apollo_pcie.c and apollo_rpmh_bcm_vote(), each holding apollo_rpmh_tcs1_lock around it). How fast a core reads,
+ * writes and copies is measured before and after.
+ */
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t phys_addr, vm_size_t size, unsigned int flags);
+
+#define CMD_DB_PHYS             0x80860000UL
+#define CMD_DB_SIZE             0x20000UL
+#define RSC_PHYS                0x18220000UL
+#define RSC_SIZE                0x10000UL
+#define DDR_TCS                 1
+#define TCS(reg)                (rsc + 0xd00 + 672 * DDR_TCS + (reg))
+#define BCM_COMMIT              (1u << 30)
+#define BCM_VALID               (1u << 29)
+#define BCM_VOTE(ab, ib)        (BCM_COMMIT | BCM_VALID | ((uint32_t)(ab) & 0x3fff) << 14 | ((uint32_t)(ib) & 0x3fff))
+#define BCM_ACV_APPS            8
+#define DDR_TOP                 0x3fff
+
+struct cmd_db_slave {
+	uint16_t id, header_offset, data_offset, count, version, reserved[3];
+};
+struct cmd_db_header {
+	uint32_t version;
+	uint8_t magic[4];
+	struct cmd_db_slave slave[8];
+	uint32_t checksum, reserved;
+	uint8_t data[];
+};
+struct cmd_db_entry {
+	char id[8];
+	uint32_t priority[2];
+	uint32_t address;
+	uint16_t length, offset;
+};
+
+static uint32_t
+cmd_db_address(const char *name)
+{
+	static const struct cmd_db_header *db;
+	char id[8] = { 0 };
+
+	if (db == NULL) {
+		db = (const struct cmd_db_header *)ml_io_map_unmappable(CMD_DB_PHYS, CMD_DB_SIZE, VM_WIMG_WCOMB);
+	}
+	if (db == NULL || db->magic[0] != 0xdb || db->magic[1] != 0x30 || db->magic[2] != 0x03 || db->magic[3] != 0x0c) {
+		return 0;
+	}
+	strlcpy(id, name, sizeof(id));
+	for (unsigned s = 0; s < 8; s++) {
+		const struct cmd_db_entry *entry = (const struct cmd_db_entry *)(db->data + db->slave[s].header_offset);
+
+		if (db->slave[s].id == 0 || db->slave[s].count > 512) {
+			continue;
+		}
+		for (unsigned i = 0; i < db->slave[s].count; i++) {
+			if (memcmp(entry[i].id, id, sizeof(id)) == 0) {
+				return entry[i].address;
+			}
+		}
+	}
+	return 0;
+}
+
+/* One request through TCS 1, done when every command says completed (hakios.apollo_pcie.c: TCS 1's IRQ bit never sets) */
+static bool
+ddr_vote(uint32_t mc0, uint32_t sh0, uint32_t acv, uint32_t vote)
+{
+	vm_offset_t rsc = ml_io_map(RSC_PHYS, RSC_SIZE);
+	uint32_t address[3] = { mc0, sh0, acv }, data[3] = { BCM_VOTE(vote, vote), BCM_VOTE(vote, vote), BCM_VOTE(0, BCM_ACV_APPS) };
+	uint64_t deadline;
+
+	if (rsc == 0 || *(volatile uint32_t *)TCS(0x18) == 0) {
+		return false;                   /* (busy, or not mapped) */
+	}
+	*(volatile uint32_t *)(rsc + 0xd08) = 1u << DDR_TCS;
+	for (unsigned c = 0; c < 3; c++) {
+		*(volatile uint32_t *)TCS(0x30 + 20 * c) = 0x10008 | 0x100;     /* a 4-byte write, with a response */
+		*(volatile uint32_t *)TCS(0x34 + 20 * c) = address[c];
+		*(volatile uint32_t *)TCS(0x38 + 20 * c) = data[c];
+	}
+	*(volatile uint32_t *)TCS(0x10) = 7;
+	*(volatile uint32_t *)TCS(0x1c) = 7;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	*(volatile uint32_t *)TCS(0x14) &= ~(1u << 24);
+	*(volatile uint32_t *)TCS(0x14) |= 1u << 16;
+	*(volatile uint32_t *)TCS(0x14) |= 1u << 24;
+	clock_interval_to_deadline(100, NSEC_PER_MSEC, &deadline);
+	for (;;) {
+		bool all = true;
+
+		for (unsigned c = 0; c < 3; c++) {
+			all = all && (*(volatile uint32_t *)TCS(0x3c + 20 * c) & (1u << 16));
+		}
+		if (all && *(volatile uint32_t *)TCS(0x18) != 0) {
+			break;
+		}
+		if (mach_absolute_time() > deadline) {
+			*(volatile uint32_t *)TCS(0x14) &= ~((1u << 24) | (1u << 16));
+			*(volatile uint32_t *)TCS(0x1c) = 0;
+			return false;
+		}
+		delay_for_interval(50, NSEC_PER_USEC);
+	}
+	*(volatile uint32_t *)TCS(0x14) &= ~((1u << 24) | (1u << 16));
+	*(volatile uint32_t *)TCS(0x1c) = 0;
+	return true;
+}
+
+/*
+ * A vote for one bus clock manager (BCM) of RPMh by its cmd-db name, for the other apollo drivers (hakios.apollo_haptic.c: the
+ * QUP wrappers' core clocks, the BCM "QUP0" -- it covers wrapper 1, whose serial engine 11 the haptic uses; cmd-db has
+ * no "QUP1" -- which no one but Android's geni-se driver votes for). Through TCS 1 as above;
+ * false if RPMh has no such name or does not take the vote.
+ */
+bool apollo_rpmh_bcm_vote(const char *name, uint32_t ab, uint32_t ib);
+void apollo_cmd_db_dump(void);
+
+/* every name cmd-db has, by its slave (for finding what a resource is called on this phone) */
+void
+apollo_cmd_db_dump(void)
+{
+	const struct cmd_db_header *db;
+	char line[300];
+
+	(void)cmd_db_address("");                       /* (maps it) */
+	db = (const struct cmd_db_header *)ml_io_map_unmappable(CMD_DB_PHYS, CMD_DB_SIZE, VM_WIMG_WCOMB);
+	for (unsigned s = 0; db != NULL && s < 8; s++) {
+		const struct cmd_db_entry *entry = (const struct cmd_db_entry *)(db->data + db->slave[s].header_offset);
+		int at = snprintf(line, sizeof(line), "apollo rpmh: slave %u (id %u, %u names):", s, db->slave[s].id, db->slave[s].count);
+
+		if (db->slave[s].id == 0 || db->slave[s].count > 512) {
+			continue;
+		}
+		for (unsigned i = 0; i < db->slave[s].count; i++) {
+			if (at > (int)sizeof(line) - 24) {
+				say("%s\n", line);
+				at = snprintf(line, sizeof(line), "apollo rpmh: ...");
+			}
+			at += snprintf(line + at, sizeof(line) - (size_t)at, " %.8s=%#x", entry[i].id, entry[i].address);
+		}
+		say("%s\n", line);
+	}
+}
+
+
+static LCK_GRP_DECLARE(apollo_shared_lock_group, "apollo-shared");
+LCK_MTX_DECLARE(apollo_rpmh_tcs1_lock, &apollo_shared_lock_group);
+static LCK_SPIN_DECLARE(gcc_vote_lock, &apollo_shared_lock_group);
+
+void
+apollo_gcc_vote(vm_offset_t vote_register, uint32_t bits)
+{
+	lck_spin_lock(&gcc_vote_lock);
+	*(volatile uint32_t *)vote_register |= bits;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	lck_spin_unlock(&gcc_vote_lock);
+}
+
+static bool rpmh_bcm_vote_locked(vm_offset_t rsc, const char *name, uint32_t ab, uint32_t ib);
+
+bool
+apollo_rpmh_bcm_vote(const char *name, uint32_t ab, uint32_t ib)
+{
+	static vm_offset_t rsc;         /* mapped once: ml_io_map's small submap is not given back */
+	bool done;
+
+	lck_mtx_lock(&apollo_rpmh_tcs1_lock);
+	if (rsc == 0) {
+		rsc = ml_io_map(RSC_PHYS, RSC_SIZE);
+	}
+	done = rsc != 0 && rpmh_bcm_vote_locked(rsc, name, ab, ib);
+	lck_mtx_unlock(&apollo_rpmh_tcs1_lock);
+	return done;
+}
+
+static bool
+rpmh_bcm_vote_locked(vm_offset_t rsc, const char *name, uint32_t ab, uint32_t ib)
+{
+	uint32_t address = cmd_db_address(name);
+	uint64_t deadline;
+
+	if (address == 0 || *(volatile uint32_t *)TCS(0x18) == 0) {
+		return false;
+	}
+	*(volatile uint32_t *)(rsc + 0xd08) = 1u << DDR_TCS;
+	*(volatile uint32_t *)TCS(0x30) = 0x10008 | 0x100;     /* a 4-byte write, with a response */
+	*(volatile uint32_t *)TCS(0x34) = address;
+	*(volatile uint32_t *)TCS(0x38) = BCM_VOTE(ab, ib);
+	*(volatile uint32_t *)TCS(0x10) = 1;
+	*(volatile uint32_t *)TCS(0x1c) = 1;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	*(volatile uint32_t *)TCS(0x14) &= ~(1u << 24);
+	*(volatile uint32_t *)TCS(0x14) |= 1u << 16;
+	*(volatile uint32_t *)TCS(0x14) |= 1u << 24;
+	clock_interval_to_deadline(100, NSEC_PER_MSEC, &deadline);
+	while (!((*(volatile uint32_t *)TCS(0x3c) & (1u << 16)) && *(volatile uint32_t *)TCS(0x18) != 0)) {
+		if (mach_absolute_time() > deadline) {
+			*(volatile uint32_t *)TCS(0x14) &= ~((1u << 24) | (1u << 16));
+			*(volatile uint32_t *)TCS(0x1c) = 0;
+			return false;
+		}
+		delay_for_interval(50, NSEC_PER_USEC);
+	}
+	*(volatile uint32_t *)TCS(0x14) &= ~((1u << 24) | (1u << 16));
+	*(volatile uint32_t *)TCS(0x1c) = 0;
+	return true;
+}
+
+/* MB a second that one core writes, reads and copies, 32 MB at a time (far more than any cache) */
+static void
+memory_speed(const char *when)
+{
+	const vm_size_t size = 32 << 20;
+	uint64_t *buf = kalloc_data(2 * size, Z_WAITOK), t0, t[3], ns[3], sum = 0;
+
+	if (buf == NULL) {
+		return;
+	}
+	t0 = mach_absolute_time();
+	for (vm_size_t i = 0; i < size / 8; i++) {
+		buf[i] = i;
+	}
+	t[0] = mach_absolute_time() - t0;
+	t0 = mach_absolute_time();
+	for (vm_size_t i = 0; i < size / 8; i++) {
+		sum += ((volatile uint64_t *)buf)[i];
+	}
+	t[1] = mach_absolute_time() - t0;
+	t0 = mach_absolute_time();
+	memcpy((uint8_t *)buf + size, buf, size);
+	t[2] = mach_absolute_time() - t0;
+	for (int k = 0; k < 3; k++) {
+		absolutetime_to_nanoseconds(t[k], &ns[k]);
+		ns[k] = ns[k] ? ns[k] : 1;
+	}
+	say("apollo ddr: %s: one core writes %llu MB/s, reads %llu MB/s, copies %llu MB/s%s\n", when,
+	    32000000000ull / ns[0], 32000000000ull / ns[1], 32000000000ull / ns[2], sum == 1 ? "" : "");
+	kfree_data(buf, 2 * size);
+}
+
+static void
+memory_bandwidth(void)
+{
+	uint32_t enabled = 0, mc0, sh0, acv;
+	bool voted;
+
+	if (!PE_parse_boot_argn("apollo_ddr", &enabled, sizeof(enabled)) || !enabled) {
+		return;
+	}
+	mc0 = cmd_db_address("MC0");
+	sh0 = cmd_db_address("SH0");
+	acv = cmd_db_address("ACV");
+	if (mc0 == 0 || sh0 == 0 || acv == 0) {
+		say("apollo ddr: RPMh has no MC0 (%#x), SH0 (%#x) or ACV (%#x): no vote\n", mc0, sh0, acv);
+		return;
+	}
+	memory_speed("as found");
+	lck_mtx_lock(&apollo_rpmh_tcs1_lock);
+	voted = ddr_vote(mc0, sh0, acv, DDR_TOP);
+	lck_mtx_unlock(&apollo_rpmh_tcs1_lock);
+	if (!voted) {
+		say("apollo ddr: RPMh did not take the vote\n");
+		return;
+	}
+	delay_for_interval(20, NSEC_PER_MSEC);
+	say("apollo ddr: the memory's bandwidth voted to the top (MC0 %#x, SH0 %#x, ACV %#x)\n", mc0, sh0, acv);
+	memory_speed("voted to the top");
+}
+
+/* ---- heat (boot-arg apollo_thermal, default 1 with apollo_cpufreq=1) ---------------------------------------------
+ *
+ * Nothing else here lowers the cores' speed, and a phone held at its top speed gets hot. Once a second the SoC's
+ * temperature sensors are read -- the phone's device tree, thermal-zones: tsens@c222000 (its readings at 0xc263000)
+ * sensors 1 to 4 the small cores, 7 to 14 the big ones, 15 the GPU; tsens@c223000 (0xc265000) sensor 3 the memory and
+ * 8 the GPU again -- and the hottest of them decides: from THERMAL_HOT on the big cores' groups go down a row of
+ * their table each second (the small cores too from THERMAL_HOTTER), and under THERMAL_COOL back up a row, never
+ * over the top. Android's own limit for the big cores begins at 75 degrees (cpu-1-N-step, cpufreq-1N-config). The
+ * sensors' status words (tsens v2, as hakios.adreno.c reads its phone's): the reading in the low 12 bits, signed,
+ * in tenths of a degree, and bit 21 when there is one.
+ */
+#define TSENS0_TM_PHYS          0x0c263000UL
+#define TSENS1_TM_PHYS          0x0c265000UL
+#define TSENS_STATUS(n)         (0xa0 + 4 * (n))
+#define TSENS_VALID             (1u << 21)
+#define THERMAL_HOT             700             /* tenths of a degree */
+#define THERMAL_HOTTER          800
+#define THERMAL_COOL            620
+
+static vm_offset_t epss[EPSS_DOMAINS];
+static uint32_t top_row[EPSS_DOMAINS], row_now[EPSS_DOMAINS], row_khz[EPSS_DOMAINS][EPSS_TABLE_ROWS];
+/*
+ * The row the heat allows each group while the display is on: the thermal thread moves it a row a second, whether the
+ * display is on or not, and apollo_cpufreq_screen() goes back to it (never higher). row_now[] and the rows themselves
+ * are set by the thermal thread and by apollo_cpufreq_screen(): set_row_locked() under cpufreq_lock.
+ */
+static uint32_t row_allowed[EPSS_DOMAINS];
+static LCK_SPIN_DECLARE(cpufreq_lock, &apollo_shared_lock_group);
+
+/* a sensor's reading in tenths of a degree, or -2730 if it has none */
+static int32_t
+sensor(vm_offset_t tm, uint32_t n)
+{
+	for (unsigned again = 0; again < 16; again++) {
+		uint32_t status = *(volatile uint32_t *)(tm + TSENS_STATUS(n));
+
+		if (status & TSENS_VALID) {
+			int32_t tenths = (int32_t)(status << 20) >> 20;
+
+			/* (a reading no phone has -- a layout not as believed -- slows nothing down) */
+			return tenths > 1500 || tenths < -400 ? -2730 : tenths;
+		}
+	}
+	return -2730;
+}
+
+static void
+set_row_locked(uint32_t domain, uint32_t row)
+{
+	if (epss[domain] == 0 || row == row_now[domain]) {
+		return;
+	}
+	*(volatile uint32_t *)(epss[domain] + EPSS_PERF_STATE) = row;
+	row_now[domain] = row;
+}
+
+/*
+ * While the display is off (apollo_cpufreq_screen(), from apollo_backlight_power()), every core group runs at its lowest
+ * row: nothing is on the screen to hurry for, and the phone neither drains nor warms. Back on, they go straight to the
+ * rows the heat allows (row_allowed[]: the top ones unless the phone is hot).
+ */
+static volatile bool screen_off;
+
+void
+apollo_cpufreq_screen(bool on)
+{
+	lck_spin_lock(&cpufreq_lock);
+	/*
+	 * Off -> on: the allowed rows at once, not at the thermal thread's next second -- the first frames after the screen
+	 * comes back are drawn (and copied to the panel by the processors) right away, and at the screen-off rows they came
+	 * out torn (25 October). The thermal thread takes over from there (and says so) on its next pass. A repeated "on"
+	 * changes nothing: the rows stay where the heat has put them.
+	 */
+	if (on && screen_off) {
+		for (uint32_t domain = 0; domain < EPSS_DOMAINS; domain++) {
+			set_row_locked(domain, row_allowed[domain]);
+		}
+	}
+	screen_off = !on;
+	lck_spin_unlock(&cpufreq_lock);
+}
+
+static void
+apollo_thermal_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	bool was_off = false;
+
+	static const uint8_t cpu_sensors[] = { 1, 2, 3, 4, 7, 8, 9, 10, 11, 12, 13, 14 };
+	vm_offset_t tm0 = ml_io_map(TSENS0_TM_PHYS, 0x1000), tm1 = ml_io_map(TSENS1_TM_PHYS, 0x1000);
+	int32_t hottest_seen = -2730;
+	bool blind_said = false;
+
+	for (uint32_t tick = 0;; tick++) {
+		int32_t cpu = -2730, gpu = -2730, ddr = -2730, hottest;
+		bool off;
+
+		/* (an unmapped sensor block reads as no sensor: sensor() is not given a 0 base) */
+		for (unsigned i = 0; tm0 != 0 && i < sizeof(cpu_sensors); i++) {
+			int32_t t = sensor(tm0, cpu_sensors[i]);
+
+			cpu = t > cpu ? t : cpu;
+		}
+		if (tm0 != 0) {
+			gpu = sensor(tm0, 15);
+		}
+		if (tm1 != 0) {
+			int32_t t = sensor(tm1, 8);
+
+			gpu = t > gpu ? t : gpu;
+			ddr = sensor(tm1, 3);
+		}
+		hottest = cpu > gpu ? cpu : gpu;
+		hottest = ddr > hottest ? ddr : hottest;
+		hottest_seen = hottest > hottest_seen ? hottest : hottest_seen;
+
+		/*
+		 * The rows the heat allows. No core sensor that reads is no reason to think the cores cool: then every group
+		 * is held at the middle of its table at most (and not raised) until one reads again.
+		 */
+		lck_spin_lock(&cpufreq_lock);
+		if (cpu == -2730) {
+			for (uint32_t domain = 0; domain < EPSS_DOMAINS; domain++) {
+				row_allowed[domain] = row_allowed[domain] > top_row[domain] / 2 ? top_row[domain] / 2 : row_allowed[domain];
+			}
+		} else if (hottest >= THERMAL_HOT) {
+			for (uint32_t domain = 1; domain < EPSS_DOMAINS; domain++) {
+				row_allowed[domain] = row_allowed[domain] > 0 ? row_allowed[domain] - 1 : 0;
+			}
+			if (hottest >= THERMAL_HOTTER) {
+				row_allowed[0] = row_allowed[0] > 0 ? row_allowed[0] - 1 : 0;
+			}
+		} else if (hottest < THERMAL_COOL) {
+			for (uint32_t domain = 0; domain < EPSS_DOMAINS; domain++) {
+				row_allowed[domain] = row_allowed[domain] < top_row[domain] ? row_allowed[domain] + 1 : top_row[domain];
+			}
+		}
+		/* while the display is off the lowest rows stay; on, the allowed ones */
+		off = screen_off;
+		for (uint32_t domain = 0; domain < EPSS_DOMAINS; domain++) {
+			set_row_locked(domain, off ? 0 : row_allowed[domain]);
+		}
+		lck_spin_unlock(&cpufreq_lock);
+		if (off != was_off) {
+			was_off = off;
+			say("apollo thermal: the display is %s: the cores at %u, %u, %u MHz\n", was_off ? "off" : "on",
+			    row_khz[0][row_now[0]] / 1000, row_khz[1][row_now[1]] / 1000, row_khz[2][row_now[2]] / 1000);
+		}
+		if ((cpu == -2730) != blind_said) {
+			blind_said = !blind_said;
+			say("apollo thermal: %s\n", blind_said ? "NO CORE SENSOR READS: the cores held at the middle of their tables" :
+			    "the core sensors read again");
+		}
+		if (tick % 30 == 0) {
+			say("apollo thermal: cores %d.%d, GPU %d.%d, memory %d.%d degrees (hottest so far %d.%d); speeds %u, %u, %u MHz\n",
+			    cpu / 10, cpu % 10 < 0 ? -(cpu % 10) : cpu % 10, gpu / 10, gpu % 10 < 0 ? -(gpu % 10) : gpu % 10,
+			    ddr / 10, ddr % 10 < 0 ? -(ddr % 10) : ddr % 10, hottest_seen / 10, hottest_seen % 10,
+			    row_khz[0][row_now[0]] / 1000, row_khz[1][row_now[1]] / 1000, row_khz[2][row_now[2]] / 1000);
+		}
+		delay_for_interval(1000, NSEC_PER_MSEC);
+	}
+}
+
+/*
+ * The speed core group `domain` (0: cores 0-3, 1: 4-6, 2: 7) runs at now, in MHz, for the hitch tracer (hakios.apollo_hitch.c,
+ * from a timer interrupt: one register read, no lock). As Linux's qcom_cpufreq_get_hw_freq reads EPSS: the domain state's
+ * [7:0] times 19.2 MHz, what the firmware has really set (below the row asked for when it limits the group itself); if that
+ * reads as nothing a core runs at, the row asked for (row_now). 0: not known (apollo_cpufreq is off, or no such group).
+ */
+uint32_t
+apollo_cpufreq_mhz(unsigned domain)
+{
+	uint32_t khz;
+
+	if (domain >= EPSS_DOMAINS || epss[domain] == 0) {
+		return 0;
+	}
+	khz = XO_KHZ * (*(volatile uint32_t *)(epss[domain] + EPSS_DOMAIN_STATE) & 0xff);
+	if (khz < 200000 || khz > 3500000) {
+		khz = row_khz[domain][row_now[domain]];
+	}
+	return khz / 1000;
+}
+
+void
+apollo_cpufreq_init(void)
+{
+	static const char *const group[EPSS_DOMAINS] = { "cores 0-3", "cores 4-6", "core 7" };
+	uint32_t enabled = 0, thermal = 1;
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("apollo_cpufreq", &enabled, sizeof(enabled)) || !enabled) {
+		return;
+	}
+	for (uint32_t domain = 0; domain < EPSS_DOMAINS; domain++) {
+		vm_offset_t base = ml_io_map(EPSS_PHYS + domain * EPSS_DOMAIN_SIZE, EPSS_DOMAIN_SIZE);
+		uint32_t top = 0, top_khz = 0, was;
+
+		if (base == 0) {
+			say("apollo cpufreq: cannot map domain %u\n", domain);
+			continue;
+		}
+		for (uint32_t row = 0; row < EPSS_TABLE_ROWS; row++) {
+			uint32_t entry = *(volatile uint32_t *)(base + EPSS_FREQ_TABLE + 4 * row);
+			uint32_t khz = (entry >> 30) ? XO_KHZ * (entry & 0xff) : ALTERNATE_KHZ;
+
+			if (row > 0 && khz <= top_khz) {
+				break;
+			}
+			top = row;
+			top_khz = khz;
+			row_khz[domain][row] = khz;
+		}
+		epss[domain] = base;
+		top_row[domain] = row_now[domain] = row_allowed[domain] = top;
+		was = *(volatile uint32_t *)(base + EPSS_PERF_STATE);
+		*(volatile uint32_t *)(base + EPSS_PERF_STATE) = top;
+		delay_for_interval(20, NSEC_PER_MSEC);
+		say("apollo cpufreq: %s: row %u -> %u of the table, %u MHz\n", group[domain], was, top, top_khz / 1000);
+	}
+	memory_bandwidth();
+	PE_parse_boot_argn("apollo_thermal", &thermal, sizeof(thermal));
+	if (thermal && kernel_thread_start(apollo_thermal_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_set_thread_name(thread, "apollo thermal");
+		thread_deallocate(thread);
+		say("apollo thermal: the cores slow down from %d degrees, and speed up again under %d\n", THERMAL_HOT / 10,
+		    THERMAL_COOL / 10);
+	}
+}
diff --git a/bsd/dev/hakios.apollo_cs35l41.c b/bsd/dev/hakios.apollo_cs35l41.c
new file mode 100644
index 000000000000..1f987d5254ea
--- /dev/null
+++ b/bsd/dev/hakios.apollo_cs35l41.c
@@ -0,0 +1,1996 @@
+/*
+ * The speaker amplifiers of the Xiaomi Mi 10T (apollo), step 4 of apollo_audio=N (bsd/dev/hakios.apollo_sound.c calls these
+ * as hakios.sound.c calls hakios_speaker_* for its Awinic ones).
+ *
+ * Two Cirrus CS35L41 (revision B2) on I2C: the serial engine 3 of the first QUPv3 wrapper (0x98c000; GPIO 119 SDA and
+ * 120 SCL, function qup3), at 0x40 (the speaker) and 0x42 (the earpiece, Android's "RCV"), both on reset GPIO 114.
+ * They are fed by the tertiary TDM interface: 8 slots of 32 bits, the speaker's channel in slot 1 and the earpiece's
+ * in slot 0 (as Android leaves their registers: .device-local/apollo/audio/NOTES-amps.txt), here at 48 kHz.
+ *
+ * Set up as Linux's cs35l41 driver sets one up (sound/soc/codecs/cs35l41.c, cs35l41-lib.c) for its internal boost:
+ * reset, the OTP boot awaited, the revision B2 errata and the OTP's trims unpacked under the test key, the boost from
+ * the tree's 1 uH / 15 uF / 4 A (what Android leaves: 0x2424, 0x7500, 0x40), the serial port as TDM (DSP_A), clocks
+ * from the SoC, 24-bit samples in 32-bit slots, the PLL from the bit clock (12.288 MHz: REFCLK 0x33), 48 kHz, and the
+ * DAC fed from the serial port's first channel (ASPRX1) -- not through the Cirrus DSP, whose speaker protection
+ * firmware Android runs and this does not. In its place: the analog gain at 12 of Android's 18, the digital volume
+ * muted until hakios.apollo_sound.c asks for a level, and never above what it asks (its default: 20 dB under Android's).
+ *
+ * Boot-arg apollo_amps_dsp=1 or 2 also loads (and with 2 starts) the speaker protection firmware, still without routing the
+ * sound through it: see "the speaker protection firmware" below. Default 0: as before.
+ * Boot-arg apollo_amps=1 the speaker only, 2 the earpiece only, 3 both (default).
+ * I2C through the serial engine as Linux's i2c-qcom-geni.c drives it: FIFO mode, polled, 400 kHz.
+ */
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include <sys/hakios.apollo_input.h>
+#include <sys/systm.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+/* into the loader's log as well (as the other apollo drivers) */
+extern void loader_log_putc(char c);
+
+static int say(const char *format, ...) __printflike(1, 2);
+
+static int
+say(const char *format, ...)
+{
+	char line[300];
+	va_list list;
+
+	va_start(list, format);
+	vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
+	for (const char *c = line; *c != 0; c++) {
+		loader_log_putc(*c);
+	}
+	return printf("%s", line);
+}
+
+static inline uint32_t
+rd(vm_offset_t address)
+{
+	return *(volatile uint32_t *)address;
+}
+
+static inline void
+wr(vm_offset_t address, uint32_t value)
+{
+	*(volatile uint32_t *)address = value;
+}
+
+static void
+sleep_us(uint32_t us)
+{
+	delay_for_interval(us, NSEC_PER_USEC);
+}
+
+static void
+sleep_ms(uint32_t ms)
+{
+	delay_for_interval(ms, NSEC_PER_MSEC);
+}
+
+/* ---- pins (TLMM, north tile: one page per pin) --------------------------------------------------------- */
+
+#define TLMM_NORTH_PHYS         0x0f900000UL
+#define PIN_RESET               114
+#define PIN_SDA                 119
+#define PIN_SCL                 120
+#define FUNCTION_QUP3           1
+
+static vm_offset_t pin_reset, pins_i2c;         /* pin 114's page; 119 and 120's two */
+
+static vm_offset_t
+pin(unsigned n)
+{
+	return n == PIN_RESET ? pin_reset : pins_i2c + 0x1000UL * (n - PIN_SDA);
+}
+
+static void
+pin_out(unsigned n, bool high)
+{
+	wr(pin(n) + 4, high ? 2 : 0);
+	wr(pin(n), (2 / 2 - 1) << 6 | 1u << 9);         /* gpio, no pull, 2 mA, output */
+}
+
+/* ---- clocks (GCC, kona) ------------------------------------------------------------------------------- */
+
+#define GCC_PHYS                0x00100000UL
+#define GCC_SIZE                0x60000UL
+#define GCC_VOTE                0x52008
+#define VOTE_QUP0               ((1u << 6) | (1u << 7) | (1u << 8) | (1u << 9))        /* m_ahb, s_ahb, core, core_2x */
+#define VOTE_QUP0_SE3           (1u << 13)
+#define QUP0_M_AHB_CBCR         0x17004
+#define QUP0_S_AHB_CBCR         0x17008
+#define QUP0_SE3_CBCR           0x1739c
+#define QUP0_SE3_RCG            0x173a0         /* cmd; cfg +4; DFS: +0x14, levels at +0x1c, +0x5c, +0x9c */
+#define CLOCK_OFF               (1u << 31)
+#define CLOCK_HW_CTL            (1u << 1)
+#define XO_HZ                   19200000u
+
+static vm_offset_t gcc;
+
+static uint32_t
+rcg_rate(uint32_t cfg, uint32_t m, uint32_t not_n_minus_m)
+{
+	static const uint32_t parent[8] = { XO_HZ, 600000000, 0, 0, 0, 0, 300000000, 0 };
+	uint64_t hz = parent[cfg >> 8 & 7];
+	uint32_t divider = cfg & 0x1f, mode = cfg >> 12 & 3;
+
+	if (divider) {
+		hz = hz * 2 / (divider + 1);
+	}
+	if (mode) {
+		uint32_t n = (~not_n_minus_m & 0xffff) + (m & 0xffff);
+
+		if (n) {
+			hz = hz * (m & 0xffff) / n;
+		}
+	}
+	return (uint32_t)hz;
+}
+
+/* the serial engine's clock: XO's 19.2 MHz, the rate i2c-qcom-geni.c's table is for; which preset gives it */
+static int
+clocks_on(uint32_t *select)
+{
+	uint32_t s_ahb;
+
+	apollo_gcc_vote(gcc + GCC_VOTE, VOTE_QUP0 | VOTE_QUP0_SE3);    /* (locked: the other drivers vote in the same register) */
+	*select = 0;
+	if (rd(gcc + QUP0_SE3_RCG + 0x14) & 1) {
+		int found = -1;
+
+		for (uint32_t level = 0; level < 8 && found < 0; level++) {
+			if (rcg_rate(rd(gcc + QUP0_SE3_RCG + 0x1c + 4 * level), rd(gcc + QUP0_SE3_RCG + 0x5c + 4 * level),
+			    rd(gcc + QUP0_SE3_RCG + 0x9c + 4 * level)) == XO_HZ) {
+				found = (int)level;
+			}
+		}
+		if (found < 0) {
+			say("apollo cs35l41: serial engine 3 has no 19.2 MHz preset\n");
+			return -1;
+		}
+		*select = (uint32_t)found;
+	} else {
+		wr(gcc + QUP0_SE3_RCG + 4, (rd(gcc + QUP0_SE3_RCG + 4) & ~0x371fu) | 1);
+		wr(gcc + QUP0_SE3_RCG, rd(gcc + QUP0_SE3_RCG) | 1);
+		for (int i = 0; i < 500 && (rd(gcc + QUP0_SE3_RCG) & 1); i++) {
+			sleep_us(10);
+		}
+	}
+	for (int i = 0; i < 1000; i++) {
+		s_ahb = rd(gcc + QUP0_S_AHB_CBCR);
+		s_ahb = (s_ahb & CLOCK_HW_CTL) ? s_ahb & ~CLOCK_OFF : s_ahb;       /* gated by the hardware: idle, not off */
+		if (!((rd(gcc + QUP0_M_AHB_CBCR) | s_ahb | rd(gcc + QUP0_SE3_CBCR)) & CLOCK_OFF)) {
+			return 0;
+		}
+		sleep_us(10);
+	}
+	say("apollo cs35l41: the clocks stay off: %#x %#x %#x\n", rd(gcc + QUP0_M_AHB_CBCR), rd(gcc + QUP0_S_AHB_CBCR),
+	    rd(gcc + QUP0_SE3_CBCR));
+	return -1;
+}
+
+/* ---- I2C through the serial engine (i2c-qcom-geni.c) ------------------------------------------------------- */
+
+#define SE_PHYS                 0x0098c000UL    /* the fourth serial engine of the first QUPv3 wrapper */
+#define SE_SIZE                 0x4000UL
+#define GENI_FORCE_DEFAULT      0x020
+#define GENI_OUTPUT_CTRL        0x024
+#define GENI_CGC_CTRL           0x028
+#define GENI_STATUS             0x040
+#define GENI_SER_M_CLK_CFG      0x048
+#define GENI_IF_DISABLE_RO      0x064
+#define GENI_FW_REVISION_RO     0x068           /* [15:8] protocol: 3 = I2C */
+#define GENI_CLK_SEL            0x07c
+#define GENI_BYTE_GRAN          0x254
+#define GENI_DMA_MODE_EN        0x258
+#define GENI_TX_PACKING_CFG0    0x260
+#define GENI_TX_PACKING_CFG1    0x264
+#define I2C_TX_TRANS_LEN        0x26c
+#define I2C_RX_TRANS_LEN        0x270
+#define I2C_SCL_COUNTERS        0x278
+#define GENI_RX_PACKING_CFG0    0x284
+#define GENI_RX_PACKING_CFG1    0x288
+#define GENI_M_CMD0             0x600
+#define GENI_M_CMD_CTRL         0x604
+#define GENI_M_IRQ_STATUS       0x610
+#define GENI_M_IRQ_EN           0x614
+#define GENI_M_IRQ_CLEAR        0x618
+#define GENI_S_IRQ_CLEAR        0x648
+#define GENI_TX_FIFO            0x700
+#define GENI_RX_FIFO            0x780
+#define GENI_TX_FIFO_STATUS     0x800
+#define GENI_RX_FIFO_STATUS     0x804
+#define GENI_TX_WATERMARK       0x80c
+#define GENI_RX_WATERMARK       0x810
+#define GENI_RX_RFR_WATERMARK   0x814
+#define SE_DMA_TX_IRQ_CLR       0xc44
+#define SE_DMA_RX_IRQ_CLR       0xd44
+#define SE_GSI_EVENT_EN         0xe18
+#define SE_IRQ_EN               0xe1c
+#define SE_HW_PARAM_0           0xe24
+#define SE_DMA_GENERAL_CFG      0xe30
+
+#define I2C_WRITE               1u
+#define I2C_READ                2u
+#define I2C_STOP_STRETCH        (1u << 2)       /* no stop at the end: a repeated start follows */
+#define M_CMD_DONE              (1u << 0)
+#define M_CMD_CANCEL            (1u << 4)
+#define M_CMD_ABORT             (1u << 5)
+#define M_NACK                  (1u << 10)      /* M_GP_IRQ_1: the address or a byte was not acknowledged */
+#define M_ERRORS                ((1u << 1) | (1u << 2) | (1u << 3) | M_NACK | (1u << 11) | (1u << 12) | (1u << 13) | \
+	                         (1u << 24) | (1u << 25) | (1u << 28) | (1u << 29))
+
+static vm_offset_t se;
+static uint32_t fifo_depth;
+
+static const char *
+i2c_init(uint32_t select)
+{
+	if ((rd(se + GENI_FW_REVISION_RO) >> 8 & 0xff) != 3) {
+		return "serial engine 3 has no I2C firmware";
+	}
+	if (rd(se + GENI_IF_DISABLE_RO) & 1) {
+		return "serial engine 3's FIFO interface is disabled";
+	}
+	fifo_depth = rd(se + SE_HW_PARAM_0) >> 16 & 0x3f;
+	if (fifo_depth < 4) {
+		return "serial engine 3 reports no FIFO";
+	}
+	wr(se + SE_GSI_EVENT_EN, 0);
+	wr(se + GENI_M_IRQ_CLEAR, 0xffffffff);
+	wr(se + GENI_S_IRQ_CLEAR, 0xffffffff);
+	wr(se + SE_DMA_TX_IRQ_CLR, 0xffffffff);
+	wr(se + SE_DMA_RX_IRQ_CLR, 0xffffffff);
+	wr(se + GENI_CGC_CTRL, rd(se + GENI_CGC_CTRL) | 0x7f);
+	wr(se + SE_DMA_GENERAL_CFG, rd(se + SE_DMA_GENERAL_CFG) | 0xf);
+	wr(se + GENI_OUTPUT_CTRL, 0x7f);
+	wr(se + GENI_FORCE_DEFAULT, 1);
+	wr(se + GENI_DMA_MODE_EN, rd(se + GENI_DMA_MODE_EN) & ~1u);
+	wr(se + GENI_RX_WATERMARK, fifo_depth - 3);
+	wr(se + GENI_RX_RFR_WATERMARK, fifo_depth - 2);
+	wr(se + GENI_TX_WATERMARK, 0);
+	wr(se + SE_IRQ_EN, rd(se + SE_IRQ_EN) | 0xf);
+	wr(se + GENI_M_IRQ_EN, rd(se + GENI_M_IRQ_EN) | 0x7fc0007f);
+	wr(se + GENI_TX_PACKING_CFG0, 0x0007f8fe);      /* bytes, the first in the low byte of a word (as hakios.apollo_touch.c) */
+	wr(se + GENI_TX_PACKING_CFG1, 0x000ffefe);
+	wr(se + GENI_RX_PACKING_CFG0, 0x0007f8fe);
+	wr(se + GENI_RX_PACKING_CFG1, 0x000ffefe);
+	wr(se + GENI_BYTE_GRAN, 0);
+	/* 400 kHz from 19.2 MHz (i2c-qcom-geni.c's geni_i2c_clk_map): divider 2, high 5, low 12, cycle 24 */
+	wr(se + GENI_CLK_SEL, select & 7);
+	wr(se + GENI_SER_M_CLK_CFG, 2u << 4 | 1);
+	wr(se + I2C_SCL_COUNTERS, 5u << 20 | 12u << 10 | 24u);
+	return NULL;
+}
+
+static void
+i2c_recover(void)
+{
+	wr(se + GENI_M_CMD_CTRL, 1u << 2);
+	for (int i = 0; i < 200 && !(rd(se + GENI_M_IRQ_STATUS) & M_CMD_CANCEL); i++) {
+		sleep_us(50);
+	}
+	if (!(rd(se + GENI_M_IRQ_STATUS) & M_CMD_CANCEL)) {
+		wr(se + GENI_M_CMD_CTRL, 1u << 1);
+		for (int i = 0; i < 200 && !(rd(se + GENI_M_IRQ_STATUS) & M_CMD_ABORT); i++) {
+			sleep_us(50);
+		}
+	}
+	for (int i = 0; i < 64 && (rd(se + GENI_RX_FIFO_STATUS) & 0x01ffffff); i++) {
+		(void)rd(se + GENI_RX_FIFO);
+	}
+	wr(se + GENI_M_IRQ_CLEAR, 0xffffffff);
+}
+
+static unsigned i2c_failures;
+
+/* One transfer: write `length` bytes of `tx`, or read `length` into `rx`; `stop`: a stop at the end */
+static bool
+i2c_xfer(uint8_t address, const uint8_t *tx, uint8_t *rx, uint32_t length, bool stop)
+{
+	uint32_t sent = 0, received = 0, status = 0, i;
+
+	for (i = 0; i < 200 && (rd(se + GENI_STATUS) & 1); i++) {
+		sleep_us(10);
+	}
+	wr(se + GENI_M_IRQ_CLEAR, 0xffffffff);
+	wr(se + (tx != NULL ? I2C_TX_TRANS_LEN : I2C_RX_TRANS_LEN), length);
+	wr(se + GENI_M_CMD0, (tx != NULL ? I2C_WRITE : I2C_READ) << 27 | (uint32_t)address << 9 | (stop ? 0 : I2C_STOP_STRETCH));
+	for (i = 0; i < 4000; i++) {                    /* 20 ms at most: four bytes take 0.1 ms at 400 kHz */
+		while (tx != NULL && sent < length && (rd(se + GENI_TX_FIFO_STATUS) & 0x0fffffff) + 1 < fifo_depth) {
+			uint32_t word = 0;
+
+			for (int j = 0; j < 4 && sent < length; j++, sent++) {
+				word |= (uint32_t)tx[sent] << (8 * j);
+			}
+			wr(se + GENI_TX_FIFO, word);
+		}
+		if (rx != NULL) {
+			uint32_t words = rd(se + GENI_RX_FIFO_STATUS) & 0x01ffffff;
+
+			while (words--) {
+				uint32_t word = rd(se + GENI_RX_FIFO);
+
+				for (int j = 0; j < 4 && received < length; j++) {
+					rx[received++] = (uint8_t)(word >> (8 * j));
+				}
+			}
+		}
+		status = rd(se + GENI_M_IRQ_STATUS);
+		if (status & M_ERRORS) {
+			break;
+		}
+		if ((status & M_CMD_DONE) && (rx == NULL || received == length)) {
+			wr(se + GENI_M_IRQ_CLEAR, status);
+			return true;
+		}
+		sleep_us(5);
+	}
+	if (i2c_failures++ < 8) {
+		say("apollo cs35l41: I2C %s of %u bytes at %#x failed: status %#x%s (sent %u, received %u)\n", tx ? "write" : "read",
+		    length, address, status, (status & M_NACK) ? ", NOT ACKNOWLEDGED" : "", sent, received);
+	}
+	i2c_recover();
+	return false;
+}
+
+/* ---- the amplifiers' registers: 32-bit addresses and values, big-endian --------------------------------------- */
+
+static bool
+reg_read(uint8_t amp, uint32_t reg, uint32_t *value)
+{
+	uint8_t a[4] = { (uint8_t)(reg >> 24), (uint8_t)(reg >> 16), (uint8_t)(reg >> 8), (uint8_t)reg }, v[4];
+
+	if (!i2c_xfer(amp, a, NULL, 4, false) || !i2c_xfer(amp, NULL, v, 4, true)) {
+		return false;
+	}
+	*value = (uint32_t)v[0] << 24 | (uint32_t)v[1] << 16 | (uint32_t)v[2] << 8 | v[3];
+	return true;
+}
+
+static bool
+reg_write(uint8_t amp, uint32_t reg, uint32_t value)
+{
+	uint8_t b[8] = { (uint8_t)(reg >> 24), (uint8_t)(reg >> 16), (uint8_t)(reg >> 8), (uint8_t)reg,
+		         (uint8_t)(value >> 24), (uint8_t)(value >> 16), (uint8_t)(value >> 8), (uint8_t)value };
+
+	return i2c_xfer(amp, b, NULL, 8, true);
+}
+
+static bool
+reg_update(uint8_t amp, uint32_t reg, uint32_t mask, uint32_t value)
+{
+	uint32_t old;
+
+	return reg_read(amp, reg, &old) && reg_write(amp, reg, (old & ~mask) | (value & mask));
+}
