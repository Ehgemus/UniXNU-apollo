+/* One amplifier, after the reset: found, trimmed, set up for the frame, powered down and muted */
+static bool
+amp_setup(unsigned a)
+{
+	uint8_t amp = amps[a].address;
+	uint32_t id = 0, rev = 0, status = 0;
+	int i;
+
+	for (i = 0; i < 100; i++) {
+		if (reg_read(amp, REG_IRQ1_STATUS4, &status) && (status & 0x2)) {
+			break;
+		}
+		sleep_ms(1);
+	}
+	if (i == 100) {
+		say("apollo cs35l41: %s: the OTP boot is not done (%#x)\n", amps[a].name, status);
+		return false;
+	}
+	if (!reg_read(amp, REG_IRQ1_STATUS3, &status) || (status & 0x80000000u)) {
+		say("apollo cs35l41: %s: the OTP boot failed (%#x)\n", amps[a].name, status);
+		return false;
+	}
+	if (!reg_read(amp, REG_DEVID, &id) || !reg_read(amp, REG_REVID, &rev) || (id != 0x35a40 && id != 0x35b40)) {
+		say("apollo cs35l41: %s: not a CS35L41 (id %#x, revision %#x)\n", amps[a].name, id, rev);
+		return false;
+	}
+	/* the errata (revision B0 and B2 alike), the DSP core stopped, the trims: under the test key */
+	if (!test_key(amp, true) ||
+	    !reg_write(amp, REG_VIMON_SPKMON_RESYNC, 0) || !reg_write(amp, 0x00004310, 0) ||
+	    !reg_write(amp, REG_VPVBST_FS_SEL, 0) || !reg_write(amp, REG_BST_DCM_CTRL, 0x51) ||
+	    !reg_write(amp, REG_DSP1_YM_ACCEL_PL0, 0) || !reg_write(amp, REG_DSP1_XM_ACCEL_PL0, 0) ||
+	    !reg_write(amp, REG_PWR_CTRL2, 0) || !reg_write(amp, REG_AMP_GAIN_CTRL, 0) ||
+	    !reg_write(amp, REG_ASP_TX3_SRC, 0) || !reg_write(amp, REG_ASP_TX4_SRC, 0) ||
+	    !reg_write(amp, REG_DSP1_CCM_CORE_CTRL, 0) || !otp_unpack(amp) ||
+	    /* the frame monitor for a bit clock over 6.144 MHz (cs35l41_dai_set_sysclk) */
+	    !reg_write(amp, REG_TST_FS_MON0, 0x10 | 0x24u << 12) || !test_key(amp, false)) {
+		say("apollo cs35l41: %s: the errata and trims could not be written\n", amps[a].name);
+		return false;
+	}
+	/* boost (the tree's 1 uH, 15 uF, 4 A: Android's values), the serial port, the clock, the DAC's source, muted */
+	if (!reg_update(amp, REG_BST_COEFF, 0xffff, 0x2424) || !reg_update(amp, REG_BST_SLOPE_LBST, 0xff03, 0x7500) ||
+	    !reg_update(amp, REG_BST_PEAK_CUR, 0x7f, 0x40) || !reg_update(amp, REG_PWR_CTRL2, 0x30, 0x20) ||
+	    !reg_update(amp, REG_SP_HIZ_CTRL, 0x3, 0x3) ||
+	    !reg_write(amp, REG_SP_FORMAT, 0x20200000) ||              /* 32-bit slots both ways, DSP_A, clocks from the SoC */
+	    !reg_update(amp, REG_SP_RX_WL, 0x3f, 24) || !reg_update(amp, REG_SP_TX_WL, 0x3f, 24) ||
+	    !reg_update(amp, REG_SP_FRAME_RX_SLOT, 0x3f, amps[a].slot) ||
+	    !reg_update(amp, REG_GLOBAL_CLK_CTRL, 0x1f, 0x03) ||
+	    /* the PLL from the bit clock, 12.288 MHz (cs35l41_set_sysclk's order) */
+	    !reg_update(amp, REG_PLL_CLK_CTRL, 1u << 11, 1u << 11) ||
+	    !reg_update(amp, REG_PLL_CLK_CTRL, 0x3f << 5, 0x33u << 5) ||
+	    !reg_update(amp, REG_PLL_CLK_CTRL, 1u << 4, 0) ||
+	    !reg_update(amp, REG_PLL_CLK_CTRL, 0x7, 0) ||
+	    !reg_update(amp, REG_PLL_CLK_CTRL, 1u << 11, 0) ||
+	    !reg_update(amp, REG_PLL_CLK_CTRL, 1u << 4, 1u << 4) ||
+	    !reg_update(amp, REG_DAC_PCM1_SRC, 0x7f, 0x08) ||
+	    !reg_update(amp, REG_AMP_DIG_VOL_CTRL, 0x7ffu << 3, VOL_MUTE << 3) ||
+	    !reg_update(amp, REG_AMP_GAIN_CTRL, 0x1f << 5, GAIN << 5)) {
+		say("apollo cs35l41: %s: could not be set up\n", amps[a].name);
+		return false;
+	}
+	say("apollo cs35l41: %s: CS35L41 %#x revision %#x, set up: TDM slot %u of 8, 24 bits at 48 kHz, the PLL from the bit "
+	    "clock, gain %u, muted, powered down\n", amps[a].name, id, rev, amps[a].slot, GAIN);
+	return true;
+}
+
+/* ---- the speaker protection firmware (boot-arg apollo_amps_dsp=N) --------------------------------------------------
+ *
+ * Android runs cs35l41-dsp1-spk-prot-revb2.wmfw (the HALO core's program and its initial data) and a tuning file per
+ * amplifier (.bin: -revb2.bin for the speaker, -RCV-revb2.bin for the earpiece) through Linux's cs_dsp
+ * (drivers/firmware/cirrus/cs_dsp.c: cs_dsp_load, cs_dsp_halo_setup_algs, cs_dsp_load_coeff, cs_dsp_run). Done here the
+ * same way; verified against Android's load log (.device-local/apollo/android-wifi/dmesg-boot.txt, "DSP1:" lines of 1-0040):
+ * every block's address, the algorithm's "ID cd v29.33.0 XM@94 YM@e", "Writing 4044 bytes at 2c0015c", "Writing 8 bytes at 34016e0".
+ *
+ *   apollo_amps_dsp=0 (default): nothing of this runs.
+ *   =1 (stages 1 and 2): the three files are parsed and written (the core stopped), then read back and compared;
+ *   =2 (stage 3): the MPU unlocked, the rate slots set, the monitor inputs set, the core started at boot WITHOUT requiring
+ *      its heartbeat (the DSP runs from the PLL, which needs the bit clock: none at boot, run 221026). At each playback start
+ *      (bit clock running, amplifier not yet powered up) the heartbeat is checked, the core restarted once if it does not count;
+ *      after power-up the mailbox gets RESUME (PAUSE at stop). Healthy or not, the audio stays PCM (DAC_PCM1_SRC = ASPRX1).
+ *   =3 (stage 4): as 2, and at the playback start the DAC is fed from the DSP (DAC_PCM1_SRC = DSPTX1, DSP RX1/RX2 = ASPRX1,
+ *      DRE on); at stop the DAC goes back to ASPRX1. Only at the rate the tuning was made for (Android's 96 kHz: AMP_RATE_HZ
+ *      must equal DSP_TUNING_RATE_HZ) and only for an amplifier whose calibration took; otherwise it runs as 2 (said in the log):
+ *      the protection algorithm fed at the wrong rate or with the wrong impedance would protect nothing it claims to.
+ * On any failure (loading, no heartbeat at playback, no RESUME) the cores are stopped and both amplifiers are reset and set up
+ * again as before this existed.
+ *
+ * Memory windows (cs35l41-lib.c cs35l41_dsp1_regions, include/sound/cs35l41.h): XM packed 0x02000000, XM unpacked (24-bit)
+ * 0x02800000, YM packed 0x02c00000, YM unpacked 0x03400000, PM packed 0x03800000. cs_dsp_halo_region_to_reg(): packed XM/YM
+ * at (base + 3 * word) & ~3, PM at base + 5 * word, unpacked at base + 4 * word. The registers' format as everywhere here: a
+ * 32-bit address, then data, the address counting up by the byte (regmap_raw_write), big-endian words.
+ */
+extern const uint8_t *hakios_image_file(const char *dir, const char *name, uint64_t *size, int *disk_out);
+
+/*
+ * Data bytes per I2C transaction (plus the 4 of the address): ~6 ms at 400 kHz, under i2c_xfer()'s 20 ms. A multiple of 12:
+ * the packed memories take three 32-bit registers for four 24-bit DSP words (cs_dsp.c: cs_dsp_halo_region_to_reg, packed
+ * = base + 3 * word), and with 256 the second transaction of the first big XM block -- which began inside such a group --
+ * read back as zeros while the first was right (25 October). 240 = 20 whole groups of XM/YM, 12 of PM.
+ */
+#define DSP_CHUNK               240             /* and of 20: packed PM takes five registers for four 40-bit words (cs_dsp.c:
+	                                         * base + 5 * word); 252 broke the PM block at +2048 (25 October) */
+#define DSP_VERIFY_FULL         8192u           /* blocks up to this size are read back whole, larger ones in windows */
+#define DSP_VERIFY_STRIDE       2040u           /* a multiple of 60, as DSP_CHUNK: windows start on whole packed groups */
+#define DSP_BASE                0x02b80000u     /* cs35l41_configure_cs_dsp: dsp->base = CS35L41_DSP1_CTRL_BASE */
+#define DSP_CORE_SOFT_RESET     (DSP_BASE + 0x00010)
+#define DSP_CORE_CONTROL        (DSP_BASE + 0x41000)    /* HALO_CCM_CORE_CONTROL (= REG_DSP1_CCM_CORE_CTRL) */
+#define DSP_CORE_RESET          0x00000200u
+#define DSP_CORE_EN             0x00000001u
+#define DSP_MPU_LOCK_CONFIG     (DSP_BASE + 0x43140)
+#define DSP_MPU_ACCESS          (DSP_BASE + 0x43000)    /* four groups of 0x18: XMEM, YMEM, WINDOW, XREG, (gap), YREG */
+#define DSP_RX1_RATE            (DSP_BASE + 0x00080)    /* eight, 8 apart; TX1_RATE at +0x280 */
+#define DSP_TX1_RATE            (DSP_BASE + 0x00280)
+#define DSP_MBOX_STATUS         0x00013004u     /* CS35L41_DSP_MBOX_2: CSPL status, 0 RUNNING, 1 PAUSED (cs35l41.h) */
+#define DSP_MBOX_CMD            0x00013020u     /* CS35L41_DSP_VIRT1_MBOX_1: where cs35l41_set_cspl_mbox_cmd() writes the command */
+#define MBOX_CMD_PAUSE          1u              /* enum cs35l41_cspl_mbox_cmd (cs35l41.h): PAUSE 1 (status PAUSED 1), */
+#define MBOX_CMD_RESUME         2u              /* RESUME 2 (status RUNNING 0), SPK_OUT_ENABLE 7 (external boost only) */
+#define REG_DSP1_RX1_SRC        0x00004c40u     /* then RX2 .. RX8, 4 apart */
+#define REG_IRQ1_RAW_STATUS3    0x00010098      /* the live PLL state (IRQ1_STATUS3 latches events: its bit 29 is not the lock) */
+#define REG_IRQ1_STATUS3_PLL    0x00000002u     /* CS35L41_PLL_LOCK in IRQ1_STATUS3 */
+#define SRC_ASPRX1              0x08u
+#define SRC_DSP_TX1             0x32u           /* CS35L41_INPUT_DSP_TX1: DAC_PCM1_SRC "DSP" is 0x32 (cs35l41_pcm_source_values) */
+#define SRC_VPMON               0x28u           /* cs35l41_dsp_init: DSP1RX5 VPMON (internal boost), RX6 VBSTMON, RX7 TEMPMON, RX8 RSVD */
+#define SRC_VBSTMON             0x29u
+#define SRC_TEMPMON             0x3au
+#define SRC_RSVD                0x3bu
+#define PWR_CTRL3_DRE           (1u << 20)      /* "DRE Switch": SOC_DAPM_SINGLE(PWR_CTRL3, 20); Android's PWR_CTRL3 0x01101000 has it set */
+#define REG_PWR_CTRL3           0x0000201c
+/* What Android leaves while music plays (.device-local/apollo/audio/amps-playing-table.txt), applied at apollo_amps_dsp >= 3.
+ * Bit names from include/sound/cs35l41.h and cs35l41.c's DAPM widgets. */
+#define REG_CTRL_OVRRIDE        0x00002020u     /* CS35L41_CTRL_OVRRIDE: Android 0x2 (no field names upstream) */
+#define PWR_CTRL2_MONITORS      0x00003700u     /* VPMON bit 8, VBSTMON 9, TEMPMON 10, VMON 12, IMON 13 (the "VMON".."TEMPMON" supplies);
+	                                         * Android's 0x3721 = these + BST_EN 2 (bits 5:4, set at setup) + AMP_EN (bit 0, set at power-up) */
+#define PWR_CTRL3_ANDROID       0x01101010u     /* bit 4 CLASSH_EN ("CLASS H" ADC), bit 20 DRE, bit 24 (default 0x01000010 has it), bit 12 (not
+	                                         * named upstream) */
+#define REG_BSTCVRT_VCTRL1      0x00003800u     /* Android 0 */
+#define REG_BSTCVRT_VCTRL2      0x00003804u     /* BST_CTL_SEL: 0 register (VCTRL1), 1 Class-H tracking, 2 MDSYNC (cs35l41.h CS35L41_BST_CTL_SEL_*); Android 1 */
+#define REG_BSTCVRT_SFT_RAMP    0x0000380cu     /* Android 3 */
+#define REG_BSTCVRT_SW_FREQ     0x00003818u     /* Android 0x01008000 */
+#define REG_BSTCVRT_DCM_FORCE   0x00003820u     /* Android 0 */
+#define REG_ASP_TX1_SRC         0x00004c20u
+#define REG_ASP_TX2_SRC         0x00004c24u
+#define SP_EN_RX2               (1u << 17)      /* ASP_RX2_EN */
+#define SP_EN_TX1               (1u << 0)
+#define SP_EN_TX2               (1u << 1)
+#define SRC_ASPRX2              0x09u
+#define SRC_VMON                0x18u
+#define SRC_IMON                0x19u
+#define SRC_CLASSH              0x21u           /* Android's DSP RX6 (Linux's cs35l41_dsp_init writes VBSTMON there) */
+#define AMP_DIG_VOL_RAMP_MASK   0x7u            /* AMP_DIG_VOL_CTRL [2:0] volume ramp; Android 4 */
+#define AMP_DIG_VOL_RAMP        4u
+#define CAL_R_ADDR              0x0280026cu     /* CSPL "CAL_R", "CAL_STATUS", "CAL_CHECKSUM" (XM unpacked, as Android's dump has them) */
+#define CAL_STATUS_ADDR         0x02800274u
+#define CAL_CHECKSUM_ADDR       0x02800278u
+#define DSP_XM_UNPACKED         0x02800000u
+#define DSP_YM_UNPACKED         0x03400000u
+#define DSP_XM_PACKED           0x02000000u
+#define DSP_YM_PACKED           0x02c00000u
+#define DSP_PM_PACKED           0x03800000u
+#define AMP_RATE_HZ             48000u          /* what this runs the amplifiers at (GLOBAL_FS 3) */
+#define DSP_TUNING_RATE_HZ      96000u          /* what the .bin tuning is for: Android's rate (GLOBAL_FS 4) */
+#define FW_ID_HALO_CSPL         0x400a4u        /* the firmware's own id (XM header) */
+#define ALG_ID_CSPL             0xcdu           /* the speaker protection algorithm */
+#define ALG_CSPL_XM_BASE        0x94u           /* what Android's log shows for it: "XM@94 YM@e" */
+#define ALG_CSPL_YM_BASE        0x0eu
+#define DSP_MAX_ALGS            4
+
+#define WMFW_PM_PACKED          0x10u
+#define WMFW_XM_PACKED          0x11u
+#define WMFW_YM_PACKED          0x12u
+#define WMFW_XM_UNPACKED        0x05u           /* WMFW_ADSP2_XM */
+#define WMFW_YM_UNPACKED        0x06u           /* WMFW_ADSP2_YM */
+#define WMFW_ALGORITHM_DATA     0xf2u
+#define WMFW_INFO_TEXT          0xffu
+#define WMFW_NAME_TEXT          0xfeu
+
+struct dsp_info {                               /* the XM header the firmware leaves in the DSP (wmfw_halo_id_hdr) */
+	uint32_t fw_id, fw_ver, vendor, xm_base, ym_base, n_algs;
+	struct {
+		uint32_t id, ver, xm_base, ym_base;
+	} alg[DSP_MAX_ALGS];
+};
+
+static uint32_t dsp_level;                      /* apollo_amps_dsp */
+static struct dsp_info dsp_info[2];
+/* The firmware's controls (from the .wmfw's algorithm data), kept for the playback start; valid = loaded and the core started */
+static struct {
+	bool valid, routed, feedback, calibrated;
+	uint32_t cal_r, cal_status, cal_checksum;
+	uint32_t halo_state, heartbeat, enable, command, state, errorno, temperature;
+} dsp_ctl[2];
+
+static inline uint32_t
+le32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+static inline uint32_t
+le16(const uint8_t *p)
+{
+	return (uint32_t)p[0] | (uint32_t)p[1] << 8;
+}
+
+static inline uint32_t
+be32(const uint8_t *p)
+{
+	return (uint32_t)p[0] << 24 | (uint32_t)p[1] << 16 | (uint32_t)p[2] << 8 | p[3];
+}
+
+static uint64_t
+now_ms(void)
+{
+	uint64_t abs = mach_absolute_time(), ns;
+
+	absolutetime_to_nanoseconds(abs, &ns);
+	return ns / 1000000;
+}
+
+/* `len` bytes at the register `reg`, in transactions of up to DSP_CHUNK bytes (the address counts up by itself) */
+static bool
+dsp_write(uint8_t amp, uint32_t reg, const uint8_t *data, uint32_t len)
+{
+	uint8_t b[4 + DSP_CHUNK];
+
+	if ((reg & 3) != 0 || (len & 3) != 0) {
+		say("apollo cs35l41: %#x: the write of %u bytes at %#x is not word aligned\n", amp, len, reg);
+		return false;
+	}
+	while (len > 0) {
+		uint32_t n = len < DSP_CHUNK ? len : DSP_CHUNK;
+
+		b[0] = (uint8_t)(reg >> 24), b[1] = (uint8_t)(reg >> 16), b[2] = (uint8_t)(reg >> 8), b[3] = (uint8_t)reg;
+		memcpy(b + 4, data, n);
+		if (!i2c_xfer(amp, b, NULL, 4 + n, true)) {
+			say("apollo cs35l41: %#x: the write of %u bytes at %#x failed\n", amp, n, reg);
+			return false;
+		}
+		reg += n, data += n, len -= n;
+	}
+	return true;
+}
+
+static bool
+dsp_read(uint8_t amp, uint32_t reg, uint8_t *out, uint32_t len)
+{
+	while (len > 0) {
+		uint32_t n = len < DSP_CHUNK ? len : DSP_CHUNK;
+		uint8_t a[4] = { (uint8_t)(reg >> 24), (uint8_t)(reg >> 16), (uint8_t)(reg >> 8), (uint8_t)reg };
+
+		if (!i2c_xfer(amp, a, NULL, 4, false) || !i2c_xfer(amp, NULL, out, n, true)) {
+			return false;
+		}
+		reg += n, out += n, len -= n;
+	}
+	return true;
+}
+
+static uint32_t dsp_bytes_checked;
+
+static bool
+dsp_verify_window(uint8_t amp, uint32_t reg, const uint8_t *data, uint32_t len, uint32_t off, const char *what)
+{
+	uint8_t back[DSP_CHUNK];
+	uint32_t n = len - off < DSP_CHUNK ? len - off : DSP_CHUNK, i = 0;
+
+	if (!dsp_read(amp, reg + off, back, n)) {
+		say("apollo cs35l41: %#x: %s: the readback of %u bytes at %#x failed\n", amp, what, n, reg + off);
+		return false;
+	}
+	if (memcmp(back, data + off, n) != 0) {
+		while (back[i] == data[off + i]) {
+			i++;
+		}
+		uint32_t bad = 0, w0 = 0, wl = 0, k;
+		uint8_t again[DSP_CHUNK];
+		bool ok;
+
+		for (k = 0; k < n; k++) {
+			bad += back[k] != data[off + k];
+		}
+		say("apollo cs35l41: %#x: %s: READBACK MISMATCH at %#x (+%u of the block's %u): wrote %02x, read %02x (%u of the window's %u bytes differ, I2C failures so far %u)\n",
+		    amp, what, reg + off + i, off + i, len, data[off + i], back[i], bad, n, i2c_failures);
+		/* diagnosis: re-read the window's first and last word, then write it again one word per transaction */
+		ok = reg_read(amp, reg + off, &w0) && reg_read(amp, reg + off + n - 4, &wl);
+		say("apollo cs35l41: %#x: re-read: first word %#x (wanted %#x), last word %#x (wanted %#x)%s\n", amp, w0, be32(data + off), wl,
+		    be32(data + off + n - 4), ok ? "" : " (a read failed)");
+		for (k = 0; k < n; k += 4) {
+			uint8_t one[8] = { (uint8_t)((reg + off + k) >> 24), (uint8_t)((reg + off + k) >> 16), (uint8_t)((reg + off + k) >> 8),
+				           (uint8_t)(reg + off + k), data[off + k], data[off + k + 1], data[off + k + 2], data[off + k + 3] };
+
+			if (!i2c_xfer(amp, one, NULL, 8, true)) {
+				say("apollo cs35l41: %#x: the word-by-word rewrite failed at %#x\n", amp, reg + off + k);
+				return false;
+			}
+		}
+		if (!dsp_read(amp, reg + off, again, n)) {
+			say("apollo cs35l41: %#x: the readback after the word-by-word rewrite failed\n", amp);
+			return false;
+		}
+		if (memcmp(again, data + off, n) != 0) {
+			for (k = 0; again[k] == data[off + k]; k++) {
+			}
+			say("apollo cs35l41: %#x: still wrong after word-by-word writes (+%u: read %02x): the region is not writable\n", amp,
+			    off + k, again[k]);
+			return false;
+		}
+		say("apollo cs35l41: %#x: word-by-word writes of the window took: the burst write failed, not the region (continuing)\n", amp);
+	}
+	dsp_bytes_checked += n;
+	return true;
+}
+
+/* Read back what was just written and compare it: all of a block up to DSP_VERIFY_FULL, of a larger one a window of
+ * DSP_CHUNK bytes every DSP_VERIFY_STRIDE and the last window */
+static bool
+dsp_verify(uint8_t amp, uint32_t reg, const uint8_t *data, uint32_t len, const char *what)
+{
+	uint32_t stride = len <= DSP_VERIFY_FULL ? DSP_CHUNK : DSP_VERIFY_STRIDE, off;
+
+	for (off = 0; off < len; off += stride) {
+		if (!dsp_verify_window(amp, reg, data, len, off, what)) {
+			return false;
+		}
+	}
+	if (len > DSP_CHUNK && (off - stride) + DSP_CHUNK < len) {                  /* the tail: the last window ends at the end */
+		/*
+		 * ...from a start on a whole packed group (60 bytes: 12 for XM/YM, 20 for PM): reads that begin inside a group
+		 * came back as zeros where the writes were right (the PM block at +2048, 25 October)
+		 */
+		return dsp_verify_window(amp, reg, data, len, (len - DSP_CHUNK) / 60 * 60, what);
+	}
+	return true;
+}
+
+/* The register of word `words` of a memory type of the file formats (cs_dsp_halo_region_to_reg) */
+static bool
+dsp_region_reg(uint32_t type, uint32_t words, uint32_t *reg)
+{
+	switch (type) {
+	case WMFW_XM_PACKED:
+		*reg = (DSP_XM_PACKED + words * 3) & ~3u;
+		return true;
+	case WMFW_YM_PACKED:
+		*reg = (DSP_YM_PACKED + words * 3) & ~3u;
+		return true;
+	case WMFW_PM_PACKED:
+		*reg = DSP_PM_PACKED + words * 5;
+		return true;
+	case WMFW_XM_UNPACKED:
+		*reg = DSP_XM_UNPACKED + words * 4;
+		return true;
+	case WMFW_YM_UNPACKED:
+		*reg = DSP_YM_UNPACKED + words * 4;
+		return true;
+	}
+	return false;
+}
+
+static const char *
+dsp_region_name(uint32_t type)
+{
+	switch (type) {
+	case WMFW_XM_PACKED: return "XM_PACKED";
+	case WMFW_YM_PACKED: return "YM_PACKED";
+	case WMFW_PM_PACKED: return "PM_PACKED";
+	case WMFW_XM_UNPACKED: return "XM";
+	case WMFW_YM_UNPACKED: return "YM";
+	}
+	return "?";
+}
+
+/* The .wmfw (format 3, HALO): the 40-byte header, then blocks of { type << 24 | offset (words), length, data } with no
+ * padding between them (cs_dsp_load). Memory blocks are written; the information text and the algorithm data (the
+ * controls' names, read by dsp_control()) are not. */
+static bool
+wmfw_load(uint8_t amp, const uint8_t *fw, uint64_t size, uint32_t *blocks, uint32_t *bytes)
+{
+	uint64_t pos;
+
+	if (size < 40 || memcmp(fw, "WMFW", 4) != 0 || fw[11] != 3 || fw[10] != 4) {
+		say("apollo cs35l41: the .wmfw is not a format 3 file for a HALO core\n");
+		return false;
+	}
+	pos = le32(fw + 4);                             /* header length: 40 */
+	while (pos + 8 <= size) {
+		uint32_t word = le32(fw + pos), len = le32(fw + pos + 4), type = word >> 24, offset = word & 0xffffff, reg = 0;
+
+		if (len > size - pos - 8) {
+			say("apollo cs35l41: the .wmfw's block at %llu overflows the file\n", pos);
+			return false;
+		}
+		if (type == WMFW_INFO_TEXT || type == WMFW_NAME_TEXT || type == WMFW_ALGORITHM_DATA) {
+			pos += 8 + len;
+			continue;
+		}
+		if (!dsp_region_reg(type, offset, &reg)) {
+			say("apollo cs35l41: the .wmfw's block at %llu has the unknown type %#x\n", pos, type);
+			return false;
+		}
+		if (!dsp_write(amp, reg, fw + pos + 8, len) || !dsp_verify(amp, reg, fw + pos + 8, len, dsp_region_name(type))) {
+			return false;
+		}
+		(*blocks)++;
+		*bytes += len;
+		pos += 8 + len;
+	}
+	return pos == size;
+}
+
+/* A string field of the algorithm data: a length of `width` bytes, the characters, padded to 4 (cs_dsp_coeff_parse_string) */
+static bool
+alg_string(const uint8_t *b, uint32_t length, uint32_t *pos, unsigned width, const uint8_t **text, uint32_t *n)
+{
+	uint32_t l, total;
+
+	if (length - *pos < 4) {
+		return false;
+	}
+	l = width == 1 ? b[*pos] : le16(b + *pos);
+	total = (l + width + 3) & ~3u;
+	if (total > length - *pos) {
+		return false;
+	}
+	if (text != NULL) {
+		*text = b + *pos + width;
+	}
+	if (n != NULL) {
+		*n = l;
+	}
+	*pos += total;
+	return true;
+}
+
+/* The register of the control `name` of algorithm `alg` (an 0xf2 block: id, name, description, count, then per control
+ * { u16 offset, u16 memory type, u32 size of the rest } name, description strings, ctl type, flags, length), given where the
+ * firmware put the algorithm (`info`). cs_dsp_parse_coeff and cs_dsp_coeff_base_reg: the algorithm's base plus the offset, in
+ * the unpacked memory */
+static bool
+dsp_control(const uint8_t *fw, uint64_t size, const struct dsp_info *info, uint32_t alg, const char *name, uint32_t *reg)
+{
+	uint64_t pos = le32(fw + 4);
+	uint32_t xm = 0, ym = 0;
+	bool known = false;
+
+	if (info->fw_id == alg) {
+		xm = info->xm_base, ym = info->ym_base, known = true;
+	}
+	for (uint32_t i = 0; i < info->n_algs && i < DSP_MAX_ALGS; i++) {
+		if (info->alg[i].id == alg) {
+			xm = info->alg[i].xm_base, ym = info->alg[i].ym_base, known = true;
+		}
+	}
+	if (!known) {
+		return false;
+	}
+	while (pos + 8 <= size) {
+		uint32_t word = le32(fw + pos), len = le32(fw + pos + 4), p = 0, count;
+		const uint8_t *b = fw + pos + 8;
+
+		if (len > size - pos - 8) {
+			return false;
+		}
+		pos += 8 + len;
+		if ((word >> 24) != WMFW_ALGORITHM_DATA || len < 8 || le32(b) != alg) {
+			continue;
+		}
+		p = 4;
+		if (!alg_string(b, len, &p, 1, NULL, NULL) || !alg_string(b, len, &p, 2, NULL, NULL) || len - p < 4) {
+			return false;
+		}
+		count = le32(b + p);
+		p += 4;
+		for (uint32_t i = 0; i < count; i++) {
+			uint32_t offset, type, rest, q, n = 0, end;
+			const uint8_t *text = NULL;
+
+			if (len - p < 8) {
+				return false;
+			}
+			offset = le16(b + p), type = le16(b + p + 2), rest = le32(b + p + 4);
+			if (rest > len - p - 8) {
+				return false;
+			}
+			end = p + 8 + rest;
+			q = p + 8;
+			if (!alg_string(b, len, &q, 1, &text, &n) || !alg_string(b, len, &q, 1, NULL, NULL) ||
+			    !alg_string(b, len, &q, 2, NULL, NULL)) {
+				return false;
+			}
+			if (strlen(name) == n && memcmp(text, name, n) == 0) {
+				if (type == WMFW_XM_UNPACKED) {
+					*reg = DSP_XM_UNPACKED + (xm + offset) * 4;
+				} else if (type == WMFW_YM_UNPACKED) {
+					*reg = DSP_YM_UNPACKED + (ym + offset) * 4;
+				} else {
+					return false;
+				}
+				return true;
+			}
+			p = end;
+		}
+	}
+	return false;
+}
+
+/* The XM header (cs_dsp_halo_setup_algs): 10 words (core id, block rev, vendor, firmware id, version, XM base and size, YM base
+ * and size, algorithm count), then 6 per algorithm (id, version, XM base, XM size, YM base, YM size); read from the DSP's
+ * unpacked XM, so it shows that the packed writes landed */
+static bool
+dsp_header(uint8_t amp, struct dsp_info *info)
+{
+	uint8_t raw[4 * (10 + 6 * DSP_MAX_ALGS)];
+	uint32_t n;
+
+	memset(info, 0, sizeof(*info));
+	if (!dsp_read(amp, DSP_XM_UNPACKED, raw, 40)) {
+		return false;
+	}
+	info->vendor = be32(raw + 8), info->fw_id = be32(raw + 12), info->fw_ver = be32(raw + 16);
+	info->xm_base = be32(raw + 20), info->ym_base = be32(raw + 28), info->n_algs = n = be32(raw + 36);
+	if (n == 0 || n > DSP_MAX_ALGS || !dsp_read(amp, DSP_XM_UNPACKED + 40, raw + 40, 24 * n)) {
+		return false;
+	}
+	for (uint32_t i = 0; i < n; i++) {
+		const uint8_t *e = raw + 40 + 24 * i;
+
+		info->alg[i].id = be32(e), info->alg[i].ver = be32(e + 4), info->alg[i].xm_base = be32(e + 8);
+		info->alg[i].ym_base = be32(e + 16);
+	}
+	return true;
+}
+
+static bool
+dsp_alg_base(const struct dsp_info *info, uint32_t id, uint32_t *xm, uint32_t *ym)
+{
+	if (id == info->fw_id) {
+		*xm = info->xm_base, *ym = info->ym_base;
+		return true;
+	}
+	for (uint32_t i = 0; i < info->n_algs && i < DSP_MAX_ALGS; i++) {
+		if (info->alg[i].id == id) {
+			*xm = info->alg[i].xm_base, *ym = info->alg[i].ym_base;
+			return true;
+		}
+	}
+	return false;
+}
+
+/* The .bin (WMDR, cs_dsp_load_coeff): a header of `len` (at +4), then items of { u16 offset, u16 type, u32 algorithm id, u32
+ * version, u32 offset32, u32 length, data }, each padded to 4. The data of a memory type goes to the algorithm's base in that
+ * memory plus `offset` (bytes): 0x12 YM_PACKED, 0x11 XM_PACKED, 0x06 YM, 0x05 XM. Texts (0xfe00) and metadata (0xfc00) skipped. */
+static bool
+bin_load(uint8_t amp, const struct dsp_info *info, const uint8_t *bin, uint64_t size, uint32_t *items, uint32_t *bytes)
+{
+	uint64_t pos;
+
+	if (size < 16 || memcmp(bin, "WMDR", 4) != 0) {
+		say("apollo cs35l41: the .bin is not a WMDR file\n");
+		return false;
+	}
+	pos = le32(bin + 4);
+	while (pos + 20 <= size) {
+		uint32_t offset = le16(bin + pos), type = le16(bin + pos + 2), id = le32(bin + pos + 4), len = le32(bin + pos + 16);
+		uint32_t xm, ym, base, reg;
+
+		if (len > size - pos - 20) {
+			say("apollo cs35l41: the .bin's item at %llu overflows the file\n", pos);
+			return false;
+		}
+		if (type == 0xfe00 || type == 0xfc00 || type == 0xff00) {
+			pos += (20 + (uint64_t)len + 3) & ~3ull;
+			continue;
+		}
+		if ((type != WMFW_XM_PACKED && type != WMFW_YM_PACKED && type != WMFW_XM_UNPACKED && type != WMFW_YM_UNPACKED) ||
+		    !dsp_alg_base(info, id, &xm, &ym)) {
+			say("apollo cs35l41: the .bin's item at %llu: type %#x for algorithm %#x is not one this knows\n", pos, type, id);
+			return false;
+		}
+		base = (type == WMFW_XM_PACKED || type == WMFW_XM_UNPACKED) ? xm : ym;
+		if (!dsp_region_reg(type, base, &reg)) {
+			return false;
+		}
+		reg += offset;
+		say("apollo cs35l41: %#x: .bin item: %u bytes in %s for algorithm %#x v%u.%u.%u at %#x\n", amp, len, dsp_region_name(type), id,
+		    le32(bin + pos + 8) >> 16 & 0xff, le32(bin + pos + 8) >> 8 & 0xff, le32(bin + pos + 8) & 0xff, reg);
+		if (!dsp_write(amp, reg, bin + pos + 20, len) || !dsp_verify(amp, reg, bin + pos + 20, len, "the .bin")) {
+			return false;
+		}
+		(*items)++;
+		*bytes += len;
+		pos += (20 + (uint64_t)len + 3) & ~3ull;
+	}
+	return true;
+}
+
+static void
+dsp_stop_core(uint8_t amp)
+{
+	reg_update(amp, DSP_CORE_CONTROL, DSP_CORE_EN, 0);              /* cs_dsp_halo_stop_core */
+	reg_update(amp, DSP_CORE_SOFT_RESET, 1, 1);
+}
+
+/* Stages 1 and 2 for one amplifier: the .wmfw and the .bin written (the core stopped), read back, the header checked */
+static bool
+dsp_load(unsigned a, const uint8_t *fw, uint64_t fw_size, const uint8_t *bin, uint64_t bin_size)
+{
+	uint8_t amp = amps[a].address;
+	uint32_t blocks = 0, bytes = 0, items = 0, bin_bytes = 0, xm = 0, ym = 0, reg;
+	struct dsp_info *info = &dsp_info[a];
+	uint64_t start = now_ms(), mid;
+
+	dsp_bytes_checked = 0;
+	if (!reg_write(amp, DSP_CORE_CONTROL, 0) || !wmfw_load(amp, fw, fw_size, &blocks, &bytes)) {
+		return false;
+	}
+	mid = now_ms();
+	if (!dsp_header(amp, info)) {
+		say("apollo cs35l41: %s: the firmware's header cannot be read back from the DSP's XM\n", amps[a].name);
+		return false;
+	}
+	say("apollo cs35l41: %s: firmware %#x vendor %#x v%u.%u.%u, XM@%#x YM@%#x, %u algorithm(s)", amps[a].name, info->fw_id, info->vendor,
+	    info->fw_ver >> 16 & 0xff, info->fw_ver >> 8 & 0xff, info->fw_ver & 0xff, info->xm_base, info->ym_base, info->n_algs);
+	for (uint32_t i = 0; i < info->n_algs && i < DSP_MAX_ALGS; i++) {
+		say(", [%u] ID %x v%u.%u.%u XM@%x YM@%x", i, info->alg[i].id, info->alg[i].ver >> 16 & 0xff, info->alg[i].ver >> 8 & 0xff,
+		    info->alg[i].ver & 0xff, info->alg[i].xm_base, info->alg[i].ym_base);
+	}
+	say("\n");
+	if (info->fw_id != FW_ID_HALO_CSPL || !dsp_alg_base(info, ALG_ID_CSPL, &xm, &ym) || xm != ALG_CSPL_XM_BASE || ym != ALG_CSPL_YM_BASE) {
+		say("apollo cs35l41: %s: NOT the expected firmware (%#x with the algorithm %#x at XM@%#x YM@%#x)\n", amps[a].name,
+		    FW_ID_HALO_CSPL, ALG_ID_CSPL, ALG_CSPL_XM_BASE, ALG_CSPL_YM_BASE);
+		return false;
+	}
+	if (!bin_load(amp, info, bin, bin_size, &items, &bin_bytes)) {
+		return false;
+	}
+	if (!dsp_control(fw, fw_size, info, ALG_ID_CSPL, "CSPL_STATE", &reg) || reg != DSP_XM_UNPACKED + (ALG_CSPL_XM_BASE + 2) * 4) {
+		say("apollo cs35l41: %s: the CSPL_STATE control is not where Android reads it (%#x)\n", amps[a].name, DSP_XM_UNPACKED +
+		    (ALG_CSPL_XM_BASE + 2) * 4);
+		return false;
+	}
+	say("apollo cs35l41: %s: LOADED: .wmfw %u blocks, %u bytes; .bin %u items, %u bytes; %u bytes read back and equal; %llu ms "
+	    "(%llu for the .wmfw)\n", amps[a].name, blocks, bytes, items, bin_bytes, dsp_bytes_checked, now_ms() - start, mid - start);
+	return true;
+}
+
+/* cs_dsp_halo_start_core */
+static bool
+dsp_core_start(uint8_t amp)
+{
+	return reg_update(amp, DSP_CORE_CONTROL, DSP_CORE_RESET | DSP_CORE_EN, DSP_CORE_RESET | DSP_CORE_EN) &&
+	       reg_update(amp, DSP_CORE_CONTROL, DSP_CORE_RESET, 0);
+}
+
+/* The CSPL mailbox (cs35l41_set_cspl_mbox_cmd): the command to VIRT1_MBOX_1, then MBOX_2 read up to 5 times, 1 ms apart, for the
+ * status that command gives (RESUME: RUNNING 0, PAUSE: PAUSED 1; 0xffffffff and 0x00ffffff are errors) */
+static bool
+dsp_mbox(unsigned a, uint32_t cmd, uint32_t want)
+{
+	uint8_t amp = amps[a].address;
+	uint32_t sts = 0xdead;
+
+	if (!reg_write(amp, DSP_MBOX_CMD, cmd)) {
+		return false;
+	}
+	for (int i = 0; i < 5; i++) {
+		sleep_ms(1);
+		if (reg_read(amp, DSP_MBOX_STATUS, &sts)) {
+			if (sts == 0xffffffffu || sts == 0x00ffffffu) {
+				break;
+			}
+			if (sts == want) {
+				return true;
+			}
+		}
+	}
+	say("apollo cs35l41: %s: mailbox command %u: status %#x, wanted %#x\n", amps[a].name, cmd, sts, want);
+	return false;
+}
+
+/* The state of the firmware, for the log */
+static void
+dsp_report(unsigned a, const char *when)
+{
+	uint8_t amp = amps[a].address;
+	uint32_t hs = 0xdead, beat = 0xdead, en = 0xdead, cmd = 0xdead, st = 0xdead, err = 0xdead, temp = 0xdead, mbox = 0xdead;
+	uint32_t pll = 0xdead, pllc = 0xdead, core = 0xdead;
+
+	reg_read(amp, dsp_ctl[a].halo_state, &hs), reg_read(amp, dsp_ctl[a].heartbeat, &beat), reg_read(amp, dsp_ctl[a].enable, &en);
+	reg_read(amp, dsp_ctl[a].command, &cmd), reg_read(amp, dsp_ctl[a].state, &st), reg_read(amp, dsp_ctl[a].errorno, &err);
+	reg_read(amp, dsp_ctl[a].temperature, &temp), reg_read(amp, DSP_MBOX_STATUS, &mbox);
+	reg_read(amp, REG_IRQ1_RAW_STATUS3, &pll), reg_read(amp, REG_PLL_CLK_CTRL, &pllc), reg_read(amp, DSP_CORE_CONTROL, &core);
+	say("apollo cs35l41: %s: DSP %s: HALO_STATE %#x HEARTBEAT %#x | CSPL ENABLE %#x COMMAND %#x STATE %#x ERRORNO %#x TEMPERATURE %#x "
+	    "| mailbox status %#x | core control %#x PLL_CLK_CTRL %#x raw IRQ1_STATUS3 %#x (PLL %s)\n", amps[a].name, when, hs, beat, en, cmd,
+	    st, err, temp, mbox, core, pllc, pll, (pll & REG_IRQ1_STATUS3_PLL) ? "locked" : "NOT locked");
+}
+
+/* apollo_amps_dsp >= 3, before GLOBAL_EN: what Android has set while music plays and the protection algorithm needs: the
+ * voltage/current/temperature monitors on (PWR_CTRL2), the DSP's eight inputs, Class-H tracking boost, the ASP slots the
+ * feedback uses, the ramp. The output is not routed yet (DAC_PCM1_SRC stays ASPRX1 until the firmware is judged). */
+static bool
+dsp_feedback(unsigned a)
+{
+	uint8_t amp = amps[a].address;
+	/* DSP1 RX1..RX8 as Android: ASPRX1, ASPRX1 (speaker) or ASPRX2 (earpiece), VMON, IMON, VPMON, CLASSH, TEMPMON, RSVD */
+	const uint32_t rx[8] = { SRC_ASPRX1, amps[a].rx2_asprx2 ? SRC_ASPRX2 : SRC_ASPRX1, SRC_VMON, SRC_IMON, SRC_VPMON, SRC_CLASSH,
+	                         SRC_TEMPMON, SRC_RSVD };
+
+	for (unsigned i = 0; i < 8; i++) {
+		if (!reg_write(amp, REG_DSP1_RX1_SRC + 4 * i, rx[i])) {
+			return false;
+		}
+	}
+	if (!reg_update(amp, REG_PWR_CTRL2, PWR_CTRL2_MONITORS, PWR_CTRL2_MONITORS) ||
+	    !reg_update(amp, REG_PWR_CTRL3, PWR_CTRL3_ANDROID, PWR_CTRL3_ANDROID) || !reg_write(amp, REG_CTRL_OVRRIDE, 2) ||
+	    !reg_write(amp, REG_BSTCVRT_VCTRL1, 0) || !reg_write(amp, REG_BSTCVRT_SFT_RAMP, 3) ||
+	    !reg_write(amp, REG_BSTCVRT_SW_FREQ, 0x01008000) || !reg_write(amp, REG_BSTCVRT_DCM_FORCE, 0) ||
+	    !reg_write(amp, REG_BSTCVRT_VCTRL2, 1) ||
+	    !reg_update(amp, REG_AMP_DIG_VOL_CTRL, AMP_DIG_VOL_RAMP_MASK, AMP_DIG_VOL_RAMP)) {
+		return false;
+	}
+	/* the DSP's output also on the ASP TX the way Android has it (earpiece TX1, speaker TX2: SP_FRAME_TX_SLOT 0x03020100) and the
+	 * earpiece's second RX slot; SP_ENABLES: speaker 0x00010002, earpiece 0x00030001 (bit 16 is set at power-up) */
+	if (!reg_write(amp, amps[a].rx2_asprx2 ? REG_ASP_TX1_SRC : REG_ASP_TX2_SRC, SRC_DSP_TX1) ||
+	    !reg_update(amp, REG_SP_FRAME_RX_SLOT, 0x3f00, (uint32_t)amps[a].rx2_slot << 8) ||
+	    !reg_update(amp, REG_SP_ENABLES, SP_EN_RX2 | SP_EN_TX1 | SP_EN_TX2,
+	                amps[a].rx2_asprx2 ? SP_EN_RX2 | SP_EN_TX1 : SP_EN_TX2)) {
+		return false;
+	}
+	dsp_ctl[a].feedback = true;
+	say("apollo cs35l41: %s: Android's playing setup: monitors on (PWR_CTRL2 +%#x), PWR_CTRL3 %#x, DSP RX1..8 = ASPRX1/%s/VMON/IMON/VPMON/CLASSH/"
+	    "TEMPMON/RSVD, boost Class-H tracking, ASP TX%u = DSPTX1, ramp %u\n", amps[a].name, PWR_CTRL2_MONITORS, PWR_CTRL3_ANDROID,
+	    amps[a].rx2_asprx2 ? "ASPRX2" : "ASPRX1", amps[a].rx2_asprx2 ? 1 : 2, AMP_DIG_VOL_RAMP);
+	return true;
+}
+
+/* The three calibration words as the DSP memory holds them (24-bit values in 32-bit unpacked XM words), read back */
+static bool
+dsp_cal_read(unsigned a, uint32_t *r, uint32_t *st, uint32_t *sum)
+{
+	uint8_t amp = amps[a].address;
+
+	return reg_read(amp, dsp_ctl[a].cal_r, r) && reg_read(amp, dsp_ctl[a].cal_status, st) &&
+	       reg_read(amp, dsp_ctl[a].cal_checksum, sum);
+}
+
+/* cs_amp_write_cal_coeffs: CAL_R, CAL_STATUS, CAL_CHECKSUM (= CAL_R + CAL_STATUS), each a big-endian 32-bit word at its control's
+ * unpacked-XM address (cs_dsp_coeff_write_ctrl -> regmap_raw_write); written with dsp_write, the path the firmware image took */
+static bool
+dsp_cal_write(unsigned a)
+{
+	uint8_t amp = amps[a].address, w[4];
+	const uint32_t reg[3] = { dsp_ctl[a].cal_r, dsp_ctl[a].cal_status, dsp_ctl[a].cal_checksum };
+	const uint32_t val[3] = { amps[a].cal_r, 1, amps[a].cal_r + 1 };
+
+	for (unsigned i = 0; i < 3; i++) {
+		w[0] = (uint8_t)(val[i] >> 24), w[1] = (uint8_t)(val[i] >> 16), w[2] = (uint8_t)(val[i] >> 8), w[3] = (uint8_t)val[i];
+		if (!dsp_write(amp, reg[i], w, 4)) {
+			return false;
+		}
+	}
+	return true;
+}
+
+/* The speaker's own measured impedance as Android's CSPL has it (CAL_R, CAL_STATUS 1, CAL_CHECKSUM = CAL_R + CAL_STATUS), read
+ * back. Run 232258 read zeros after the plain writes, with the firmware running: so the memory around it is logged first (the words
+ * Android's dump has non-zero at 0x2800250..0x2800278 show whether the firmware's own state reads at all), and a failed readback is
+ * retried with the firmware PAUSED (a running core may own or rewrite these words), then RESUMEd. */
+static bool
+dsp_calibrate(unsigned a)
+{
+	uint8_t amp = amps[a].address, raw[0x30];
+	uint32_t r = 0, st = 0, sum = 0;
+	bool ok;
+
+	if (dsp_ctl[a].cal_r == 0) {
+		return true;
+	}
+	if (dsp_read(amp, DSP_XM_UNPACKED + 0x250, raw, sizeof raw)) {
+		say("apollo cs35l41: %s: XM words 0x250..0x27c before the calibration: %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x\n",
+		    amps[a].name, be32(raw), be32(raw + 4), be32(raw + 8), be32(raw + 12), be32(raw + 16), be32(raw + 20), be32(raw + 24),
+		    be32(raw + 28), be32(raw + 32), be32(raw + 36), be32(raw + 40), be32(raw + 44));
+	}
+	if (!dsp_cal_write(a)) {
+		return false;
+	}
+	sleep_ms(3);
+	if (!dsp_cal_read(a, &r, &st, &sum)) {
+		return false;
+	}
+	say("apollo cs35l41: %s: calibration CAL_R %#x STATUS %#x CHECKSUM %#x (wanted %#x, 1, %#x)\n", amps[a].name, r, st, sum,
+	    amps[a].cal_r, amps[a].cal_r + 1);
+	ok = r == amps[a].cal_r && st == 1 && sum == amps[a].cal_r + 1;
+	if (!ok && dsp_mbox(a, MBOX_CMD_PAUSE, 1)) {
+		bool wrote = dsp_cal_write(a);
+
+		sleep_ms(3);
+		if (wrote && dsp_cal_read(a, &r, &st, &sum)) {
+			say("apollo cs35l41: %s: calibration with the firmware paused: CAL_R %#x STATUS %#x CHECKSUM %#x\n", amps[a].name, r, st, sum);
+			ok = r == amps[a].cal_r && st == 1 && sum == amps[a].cal_r + 1;
+		}
+		if (!dsp_mbox(a, MBOX_CMD_RESUME, 0)) {
+			dsp_report(a, "RESUME after the paused calibration FAILED");
+			return false;
+		}
+		sleep_ms(3);
+		if (dsp_cal_read(a, &r, &st, &sum)) {
+			ok = r == amps[a].cal_r && st == 1 && sum == amps[a].cal_r + 1;
+			say("apollo cs35l41: %s: calibration after RESUME: CAL_R %#x STATUS %#x CHECKSUM %#x (%s)\n", amps[a].name, r, st, sum,
+			    ok ? "kept" : "LOST");
+		}
+	}
+	return ok;
+}
+
+/* Stage 3 for one amplifier: cs_dsp_run (the MPU unlocked, the core started), cs35l41_write_fs_errata (the rate slots), the
+ * DSP's monitor inputs (cs35l41_dsp_init). The core is started here, at boot, without a bit clock: the firmware is NOT awaited
+ * (run 221026: no heartbeat then). Linux starts the core when the playback path powers up (the "DSP1 Preload" widget's POST_PMU
+ * runs wm_adsp_event -> cs_dsp_run) with the PLL running; dsp_playback_check() looks for the heartbeat at the first playback. */
+static bool
+dsp_run(unsigned a, const uint8_t *fw, uint64_t fw_size)
+{
+	uint8_t amp = amps[a].address;
+	const struct dsp_info *info = &dsp_info[a];
+	uint32_t halo_state_reg = 0, heartbeat_reg = 0, enable_reg = 0, command_reg = 0, state_reg = 0, error_reg = 0, temperature_reg = 0;
+	uint32_t v;
+
+	if (!dsp_control(fw, fw_size, info, FW_ID_HALO_CSPL, "HALO_STATE", &halo_state_reg) ||
+	    !dsp_control(fw, fw_size, info, FW_ID_HALO_CSPL, "HALO_HEARTBEAT", &heartbeat_reg) ||
+	    !dsp_control(fw, fw_size, info, ALG_ID_CSPL, "CSPL_ENABLE", &enable_reg) ||
+	    !dsp_control(fw, fw_size, info, ALG_ID_CSPL, "CSPL_COMMAND", &command_reg) ||
+	    !dsp_control(fw, fw_size, info, ALG_ID_CSPL, "CSPL_STATE", &state_reg) ||
+	    !dsp_control(fw, fw_size, info, ALG_ID_CSPL, "CSPL_ERRORNO", &error_reg) ||
+	    !dsp_control(fw, fw_size, info, ALG_ID_CSPL, "CSPL_TEMPERATURE", &temperature_reg)) {
+		say("apollo cs35l41: %s: the firmware's HALO_STATE, HALO_HEARTBEAT or CSPL_* controls are not in the .wmfw\n", amps[a].name);
+		return false;
+	}
+	say("apollo cs35l41: %s: controls (from the .wmfw's algorithm data): HALO_STATE %#x, HALO_HEARTBEAT %#x, CSPL_ENABLE %#x, "
+	    "CSPL_COMMAND %#x, CSPL_STATE %#x, CSPL_ERRORNO %#x, CSPL_TEMPERATURE %#x\n", amps[a].name, halo_state_reg, heartbeat_reg,
+	    enable_reg, command_reg, state_reg, error_reg, temperature_reg);
+	dsp_ctl[a].halo_state = halo_state_reg, dsp_ctl[a].heartbeat = heartbeat_reg, dsp_ctl[a].enable = enable_reg;
+	dsp_ctl[a].command = command_reg, dsp_ctl[a].state = state_reg, dsp_ctl[a].errorno = error_reg;
+	dsp_ctl[a].temperature = temperature_reg;
+
+	/* the calibration controls (apollo_amps_dsp >= 3): by name from the .wmfw, Android's addresses if the names are not there */
+	if (dsp_level >= 3) {
+		uint32_t r = 0, st = 0, sum = 0;
+
+		if (dsp_control(fw, fw_size, info, ALG_ID_CSPL, "CAL_R", &r) && dsp_control(fw, fw_size, info, ALG_ID_CSPL, "CAL_STATUS", &st) &&
+		    dsp_control(fw, fw_size, info, ALG_ID_CSPL, "CAL_CHECKSUM", &sum)) {
+			say("apollo cs35l41: %s: calibration controls from the .wmfw: CAL_R %#x CAL_STATUS %#x CAL_CHECKSUM %#x (Android: %#x %#x %#x)\n",
+			    amps[a].name, r, st, sum, CAL_R_ADDR, CAL_STATUS_ADDR, CAL_CHECKSUM_ADDR);
+		} else {
+			r = CAL_R_ADDR, st = CAL_STATUS_ADDR, sum = CAL_CHECKSUM_ADDR;
+			say("apollo cs35l41: %s: CAL_* not found in the .wmfw: Android's addresses\n", amps[a].name);
+		}
+		dsp_ctl[a].cal_r = r, dsp_ctl[a].cal_status = st, dsp_ctl[a].cal_checksum = sum;
+	}
+
+	/* the calibration with the core still stopped (as Linux writes it before cs_dsp_run), read back, and again after the core has
+	 * run 20 ms: tells whether the memory takes the words and whether the firmware's start clears them */
+	if (dsp_level >= 3 && dsp_ctl[a].cal_r != 0 && dsp_cal_write(a)) {
+		uint32_t cr = 0, cs = 0, ck = 0;
+
+		if (dsp_cal_read(a, &cr, &cs, &ck)) {
+			say("apollo cs35l41: %s: calibration written with the core stopped: CAL_R %#x STATUS %#x CHECKSUM %#x\n", amps[a].name, cr, cs, ck);
+		}
+	}
+	/* cs_dsp_halo_configure_mpu with lock_regions = 0xffffffff (cs35l41_configure_cs_dsp): nothing locked */
+	if (!reg_write(amp, DSP_MPU_LOCK_CONFIG, 0x5555) || !reg_write(amp, DSP_MPU_LOCK_CONFIG, 0xaaaa)) {
+		return false;
+	}
+	for (uint32_t g = 0; g < 4; g++) {
+		static const uint32_t groups[5] = { 0x00, 0x04, 0x08, 0x0c, 0x14 };         /* XMEM, YMEM, WINDOW, XREG, YREG */
+
+		for (uint32_t k = 0; k < 5; k++) {
+			if (!reg_write(amp, DSP_MPU_ACCESS + 0x18 * g + groups[k], 0xffffffffu)) {
+				return false;
+			}
+		}
+	}
+	if (!reg_write(amp, DSP_MPU_LOCK_CONFIG, 0)) {
+		return false;
+	}
+	for (uint32_t s = 0; s < 8; s++) {              /* the slots' rates, 0x1 (cs35l41_fs_errata_patch) */
+		if (!reg_write(amp, DSP_RX1_RATE + 8 * s, 1) || !reg_write(amp, DSP_TX1_RATE + 8 * s, 1)) {
+			return false;
+		}
+	}
+	/* the monitor inputs of cs35l41_dsp_init (not the reset defaults for RX5 and RX6): VPMON, VBSTMON, TEMPMON, reserved */
+	if (!reg_write(amp, REG_DSP1_RX1_SRC + 0x10, SRC_VPMON) || !reg_write(amp, REG_DSP1_RX1_SRC + 0x14, SRC_VBSTMON) ||
+	    !reg_write(amp, REG_DSP1_RX1_SRC + 0x18, SRC_TEMPMON) || !reg_write(amp, REG_DSP1_RX1_SRC + 0x1c, SRC_RSVD)) {
+		return false;
+	}
+	if (!dsp_core_start(amp)) {
+		return false;
+	}
+	sleep_ms(20);
+	dsp_report(a, "core started at boot (no bit clock yet: the heartbeat is not required here)");
+	if (dsp_level >= 3 && dsp_ctl[a].cal_r != 0) {
+		uint32_t cr = 0, cs = 0, ck = 0;
+
+		if (dsp_cal_read(a, &cr, &cs, &ck)) {
+			say("apollo cs35l41: %s: calibration after the core's first 20 ms: CAL_R %#x STATUS %#x CHECKSUM %#x\n", amps[a].name, cr, cs, ck);
+		}
+	}
+	if (reg_read(amp, 0x02bc3104, &v)) {                /* HALO_MPU_XM_VIO_STATUS: a violation would show here */
+		if (v & 0x007e0000u) {
+			say("apollo cs35l41: %s: MPU XM violation status %#x\n", amps[a].name, v);
+		}
+	}
+	dsp_ctl[a].valid = true;
+	dsp_ctl[a].routed = false;
+	say("apollo cs35l41: %s: the firmware is loaded and its core started; it is judged at the first playback\n", amps[a].name);
+	return true;
+}
+
+/* The PLL locked (CS35L41_PLL_LOCK, BIT(1) of IRQ1_STATUS3; the raw register is the live level, the latched one is accepted too).
+ * Up to 500 ms, polled every 5 ms; the time to lock is logged. */
+static bool
+dsp_wait_pll(unsigned a)
+{
+	uint8_t amp = amps[a].address;
+	uint32_t raw = 0, latched = 0;
+	uint64_t start = now_ms();
+
+	for (int i = 0; i < 100; i++) {
+		if (reg_read(amp, REG_IRQ1_RAW_STATUS3, &raw) && (raw & REG_IRQ1_STATUS3_PLL)) {
+			say("apollo cs35l41: %s: PLL locked after %llu ms (raw IRQ1 status 3 %#x)\n", amps[a].name, now_ms() - start, raw);
+			return true;
+		}
+		reg_read(amp, REG_IRQ1_STATUS3, &latched);
+		if (latched & REG_IRQ1_STATUS3_PLL) {
+			say("apollo cs35l41: %s: PLL lock latched after %llu ms (raw %#x, latched %#x)\n", amps[a].name, now_ms() - start, raw,
+			    latched);
+			return true;
+		}
+		sleep_ms(5);
+	}
+	say("apollo cs35l41: %s: PLL NOT locked after %llu ms (raw IRQ1 status 3 %#x, latched %#x)\n", amps[a].name, now_ms() - start,
+	    raw, latched);
+	return false;
+}
+
+/* What the firmware's CSPL_ERRORNO says: neither upstream Linux, the .wmfw nor Cirrus's public files give the codes, so only the
+ * zero is known (no error) */
+static const char *
+dsp_errorno_text(uint32_t err)
+{
+	return err == 0 ? "no error" : "meaning not documented in Linux, the .wmfw or Cirrus's public files";
+}
+
+/* The firmware's check at a playback start, after the amplifier powered up and the PLL locked (Linux: the core runs at POST_PMU,
+ * wm_adsp_event -> cs_dsp_run): the core is stopped and started again (cs_dsp_halo_start_core), and the heartbeat must change
+ * twice within 300 ms. CSPL_STATE and CSPL_ERRORNO are read and logged. */
+static bool
+dsp_playback_check(unsigned a)
+{
+	uint8_t amp = amps[a].address;
+	uint32_t beat = 0, last = 0, beats = 0, state = 0xdead, err = 0xdead;
+
+	/*
+	 * No restart: the core started at boot runs by itself once the PLL locks -- its heartbeat had counted to 0xd (and the
+	 * earpiece's to 0x213) by the time this looked, and the restart is what stopped it (HEARTBEAT 1, CSPL_STATE 1,
+	 * CSPL_ERRORNO 2 after it; 25 October). Linux too starts the core once (cs_dsp_run at POST_PMU) and never again.
+	 */
+	dsp_report(a, "at the playback start, amplifier powered, PLL locked");
+	for (int i = 0; i < 30; i++) {
+		if (!reg_read(amp, dsp_ctl[a].heartbeat, &beat)) {
+			return false;
+		}
+		if (i > 0 && beat != last) {
+			beats++;
+		}
+		last = beat;
+		if (beats >= 2) {
+			break;
+		}
+		sleep_ms(10);
+	}
+	reg_read(amp, dsp_ctl[a].state, &state), reg_read(amp, dsp_ctl[a].errorno, &err);
+	say("apollo cs35l41: %s: CSPL_STATE %#x, CSPL_ERRORNO %#x (%s)\n", amps[a].name, state, err, dsp_errorno_text(err));
+	if (beats >= 2) {
+		say("apollo cs35l41: %s: the firmware's heartbeat counts at the playback start (%u changes, now %#x)\n", amps[a].name, beats,
+		    beat);
+		dsp_report(a, "at the playback start, heartbeat counting");
+		return true;
+	}
+	say("apollo cs35l41: %s: no heartbeat at the playback start (%u changes, %#x)\n", amps[a].name, beats, beat);
+	dsp_report(a, "at the playback start, NO heartbeat");
+	return false;
+}
+
+/* Both amplifiers reset together (they share the line) and set up again, without the firmware */
+static void
+amps_plain_pcm(void)
+{
+	pin_out(PIN_RESET, false);
+	sleep_ms(2);
+	pin_out(PIN_RESET, true);
+	sleep_ms(2);
+	for (unsigned a = 0; a < 2; a++) {
+		amp_ready[a] = amp_used[a] && amp_setup(a);
+	}
+}
+
+/* Cores stopped, both amplifiers reset and set up again as plain PCM, the firmware given up for this run */
+static void
+dsp_failsafe(void)
+{
+	for (unsigned a = 0; a < 2; a++) {
+		if (amp_used[a]) {
+			dsp_stop_core(amps[a].address);
+		}
+		dsp_ctl[a].valid = false;
+		dsp_ctl[a].routed = false;
+	}
+	dsp_level = 0;
+	amps_plain_pcm();
+}
+
+static void
+dsp_stage(void)
+{
+	static const char *const bins[2] = { "cs35l41-dsp1-spk-prot-revb2.bin", "cs35l41-dsp1-spk-prot-RCV-revb2.bin" };
+	uint64_t fw_size = 0, start = now_ms();
+	const uint8_t *fw = hakios_image_file("fw", "cs35l41-dsp1-spk-prot-revb2.wmfw", &fw_size, NULL);     /* (never freed: it can
+	                                                                                                       * point into the image) */
+	bool ok = fw != NULL;
+
+	if (!ok) {
+		say("apollo cs35l41: apollo_amps_dsp=%u: cs35l41-dsp1-spk-prot-revb2.wmfw is not in the image's fw/ (fw-audio-apollo/): plain PCM\n",
+		    dsp_level);
+		return;
+	}
+	for (unsigned a = 0; a < 2 && ok; a++) {
+		uint64_t bin_size = 0;
+		const uint8_t *bin;
+
+		if (!amp_ready[a]) {
+			continue;
+		}
+		bin = hakios_image_file("fw", bins[a], &bin_size, NULL);
+		if (bin == NULL) {
+			say("apollo cs35l41: %s is not in the image's fw/\n", bins[a]);
+			ok = false;
+		} else {
+			ok = dsp_load(a, fw, fw_size, bin, bin_size) && (dsp_level < 2 || dsp_run(a, fw, fw_size));
+		}
+	}
+	if (ok) {
+		say("apollo cs35l41: apollo_amps_dsp=%u: the firmware is loaded%s on every amplifier in use after %llu ms; the audio stays PCM "
+		    "until the first playback judges it\n", dsp_level, dsp_level >= 2 ? " and its core started" : "", now_ms() - start);
+		return;
+	}
+	say("apollo cs35l41: apollo_amps_dsp=%u FAILED: both amplifiers reset and set up as plain PCM\n", dsp_level);
+	dsp_failsafe();
+}
+
+static bool
+map_all(void)
+{
+	if (gcc != 0) {
+		return true;
+	}
+	pin_reset = ml_io_map(TLMM_NORTH_PHYS + 0x1000UL * PIN_RESET, 0x1000);
+	pins_i2c = ml_io_map(TLMM_NORTH_PHYS + 0x1000UL * PIN_SDA, 0x2000);
+	gcc = ml_io_map(GCC_PHYS, GCC_SIZE);
+	se = ml_io_map(SE_PHYS, SE_SIZE);
+	return pin_reset && pins_i2c && gcc && se;
+}
+
+static bool
+amps_prepare(void)
+{
+	uint32_t which = 3, select = 0;
+	const char *problem;
+	bool any = false;
+
+	PE_parse_boot_argn("apollo_amps", &which, sizeof(which));
+	dsp_level = 0;
+	PE_parse_boot_argn("apollo_amps_dsp", &dsp_level, sizeof(dsp_level));
+	if (dsp_level >= 3 && AMP_RATE_HZ != DSP_TUNING_RATE_HZ) {
+		say("apollo cs35l41: apollo_amps_dsp=%u REFUSED: the tuning is for %u Hz and this runs %u Hz; stage 2 instead (the firmware "
+		    "loaded and run, the audio PCM)\n", dsp_level, DSP_TUNING_RATE_HZ, AMP_RATE_HZ);
+		dsp_level = 2;
+	}
+	amp_used[0] = (which & 1) != 0;
+	amp_used[1] = (which & 2) != 0;
+	if (!map_all()) {
+		say("apollo cs35l41: cannot map the registers\n");
+		return false;
+	}
+	if (clocks_on(&select) != 0) {
+		return false;
+	}
+	wr(pin(PIN_SDA), FUNCTION_QUP3 << 2 | (2 / 2 - 1) << 6);
+	wr(pin(PIN_SCL), FUNCTION_QUP3 << 2 | (2 / 2 - 1) << 6);
+	problem = i2c_init(select);
+	if (problem != NULL) {
+		say("apollo cs35l41: %s\n", problem);
+		return false;
+	}
+	memset(dsp_ctl, 0, sizeof(dsp_ctl));
+	/* both out of reset at once: they share the line (cs35l41_probe: low 2 ms, high, 2 ms) */
+	pin_out(PIN_RESET, false);
+	sleep_ms(2);
+	pin_out(PIN_RESET, true);
+	sleep_ms(2);
+	prepared = true;
+	for (unsigned a = 0; a < 2; a++) {
+		amp_ready[a] = amp_used[a] && amp_setup(a);
+		any |= amp_ready[a];
+	}
+	if (any && dsp_level >= 1) {
+		dsp_stage();
+		any = amp_ready[0] || amp_ready[1];
+	}
+	return any;
+}
+
+/* Powered up (the clock runs: hakios.apollo_sound.c has started the port), unmuted only by apollo_cs35l41_volume() */
+static bool
+amps_start(void)
+{
+	bool any = false, dsp_failed = false;
+
+	for (unsigned a = 0; a < 2; a++) {
+		uint8_t amp = amps[a].address;
+		uint32_t status = 0;
+		int i;
+
+		if (!amp_ready[a] || amp_on[a]) {
+			any |= amp_on[a];
+			continue;
+		}
+		if (dsp_level >= 3 && dsp_ctl[a].valid && !dsp_feedback(a)) {
+			say("apollo cs35l41: %s: the feedback setup failed\n", amps[a].name);
+			dsp_failed = true;
+			continue;
+		}
+		if (!reg_update(amp, REG_SP_ENABLES, 1u << 16, 1u << 16) ||
+		    !test_key(amp, true) || !reg_write(amp, REG_PUP_PDN, 0x002f1aa0) || !test_key(amp, false) ||
+		    !reg_update(amp, REG_PWR_CTRL1, 1, 1)) {
+			continue;
+		}
+		for (i = 0; i < 100; i++) {
+			if (reg_read(amp, REG_IRQ1_STATUS1, &status) && (status & PUP_DONE)) {
+				break;
+			}
+			sleep_ms(1);
+		}
+		reg_write(amp, REG_IRQ1_STATUS1, PUP_DONE);
+		if (i == 100 || !reg_update(amp, REG_PWR_CTRL2, 1, 1)) {
+			say("apollo cs35l41: %s: did not power up (status %#x)\n", amps[a].name, status);
+			continue;
+		}
+		amp_on[a] = true;
+		any = true;
+		read_failures[a] = 0;
+		volume_at = 8 * 102;            /* (powered up muted) */
+		say("apollo cs35l41: %s: POWERED UP, muted\n", amps[a].name);
+	}
+	/* The firmware, after the amplifiers powered up (muted) with the bit clock running (Linux's order: the PLL from the clock, the
+	 * core run at POST_PMU, then RESUME): the PLL locked, the core restarted with a counting heartbeat, RESUME answered with
+	 * status 0. Only then the DAC may take the DSP's output (apollo_amps_dsp >= 3). */
+	if (dsp_level >= 3) {
+		say("apollo cs35l41: NOTE the rate: Android runs these amplifiers at 96 kHz (GLOBAL_FS 4, PLL_CLK_CTRL 0x10770, SCLK 24.576 MHz) with "
+		    "the protection firmware; this runs 48 kHz (GLOBAL_FS 3, 12.288 MHz)\n");
+	}
+	for (unsigned a = 0; a < 2 && dsp_level >= 2 && !dsp_failed; a++) {
+		if (!amp_on[a] || !dsp_ctl[a].valid) {
+			continue;
+		}
+		/*
+		 * RESUME before the heartbeat is looked at: the previous playback's end left the firmware PAUSED (mailbox status 1), and
+		 * a paused firmware's heartbeat stands still -- it had counted to 0x16d0 and the check called it dead (25 October).
+		 */
+		if (!dsp_wait_pll(a)) {
+			dsp_failed = true;
+		} else if (!dsp_mbox(a, MBOX_CMD_RESUME, 0)) {      /* cs35l41_dsp_audio_ev POST_PMU (internal boost: no SPK_OUT_ENABLE) */
+			dsp_report(a, "RESUME FAILED");
+			dsp_failed = true;
+		} else if (!dsp_playback_check(a)) {
+			dsp_failed = true;
+		} else if (dsp_level >= 3 && (dsp_ctl[a].cal_r == 0 || !dsp_calibrate(a))) {
+			/*
+			 * Not a failure: written before RESUME the values read back as zeros (25 October), so they are tried with the
+			 * firmware running. But the DAC is not given the firmware's output without them (stage 2 for this amplifier):
+			 * its tuning's default impedance is not this speaker's.
+			 */
+			dsp_ctl[a].calibrated = false;
+			say("apollo cs35l41: %s: the calibration did not take: the audio stays PCM (stage 2), the firmware not routed\n",
+			    amps[a].name);
+		} else {
+			dsp_ctl[a].calibrated = dsp_level >= 3;
+			dsp_report(a, "after RESUME, heartbeat counting");
+		}
+	}
+	for (unsigned a = 0; a < 2 && dsp_level >= 3; a++) {
+		uint8_t amp = amps[a].address;
+
+		if (!amp_on[a] || !dsp_ctl[a].valid || dsp_ctl[a].routed) {
+			continue;
+		}
+		if (AMP_RATE_HZ != DSP_TUNING_RATE_HZ || !dsp_ctl[a].calibrated) {
+			say("apollo cs35l41: %s: NOT routed through the firmware (%s): PCM, as stage 2\n", amps[a].name,
+			    AMP_RATE_HZ != DSP_TUNING_RATE_HZ ? "not at the tuning's rate" : "not calibrated");
+			continue;
+		}
+		/* Android's "speaker" path (mixer_paths_overlay_static.xml): PCM Source DSP, DSP RX1 and RX2 from ASPRX1 (the channel's own
+		 * slot, SP_FRAME_RX_SLOT), the DRE switch on; "Boost Class-H Tracking" and "Class-H Head Room" are Cirrus's Android controls
+		 * whose registers are not in upstream Linux nor in Android's register dump, so they are left as they are. */
+		if (!reg_update(amp, REG_PWR_CTRL3, PWR_CTRL3_DRE, PWR_CTRL3_DRE) || !reg_update(amp, REG_DAC_PCM1_SRC, 0x7f, SRC_DSP_TX1)) {
+			dsp_failed = true;
+			break;
+		}
+		dsp_ctl[a].routed = true;
+		say("apollo cs35l41: %s: DAC_PCM1_SRC = DSPTX1, DSP RX1 and RX2 = ASPRX1, DRE on: the audio goes through the firmware\n",
+		    amps[a].name);
+	}
+	if (dsp_failed) {
+		for (unsigned a = 0; a < 2; a++) {
+			uint32_t s1 = 0xdead, s2 = 0xdead, s3 = 0xdead, s4 = 0xdead;
+
+			if (amp_on[a] && dsp_ctl[a].valid) {
+				reg_read(amps[a].address, REG_IRQ1_STATUS1, &s1), reg_read(amps[a].address, REG_IRQ1_STATUS1 + 4, &s2);
+				reg_read(amps[a].address, REG_IRQ1_STATUS3, &s3), reg_read(amps[a].address, REG_IRQ1_STATUS3 + 4, &s4);
+				say("apollo cs35l41: %s: failure state: IRQ1_STATUS1 %#x STATUS2 %#x STATUS3 %#x STATUS4 %#x\n", amps[a].name, s1, s2, s3, s4);
+				dsp_report(a, "at the failure");
+			}
+		}
+		say("apollo cs35l41: THE FIRMWARE IS NOT HEALTHY (PLL, heartbeat, RESUME or routing): amplifiers powered down, reset, plain PCM\n");
+		amps_stop();
+		dsp_failsafe();
+		return amps_start();                    /* (dsp_level is 0 now: no second pass through this) */
+	}
+	return any;
+}
+
+/* `below` eighths of a dB under Android's level (0 dB of digital volume): stepped there, 6 dB a step, step_ms apart */
+static bool
+amps_volume(uint32_t below, uint32_t step_ms)
+{
+	uint32_t at = volume_at;
+	bool ok = true;
+
+	if (below > 8 * 102) {
+		below = 8 * 102;
+	}
+	while (at != below) {
+		at = at > below ? (at - below > 48 ? at - 48 : below) : (below - at > 48 ? at + 48 : below);
+		for (unsigned a = 0; a < 2; a++) {
+			if (amp_on[a]) {
+				uint32_t vol = at >= 8 * 102 ? VOL_MUTE : ((uint32_t)(-(int32_t)at) & 0x7ff);
+
+				ok &= reg_update(amps[a].address, REG_AMP_DIG_VOL_CTRL, 0x7ffu << 3, vol << 3);
+			}
+		}
+		volume_at = at;
+		if (step_ms) {
+			sleep_ms(step_ms);
+		}
+	}
+	return ok;
+}
+
+/*
+ * No fault reported (an amplifier's short, its temperature, its boost); on one, both are powered down. A status that
+ * cannot be read is not taken for a healthy one: READ_FAILURES_MOST failed reads in a row, and both are powered down too
+ * (a bus that stopped answering would otherwise hide every fault while they play). TEMP_WARN is noted for the monitor.
+ */
+static bool
+amps_healthy(void)
+{
+	for (unsigned a = 0; a < 2; a++) {
+		uint32_t status = 0;
+
+		if (!amp_on[a]) {
+			continue;
+		}
+		if (!reg_read(amps[a].address, REG_IRQ1_STATUS1, &status)) {
+			if (++read_failures[a] >= READ_FAILURES_MOST) {
+				say("apollo cs35l41: %s: ITS STATUS CANNOT BE READ (%u times in a row): both powered down\n", amps[a].name,
+				    read_failures[a]);
+				amps_stop();
+				return false;
+			}
+			continue;
+		}
+		read_failures[a] = 0;
+		if (status & IRQ1_ERRORS) {
+			say("apollo cs35l41: %s REPORTS A FAULT (%#x): both powered down\n", amps[a].name, status);
+			amps_stop();
+			return false;
+		}
+		if ((status & IRQ1_TEMP_WARN) && !temp_warned) {
+			temp_warned = true;
+			say("apollo cs35l41: %s WARNS OF ITS TEMPERATURE (%#x): the level is cut by %u.%03u dB for the rest of the run\n",
+			    amps[a].name, status, TEMP_WARN_CUT / 8, TEMP_WARN_CUT % 8 * 125);
+		}
+	}
+	return true;
+}
+
+/* Muted, powered down (cs35l41_global_enable(0), the power-down patch) */
+static void
+amps_stop(void)
+{
+	for (unsigned a = 0; a < 2; a++) {
+		uint8_t amp = amps[a].address;
+		uint32_t status = 0;
+
+		if (!amp_on[a]) {
+			continue;
+		}
+		reg_update(amp, REG_AMP_DIG_VOL_CTRL, 0x7ffu << 3, VOL_MUTE << 3);
+		if (dsp_ctl[a].valid) {
+			dsp_mbox(a, MBOX_CMD_PAUSE, 1);                 /* cs35l41_dsp_audio_ev PRE_PMD (a failure only logs) */
+		}
+		reg_update(amp, REG_PWR_CTRL2, 1, 0);
+		reg_update(amp, REG_PWR_CTRL1, 1, 0);
+		for (int i = 0; i < 100; i++) {
+			if (reg_read(amp, REG_IRQ1_STATUS1, &status) && (status & PDN_DONE)) {
+				break;
+			}
+			sleep_ms(1);
+		}
+		reg_write(amp, REG_IRQ1_STATUS1, PDN_DONE);
+		test_key(amp, true);
+		reg_write(amp, REG_PUP_PDN, 0x002f1aa3);
+		test_key(amp, false);
+		reg_update(amp, REG_SP_ENABLES, 1u << 16, 0);
+		if (dsp_ctl[a].feedback) {                                  /* the monitors and the extra ASP slots off again */
+			reg_update(amp, REG_SP_ENABLES, SP_EN_RX2 | SP_EN_TX1 | SP_EN_TX2, 0);
+			reg_update(amp, REG_PWR_CTRL2, PWR_CTRL2_MONITORS, 0);
+			dsp_ctl[a].feedback = false;
+		}
+		if (dsp_ctl[a].routed) {                                    /* the DAC back on the ASP: PCM until the next start routes it */
+			reg_update(amp, REG_DAC_PCM1_SRC, 0x7f, SRC_ASPRX1);
+			dsp_ctl[a].routed = false;
+		}
+		amp_on[a] = false;
+		volume_at = 8 * 102;            /* (muted on the way down) */
+		say("apollo cs35l41: %s: powered down\n", amps[a].name);
+	}
+}
+
+/* On a panic's way out: both held in reset at once (no I2C, no sleep) */
+void
+apollo_cs35l41_quiesce(void)
+{
+	if (prepared && pin_reset != 0) {
+		wr(pin_reset + 4, 0);
+	}
+}
+
+/*
+ * The further reduction the guard is to make (eighths of a dB): TEMP_WARN (IRQ1_STATUS1 bit 15, latched, never cleared
+ * here), once either amplifier has shown it, holds the level TEMP_WARN_CUT down for the rest of the run -- Android's
+ * protection firmware would turn it down by itself; this has no measure of how far, so it stays cut. Nothing else yet
+ * (Android's cold-amplifier and battery tables are not carried over).
+ */
+static uint32_t
+amps_monitor(bool tell)
+{
+	for (unsigned a = 0; a < 2 && !temp_warned; a++) {
+		uint32_t status = 0;
+
+		if (amp_on[a] && reg_read(amps[a].address, REG_IRQ1_STATUS1, &status) && (status & IRQ1_TEMP_WARN)) {
+			temp_warned = true;
+			say("apollo cs35l41: %s WARNS OF ITS TEMPERATURE (%#x): the level is cut by %u.%03u dB for the rest of the run\n",
+			    amps[a].name, status, TEMP_WARN_CUT / 8, TEMP_WARN_CUT % 8 * 125);
+		}
+	}
+	if (tell && temp_warned) {
+		say("apollo cs35l41: the temperature warning holds the level %u.%03u dB down\n", TEMP_WARN_CUT / 8, TEMP_WARN_CUT % 8 * 125);
+	}
+	return temp_warned ? TEMP_WARN_CUT : 0;
+}
+
+/* ---- the entry points (hakios.apollo_sound.c): one at a time, under amps_lock ------------------------------------- */
+
+bool
+apollo_cs35l41_prepare(__unused const uint8_t *config, __unused uint64_t size)
+{
+	bool ok;
+
+	lck_mtx_lock(&amps_lock);
+	ok = amps_prepare();
+	lck_mtx_unlock(&amps_lock);
+	return ok;
+}
+
+bool
+apollo_cs35l41_start(void)
+{
+	bool ok;
+
+	lck_mtx_lock(&amps_lock);
+	ok = amps_start();
+	lck_mtx_unlock(&amps_lock);
+	return ok;
+}
+
+bool
+apollo_cs35l41_volume(uint32_t below, uint32_t step_ms)
+{
+	bool ok;
+
+	lck_mtx_lock(&amps_lock);
+	ok = amps_volume(below, step_ms);
+	lck_mtx_unlock(&amps_lock);
+	return ok;
+}
+
+bool
+apollo_cs35l41_healthy(void)
+{
+	bool ok;
+
+	lck_mtx_lock(&amps_lock);
+	ok = amps_healthy();
+	lck_mtx_unlock(&amps_lock);
+	return ok;
+}
+
+void
+apollo_cs35l41_stop(void)
+{
+	lck_mtx_lock(&amps_lock);
+	amps_stop();
+	lck_mtx_unlock(&amps_lock);
+}
+
+uint32_t
+apollo_cs35l41_monitor(bool tell)
+{
+	uint32_t below;
+
+	lck_mtx_lock(&amps_lock);
+	below = amps_monitor(tell);
+	lck_mtx_unlock(&amps_lock);
+	return below;
+}
diff --git a/bsd/dev/hakios.apollo_display.c b/bsd/dev/hakios.apollo_display.c
new file mode 100644
index 000000000000..0c1fe83705be
--- /dev/null
+++ b/bsd/dev/hakios.apollo_display.c
@@ -0,0 +1,1618 @@
+/*
+ * The display timing of the Xiaomi Mi 10T (apollo), read and, with a boot-arg, changed -- with boot-arg apollo_display=1
+ * (without it nothing here runs) and, optionally, apollo_display_hz=N (60 to 144: the refresh rate to switch the panel to).
+ *
+ * The phone's UEFI left the display controller (the SM8250's DPU) running: a video-mode DSI panel, DSC-compressed, driven
+ * by the controller's timing engine INTF_1. The registers of that timing engine are at physical 0x0ae6b800, 0x2c0 long
+ * (the device tree's DSI ctrl0 "mdp_intf_base" 0xae6b800; Linux's catalog dpu_6_0_sm8250.h has intf_1 at 0xae01000 +
+ * 0x6a800, the same). The offsets are those of Linux's drivers/gpu/drm/msm/disp/dpu1/dpu_hw_intf.c: TIMING_ENGINE_EN
+ * 0x000, HSYNC_CTL 0x008 (bits 31:16 the period of a line in pixel clocks, bits 15:0 the width of the sync pulse),
+ * VSYNC_PERIOD_F0 0x00c (the frame in pixel clocks: lines * the line's period), VSYNC_PULSE_WIDTH_F0 0x014,
+ * DISPLAY_V_START_F0 0x01c, DISPLAY_V_END_F0 0x024, ACTIVE_V_START_F0 0x02c, ACTIVE_V_END_F0 0x034 (all of them in pixel
+ * clocks as well: line * period + skew, so a line number is the value divided by the period), DISPLAY_HCTL 0x03c,
+ * ACTIVE_HCTL 0x040, FRAME_LINE_COUNT_EN 0x0a8 (Linux writes 3 to count both frames and lines), FRAME_COUNT 0x0ac,
+ * LINE_COUNT 0x0b0 and STATUS 0x26c (bit 0: the timing engine is running).
+ *
+ * The panel (the device tree's mdss_dsi_j3s_37_02_0a_dsc_video, whose only timing node is timing@0) is 1080x2400 at 144 Hz,
+ * with a vertical front porch of 28 lines, back porch of 26 and a pulse of 2: 2456 lines to a frame. Its other rates (120,
+ * 90 and 60, from qcom,dsi-supported-dfps-list) are made by a longer vertical front porch alone ("dfps_immediate_porch_mode_vfp"),
+ * the pixel clock staying as it is. That is what apollo_display_hz=N does here: the line time is kept, the frame gets
+ * the lines that make N, and the extra ones are all front porch.
+ *
+ * A change of the INTF's registers takes effect when the control block that drives it flushes it: the CTL blocks are at
+ * 0x0ae02000 + 0x200 * n (n = 0 to 5, 0x1e0 long each); CTL_TOP is at 0x014, CTL_FLUSH at 0x018, CTL_INTF_ACTIVE at 0x0f4
+ * and CTL_INTF_FLUSH at 0x110. On this generation INTF_1 is flushed by bit 1 of CTL_INTF_FLUSH together with bit 31 of
+ * CTL_FLUSH. The CTL that drives INTF_1 is found by reading CTL_TOP and CTL_INTF_ACTIVE of all six (and logging them): the
+ * one whose CTL_INTF_ACTIVE has bit 1 set, else the first whose CTL_TOP is not zero. If none is found, the timing is not
+ * changed.
+ *
+ * What the framebuffer driver gets: the measured refresh rate (apollo_display_hz) and a wait for the moment the scan is
+ * outside the picture (apollo_display_wait_scanout). The panel's memory is scanned out line by line; a frame copied into
+ * it while the scan is inside the picture shows as a tear where the scan crosses the copy. A copy that begins right
+ * after the scan has left the picture, and is faster than the scan is, is never crossed by it.
+ *
+ * Toward tear-free composition (the page flip instead of the copy):
+ *  - apollo_dpu_dump=1: a read-only dump of the DPU as the UEFI left it (the source pipes, the CTLs, the layer mixers, and the
+ *    SMMU stream of the display), with the pipe that scans the boot framebuffer marked.
+ *  - apollo_display_flip(phys, stride) / apollo_display_flip_latched(): the pipe's SRC0_ADDR is written and the pipe's bit
+ *    in CTL_FLUSH set; the hardware takes the new address at the next frame's start and clears the bit.
+ *  - apollo_flip=1: three frames, the flips to them queued and written at the frame start by a thread ("apollo flip"), see
+ *    the triple buffering below; apollo_flip_latest=0: a queued frame is never taken back for a newer one.
+ *  - apollo_flip_test=S: 20 s after the init, two buffers (red, green) are flipped between for S seconds and timed (not with
+ *    apollo_flip=1, whose frames they are).
+ * The catalog offsets of Linux (catalog/dpu_6_0_sm8250.h) are relative to 0x0ae01000 (its ctl_0 is at 0x1000, and the CTL
+ * here is at 0x0ae02000); the device tree's mdss_mdp reg "mdp_phys" is 0x0ae00000, size 0x84208, and its qcom,sde-sspp-off
+ * (0x5000 0x7000 0x9000 0xb000 0x25000 0x27000 0x29000 0x2b000), qcom,sde-ctl-off (0x2000 + 0x200 n) and qcom,sde-mixer-off
+ * (0x45000 + 0x1000 n) are relative to 0x0ae00000, i.e. the catalog's plus 0x1000: the offsets below are those.
+ */
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/sched_prim.h>         /* assert_wait, thread_block, thread_wakeup */
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <mach/vm_param.h>
+#include <pexpert/pexpert.h>
+#include <console/video_console.h>
+#include <sys/hakios.apollo_input.h>  /* apollo_frames_flip(), apollo_frames_acquire() */
+#include <sys/systm.h>
+#include <vm/memory_types.h>
+#include <vm/vm_kern.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+/*
+ * The large maps of the dump and the flips (the MDP's 532 KB, the SMMU's) go into the kernel's map, not the io submap:
+ * that one is small and every driver's registers stay in it for good -- with these in it too, hakios.apollo_cs35l41.c's
+ * 384 KB no longer fitted and the kernel panicked on the first sound (25 October, "kmem_alloc ... failed with 3").
+ */
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t phys_addr, vm_size_t size, unsigned int flags);
+extern uint64_t kvtophys(vm_offset_t va);       /* pmap_paddr_t */
+extern kern_return_t thread_terminate(thread_t thread);
+extern void thread_set_thread_name(thread_t thread, const char *name);
+extern struct vc_info vinfo;                    /* the boot framebuffer, as the text console knows it */
+
+/* into the loader's log as well (as the other apollo drivers) */
+extern void loader_log_putc(char c);
+
+void apollo_display_init(void);
+uint32_t apollo_display_hz(void);
+bool apollo_display_wait_scanout(uint64_t max_ns);
+bool apollo_display_flip(uint64_t phys, uint32_t stride);
+bool apollo_display_flip_latched(void);
+int apollo_scanout_get(unsigned *count, vm_offset_t va[3], uint64_t pa[3], uint32_t *stride);
+bool apollo_scanout_flip(unsigned index, bool gpu);
+bool apollo_scanout_latched(void);
+int apollo_scanout_take(void);
+void apollo_scanout_release(unsigned index);
+bool apollo_scanout_gpu_info(unsigned index, uint64_t *phys, uint32_t *stride, uint32_t *width, uint32_t *height,
+    uint64_t *bytes, vm_offset_t *va);
+int apollo_scanout_acquire(uint32_t timeout_ms);
+void apollo_scanout_mark(unsigned index, uint32_t swap);
+int apollo_scanout_take_mark(uint32_t swap, uint32_t surface);
+void apollo_scanout_wait(uint32_t timeout_us);
+unsigned apollo_scanout_front(void);
+
+static int say(const char *format, ...) __printflike(1, 2);
+
+static int
+say(const char *format, ...)
+{
+	char line[300];
+	va_list list;
+
+	va_start(list, format);
+	vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
+	for (const char *c = line; *c != 0; c++) {
+		loader_log_putc(*c);
+	}
+	return printf("%s", line);
+}
+
+static inline uint32_t
+rd(vm_offset_t address)
+{
+	return *(volatile uint32_t *)address;
+}
+
+static inline void
+wr(vm_offset_t address, uint32_t value)
+{
+	*(volatile uint32_t *)address = value;
+}
+
+/* ---- the registers ---------------------------------------------------------------------------------- */
+
+#define INTF_PHYS               0x0ae6b800UL
+#define INTF_SIZE               0x2c0UL
+#define INTF_TIMING_EN          0x000
+#define INTF_HSYNC_CTL          0x008
+#define INTF_VSYNC_PERIOD       0x00c
+#define INTF_VSYNC_PULSE        0x014
+#define INTF_DISPLAY_V_START    0x01c
+#define INTF_DISPLAY_V_END      0x024
+#define INTF_ACTIVE_V_START     0x02c
+#define INTF_ACTIVE_V_END       0x034
+#define INTF_DISPLAY_HCTL       0x03c
+#define INTF_ACTIVE_HCTL        0x040
+#define INTF_FRAME_LINE_EN      0x0a8
+#define INTF_FRAME_COUNT        0x0ac
+#define INTF_LINE_COUNT         0x0b0
+#define INTF_STATUS             0x26c
+#define INTF_STATUS_RUNNING     0x1u
+
+#define CTL_PHYS                0x0ae02000UL
+#define CTL_STRIDE              0x200UL
+#define CTL_SIZE                0x1e0UL
+#define CTL_COUNT               6
+#define CTL_TOP                 0x014
+#define CTL_FLUSH               0x018
+#define CTL_INTF_ACTIVE         0x0f4
+#define CTL_INTF_FLUSH          0x110
+#define CTL_FLUSH_INTF_BIT      (1u << 31)      /* CTL_FLUSH: the interface flush register is in use */
+#define CTL_INTF_FLUSH_INTF1    (1u << 1)       /* CTL_INTF_FLUSH: INTF_1 */
+#define CTL_INTF_ACTIVE_INTF1   (1u << 1)
+
+/* the panel's native frame: 2400 + 28 + 26 + 2 lines at 144 Hz */
+#define NATIVE_LINES            2456u
+#define NATIVE_HZ               144u
+
+#define MEASURE_MS              1000           /* (a frame more or less in 250 ms is 4 Hz at 60: too coarse to judge by) */
+#define SETTLE_MS               100
+
+static vm_offset_t intf;                /* the mapped INTF_1; 0: the driver did not start */
+static vm_offset_t ctl_base[CTL_COUNT];
+static int ctl_driving = -1;            /* the CTL that drives INTF_1, -1: none found */
+
+/* the driver's state: what was read, and what the rate measured */
+static uint32_t hsync_period;           /* pixel clocks to a line */
+static uint32_t frame_lines;            /* lines to a frame, as the registers have it now */
+static uint32_t active_start_line, active_end_line;
+static uint32_t measured_mhz;           /* the refresh rate in millihertz, measured */
+
+/* the rate in tenths of a hertz, rounded, for the log */
+static uint32_t
+tenths(uint32_t mhz)
+{
+	return (mhz + 50) / 100;
+}
+
+/* frames a second, in millihertz, as the frame counter counts them over MEASURE_MS (0 if it does not count) */
+static uint32_t
+measure(void)
+{
+	uint64_t t0, t1, ns, frames;
+	uint32_t c0, c1;
+
+	c0 = rd(intf + INTF_FRAME_COUNT);
+	t0 = mach_absolute_time();
+	delay_for_interval(MEASURE_MS, 1000 * NSEC_PER_USEC);
+	c1 = rd(intf + INTF_FRAME_COUNT);
+	t1 = mach_absolute_time();
+	absolutetime_to_nanoseconds(t1 - t0, &ns);
+	if (ns == 0) {
+		return 0;
+	}
+	frames = (uint32_t)(c1 - c0);
+	return (uint32_t)(frames * 1000000000000ULL / ns);
+}
+
+/* the line's period and the frame's length, as the registers have them now */
+static void
+read_timing(void)
+{
+	hsync_period = rd(intf + INTF_HSYNC_CTL) >> 16;
+	if (hsync_period == 0) {
+		frame_lines = active_start_line = active_end_line = 0;
+		return;
+	}
+	frame_lines = rd(intf + INTF_VSYNC_PERIOD) / hsync_period;
+	active_start_line = rd(intf + INTF_ACTIVE_V_START) / hsync_period;
+	active_end_line = rd(intf + INTF_ACTIVE_V_END) / hsync_period;
+	if (active_end_line == 0) {
+		/* Linux leaves the active window 0 where it is the whole display (dpu_hw_intf.c): the display window then */
+		active_start_line = rd(intf + INTF_DISPLAY_V_START) / hsync_period;
+		active_end_line = rd(intf + INTF_DISPLAY_V_END) / hsync_period;
+	}
+}
+
+static void
+log_timing(void)
+{
+	uint32_t hsync = rd(intf + INTF_HSYNC_CTL);
+
+	say("apollo display: timing engine %s (status %#x), frame/line counters %#x\n",
+	    (rd(intf + INTF_TIMING_EN) & 1) ? "on" : "off", rd(intf + INTF_STATUS), rd(intf + INTF_FRAME_LINE_EN));
+	say("apollo display: hsync period %u pixel clocks, pulse %u; vsync period %u (%u lines), pulse %u\n",
+	    hsync >> 16, hsync & 0xffff, rd(intf + INTF_VSYNC_PERIOD), frame_lines, rd(intf + INTF_VSYNC_PULSE));
+	say("apollo display: display v %u..%u, active v %u..%u (lines %u..%u); display hctl %#x, active hctl %#x\n",
+	    rd(intf + INTF_DISPLAY_V_START), rd(intf + INTF_DISPLAY_V_END), rd(intf + INTF_ACTIVE_V_START),
+	    rd(intf + INTF_ACTIVE_V_END), active_start_line, active_end_line, rd(intf + INTF_DISPLAY_HCTL),
+	    rd(intf + INTF_ACTIVE_HCTL));
+}
+
+/* the line time the measurement implies, and the rate the same line time gives with the native number of lines */
+static uint32_t
+native_mhz(void)
+{
+	return (uint32_t)((uint64_t)measured_mhz * frame_lines / NATIVE_LINES);
+}
+
+static void
+log_rate(void)
+{
+	uint32_t line_ns = 0, native;
+
+	if (measured_mhz != 0 && frame_lines != 0) {
+		line_ns = (uint32_t)(1000000000000ULL / ((uint64_t)measured_mhz * frame_lines));
+	}
+	native = tenths(native_mhz());
+	say("apollo display: measured %u.%u Hz over %u ms; a line takes about %u ns; with %u lines that line time is %u.%u Hz\n",
+	    tenths(measured_mhz) / 10, tenths(measured_mhz) % 10, MEASURE_MS, line_ns, NATIVE_LINES, native / 10, native % 10);
+}
+
+/* ---- the CTL that drives INTF_1 ---------------------------------------------------------------------- */
+
+static void
+find_ctl(void)
+{
+	int first_top = -1, active = -1;
+
+	for (int n = 0; n < CTL_COUNT; n++) {
+		uint32_t top, intf_active;
+
+		ctl_base[n] = ml_io_map(CTL_PHYS + CTL_STRIDE * (uint32_t)n, CTL_SIZE);
+		top = rd(ctl_base[n] + CTL_TOP);
+		intf_active = rd(ctl_base[n] + CTL_INTF_ACTIVE);
+		say("apollo display: ctl_%d: CTL_TOP %#x, CTL_INTF_ACTIVE %#x\n", n, top, intf_active);
+		if (active < 0 && (intf_active & CTL_INTF_ACTIVE_INTF1)) {
+			active = n;
+		}
+		if (first_top < 0 && top != 0) {
+			first_top = n;
+		}
+	}
+	ctl_driving = active >= 0 ? active : first_top;
+	if (ctl_driving >= 0) {
+		say("apollo display: ctl_%d drives INTF_1 (%s)\n", ctl_driving,
+		    active >= 0 ? "its CTL_INTF_ACTIVE has the bit" : "the first with a CTL_TOP");
+	} else {
+		say("apollo display: no CTL drives INTF_1: the timing will not be changed\n");
+	}
+}
+
+/* the INTF's registers written are taken over at the next frame's start, when the CTL flushes them */
+static void
+flush(void)
+{
+	wr(ctl_base[ctl_driving] + CTL_INTF_FLUSH, CTL_INTF_FLUSH_INTF1);
+	wr(ctl_base[ctl_driving] + CTL_FLUSH, CTL_FLUSH_INTF_BIT);
+}
+
+/* ---- the rate -------------------------------------------------------------------------------------- */
+
+/* switch to `hz` by the vertical front porch alone: the line time stays, the frame has the lines that make `hz` */
+static void
+set_rate(uint32_t hz)
+{
+	uint64_t lines;
+	uint32_t old_period, new_lines, low, high, got;
+
+	if (!(rd(intf + INTF_STATUS) & INTF_STATUS_RUNNING)) {
+		say("apollo display: refusing to change the rate: the timing engine is not running\n");
+		return;
+	}
+	if (measured_mhz < 30000 || measured_mhz > 150000) {
+		say("apollo display: refusing to change the rate: the measured %u.%u Hz is not between 30 and 150\n",
+		    tenths(measured_mhz) / 10, tenths(measured_mhz) % 10);
+		return;
+	}
+	if ((uint64_t)measured_mhz * 100 >= (uint64_t)hz * 1000 * 97 && (uint64_t)measured_mhz * 100 <= (uint64_t)hz * 1000 * 103) {
+		say("apollo display: the panel runs at %u Hz already (measured %u.%u): nothing to change\n", hz,
+		    tenths(measured_mhz) / 10, tenths(measured_mhz) % 10);
+		return;
+	}
+	if (ctl_driving < 0) {
+		say("apollo display: refusing to change the rate: no CTL drives INTF_1\n");
+		return;
+	}
+	/* round(lines * measured / N) */
+	lines = ((uint64_t)frame_lines * measured_mhz + (uint64_t)hz * 500) / ((uint64_t)hz * 1000);
+	new_lines = (uint32_t)lines;
+	low = NATIVE_LINES - 2;
+	high = NATIVE_LINES * NATIVE_HZ / 60 + 50;
+	if (new_lines < active_end_line + 2) {
+		say("apollo display: refusing to change the rate: %u lines would leave no front porch (the picture ends at line %u)\n",
+		    new_lines, active_end_line);
+		return;
+	}
+	if (new_lines < low || new_lines > high) {
+		say("apollo display: refusing to change the rate: %u lines is not between %u and %u\n", new_lines, low, high);
+		return;
+	}
+	/* the line time must be that of a 144 Hz frame of 2456 lines, within 3% */
+	if (native_mhz() < NATIVE_HZ * 1000 * 97 / 100 || native_mhz() > NATIVE_HZ * 1000 * 103 / 100) {
+		say("apollo display: refusing to change the rate: the line time is not that of a native %u Hz panel\n",
+		    NATIVE_HZ);
+		return;
+	}
+
+	old_period = rd(intf + INTF_VSYNC_PERIOD);
+	say("apollo display: %u Hz: %u lines (was %u), vsync period %u (was %u)\n", hz, new_lines, frame_lines,
+	    new_lines * hsync_period, old_period);
+	wr(intf + INTF_VSYNC_PERIOD, new_lines * hsync_period);
+	flush();
+	delay_for_interval(SETTLE_MS, 1000 * NSEC_PER_USEC);
+	measured_mhz = measure();
+	read_timing();
+	got = measured_mhz;
+	say("apollo display: after the change vsync period reads %u (%u lines)\n", rd(intf + INTF_VSYNC_PERIOD), frame_lines);
+	log_rate();
+	if (got < hz * 1000 * 95 / 100 || got > hz * 1000 * 105 / 100) {
+		say("apollo display: %u.%u Hz is not %u Hz: the change is undone\n", tenths(got) / 10, tenths(got) % 10, hz);
+		wr(intf + INTF_VSYNC_PERIOD, old_period);
+		flush();
+		delay_for_interval(SETTLE_MS, 1000 * NSEC_PER_USEC);
+		measured_mhz = measure();
+		read_timing();
+		log_rate();
+	} else {
+		say("apollo display: the panel runs at %u.%u Hz\n", tenths(got) / 10, tenths(got) % 10);
+	}
+}
+
+/* ---- for the framebuffer driver --------------------------------------------------------------------- */
+
+/* the refresh rate, in whole hertz; 0 if the driver did not start */
+uint32_t
+apollo_display_hz(void)
+{
+	if (intf == 0) {
+		return 0;
+	}
+	return (measured_mhz + 500) / 1000;
+}
+
+/*
+ * Wait until the scan is outside the picture (before its first line or from its end on), for at most max_ns. True if
+ * it was found so, or got so; false if the driver did not start or the time ran out.
+ */
+bool
+apollo_display_wait_scanout(uint64_t max_ns)
+{
+	uint64_t start, limit, now;
+	bool found = false;
+
+	if (intf == 0 || active_end_line == 0) {
+		return false;
+	}
+	start = mach_absolute_time();
+	nanoseconds_to_absolutetime(max_ns, &limit);
+	for (;;) {
+		uint32_t line = rd(intf + INTF_LINE_COUNT);
+
+		if (line < active_start_line || line >= active_end_line) {
+			found = true;
+			break;
+		}
+		now = mach_absolute_time();
+		if (now - start >= limit) {
+			break;
+		}
+		/*
+		 * Not a spin for the whole of the picture: the scan's lines go at a known pace, so sleep until shortly
+		 * before it leaves the picture (a frame's time / its lines), and look again.
+		 */
+		if (measured_mhz != 0 && frame_lines != 0) {
+			uint64_t line_ns = 1000000000000ULL / ((uint64_t)measured_mhz * frame_lines);
+			uint64_t left_ns = (uint64_t)(active_end_line - line) * line_ns;
+
+			if (left_ns > 300000) {
+				delay_for_interval((uint32_t)((left_ns - 200000) / 1000), NSEC_PER_USEC);
+			}
+		}
+	}
+	return found;
+}
+
+/* ---- the DPU: source pipes, CTLs, mixers (apollo_dpu_dump=1), and the page flip -------------------------- */
+
+/* the MDP as the device tree has it (mdss_mdp reg "mdp_phys"): 0x0ae00000, 0x84208 long; mapped to the page after */
+#define MDP_PHYS                0x0ae00000UL
+#define MDP_SIZE                0x85000UL
+
+/*
+ * Source pipes: the device tree's qcom,sde-sspp-off (relative to MDP_PHYS: Linux's dpu_6_0_sm8250.h sm8250_sspp, sspp_0 to
+ * sspp_3 = VIG0..3 at 0x4000, 0x6000, 0x8000, 0xa000 and sspp_8 to sspp_11 = DMA0..3 at 0x24000, 0x26000, 0x28000, 0x2a000,
+ * all plus the catalog's base 0x1000). The bit of each in CTL_FLUSH is dpu_hw_ctl.c's dpu_hw_ctl_update_pending_flush_sspp():
+ * VIG0 0, VIG1 1, VIG2 2, VIG3 18, DMA0 11, DMA1 12, DMA2 24, DMA3 25.
+ */
+#define SSPP_COUNT              8
+static const struct {
+	const char *name;
+	uint32_t offset;
+	uint32_t flush_bit;
+} sspp_table[SSPP_COUNT] = {
+	{ "VIG0", 0x05000, 0 }, { "VIG1", 0x07000, 1 }, { "VIG2", 0x09000, 2 }, { "VIG3", 0x0b000, 18 },
+	{ "DMA0", 0x25000, 11 }, { "DMA1", 0x27000, 12 }, { "DMA2", 0x29000, 24 }, { "DMA3", 0x2b000, 25 },
+};
+/* the registers of a source pipe: dpu_hw_sspp.c (SSPP_SRC_SIZE 0x00, SSPP_SRC_XY 0x08, SSPP_OUT_SIZE 0x0c, SSPP_OUT_XY 0x10,
+ * SSPP_SRC0_ADDR 0x14, SSPP_SRC_YSTRIDE0 0x24, SSPP_SRC_FORMAT 0x30, SSPP_SRC_UNPACK_PATTERN 0x34, SSPP_SRC_OP_MODE 0x38);
+ * 0x04 (the image size of the source) is not in Linux's file: the vendor's sde_hw_sspp.c names it SSPP_SRC_IMG_SIZE */
+#define SSPP_SRC_SIZE           0x00    /* height << 16 | width, of the rectangle read */
+#define SSPP_SRC_IMG_SIZE       0x04
+#define SSPP_SRC_XY             0x08
+#define SSPP_OUT_SIZE           0x0c
+#define SSPP_OUT_XY             0x10
+#define SSPP_SRC0_ADDR          0x14    /* 32 bits: the SMMU's input address (a physical one if it passes it) */
+#define SSPP_SRC_YSTRIDE0       0x24    /* [15:0] the stride of plane 0, [31:16] of plane 1 (dpu_hw_sspp_setup_sourceaddress, _setup_rects) */
+#define SSPP_SRC_FORMAT         0x30
+#define SSPP_SRC_UNPACK_PATTERN 0x34    /* element k (memory order) in bits 8k+1:8k: 0 G, 1 B, 2 R, 3 alpha (dpu_hw_sspp.c: C0_G_Y 0, C1_B_Cb 1, C2_R_Cr 2, C3_ALPHA 3) */
+#define SSPP_SRC_OP_MODE        0x38
+
+/* the CTL's registers, dpu_hw_ctl.c */
+#define CTL_START               0x01c
+#define CTL_MERGE_3D_ACTIVE     0x0e4
+#define CTL_DSC_ACTIVE          0x0e8
+#define CTL_WB_ACTIVE           0x0ec
+#define CTL_CWB_ACTIVE          0x0f0
+#define CTL_CDM_ACTIVE          0x0f8
+#define CTL_FETCH_PIPE_ACTIVE   0x0fc
+#define CTL_MERGE_3D_FLUSH      0x100
+#define CTL_DSC_FLUSH           0x104
+#define CTL_PIPE_ACTIVE         0x12c
+#define CTL_LAYER_ACTIVE        0x130
+#define CTL_INTF_MASTER         0x134
+/* CTL_LAYER(lm): lm 0..4 at 4 * lm, lm 5 at 0x024; _EXT 0x40 + 4 lm, _EXT2 0x70 + 4 lm, _EXT3 0xa0 + 4 lm, _EXT4 0xb8 + 4 lm */
+static inline uint32_t
+ctl_layer(uint32_t lm)
+{
+	return lm == 5 ? 0x024 : 4 * lm;
+}
+
+/* the layer mixers: the device tree's qcom,sde-mixer-off 0x45000 + 0x1000 n (Linux's lm_0 .. lm_5 at 0x44000 + 0x1000 n, plus 0x1000) */
+#define LM_COUNT                6
+#define LM_PHYS_OFF             0x45000
+#define LM_OP_MODE              0x00    /* dpu_hw_lm.c */
+#define LM_OUT_SIZE             0x04
+#define LM_BG_SRC_SEL_V12       0x14
+#define LM_BORDER_COLOR_0_V12   0x1c
+#define LM_BORDER_COLOR_1_V12   0x20
+#define LM_STAGE0               0x20    /* sdm845_lm_sblk blendstage_base: 0x20, 0x38, 0x50 ... (dpu_hw_catalog.c), 0x18 apart */
+#define LM_STAGE_STEP           0x18
+#define LM_BLEND0_OP            0x00    /* from a stage's base: LM_BLEND0_OP 0x00, LM_BLEND0_FG_SRC_SEL_V12 0x04, _CONST_ALPHA_V12 0x08 */
+#define LM_BLEND0_FG_SRC_SEL    0x04
+#define LM_BLEND0_CONST_ALPHA   0x08
+
+/* the display's SMMU stream: the device tree's smmu_sde_unsec_cb iommus <&apps_smmu 0x820 0x402> (secure: 0x821 0x400) */
+#define SMMU_PHYS               0x15000000UL
+#define SMMU_SIZE               0x100000UL
+#define SMMU_SCR0               0x000   /* bit 0 CLIENTPD, bit 3 EXIDENABLE, bit 10 USFCFG (fault on an unmatched stream) */
+#define SMMU_IDR0               0x020   /* [7:0] number of stream match registers */
+#define SMMU_IDR1               0x024   /* [31] 64 KB pages, [30:28] log2(pages)-1, [7:0] number of context banks */
+#define SMMU_SMR(n)             (0x800 + 4 * (n))       /* bit 31 valid, [30:16] mask, [14:0] stream (as hakios.apollo_pcie.c) */
+#define SMMU_S2CR(n)            (0xc00 + 4 * (n))       /* [17:16] 0 translate, 1 bypass, 2 fault; [7:0] context */
+#define SMMU_CB_SCTLR           0x00    /* bit 0 M: translation on */
+#define SMMU_CB_TTBR0           0x20
+#define SMMU_CB_TCR             0x30
+#define SMMU_CB_FSR             0x58
+#define MDSS_STREAM             0x820
+#define MDSS_STREAM_MASK        0x402
+#define MDSS_SEC_STREAM         0x821
+#define MDSS_SEC_MASK           0x400
+
+#define FLIP_TIMEOUT_US         100000  /* a flip that has not latched by then is a failure */
+
+static vm_offset_t mdp;                 /* the mapped MDP, 0: not yet */
+static int sspp_found = -1;             /* the pipe that scans the boot framebuffer, -1: none */
+static bool smmu_blocks;                /* the display's stream translates (or faults): flips are refused */
+static uint64_t fb_phys;                /* the boot framebuffer's physical address, 0: not found */
+static uint32_t flip_stride;            /* the stride of the pipe now, as the flip keeps it */
+static uint32_t boot_stride;            /* ... and the boot framebuffer's, which apollo_display_quiesce() puts back */
+static uint32_t flip_bit;               /* the pipe's bit in CTL_FLUSH */
+static uint64_t flip_last_us;           /* the last flip's time to latch, microseconds, ~0: it did not */
+static uint32_t flip_frames_before, flip_frames_after;
+static bool scan_stopped;               /* apollo_display_quiesce(): the run ends, the triple buffering writes the pipe no more */
+
+/*
+ * The boot framebuffer's physical address. The text console's vinfo (the structure MiniIOMobileFramebuffer takes
+ * v_baseaddr from) has the kernel's address of it in v_baseaddr and the physical one in v_physaddr (video_console.c,
+ * initialize_screen: it was given by the loader, bit 0 of the boot args' Video.v_baseAddr was set or the VM was not up);
+ * kvtophys() of v_baseaddr is the cross-check.
+ */
+static uint64_t
+framebuffer_phys(void)
+{
+	uint64_t from_vinfo = vinfo.v_physaddr, from_va = 0;
+
+	if (vinfo.v_baseaddr != 0) {
+		from_va = kvtophys((vm_offset_t)vinfo.v_baseaddr);
+	}
+	say("apollo dpu: framebuffer: vinfo v_baseaddr %#lx, v_physaddr %#llx, kvtophys(v_baseaddr) %#llx; PE_state v_baseAddr %#lx\n",
+	    (unsigned long)vinfo.v_baseaddr, from_vinfo, from_va, (unsigned long)PE_state.video.v_baseAddr);
+	if (from_va != 0) {
+		if (from_vinfo != 0 && from_vinfo != from_va) {
+			say("apollo dpu: framebuffer: v_physaddr and kvtophys() differ: the pipe match uses kvtophys()\n");
+		}
+		return from_va;
+	}
+	return from_vinfo;
+}
+
+/* read-only: the stream of the display in the application processors' SMMU; sets smmu_blocks */
+static void
+smmu_look(void)
+{
+	vm_offset_t base = ml_io_map_unmappable(SMMU_PHYS, SMMU_SIZE, VM_WIMG_IO);
+	uint32_t scr0 = rd(base + SMMU_SCR0), idr0 = rd(base + SMMU_IDR0), idr1 = rd(base + SMMU_IDR1);
+	uint32_t matches = idr0 & 0xff, contexts = idr1 & 0xff, page = (idr1 >> 31) ? 0x10000 : 0x1000, pages = 2u << (idr1 >> 28 & 7);
+	uint32_t found = 0;
+
+	say("apollo dpu: smmu: SCR0 %#x (CLIENTPD %u, USFCFG %u), %u match registers, %u contexts, pages of %#x\n", scr0, scr0 & 1,
+	    scr0 >> 10 & 1, matches, contexts, page);
+	if (scr0 & 1u << 3) {
+		say("apollo dpu: smmu: 16-bit stream ids, not read\n");
+		return;
+	}
+	for (uint32_t n = 0; n < matches && SMMU_SMR(n) < 0xc00; n++) {
+		uint32_t smr = rd(base + SMMU_SMR(n)), s2cr = rd(base + SMMU_S2CR(n));
+		uint32_t stream = smr & 0x7fff, mask = smr >> 16 & 0x7fff, type = s2cr >> 16 & 3;
+		bool unsec, sec;
+
+		if (!(smr >> 31)) {
+			continue;
+		}
+		/* the entry covers the display's stream if the ids agree outside both masks (the device tree's mask bits are "don't care") */
+		unsec = ((stream ^ MDSS_STREAM) & ~mask & ~MDSS_STREAM_MASK) == 0;
+		sec = ((stream ^ MDSS_SEC_STREAM) & ~mask & ~MDSS_SEC_MASK) == 0;
+		if (!unsec && !sec) {
+			continue;
+		}
+		found++;
+		say("apollo dpu: smmu: smr %u: stream %#x mask %#x (%s) s2cr %#x: %s, context %u\n", n, stream, mask,
+		    unsec ? "mdss unsecure" : "mdss secure", s2cr, type == 0 ? "translate" : type == 1 ? "bypass" : "fault", s2cr & 0xff);
+		if (type == 0 && (s2cr & 0xff) < contexts) {
+			vm_offset_t cb = base + (pages + (s2cr & 0xff)) * page;
+			uint32_t sctlr = rd(cb + SMMU_CB_SCTLR);
+
+			say("apollo dpu: smmu: context %u: SCTLR %#x (M %u), TTBR0 %#llx, TCR %#x, FSR %#x\n", s2cr & 0xff, sctlr, sctlr & 1,
+			    (uint64_t)rd(cb + SMMU_CB_TTBR0) | (uint64_t)rd(cb + SMMU_CB_TTBR0 + 4) << 32, rd(cb + SMMU_CB_TCR),
+			    rd(cb + SMMU_CB_FSR));
+			if (unsec && (sctlr & 1)) {
+				smmu_blocks = true;     /* an address of ours would go through that context's tables */
+			}
+		} else if (type == 2 && unsec) {
+			smmu_blocks = true;
+		}
+	}
+	if (found == 0) {
+		say("apollo dpu: smmu: no match register covers streams %#x/%#x: %s\n", MDSS_STREAM,
+		    (scr0 & 1) ? "the SMMU is bypassed for clients (CLIENTPD)" :
+		    (scr0 >> 10 & 1) ? "unmatched streams fault (USFCFG)" : "unmatched streams pass through");
+		if (!(scr0 & 1) && (scr0 >> 10 & 1)) {
+			smmu_blocks = true;
+		}
+	}
+	say("apollo dpu: smmu: the display's stream %s\n", smmu_blocks ? "TRANSLATES: flips are refused" : "is not translated");
+}
+
+static void
+dump_sspp(void)
+{
+	for (int i = 0; i < SSPP_COUNT; i++) {
+		vm_offset_t b = mdp + sspp_table[i].offset;
+
+		say("apollo dpu: %s@%#lx size %#x img %#x xy %#x out %#x/%#x addr %#x stride %#x fmt %#x unpack %#x op %#x%s\n",
+		    sspp_table[i].name, MDP_PHYS + sspp_table[i].offset, rd(b + SSPP_SRC_SIZE), rd(b + SSPP_SRC_IMG_SIZE),
+		    rd(b + SSPP_SRC_XY), rd(b + SSPP_OUT_SIZE), rd(b + SSPP_OUT_XY), rd(b + SSPP_SRC0_ADDR), rd(b + SSPP_SRC_YSTRIDE0),
+		    rd(b + SSPP_SRC_FORMAT), rd(b + SSPP_SRC_UNPACK_PATTERN), rd(b + SSPP_SRC_OP_MODE),
+		    i == sspp_found ? "  <== scans the boot framebuffer" : "");
+	}
+}
+
+static void
+dump_ctl(void)
+{
+	for (uint32_t n = 0; n < CTL_COUNT; n++) {
+		vm_offset_t c = mdp + (CTL_PHYS - MDP_PHYS) + CTL_STRIDE * n;
+
+		say("apollo dpu: ctl_%u%s: top %#x flush %#x intf_active %#x intf_flush %#x merge3d %#x/%#x dsc %#x/%#x wb %#x cwb %#x cdm %#x "
+		    "fetch_pipe %#x pipe %#x layer_active %#x intf_master %#x\n", n, (int)n == ctl_driving ? " (drives INTF_1)" : "",
+		    rd(c + CTL_TOP), rd(c + CTL_FLUSH), rd(c + CTL_INTF_ACTIVE), rd(c + CTL_INTF_FLUSH), rd(c + CTL_MERGE_3D_ACTIVE),
+		    rd(c + CTL_MERGE_3D_FLUSH), rd(c + CTL_DSC_ACTIVE), rd(c + CTL_DSC_FLUSH), rd(c + CTL_WB_ACTIVE),
+		    rd(c + CTL_CWB_ACTIVE), rd(c + CTL_CDM_ACTIVE), rd(c + CTL_FETCH_PIPE_ACTIVE), rd(c + CTL_PIPE_ACTIVE),
+		    rd(c + CTL_LAYER_ACTIVE), rd(c + CTL_INTF_MASTER));
+		for (uint32_t lm = 0; lm < LM_COUNT; lm++) {
+			uint32_t l = rd(c + ctl_layer(lm)), e = rd(c + 0x40 + 4 * lm), e2 = rd(c + 0x70 + 4 * lm), e3 = rd(c + 0xa0 + 4 * lm),
+			    e4 = rd(c + 0xb8 + 4 * lm);
+
+			if (l | e | e2 | e3 | e4) {
+				say("apollo dpu: ctl_%u layer(lm_%u) %#x ext %#x ext2 %#x ext3 %#x ext4 %#x\n", n, lm, l, e, e2, e3, e4);
+			}
+		}
+	}
+}
+
+static void
+dump_lm(void)
+{
+	for (uint32_t n = 0; n < LM_COUNT; n++) {
+		vm_offset_t l = mdp + LM_PHYS_OFF + 0x1000 * n;
+		uint32_t out = rd(l + LM_OUT_SIZE);
+
+		if (out == 0 && rd(l + LM_OP_MODE) == 0) {
+			continue;
+		}
+		say("apollo dpu: lm_%u: op_mode %#x out_size %#x bg_src_sel %#x border %#x/%#x; stage0 op %#x fg_src %#x alpha %#x, "
+		    "stage1 op %#x fg_src %#x, stage2 op %#x fg_src %#x\n", n, rd(l + LM_OP_MODE), out, rd(l + LM_BG_SRC_SEL_V12),
+		    rd(l + LM_BORDER_COLOR_0_V12), rd(l + LM_BORDER_COLOR_1_V12), rd(l + LM_STAGE0 + LM_BLEND0_OP),
+		    rd(l + LM_STAGE0 + LM_BLEND0_FG_SRC_SEL), rd(l + LM_STAGE0 + LM_BLEND0_CONST_ALPHA),
+		    rd(l + LM_STAGE0 + LM_STAGE_STEP + LM_BLEND0_OP), rd(l + LM_STAGE0 + LM_STAGE_STEP + LM_BLEND0_FG_SRC_SEL),
+		    rd(l + LM_STAGE0 + 2 * LM_STAGE_STEP + LM_BLEND0_OP), rd(l + LM_STAGE0 + 2 * LM_STAGE_STEP + LM_BLEND0_FG_SRC_SEL));
+	}
+}
+
+/* map the MDP, find the pipe that scans the boot framebuffer, look at the SMMU; the dump on request. Needs find_ctl() done. */
+static void
+dpu_setup(bool dump)
+{
+	mdp = ml_io_map_unmappable(MDP_PHYS, MDP_SIZE, VM_WIMG_IO);
+	fb_phys = framebuffer_phys();
+	for (int i = 0; i < SSPP_COUNT; i++) {
+		if (fb_phys != 0 && rd(mdp + sspp_table[i].offset + SSPP_SRC0_ADDR) == (uint32_t)fb_phys && fb_phys < (1ull << 32)) {
+			sspp_found = i;
+			break;
+		}
+	}
+	if (sspp_found >= 0) {
+		vm_offset_t b = mdp + sspp_table[sspp_found].offset;
+
+		flip_bit = 1u << sspp_table[sspp_found].flush_bit;
+		flip_stride = rd(b + SSPP_SRC_YSTRIDE0) & 0xffff;
+		boot_stride = flip_stride;
+		say("apollo dpu: %s's SRC0_ADDR is the framebuffer %#llx (stride %u, flush bit %u)\n", sspp_table[sspp_found].name,
+		    fb_phys, flip_stride, sspp_table[sspp_found].flush_bit);
+	} else {
+		say("apollo dpu: no source pipe has SRC0_ADDR %#llx: no flips\n", fb_phys);
+	}
+	if (dump) {
+		dump_sspp();
+		dump_ctl();
+		dump_lm();
+	}
+	smmu_look();
+}
+
+static bool
+flip_ready(void)
+{
+	return mdp != 0 && sspp_found >= 0 && ctl_driving >= 0 && !smmu_blocks;
+}
+
+/*
+ * Page flip: the pipe's SRC0_ADDR (and SRC_YSTRIDE0 if the stride differs) is written, and last the pipe's bit in the
+ * driving CTL's CTL_FLUSH (dpu_hw_ctl_trigger_flush(): DPU_REG_WRITE(CTL_FLUSH, pending_flush_mask), the pipe's bit from
+ * dpu_hw_ctl_update_pending_flush_sspp()); the hardware takes the registers at the frame's start and clears the bit.
+ * The address is 32 bits (SRC0_ADDR), so the buffer must be below 4 GB. False: nothing was written.
+ */
+bool
+apollo_display_flip(uint64_t phys, uint32_t stride)
+{
+	vm_offset_t b, c;
+
+	if (!flip_ready()) {
+		return false;
+	}
+	if (phys >= (1ull << 32) || (phys & 0xff) != 0 || stride == 0 || stride > 0xffff) {
+		say("apollo dpu: flip refused: address %#llx (below 4 GB, 256-byte aligned) or stride %u unusable\n", phys, stride);
+		return false;
+	}
+	b = mdp + sspp_table[sspp_found].offset;
+	c = ctl_base[ctl_driving];
+	flip_frames_before = rd(intf + INTF_FRAME_COUNT);
+	wr(b + SSPP_SRC0_ADDR, (uint32_t)phys);
+	if (stride != flip_stride) {
+		wr(b + SSPP_SRC_YSTRIDE0, (rd(b + SSPP_SRC_YSTRIDE0) & 0xffff0000u) | stride);
+		flip_stride = stride;
+	}
+	__asm__ volatile ("dsb sy" : : : "memory");
+	wr(c + CTL_FLUSH, flip_bit);    /* last */
+	return true;
+}
+
+/*
+ * The run's end (osfmk/arm64/loader_return.c, after a panic too: no lock, no sleep, no log): the pipe back on the boot
+ * framebuffer, which the loader draws its screen into and reads screenshots from. Latched at the next frame start.
+ */
+void
+apollo_display_quiesce(void)
+{
+	scan_stopped = true;                    /* (a queued frame of apollo_flip=1 is not written after this) */
+	if (!flip_ready() || fb_phys == 0 || fb_phys >= (1ull << 32)) {
+		return;
+	}
+	wr(mdp + sspp_table[sspp_found].offset + SSPP_SRC0_ADDR, (uint32_t)fb_phys);
+	if (boot_stride != 0) {
+		/* (frames the GPU drew have a stride of 64-byte multiples, apollo_gpu_present=1: the boot framebuffer's is not) */
+		vm_offset_t b = mdp + sspp_table[sspp_found].offset;
+
+		wr(b + SSPP_SRC_YSTRIDE0, (rd(b + SSPP_SRC_YSTRIDE0) & 0xffff0000u) | boot_stride);
+	}
+	__asm__ volatile ("dsb sy" : : : "memory");
+	wr(ctl_base[ctl_driving] + CTL_FLUSH, flip_bit);
+}
+
+/* the flush bit has been cleared by the hardware: the last flip has taken effect */
+bool
+apollo_display_flip_latched(void)
+{
+	if (!flip_ready()) {
+		return false;
+	}
+	return (rd(ctl_base[ctl_driving] + CTL_FLUSH) & flip_bit) == 0;
+}
+
+/* wait for the latch of the flip just made; the time in microseconds (or ~0 if it did not in FLIP_TIMEOUT_US) */
+static uint64_t
+flip_wait_latch(void)
+{
+	uint64_t t0 = mach_absolute_time(), now, us;
+
+	for (;;) {
+		bool done = apollo_display_flip_latched();
+
+		now = mach_absolute_time();
+		absolutetime_to_nanoseconds(now - t0, &us);
+		us /= 1000;
+		if (done) {
+			flip_frames_after = rd(intf + INTF_FRAME_COUNT);
+			flip_last_us = us;
+			return us;
+		}
+		if (us >= FLIP_TIMEOUT_US) {
+			flip_frames_after = rd(intf + INTF_FRAME_COUNT);
+			flip_last_us = ~0ull;
+			return ~0ull;
+		}
+	}
+}
+
+/* ---- the self-test (apollo_flip_test=S) --------------------------------------------------------------- */
+
+#define TEST_DELAY_MS           20000
+#define TEST_HOLD_MS            3000
+#define TEST_HEIGHT_MAX         4096
+
+static uint32_t flip_test_seconds;
+
+struct flip_stats {
+	uint32_t requested, in_frame, missed;
+	uint64_t min_us, max_us, sum_us;
+	uint32_t max_frames;
+};
+
+static void
+stats_clear(struct flip_stats *st)
+{
+	st->requested = st->in_frame = st->missed = st->max_frames = 0;
+	st->min_us = ~0ull;
+	st->max_us = st->sum_us = 0;
+}
+
+/* a flip, its latch awaited; false if it did not latch (a miss), and the time and frames counted */
+static bool
+timed_flip(struct flip_stats *st, uint64_t phys, uint32_t stride)
+{
+	uint64_t us, frame_us = measured_mhz ? 1000000000ull / measured_mhz : 16667;
+	uint32_t frames;
+
+	st->requested++;
+	if (!apollo_display_flip(phys, stride)) {
+		st->missed++;
+		return false;
+	}
+	us = flip_wait_latch();
+	if (us == ~0ull) {
+		st->missed++;
+		return false;
+	}
+	frames = flip_frames_after - flip_frames_before;
+	if (frames > st->max_frames) {
+		st->max_frames = frames;
+	}
+	if (us <= frame_us + frame_us / 10) {
+		st->in_frame++;
+	}
+	st->sum_us += us;
+	if (us < st->min_us) {
+		st->min_us = us;
+	}
+	if (us > st->max_us) {
+		st->max_us = us;
+	}
+	return true;
+}
+
+static void
+stats_log(const char *what, const struct flip_stats *st)
+{
+	uint32_t done = st->requested - st->missed;
+
+	say("apollo flip test: %s: %u flips requested, %u latched within one frame, latch %llu/%llu/%llu us (min/mean/max), "
+	    "%u missed, at most %u frames passed\n", what, st->requested, st->in_frame, done ? st->min_us : 0,
+	    done ? st->sum_us / done : 0, st->max_us, st->missed, st->max_frames);
+}
+
+/* the 32-bit pixel of a colour in the pipe's byte order (SRC_UNPACK_PATTERN), alpha at its maximum */
+static uint32_t
+pixel(uint32_t pattern, uint32_t component /* 0 G, 1 B, 2 R */)
+{
+	uint32_t value = 0;
+
+	for (uint32_t k = 0; k < 4; k++) {
+		uint32_t element = pattern >> (8 * k) & 3;
+
+		if (element == 3 || element == component) {
+			value |= 0xffu << (8 * k);
+		}
+	}
+	return value;
+}
+
+static void
+fill_buffer(vm_offset_t buffer, size_t bytes, uint32_t value)
+{
+	uint32_t *p = (uint32_t *)buffer;
+
+	for (size_t i = 0; i < bytes / 4; i++) {
+		p[i] = value;
+	}
+	for (vm_offset_t line = buffer; line < buffer + bytes; line += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (line));
+	}
+	__asm__ volatile ("dsb sy");
+}
+
+/* the original picture back, its latch verified */
+static void
+restore_original(uint32_t stride)
+{
+	struct flip_stats st;
+
+	stats_clear(&st);
+	if (timed_flip(&st, fb_phys, stride)) {
+		say("apollo flip test: the boot framebuffer %#llx is back, latched in %llu us\n", fb_phys, flip_last_us);
+	} else {
+		say("apollo flip test: the boot framebuffer %#llx was written back but the flip did not latch in %u ms\n", fb_phys,
+		    FLIP_TIMEOUT_US / 1000);
+	}
+	/* two frames before the buffers are let go: the scan may still be reading the old one */
+	delay_for_interval(100, NSEC_PER_MSEC);
+}
+
+/*
+ * The two buffers of the flips, taken while the kernel starts: 20 s in, 10 MB in one piece below 4 GB (the pipe's
+ * addresses are 32 bits) were no longer to be had (25 October) -- as the Wi-Fi's DMA pool, they are taken at boot.
+ */
+static vm_offset_t flip_buf[2];
+static uint64_t flip_phys[2];
+static size_t flip_bytes;
+static uint32_t flip_gpu_stride;        /* apollo_gpu_present=1: the stride of frames the GPU draws (0: none are), see flip_reserve() */
+static uint32_t flip_height;
+static bool flip_reserved;      /* the buffers are the display reservation's: never freed */
+
+/*
+ * They come out of the display's own reservation: the UEFI keeps 0x9c000000 + 0x2400000 for it (apolloPkg's
+ * MemoryMapLib.c, "Display Reserved"; Android's tree: cont_splash_region@9c000000, 0x2300000), the kernel never has it,
+ * and the boot framebuffer (fb_phys) takes only its first frame -- two more fit behind it. Write-combined, as the
+ * panel's memory is: nothing is held back in the processors' caches. (In one piece below 4 GB from the kernel's
+ * memory there was none, at 20 s or at boot: 25 October.)
+ */
+#define DISPLAY_RESERVED_PHYS   0x9c000000ull
+#define DISPLAY_RESERVED_SIZE   0x2400000ull
+
+static void
+flip_reserve(void)
+{
+	vm_offset_t b = mdp + sspp_table[sspp_found].offset;
+	uint32_t stride = rd(b + SSPP_SRC_YSTRIDE0) & 0xffff, height = rd(b + SSPP_SRC_SIZE) >> 16;
+
+	if (stride == 0 || height == 0 || height > TEST_HEIGHT_MAX || fb_phys != DISPLAY_RESERVED_PHYS) {
+		say("apollo flip: the boot framebuffer is at %#llx, not at the start of the display's reservation: no buffers\n", fb_phys);
+		return;
+	}
+	flip_bytes = round_page((size_t)stride * height);
+	/*
+	 * apollo_gpu_present=1: the GPU draws the frames too (the window server scales into them with Mesa). A render target's
+	 * pitch is a multiple of 64 bytes (Mesa's fd_resource_from_handle() refuses any other; RB_BLIT_DST_PITCH and RB_2D_DST_PITCH
+	 * of a6xx.xml are in units of 64 bytes): 1080 * 4 = 4320 is 67.5 of them, so a frame the GPU has drawn is flipped to with
+	 * stride 4352, and each of the three frames gets the room for that (10444800 bytes, three of them 31.3 MB of the 37.7 MB).
+	 * The CPU's frames (the boot stride) go on being drawn in the same places, and every flip says which stride it is.
+	 */
+	{
+		uint32_t gpu_present = 0;
+
+		PE_parse_boot_argn("apollo_gpu_present", &gpu_present, sizeof(gpu_present));
+		if (gpu_present == 1) {
+			uint32_t gpu_stride = (stride + 63) & ~63u;
+
+			if (3 * (uint64_t)round_page((size_t)gpu_stride * height) <= DISPLAY_RESERVED_SIZE) {
+				flip_gpu_stride = gpu_stride;
+				flip_bytes = round_page((size_t)gpu_stride * height);
+			} else {
+				say("apollo flip: three frames of the GPU's stride %u do not fit the display's reservation\n", gpu_stride);
+			}
+		}
+		flip_height = height;
+	}
+	if (3 * (uint64_t)flip_bytes > DISPLAY_RESERVED_SIZE) {
+		say("apollo flip: three frames of %lu bytes do not fit the display's reservation\n", (unsigned long)flip_bytes);
+		return;
+	}
+	for (uint32_t i = 0; i < 2; i++) {
+		flip_phys[i] = DISPLAY_RESERVED_PHYS + (uint64_t)(i + 1) * flip_bytes;
+		flip_buf[i] = ml_io_map_unmappable((vm_offset_t)flip_phys[i], flip_bytes, VM_WIMG_WCOMB);
+		if (flip_buf[i] == 0) {
+			say("apollo flip: buffer %u at %#llx cannot be mapped\n", i, flip_phys[i]);
+			return;
+		}
+	}
+	flip_reserved = true;
+	say("apollo flip: two buffers of %lu bytes in the display's reservation, at %#llx and %#llx\n", (unsigned long)flip_bytes,
+	    flip_phys[0], flip_phys[1]);
+}
+
+static void
+flip_test_thread(void *arg, wait_result_t wr_)
+{
+	vm_offset_t buf[2] = { 0, 0 };
+	uint64_t phys[2] = { 0, 0 };
+	vm_offset_t b;
+	uint32_t stride, height, pattern, colours[2], seconds = flip_test_seconds, orig_stride;
+	size_t bytes = 0;
+	struct flip_stats st;
+	uint32_t i;
+
+	(void)arg;
+	(void)wr_;
+	delay_for_interval(TEST_DELAY_MS, NSEC_PER_MSEC);
+	if (!flip_ready()) {
+		say("apollo flip test: not run: no pipe on the framebuffer, no CTL, or the display's SMMU stream translates\n");
+		goto out;
+	}
+	b = mdp + sspp_table[sspp_found].offset;
+	orig_stride = stride = rd(b + SSPP_SRC_YSTRIDE0) & 0xffff;
+	height = rd(b + SSPP_SRC_SIZE) >> 16;
+	pattern = rd(b + SSPP_SRC_UNPACK_PATTERN);
+	if (stride == 0 || height == 0 || height > TEST_HEIGHT_MAX || fb_phys == 0) {
+		say("apollo flip test: not run: the pipe's stride %u / height %u are odd\n", stride, height);
+		goto out;
+	}
+	bytes = round_page((size_t)stride * height);
+	/* in one piece and below 4 GB (the pipe's address is 32 bits) */
+	for (i = 0; i < 2; i++) {
+		if (flip_buf[i] == 0 || flip_bytes < bytes) {
+			say("apollo flip test: not run: buffer %u was not taken at boot\n", i);
+			goto out;
+		}
+		buf[i] = flip_buf[i];
+		phys[i] = flip_phys[i];
+		if (phys[i] + bytes > (1ull << 32) || (phys[i] & 0xff)) {
+			say("apollo flip test: not run: buffer %u at %#llx is out of the pipe's reach\n", i, phys[i]);
+			goto out;
+		}
+	}
+	colours[0] = pixel(pattern, 2);         /* red */
+	colours[1] = pixel(pattern, 0);         /* green */
+	fill_buffer(buf[0], bytes, colours[0]);
+	fill_buffer(buf[1], bytes, colours[1]);
+	say("apollo flip test: red %#x at %#llx, green %#x at %#llx (%lu bytes each, stride %u, unpack %#x); the panel is about to "
+	    "flash red and green for %u s\n", colours[0], phys[0], colours[1], phys[1], (unsigned long)bytes, stride, pattern, seconds);
+	delay_for_interval(TEST_HOLD_MS, NSEC_PER_MSEC);
+
+	/* half the time: once a second */
+	stats_clear(&st);
+	say("apollo flip test: once a second for %u s, first flip now\n", seconds / 2);
+	for (i = 0; i < seconds / 2; i++) {
+		if (!timed_flip(&st, phys[i & 1], stride)) {
+			say("apollo flip test: flip %u did not latch within %u ms: aborted\n", i, FLIP_TIMEOUT_US / 1000);
+			stats_log("paced", &st);
+			goto restore;
+		}
+		delay_for_interval(1000, NSEC_PER_MSEC);
+	}
+	stats_log("paced", &st);
+
+	/* the other half: one flip per frame, each after the latch of the one before */
+	say("apollo flip test: one flip per frame for %u s\n", seconds - seconds / 2);
+	for (uint32_t s = 0; s < seconds - seconds / 2; s++) {
+		uint64_t t0 = mach_absolute_time(), now, ns;
+		uint32_t flip = 0;
+
+		stats_clear(&st);
+		for (;;) {
+			if (!timed_flip(&st, phys[flip++ & 1], stride)) {
+				say("apollo flip test: a flip did not latch within %u ms: aborted\n", FLIP_TIMEOUT_US / 1000);
+				stats_log("per frame", &st);
+				goto restore;
+			}
+			now = mach_absolute_time();
+			absolutetime_to_nanoseconds(now - t0, &ns);
+			if (ns >= 1000000000ull) {
+				break;
+			}
+		}
+		stats_log("per frame", &st);
+	}
+restore:
+	restore_original(orig_stride);
+out:
+	/* (the buffers are flip_reserve()'s mappings of the display's reservation: kept, never given to kmem_free) */
+	thread_terminate(current_thread());
+}
+
+/* ---- the frames of the triple buffering (apollo_flip=1) -------------------------------------------------- */
+
+/*
+ * MiniIOMobileFramebuffer draws into one of three frames and flips the pipe to it: frame 0 is the boot framebuffer (fb_phys;
+ * the caller already has it mapped, as fBase, and passes that address in va[0] of apollo_scanout_get), frames 1 and 2 are
+ * flip_buf[0..1] (the display reservation behind it, mapped by flip_reserve).
+ * scan_front: the frame the panel scans, as far as we have seen it latch; scan_pending: the one written to the pipe (its
+ * CTL_FLUSH bit set) but not yet seen latched, or SCAN_NONE; scan_queued: one drawn and asked to be flipped to while another
+ * was pending -- not written to the pipe yet (the pipe has one set of shadow registers: a second write before the latch
+ * would race the frame start, and which of the two the panel then scans could not be told), or SCAN_NONE.
+ *
+ * The flip does not wait (it used to: show() slept until the flip before had latched, 9 to 15 ms of every frame at 60 Hz,
+ * 26 October -- and since a frame that came while one was pending was written only at the next frame start, every frame was
+ * shown a refresh later than it could have been, as long as frames kept coming). The panel (a video-mode DSI panel, INTF_1's
+ * timing engine running, see the top of this file) takes a flushed pipe's registers at the frame start. apollo_scanout_flip():
+ *  - nothing pending: the pipe is written at once (shown from the next frame start), as before;
+ *  - one pending, apollo_flip_latest=1 (the default) and the same stride: the pipe's SRC0_ADDR is written over with the new
+ *    frame and the flush bit set again: latest wins, the pending one is never shown -- or, if the frame start came between
+ *    the two writes, it is shown for that one refresh. Which of the two the frame start took cannot be told, so the replaced
+ *    frame is HELD (scan_held: neither drawn into nor handed out) until the new pending one is seen latched: the flush bit
+ *    read clear after our own write of it means the pipe has taken our SRC0_ADDR, whatever happened in between;
+ *  - else (apollo_flip_latest=0, or a CPU frame after a GPU one: another stride, which two writes cannot change at once
+ *    safely) the frame is queued (scan_queued; one queued later replaces it, latest wins) and written the moment the pending
+ *    one is seen latched -- by whoever looks first under scan_lock (scan_update), at the latest by a thread of its own,
+ *    "apollo flip", which looks right after each frame start: written then, it is shown from the next.
+ * With apollo_flip_latest=1 a queued frame is also given back to whoever needs a frame to draw into when none is free
+ * (apollo_scanout_take, apollo_scanout_acquire), the newer picture taking the older's place.
+ * Never drawn into: scan_front (scanned), scan_pending (latched at the next frame start), scan_held (perhaps scanned); a
+ * queued frame is in no register of the pipe, so it may be taken back.
+ *
+ * Where the frame start is: the timing engine's line counter (INTF_LINE_COUNT) gives the line in the frame; the line at which
+ * the CTL_FLUSH bit clears is learned (scan_latch_line) by looking every 250 us until a latch is seen, then the thread sleeps
+ * until shortly after that line in every frame. No interrupt: the MDSS's interrupt (the DPU's INTF vsync / CTL start) goes
+ * through the MDSS's own interrupt controller, which this kernel has no driver for.
+ */
+#define SCAN_NONE       0xffffffffu
+static unsigned scan_front;
+static unsigned scan_pending = SCAN_NONE;
+static unsigned scan_queued = SCAN_NONE;
+static bool scan_queued_gpu;            /* the queued frame was drawn by the GPU (its stride) */
+static bool scan_pending_gpu;           /* ... and the pending one */
+static uint32_t scan_held;              /* a bit per frame: replaced while pending, perhaps scanned until the pending one latches */
+static uint64_t scan_asked_abs[3];      /* when the flip to each frame was asked for (apollo_scanout_flip) */
+static uint64_t scan_written_abs;       /* when the pending one was written to the pipe */
+static bool scan_latest = false;        /* apollo_flip_latest=1: a newer frame replaces a pending one (off: on the phone it dropped frames that came two in one refresh, 28 October) */
+static uint32_t scan_latches;           /* latches seen */
+
+/* the "apollo flip" thread: where in the frame the flush bit clears, and its looks */
+#define SCAN_LINE_UNKNOWN       0xffffffffu
+#define SCAN_POLL_NS            250000ULL       /* looks while the latch's line is not known */
+#define SCAN_SHORT_NS           150000ULL       /* looks just after the latch's line, while a flip written before it is pending */
+#define SCAN_WINDOW_NS          1500000ULL      /* ... for this long after it; still pending then: the line was wrong */
+#define SCAN_AFTER_NS           100000ULL       /* the look after the latch's line, this much after it */
+#define SCAN_STUCK_NS           20000000ULL     /* a flip pending for longer than FLIP_TIMEOUT_US (the panel off?): looks this far apart */
+static uint32_t scan_latch_line = SCAN_LINE_UNKNOWN;
+static uint64_t scan_look_abs;          /* the thread's last look that found a flip pending (0: none) */
+static uint32_t scan_learned;           /* (times the line was learned: logged the first few) */
+static char scan_event;                 /* the thread sleeps on it: a flip is pending or queued */
+
+/*
+ * The state machine of the three frames is here, behind one lock: the presenter (MiniIOMobileFramebuffer's show()), the
+ * window server's calls (ApolloGPU's kApolloScanout, apollo_gpu_present=1) and the "apollo flip" thread all move it. A frame
+ * is FREE when it is neither scan_front nor scan_pending nor scan_queued nor held nor reserved: reserved is a frame that someone
+ * is drawing into -- the presenter's CPU copy (apollo_scanout_take) or the GPU, for the window server (apollo_scanout_acquire)
+ * -- from the moment it is handed out until the flip to it (apollo_scanout_flip) or its release. The flip to a frame makes it
+ * scan_pending (written over the one pending, which is then held, or queued behind it), then scan_front; the one that was in
+ * front before it, and the held ones, are free again once the new one has latched.
+ */
+static LCK_GRP_DECLARE(scan_lck_grp, "apollo-scanout");
+static LCK_MTX_DECLARE(scan_lock, &scan_lck_grp);
+static uint32_t scan_reserved;          /* a bit per frame */
+static int scan_mark = -1;              /* a frame the GPU has drawn the next swap into (apollo_scanout_mark), or -1 */
+static uint32_t scan_mark_swap;         /* ... and the number of that swap (bit 31 set: the ID of the swap's layer 0 surface) */
+
+/* the frames: 3 and their addresses (va[0] in: frame 0's address, as the caller maps it; count 0: flips are not available) */
+int
+apollo_scanout_get(unsigned *count, vm_offset_t va[3], uint64_t pa[3], uint32_t *stride)
+{
+	*count = 0;
+	if (!flip_ready() || !flip_reserved || va[0] == 0) {
+		return 0;
+	}
+	va[1] = flip_buf[0];
+	va[2] = flip_buf[1];
+	pa[0] = fb_phys;
+	pa[1] = flip_phys[0];
+	pa[2] = flip_phys[1];
+	*stride = boot_stride;
+	lck_mtx_lock(&scan_lock);
+	scan_front = 0;
+	scan_pending = SCAN_NONE;
+	scan_queued = SCAN_NONE;
+	scan_held = 0;
+	lck_mtx_unlock(&scan_lock);
+	*count = 3;
+	return 3;
+}
+
+/* a frame's line period in nanoseconds (0: not known) */
+static uint64_t
+scan_line_ns(void)
+{
+	if (measured_mhz == 0 || frame_lines == 0) {
+		return 0;
+	}
+	return 1000000000000ULL / ((uint64_t)measured_mhz * frame_lines);
+}
+
+/* nanoseconds since the latch's line (or the frame's first line while that is not known), from the line counter */
+static uint64_t
+scan_since_latch_ns(uint32_t line)
+{
+	uint32_t at = scan_latch_line == SCAN_LINE_UNKNOWN ? 0 : scan_latch_line;
+
+	if (frame_lines == 0 || line >= frame_lines || at >= frame_lines) {
+		return 0;
+	}
+	return (uint64_t)((line + frame_lines - at) % frame_lines) * scan_line_ns();
+}
+
+/* with the lock held: frame `index` written to the pipe; true: it is scan_pending now */
+static bool
+scan_write(unsigned index, bool gpu)
+{
+	if (scan_stopped || !apollo_display_flip(index == 0 ? fb_phys : flip_phys[index - 1], gpu ? flip_gpu_stride : boot_stride)) {
+		return false;
+	}
+	scan_pending = index;
+	scan_pending_gpu = gpu;
+	scan_written_abs = mach_absolute_time();
+	return true;
+}
+
+/*
+ * With the lock held: if the pending flip has latched, its frame is the front now (and the one in front before it is free);
+ * then a queued frame is written to the pipe. True: nothing is pending (after this look; a queued frame written is pending).
+ */
+static bool
+scan_update(void)
+{
+	if (scan_pending != SCAN_NONE) {
+		uint64_t ns;
+
+		if (!apollo_display_flip_latched()) {
+			return false;
+		}
+		absolutetime_to_nanoseconds(mach_absolute_time() - scan_asked_abs[scan_pending], &ns);
+		apollo_frames_flip(APOLLO_FRAMES_FLIP_LATCHED, ns);
+		scan_latches++;
+		scan_front = scan_pending;
+		scan_pending = SCAN_NONE;
+		scan_held = 0;                          /* (the pipe scans the latched one: whatever it took before is behind it) */
+	}
+	if (scan_queued != SCAN_NONE) {
+		unsigned queued = scan_queued;
+
+		scan_queued = SCAN_NONE;
+		if (queued != scan_front && scan_write(queued, scan_queued_gpu)) {
+			apollo_frames_flip(APOLLO_FRAMES_FLIP_APPLIED, intf != 0 ? scan_since_latch_ns(rd(intf + INTF_LINE_COUNT)) : 0);
+			return false;
+		}
+		apollo_frames_flip(APOLLO_FRAMES_FLIP_FAILED, 0);      /* (the frame is nobody's now: free) */
+	}
+	return true;
+}
+
+/*
+ * A new flip may be asked for now. (Before the flips were queued this was "the one before has latched", and show() waited for
+ * it; now apollo_scanout_flip() always takes the frame -- queued if one is pending -- so it is true. The look updates the front.)
+ */
+bool
+apollo_scanout_latched(void)
+{
+	lck_mtx_lock(&scan_lock);
+	scan_update();
+	lck_mtx_unlock(&scan_lock);
+	return true;
+}
+
+/*
+ * With the lock held: a frame that is not scanned, not waiting for its latch, not queued and nobody's; -1: none. If there is
+ * none and `latest` (apollo_flip_latest=1), the queued frame, taken back: the caller draws a newer picture into it.
+ */
+static int
+scan_free(bool latest)
+{
+	scan_update();
+	for (unsigned i = 0; i < 3; i++) {
+		if (i != scan_front && i != scan_pending && i != scan_queued && !((scan_reserved | scan_held) & (1u << i))) {
+			return (int)i;
+		}
+	}
+	if (latest && scan_latest && scan_queued != SCAN_NONE) {
+		int index = (int)scan_queued;
+
+		scan_queued = SCAN_NONE;
+		apollo_frames_flip(APOLLO_FRAMES_FLIP_TAKEN_BACK, 0);
+		return index;
+	}
+	return -1;
+}
+
+/*
+ * A frame for the presenter to draw into (the CPU's copy), reserved until the flip to it; -1: none is free now (the one
+ * flipped to last has not latched, and the window server holds the third).
+ */
+int
+apollo_scanout_take(void)
+{
+	int index;
+
+	lck_mtx_lock(&scan_lock);
+	index = scan_free(true);
+	if (index >= 0) {
+		scan_reserved |= 1u << index;
+	} else {
+		apollo_frames_flip(APOLLO_FRAMES_FLIP_NONE_FREE, 0);
+	}
+	lck_mtx_unlock(&scan_lock);
+	return index;
+}
+
+/* a reserved frame given back without a flip (the window server abandoned it, or the presenter could not flip) */
+void
+apollo_scanout_release(unsigned index)
+{
+	if (index > 2) {
+		return;
+	}
+	lck_mtx_lock(&scan_lock);
+	scan_reserved &= ~(1u << index);
+	if (scan_mark == (int)index) {
+		scan_mark = -1;
+	}
+	lck_mtx_unlock(&scan_lock);
+}
+
+/*
+ * Frame `index` as the GPU's target (apollo_gpu_present=1, ApolloGPU's kApolloScanout): where it is, its stride (a multiple
+ * of 64: see flip_reserve()), its size, and, if it has one, its address in the kernel (frame 0's is the loader's, which only
+ * MiniIOMobileFramebuffer knows: 0). False: the GPU does not draw the frames (no boot-arg, no flips).
+ */
+bool
+apollo_scanout_gpu_info(unsigned index, uint64_t *phys, uint32_t *stride, uint32_t *width, uint32_t *height, uint64_t *bytes,
+    vm_offset_t *va)
+{
+	if (index > 2 || flip_gpu_stride == 0 || !flip_reserved || !flip_ready()) {
+		return false;
+	}
+	*phys = index == 0 ? fb_phys : flip_phys[index - 1];
+	*stride = flip_gpu_stride;
+	*width = boot_stride / 4;
+	*height = flip_height;
+	*bytes = flip_bytes;
+	*va = index == 0 ? 0 : flip_buf[index - 1];
+	return true;
+}
+
+/*
+ * A free frame for the window server to have the GPU draw into, reserved for it (apollo_scanout_release gives it back, the
+ * flip to it ends the reservation); waits up to timeout_ms for one -- the swaps that are ahead of this frame free them, and
+ * with apollo_flip_latest=1 a queued frame is taken back at once -- and returns -1 if there is none then. Not for the
+ * presenter's thread (it is the one that frees them).
+ */
+int
+apollo_scanout_acquire(uint32_t timeout_ms)
+{
+	uint64_t began = mach_absolute_time(), ns;
+
+	for (;;) {
+		int index;
+
+		lck_mtx_lock(&scan_lock);
+		index = flip_gpu_stride != 0 && flip_reserved ? scan_free(true) : -1;
+		if (index >= 0) {
+			scan_reserved |= 1u << index;
+		}
+		lck_mtx_unlock(&scan_lock);
+		if (index >= 0) {
+			apollo_frames_acquire(mach_absolute_time() - began, true);
+			return index;
+		}
+		absolutetime_to_nanoseconds(mach_absolute_time() - began, &ns);
+		if (flip_gpu_stride == 0 || !flip_reserved || ns / NSEC_PER_MSEC >= timeout_ms) {
+			apollo_frames_acquire(mach_absolute_time() - began, false);
+			return -1;
+		}
+		delay_for_interval(500, NSEC_PER_USEC);
+	}
+}
+
+/* the next SwapEnd with number `swap` is of a frame the GPU has drawn into `index` (taken by apollo_scanout_take_mark) */
+void
+apollo_scanout_mark(unsigned index, uint32_t swap)
+{
+	if (index > 2) {
+		return;
+	}
+	lck_mtx_lock(&scan_lock);
+	if (scan_mark >= 0 && scan_mark != (int)index) {
+		scan_reserved &= ~(1u << scan_mark);    /* (a frame marked and never swapped) */
+	}
+	scan_mark = (int)index;
+	scan_mark_swap = swap;
+	lck_mtx_unlock(&scan_lock);
+}
+
+/* present(): the frame that swap `swap` was drawn into by the GPU, or -1; the reservation goes on until the flip or the release */
+int
+apollo_scanout_take_mark(uint32_t swap, uint32_t surface)
+{
+	int index;
+
+	lck_mtx_lock(&scan_lock);
+	index = scan_mark;
+	scan_mark = -1;
+	/* (the mark is of a swap number, or, with bit 31, of the surface that is the swap's layer 0: userland/src/eagl.c, scan_frame()) */
+	if (index >= 0 && scan_mark_swap != swap &&
+	    !((scan_mark_swap & 0x80000000u) != 0 && surface != 0 && (scan_mark_swap & 0x7fffffffu) == surface)) {
+		scan_reserved &= ~(1u << index);        /* (some other swap: the mark is stale) */
+		index = -1;
+	}
+	lck_mtx_unlock(&scan_lock);
+	return index;
+}
+
+/*
+ * Flip to frame `index`, which was drawn by the CPU (gpu false: the boot stride) or by the GPU (the stride of its rows). Does
+ * not wait: written to the pipe at once if no flip is pending; if one is, written over it (apollo_flip_latest=1, the same
+ * stride: the replaced one held until this one latches) or queued (replacing a frame queued before, which is then free and
+ * never shown) and written by whoever sees the pending one latch first. False: refused (the frame is the front, or the pipe
+ * could not be written): nothing was done, and the frame is still reserved.
+ */
+bool
+apollo_scanout_flip(unsigned index, bool gpu)
+{
+	bool flipped = false;
+	uint64_t now = mach_absolute_time();
+
+	if (index > 2 || (gpu && flip_gpu_stride == 0)) {
+		return false;
+	}
+	lck_mtx_lock(&scan_lock);
+	if (scan_update()) {
+		/* (nothing pending: written now, as before) */
+		if (index != scan_front) {
+			scan_asked_abs[index] = now;
+			flipped = scan_write(index, gpu);
+			if (flipped) {
+				apollo_frames_flip(APOLLO_FRAMES_FLIP_AT_ONCE, 0);
+			}
+		}
+	} else if (index == scan_pending) {
+		flipped = true;                         /* (it is on its way to the panel already) */
+	} else if (index != scan_front && scan_latest && gpu == scan_pending_gpu && !(scan_held & (1u << index))) {
+		/* latest wins on the pipe: SRC0_ADDR written over, the flush bit set again (see the triple buffering's comment) */
+		unsigned replaced = scan_pending;
+
+		scan_asked_abs[index] = now;
+		if (scan_write(index, gpu)) {
+			scan_held |= 1u << replaced;
+			apollo_frames_flip(APOLLO_FRAMES_FLIP_SUPERSEDED, 0);
+			if (scan_queued != SCAN_NONE && scan_queued != index) {
+				apollo_frames_flip(APOLLO_FRAMES_FLIP_REPLACED, 0);    /* (older than this one: never to be shown) */
+			}
+			scan_queued = SCAN_NONE;
+			flipped = true;
+		}
+	} else if (index != scan_front && !(scan_held & (1u << index))) {
+		if (scan_queued != SCAN_NONE && scan_queued != index) {
+			apollo_frames_flip(APOLLO_FRAMES_FLIP_REPLACED, 0);    /* (latest wins: the older is free again) */
+		}
+		scan_queued = index;
+		scan_queued_gpu = gpu;
+		scan_asked_abs[index] = now;
+		apollo_frames_flip(APOLLO_FRAMES_FLIP_QUEUED, 0);
+		flipped = true;
+	}
+	if (flipped) {
+		scan_reserved &= ~(1u << index);
+		thread_wakeup((event_t)&scan_event);
+	}
+	lck_mtx_unlock(&scan_lock);
+	return flipped;
+}
+
+/*
+ * The "apollo flip" thread: while a flip is pending, it looks at the flush bit right after the line where it clears (or every
+ * 250 us until that line is known), so that a queued frame is written at the start of the refresh in which the one before it
+ * latched -- and shown from the next. When to look next, with the lock held; `line` is the line counter at this look.
+ */
+static uint64_t
+scan_next_look(uint64_t now, uint32_t line)
+{
+	uint64_t line_ns = scan_line_ns(), since, ns, written, deadline;
+
+	absolutetime_to_nanoseconds(now - scan_written_abs, &written);
+	if (line_ns == 0 || line >= frame_lines) {
+		ns = SCAN_POLL_NS;
+	} else if (written > FLIP_TIMEOUT_US * NSEC_PER_USEC) {
+		ns = SCAN_STUCK_NS;                     /* (the panel is off, or the timing engine stopped: no frame starts) */
+	} else if (scan_latch_line == SCAN_LINE_UNKNOWN) {
+		ns = SCAN_POLL_NS;
+	} else {
+		since = scan_since_latch_ns(line);
+		if (written > since + SCAN_SHORT_NS && since >= SCAN_WINDOW_NS) {
+			/* written well before this frame's latch line and still pending well after it: the line is not where it clears */
+			scan_latch_line = SCAN_LINE_UNKNOWN;
+			ns = SCAN_POLL_NS;
+		} else if (written > since && since < SCAN_WINDOW_NS) {
+			ns = SCAN_SHORT_NS;             /* (it should clear any moment) */
+		} else {
+			ns = (uint64_t)frame_lines * line_ns - since + SCAN_AFTER_NS;   /* the next frame's latch line, a little after */
+		}
+	}
+	nanoseconds_to_absolutetime(ns, &deadline);
+	return now + deadline;
+}
+
+static void
+scan_thread(void *arg __unused, wait_result_t wr_ __unused)
+{
+	lck_mtx_lock(&scan_lock);
+	for (;;) {
+		uint32_t latches = scan_latches, line;
+		uint64_t now, ns;
+
+		while (scan_pending == SCAN_NONE && scan_queued == SCAN_NONE) {
+			scan_look_abs = 0;
+			assert_wait((event_t)&scan_event, THREAD_UNINT);
+			lck_mtx_unlock(&scan_lock);
+			thread_block(THREAD_CONTINUE_NULL);
+			lck_mtx_lock(&scan_lock);
+			latches = scan_latches;
+		}
+		now = mach_absolute_time();
+		line = rd(intf + INTF_LINE_COUNT);
+		scan_update();
+		/*
+		 * A latch seen by a look that came soon after one which found the flip pending: the bit cleared between the two,
+		 * so at about this line (some 250 us late at most) -- where the thread looks from now on.
+		 */
+		if (scan_latches != latches && scan_look_abs != 0 && line < frame_lines) {
+			absolutetime_to_nanoseconds(now - scan_look_abs, &ns);
+			if (ns < SCAN_POLL_NS + SCAN_POLL_NS / 2 && scan_latch_line == SCAN_LINE_UNKNOWN) {
+				scan_latch_line = line;
+				if (scan_learned++ < 4) {
+					say("apollo flip: the flush bit clears by line %u of %u: flips are looked at there\n", line,
+					    frame_lines);
+				}
+			}
+		}
+		scan_look_abs = scan_pending != SCAN_NONE ? now : 0;
+		if (scan_pending == SCAN_NONE && scan_queued == SCAN_NONE) {
+			continue;
+		}
+		assert_wait_deadline_with_leeway((event_t)&scan_event, THREAD_UNINT, TIMEOUT_URGENCY_SYS_CRITICAL,
+		    scan_next_look(now, line), 0);
+		lck_mtx_unlock(&scan_lock);
+		thread_block(THREAD_CONTINUE_NULL);
+		lck_mtx_lock(&scan_lock);
+	}
+}
+
+/* the presenter used to sleep here until the pending flip had latched; flips are queued now (apollo_scanout_flip): no wait */
+void
+apollo_scanout_wait(uint32_t timeout_us)
+{
+	uint64_t t0 = mach_absolute_time(), ns;
+
+	while (!apollo_scanout_latched()) {
+		absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+		if (ns / 1000 >= timeout_us) {
+			return;
+		}
+		if (timeout_us - ns / 1000 > 2000) {
+			delay_for_interval(1, NSEC_PER_MSEC);
+		}
+	}
+}
+
+unsigned
+apollo_scanout_front(void)
+{
+	return scan_front;
+}
+
+/* ---- start ------------------------------------------------------------------------------------------- */
+
+void
+apollo_display_init(void)
+{
+	uint32_t enable = 0, hz = 0, dump = 0, test = 0, flip_mode = 0;
+	vm_offset_t regs;
+
+	if (!PE_parse_boot_argn("apollo_display", &enable, sizeof(enable)) || enable != 1) {
+		return;
+	}
+	regs = ml_io_map(INTF_PHYS, INTF_SIZE);
+	if (rd(regs + INTF_FRAME_LINE_EN) != 3) {
+		wr(regs + INTF_FRAME_LINE_EN, 3);
+	}
+	intf = regs;
+	read_timing();
+	log_timing();
+	if (hsync_period == 0 || frame_lines == 0) {
+		say("apollo display: the line period reads 0: INTF_1 is not set up, left alone\n");
+		intf = 0;
+		return;
+	}
+	if (!(rd(intf + INTF_STATUS) & INTF_STATUS_RUNNING)) {
+		say("apollo display: the timing engine is not running\n");
+	}
+	measured_mhz = measure();
+	log_rate();
+	find_ctl();
+	/* before any change of the rate: the DPU as the UEFI left it */
+	PE_parse_boot_argn("apollo_dpu_dump", &dump, sizeof(dump));
+	PE_parse_boot_argn("apollo_flip_test", &test, sizeof(test));
+	PE_parse_boot_argn("apollo_flip", &flip_mode, sizeof(flip_mode));
+	if (dump == 1 || test != 0 || flip_mode == 1) {
+		dpu_setup(dump == 1);
+	}
+	if ((test != 0 || flip_mode == 1) && flip_ready()) {
+		flip_reserve();
+	}
+	if (flip_mode == 1 && flip_reserved) {
+		/* the flips of the triple buffering are queued, and written by this thread at the frame start (see apollo_scanout_flip) */
+		uint32_t latest = 1;
+		thread_t thread;
+
+		PE_parse_boot_argn("apollo_flip_latest", &latest, sizeof(latest));
+		scan_latest = latest != 0;
+		if (kernel_thread_start(scan_thread, NULL, &thread) == KERN_SUCCESS) {
+			thread_set_thread_name(thread, "apollo flip");
+			thread_deallocate(thread);
+			say("apollo flip: flips are queued, not waited for; a queued frame is %s\n", scan_latest ?
+			    "taken back for a newer one when no frame is free (apollo_flip_latest=1)" : "never taken back (apollo_flip_latest=0)");
+		} else {
+			say("apollo flip: no thread for the queued flips: they are written when the presenter or the window server looks\n");
+		}
+	}
+	if (test != 0 && flip_mode == 1) {
+		/* the test flips between frames 1 and 2 of the reservation, which apollo_flip=1 draws into and scans out */
+		say("apollo display: apollo_flip_test=%u is not run with apollo_flip=1 (the two share the frames)\n", test);
+	} else if (test != 0 && test <= 600) {
+		thread_t thread;
+
+		flip_test_seconds = test < 2 ? 2 : test;
+		if (kernel_thread_start(flip_test_thread, NULL, &thread) == KERN_SUCCESS) {
+			thread_set_thread_name(thread, "apollo flip test");
+			thread_deallocate(thread);
+			say("apollo flip test: %u s of flips will start %u s from now\n", flip_test_seconds, TEST_DELAY_MS / 1000);
+		}
+	} else if (test != 0) {
+		say("apollo display: apollo_flip_test=%u is not between 1 and 600: ignored\n", test);
+	}
+	if (PE_parse_boot_argn("apollo_display_hz", &hz, sizeof(hz))) {
+		if (hz < 60 || hz > 144) {
+			say("apollo display: apollo_display_hz=%u is not between 60 and 144: ignored\n", hz);
+		} else {
+			set_rate(hz);
+		}
+	}
+}
diff --git a/bsd/dev/hakios.apollo_frames.c b/bsd/dev/hakios.apollo_frames.c
new file mode 100644
index 000000000000..9926d145774c
--- /dev/null
+++ b/bsd/dev/hakios.apollo_frames.c
@@ -0,0 +1,275 @@
+/*
+ * Frame-pacing statistics of the Xiaomi Mi 10T (apollo), with boot-arg apollo_frames=1 (without it nothing is counted or
+ * logged: the hooks return at once). Instrumentation only, no behaviour change.
+ *
+ * Where the numbers are taken (iokit/Kernel/MiniIOMobileFramebuffer.cpp):
+ *   - apollo_frames_swap(): IOMobileFramebuffer::present(), the SwapEnd of CoreAnimation: when a frame arrives, and how
+ *     long that call was blocked because the panel's queue was full (fb_queue).
+ *   - apollo_frames_vsync(): IOMobileFramebufferUserClient::vsync(), one tick of the display link's timer thread-call
+ *     (refreshHz(), 60), delivered to backboardd.
+ *   - apollo_frames_shown(): the end of IOMobileFramebuffer::show(), the presenter thread's work for one frame: the wait
+ *     for the GPU (surface drawn), the wait for the panel's scan to leave the picture (apollo_display_wait_scanout) and
+ *     the CPU copy/scale of the layers into the panel's memory (drawLayer, plus record()). With apollo_flip=1 the flips are
+ *     queued (bsd/dev/hakios.apollo_display.c, apollo_scanout_flip): "scanout-wait" is then only the call that queues one,
+ *     near 0; where the waits went is in the third line.
+ *   - apollo_frames_flip(): hakios.apollo_display.c's triple buffering: each flip written at once (nothing pending) or queued
+ *     behind a pending one; when the queued ones were written (after the frame start: the "apollo flip" thread's promptness,
+ *     a flip written before the next frame start is shown from it); pending flips written over by a newer one (latest wins);
+ *     every latch, and the time from the flip's request to its latch (what a frame waits for the panel once it is drawn: under
+ *     a refresh, half of one on average, is the floor; more than one means frames wait in a queue); queued frames replaced or
+ *     taken back by a newer one (never shown); the presenter finding no frame.
+ *   - apollo_frames_acquire(): the window server's wait for a frame to have the GPU draw into (kScanoutAcquire; eagl.c gives
+ *     up after 50 ms, and the processor draws that swap): the wait the panel puts on CoreAnimation's own thread.
+ * Every 2 seconds in which a frame was presented, three lines "apollo frames: ..." are logged.
+ * With apollo_hitch=1 as well, the swaps and the windows feed the hitch tracer (bsd/dev/hakios.apollo_hitch.c): what the
+ * processors ran in a gap between two swaps, and over the windows.
+ */
+#include <kern/clock.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include <sys/hakios.apollo_input.h>  /* apollo_frames_flip(), apollo_frames_acquire() and their kinds; apollo_hitch_* */
+#include <sys/systm.h>
+
+/* into the loader's log as well (as the other apollo drivers) */
+extern void loader_log_putc(char c);
+
+void apollo_frames_swap(uint64_t blocked_abs);
+void apollo_frames_vsync(void);
+void apollo_frames_shown(uint64_t gpu_abs, uint64_t scan_abs, uint64_t copy_abs, uint32_t on_scan);
+#define FLIP_KINDS      APOLLO_FRAMES_FLIP_KINDS
+#define FLIP_APPLIED    APOLLO_FRAMES_FLIP_APPLIED
+#define FLIP_LATCHED    APOLLO_FRAMES_FLIP_LATCHED
+
+static int say(const char *format, ...) __printflike(1, 2);
+
+static int
+say(const char *format, ...)
+{
+	char line[512];
+	va_list list;
+
+	va_start(list, format);
+	vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
+	for (const char *c = line; *c != 0; c++) {
+		loader_log_putc(*c);
+	}
+	return printf("%s", line);
+}
+
+#define WINDOW_NS       (2ULL * NSEC_PER_SEC)
+
+static int enabled = -1;                        /* -1: boot-arg not read yet */
+
+/* swaps (any thread: atomics; the maxima may race, which is fine for statistics) */
+static uint64_t sw_count, sw_blocked_ns, sw_blocked_max_ns, sw_last_abs;
+static uint64_t sw_gap_sum_ns, sw_gap_max_ns, sw_gap_20, sw_gap_34, sw_gaps;
+static uint64_t sw_blocked_n;
+static uint64_t vsync_ticks;
+
+/* presented frames (the presenter thread only) */
+static uint64_t pr_count, pr_since_abs, pr_last_abs;
+static uint64_t pr_gap_sum_ns, pr_gap_max_ns, pr_gap_20, pr_gap_34, pr_gaps;
+static uint64_t pr_gpu_ns, pr_scan_ns, pr_copy_ns, pr_total_max_ns, pr_gpu_max_ns, pr_scan_max_ns, pr_copy_max_ns;
+static uint64_t pr_on_scan;
+
+/* flips (under hakios.apollo_display.c's scan_lock: one at a time; taken by the report with atomics) and the window server's waits */
+static uint64_t fl_count[FLIP_KINDS], fl_sum_ns[FLIP_KINDS], fl_max_ns[FLIP_KINDS];
+static uint64_t aq_count, aq_sum_ns, aq_max_ns, aq_waited, aq_failed;
+
+static bool
+on(void)
+{
+	if (enabled < 0) {
+		uint32_t value = 0;
+
+		enabled = PE_parse_boot_argn("apollo_frames", &value, sizeof(value)) && value == 1;
+		if (enabled) {
+			say("apollo frames: statistics on (every 2 s in which a frame was presented)\n");
+		}
+	}
+	return enabled > 0;
+}
+
+static inline uint64_t
+ns_of(uint64_t abs)
+{
+	uint64_t ns;
+
+	absolutetime_to_nanoseconds(abs, &ns);
+	return ns;
+}
+
+static inline void
+max_to(uint64_t *where, uint64_t value)
+{
+	if (value > *where) {
+		*where = value;
+	}
+}
+
+void
+apollo_frames_vsync(void)
+{
+	if (on()) {
+		__atomic_fetch_add(&vsync_ticks, 1, __ATOMIC_RELAXED);
+	}
+}
+
+void
+apollo_frames_flip(unsigned what, uint64_t ns)
+{
+	if (!on() || what >= FLIP_KINDS) {
+		return;
+	}
+	__atomic_fetch_add(&fl_count[what], 1, __ATOMIC_RELAXED);
+	__atomic_fetch_add(&fl_sum_ns[what], ns, __ATOMIC_RELAXED);
+	max_to(&fl_max_ns[what], ns);
+}
+
+void
+apollo_frames_acquire(uint64_t wait_abs, bool got)
+{
+	uint64_t ns;
+
+	if (!on()) {
+		return;
+	}
+	ns = ns_of(wait_abs);
+	__atomic_fetch_add(&aq_count, 1, __ATOMIC_RELAXED);
+	__atomic_fetch_add(&aq_sum_ns, ns, __ATOMIC_RELAXED);
+	__atomic_fetch_add(&aq_waited, ns > 500 * NSEC_PER_USEC, __ATOMIC_RELAXED);
+	__atomic_fetch_add(&aq_failed, !got, __ATOMIC_RELAXED);
+	max_to(&aq_max_ns, ns);
+}
+
+void
+apollo_frames_swap(uint64_t blocked_abs)
+{
+	uint64_t now, last, gap, blocked;
+
+	if (!on()) {
+		return;
+	}
+	now = mach_absolute_time();
+	last = sw_last_abs;
+	sw_last_abs = now;
+	__atomic_fetch_add(&sw_count, 1, __ATOMIC_RELAXED);
+	if (last != 0) {
+		gap = ns_of(now - last);
+		if (gap < 500 * NSEC_PER_MSEC) {        /* (a pause with nothing moving is not a late frame) */
+			__atomic_fetch_add(&sw_gap_sum_ns, gap, __ATOMIC_RELAXED);
+			__atomic_fetch_add(&sw_gaps, 1, __ATOMIC_RELAXED);
+			__atomic_fetch_add(&sw_gap_20, gap > 20 * NSEC_PER_MSEC, __ATOMIC_RELAXED);
+			__atomic_fetch_add(&sw_gap_34, gap > 34 * NSEC_PER_MSEC, __ATOMIC_RELAXED);
+			max_to(&sw_gap_max_ns, gap);
+		}
+		apollo_hitch_swap(last, now);           /* (apollo_hitch=1: a gap over apollo_hitch_ms is looked into) */
+	}
+	if (blocked_abs != 0) {
+		blocked = ns_of(blocked_abs);
+		__atomic_fetch_add(&sw_blocked_ns, blocked, __ATOMIC_RELAXED);
+		__atomic_fetch_add(&sw_blocked_n, 1, __ATOMIC_RELAXED);
+		max_to(&sw_blocked_max_ns, blocked);
+	}
+}
+
+void
+apollo_frames_shown(uint64_t gpu_abs, uint64_t scan_abs, uint64_t copy_abs, uint32_t on_scan)
+{
+	uint64_t now, gpu, scan, copy, total, window;
+
+	if (!on()) {
+		return;
+	}
+	now = mach_absolute_time();
+	gpu = ns_of(gpu_abs);
+	scan = ns_of(scan_abs);
+	copy = ns_of(copy_abs);
+	total = gpu + scan + copy;
+	if (pr_since_abs == 0) {
+		pr_since_abs = now;
+		apollo_hitch_window(true, 0);
+	}
+	pr_count++;
+	pr_gpu_ns += gpu;
+	pr_scan_ns += scan;
+	pr_copy_ns += copy;
+	pr_on_scan += on_scan;
+	max_to(&pr_gpu_max_ns, gpu);
+	max_to(&pr_scan_max_ns, scan);
+	max_to(&pr_copy_max_ns, copy);
+	max_to(&pr_total_max_ns, total);
+	if (pr_last_abs != 0) {
+		uint64_t gap = ns_of(now - pr_last_abs);
+
+		if (gap < 500 * NSEC_PER_MSEC) {
+			pr_gap_sum_ns += gap;
+			pr_gaps++;
+			pr_gap_20 += gap > 20 * NSEC_PER_MSEC;
+			pr_gap_34 += gap > 34 * NSEC_PER_MSEC;
+			max_to(&pr_gap_max_ns, gap);
+		}
+	}
+	pr_last_abs = now;
+	window = ns_of(now - pr_since_abs);
+	if (window < WINDOW_NS) {
+		return;
+	}
+	{
+		uint64_t n = pr_count, g = pr_gaps ? pr_gaps : 1, sn = __atomic_exchange_n(&sw_count, 0, __ATOMIC_RELAXED);
+		uint64_t sg = __atomic_exchange_n(&sw_gaps, 0, __ATOMIC_RELAXED);
+		uint64_t sgsum = __atomic_exchange_n(&sw_gap_sum_ns, 0, __ATOMIC_RELAXED);
+		uint64_t sgmax = __atomic_exchange_n(&sw_gap_max_ns, 0, __ATOMIC_RELAXED);
+		uint64_t sg20 = __atomic_exchange_n(&sw_gap_20, 0, __ATOMIC_RELAXED);
+		uint64_t sg34 = __atomic_exchange_n(&sw_gap_34, 0, __ATOMIC_RELAXED);
+		uint64_t sbn = __atomic_exchange_n(&sw_blocked_n, 0, __ATOMIC_RELAXED);
+		uint64_t sb = __atomic_exchange_n(&sw_blocked_ns, 0, __ATOMIC_RELAXED);
+		uint64_t sbmax = __atomic_exchange_n(&sw_blocked_max_ns, 0, __ATOMIC_RELAXED);
+		uint64_t ticks = __atomic_exchange_n(&vsync_ticks, 0, __ATOMIC_RELAXED);
+
+		say("apollo frames: presented %llu in %llu ms = %llu.%02llu fps; interval mean %llu.%02llu max %llu.%02llu ms, "
+		    ">20 ms: %llu, >34 ms: %llu; present path per frame (mean/max us): total %llu/%llu = gpu-wait %llu/%llu + "
+		    "scanout-wait %llu/%llu (%llu on scan) + copy %llu/%llu; vsync ticks %llu (%llu/s)\n",
+		    n, window / NSEC_PER_MSEC, n * 1000000000ULL / window, (n * 100000000000ULL / window) % 100,
+		    pr_gap_sum_ns / g / NSEC_PER_MSEC, (pr_gap_sum_ns / g / 10000) % 100,
+		    pr_gap_max_ns / NSEC_PER_MSEC, (pr_gap_max_ns / 10000) % 100, pr_gap_20, pr_gap_34,
+		    (pr_gpu_ns + pr_scan_ns + pr_copy_ns) / n / 1000, pr_total_max_ns / 1000, pr_gpu_ns / n / 1000,
+		    pr_gpu_max_ns / 1000, pr_scan_ns / n / 1000, pr_scan_max_ns / 1000, pr_on_scan, pr_copy_ns / n / 1000,
+		    pr_copy_max_ns / 1000, ticks, ticks * 1000000000ULL / window);
+		say("apollo frames: swaps in %llu (CA arrival) interval mean %llu.%02llu max %llu.%02llu ms, >20 ms: %llu, "
+		    ">34 ms: %llu; swap blocked on a full queue %llu times, %llu us total, max %llu us\n", sn,
+		    sgsum / (sg ? sg : 1) / NSEC_PER_MSEC, (sgsum / (sg ? sg : 1) / 10000) % 100, sgmax / NSEC_PER_MSEC,
+		    (sgmax / 10000) % 100, sg20, sg34, sbn, sb / 1000, sbmax / 1000);
+	}
+	{
+		uint64_t c[FLIP_KINDS], sum[FLIP_KINDS], mx[FLIP_KINDS];
+		uint64_t an = __atomic_exchange_n(&aq_count, 0, __ATOMIC_RELAXED);
+		uint64_t asum = __atomic_exchange_n(&aq_sum_ns, 0, __ATOMIC_RELAXED);
+		uint64_t amax = __atomic_exchange_n(&aq_max_ns, 0, __ATOMIC_RELAXED);
+		uint64_t awaited = __atomic_exchange_n(&aq_waited, 0, __ATOMIC_RELAXED);
+		uint64_t afailed = __atomic_exchange_n(&aq_failed, 0, __ATOMIC_RELAXED);
+
+		for (unsigned k = 0; k < FLIP_KINDS; k++) {
+			c[k] = __atomic_exchange_n(&fl_count[k], 0, __ATOMIC_RELAXED);
+			sum[k] = __atomic_exchange_n(&fl_sum_ns[k], 0, __ATOMIC_RELAXED);
+			mx[k] = __atomic_exchange_n(&fl_max_ns[k], 0, __ATOMIC_RELAXED);
+		}
+		say("apollo frames: flips %llu at once + %llu over a pending one + %llu queued (written %llu/%llu us after the frame "
+		    "start, mean/max), %llu queued replaced and %llu taken back (not shown), %llu failed; %llu latched (%llu/s), "
+		    "asked -> latched %llu/%llu us; presenter found no frame %llu times; window server's acquire %llu, waited "
+		    "%llu/%llu us (mean/max), %llu over 0.5 ms, %llu none in time\n", c[APOLLO_FRAMES_FLIP_AT_ONCE],
+		    c[APOLLO_FRAMES_FLIP_SUPERSEDED], c[APOLLO_FRAMES_FLIP_QUEUED],
+		    sum[FLIP_APPLIED] / (c[FLIP_APPLIED] ? c[FLIP_APPLIED] : 1) / 1000, mx[FLIP_APPLIED] / 1000,
+		    c[APOLLO_FRAMES_FLIP_REPLACED], c[APOLLO_FRAMES_FLIP_TAKEN_BACK], c[APOLLO_FRAMES_FLIP_FAILED],
+		    c[FLIP_LATCHED], c[FLIP_LATCHED] * 1000000000ULL / window,
+		    sum[FLIP_LATCHED] / (c[FLIP_LATCHED] ? c[FLIP_LATCHED] : 1) / 1000, mx[FLIP_LATCHED] / 1000,
+		    c[APOLLO_FRAMES_FLIP_NONE_FREE], an, asum / (an ? an : 1) / 1000, amax / 1000, awaited, afailed);
+	}
+	apollo_hitch_window(false, window);
+	pr_count = pr_since_abs = 0;
+	pr_gap_sum_ns = pr_gap_max_ns = pr_gap_20 = pr_gap_34 = pr_gaps = 0;
+	pr_gpu_ns = pr_scan_ns = pr_copy_ns = pr_total_max_ns = pr_gpu_max_ns = pr_scan_max_ns = pr_copy_max_ns = 0;
+	pr_on_scan = 0;
+}
diff --git a/bsd/dev/hakios.apollo_guard.c b/bsd/dev/hakios.apollo_guard.c
new file mode 100644
index 000000000000..8dbd310df3e5
--- /dev/null
+++ b/bsd/dev/hakios.apollo_guard.c
@@ -0,0 +1,326 @@
+/*
+ * The Xiaomi Mi 10T's (apollo) speakers' guard: a copy of bsd/dev/hakios.guard.c, kept apart from it so that its
+ * limits can follow apollo's CS35L41s (bsd/dev/hakios.apollo_cs35l41.c) rather than redwood's Awinic amplifiers. As yet the
+ * numbers are redwood's: they are reckoned at Android's digital level. By default apollo's amplifiers play 20 dB under it
+ * (apollo_sound_below, default 160) with their analog gain at 12 of Android's 18; apollo_sound_below=0 brings the digital
+ * level up to Android's, and then only these limits -- not Cirrus's protection firmware, which does not run -- stand
+ * between the samples and the speakers (hakios.apollo_sound.c).
+ */
+/*
+ * The speakers' guard: what the samples go through on their way to the phone's two amplifiers
+ * (bsd/dev/hakios.sound.c's feeder), in place of the protection Android has in the audio DSP.
+ *
+ * Under Android the DSP runs Awinic's algorithm (SKTune, "aw882xx_rx_switch") with each
+ * speaker's calibration: it keeps the cone's excursion and the voice coil's temperature in
+ * bounds, measuring both through the amplifiers' current and voltage feedback. None of that runs
+ * here, and nothing here knows the speakers' parameters (Android's files that can be read have
+ * none: the amplifiers' register profile, the battery tables of its "monitor", and in the device
+ * tree a range of 4 to 9 ohms for the calibrated resistance). So the guard holds what reaches the
+ * speakers to levels that are safe for small phone speakers whatever they are exactly, measured
+ * the only way there is without feedback -- from the samples and the amplifiers' level -- and
+ * kept well under what the speakers can take at Android's level:
+ *
+ *   high-pass  a second-order Butterworth filter at 200 Hz: a phone's speaker gives out next to
+ *              nothing below its resonance (several hundred Hz), and what it is given there only
+ *              moves the cone further and heats the coil
+ *   power      the power that would reach a speaker, averaged three ways -- over 0.2 s (the
+ *              cone and coil at once), 3 s (the voice coil's warming) and 60 s (the magnet and
+ *              the frame) -- and the level turned down so that none of the three averages goes
+ *              over its limit: 3, 6 and 9 dB under the power of a full-scale sine at Android's
+ *              level. Sound of ordinary loudness never comes near them; a sustained full-scale
+ *              tone is turned down at once to the first, after seconds to the second and over a
+ *              minute to the third, and the level comes back up as the averages fall, as a
+ *              speaker cools. The averages go on falling while the amplifiers are off.
+ *   peaks      no sample above 3 dB under full scale at Android's level: a limiter that turns
+ *              the level down at the sample that would go over (so none does) and lets it come
+ *              back with a time constant of 43 ms
+ *   monitor    a further reduction that the amplifiers' watch asks for (on apollo
+ *              hakios.apollo_cs35l41.c's apollo_cs35l41_monitor(): 6 dB for the rest of the run
+ *              once either amplifier has raised its temperature warning, TEMP_WARN)
+ *
+ * Before all that, a gain (sound_gain, at most 12 dB): iOS's own processing for the iPhone X's
+ * speaker keeps even a full-scale tone at its top volume 12.6 to 14.3 dB under full scale, so
+ * without it iOS at the top would stay that much under Android at the top. What it lifts over
+ * full scale is held to full scale by the peak limiter (or to its lower limit), never clipped.
+ *
+ * All the limits are in terms of the speakers: a signal at full scale with the amplifiers at
+ * Android's level (the loudest they are ever set to) is 0 dB. With the amplifiers turned down
+ * (sound_below) the same samples are that much quieter at the speakers, and the guard holds them
+ * back only that much later. Everything is integer arithmetic (the kernel's threads do no
+ * floating point); fractions are in Q30 unless said otherwise.
+ *
+ * One caller at a time (the feeder); apollo_guard_attenuation() and apollo_guard_monitor() may
+ * be called from another thread.
+ */
+#include <stdbool.h>
+#include <stdint.h>
+#include <sys/hakios.apollo_audio.h>
+
+#define ONE                     (1ll << 30)
+#define FULL_SCALE              32768
+
+/* The limits, in eighths of a dB under full scale at Android's level (powers: under a full-scale square wave's) */
+#define PEAK_LIMIT              (3 * 8)
+#define RMS_LIMIT               (6 * 8)         /* a full-scale sine is 3 dB under a square wave: these are 3, 6, 9 dB under it */
+#define FAST_LIMIT              (9 * 8)
+#define SLOW_LIMIT              (12 * 8)
+/* ... and the averages' time constants, in frames (48 kHz) */
+#define RMS_FRAMES              9600            /* 0.2 s */
+#define FAST_FRAMES             144000          /* 3 s */
+#define SLOW_FRAMES             2880000         /* 60 s */
+#define RELEASE_SHIFT           11              /* the peak limiter lets go with a time constant of 2048 frames, 43 ms */
+#define MAX_FRAMES              1024            /* the most frames processed at once (the feeder's period: 960) */
+
+/* 10^(-n/160), n = 0..47, in Q30: an attenuation of n eighths of a dB, as a factor of amplitude */
+static const uint32_t eighths[48] = {
+	1073741824, 1058400094, 1043277569, 1028371116, 1013677647, 999194121, 984917536, 970844937, 956973408, 943300077,
+	929822112, 916536722, 903441154, 890532697, 877808678, 865266461, 852903448, 840717079, 828704830, 816864213,
+	805192776, 793688102, 782347808, 771169545, 760150998, 749289885, 738583957, 728030996, 717628817, 707375265,
+	697268218, 687305580, 677485290, 667805313, 658263644, 648858308, 639587356, 630448869, 621440953, 612561743,
+	603809400, 595182112, 586678091, 578295576, 570032831, 561888146, 553859832, 545946228,
+};
+#define SIX_DB                  538145694       /* 10^(-6/20) in Q30 */
+
+/* the high-pass filter, 200 Hz at 48 kHz, Q = 1/sqrt(2): b0, b1, b2, a1, a2 in Q30 (RBJ's cookbook) */
+static const int64_t hpf_b0 = 1054047540, hpf_b1 = -2108095079, hpf_b2 = 1054047540;
+static const int64_t hpf_a1 = -2107733822, hpf_a2 = 1034714513;
+
+static struct {
+	bool hpf;
+	uint64_t gain;                          /* the gain before everything, Q30 (1 to 4) */
+	volatile uint32_t attenuation;          /* the amplifiers' level under Android's, eighths of a dB; APOLLO_GUARD_SILENT: off */
+	volatile uint32_t monitor;              /* the monitor's reduction, eighths of a dB */
+	int64_t x1[2], x2[2], y1[2], y2[2];     /* the filter's past, in 1/256 of a sample */
+	uint64_t rms[2], fast[2], slow[2];      /* average powers at each speaker, Q30 of a full-scale square wave at Android's level */
+	uint64_t level;                         /* the power guard's and the monitor's gain at the end of the last block */
+	uint64_t envelope;                      /* the peak limiter's, 1/65536 of a sample */
+	struct apollo_guard_report report;
+} guard = { .hpf = true, .attenuation = APOLLO_GUARD_SILENT, .gain = ONE, .level = ONE, .report = { .least_gain = ONE, .least_peak_gain = 65536 } };
+
+static int32_t work[2 * MAX_FRAMES];
+
+/* 10^(-n/160) in Q30: n eighths of a dB under, as a factor of amplitude */
+static uint64_t
+amplitude(uint32_t n)
+{
+	uint64_t value = eighths[n % 48];
+
+	for (uint32_t i = 0; i < n / 48 && value != 0; i++) {
+		value = value * SIX_DB >> 30;
+	}
+	return value;
+}
+
+static uint64_t
+isqrt(uint64_t value)
+{
+	uint64_t root = 0, bit = 1ull << 62;
+
+	while (bit > value) {
+		bit >>= 2;
+	}
+	while (bit != 0) {
+		if (value >= root + bit) {
+			value -= root + bit;
+			root = (root >> 1) + bit;
+		} else {
+			root >>= 1;
+		}
+		bit >>= 2;
+	}
+	return root;
+}
+
+/* how much of `limit' a power is, as the square of the gain that would bring it down to it (Q30, at most 1) */
+static uint64_t
+headroom(uint64_t power, uint64_t limit)
+{
+	if (power <= limit) {
+		return ONE;
+	}
+	return (limit << 30) / power;
+}
+
+void
+apollo_guard_configure(bool hpf, uint32_t gain)
+{
+	guard.hpf = hpf;
+	/* 10^(gain/160): one over the attenuation by as much */
+	guard.gain = (1ull << 60) / amplitude(gain > APOLLO_GUARD_MAX_GAIN ? APOLLO_GUARD_MAX_GAIN : gain);
+}
+
+void
+apollo_guard_attenuation(uint32_t below)
+{
+	guard.attenuation = below;
+}
+
+void
+apollo_guard_monitor(uint32_t below)
+{
+	guard.monitor = below;
+}
+
+static void
+block(int16_t *frames, uint32_t count)
+{
+	uint32_t attenuation = guard.attenuation;
+	struct apollo_guard_report *r = &guard.report;
+	/* (the power's attenuation is twice the amplitude's: kept from wrapping, which would make a quiet level a loud one) */
+	uint64_t to_speaker = attenuation == APOLLO_GUARD_SILENT ? 0 :
+	    amplitude(attenuation > UINT32_MAX / 2 ? UINT32_MAX : 2 * attenuation);
+	uint64_t sum[2] = { 0, 0 }, g2 = ONE, g, start = guard.level, ceiling;
+	uint32_t binding = 0;
+
+	/* the high-pass filter, and what comes out of it: its power, per channel */
+	for (uint32_t i = 0; i < 2 * count; i++) {
+		unsigned c = i & 1;
+		int64_t x = (int64_t)frames[i] * (int64_t)guard.gain >> 22, y;    /* (the gain, and 1/256 of a sample) */
+		uint32_t level = frames[i] < 0 ? (uint32_t)-frames[i] : (uint32_t)frames[i];
+
+		if (level > r->peak_in) {
+			r->peak_in = level;
+		}
+		if (guard.hpf) {
+			y = (hpf_b0 * x + hpf_b1 * guard.x1[c] + hpf_b2 * guard.x2[c] - hpf_a1 * guard.y1[c] - hpf_a2 * guard.y2[c]) >> 30;
+			guard.x2[c] = guard.x1[c];
+			guard.x1[c] = x;
+			guard.y2[c] = guard.y1[c];
+			guard.y1[c] = y;
+		} else {
+			y = x;
+		}
+		work[i] = (int32_t)((y + 128) >> 8);
+		sum[c] += (uint64_t)((int64_t)work[i] * work[i]);
+	}
+
+	/* the averages at the speakers, and the gain that keeps all three under their limits */
+	for (unsigned c = 0; c < 2; c++) {
+		/* the block's power, Q30 of full scale (a square wave at 32768), then as it reaches the speaker */
+		uint64_t power = (uint64_t)((unsigned __int128)(sum[c] / count) * to_speaker >> 30), h;
+
+		guard.rms[c] = (uint64_t)((int64_t)guard.rms[c] + ((int64_t)power - (int64_t)guard.rms[c]) * count / RMS_FRAMES);
+		guard.fast[c] = (uint64_t)((int64_t)guard.fast[c] + ((int64_t)power - (int64_t)guard.fast[c]) * count / FAST_FRAMES);
+		guard.slow[c] = (uint64_t)((int64_t)guard.slow[c] + ((int64_t)power - (int64_t)guard.slow[c]) * count / SLOW_FRAMES);
+		if ((h = headroom(guard.rms[c], amplitude(2 * RMS_LIMIT))) < g2) {
+			g2 = h;
+			binding = 1;
+		}
+		if ((h = headroom(guard.fast[c], amplitude(2 * FAST_LIMIT))) < g2) {
+			g2 = h;
+			binding = 2;
+		}
+		if ((h = headroom(guard.slow[c], amplitude(2 * SLOW_LIMIT))) < g2) {
+			g2 = h;
+			binding = 3;
+		}
+	}
+	g = isqrt(g2 << 30) * amplitude(guard.monitor) >> 30;
+	if (g > ONE) {
+		g = ONE;
+	}
+	r->blocks++;
+	if (binding == 1) {
+		r->rms_blocks++;
+	} else if (binding == 2) {
+		r->fast_blocks++;
+	} else if (binding == 3) {
+		r->slow_blocks++;
+	}
+	if (g < r->least_gain) {
+		r->least_gain = g;
+	}
+
+	/* the peaks: no sample over the limit at the speaker (and none over full scale) */
+	ceiling = FULL_SCALE - 1;
+	if (attenuation != APOLLO_GUARD_SILENT && attenuation < PEAK_LIMIT) {
+		ceiling = (uint64_t)FULL_SCALE * amplitude(PEAK_LIMIT - attenuation) >> 30;
+	}
+	for (uint32_t f = 0; f < count; f++) {
+		/* (the power guard's gain moves from the last block's to this one's across the block) */
+		uint64_t gain = (uint64_t)((int64_t)start + ((int64_t)g - (int64_t)start) * (int64_t)(f + 1) / (int64_t)count);
+		int64_t y[2];
+		uint64_t level, peak_gain = 65536;
+
+		for (unsigned c = 0; c < 2; c++) {
+			y[c] = (int64_t)work[2 * f + c] * (int64_t)gain >> 30;
+		}
+		level = (uint64_t)(y[0] < 0 ? -y[0] : y[0]);
+		if ((uint64_t)(y[1] < 0 ? -y[1] : y[1]) > level) {
+			level = (uint64_t)(y[1] < 0 ? -y[1] : y[1]);
+		}
+		guard.envelope -= guard.envelope >> RELEASE_SHIFT;
+		if (level << 16 > guard.envelope) {
+			guard.envelope = level << 16;
+		}
+		if (guard.envelope > ceiling << 16) {
+			peak_gain = (ceiling << 32) / guard.envelope;
+			r->limited_frames++;
+			if (peak_gain < r->least_peak_gain) {
+				r->least_peak_gain = (uint32_t)peak_gain;
+			}
+		}
+		for (unsigned c = 0; c < 2; c++) {
+			int64_t out = y[c] * (int64_t)peak_gain >> 16;
+			uint32_t magnitude;
+
+			out = out > FULL_SCALE - 1 ? FULL_SCALE - 1 : out < -FULL_SCALE ? -FULL_SCALE : out;
+			frames[2 * f + c] = (int16_t)out;
+			magnitude = (uint32_t)(out < 0 ? -out : out);
+			if (magnitude > r->peak_out) {
+				r->peak_out = magnitude;
+			}
+		}
+	}
+	guard.level = g;
+	r->gain = g;
+	r->rms = guard.rms[0] > guard.rms[1] ? guard.rms[0] : guard.rms[1];
+	r->fast = guard.fast[0] > guard.fast[1] ? guard.fast[0] : guard.fast[1];
+	r->slow = guard.slow[0] > guard.slow[1] ? guard.slow[0] : guard.slow[1];
+}
+
+void
+apollo_guard_process(int16_t *frames, uint32_t count)
+{
+	while (count > 0) {
+		uint32_t n = count < MAX_FRAMES ? count : MAX_FRAMES;
+
+		block(frames, n);
+		frames += 2 * n;
+		count -= n;
+	}
+}
+
+/* What has happened since the last call (and the averages and the gain as they are now). */
+void
+apollo_guard_take_report(struct apollo_guard_report *report)
+{
+	*report = guard.report;
+	guard.report = (struct apollo_guard_report){ .least_gain = ONE, .least_peak_gain = 65536 };
+}
+
+/* 10 log10 of a Q30 ratio, in tenths of a dB (for what is said) */
+int
+apollo_guard_decibels(uint64_t ratio)
+{
+	static const uint16_t fraction[17] = {
+		0, 5732, 11136, 16248, 21098, 25711, 30109, 34312, 38336, 42196, 45904, 49472, 52911, 56229, 59434, 62534, 65535,
+	};
+	int64_t log2;                           /* Q16 */
+	unsigned top = 63;
+
+	if (ratio == 0) {
+		return -999;
+	}
+	while (!(ratio >> top)) {
+		top--;
+	}
+	{
+		/* the 4 bits under the top one choose a segment, the next 12 where in it */
+		uint64_t mantissa = top >= 16 ? ratio >> (top - 16) : ratio << (16 - top);
+		unsigned index = (unsigned)(mantissa >> 12) & 15, within = (unsigned)mantissa & 4095;
+
+		log2 = ((int64_t)top - 30) * 65536 + fraction[index] + (int64_t)(fraction[index + 1] - fraction[index]) * within / 4096;
+	}
+	return (int)(log2 * 30103 / 65536 / 1000);
+}
diff --git a/bsd/dev/hakios.apollo_haptic.c b/bsd/dev/hakios.apollo_haptic.c
new file mode 100644
index 000000000000..c927a0fcbd0f
--- /dev/null
+++ b/bsd/dev/hakios.apollo_haptic.c
@@ -0,0 +1,1324 @@
+/*
+ * The vibration motor of the Xiaomi Mi 10T (apollo): a linear resonant actuator driven by an Awinic AW8697 (chip ID
+ * 0x97 in register 0), Android's "aw8697_haptic" (Xiaomi's driver drivers/input/misc/aw8697_haptic/aw8697.c of the
+ * apollo-q-oss kernel). This is hakios.haptic.c's service (what iOS plays on its "Actuator" device arrives at
+ * /dev/apollo-haptic as samples and is played as Android's waveforms), for another chip on another bus. From the
+ * phone's own device tree (//soc/i2c@a8c000/aw8697_haptic@5A):
+ *
+ *   I2C        the serial engine 11 = the sixth of the second QUPv3 wrapper (qupv3_se11_i2c at 0xa8c000; the
+ *              wrapper's core at 0xac0000): function qup11 (1) on GPIO 60 data and 61 clock, 2 mA, no pull, address
+ *              0x5a; 400 kHz through the serial engine's FIFO as in hakios.apollo_cs35l41.c
+ *   reset      GPIO 130, high = running (Android's hw_reset: low 5 ms, high 5 ms)
+ *   interrupt  GPIO 129, pulled up (not used: polled)
+ *   effects    Android's RAM waveforms, aw8697_haptic.bin (fw/ of the small image): 1..10 short (Android's effects
+ *              0..9: vib_effect_id_boundary 0xa), 11 the one Android repeats forever for a long vibration
+ *
+ * Nothing here is done unless the boot-arg apollo_haptic=N asks for it (N as redwood's haptic=N):
+ *
+ *   1  a look, reading only: the pins, and whether the chip answers (its ID, 0x97). Out of the firmware the reset
+ *      pin is an input with a pull-down: the chip is held in reset and does not answer.
+ *   2  ... and the reset released as Android's driver releases it, and the chip's registers read (nothing written)
+ *   3  ... and Android's configuration written (aw8697_haptic_init), Android's waveforms loaded into the chip's RAM
+ *      and read back; then standby. Nothing moves.
+ *   4  ... and one short effect played (apollo_haptic_effect=N, default 1: Android's effect 0)
+ *   5  ... configured and loaded as for 3, and the motor for iOS until the run ends: /dev/apollo-haptic (mode 0666)
+ *      takes int16 mono 48 kHz samples as /dev/hakios-haptic does; a waveform of iOS's (a stretch of samples after
+ *      a pause) is a tap (waveform 1), one that goes on for longer than a tap the looping waveform (11) until it
+ *      ends -- HAPTIC_MAX_MS at most, then the motor rests as long. The gain follows the loudness (gain_for()).
+ *      Taps and vibrations together drive the motor HAPTIC_MAX_MS at most in any DUTY_WINDOW_MS (2 s): past that
+ *      it is stopped and rests HAPTIC_MAX_MS, and nothing starts until the window has room again.
+ *
+ * Limits, whatever asks: Android's own values only (gain 0x80 at the most, its boost settings, its waveforms); no
+ * effect longer than HAPTIC_MAX_MS, no more than HAPTIC_MAX_MS of driving in any DUTY_WINDOW_MS; any fault the chip
+ * reports (boost short circuit or over-voltage, under-voltage, over-current, over-temperature), a byte nobody acknowledges or a RAM that does not read back, and the chip is put
+ * into reset for the rest of the run. At the run's end and on a panic's way out the chip goes back into reset.
+ *
+ * Taken from Android's driver (aw8697.c, apollo-q-oss), function by function:
+ *   aw8697_hw_reset            reset low 5 ms, high 5 ms
+ *   aw8697_read_chipid         REG_ID (0x00) = 0x97, then aw8697_haptic_softreset: REG_ID <- 0xaa, 1 ms
+ *   aw8697_haptic_init         standby; PWMDBG[6:5] = 2 (24 kHz); BSTDBG1..3 <- DT vib_bstdbg 0x30 0xeb 0xd4; TSET <-
+ *                              0x12; R_SPARE <- 0x68; ANADBG[3:2] = 3; BSTCFG[2:0] = 5 (3.5 A); motor protection off
+ *                              (DETCTRL[5] = 1, PWMPRC[7] = 0, PRLVL[7] = 0); BST_AUTO[2] = 0; offset calibration;
+ *                              ADCTEST[6] = 1 (vbat hardware compensation); BEMF_VTH <- DT vib_bemf_config
+ *   aw8697_container_update    RAMINIT (SYSCTRL[5]) on; BASE_ADDRH/L <- the file's bytes 2, 3; FIFO_AE/AF from the
+ *                              base address; RAMADDRH/L <- the same; the file from byte 4 on into RAMDATA; RAMINIT off
+ *   aw8697_ram_loaded          the file's first two bytes: the sum of all the others (16 bits)
+ *   aw8697_haptic_play_effect_seq / _play_mode / _play_go / _set_wav_seq / _set_wav_loop /
+ *   _set_repeat_wav_seq / _set_gain / _set_bst_vol
+ *                              WAVSEQ1 (0x07) <- waveform, WAVSEQ2 <- 0, WAVLOOP1 (0x0f) <- 0 (once) or 0xf0 (forever),
+ *                              SYSCTRL: RAM mode, active, boost (once) or bypass (looped); DATDBG (0x39) <- gain;
+ *                              BSTDBG4[5:1] <- DT vib_bst_vol_ram 0x11; GO (0x05) <- 1
+ *   aw8697_haptic_stop         GO <- 0, until GLB_STATE (0x46) & 0xf is 0, then SYSCTRL[0] = 1 (standby)
+ */
+#include <kern/clock.h>
+#include <kern/kalloc.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <miscfs/devfs/devfs.h>
+#include <sys/conf.h>
+#include <sys/systm.h>
+#include <sys/uio.h>
+#include <sys/hakios.apollo_input.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern kern_return_t thread_terminate(thread_t thread);
+extern void loader_log_putc(char c);
+extern const uint8_t *hakios_image_file(const char *dir, const char *name, uint64_t *size, int *disk_out);
+
+static uint32_t stage;
+static bool broken, released, leaving, prepared;
+
+/* every line to the loader's log as well (and to the console when that may be written) */
+extern bool apollo_rpmh_bcm_vote(const char *name, uint32_t ab, uint32_t ib);    /* hakios.apollo_cpufreq.c */
+extern void apollo_cmd_db_dump(void);
+static bool bringing_up;                /* the chip's bring-up: every line waits pause_ms */
+static uint32_t pause_ms = 400;
+static uint32_t start_after_ms = 15000;  /* (the start's flood of lines over first: apollo_haptic_after=MS) */
+static int say(const char *format, ...) __printflike(1, 2);
+
+static int
+say(const char *format, ...)
+{
+	char line[300];
+	va_list list;
+	int length;
+
+	va_start(list, format);
+	length = vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
+	for (const char *c = line; *c != 0; c++) {
+		loader_log_putc(*c);
+	}
+	if (!leaving && ml_get_interrupts_enabled()) {
+		printf("%s", line);
+		/*
+		 * The first runs reset the phone without a word (25 October): while the chip is being brought up, every line
+		 * is given time to reach the loader before the next access (apollo_haptic_pause=MS, 0: none).
+		 */
+		if (bringing_up && pause_ms) {
+			delay_for_interval(pause_ms, 1000 * NSEC_PER_USEC);
+		}
+	}
+	return length;
+}
+
+static inline uint32_t
+rd(vm_offset_t address)
+{
+	return *(volatile uint32_t *)address;
+}
+
+static inline void
+wr(vm_offset_t address, uint32_t value)
+{
+	*(volatile uint32_t *)address = value;
+}
+
+static void
+spin_us(uint32_t us)
+{
+	uint64_t until;
+
+	nanoseconds_to_absolutetime((uint64_t)us * NSEC_PER_USEC, &until);
+	until += mach_absolute_time();
+	while (mach_absolute_time() < until) {
+	}
+}
+
+static void
+sleep_us(uint32_t us)
+{
+	if (leaving) {
+		spin_us(us);
+	} else {
+		delay_for_interval(us, NSEC_PER_USEC);
+	}
+}
+
+static void
+wait_ms(uint32_t ms)
+{
+	if (leaving) {
+		spin_us(ms * 1000);
+	} else {
+		delay_for_interval(ms, NSEC_PER_MSEC);
+	}
+}
+
+/* ---- pins (TLMM, south tile: one page per pin, mapped one pair at a time) ------------------------------------ */
+
+#define TLMM_SOUTH_PHYS         0x0f500000UL
+#define PIN_SDA                 60
+#define PIN_SCL                 61
+#define PIN_INT                 129
+#define PIN_RESET               130
+#define FUNCTION_QUP11          1       /* pinctrl-kona.c: GPIO 60 and 61, the function after gpio */
+
+static vm_offset_t pins_i2c;            /* pages of GPIO 60 and 61 */
+static vm_offset_t pins_rst;            /* pages of GPIO 129 and 130 */
+
+static vm_offset_t
+pin(unsigned n)
+{
+	return n < PIN_INT ? pins_i2c + 0x1000UL * (n - PIN_SDA) : pins_rst + 0x1000UL * (n - PIN_INT);
+}
+
+static void
+show_pins(void)
+{
+	static const struct {
+		unsigned pin;
+		const char *what;
+	} pins[] = { { PIN_SDA, "I2C data" }, { PIN_SCL, "I2C clock" }, { PIN_RESET, "reset" }, { PIN_INT, "interrupt" } };
+
+	for (unsigned i = 0; i < sizeof(pins) / sizeof(pins[0]); i++) {
+		uint32_t cfg, io;
+
+		say("apollo haptic: about to read gpio%u's configuration at %#lx\n", pins[i].pin,
+		    TLMM_SOUTH_PHYS + 0x1000UL * pins[i].pin);
+		cfg = rd(pin(pins[i].pin));
+		io = rd(pin(pins[i].pin) + 4);
+
+		say("apollo haptic: gpio%u (%s): function %u, pull %u, %u mA, %s, reads %u\n", pins[i].pin, pins[i].what,
+		    (cfg >> 2) & 15, cfg & 3, (((cfg >> 6) & 7) + 1) * 2, (cfg & (1u << 9)) ? (io & 2 ? "drives high" : "drives low") :
+		    "input", io & 1);
+	}
+}
+
+/* the reset pin as an output of the GPIO function, driving `high' (2 mA, no pull) */
+static void
+reset_pin(bool high)
+{
+	wr(pin(PIN_RESET) + 4, high ? 2 : 0);
+	wr(pin(PIN_RESET), 1u << 9);
+	released = high;
+}
+
+static bool
+reset_is_high(void)
+{
+	uint32_t cfg = rd(pin(PIN_RESET)), io = rd(pin(PIN_RESET) + 4);
+
+	return (cfg & (1u << 9)) && (io & 2);
+}
+
+/* ---- clocks (GCC, kona; the second QUPv3 wrapper's sixth serial engine) -------------------------------------- */
+
+#define GCC_PHYS                0x00100000UL
+#define GCC_SIZE                0x60000UL
+#define GCC_VOTE                0x52008         /* gcc-kona.c: enable_reg of all the wrapper 1 clocks below */
+#define VOTE_QUP1_CORE_2X       (1u << 18)      /* gcc_qupv3_wrap1_core_2x_clk: halt 0x23140 */
+#define VOTE_QUP1_CORE          (1u << 19)      /* gcc_qupv3_wrap1_core_clk: halt 0x23138 */
+#define VOTE_QUP1_M_AHB         (1u << 20)      /* gcc_qupv3_wrap_1_m_ahb_clk: halt 0x18004 */
+#define VOTE_QUP1_S_AHB         (1u << 21)      /* gcc_qupv3_wrap_1_s_ahb_clk: halt 0x18008 (hwcg bit 1) */
+#define VOTE_QUP1_S3            (1u << 25)      /* gcc_qupv3_wrap1_s3_clk: halt 0x1839c */
+#define QUP1_CORE_2X_CBCR       0x23140
+#define QUP1_CORE_CBCR          0x23138
+#define QUP1_M_AHB_CBCR         0x18004
+#define QUP1_S_AHB_CBCR         0x18008
+#define QUP1_S3_CBCR            0x1839c
+#define QUP1_S3_RCG             0x183a0         /* gcc_qupv3_wrap1_s3_clk_src cmd_rcgr; cfg +4; DFS: +0x14, levels at +0x1c, +0x5c, +0x9c */
+/*
+ * (The first version enabled wrapper 1's serial engine *5* -- 0x185fc, vote bit 27 -- for serial engine 11 = 0xa8c000, the
+ * fourth of the wrapper's engines, S3: its own clock stayed off. The phone's DT agrees with S3: i2c@a8c000's clocks are
+ * GCC 112 = GCC_QUPV3_WRAP1_S3_CLK, 134 = WRAP_1_M_AHB, 135 = WRAP_1_S_AHB, in the kona clock header of apollo-q-oss.)
+ */
+#define WRAPPER1_PHYS           0x00ac0000UL    /* qupv3_1_geni_se@ac0000 */
+#define WRAPPER_HW_VER          0x04            /* qcom-geni-se.c: QUP_HW_VER_REG */
+#define CLOCK_OFF               (1u << 31)
+#define CLOCK_HW_CTL            (1u << 1)
+#define XO_HZ                   19200000u
+
+static vm_offset_t gcc, wrapper;
+
+static uint32_t
+rcg_rate(uint32_t cfg, uint32_t m, uint32_t not_n_minus_m)
+{
+	static const uint32_t parent[8] = { XO_HZ, 600000000, 0, 0, 0, 0, 300000000, 0 };
+	uint64_t hz = parent[cfg >> 8 & 7];
+	uint32_t divider = cfg & 0x1f, mode = cfg >> 12 & 3;
+
+	if (divider) {
+		hz = hz * 2 / (divider + 1);
+	}
+	if (mode) {
+		uint32_t n = (~not_n_minus_m & 0xffff) + (m & 0xffff);
+
+		if (n) {
+			hz = hz * (m & 0xffff) / n;
+		}
+	}
+	return (uint32_t)hz;
+}
+
+/* a branch's CLK_OFF bit (a branch the hardware gates, by its HW_CTL bit, is idle then, not off) */
+static bool
+branch_on(uint32_t cbcr)
+{
+	uint32_t v = rd(gcc + cbcr);
+
+	return !(v & CLOCK_OFF) || (cbcr == QUP1_S_AHB_CBCR && (v & CLOCK_HW_CTL));
+}
+
+/* the wrapper's bus and core clocks (m_ahb, s_ahb, core, core_2x): voted, then each read back (up to 10 ms) */
+static int
+bus_clocks_on(void)
+{
+	apollo_gcc_vote(gcc + GCC_VOTE, VOTE_QUP1_CORE_2X | VOTE_QUP1_CORE | VOTE_QUP1_M_AHB | VOTE_QUP1_S_AHB);    /* (locked: shared register) */
+	for (int i = 0; i < 1000; i++) {
+		if (branch_on(QUP1_CORE_2X_CBCR) && branch_on(QUP1_CORE_CBCR) && branch_on(QUP1_M_AHB_CBCR) && branch_on(QUP1_S_AHB_CBCR)) {
+			return 0;
+		}
+		sleep_us(10);
+	}
+	say("apollo haptic: the wrapper's clocks stay off: core_2x %#x core %#x m_ahb %#x s_ahb %#x (vote reads %#x)\n",
+	    rd(gcc + QUP1_CORE_2X_CBCR), rd(gcc + QUP1_CORE_CBCR), rd(gcc + QUP1_M_AHB_CBCR), rd(gcc + QUP1_S_AHB_CBCR),
+	    rd(gcc + GCC_VOTE));
+	return -1;
+}
+
+/* the serial engine's clock: XO's 19.2 MHz, the rate i2c-qcom-geni.c's table is for; which preset gives it */
+static int
+se_clock_on(uint32_t *select)
+{
+	*select = 0;
+	if (rd(gcc + QUP1_S3_RCG + 0x14) & 1) {
+		int found = -1;
+
+		for (uint32_t lvl = 0; lvl < 8 && found < 0; lvl++) {
+			if (rcg_rate(rd(gcc + QUP1_S3_RCG + 0x1c + 4 * lvl), rd(gcc + QUP1_S3_RCG + 0x5c + 4 * lvl),
+			    rd(gcc + QUP1_S3_RCG + 0x9c + 4 * lvl)) == XO_HZ) {
+				found = (int)lvl;
+			}
+		}
+		if (found < 0) {
+			say("apollo haptic: serial engine 11 has no 19.2 MHz preset\n");
+			return -1;
+		}
+		*select = (uint32_t)found;
+	} else {
+		wr(gcc + QUP1_S3_RCG + 4, (rd(gcc + QUP1_S3_RCG + 4) & ~0x371fu) | 1);
+		wr(gcc + QUP1_S3_RCG, rd(gcc + QUP1_S3_RCG) | 1);
+		for (int i = 0; i < 500 && (rd(gcc + QUP1_S3_RCG) & 1); i++) {
+			sleep_us(10);
+		}
+		if (rd(gcc + QUP1_S3_RCG) & 1) {
+			say("apollo haptic: the serial engine's clock does not take its configuration (%#x)\n", rd(gcc + QUP1_S3_RCG));
+			return -1;
+		}
+	}
+	apollo_gcc_vote(gcc + GCC_VOTE, VOTE_QUP1_S3);
+	for (int i = 0; i < 1000; i++) {
+		if (branch_on(QUP1_S3_CBCR)) {
+			return 0;
+		}
+		sleep_us(10);
+	}
+	say("apollo haptic: serial engine 11's clock stays off: %#x\n", rd(gcc + QUP1_S3_CBCR));
+	return -1;
+}
+
+/* ---- I2C through the serial engine (i2c-qcom-geni.c; as in hakios.apollo_cs35l41.c) ----------------------------------- */
+
+#define SE_PHYS                 0x00a8c000UL    /* the sixth serial engine of the second QUPv3 wrapper */
+#define SE_SIZE                 0x4000UL
+#define GENI_FORCE_DEFAULT      0x020
+#define GENI_OUTPUT_CTRL        0x024
+#define GENI_CGC_CTRL           0x028
+#define GENI_STATUS             0x040
+#define GENI_SER_M_CLK_CFG      0x048
+#define GENI_IF_DISABLE_RO      0x064
+#define GENI_FW_REVISION_RO     0x068           /* [15:8] protocol: 3 = I2C */
+#define GENI_CLK_SEL            0x07c
+#define GENI_BYTE_GRAN          0x254
+#define GENI_DMA_MODE_EN        0x258
+#define GENI_TX_PACKING_CFG0    0x260
+#define GENI_TX_PACKING_CFG1    0x264
+#define I2C_TX_TRANS_LEN        0x26c
+#define I2C_RX_TRANS_LEN        0x270
+#define I2C_SCL_COUNTERS        0x278
+#define GENI_RX_PACKING_CFG0    0x284
+#define GENI_RX_PACKING_CFG1    0x288
+#define GENI_M_CMD0             0x600
+#define GENI_M_CMD_CTRL         0x604
+#define GENI_M_IRQ_STATUS       0x610
+#define GENI_M_IRQ_EN           0x614
+#define GENI_M_IRQ_CLEAR        0x618
+#define GENI_S_IRQ_CLEAR        0x648
+#define GENI_TX_FIFO            0x700
+#define GENI_RX_FIFO            0x780
+#define GENI_TX_FIFO_STATUS     0x800
+#define GENI_RX_FIFO_STATUS     0x804
+#define GENI_TX_WATERMARK       0x80c
+#define GENI_RX_WATERMARK       0x810
+#define GENI_RX_RFR_WATERMARK   0x814
+#define SE_DMA_TX_IRQ_CLR       0xc44
+#define SE_DMA_RX_IRQ_CLR       0xd44
+#define SE_GSI_EVENT_EN         0xe18
+#define SE_IRQ_EN               0xe1c
+#define SE_HW_PARAM_0           0xe24
+#define SE_DMA_GENERAL_CFG      0xe30
+
+#define I2C_WRITE               1u
+#define I2C_READ                2u
+#define I2C_STOP_STRETCH        (1u << 2)       /* no stop at the end: a repeated start follows */
+#define M_CMD_DONE              (1u << 0)
+#define M_CMD_CANCEL            (1u << 4)
+#define M_CMD_ABORT             (1u << 5)
+#define M_NACK                  (1u << 10)      /* M_GP_IRQ_1: the address or a byte was not acknowledged */
+#define M_ERRORS                ((1u << 1) | (1u << 2) | (1u << 3) | M_NACK | (1u << 11) | (1u << 12) | (1u << 13) | \
+	                         (1u << 24) | (1u << 25) | (1u << 28) | (1u << 29))
+
+static vm_offset_t se;
+static uint32_t fifo_depth;
+
+static const char *
+i2c_init(uint32_t select)
+{
+	if ((rd(se + GENI_FW_REVISION_RO) >> 8 & 0xff) != 3) {
+		return "serial engine 11 has no I2C firmware";
+	}
+	if (rd(se + GENI_IF_DISABLE_RO) & 1) {
+		return "serial engine 11's FIFO interface is disabled";
+	}
+	fifo_depth = rd(se + SE_HW_PARAM_0) >> 16 & 0x3f;
+	if (fifo_depth < 4) {
+		return "serial engine 11 reports no FIFO";
+	}
+	wr(se + SE_GSI_EVENT_EN, 0);
+	wr(se + GENI_M_IRQ_CLEAR, 0xffffffff);
+	wr(se + GENI_S_IRQ_CLEAR, 0xffffffff);
+	wr(se + SE_DMA_TX_IRQ_CLR, 0xffffffff);
+	wr(se + SE_DMA_RX_IRQ_CLR, 0xffffffff);
+	wr(se + GENI_CGC_CTRL, rd(se + GENI_CGC_CTRL) | 0x7f);
+	wr(se + SE_DMA_GENERAL_CFG, rd(se + SE_DMA_GENERAL_CFG) | 0xf);
+	wr(se + GENI_OUTPUT_CTRL, 0x7f);
+	wr(se + GENI_FORCE_DEFAULT, 1);
+	wr(se + GENI_DMA_MODE_EN, rd(se + GENI_DMA_MODE_EN) & ~1u);
+	wr(se + GENI_RX_WATERMARK, fifo_depth - 3);
+	wr(se + GENI_RX_RFR_WATERMARK, fifo_depth - 2);
+	wr(se + GENI_TX_WATERMARK, 0);
+	wr(se + SE_IRQ_EN, rd(se + SE_IRQ_EN) | 0xf);
+	wr(se + GENI_M_IRQ_EN, rd(se + GENI_M_IRQ_EN) | 0x7fc0007f);
+	wr(se + GENI_TX_PACKING_CFG0, 0x0007f8fe);      /* bytes, the first in the low byte of a word */
+	wr(se + GENI_TX_PACKING_CFG1, 0x000ffefe);
+	wr(se + GENI_RX_PACKING_CFG0, 0x0007f8fe);
+	wr(se + GENI_RX_PACKING_CFG1, 0x000ffefe);
+	wr(se + GENI_BYTE_GRAN, 0);
+	/* 400 kHz from 19.2 MHz (i2c-qcom-geni.c's geni_i2c_clk_map): divider 2, high 5, low 12, cycle 24 */
+	wr(se + GENI_CLK_SEL, select & 7);
+	wr(se + GENI_SER_M_CLK_CFG, 2u << 4 | 1);
+	wr(se + I2C_SCL_COUNTERS, 5u << 20 | 12u << 10 | 24u);
+	return NULL;
+}
+
+static void
+i2c_recover(void)
+{
+	wr(se + GENI_M_CMD_CTRL, 1u << 2);
+	for (int i = 0; i < 200 && !(rd(se + GENI_M_IRQ_STATUS) & M_CMD_CANCEL); i++) {
+		sleep_us(50);
+	}
+	if (!(rd(se + GENI_M_IRQ_STATUS) & M_CMD_CANCEL)) {
+		wr(se + GENI_M_CMD_CTRL, 1u << 1);
+		for (int i = 0; i < 200 && !(rd(se + GENI_M_IRQ_STATUS) & M_CMD_ABORT); i++) {
+			sleep_us(50);
+		}
+	}
+	for (int i = 0; i < 64 && (rd(se + GENI_RX_FIFO_STATUS) & 0x01ffffff); i++) {
+		(void)rd(se + GENI_RX_FIFO);
+	}
+	wr(se + GENI_M_IRQ_CLEAR, 0xffffffff);
+}
+
+static unsigned i2c_failures;
+
+/* One transfer: write `length` bytes of `tx`, or read `length` into `rx`; `stop`: a stop at the end */
+static bool
+i2c_xfer(uint8_t address, const uint8_t *tx, uint8_t *rx, uint32_t length, bool stop)
+{
+	uint32_t sent = 0, received = 0, status = 0, i;
+
+	for (i = 0; i < 200 && (rd(se + GENI_STATUS) & 1); i++) {
+		sleep_us(10);
+	}
+	wr(se + GENI_M_IRQ_CLEAR, 0xffffffff);
+	wr(se + (tx != NULL ? I2C_TX_TRANS_LEN : I2C_RX_TRANS_LEN), length);
+	wr(se + GENI_M_CMD0, (tx != NULL ? I2C_WRITE : I2C_READ) << 27 | (uint32_t)address << 9 | (stop ? 0 : I2C_STOP_STRETCH));
+	for (i = 0; i < 8000; i++) {                    /* 40 ms at most: 33 bytes take 0.8 ms at 400 kHz */
+		while (tx != NULL && sent < length && (rd(se + GENI_TX_FIFO_STATUS) & 0x0fffffff) + 1 < fifo_depth) {
+			uint32_t word = 0;
+
+			for (int j = 0; j < 4 && sent < length; j++, sent++) {
+				word |= (uint32_t)tx[sent] << (8 * j);
+			}
+			wr(se + GENI_TX_FIFO, word);
+		}
+		if (rx != NULL) {
+			uint32_t words = rd(se + GENI_RX_FIFO_STATUS) & 0x01ffffff;
+
+			while (words--) {
+				uint32_t word = rd(se + GENI_RX_FIFO);
+
+				for (int j = 0; j < 4 && received < length; j++) {
+					rx[received++] = (uint8_t)(word >> (8 * j));
+				}
+			}
+		}
+		status = rd(se + GENI_M_IRQ_STATUS);
+		if (status & M_ERRORS) {
+			break;
+		}
+		if ((status & M_CMD_DONE) && (rx == NULL || received == length)) {
+			wr(se + GENI_M_IRQ_CLEAR, status);
+			return true;
+		}
+		sleep_us(5);
+	}
+	if (i2c_failures++ < 8) {
+		say("apollo haptic: I2C %s of %u bytes at %#x failed: status %#x%s (sent %u, received %u)\n", tx ? "write" : "read",
+		    length, address, status, (status & M_NACK) ? ", NOT ACKNOWLEDGED" : "", sent, received);
+	}
+	i2c_recover();
+	return false;
+}
+
+/* ---- the chip's registers: 8 bits, the address counts up (but for the RAM's data port) ---------------------------- */
+
+#define AW_ADDRESS              0x5a
+
+static bool
+regs_read(uint8_t reg, uint8_t *values, unsigned count)
+{
+	return i2c_xfer(AW_ADDRESS, &reg, NULL, 1, false) && i2c_xfer(AW_ADDRESS, NULL, values, count, true);
+}
+
+static bool
+regs_write(uint8_t reg, const uint8_t *values, unsigned count)
+{
+	uint8_t buffer[40];
+
+	if (count > sizeof(buffer) - 1) {
+		return false;
+	}
+	buffer[0] = reg;
+	memcpy(buffer + 1, values, count);
+	return i2c_xfer(AW_ADDRESS, buffer, NULL, count + 1, true);
+}
+
+/* ---- the chip (aw8697_reg.h) ------------------------------------------------------------------------------- */
+
+#define AW_ID                   0x00            /* read: 0x97; write 0xaa: a soft reset */
+#define AW_SYSST                0x01
+#define AW_SYSINT               0x02            /* read: cleared; [7] boost, [6] over-voltage, [5] UVLO, [2] OC, [1] OT */
+#define AW_SYSINTM              0x03            /* [5] UVLO masked */
+#define AW_SYSCTRL              0x04            /* [5] RAMINIT, [3:2] play mode (0 RAM), [1] boost (0 bypass), [0] standby */
+#define AW_GO                   0x05
+#define AW_WAVSEQ1              0x07
+#define AW_WAVSEQ2              0x08
+#define AW_WAVLOOP1             0x0f            /* [7:4] how often the first is repeated, 15: forever */
+#define AW_PWMPRC               0x2d            /* [7] the motor's protection */
+#define AW_PWMDBG               0x2e            /* [6:5] the PWM rate: 2 is 24 kHz */
+#define AW_BSTDBG1              0x31
+#define AW_BSTDBG2              0x32
+#define AW_BSTDBG3              0x33
+#define AW_BSTCFG               0x34            /* [2:0] the boost's peak current: 5 is 3.5 A */
+#define AW_ANADBG               0x35            /* [3:2] the over-current limit: 3 is 4.65 A */
+#define AW_DATDBG               0x39            /* the gain */
+#define AW_BSTDBG4              0x3a            /* [5:1] the boost's voltage */
+#define AW_PRLVL                0x3e            /* [7] the protection */
+#define AW_BASEADDRH            0x21
+#define AW_BASEADDRL            0x22
+#define AW_FIFO_AEH             0x23
+#define AW_FIFO_AEL             0x24
+#define AW_FIFO_AFH             0x25
+#define AW_FIFO_AFL             0x26
+#define AW_RAMADDRH             0x40
+#define AW_RAMADDRL             0x41
+#define AW_RAMDATA              0x42
+#define AW_GLB_STATE            0x46            /* [3:0] 0: standby */
+#define AW_BST_AUTO             0x47            /* [2] automatic boost */
+#define AW_TSET                 0x4d
+#define AW_R_SPARE              0x5d
+#define AW_DETCTRL              0x5f            /* [5] protection: no action, [0] the offset diagnosis */
+#define AW_ADCTEST              0x66            /* [6] vbat compensation in hardware */
+#define AW_BEMF_VTHH_H          0x74
+#define AW_CHIPID               0x97
+
+#define SYSINT_FAULTS           0xe6
+#define HAPTIC_MAX_MS           1000
+#define DUTY_WINDOW_MS          2000            /* at most HAPTIC_MAX_MS of driving (taps and vibrations) in any window this long */
+#define DUTY_SLOT_MS            100             /* the window kept as so many slots of driving time; one more than it takes, so */
+#define DUTY_SLOTS              (DUTY_WINDOW_MS / DUTY_SLOT_MS + 1)     /* that the slots always cover the whole window */
+#define ANDROID_GAIN            0x80            /* aw8697_haptic_effect_strength(): the strongest level */
+#define BST_VOL_RAM             0x11            /* DT vib_bst_vol_ram */
+
+static void
+give_up(const char *why)
+{
+	broken = true;
+	say("apollo haptic: %s: THE CHIP IS PUT INTO RESET (gpio%u low) and nothing more is done\n", why, PIN_RESET);
+	if (pins_rst != 0) {
+		reset_pin(false);
+	}
+}
+
+static bool
+get(uint8_t reg, uint8_t *value)
+{
+	if (!regs_read(reg, value, 1)) {
+		say("apollo haptic: %#04x NOT READ\n", reg);
+		return false;
+	}
+	return true;
+}
+
+/* One register written and read back; a value that reads back differently is said (some bits may not be the host's), not fatal. */
+static bool
+put(uint8_t reg, uint8_t value)
+{
+	uint8_t after = 0;
+
+	if (broken) {
+		return false;
+	}
+	if (!regs_write(reg, &value, 1)) {
+		say("apollo haptic: %#04x <- %#04x NOT ACKNOWLEDGED\n", reg, value);
+		give_up("a write was not acknowledged");
+		return false;
+	}
+	if (!regs_read(reg, &after, 1)) {
+		give_up("a register could not be read back");
+		return false;
+	}
+	say("apollo haptic: %#04x <- %#04x, reads %#04x%s\n", reg, value, after, after == value ? "" : ": DIFFERENT");
+	return true;
+}
+
+/* A register's bits `mask' set to `value' (the others as they are), as aw8697_i2c_write_bits(). */
+static bool
+upd(uint8_t reg, uint8_t mask, uint8_t value)
+{
+	uint8_t old = 0;
+
+	if (broken || !get(reg, &old)) {
+		give_up("a register could not be read");
+		return false;
+	}
+	return put(reg, (uint8_t)((old & ~mask) | (value & mask)));
+}
+
+/* The chip's interrupt flags (reading clears them): false, and the chip given up on, if one is a fault. */
+static bool
+healthy(const char *when)
+{
+	uint8_t flags = 0;
+
+	if (!get(AW_SYSINT, &flags)) {
+		give_up("the flags could not be read");
+		return false;
+	}
+	/*
+	 * Under-voltage alone is not a fault: Xiaomi's aw8697.c masks the UVLO interrupt in standby (aw8697_haptic_play_mode(),
+	 * SYSINTM_UVLO_OFF) and only logs it otherwise ("chip uvlo int error"); the chip showed it right after its
+	 * configuration, at rest (25 October).
+	 */
+	if (flags & 0x20) {
+		say("apollo haptic: %s: the chip reports under-voltage (%#04x): told, not a fault (as Xiaomi's driver)\n", when, flags);
+	}
+	/*
+	 * Nor a boost error: Xiaomi's aw8697.c switches that interrupt off (aw8697_interrupt_setup(): SYSINTM BSTERR_OFF) and
+	 * never looks at it; the chip raised it on the first tap of a run (25 October) and the motor was given up on for nothing.
+	 */
+	if (flags & 0x80) {
+		static unsigned told;
+
+		if (told++ < 4) {
+			say("apollo haptic: %s: the chip reports a boost error (%#04x): told, not a fault (Xiaomi's driver masks it)\n", when,
+			    flags);
+		}
+	}
+	if (flags & SYSINT_FAULTS & ~0xa0) {
+		say("apollo haptic: %s: the chip reports %#04x:%s%s%s%s%s\n", when, flags, flags & 0x80 ? " BOOST ERROR" : "",
+		    flags & 0x40 ? " OVER-VOLTAGE" : "", flags & 0x20 ? " UNDER-VOLTAGE" : "", flags & 0x04 ? " OVER-CURRENT" : "",
+		    flags & 0x02 ? " OVER-TEMPERATURE" : "");
+		give_up("a fault");
+		return false;
+	}
+	return true;
+}
+
+static bool
+chip_answers(void)
+{
+	uint8_t id = 0;
+
+	if (!regs_read(AW_ID, &id, 1)) {
+		say("apollo haptic: nobody answers at %#x on the bus of gpio%u/%u\n", AW_ADDRESS, PIN_SDA, PIN_SCL);
+		return false;
+	}
+	say("apollo haptic: the chip at %#x says %#04x%s\n", AW_ADDRESS, id, id == AW_CHIPID ? ", an AW8697" : ": NOT THE AW8697 EXPECTED");
+	return id == AW_CHIPID;
+}
+
+/* the registers as they are (not the interrupt flags, the RTP and RAM data ports: reading them has effects), nothing written */
+static void
+show_registers(void)
+{
+	for (unsigned base = 0; base < 0x80; base += 8) {
+		uint8_t values[8];
+		bool ok = true;
+
+		for (unsigned i = 0; i < 8; i++) {
+			unsigned reg = base + i;
+
+			values[i] = 0;
+			if (reg == AW_SYSINT || reg == 0x06 || reg == AW_RAMDATA) {
+				continue;
+			}
+			ok &= get((uint8_t)reg, &values[i]);
+		}
+		say("apollo haptic: %#04x: %02x %02x %02x %02x %02x %02x %02x %02x\n", base, values[0], values[1], values[2], values[3],
+		    values[4], values[5], values[6], values[7]);
+		if (!ok) {
+			return;
+		}
+	}
+}
+
+/* aw8697_hw_reset(): low 5 ms, high 5 ms */
+static void
+hardware_reset(void)
+{
+	/* aw8697_hw_reset() with pinctrl: aw8697_reset_active (output high), 5 ms, aw8697_reset_reset (output low), 5 ms, active */
+	say("apollo haptic: the reset is released: gpio%u high, low for 5 ms, then high\n", PIN_RESET);
+	wr(pin(PIN_INT), 3);                    /* aw8697_gpio_int: gpio, 2 mA, pull-up, input */
+	reset_pin(true);
+	wait_ms(5);
+	reset_pin(false);
+	wait_ms(5);
+	reset_pin(true);
+	wait_ms(5);
+}
+
+/* aw8697_haptic_play_mode(STANDBY) */
+static bool
+to_standby(void)
+{
+	return upd(AW_SYSINTM, 0x20, 0x20) && upd(AW_SYSCTRL, 0x01, 0x01);
+}
+
+/* aw8697_haptic_init(): Android's configuration */
+static bool
+configure(void)
+{
+	static const uint8_t bemf[4] = { 0x00, 0x08, 0x03, 0xf8 };     /* DT vib_bemf_config */
+	uint8_t id = 0;
+
+	say("apollo haptic: Android's configuration is written\n");
+	if (!regs_write(AW_ID, (const uint8_t[]){ 0xaa }, 1)) {         /* aw8697_haptic_softreset() */
+		give_up("the soft reset was not acknowledged");
+		return false;
+	}
+	wait_ms(2);
+	if (!get(AW_ID, &id) || id != AW_CHIPID) {
+		give_up("the chip does not answer after its soft reset");
+		return false;
+	}
+	if (!to_standby() || !upd(AW_PWMDBG, 0x60, 2 << 5) ||
+	    !put(AW_BSTDBG1, 0x30) || !put(AW_BSTDBG2, 0xeb) || !put(AW_BSTDBG3, 0xd4) ||    /* DT vib_bstdbg */
+	    !put(AW_TSET, 0x12) || !put(AW_R_SPARE, 0x68) ||                                 /* DT vib_tset, vib_r_spare */
+	    !upd(AW_ANADBG, 0x0c, 3 << 2) || !upd(AW_BSTCFG, 0x07, 5) ||
+	    !upd(AW_DETCTRL, 0x20, 0x20) || !upd(AW_PWMPRC, 0x80, 0) || !upd(AW_PRLVL, 0x80, 0) ||  /* the motor protection off */
+	    !upd(AW_BST_AUTO, 0x04, 0)) {
+		return false;
+	}
+	/* aw8697_haptic_offset_calibration(): RAMINIT on, the diagnosis run, RAMINIT off */
+	if (!upd(AW_SYSCTRL, 0x20, 0x20) || !upd(AW_DETCTRL, 0x01, 0x01)) {
+		return false;
+	}
+	for (unsigned i = 0; i < 500; i++) {
+		uint8_t value = 1;
+
+		if (!get(AW_DETCTRL, &value) || !(value & 1)) {
+			break;
+		}
+		wait_ms(1);
+	}
+	if (!upd(AW_SYSCTRL, 0x20, 0) || !upd(AW_ADCTEST, 0x40, 0x40)) {
+		return false;
+	}
+	for (unsigned i = 0; i < 4; i++) {
+		if (!put((uint8_t)(AW_BEMF_VTHH_H + i), bemf[i])) {
+			return false;
+		}
+	}
+	return upd(AW_BSTDBG4, 0x3e, BST_VOL_RAM << 1) && healthy("after the configuration");
+}
+
+static uint32_t states_seen;           /* the GLB_STATE states seen by the last wait, a bit each */
+
+/* until the chip says it is in standby (GLB_STATE 0), at most `ms' */
+static bool
+wait_standby(unsigned ms)
+{
+	states_seen = 0;
+	for (unsigned waited = 0; waited <= ms; waited += 2) {
+		uint8_t state = 0xff;
+
+		if (!get(AW_GLB_STATE, &state)) {
+			return false;
+		}
+		states_seen |= 1u << (state & 0x0f);
+		if ((state & 0x0f) == 0) {
+			return true;
+		}
+		wait_ms(2);
+	}
+	return false;
+}
+
+/*
+ * Android's waveforms into the chip's RAM (aw8697_ram_loaded, aw8697_container_update): the file is a checksum (16
+ * bits, of all that follows), the address the RAM's contents begin at, and those contents from byte 4 on -- a
+ * version byte, the start and end address of each waveform, the waveforms. Read back the same way and compared.
+ */
+static bool
+load_waveforms(void)
+{
+	uint64_t size = 0;
+	const uint8_t *file = hakios_image_file("fw", "aw8697_haptic.bin", &size, NULL);
+	uint16_t sum = 0;
+	uint32_t base, length, ae, af;
+	uint8_t address[2], back[32];
+	bool ok = false;
+
+	if (file == NULL || size < 8) {
+		say("apollo haptic: no aw8697_haptic.bin in fw/ of the small image\n");
+		return false;
+	}
+	for (uint64_t i = 2; i < size; i++) {
+		sum = (uint16_t)(sum + file[i]);
+	}
+	if (sum != (uint16_t)(file[0] << 8 | file[1])) {
+		say("apollo haptic: aw8697_haptic.bin does not add up (%#x, it says %#x): not loaded\n", sum, file[0] << 8 | file[1]);
+		goto out;
+	}
+	base = (uint32_t)(file[2] << 8 | file[3]);
+	length = (uint32_t)size - 4;
+	ae = base >> 2;
+	af = base - (base >> 2);
+	say("apollo haptic: Android's waveforms: %u bytes from %#x on\n", length, base);
+	if (!wait_standby(250) || !upd(AW_SYSCTRL, 0x20, 0x20)) {       /* RAMINIT */
+		give_up("the RAM could not be opened");
+		goto out;
+	}
+	address[0] = file[2];
+	address[1] = file[3];
+	if (!put(AW_BASEADDRH, address[0]) || !put(AW_BASEADDRL, address[1]) ||
+	    !put(AW_FIFO_AEH, (uint8_t)(ae >> 8)) || !put(AW_FIFO_AEL, (uint8_t)ae) ||
+	    !put(AW_FIFO_AFH, (uint8_t)(af >> 8)) || !put(AW_FIFO_AFL, (uint8_t)af) ||
+	    !regs_write(AW_RAMADDRH, address, 2)) {
+		give_up("the RAM's address could not be set");
+		goto out;
+	}
+	for (uint32_t at = 0; at < length; at += 32) {
+		unsigned n = length - at < 32 ? length - at : 32;
+
+		if (!regs_write(AW_RAMDATA, file + 4 + at, n)) {
+			give_up("the RAM could not be written");
+			goto out;
+		}
+	}
+	if (!regs_write(AW_RAMADDRH, address, 2)) {
+		give_up("the RAM's address could not be set again");
+		goto out;
+	}
+	for (uint32_t at = 0; at < length; at += sizeof(back)) {
+		unsigned n = length - at < sizeof(back) ? length - at : sizeof(back);
+
+		if (!regs_read(AW_RAMDATA, back, n) || memcmp(back, file + 4 + at, n) != 0) {
+			say("apollo haptic: the RAM reads back differently at %#x\n", base + at);
+			give_up("the waveforms did not load");
+			goto out;
+		}
+	}
+	if (!upd(AW_SYSCTRL, 0x20, 0)) {
+		goto out;
+	}
+	say("apollo haptic: Android's waveforms are in the chip's RAM and read back as written\n");
+	ok = healthy("after the waveforms");
+out:
+	/*
+	 * Not freed: hakios_image_file() can hand back the file where it lies in the image itself, not a copy -- freeing
+	 * that panicked the kernel ("kfree: addr ..., size 3861 not found in any zone", 25 October; and with the Wi-Fi's
+	 * shutdown hanging on the way out, it looked like a freeze). 4 KB kept for the run is nothing.
+	 */
+	return ok;
+}
+
+/* GO off, the chip awaited until it is in standby, then put there (aw8697_haptic_stop()) */
+static bool
+halt(void)
+{
+	/* (one that cannot be told -- given up on already, or not answering -- is stopped by its reset line instead) */
+	if (broken || !regs_write(AW_GO, (const uint8_t[]){ 0 }, 1) || !wait_standby(200)) {
+		give_up(broken ? "it cannot be told to stop" : "it does not stop");
+		return false;
+	}
+	return to_standby();            /* (a failure there has put it into reset already: put(), upd()) */
+}
+
+/* A waveform started without waiting for it: once, or (`forever') repeated until halted. */
+static bool
+start_waveform(unsigned waveform, bool forever, uint8_t gain)
+{
+	/*
+	 * The first time iOS played (25 October) the kernel hung on the spot: before each waveform, the serial engine's clocks
+	 * are read back (the GCC's registers are always safe to read), so that an engine whose clocks someone has turned
+	 * off is never touched -- the bus would hang on it.
+	 */
+	if (!branch_on(QUP1_CORE_2X_CBCR) || !branch_on(QUP1_CORE_CBCR) || !branch_on(QUP1_M_AHB_CBCR) || !branch_on(QUP1_S_AHB_CBCR) ||
+	    !branch_on(QUP1_S3_CBCR)) {
+		say("apollo haptic: THE SERIAL ENGINE'S CLOCKS ARE OFF before a waveform (core_2x %#x core %#x m_ahb %#x s_ahb %#x s3 %#x, vote "
+		    "%#x): the engine is not touched\n", rd(gcc + QUP1_CORE_2X_CBCR), rd(gcc + QUP1_CORE_CBCR), rd(gcc + QUP1_M_AHB_CBCR),
+		    rd(gcc + QUP1_S_AHB_CBCR), rd(gcc + QUP1_S3_CBCR), rd(gcc + GCC_VOTE));
+		give_up("the serial engine's clocks are off");  /* (the reset line only: the engine is not touched) */
+		return false;
+	}
+	{
+		static unsigned told;
+
+		if (told++ < 3) {
+			say("apollo haptic: waveform %u (%s, gain %#04x): clocks on, the chip is told\n", waveform, forever ? "repeated" : "once", gain);
+		}
+	}
+	if (!put(AW_WAVSEQ1, (uint8_t)waveform) || !put(AW_WAVSEQ2, 0) || !put(AW_WAVLOOP1, forever ? 0xf0 : 0x00) ||
+	    !upd(AW_SYSCTRL, 0x0f, forever ? 0x00 : 0x02) ||                     /* RAM mode, active, boost (bypass for a loop) */
+	    !get(AW_SYSINT, &(uint8_t){ 0 }) || !upd(AW_SYSINTM, 0x20, 0) ||    /* (the flags cleared, UVLO watched) */
+	    !put(AW_DATDBG, gain)) {
+		return false;
+	}
+	if (!regs_write(AW_GO, (const uint8_t[]){ 1 }, 1)) {
+		give_up("the start was not acknowledged");
+		return false;
+	}
+	return true;
+}
+
+/* One waveform played once (Android's effect `effect' - 1), stopped at HAPTIC_MAX_MS at the latest. */
+static bool
+play_effect(unsigned effect)
+{
+	uint64_t began = mach_absolute_time(), ended;
+	bool done;
+
+	say("apollo haptic: waveform %u is played once, at Android's gain %#x\n", effect, ANDROID_GAIN);
+	if (!wait_standby(250) || !start_waveform(effect, false, ANDROID_GAIN)) {
+		return false;
+	}
+	wait_ms(2);
+	done = wait_standby(HAPTIC_MAX_MS);
+	absolutetime_to_nanoseconds(mach_absolute_time() - began, &ended);
+	if (!done) {
+		say("apollo haptic: STILL PLAYING after %u ms: stopped\n", HAPTIC_MAX_MS);
+	}
+	if (!halt()) {
+		return false;
+	}
+	say("apollo haptic: the waveform has played: back in standby after %llu ms (states seen meanwhile: %#x, a bit each; 0 is "
+	    "standby)\n", ended / NSEC_PER_MSEC, states_seen);
+	return healthy("after playing");
+}
+
+/* ---- apollo_haptic=5: the motor for iOS (hakios.haptic.c's service) ------------------------------------------- */
+
+#define ACTIVE_US               30000           /* a write that was not silence counts for this long */
+#define SILENT_BELOW            256             /* of 32768: samples no larger are silence */
+#define TAP_US                  60000           /* longer than this, and it is a vibration, not a tap */
+#define SETTLE_US               8000            /* how long iOS's waveform is listened to before a tap: its loudness */
+#define FOLLOW_US               20000           /* how often a vibration's strength follows iOS's */
+
+#define TOLD_EVENTS             24              /* the first so many taps and vibrations are each said */
+
+static volatile uint64_t heard_us;              /* when the last write that was not silence came */
+static volatile uint64_t quiet_us;              /* when the last write that was silence came */
+static volatile uint64_t onset_us;              /* when iOS's last waveform began: the first write not silence after a pause */
+static volatile uint32_t heard_peak;            /* the largest sample of that waveform, or since the service last looked */
+static uint64_t written_frames;
+static unsigned taps, loops, capped;            /* what has been played, for the run's end */
+
+static uint64_t
+now_us(void)
+{
+	uint64_t ns;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / NSEC_PER_USEC;
+}
+
+/* From the audio server's I/O thread: never waits. */
+static int
+haptic_write(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	int16_t samples[256];
+	int error = 0;
+
+	while (uio_resid(uio) >= 2) {
+		user_ssize_t bytes = uio_resid(uio);
+		uint32_t peak = 0;
+
+		if (bytes > (user_ssize_t)sizeof(samples)) {
+			bytes = sizeof(samples);
+		}
+		bytes &= ~(user_ssize_t)1;
+		if ((error = uiomove((caddr_t)samples, (int)bytes, uio)) != 0) {
+			break;
+		}
+		for (unsigned i = 0; i < bytes / 2; i++) {
+			uint32_t v = samples[i] < 0 ? (uint32_t)-(int32_t)samples[i] : (uint32_t)samples[i];
+
+			peak = v > peak ? v : peak;
+		}
+		written_frames += (uint64_t)bytes / 2;
+		if (peak > SILENT_BELOW) {
+			uint64_t now = now_us();
+
+			if (heard_us == 0 || quiet_us > heard_us || now - heard_us >= ACTIVE_US) {
+				onset_us = now;
+				heard_peak = 0;
+			}
+			heard_us = now;
+			if (peak > heard_peak) {
+				heard_peak = peak;
+			}
+		} else {
+			quiet_us = now_us();
+		}
+	}
+	return error;
+}
+
+static int
+haptic_open(__unused dev_t dev, __unused int flags, __unused int type, __unused struct proc *p)
+{
+	return 0;
+}
+
+static const struct cdevsw haptic_cdevsw = {
+	.d_open = haptic_open, .d_close = haptic_open, .d_read = eno_rdwrt, .d_write = haptic_write,
+	.d_ioctl = eno_ioctl, .d_stop = eno_stop, .d_reset = eno_reset, .d_select = eno_select,
+	.d_mmap = eno_mmap, .d_strategy = eno_strat, .d_type = 0
+};
+
+/* the chip's state (GLB_STATE: 0 standby), 0xff if it cannot be read */
+static unsigned
+chip_state(void)
+{
+	uint8_t state = 0xff;
+
+	return get(AW_GLB_STATE, &state) ? state & 0x0f : 0xff;
+}
+
+/*
+ * How strong to play what iOS plays (hakios.haptic.c's reasoning): Android's strongest gain, 0x80, from a third of
+ * full scale up, and below that down to five eighths of it (0x50, Android's medium level) for the softest.
+ */
+static uint8_t
+gain_for(uint32_t peak)
+{
+	uint32_t top = ANDROID_GAIN, low = top * 5 / 8, third = 32767 / 3;
+
+	return (uint8_t)(peak >= third ? top : low + (top - low) * peak / third);
+}
+
+static void
+serve(void)
+{
+	enum { IDLE, TAP, LOOP, REST } state = IDLE;
+	uint64_t since = 0, rest_until = 0, last_look = 0, tap_onset = 0, followed = 0;
+	uint8_t playing_gain = 0;
+	unsigned follows = 0;                   /* how often the vibration playing now has changed strength */
+	uint32_t driven[DUTY_SLOTS] = { 0 };    /* us the motor was driven (a tap or a vibration under way) per DUTY_SLOT_MS */
+	uint64_t duty_slot = now_us() / (DUTY_SLOT_MS * 1000), duty_last = now_us();
+	unsigned duty_cuts = 0;
+	int major = cdevsw_add(-1, &haptic_cdevsw);
+
+	if (major < 0 || devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "apollo-haptic") == NULL) {
+		say("apollo haptic: /dev/apollo-haptic cannot be made\n");
+		return;
+	}
+	say("apollo haptic: THE MOTOR PLAYS WHAT IOS PLAYS ON ITS ACTUATOR (/dev/apollo-haptic) from here on, until the run ends\n");
+	while (!broken) {
+		uint64_t now = now_us();
+		bool active = heard_us != 0 && now - heard_us < ACTIVE_US;
+		uint32_t peak = heard_peak;
+		uint8_t gain = gain_for(peak);
+		uint64_t slot = now / (DUTY_SLOT_MS * 1000), window = 0;
+
+		/*
+		 * The duty budget, across taps and vibrations alike: the time since the last look counts as driving if a tap or a
+		 * vibration was under way (a tap's whole TAP state, more than its waveform: on the safe side); the slots older
+		 * than the window are emptied. Over HAPTIC_MAX_MS in the window: stopped, a rest of HAPTIC_MAX_MS, and nothing
+		 * starts again until the window has room (a single cap per vibration does not stop a stream of short taps).
+		 */
+		for (uint64_t s = duty_slot + 1; s <= slot && s <= duty_slot + DUTY_SLOTS; s++) {
+			driven[s % DUTY_SLOTS] = 0;
+		}
+		duty_slot = slot;
+		if (state == TAP || state == LOOP) {
+			uint64_t spent = now - duty_last;
+
+			driven[slot % DUTY_SLOTS] += spent > DUTY_WINDOW_MS * 1000ull ? DUTY_WINDOW_MS * 1000u : (uint32_t)spent;
+		}
+		duty_last = now;
+		for (unsigned i = 0; i < DUTY_SLOTS; i++) {
+			window += driven[i];
+		}
+		if ((state == TAP || state == LOOP) && window >= HAPTIC_MAX_MS * 1000ull) {
+			if (!halt()) {
+				break;
+			}
+			capped++;
+			rest_until = now + HAPTIC_MAX_MS * 1000ull;
+			if (duty_cuts++ < TOLD_EVENTS) {
+				say("apollo haptic: %llu ms of driving in the last %u ms: the motor is STOPPED and rests %u ms (%u taps, %u "
+				    "vibrations so far)\n", window / 1000, DUTY_WINDOW_MS, HAPTIC_MAX_MS, taps, loops);
+			}
+			state = REST;
+			wait_ms(4);
+			continue;
+		}
+
+		switch (state) {
+		case IDLE:
+		case TAP:
+			/*
+			 * A waveform of iOS's that has begun (after a pause: a tap of a series is a tap of its own) is
+			 * a tap -- once its first milliseconds are heard: a waveform begins softly, and they say how
+			 * loud it is; one that goes on without a pause, a vibration.
+			 */
+			if (active && onset_us != tap_onset && now - onset_us >= SETTLE_US) {
+				uint64_t began = onset_us;
+
+				if (window >= HAPTIC_MAX_MS * 1000ull) {
+					tap_onset = began;      /* (no room in the duty window: this tap is left out, not played late) */
+					break;
+				}
+				if (state == TAP && !wait_standby(0) && !halt()) {
+					break;
+				}
+				if (!start_waveform(1, false, gain ? gain : 1)) {
+					break;
+				}
+				state = TAP;
+				since = now;
+				tap_onset = began;
+				taps++;
+				if (taps + loops <= TOLD_EVENTS) {
+					wait_ms(4);
+					say("apollo haptic: tap %u: iOS's waveform peaks at %u of 32768: Android's waveform 1 at gain %#04x; the "
+					    "chip's state %u\n", taps, peak, gain ? gain : 1, chip_state());
+				}
+				break;
+			}
+			if (state == IDLE) {
+				break;
+			}
+			if (active && quiet_us < tap_onset && now - since > TAP_US) {
+				if (halt() && start_waveform(11, true, gain ? gain : 1)) {
+					state = LOOP;
+					since = followed = now;
+					playing_gain = gain ? gain : 1;
+					follows = 0;
+					loops++;
+					heard_peak = 0;
+					if (taps + loops <= TOLD_EVENTS) {
+						wait_ms(4);
+						say("apollo haptic: vibration %u: iOS goes on playing (peak %u): Android's waveform 11 over and over at "
+						    "gain %#04x, %u ms at most; the chip's state %u\n", loops, peak, gain ? gain : 1,
+						    HAPTIC_MAX_MS, chip_state());
+					}
+				}
+			} else if (!active && now - since > TAP_US) {
+				state = halt() ? IDLE : state;          /* (the tap is over: the chip back into standby) */
+			}
+			break;
+		case LOOP:
+			/* as strong as iOS's waveform is now (Android's gain at full scale, never more) */
+			if (active && now - followed >= FOLLOW_US) {
+				followed = now;
+				heard_peak = 0;
+				if (peak != 0 && (gain > playing_gain + 8 || gain + 8 < playing_gain)) {
+					if (!put(AW_DATDBG, gain)) {
+						break;
+					}
+					playing_gain = gain;
+					follows++;
+				}
+			}
+			if (!active || now - since > HAPTIC_MAX_MS * 1000ull) {
+				bool cut = now - since > HAPTIC_MAX_MS * 1000ull;
+
+				if (cut) {
+					capped++;
+					rest_until = now + HAPTIC_MAX_MS * 1000ull;
+				}
+				if (halt()) {
+					state = rest_until > now ? REST : IDLE;
+					if (taps + loops <= TOLD_EVENTS + 1) {
+						say("apollo haptic: vibration %u: %s after %llu ms (its strength changed %u times, last to gain %#04x); "
+						    "the chip is in standby\n", loops, cut ? "CUT at the limit" : "iOS stopped, and so does the motor",
+						    (now - since) / 1000, follows, playing_gain);
+					}
+				}
+			}
+			break;
+		case REST:
+			if (now >= rest_until) {        /* (and what starts next waits for room in the duty window) */
+				state = IDLE;
+			}
+			break;
+		}
+		if (state != IDLE && state != REST && now - last_look > 50000) {
+			last_look = now;
+			if (!healthy("while playing")) {
+				break;
+			}
+		}
+		wait_ms(4);
+	}
+	say("apollo haptic: the motor is given up on (%u taps and %u vibrations played, %u cut at %u ms)\n", taps, loops, capped,
+	    HAPTIC_MAX_MS);
+}
+
+static bool
+prepare(void)
+{
+	uint32_t select = 0;
+	const char *problem;
+
+	pins_i2c = ml_io_map(TLMM_SOUTH_PHYS + 0x1000UL * PIN_SDA, 0x2000);
+	pins_rst = ml_io_map(TLMM_SOUTH_PHYS + 0x1000UL * PIN_INT, 0x2000);
+	gcc = ml_io_map(GCC_PHYS, GCC_SIZE);
+	se = ml_io_map(SE_PHYS, SE_SIZE);
+	wrapper = ml_io_map(WRAPPER1_PHYS, 0x1000);
+	if (!pins_i2c || !pins_rst || !gcc || !se || !wrapper) {
+		say("apollo haptic: cannot map the registers\n");
+		return false;
+	}
+	show_pins();
+	/*
+	 * Wrapper 1's core clock is RPMh's on this SoC: Linux' geni-se driver votes the interconnect path "qup-core"
+	 * (qup1_core_master -> qup1_core_slave), and in sm8250.c's icc tables that is the BCM "QUP0": it holds the core
+	 * masters of all three wrappers (bcm_qup0.nodes = qup0/1/2_core_master). cmd-db has no "QUP1" on this phone.
+	 */
+	say("apollo haptic: about to vote for the QUP core clocks in RPMh (BCM \"QUP0\", which covers wrapper 1 too)\n");
+	if (!apollo_rpmh_bcm_vote("QUP0", 1, 1)) {
+		say("apollo haptic: RPMh does not take the \"QUP0\" vote: not touching serial engine 11\n");
+		apollo_cmd_db_dump();
+		return false;
+	}
+	say("apollo haptic: about to turn on wrapper 1's bus and core clocks (gcc vote %#x, bits 18-21), then read each back\n", GCC_VOTE);
+	if (bus_clocks_on() != 0) {
+		return false;
+	}
+	say("apollo haptic: wrapper 1's clocks are on (core_2x %#x core %#x m_ahb %#x s_ahb %#x): about to read its version at %#lx\n",
+	    rd(gcc + QUP1_CORE_2X_CBCR), rd(gcc + QUP1_CORE_CBCR), rd(gcc + QUP1_M_AHB_CBCR), rd(gcc + QUP1_S_AHB_CBCR),
+	    WRAPPER1_PHYS + WRAPPER_HW_VER);
+	say("apollo haptic: wrapper 1's version is %#x\n", rd(wrapper + WRAPPER_HW_VER));
+	say("apollo haptic: about to turn on serial engine 11's clock (gcc_qupv3_wrap1_s3_clk, vote bit 25, cbcr %#x)\n", QUP1_S3_CBCR);
+	if (se_clock_on(&select) != 0) {
+		return false;
+	}
+	say("apollo haptic: serial engine 11's clock is on (cbcr %#x)\n", rd(gcc + QUP1_S3_CBCR));
+	say("apollo haptic: about to give gpio%u and gpio%u to qup11\n", PIN_SDA, PIN_SCL);
+	wr(pin(PIN_SDA), FUNCTION_QUP11 << 2 | (2 / 2 - 1) << 6);     /* qup11, 2 mA, no pull */
+	wr(pin(PIN_SCL), FUNCTION_QUP11 << 2 | (2 / 2 - 1) << 6);
+	say("apollo haptic: about to read the serial engine at %#lx (its firmware revision), then set it up\n", SE_PHYS);
+	problem = i2c_init(select);
+	if (problem != NULL) {
+		say("apollo haptic: %s\n", problem);
+		return false;
+	}
+	prepared = true;
+	return true;
+}
+
+static void
+haptic_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	delay_for_interval(start_after_ms, 1000 * NSEC_PER_USEC);
+	bringing_up = true;
+	say("apollo haptic: stage %u: %s\n", stage, stage == 1 ? "a look, reading only" : stage == 2 ? "the reset released, registers read" :
+	    stage == 3 ? "the chip configured and its waveforms loaded, nothing played" : stage == 4 ? "one effect played" :
+	    "the motor for iOS");
+	if (!prepare()) {
+		goto done;
+	}
+	if (stage >= 2 && !reset_is_high()) {
+		hardware_reset();
+	}
+	if (!chip_answers()) {
+		say("apollo haptic: (the reset pin %s)\n", reset_is_high() ? "drives high: the chip should answer" :
+		    "does not drive high: the chip is held in reset or not powered");
+		if (released) {
+			give_up("the chip does not answer");
+		}
+	} else {
+		if (stage >= 2) {
+			show_registers();
+		}
+		if (stage >= 3 && configure() && load_waveforms() && to_standby() && stage == 4) {
+			uint32_t effect = 1;
+
+			PE_parse_boot_argn("apollo_haptic_effect", &effect, sizeof(effect));
+			if (effect < 1 || effect > 10) {
+				effect = 1;     /* (the short ones only) */
+			}
+			(void)play_effect(effect);
+		} else if (stage == 5 && !broken) {
+			bringing_up = false;
+			serve();
+		}
+	}
+done:
+	say("apollo haptic: done\n");
+	thread_terminate(current_thread());
+}
+
+void
+apollo_haptic_init(void)
+{
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("apollo_haptic", &stage, sizeof(stage)) || stage == 0) {
+		return;
+	}
+	if (stage > 5) {
+		stage = 5;
+	}
+	PE_parse_boot_argn("apollo_haptic_pause", &pause_ms, sizeof(pause_ms));
+	PE_parse_boot_argn("apollo_haptic_after", &start_after_ms, sizeof(start_after_ms));
+	if (kernel_thread_start(haptic_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_set_thread_name(thread, "apollo haptic");
+		thread_deallocate(thread);
+	}
+}
+
+/* At the run's end and on a panic's way out: the chip back into reset, if it was let out (no I2C, no lock, no sleep). */
+void
+apollo_haptic_quiesce(void)
+{
+	if (prepared && pins_rst != 0 && (released || reset_is_high())) {
+		leaving = true;
+		reset_pin(false);
+		if (stage == 5) {
+			say("apollo haptic: at the run's end: %u taps and %u vibrations played (%u cut at %u ms), from %llu frames iOS "
+			    "wrote; the chip is held in reset\n", taps, loops, capped, HAPTIC_MAX_MS, written_frames);
+		}
+	}
+}
diff --git a/bsd/dev/hakios.apollo_hitch.c b/bsd/dev/hakios.apollo_hitch.c
new file mode 100644
index 000000000000..d5ec68d6f29d
--- /dev/null
+++ b/bsd/dev/hakios.apollo_hitch.c
@@ -0,0 +1,964 @@
+/*
+ * The hitch tracer of the Xiaomi Mi 10T (apollo), with boot-args apollo_frames=1 and apollo_hitch=1 (without them nothing is
+ * started, and the hooks below return at once). Instrumentation only, no behaviour change.
+ *
+ * apollo_frames=1 (bsd/dev/hakios.apollo_frames.c) showed that the animations hitch with single gaps of 65 to 235 ms between
+ * two frames, and that those gaps are already there when CoreAnimation hands the frames to the kernel (its "swaps in N (CA
+ * arrival)" line), not in the display's path nor, on the whole, in the GPU's. What iOS -- or our own kernel threads -- were
+ * doing in such a gap is what this looks for:
+ *
+ *   - The sampler: every apollo_hitch_us (2000) microseconds, in the timer interrupt of one little core (apollo_hitch_cpu,
+ *     0; osfmk/arm64/hakios.apollo_hitch_cpu.c's apollo_hitch_timer), it notes for each of the 8 processors what runs there:
+ *     idle, or a thread -- by its process's name (p_comm), or for one of the kernel's own threads by the name
+ *     thread_set_thread_name gave it ("apollo flip", "apollo buttons", the Wi-Fi's "wifi-irq" ...; "kernel_task" if none) --
+ *     and the GPU's state: how many submissions are in flight (hakios.apollo_adreno.c's apollo_gpu_in_flight) and how many
+ *     threads wait for one in ApolloGPU's gpuWait (hakios.apollo_gpu.cpp's apollo_gpu_waiters). A ring keeps the last
+ *     RING samples (2 s at 2 ms: a gap is looked at within milliseconds of its end, so the 600 ms that matter are there).
+ *     Being an interrupt, it is never late for want of being scheduled, and on its own core it sees the thread it interrupted.
+ *     How the other cores' threads are read without locks, and why that is safe, is in hakios.apollo_hitch_cpu.c.
+ *   - Detection: apollo_frames_swap() (the CA arrival) hands every interval between two swaps longer than apollo_hitch_ms
+ *     (50) ms -- and under 500 ms: a pause with nothing moving is not a hitch -- to apollo_hitch_swap(). Most such gaps are
+ *     not stalls (seen on the phone, 28 October): runs of ~100 ms gaps are CoreAnimation's own 10 fps when nothing animates,
+ *     and gaps of 200-465 ms with the processors 85% idle, the GPU idle and backboardd at 0.1% are moments where nothing on
+ *     the screen changes. So a gap counts as a hitch only while a finger moved through it: the touch driver tells every
+ *     report (apollo_hitch_touch(), from hakios.apollo_touch.c), and the gap must hold a report in which a finger moved in
+ *     its first half AND one in its second half (see finger_moved_through). The others are only counted ("idle gaps not
+ *     counted", in the line about steady use). A hitch is queued for the logger thread ("apollo hitch"); that one takes
+ *     the samples of the interval out of the ring and says the gap, the processes busiest over all processors, the touch
+ *     reports in it (how many, and the longest time between two: the touch driver itself stalling would show there), the
+ *     core groups' and the GPU's speeds, the GPU's state; for SpringBoard, backboardd (always) and any process over 10% the
+ *     share of its four busiest threads (by pthread name, read after the gap: see resolve; "main" for the process's first
+ *     thread when it has none); SpringBoard's and backboardd's threads that were runnable but waited for a processor
+ *     (look_for_waiters); apollo_hitch_threads=0 turns both off; and per processor its three most seen.
+ *     At most apollo_hitch_rate (10) hitches a minute are told; the others are counted, and their number said with the next.
+ *   - Steady CPU use: apollo_frames' 2-second windows (those in which frames were presented) are added up, and every
+ *     apollo_hitch_windows (5) windows one line says which processes used the processors in them, and what the sampler
+ *     itself costs.
+ *
+ * The cost when on: a tick reads, for each processor, the processor's active thread (a plain load) and its id (one
+ * ml_nofault_copy of 8 bytes: a page translation and a copy, well under a microsecond); only when a processor runs another
+ * thread than at the previous tick is the name looked up again (four more such copies and a hash). Some 2 to 10 us a tick,
+ * i.e. 0.1 to 0.5% of the sampler's core; the line about steady use says what it really was.
+ */
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/sched_prim.h>         /* assert_wait, thread_block, thread_wakeup */
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include <sys/hakios.apollo_input.h>
+#include <sys/proc_internal.h>       /* struct proc's p_comm: only its offset is used */
+#include <sys/systm.h>
+#include <sys/user.h>                /* struct uthread's pth_name: only its offset is used */
+
+/* into the loader's log as well (as the other apollo drivers) */
+extern void loader_log_putc(char c);
+
+/* osfmk/arm64/hakios.apollo_hitch_cpu.c */
+extern int apollo_hitch_cpu(unsigned cpu, uint64_t *tid, uintptr_t *thread);
+extern bool apollo_hitch_thread(uintptr_t thread, uintptr_t *proc, uintptr_t *uthread, bool *kernel, uintptr_t *task);
+extern bool apollo_hitch_thread_tid(uintptr_t thread, uint64_t *tid);
+extern int apollo_hitch_task_waiting(uintptr_t task, uintptr_t *threads, uint64_t *tids, uint64_t *since_abs, int max);
+extern size_t apollo_hitch_peek(uintptr_t from, void *to, size_t size);
+extern bool apollo_hitch_timer(unsigned cpu, uint64_t interval_ns, void (*tick)(uint64_t now));
+/* the threads in ApolloGPU's gpuWait, read without its lock (hakios.apollo_gpu.cpp; apollo_gpu_in_flight: the header) */
+extern uint32_t apollo_gpu_waiters(void);
+extern kern_return_t thread_terminate(thread_t thread);
+
+static int say(const char *format, ...) __printflike(1, 2);
+
+static int
+say(const char *format, ...)
+{
+	char line[512];
+	va_list list;
+
+	va_start(list, format);
+	vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
+	for (const char *c = line; *c != 0; c++) {
+		loader_log_putc(*c);
+	}
+	return printf("%s", line);
+}
+
+#define CPUS            8
+#define RING            512             /* samples kept: a power of two (1 s at 2 ms; a gap is taken out within ms of its end) */
+#define NAMES           1024            /* the names told apart (ids): processes' and kernel threads'; more fall into ID_OTHER */
+#define NAME_CHARS      32
+#define WAITERS         1024            /* runnable-but-not-running threads of SpringBoard's and backboardd's kept: a power of two */
+#define WAIT_EVERY      4               /* their threads are looked through every 4th tick (8 ms), while a finger is down */
+#define WAIT_MAX        8               /* ... at most this many of each per look */
+#define THREADS_SEEN    256             /* distinct threads of the broken-down processes, per hitch */
+#define HASH_SLOTS      2048            /* a power of two, twice NAMES */
+#define TOUCHES         256             /* touch reports kept: a power of two (a report every 8 ms or so: 2 s) */
+#define BROKEN_DOWN     4               /* processes whose threads are told, per hitch */
+#define GAP_MAX_NS      (500 * NSEC_PER_MSEC)
+#define QUEUE           8               /* gaps waiting for the logger */
+
+/* the ids that are not a thread's */
+#define ID_OFF          0               /* the processor is off line (or not there) */
+#define ID_IDLE         1               /* its idle thread */
+#define ID_OTHER        2               /* a name that did not fit in the table */
+#define ID_GONE         3               /* a thread that was gone before its name could be read */
+#define ID_FIRST        4
+
+struct sample {
+	uint64_t at;                    /* mach_absolute_time of the tick */
+	uint16_t who[CPUS];             /* the process's (or kernel thread's) name's id for each processor */
+	uint32_t tid[CPUS];             /* ... the thread's id (its low half) ... */
+	uintptr_t thread[CPUS];         /* ... and its address: its name is read by the logger, after the gap (see thread_label) */
+	uint16_t cpu_mhz[3];            /* the core groups' speeds: cores 0-3, 4-6, 7 */
+	uint16_t gpu_mhz;
+	uint8_t gpu_flight;             /* submissions given to the GPU and not done */
+	uint8_t gpu_wait;               /* threads in gpuWait */
+};
+
+static bool hitch_on;
+static uint32_t hitch_us = 2000, hitch_ms = 50, hitch_cpu, hitch_windows = 5, hitch_rate = 10, hitch_threads = 1;
+
+/* the sampler's (the timer interrupt of one processor: one writer, no lock) */
+static struct sample ring[RING];
+static uint32_t ring_head;              /* samples written; the one in the making is ring[ring_head % RING] */
+static char names[NAMES][NAME_CHARS];
+static uint32_t name_count = ID_FIRST;  /* published with a release store once the name is in names[] */
+static uint16_t name_hash[HASH_SLOTS];
+static uint32_t name_samples[NAMES];    /* for each id, the processor-samples it was seen in (all processors, all time) */
+static uint64_t cache_tid[CPUS];        /* the thread each processor ran at the previous tick ... */
+static uint16_t cache_id[CPUS];         /* ... and its name's id */
+static uint16_t board_id[2] = { ID_OTHER, ID_OTHER };    /* the ids of "SpringBoard" and "backboardd", once seen ... */
+static uintptr_t board_task[2];         /* ... and their tasks (the latest seen running) */
+static uint64_t tick_count, tick_abs;   /* the ticks and the time they took */
+
+/* the gaps queued for the logger, and the windows' report (under hitch_lock) */
+static LCK_GRP_DECLARE(apollo_hitch_grp, "apollo-hitch");
+static LCK_SPIN_DECLARE(hitch_lock, &apollo_hitch_grp);
+static struct {
+	uint64_t from, to;
+	uint32_t skipped;               /* gaps not told since the one before */
+} queue[QUEUE];
+static unsigned queue_head, queue_tail;
+static uint64_t minute_abs;
+static uint32_t minute_told, skipped;
+static char hitch_event;                /* the logger sleeps on it */
+static uint32_t idle_gaps;              /* gaps over apollo_hitch_ms through which no finger moved: not hitches */
+
+/* the touch reports (apollo_hitch_touch: the touch driver's thread, one writer, no lock) */
+static struct {
+	uint64_t at;
+	bool down, moved;
+} touches[TOUCHES];
+static uint32_t touch_head;
+
+/* SpringBoard's (0) and backboardd's (1) threads that were runnable but on no processor (the sampler's, every WAIT_EVERY ticks) */
+static struct {
+	uint64_t at, waited_abs;        /* the look's time; how long the thread had waited for a processor by then */
+	uintptr_t thread;
+	uint32_t tid;
+	uint8_t board;
+} waiters[WAITERS];
+static uint32_t waiter_head, waiter_looks;
+
+/* the frame windows (the presenter thread only, which calls apollo_hitch_window), and the report handed to the logger */
+static bool win_begun;
+static uint32_t win_base[NAMES], win_base_ticks;
+static uint64_t win_base_tick_abs, win_ns;
+static uint32_t win_acc[NAMES], win_acc_ticks, win_count;
+static uint64_t win_acc_tick_abs, win_acc_tick_n;
+static uint32_t report[NAMES], report_ticks, report_windows;
+static uint64_t report_ns, report_tick_abs, report_tick_n;
+static bool report_ready;
+
+/* the logger's own */
+static struct sample frozen[RING];
+static uint16_t counts[CPUS][NAMES];
+static uint32_t totals[NAMES], these[NAMES];
+static struct seen {
+	uintptr_t thread;
+	uint32_t tid, count;            /* samples on a processor (or, for the runnable ones, looks it was found waiting in) */
+	uint64_t waited_abs;            /* (the runnable ones: the longest wait seen) */
+	uint16_t who;
+	char label[NAME_CHARS];
+} seen[THREADS_SEEN];
+
+static inline uint64_t
+ns_of(uint64_t abs)
+{
+	uint64_t ns;
+
+	absolutetime_to_nanoseconds(abs, &ns);
+	return ns;
+}
+
+/* -------------------------------------------------------------------------------------------------------------------- */
+/* the sampler, in the timer interrupt */
+
+/* a name's id: looked up by its hash, added if new (only the sampler adds: no lock); parent: a thread's process's id, or 0 */
+static uint16_t
+name_id(const char *name, uint16_t parent)
+{
+	uint32_t hash = 2166136261u, slot;
+
+	for (const char *c = name; *c != 0; c++) {
+		hash = (hash ^ (uint8_t)*c) * 16777619u;
+	}
+	(void)parent;
+	for (unsigned probe = 0; probe < HASH_SLOTS; probe++) {
+		uint16_t id;
+
+		slot = (hash + probe) & (HASH_SLOTS - 1);
+		id = name_hash[slot];
+		if (id == 0) {
+			if (name_count >= NAMES) {
+				return ID_OTHER;
+			}
+			id = (uint16_t)name_count;
+			strlcpy(names[id], name, NAME_CHARS);
+			name_hash[slot] = id;
+			__atomic_store_n(&name_count, name_count + 1, __ATOMIC_RELEASE);
+			return id;
+		}
+		if (strncmp(names[id], name, NAME_CHARS) == 0) {
+			return id;
+		}
+	}
+	return ID_OTHER;
+}
+
+/* a thread's name, through its uthread's pth_name (thread_set_thread_name, pthread_setname_np); empty if it has none */
+static void
+thread_name(uintptr_t uthread, char *name, size_t size)
+{
+	uintptr_t text = 0;
+
+	name[0] = 0;
+	if (apollo_hitch_peek(uthread + offsetof(struct uthread, pth_name), &text, sizeof(text)) == sizeof(text) && text != 0 &&
+	    apollo_hitch_peek(text, name, size - 1) == size - 1) {
+		name[size - 1] = 0;
+	} else {
+		name[0] = 0;
+	}
+}
+
+/*
+ * The name a running thread is counted under: its process's p_comm, or for a kernel thread its own name ("kernel_task" if
+ * it has none). *task: its task (for SpringBoard's and backboardd's thread lists).
+ *
+ * The threads themselves are not named here (they were, interned with the processes in names[], 27 October: the table, 1024
+ * names of which 768 might be threads', filled with the threads of the hundred-odd daemons launchd starts before SpringBoard
+ * and backboardd ran much, and from then on no "SpringBoard/..." name could be added, so no breakdown was ever printed). Each
+ * sample keeps the thread's address and id instead, and the logger names the few threads it tells about, a few ms after the
+ * gap (thread_label): a thread that has exited by then shows as "(exited)".
+ */
+static uint16_t
+resolve(uintptr_t thread, uintptr_t *task)
+{
+	char key[NAME_CHARS];
+	uintptr_t proc = 0, uthread = 0;
+	bool kernel = false;
+
+	if (!apollo_hitch_thread(thread, &proc, &uthread, &kernel, task)) {
+		return ID_GONE;
+	}
+	if (kernel) {
+		thread_name(uthread, key, sizeof(key));
+		if (key[0] == 0) {
+			strlcpy(key, "kernel_task", sizeof(key));
+		}
+		return name_id(key, 0);
+	}
+	if (proc == 0 || apollo_hitch_peek(proc + offsetof(struct proc, p_comm), key, MAXCOMLEN + 1) != MAXCOMLEN + 1) {
+		return ID_GONE;
+	}
+	key[MAXCOMLEN] = 0;
+	return key[0] == 0 ? ID_GONE : name_id(key, 0);
+}
+
+/*
+ * A user thread's label (the logger's, for the threads it tells about): its pthread name; "main" for an unnamed thread that
+ * is the first of its process's (p_uthlist: threads are added at its tail, so its head is the oldest, the one that exec'd);
+ * "(unnamed)" for the other unnamed ones; "(exited)" when the address no longer holds the thread with that id.
+ */
+static void
+thread_label(uintptr_t thread, uint32_t tid, char *label, size_t size)
+{
+	uintptr_t proc = 0, uthread = 0, task = 0, first = 0;
+	uint64_t now_tid = 0;
+	bool kernel = false;
+
+	if (!apollo_hitch_thread_tid(thread, &now_tid) || (uint32_t)now_tid != tid ||
+	    !apollo_hitch_thread(thread, &proc, &uthread, &kernel, &task) || proc == 0) {
+		strlcpy(label, "(exited)", size);
+		return;
+	}
+	thread_name(uthread, label, size);
+	if (label[0] == 0) {
+		bool main = apollo_hitch_peek(proc + offsetof(struct proc, p_uthlist.tqh_first), &first, sizeof(first)) ==
+		    sizeof(first) && first == uthread;
+
+		strlcpy(label, main ? "main" : "(unnamed)", size);
+	}
+}
+
+/* a finger is on the glass: the touch driver's last report, under 50 ms ago, had one down */
+static bool
+finger_down(uint64_t now)
+{
+	uint32_t head = __atomic_load_n(&touch_head, __ATOMIC_ACQUIRE);
+
+	return head != 0 && touches[(head - 1) % TOUCHES].down && now > touches[(head - 1) % TOUCHES].at &&
+	       ns_of(now - touches[(head - 1) % TOUCHES].at) < 50 * NSEC_PER_MSEC;
+}
+
+/*
+ * SpringBoard's and backboardd's threads that wait for a processor: every WAIT_EVERY ticks while a finger is on the glass
+ * (only then can a gap be a hitch: no cost otherwise), their tasks' thread lists are looked through
+ * (apollo_hitch_task_waiting: some 3 fault-free reads a thread, 30 to 60 us for both) and every thread found runnable but on
+ * no processor is noted, with how long it had been waiting.
+ */
+static void
+look_for_waiters(uint64_t now)
+{
+	uintptr_t threads[WAIT_MAX];
+	uint64_t tids[WAIT_MAX], since[WAIT_MAX];
+
+	if (!hitch_threads || ++waiter_looks % WAIT_EVERY != 0 || !finger_down(now)) {
+		return;
+	}
+	for (uint8_t board = 0; board < 2; board++) {
+		int found = board_task[board] == 0 ? 0 :
+		    apollo_hitch_task_waiting(board_task[board], threads, tids, since, WAIT_MAX);
+
+		for (int i = 0; i < found; i++) {
+			uint32_t head = waiter_head;
+
+			waiters[head % WAITERS].at = now;
+			waiters[head % WAITERS].waited_abs = now > since[i] ? now - since[i] : 0;
+			waiters[head % WAITERS].thread = threads[i];
+			waiters[head % WAITERS].tid = (uint32_t)tids[i];
+			waiters[head % WAITERS].board = board;
+			__atomic_store_n(&waiter_head, head + 1, __ATOMIC_RELEASE);
+		}
+	}
+}
+
+static void
+hitch_tick(uint64_t now)
+{
+	uint32_t head = ring_head;
+	struct sample *s = &ring[head % RING];
+
+	for (unsigned cpu = 0; cpu < CPUS; cpu++) {
+		uint64_t tid = 0;
+		uintptr_t thread = 0, task = 0;
+		uint16_t who;
+
+		switch (apollo_hitch_cpu(cpu, &tid, &thread)) {
+		case 0:
+			who = ID_IDLE;
+			thread = 0;
+			break;
+		case 1:
+			if (tid != 0 && tid == cache_tid[cpu]) {
+				who = cache_id[cpu];
+			} else {
+				who = resolve(thread, &task);
+				cache_tid[cpu] = who == ID_GONE ? 0 : tid;
+				cache_id[cpu] = who;
+				for (unsigned board = 0; board < 2 && who >= ID_FIRST && task != 0; board++) {
+					if (who == board_id[board] || (board_id[board] == ID_OTHER &&
+					    strcmp(names[who], board == 0 ? "SpringBoard" : "backboardd") == 0)) {
+						board_id[board] = who;
+						board_task[board] = task;
+					}
+				}
+			}
+			break;
+		default:
+			who = ID_OFF;
+			thread = 0;
+			break;
+		}
+		s->who[cpu] = who;
+		s->tid[cpu] = (uint32_t)tid;
+		s->thread[cpu] = thread;
+		name_samples[who]++;
+	}
+	{
+		uint32_t flight = apollo_gpu_in_flight(), waiters_now = apollo_gpu_waiters();
+
+		s->gpu_flight = (uint8_t)(flight > 255 ? 255 : flight);
+		s->gpu_wait = (uint8_t)(waiters_now > 255 ? 255 : waiters_now);
+		s->gpu_mhz = (uint16_t)apollo_gpu_mhz();
+		for (unsigned group = 0; group < 3; group++) {
+			s->cpu_mhz[group] = (uint16_t)apollo_cpufreq_mhz(group);
+		}
+	}
+	s->at = now;
+	__atomic_store_n(&ring_head, head + 1, __ATOMIC_RELEASE);
+	look_for_waiters(now);
+	tick_count++;
+	tick_abs += mach_absolute_time() - now;
+}
+
+/* -------------------------------------------------------------------------------------------------------------------- */
+/* the hooks, from hakios.apollo_frames.c */
+
+/* hakios.apollo_touch.c: a report of the touch chip's (every 8 ms or so while a finger is on the glass): one down, one moved */
+void
+apollo_hitch_touch(bool down, bool moved)
+{
+	uint32_t head;
+
+	if (!hitch_on) {
+		return;
+	}
+	head = touch_head;
+	touches[head % TOUCHES].at = mach_absolute_time();
+	touches[head % TOUCHES].down = down;
+	touches[head % TOUCHES].moved = moved;
+	__atomic_store_n(&touch_head, head + 1, __ATOMIC_RELEASE);
+}
+
+/*
+ * Whether a finger moved through the gap from..to: a report with a finger moving in its first half and one in its second.
+ * Why both halves, and not "two moving reports in it" or "a finger down all along": a finger resting on the glass moves
+ * nothing on the screen, so iOS rightly draws nothing (down all along is not enough); a gap that ends with a fresh touch is
+ * CoreAnimation waking from its idle 10 fps, whose first moves all fall at the gap's end (two moves in it are not enough
+ * either); while a finger drags something across the screen, reports in which it moved come every 8 ms through the whole
+ * gap, and every frame then has something new to show. (A fling's animation after the finger is lifted is not counted.)
+ */
+static bool
+finger_moved_through(uint64_t from, uint64_t to)
+{
+	uint32_t head = __atomic_load_n(&touch_head, __ATOMIC_ACQUIRE);
+	uint64_t middle = from + (to - from) / 2;
+	bool first = false, second = false;
+
+	for (uint32_t back = 1; back <= (head > TOUCHES ? TOUCHES : head); back++) {
+		uint64_t at = touches[(head - back) % TOUCHES].at;
+
+		if (at <= from) {
+			break;
+		}
+		if (at <= to && touches[(head - back) % TOUCHES].moved) {
+			if (at <= middle) {
+				first = true;
+			} else {
+				second = true;
+			}
+		}
+	}
+	return first && second;
+}
+
+/* apollo_frames_swap(): two swaps of CoreAnimation's, at last_abs and now_abs */
+void
+apollo_hitch_swap(uint64_t last_abs, uint64_t now_abs)
+{
+	uint64_t gap;
+	bool wake = false;
+
+	if (!hitch_on || last_abs == 0) {
+		return;
+	}
+	gap = ns_of(now_abs - last_abs);
+	if (gap <= (uint64_t)hitch_ms * NSEC_PER_MSEC || gap >= GAP_MAX_NS) {
+		return;
+	}
+	if (!finger_moved_through(last_abs, now_abs)) {
+		__atomic_fetch_add(&idle_gaps, 1, __ATOMIC_RELAXED);   /* (nothing moved on the screen to be drawn) */
+		return;
+	}
+	lck_spin_lock(&hitch_lock);
+	if (minute_abs == 0 || ns_of(now_abs - minute_abs) >= 60 * NSEC_PER_SEC) {
+		minute_abs = now_abs;
+		minute_told = 0;
+	}
+	if (minute_told >= hitch_rate || queue_head - queue_tail >= QUEUE) {
+		skipped++;
+	} else {
+		minute_told++;
+		queue[queue_head % QUEUE].from = last_abs;
+		queue[queue_head % QUEUE].to = now_abs;
+		queue[queue_head % QUEUE].skipped = skipped;
+		skipped = 0;
+		queue_head++;
+		wake = true;
+	}
+	lck_spin_unlock(&hitch_lock);
+	if (wake) {
+		thread_wakeup((event_t)&hitch_event);
+	}
+}
+
+/* apollo_frames_shown(): a 2-second window of presented frames begins (begin) or has been told (!begin) */
+void
+apollo_hitch_window(bool begin, uint64_t window_ns)
+{
+	uint32_t head;
+
+	if (!hitch_on) {
+		return;
+	}
+	head = __atomic_load_n(&ring_head, __ATOMIC_ACQUIRE);
+	if (begin) {
+		memcpy(win_base, name_samples, sizeof(win_base));
+		win_base_ticks = head;
+		win_base_tick_abs = tick_abs;
+		win_begun = true;
+		return;
+	}
+	if (!win_begun) {
+		return;                 /* (the tracer started in the middle of this window) */
+	}
+	win_begun = false;
+	for (unsigned id = 0; id < NAMES; id++) {
+		win_acc[id] += name_samples[id] - win_base[id];
+	}
+	win_acc_ticks += head - win_base_ticks;
+	win_acc_tick_abs += tick_abs - win_base_tick_abs;
+	win_acc_tick_n += head - win_base_ticks;
+	win_ns += window_ns;
+	if (++win_count < hitch_windows) {
+		return;
+	}
+	lck_spin_lock(&hitch_lock);
+	if (!report_ready) {
+		memcpy(report, win_acc, sizeof(report));
+		report_ticks = win_acc_ticks;
+		report_windows = win_count;
+		report_ns = win_ns;
+		report_tick_abs = win_acc_tick_abs;
+		report_tick_n = win_acc_tick_n;
+		report_ready = true;
+	}
+	lck_spin_unlock(&hitch_lock);
+	memset(win_acc, 0, sizeof(win_acc));
+	win_acc_ticks = win_count = 0;
+	win_acc_tick_abs = win_acc_tick_n = 0;
+	win_ns = 0;
+	thread_wakeup((event_t)&hitch_event);
+}
+
+/* -------------------------------------------------------------------------------------------------------------------- */
+/* the logger */
+
+static const char *
+name_of(uint16_t id)
+{
+	switch (id) {
+	case ID_OFF:
+		return "off";
+	case ID_IDLE:
+		return "idle";
+	case ID_OTHER:
+		return "(other)";
+	case ID_GONE:
+		return "(gone)";
+	default:
+		return id < __atomic_load_n(&name_count, __ATOMIC_ACQUIRE) ? names[id] : "?";
+	}
+}
+
+/* "a.b%" of part in whole */
+#define PCT(part, whole)        (uint32_t)((uint64_t)(part) * 100 / (whole)), (uint32_t)((uint64_t)(part) * 1000 / (whole) % 10)
+
+/* the ids of the `want` largest of values[] (skipping idle and off if busy_only), largest first; returns how many */
+static unsigned
+top_of(const uint32_t *values, unsigned want, bool busy_only, uint16_t *ids)
+{
+	unsigned found = 0;
+
+	for (uint16_t id = 0; id < NAMES; id++) {
+		unsigned at;
+
+		if (values[id] == 0 || (busy_only && (id == ID_IDLE || id == ID_OFF))) {
+			continue;
+		}
+		for (at = found; at > 0 && values[ids[at - 1]] < values[id]; at--) {
+			if (at < want) {
+				ids[at] = ids[at - 1];
+			}
+		}
+		if (at < want) {
+			ids[at] = id;
+			if (found < want) {
+				found++;
+			}
+		}
+	}
+	return found;
+}
+
+/* the touch reports of the gap from..to: how many, how many moved, the longest time between two (from the last one before it) */
+static void
+touch_in(uint64_t from, uint64_t to, uint32_t *reports, uint32_t *moving, uint64_t *longest_ns)
+{
+	uint32_t head = __atomic_load_n(&touch_head, __ATOMIC_ACQUIRE), kept = head > TOUCHES ? TOUCHES : head;
+	uint64_t last = 0;
+
+	*reports = *moving = 0;
+	*longest_ns = 0;
+	for (uint32_t back = kept; back > 0; back--) {          /* oldest first */
+		uint64_t at = touches[(head - back) % TOUCHES].at;
+
+		if (at > to) {
+			break;
+		}
+		if (at > from) {
+			(*reports)++;
+			*moving += touches[(head - back) % TOUCHES].moved;
+			if (last != 0 && ns_of(at - last) > *longest_ns) {
+				*longest_ns = ns_of(at - last);
+			}
+		}
+		last = at;
+	}
+}
+
+/* the seen[] entry of a thread (by address and id), added if new; NULL: seen[] is full */
+static struct seen *
+seen_entry(unsigned *nseen, uintptr_t thread, uint32_t tid, uint16_t who)
+{
+	for (unsigned i = 0; i < *nseen; i++) {
+		if (seen[i].thread == thread && seen[i].tid == tid) {
+			return &seen[i];
+		}
+	}
+	if (*nseen >= THREADS_SEEN) {
+		return NULL;
+	}
+	bzero(&seen[*nseen], sizeof(seen[0]));
+	seen[*nseen].thread = thread;
+	seen[*nseen].tid = tid;
+	seen[*nseen].who = who;
+	return &seen[(*nseen)++];
+}
+
+/* seen[0..nseen) labelled (thread_label), and those of one label merged into the first of them (count, longest wait) */
+static void
+label_and_merge(unsigned nseen)
+{
+	for (unsigned i = 0; i < nseen; i++) {
+		thread_label(seen[i].thread, seen[i].tid, seen[i].label, sizeof(seen[i].label));
+	}
+	for (unsigned i = 0; i < nseen; i++) {
+		for (unsigned j = 0; j < i && seen[i].count != 0; j++) {
+			if (seen[j].count != 0 && seen[j].who == seen[i].who && strcmp(seen[j].label, seen[i].label) == 0) {
+				seen[j].count += seen[i].count;
+				seen[j].waited_abs = seen[i].waited_abs > seen[j].waited_abs ? seen[i].waited_abs : seen[j].waited_abs;
+				seen[i].count = 0;
+			}
+		}
+	}
+}
+
+/* the index in seen[] of the `want` largest counts of process `who`, largest first, into ids[]; returns how many */
+static unsigned
+top_seen(unsigned nseen, uint16_t who, unsigned want, unsigned *ids)
+{
+	unsigned found = 0;
+
+	for (unsigned i = 0; i < nseen; i++) {
+		unsigned at;
+
+		if (seen[i].count == 0 || seen[i].who != who) {
+			continue;
+		}
+		for (at = found; at > 0 && seen[ids[at - 1]].count < seen[i].count; at--) {
+			if (at < want) {
+				ids[at] = ids[at - 1];
+			}
+		}
+		if (at < want) {
+			ids[at] = i;
+			if (found < want) {
+				found++;
+			}
+		}
+	}
+	return found;
+}
+
+/*
+ * Per hitch: for SpringBoard and backboardd (always, at 0% too) and any other process over 10% of all processors, the share
+ * of its four busiest threads (of all processor-samples of the gap); then SpringBoard's and backboardd's threads that were
+ * found runnable but on no processor during the gap (looks every WAIT_EVERY ticks), with the longest wait seen.
+ */
+static void
+tell_threads(uint64_t from, uint64_t to, uint32_t n)
+{
+	uint16_t broken[BROKEN_DOWN];
+	unsigned nbroken = 0, nseen = 0, top[4], found;
+	char line[400];
+	size_t used;
+
+	for (unsigned board = 0; board < 2; board++) {
+		if (board_id[board] != ID_OTHER) {
+			broken[nbroken++] = board_id[board];
+		}
+	}
+	for (uint16_t id = ID_FIRST; id < NAMES && nbroken < BROKEN_DOWN; id++) {
+		if (totals[id] * 10 > n * CPUS && id != board_id[0] && id != board_id[1]) {
+			broken[nbroken++] = id;
+		}
+	}
+	for (uint32_t i = 0; i < n; i++) {
+		for (unsigned cpu = 0; cpu < CPUS; cpu++) {
+			struct seen *entry;
+
+			for (unsigned b = 0; b < nbroken; b++) {
+				if (frozen[i].who[cpu] == broken[b] && frozen[i].thread[cpu] != 0 &&
+				    (entry = seen_entry(&nseen, frozen[i].thread[cpu], frozen[i].tid[cpu], broken[b])) != NULL) {
+					entry->count++;
+				}
+			}
+		}
+	}
+	label_and_merge(nseen);
+	for (unsigned b = 0; b < nbroken; b++) {
+		used = 0;
+		found = top_seen(nseen, broken[b], 4, top);
+		for (unsigned k = 0; k < found && used < sizeof(line); k++) {
+			used += (size_t)snprintf(line + used, sizeof(line) - used, "%s%s %u.%u%%", k ? ", " : "", seen[top[k]].label,
+			    PCT(seen[top[k]].count, n * CPUS));
+		}
+		say("apollo hitch:   %s %u.%u%%: %s\n", name_of(broken[b]), PCT(totals[broken[b]], n * CPUS),
+		    found ? line : "not on a processor in the gap");
+	}
+
+	/* the runnable ones, waiting for a processor */
+	{
+		uint32_t head = __atomic_load_n(&waiter_head, __ATOMIC_ACQUIRE);
+
+		nseen = 0;
+		for (uint32_t back = head > WAITERS ? WAITERS : head; back > 0; back--) {
+			uint32_t at = (head - back) % WAITERS;
+			struct seen *entry;
+
+			if (waiters[at].at < from || waiters[at].at > to) {
+				continue;
+			}
+			if ((entry = seen_entry(&nseen, waiters[at].thread, waiters[at].tid, board_id[waiters[at].board & 1])) != NULL) {
+				entry->count++;
+				entry->waited_abs = waiters[at].waited_abs > entry->waited_abs ? waiters[at].waited_abs : entry->waited_abs;
+			}
+		}
+		label_and_merge(nseen);
+		used = 0;
+		for (unsigned board = 0; board < 2; board++) {
+			found = board_id[board] == ID_OTHER ? 0 : top_seen(nseen, board_id[board], 4, top);
+			for (unsigned k = 0; k < found && used < sizeof(line); k++) {
+				used += (size_t)snprintf(line + used, sizeof(line) - used, "%s%s/%s %ux (up to %llu.%llu ms)",
+				    used ? ", " : "", name_of(board_id[board]), seen[top[k]].label, seen[top[k]].count,
+				    ns_of(seen[top[k]].waited_abs) / NSEC_PER_MSEC, ns_of(seen[top[k]].waited_abs) / 100000 % 10);
+			}
+		}
+		say("apollo hitch:   runnable, waiting for a processor (looked every %u ms): %s\n", WAIT_EVERY * hitch_us / 1000,
+		    used ? line : "none");
+	}
+}
+
+static void
+tell_hitch(uint64_t from, uint64_t to, uint32_t not_told)
+{
+	uint32_t head = __atomic_load_n(&ring_head, __ATOMIC_ACQUIRE), n = 0, flight_sum = 0, flight_max = 0, waiting = 0;
+	uint32_t reports, moving, mhz_min[4] = { ~0u, ~0u, ~0u, ~0u }, mhz_max[4] = { 0 };
+	uint64_t gap = ns_of(to - from), at = ns_of(to), longest;
+	char line[400], untold[48] = "", speeds[4][24];
+	size_t used;
+	uint16_t top[8];
+	unsigned found;
+
+	/* the samples of the gap, oldest first, out of the ring before the sampler writes over them */
+	for (uint32_t back = head > RING ? RING : head; back > 0; back--) {
+		const struct sample *s = &ring[(head - back) % RING];
+
+		if (s->at >= from && s->at <= to && n < RING) {
+			frozen[n++] = *s;
+		}
+	}
+	if (n == 0) {
+		say("apollo hitch: %llu ms without a frame (at %llu.%03llu s): no samples of it\n", gap / NSEC_PER_MSEC,
+		    at / NSEC_PER_SEC, at / NSEC_PER_MSEC % 1000);
+		return;
+	}
+	memset(counts, 0, sizeof(counts));
+	memset(totals, 0, sizeof(totals));
+	for (uint32_t i = 0; i < n; i++) {
+		for (unsigned cpu = 0; cpu < CPUS; cpu++) {
+			uint16_t id = frozen[i].who[cpu];
+
+			counts[cpu][id]++;
+			totals[id]++;
+		}
+		flight_sum += frozen[i].gpu_flight;
+		flight_max = frozen[i].gpu_flight > flight_max ? frozen[i].gpu_flight : flight_max;
+		waiting += frozen[i].gpu_wait != 0;
+		for (unsigned k = 0; k < 4; k++) {
+			uint32_t mhz = k < 3 ? frozen[i].cpu_mhz[k] : frozen[i].gpu_mhz;
+
+			mhz_min[k] = mhz < mhz_min[k] ? mhz : mhz_min[k];
+			mhz_max[k] = mhz > mhz_max[k] ? mhz : mhz_max[k];
+		}
+	}
+
+	/* line 1: the gap, the busiest over all processors (of all processor-samples) */
+	used = 0;
+	found = top_of(totals, 6, true, top);
+	for (unsigned k = 0; k < found && used < sizeof(line); k++) {
+		used += (size_t)snprintf(line + used, sizeof(line) - used, "%s%s %u.%u%%", k ? ", " : "", name_of(top[k]),
+		    PCT(totals[top[k]], n * CPUS));
+	}
+	if (not_told != 0) {
+		snprintf(untold, sizeof(untold), ", %u not told before it", not_told);
+	}
+	say("apollo hitch: %llu ms without a frame while a finger moved (at %llu.%03llu s, %u samples%s): busiest %s; idle %u.%u%%\n",
+	    gap / NSEC_PER_MSEC, at / NSEC_PER_SEC, at / NSEC_PER_MSEC % 1000, n, untold, found ? line : "nothing",
+	    PCT(totals[ID_IDLE], n * CPUS));
+
+	/* line 2: the touch reports, the speeds, the GPU */
+	touch_in(from, to, &reports, &moving, &longest);
+	for (unsigned k = 0; k < 4; k++) {
+		if (mhz_max[k] == 0) {
+			strlcpy(speeds[k], "?", sizeof(speeds[k]));
+		} else if (mhz_min[k] == mhz_max[k]) {
+			snprintf(speeds[k], sizeof(speeds[k]), "%u", mhz_max[k]);
+		} else {
+			snprintf(speeds[k], sizeof(speeds[k]), "%u-%u", mhz_min[k], mhz_max[k]);
+		}
+	}
+	say("apollo hitch:   touch: %u reports, %u moving, at most %llu.%llu ms apart; MHz: cpu0-3 %s, cpu4-6 %s, cpu7 %s, gpu %s; "
+	    "gpu: in flight %u.%u mean, %u max; a thread in gpuWait in %u.%u%%\n", reports, moving, longest / NSEC_PER_MSEC,
+	    longest / (NSEC_PER_MSEC / 10) % 10, speeds[0], speeds[1], speeds[2], speeds[3], flight_sum / n,
+	    flight_sum * 10 / n % 10, flight_max, PCT(waiting, n));
+
+	/* then SpringBoard, backboardd (always) and any other process over 10% of all processors: their four busiest threads */
+	if (hitch_threads) {
+		tell_threads(from, to, n);
+	}
+
+	/* the last two lines: four processors each, their three most seen */
+	for (unsigned half = 0; half < CPUS; half += 4) {
+		used = 0;
+		for (unsigned cpu = half; cpu < half + 4 && used < sizeof(line); cpu++) {
+			for (unsigned id = 0; id < NAMES; id++) {
+				these[id] = counts[cpu][id];
+			}
+			found = top_of(these, 3, false, top);
+			used += (size_t)snprintf(line + used, sizeof(line) - used, "%scpu%u:", cpu > half ? "; " : "", cpu);
+			for (unsigned k = 0; k < found && used < sizeof(line); k++) {
+				used += (size_t)snprintf(line + used, sizeof(line) - used, "%s %s %u%%", k ? "," : "",
+				    name_of(top[k]), (uint32_t)(counts[cpu][top[k]] * 100u / n));
+			}
+		}
+		say("apollo hitch:   %s\n", line);
+	}
+}
+
+static void
+tell_windows(void)
+{
+	uint32_t total = report_ticks * CPUS, busy;
+	uint64_t cost_us = ns_of(report_tick_abs) / NSEC_PER_USEC, span_us = (uint64_t)report_tick_n * hitch_us;
+	uint16_t top[10];
+	unsigned found;
+	char line[400];
+	size_t used = 0;
+
+	if (report_ticks == 0) {
+		return;
+	}
+	busy = total - report[ID_IDLE] - report[ID_OFF];
+	found = top_of(report, 10, true, top);
+	for (unsigned k = 0; k < found && used < sizeof(line); k++) {
+		used += (size_t)snprintf(line + used, sizeof(line) - used, "%s%s %u.%u%%", k ? ", " : "", name_of(top[k]),
+		    PCT(report[top[k]], total));
+	}
+	say("apollo hitch: cpu use in %u frame windows (%llu ms, %u samples, 100%% = all %u cpus): busy %u.%u%%: %s; "
+	    "%u idle gaps not counted (no finger moving through them); %u of %u names; the sampler took %llu us a tick "
+	    "(%u.%u%% of cpu%u)\n", report_windows, report_ns / NSEC_PER_MSEC, report_ticks, CPUS, PCT(busy, total),
+	    found ? line : "nothing", __atomic_exchange_n(&idle_gaps, 0, __ATOMIC_RELAXED),
+	    __atomic_load_n(&name_count, __ATOMIC_RELAXED), NAMES, cost_us / (report_tick_n ? report_tick_n : 1),
+	    PCT(cost_us, span_us ? span_us : 1), hitch_cpu);
+}
+
+static void
+hitch_logger(__unused void *parameter, __unused wait_result_t result)
+{
+	if (!apollo_hitch_timer(hitch_cpu, (uint64_t)hitch_us * NSEC_PER_USEC, hitch_tick)) {
+		say("apollo hitch: no timer on cpu%u: the tracer is off\n", hitch_cpu);
+		hitch_on = false;
+		thread_terminate(current_thread());
+		return;
+	}
+	say("apollo hitch: a sample of all %u cpus every %u us (in cpu%u's timer interrupt); gaps between CA's swaps over %u ms "
+	    "while a finger moves are told (at most %u a minute)%s, the cpu use every %u frame windows\n", CPUS, hitch_us, hitch_cpu,
+	    hitch_ms, hitch_rate, hitch_threads ? " with the busiest processes' threads" : "", hitch_windows);
+	__atomic_store_n(&hitch_on, true, __ATOMIC_RELEASE);
+	for (;;) {
+		uint64_t from = 0, to = 0;
+		uint32_t not_told = 0;
+		bool gap = false, windows = false;
+
+		lck_spin_lock(&hitch_lock);
+		if (queue_tail != queue_head) {
+			from = queue[queue_tail % QUEUE].from;
+			to = queue[queue_tail % QUEUE].to;
+			not_told = queue[queue_tail % QUEUE].skipped;
+			queue_tail++;
+			gap = true;
+		} else if (report_ready) {
+			windows = true;
+		} else {
+			assert_wait((event_t)&hitch_event, THREAD_UNINT);
+			lck_spin_unlock(&hitch_lock);
+			thread_block(THREAD_CONTINUE_NULL);
+			continue;
+		}
+		lck_spin_unlock(&hitch_lock);
+		if (gap) {
+			tell_hitch(from, to, not_told);
+		}
+		if (windows) {
+			tell_windows();
+			lck_spin_lock(&hitch_lock);
+			report_ready = false;
+			lck_spin_unlock(&hitch_lock);
+		}
+	}
+}
+
+/* from apollo_input_init (bsd_init): boot-arg apollo_hitch=1, with apollo_frames=1 (whose hooks feed it) */
+void
+apollo_hitch_init(void)
+{
+	uint32_t value = 0, frames = 0;
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("apollo_hitch", &value, sizeof(value)) || value != 1) {
+		return;
+	}
+	if (!PE_parse_boot_argn("apollo_frames", &frames, sizeof(frames)) || frames != 1) {
+		say("apollo hitch: needs apollo_frames=1 (its swaps and windows are what it looks at): off\n");
+		return;
+	}
+	PE_parse_boot_argn("apollo_hitch_us", &hitch_us, sizeof(hitch_us));
+	PE_parse_boot_argn("apollo_hitch_ms", &hitch_ms, sizeof(hitch_ms));
+	PE_parse_boot_argn("apollo_hitch_cpu", &hitch_cpu, sizeof(hitch_cpu));
+	PE_parse_boot_argn("apollo_hitch_windows", &hitch_windows, sizeof(hitch_windows));
+	PE_parse_boot_argn("apollo_hitch_rate", &hitch_rate, sizeof(hitch_rate));
+	PE_parse_boot_argn("apollo_hitch_threads", &hitch_threads, sizeof(hitch_threads));
+	hitch_us = hitch_us < 500 ? 500 : hitch_us > 50000 ? 50000 : hitch_us;
+	hitch_cpu = hitch_cpu >= CPUS ? 0 : hitch_cpu;
+	hitch_windows = hitch_windows == 0 ? 0xffffffffu : hitch_windows;      /* 0: never */
+	strlcpy(names[ID_OFF], "off", NAME_CHARS);
+	if (kernel_thread_start(hitch_logger, NULL, &thread) == KERN_SUCCESS) {
+		thread_set_thread_name(thread, "apollo hitch");
+		thread_deallocate(thread);
+	} else {
+		say("apollo hitch: no thread: off\n");
+	}
+}
diff --git a/bsd/dev/hakios.apollo_input.c b/bsd/dev/hakios.apollo_input.c
new file mode 100644
index 000000000000..6c60113445e9
--- /dev/null
+++ b/bsd/dev/hakios.apollo_input.c
@@ -0,0 +1,32 @@
+/*
+ * The Mi 10T's (apollo) drivers, started from bsd_init right after redwood's (devices/mi-10t/xnu/mi-10t.patch). Only on that phone:
+ * the loader puts device=apollo among the boot-args when it has recognised it (xnuloader/loader.c, platform_apollo).
+ * Each driver then looks for its own boot-arg (sys/hakios.apollo_input.h).
+ */
+#include <pexpert/pexpert.h>
+#include <sys/hakios.apollo_input.h>
+#include <sys/hakios.apollo_audio.h>
+#include <sys/systm.h>
+
+void
+apollo_input_init(void)
+{
+	char device[24] = "";
+
+	if (!PE_parse_boot_argn("device", device, sizeof(device)) || strcmp(device, "apollo") != 0) {
+		return;
+	}
+	printf("apollo: the Mi 10T's drivers\n");
+	apollo_cpufreq_init();
+	apollo_display_init();           /* apollo_display=1: the panel's refresh, measured (and apollo_display_hz=N) */
+	apollo_hitch_init();             /* apollo_hitch=1 (with apollo_frames=1): what the cpus run in a gap between frames */
+	apollo_backlight_init();         /* apollo_backlight=P: the light of the panel */
+	apollo_adreno_init();            /* apollo_gpu=N: the GPU, step by step, before anything else draws or talks */
+	apollo_touch_init();
+	apollo_buttons_init();
+	apollo_battery_init();
+	apollo_haptic_init();            /* apollo_haptic=N: the AW8697 vibration motor, /dev/apollo-haptic */
+	apollo_audio_init();             /* /dev/apollo-audio, for iOS's audio plug-in */
+	apollo_adsp_init();              /* apollo_audio=N: the audio DSP, and from it the speakers */
+	apollo_wifi_init();              /* apollo_wifi=N: the QCA6390 on PCIe */
+}
diff --git a/bsd/dev/hakios.apollo_lx.c b/bsd/dev/hakios.apollo_lx.c
new file mode 100644
index 000000000000..11eca4547903
--- /dev/null
+++ b/bsd/dev/hakios.apollo_lx.c
@@ -0,0 +1,780 @@
+/*
+ * Darwin-on-apollo: the kernel's side of the Mi 10T's Wi-Fi driver object (devices/mi-10t/tools/mk-ath11k.sh: Linux's ath11k for
+ * the QCA6390 on PCIe, the same sources as redwood's object under other names). It is bsd/dev/hakios.lx.c's twin: the
+ * calls of sys/hakios.lx.h, with the names apollo_lx_os_* (wifi/lx/include/apollo_prefix.h renames them in the object),
+ * for the chip that hakios.apollo_pcie.c brings up (sys/hakios.apollo_wifi.h): memory the chip sees through its SMMU context
+ * (apollo_wifi_dma_map()), its interrupts as GIC INTIDs 800 + vector (apollo_wifi_msi()), its firmware files from fw/ of
+ * the small image. The network (en0, the station) is the kernel's shared one. Nothing here is redwood's.
+ * Boot-args: wifi_irq (default 1; 0: the driver looks at its rings by polling), wifi_ba and wifi_wide (default 1, as
+ * wifi=1 stands for on redwood), wifi_trace, wifi_station, wifi_join, wifi_scan, wifi_hold, wifi_mac=AA:BB:CC:DD:EE:FF.
+ * A kernel built without the object has the weak apollo_lx_start() and the others at the end of this file.
+ */
+#include <kern/clock.h>
+#include <kern/kalloc.h>
+#include <kern/locks.h>
+#include <kern/sched_prim.h>
+#include <kern/thread.h>
+#include <os/atomic_private.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <mach/vm_param.h>
+#include <pexpert/pexpert.h>
+#include <sys/errno.h>
+#include <sys/random.h>
+#include <sys/hakios.apollo_wifi.h>
+#include <sys/hakios.lx.h>
+#include <sys/hakios.net.h>
+#include <sys/systm.h>
+#include <vm/memory_types.h>
+#include <vm/vm_kern.h>
