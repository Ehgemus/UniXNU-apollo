+static void
+cache_flush(vm_offset_t address, size_t bytes)
+{
+	for (vm_offset_t line = address & ~(vm_offset_t)63; line < address + bytes; line += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (line));
+	}
+	__asm__ volatile ("dsb sy");
+}
+
+/*
+ * Memory the chip and the CPU both write (the MHI contexts and rings): one physical piece (kmem_alloc_contig), written back and
+ * invalidated once, then mapped a second time without the CPU's cache (VM_WIMG_WCOMB: normal non-cacheable, as hakios.lx.c's
+ * lx_os_radio_memory does); the cached view is never used again. A 44-byte context shares its 64-byte line with fields the chip
+ * writes (rp, chstate): through this alias a CPU store can not write a stale line back over them. Returns the alias, 0 on failure.
+ */
+static vm_offset_t
+ctrl_alloc(vm_size_t size, uint64_t *physical)
+{
+	vm_offset_t cached = 0;
+
+	if (kmem_alloc_contig(kernel_map, &cached, size, 0, 0, 0, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return 0;
+	}
+	bzero((void *)cached, size);
+	cache_flush(cached, size);
+	*physical = kvtophys(cached);
+	return ml_io_map_unmappable(*physical, size, VM_WIMG_WCOMB);
+}
+
+/*
+ * Map the pages of a kernel buffer (not contiguous in memory) at the next free addresses of the Wi-Fi's context, adding
+ * third-level tables under the same second-level table as needed; the address of the first goes to *iova.
+ */
+static bool
+wsmmu_map_as_locked(vm_offset_t buffer, uint64_t physical, uint32_t bytes, uint64_t attributes, uint64_t *iova)
+{
+	uint32_t first_table = ~0u, last_table = 0;
+	uint64_t *second = (uint64_t *)(wsmmu.tables + 4096), at = wsmmu.next;
+	uint32_t pages = (bytes + 4095) / 4096;
+	vm_offset_t cb = wsmmu_context(wsmmu.context);
+
+	if (!wsmmu.on || at + 4096ull * pages > WIFI_ADDRESSES + (uint64_t)WIFI_L3_TABLES * 0x200000) {
+		say("apollo wifi: W2c: no room for %u pages at %#llx in the Wi-Fi's addresses\n", pages, at);
+		return false;
+	}
+	for (uint32_t page = 0; page < pages; page++) {
+		uint64_t address = at + 4096ull * page;
+		uint32_t table = (uint32_t)((address - WIFI_ADDRESSES) >> 21);
+
+		if (wsmmu.l3[table] == 0 && kmem_alloc(kernel_map, &wsmmu.l3[table], 4096, KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+		    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			wsmmu.l3[table] = 0;
+			say("apollo wifi: W2c: no memory for a page table\n");
+			return false;
+		}
+		if (first_table == ~0u) {
+			first_table = table;
+		}
+		last_table = table;
+		second[address >> 21 & 0x1ff] = kvtophys(wsmmu.l3[table]) | 3;
+		((uint64_t *)wsmmu.l3[table])[address >> 12 & 0x1ff] =
+		    (physical ? physical + 4096ull * page : kvtophys(buffer + 4096ull * page)) | attributes;
+	}
+	cache_flush((vm_offset_t)second, 4096);
+	for (uint32_t table = first_table; first_table != ~0u && table <= last_table; table++) {      /* only the tables this call touched */
+		cache_flush(wsmmu.l3[table], 4096);
+	}
+	wsmmu.next = at + 4096ull * pages;
+	wr(cb + SMMU_CB_TLBIASID, wsmmu.context);
+	wr(cb + SMMU_CB_TLBSYNC, 1);
+	for (unsigned ms = 0; rd(cb + SMMU_CB_TLBSTATUS) & 1; ms++) {
+		if (ms == 100) {
+			say("apollo wifi: W2c: the SMMU does not finish forgetting old translations\n");
+			return false;
+		}
+		sleep_ms(1);
+	}
+	*iova = at;
+	return true;
+}
+
+/* one at a time: the Wi-Fi's page tables are written from W2c's thread and from apollo_wifi_dma_map()'s callers */
+static bool
+wsmmu_map_as(vm_offset_t buffer, uint64_t physical, uint32_t bytes, uint64_t attributes, uint64_t *iova)
+{
+	bool ok;
+
+	lck_mtx_lock(&wifi_map_lock);
+	ok = wsmmu_map_as_locked(buffer, physical, bytes, attributes, iova);
+	lck_mtx_unlock(&wifi_map_lock);
+	return ok;
+}
+
+/* pages of a kernel buffer, as normal memory (MAIR index 0) */
+static bool
+wsmmu_map(vm_offset_t buffer, uint32_t bytes, uint64_t *iova)
+{
+	return wsmmu_map_as(buffer, 0, bytes, WIFI_PTE, iova);
+}
+
+static void
+mhi_write64(vm_offset_t low_register, uint64_t value)
+{
+	if (!wifi_link_alive) {
+		return;                         /* (power down has taken the link away: no BAR write) */
+	}
+	__asm__ volatile ("dsb sy");            /* the (uncached) ring and context stores are visible before the doorbell */
+	wr(bar + low_register + 4, (uint32_t)(value >> 32));
+	wr(bar + low_register, (uint32_t)value);
+}
+
+/* In interrupt context: count it, wake W2c (the 10 ms timeout of w2c_wait() covers a wakeup that comes before the wait) */
+static void
+w2c_msi_arrived(__unused void *context, uint32_t intid)
+{
+	if (intid >= W2C_MSI_INTID && intid < W2C_MSI_INTID + W2C_MSI_VECTORS) {
+		__atomic_fetch_add(&w2c_hits[intid - W2C_MSI_INTID], 1, __ATOMIC_RELAXED);
+	}
+	thread_wakeup((event_t)&w2c_wake);
+}
+
+/* Wait for an interrupt, 10 ms at most (the polls of W2c do not depend on one arriving) */
+static void
+w2c_wait(void)
+{
+	if (!w2c.msi_on) {
+		sleep_ms(10);
+		return;
+	}
+	assert_wait_timeout((event_t)&w2c_wake, THREAD_UNINT, 10, NSEC_PER_MSEC);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/*
+ * The chip's MSI: the doorbell's page in the Wi-Fi's SMMU context (device memory), INTIDs 800 to 802 attached, then the MSI capability
+ * (conf + the list from 0x34) written: address = the mapped doorbell + 0x40, data = 800, MME = what MMC allows (up to 32), enabled; INTx
+ * off in the command register. Not fatal when it fails: W2c polls as before.
+ */
+static bool
+w2c_msi_setup(void)
+{
+	uint32_t cap = rd(conf + 0x34) & 0xfc, word = 0, control, mmc, vectors, data_at, command;
+	uint64_t iova = 0, address;
+	bool wide;
+
+	for (unsigned hops = 0; cap != 0 && hops < 48; hops++) {
+		word = rd(conf + cap);
+		if ((word & 0xff) == PCI_CAP_MSI) {
+			break;
+		}
+		cap = word >> 8 & 0xfc;
+	}
+	if (cap == 0 || (word & 0xff) != PCI_CAP_MSI) {
+		say("apollo wifi: W2c: no MSI capability in the chip's list (it starts at %#x): polling only\n", rd(conf + 0x34) & 0xfc);
+		return false;
+	}
+	control = word >> 16;
+	mmc = control >> 1 & 7;
+	wide = (control & 0x80) != 0;
+	vectors = 1u << mmc;
+	say("apollo wifi: W2c: MSI capability at conf+%#x: control %#x (%s, up to %u vectors%s, %s), address %#x\n", cap, control,
+	    (control & 1) ? "enabled" : "disabled", vectors, (control & 0x100) ? ", per-vector masks" : "", wide ? "64-bit" : "32-bit address", rd(conf + cap + 4));
+	if (vectors < W2C_MSI_VECTORS) {
+		say("apollo wifi: W2c: the chip allows %u vectors, MHI needs %u: polling only\n", vectors, W2C_MSI_VECTORS);
+		return false;
+	}
+	if (mmc > W2C_MSI_WANT_LOG2) {
+		mmc = W2C_MSI_WANT_LOG2;
+		vectors = 1u << mmc;
+	}
+	if (!wsmmu_map_as(0, W2C_MSI_DOORBELL, 4096, WIFI_PTE | PTE_DEVICE, &iova)) {
+		return false;
+	}
+	address = iova + W2C_MSI_SETSPI;
+	if (!wide && (address >> 32)) {
+		say("apollo wifi: W2c: the chip's MSI address is 32 bits, the doorbell's address %#llx is not: polling only\n", address);
+		return false;
+	}
+	say("apollo wifi: W2c: the MSI doorbell (%#llx) is mapped at %#llx (device memory); the chip gets address %#llx, data %u (INTID of vector 0), %u vectors\n",
+	    W2C_MSI_DOORBELL + W2C_MSI_SETSPI, iova, address, W2C_MSI_INTID, vectors);
+	w2b_hold("the GIC distributor takes INTIDs 800 to 802 (edge), then the chip's MSI capability and command register are written");
+	for (unsigned n = 0; n < W2C_MSI_VECTORS; n++) {
+		kern_return_t kr = gic_v3_spi_attach(W2C_MSI_INTID + n, true, w2c_msi_arrived, NULL);
+
+		if (kr != KERN_SUCCESS) {
+			say("apollo wifi: W2c: INTID %u is not available (%d): polling only\n", W2C_MSI_INTID + n, kr);
+			for (unsigned m = 0; m < n; m++) {
+				gic_v3_spi_detach(W2C_MSI_INTID + m);
+			}
+			return false;
+		}
+	}
+	w2c.msi_attached = true;
+	w2c.msi_address = address;
+	data_at = cap + (wide ? 0xc : 0x8);
+	wr(conf + cap + 4, (uint32_t)address);
+	if (wide) {
+		wr(conf + cap + 8, (uint32_t)(address >> 32));
+	}
+	wr(conf + data_at, W2C_MSI_INTID);
+	if (control & 0x100) {
+		wr(conf + data_at + 4, 0);      /* the mask bits (per-vector masking): all vectors open */
+	}
+	command = rd(conf + 0x04);
+	wr(conf + 0x04, (command & 0xffff) | 1u << 10);         /* INTx disable (the status half is write-1-to-clear: left out) */
+	control = (control & ~(7u << 4)) | mmc << 4 | 1;        /* MME and enable */
+	w2c.msi_cap = cap;
+	wr(conf + cap, (word & 0xffff) | control << 16);
+	w2c.msi_on = true;
+	say("apollo wifi: W2c: MSI enabled: control %#x, address %#x %#x, data %#x, command %#x\n", rd(conf + cap) >> 16, rd(conf + cap + 4),
+	    wide ? rd(conf + cap + 8) : 0, rd(conf + data_at) & 0xffff, rd(conf + 0x04) & 0xffff);
+	return true;
+}
+
+/* The three INTIDs masked and the chip's MSI disabled; no lock, no sleep, no log: a panic's way too (quiesce) */
+static void
+w2c_msi_mask(void)
+{
+	uint32_t cap = w2c.msi_cap;
+
+	if (w2c.msi_attached) {
+		for (unsigned n = 0; n < W2C_MSI_VECTORS; n++) {
+			gic_v3_spi_mask(W2C_MSI_INTID + n);
+		}
+	}
+	if (cap != 0 && conf != 0 && !w2c.msi_cap_skip) {
+		wr(conf + cap, rd(conf + cap) & ~(1u << 16));
+	}
+	w2c.msi_on = false;
+}
+
+/* A failed W2c: masked, and the INTIDs given back */
+static void
+w2c_msi_stop(void)
+{
+	w2c_msi_mask();
+	if (w2c.msi_attached) {
+		w2c.msi_attached = false;
+		for (unsigned n = 0; n < W2C_MSI_VECTORS; n++) {
+			gic_v3_spi_detach(W2C_MSI_INTID + n);
+		}
+	}
+}
+
+/* One element, decoded as Linux's mhi_process_ctrl_ev_ring() does (drivers/bus/mhi/host/main.c) */
+static void
+w2c_event_log(unsigned ring, uint64_t index, const volatile uint32_t *tre)
+{
+	uint32_t type = tre[3] >> 16 & 0xff, code = tre[2] >> 24 & 0xff;       /* MHI_TRE_GET_EV_TYPE, _STATE, _EXECENV, _CODE */
+	uint64_t ptr = (uint64_t)tre[1] << 32 | tre[0];
+
+	/* STATE_CHANGE and EE events are always told (the power states matter); the other kinds stop at W2C_EVENT_LOG_MOST */
+	if (type != W2C_PKT_STATE_CHANGE && type != W2C_PKT_EE) {
+		if (w2c.dumped >= W2C_EVENT_LOG_MOST) {
+			return;
+		}
+		if (++w2c.dumped == W2C_EVENT_LOG_MOST) {
+			say("apollo wifi: W2c: (the event log of the other kinds stops after this one)\n");
+		}
+	}
+	switch (type) {
+	case W2C_PKT_STATE_CHANGE:
+		say("apollo wifi: W2c: ring %u element %llu: STATE_CHANGE, new MHI state %u\n", ring, index, code);
+		break;
+	case W2C_PKT_EE:
+		say("apollo wifi: W2c: ring %u element %llu: EE, new execution environment %u (%s)\n", ring, index, code, execution_environment(code));
+		break;
+	case W2C_PKT_CMD_COMPLETION:
+		say("apollo wifi: W2c: ring %u element %llu: CMD_COMPLETION, code %u, command element at %#llx\n", ring, index, code, ptr);
+		break;
+	default:
+		say("apollo wifi: W2c: ring %u element %llu: type %#x: %08x %08x %08x %08x\n", ring, index, type, tre[0], tre[1], tre[2], tre[3]);
+		break;
+	}
+}
+
+/* The doorbell of channel (or doorbell number) n; defined with IPCR below */
+static void ipcr_channel_db(unsigned n, uint64_t value);
+
+/*
+ * mhi_pm_m0_transition() (drivers/bus/mhi/host/pm.c), on the STATE_CHANGE event to M0: wake_get(force), in mission mode every event
+ * ring's doorbell (mhi_ring_er_db) and the command ring's if it is not empty, the doorbells of the channels with something on their
+ * ring (channel contexts: the chip's rp behind the host's wp), wake_put. wifi_ev_lock is held; no other lock.
+ */
+static void
+w2c_pm_m0(void)
+{
+	struct w2c_context *chan = (struct w2c_context *)(w2c.ctrl + W2C_OFF_CHAN);
+	struct w2c_context *cmd = (struct w2c_context *)(w2c.ctrl + W2C_OFF_CMD);
+
+	w2c_m2 = false;
+	apollo_wifi_wake(1);
+	if (rd(bhi_base + BHI_EXECENV) == MHI_EE_AMSS) {        /* MHI_IN_MISSION_MODE(ee) */
+		for (unsigned ring = 0; ring < W2C_EVENT_RINGS; ring++) {
+			mhi_write64(w2c.erdb + 8 * ring, w2c.wp[ring]);
+		}
+		if (ipcr_cmd_pending()) {               /* mhi_cmd->ring.rp != wp */
+			mhi_write64(MHI_CRDB_LOWER, cmd->wp);
+		}
+	}
+	for (unsigned n = IPCR_UL; n <= IPCR_DL; n++) {
+		if (ipcr_up() && chan[n].rp != chan[n].wp) {
+			ipcr_channel_db(n, chan[n].wp);
+		}
+	}
+	apollo_wifi_wake(0);
+}
+
+/*
+ * mhi_pm_m1_transition() (pm.c), on the STATE_CHANGE event to M1: Linux sets M2 (mhi_set_mhi_state: MHICTRL MHISTATE) and, when
+ * dev_wake or pending packets are there, leaves M2 at once (wake_get(force) + wake_put(force)). Ours does that decision up front:
+ * wake held (the permanent assertion of mhi_wake_hold): no M2, the wake doorbell is rung again (wake_get(force)'s doorbell); not
+ * held: MHICTRL = M2.
+ */
+static void
+w2c_pm_m1(void)
+{
+	if (mhi_wake_is_held()) {
+		mhi_wake_reassert();
+		say("apollo wifi: W2c: M1 with the wake held: wake doorbell rung again, no M2\n");
+		return;
+	}
+	wr(bar + MHI_CTRL, (rd(bar + MHI_CTRL) & ~(0xffu << MHICTRL_STATE_SHIFT)) | MHI_STATE_M2 << MHICTRL_STATE_SHIFT);
+	w2c_m2 = true;
+	say("apollo wifi: W2c: M1: MHI state M2 requested (no wake held)\n");
+}
+
+/*
+ * The event rings (ring 0 control, ring 1 data), consumed as Linux's mhi_process_ctrl_ev_ring() does: the chip's rp from the event
+ * context, the host's own rp up to it, each element told and recycled (mhi_recycle_ev_ring_element(): wp and rp on by one element,
+ * the context's wp written), the doorbell rung with the wp on every pass (mhi_ring_er_db(), unconditional as in mhi_process_ctrl_ev_ring
+ * and mhi_pm_m0_transition). The contexts and rings are the uncached alias (ctrl_alloc): no cache maintenance. Nothing is done once the
+ * firmware has crashed (wifi_dead): no doorbell goes to a chip in RDDM.
+ */
+static void
+w2c_events(void)
+{
+	struct w2c_context *contexts = (struct w2c_context *)(w2c.ctrl + W2C_OFF_EVENT);
+	static const uint32_t offset[W2C_EVENT_RINGS] = { W2C_OFF_ER0, W2C_OFF_ER1 };
+	static const uint32_t elements[W2C_EVENT_RINGS] = { W2C_ER0_ELEMENTS, W2C_ER1_ELEMENTS };
+
+	if (w2c.ctrl == 0 || !w2c.rings || wifi_dead) {
+		return;
+	}
+	lck_mtx_lock(&wifi_ev_lock);
+	for (unsigned ring = 0; ring < W2C_EVENT_RINGS && !wifi_dead; ring++) {
+		uint64_t base = w2c.ctrl_iova + offset[ring], length = (uint64_t)elements[ring] * W2C_ELEMENT, rp;
+		unsigned count = 0;
+		volatile uint64_t *context_rp = &contexts[ring].rp, *context_wp = &contexts[ring].wp;
+
+		rp = *context_rp;
+		while (rp != w2c.rp[ring]) {
+			volatile uint32_t *tre;
+
+			if (rp < base || rp >= base + length || (rp - base) % W2C_ELEMENT || count >= elements[ring]) {
+				if (!w2c.outside) {
+					w2c.outside = true;
+					say("apollo wifi: W2c: event ring %u: the chip's rp %#llx is outside the ring (%#llx, %llu bytes) or the ring is full\n", ring, rp, base, length);
+				}
+				break;
+			}
+			tre = (volatile uint32_t *)(w2c.ctrl + offset[ring] + (w2c.rp[ring] - base));
+			if (!ipcr_event(ring, (w2c.rp[ring] - base) / W2C_ELEMENT, tre)) {
+				w2c_event_log(ring, (w2c.rp[ring] - base) / W2C_ELEMENT, tre);
+			}
+			/* mhi_recycle_ev_ring_element() */
+			w2c.wp[ring] += W2C_ELEMENT;
+			if (w2c.wp[ring] >= base + length) {
+				w2c.wp[ring] = base;
+			}
+			*context_wp = w2c.wp[ring];
+			if (ring == 0 && (tre[3] >> 16 & 0xff) == W2C_PKT_STATE_CHANGE) {      /* mhi_process_ctrl_ev_ring(): MHI_PKT_TYPE_STATE_CHANGE_EVENT */
+				uint32_t state = tre[2] >> 24;
+
+				if (state == MHI_STATE_M0) {
+					w2c_pm_m0();
+				} else if (state == MHI_STATE_M1) {
+					w2c_pm_m1();
+				} else if (state == MHI_STATE_SYS_ERR) {
+					wifi_mark_dead("STATE_CHANGE event: SYS_ERR");
+				}
+			} else if (ring == 0 && (tre[3] >> 16 & 0xff) == W2C_PKT_EE && (tre[2] >> 24) == MHI_EE_RDDM) {
+				wifi_mark_dead("EE event: RDDM");
+			}
+			w2c.rp[ring] += W2C_ELEMENT;
+			if (w2c.rp[ring] >= base + length) {
+				w2c.rp[ring] = base;
+			}
+			rp = *context_rp;
+			count++;
+			if (wifi_dead) {
+				break;
+			}
+		}
+		if (!wifi_dead) {
+			mhi_write64(w2c.erdb + 8 * ring, w2c.wp[ring]);        /* mhi_ring_er_db(): every pass */
+		}
+	}
+	lck_mtx_unlock(&wifi_ev_lock);
+}
+
+/* Read the execution environment and the MHI state; log a change (and each interrupt count's); the SMMU's faults and the event rings too */
+static void
+w2c_poll(uint64_t began, const char *phase)
+{
+	uint32_t ee = rd(bhi_base + BHI_EXECENV), mhi = rd(bar + MHI_STATUS);
+
+	if (ee != w2c.ee || mhi != w2c.mhi) {
+		say("apollo wifi: W2c: %s +%llu ms: execution environment %#x (%s), MHI state %u%s%s (MHISTATUS %#x), BHI status %#x\n", phase,
+		    (now_us() - began) / 1000, ee, execution_environment(ee), mhi >> MHISTATUS_STATE_SHIFT & 0xff, (mhi & MHISTATUS_READY) ? ", ready" : "",
+		    (mhi & MHISTATUS_SYSERR) ? ", SYSTEM ERROR" : "", mhi, rd(bhi_base + BHI_STATUS));
+		w2c.ee = ee;
+		w2c.mhi = mhi;
+	}
+	for (unsigned n = 0; n < W2C_MSI_VECTORS; n++) {
+		uint32_t hits = w2c_hits[n];
+
+		if (hits != w2c.seen[n]) {
+			say("apollo wifi: W2c: %s +%llu ms: MSI vector %u: %u interrupts (was %u); execution environment %#x, MHI state %u\n", phase,
+			    (now_us() - began) / 1000, n, hits, w2c.seen[n], ee, mhi >> MHISTATUS_STATE_SHIFT & 0xff);
+			w2c.seen[n] = hits;
+		}
+	}
+	wsmmu_faults(&w2c.told);
+	diag_poll(phase, began);
+	w2c_events();
+}
+
+/* The last word on a step that did not get anywhere: the diagnostics' registers, the MSI hit counts, the SMMU's fault status */
+static void
+wifi_final_dump(const char *why)
+{
+	uint32_t direct[DIAG_DIRECT], windowed[DIAG_WINDOWED];
+	bool window = chip_prep != 0 && chip_window_ok();
+	uint64_t now = now_us();
+
+	say("apollo wifi: FINAL DUMP (%s)\n", why);
+	if (bhi_base != 0) {
+		diag_read(direct, window ? windowed : NULL);
+		diag_tell("final", now, direct, window ? windowed : NULL);
+	}
+	say("apollo wifi: final: PCI command/status %#x, link %s (port debug %#x, link status %#x)\n", rd(conf + 0x04), link_up() ? "up" : "DOWN",
+	    rd(dbi + DBI_PORT_DEBUG1), rd(dbi + DBI_LINK_CTRL_STATUS) >> 16);
+	say("apollo wifi: final: MSI: attached %u, on %u, capability at conf+%#x (control %#x); hits per vector %u %u %u; GIC counts %llu %llu %llu\n",
+	    w2c.msi_attached, w2c.msi_on, w2c.msi_cap, w2c.msi_cap ? rd(conf + w2c.msi_cap) >> 16 : 0, w2c_hits[0], w2c_hits[1], w2c_hits[2],
+	    w2c.msi_attached ? gic_v3_spi_count(W2C_MSI_INTID) : 0, w2c.msi_attached ? gic_v3_spi_count(W2C_MSI_INTID + 1) : 0,
+	    w2c.msi_attached ? gic_v3_spi_count(W2C_MSI_INTID + 2) : 0);
+	if (wsmmu.on) {
+		vm_offset_t cb = wsmmu_context(wsmmu.context);
+
+		say("apollo wifi: final: SMMU: global status %#x (stream %#x); context %u: status %#x, address %#llx, syndrome %#x, sctlr %#x\n",
+		    rd(wsmmu.base + SMMU_SGFSR), rd(wsmmu.base + SMMU_SGFSYNR1), wsmmu.context, rd(cb + SMMU_CB_FSR),
+		    (uint64_t)rd(cb + SMMU_CB_FAR + 4) << 32 | rd(cb + SMMU_CB_FAR), rd(cb + SMMU_CB_FSYNR0), rd(cb + SMMU_CB_SCTLR));
+	}
+}
+
+/* ---- RDDM: the firmware's crash dump (BHIe receive vector), drivers/bus/mhi/host/boot.c ---------------------------------- */
+
+/*
+ * ath11k_mhi_register(): mhi_ctrl->rddm_size = RDDM_DUMP_SIZE (0x420000) and seg_len = SZ_512K (drivers/net/wireless/ath/ath11k/mhi.c).
+ *   mhi_alloc_bhie_table(rddm_size): DIV_ROUND_UP(0x420000, 512 KB) = 9 segments of 512 KB, plus the vector table as the last entry
+ *     (16 bytes per segment: 64-bit address, 64-bit size; 9 * 16 = 144 bytes)
+ *   mhi_rddm_prepare() (mhi_prepare_for_power_up(), before the chip is powered up): the vector table's address to RXVECADDR_HIGH/LOW, its size
+ *     to RXVECSIZE, a sequence id (non-zero, 30 bits) to RXVECDB
+ *   mhi_download_rddm_image(): when the chip's EE becomes RDDM, wait for RXVECSTATUS[31:30] == XFER_COMPL (2) (mhi_cntrl->timeout_ms; the
+ *     DT's mhi,timeout is 10000)
+ * Ours: the nine segments are one buffer (contiguous in the chip's addresses, as the image of W2c); boot-arg apollo_wifi_rddm (default 1).
+ */
+#define BHIE_RXVECADDR_LOW_OFF  0x60
+#define BHIE_RXVECADDR_HIGH_OFF 0x64
+#define BHIE_RXVECSIZE_OFF      0x68
+#define BHIE_RXVECDB_OFF        0x70
+#define BHIE_RXVECSTATUS_OFF    0x78
+#define RDDM_DUMP_SIZE          0x420000u
+#define RDDM_SEGMENT            0x80000u        /* mhi_ctrl->seg_len = SZ_512K */
+#define RDDM_SEGMENTS           ((RDDM_DUMP_SIZE + RDDM_SEGMENT - 1) / RDDM_SEGMENT)
+#define RDDM_WAIT_US            10000000ull     /* mhi,timeout */
+#define RDDM_RUN_MIN            12              /* printable run, characters */
+#define RDDM_LINES              60
+#define RDDM_LINE_MAX           200
+
+static uint32_t wifi_rddm = 1;                  /* boot-arg apollo_wifi_rddm */
+static struct {
+	vm_offset_t buffer, table;              /* RDDM_SEGMENTS * RDDM_SEGMENT bytes; one page with the vector table */
+	uint64_t buffer_iova, table_iova;
+	bool armed, collected;
+} rddm;
+
+/* mhi_alloc_bhie_table() and mhi_rddm_prepare(): true when the receive vector is programmed */
+static bool
+w2c_rddm_prepare(void)
+{
+	struct rddm_vec {
+		uint64_t address, size;
+	} *vector;
+	uint32_t offset, sequence;
+	vm_offset_t base;
+
+	if (!wifi_rddm) {
+		return false;
+	}
+	offset = rd(bar + MHI_BHIE_OFF);
+	if (offset == 0 || offset + BHIE_RXVECSTATUS_OFF + 4 > bar_mapped) {
+		say("apollo wifi: RDDM: BHIe offset %#x out of range: no crash dump\n", offset);
+		return false;
+	}
+	base = bar + offset;
+	if (rddm.buffer == 0) {
+		if (kmem_alloc(kernel_map, &rddm.buffer, (vm_size_t)RDDM_SEGMENTS * RDDM_SEGMENT, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS ||
+		    kmem_alloc(kernel_map, &rddm.table, 4096, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			say("apollo wifi: RDDM: no memory for the dump (%u KB): no crash dump\n", RDDM_SEGMENTS * RDDM_SEGMENT / 1024);
+			rddm.buffer = rddm.table = 0;
+			return false;
+		}
+		cache_flush(rddm.buffer, (size_t)RDDM_SEGMENTS * RDDM_SEGMENT);
+		if (!wsmmu_map(rddm.buffer, RDDM_SEGMENTS * RDDM_SEGMENT, &rddm.buffer_iova) || !wsmmu_map(rddm.table, 4096, &rddm.table_iova)) {
+			say("apollo wifi: RDDM: could not map the dump buffer: no crash dump\n");
+			rddm.buffer = rddm.table = 0;
+			return false;
+		}
+		vector = (struct rddm_vec *)rddm.table;
+		for (uint32_t n = 0; n < RDDM_SEGMENTS; n++) {
+			vector[n].address = rddm.buffer_iova + (uint64_t)n * RDDM_SEGMENT;
+			vector[n].size = RDDM_SEGMENT;
+		}
+		cache_flush(rddm.table, 4096);
+	}
+	sequence = ((uint32_t)mach_absolute_time() & BHIE_SEQ_MASK) | 1;
+	wr(base + BHIE_RXVECADDR_HIGH_OFF, (uint32_t)(rddm.table_iova >> 32));
+	wr(base + BHIE_RXVECADDR_LOW_OFF, (uint32_t)rddm.table_iova);
+	wr(base + BHIE_RXVECSIZE_OFF, RDDM_SEGMENTS * 16);
+	wr(base + BHIE_RXVECDB_OFF, (rd(base + BHIE_RXVECDB_OFF) & ~BHIE_SEQ_MASK) | sequence);   /* mhi_write_reg_field() */
+	rddm.armed = true;
+	say("apollo wifi: RDDM: receive vector armed at BHIe+%#x: %u segments of %#x (%u KB) at %#llx, vector table (%u bytes) at %#llx, sequence %u\n",
+	    BHIE_RXVECADDR_LOW_OFF, RDDM_SEGMENTS, RDDM_SEGMENT, RDDM_SEGMENTS * RDDM_SEGMENT / 1024, rddm.buffer_iova, RDDM_SEGMENTS * 16,
+	    rddm.table_iova, sequence);
+	return true;
+}
+
+static bool
+rddm_has(const char *run, size_t length, const char *needle)
+{
+	size_t n = strlen(needle);
+
+	for (size_t i = 0; i + n <= length; i++) {
+		if (memcmp(run + i, needle, n) == 0) {
+			return true;
+		}
+	}
+	return false;
+}
+
+/*
+ * The firmware's own image (fw/amss.bin): a run found there word for word is its read-only data (format strings, file
+ * names), not what it wrote when it failed. The first dump (25 October) printed 40 of those and nothing else.
+ */
+static const uint8_t *rddm_image;
+static uint64_t rddm_image_size;
+
+static bool
+rddm_in_image(const char *run, size_t length)
+{
+	if (rddm_image == NULL || length < 8) {
+		return false;
+	}
+	for (uint64_t i = 0; i + length <= rddm_image_size; i++) {
+		if (rddm_image[i] == (uint8_t)run[0] && memcmp(rddm_image + i, run, length) == 0) {
+			return true;
+		}
+	}
+	return false;
+}
+
+/*
+ * The dump's printable runs (at least RDDM_RUN_MIN) with ".c" or an error word, and no '%', that are not in the firmware's image.
+ * Bounded: at most RDDM_IMAGE_BUDGET comparisons against the image (each one a pass over 4 MB; after that the candidates are
+ * printed unchecked), RDDM_SCAN_US of wall-clock time for the whole scan, and a short sleep every RDDM_YIELD bytes scanned (no lock
+ * is held: the event thread and W2c's thread both call this with nothing but wifi_lock, a mutex, at most). The 25 October runs that
+ * compared every run of the dump against the image froze the kernel.
+ */
+#define RDDM_IMAGE_BUDGET       300
+#define RDDM_SCAN_US            1000000ull
+#define RDDM_YIELD              (256u * 1024)
+
+static unsigned
+rddm_scan(const uint8_t *dump, size_t size, uint32_t *seen)
+{
+	char text[RDDM_LINE_MAX + 1];
+	size_t i = 0, yielded = 0;
+	unsigned printed = 0, compared = 0, unchecked = 0;
+	uint64_t began = now_us();
+
+	while (i < size && printed < RDDM_LINES) {
+		size_t start = i, length;
+		bool dot_c, word;
+		uint32_t hash = 5381;
+
+		while (i < size && dump[i] >= 0x20 && dump[i] < 0x7f) {
+			i++;
+		}
+		length = i - start;
+		i++;
+		if (i - yielded >= RDDM_YIELD) {
+			yielded = i;
+			sleep_ms(1);
+			if (now_us() - began > RDDM_SCAN_US) {
+				say("apollo wifi: RDDM: the scan stops at %#zx of %#zx after %llu ms (time cap)\n", i, size, (now_us() - began) / 1000);
+				break;
+			}
+		}
+		if (length < RDDM_RUN_MIN) {
+			continue;
+		}
+		if (length > RDDM_LINE_MAX) {
+			length = RDDM_LINE_MAX;
+		}
+		memcpy(text, dump + start, length);
+		text[length] = 0;
+		dot_c = rddm_has(text, length, ".c");
+		word = rddm_has(text, length, "err") || rddm_has(text, length, "ERR") || rddm_has(text, length, "assert") ||
+		    rddm_has(text, length, "ASSERT") || rddm_has(text, length, "fatal") || rddm_has(text, length, "FATAL") || rddm_has(text, length, "fail");
+		if (!(dot_c || word) || rddm_has(text, length, "%")) {
+			continue;
+		}
+		if (now_us() - began > RDDM_SCAN_US) {
+			say("apollo wifi: RDDM: the scan stops at %#zx of %#zx after %llu ms (time cap)\n", start, size, (now_us() - began) / 1000);
+			break;
+		}
+		if (compared < RDDM_IMAGE_BUDGET) {
+			compared++;
+			if (rddm_in_image(text, length)) {
+				continue;
+			}
+		} else {
+			unchecked++;
+		}
+		for (size_t k = 0; k < length; k++) {
+			hash = hash * 33 + (uint8_t)text[k];
+		}
+		for (unsigned k = 0; k < printed; k++) {
+			if (seen[k] == hash) {
+				hash = 0;
+				break;
+			}
+		}
+		if (hash == 0) {
+			continue;
+		}
+		seen[printed++] = hash;
+		say("apollo wifi: RDDM: @%#zx: %s\n", start, text);
+	}
+	say("apollo wifi: RDDM: scan done in %llu ms: %u image comparisons, %u candidates printed unchecked\n", (now_us() - began) / 1000, compared, unchecked);
+	return printed;
+}
+
+/* mhi_download_rddm_image() and the dump's crash reason, once: wait for the chip's EE RDDM and the vector's completion, then scan the buffer */
+static void
+wifi_rddm_collect(const char *why)
+{
+	uint64_t began = now_us();
+	uint32_t ee = ~0u, status = 0, offset = rd(bar + MHI_BHIE_OFF);
+	vm_offset_t base = bar + offset;
+	const uint8_t *dump = (const uint8_t *)rddm.buffer;
+	uint32_t seen[RDDM_LINES + 1];
+	size_t size = (size_t)RDDM_SEGMENTS * RDDM_SEGMENT, extent = 0;
+	unsigned printed;
+
+	if (!wifi_rddm || !rddm.armed || rddm.collected || offset == 0 || offset + BHIE_RXVECSTATUS_OFF + 4 > bar_mapped) {
+		return;
+	}
+	rddm.collected = true;
+	say("apollo wifi: RDDM: collecting (%s)\n", why);
+	while (now_us() - began < 5000000ull) {         /* the firmware enters RDDM by itself after its SYS_ERR */
+		if (ipcr_stopping() || !wifi_link_alive) {
+			say("apollo wifi: RDDM: power down: the collection is given up\n");
+			return;
+		}
+		ee = rd(bhi_base + BHI_EXECENV);
+		if (ee == MHI_EE_RDDM || ee == ~0u) {
+			break;
+		}
+		sleep_ms(10);
+	}
+	say("apollo wifi: RDDM: execution environment %#x (%s) after %llu ms\n", ee, execution_environment(ee), (now_us() - began) / 1000);
+	if (ee != MHI_EE_RDDM) {
+		return;
+	}
+	for (began = now_us(); now_us() - began < RDDM_WAIT_US; sleep_ms(10)) {
+		if (ipcr_stopping() || !wifi_link_alive) {
+			say("apollo wifi: RDDM: power down: the collection is given up\n");
+			return;
+		}
+		status = rd(base + BHIE_RXVECSTATUS_OFF);
+		if (status == ~0u || (status >> 30) == BHIE_STATUS_XFER_COMPL || (status >> 30) == BHIE_STATUS_ERROR) {
+			break;
+		}
+	}
+	if (ipcr_stopping() || !wifi_link_alive) {
+		return;
+	}
+	say("apollo wifi: RDDM: RXVECSTATUS %#x (status %u, sequence %u) after %llu ms; BHI error %#x, debug %#x %#x\n", status, status >> 30,
+	    status & BHIE_SEQ_MASK, (now_us() - began) / 1000, rd(bhi_base + BHI_ERRCODE), rd(bhi_base + BHI_ERRDBG1), rd(bhi_base + BHI_ERRDBG2));
+	if ((status >> 30) != BHIE_STATUS_XFER_COMPL) {
+		return;
+	}
+	cache_flush(rddm.buffer, size);
+	for (size_t o = size; o > 0; o--) {
+		if (dump[o - 1] != 0) {
+			extent = o;
+			break;
+		}
+	}
+	say("apollo wifi: RDDM: dump buffer %zu bytes (%u segments of %#x) at IOVA %#llx; the last non-zero byte is at %#zx (%zu bytes)\n", size,
+	    RDDM_SEGMENTS, RDDM_SEGMENT, rddm.buffer_iova, extent ? extent - 1 : 0, extent);
+	say("apollo wifi: RDDM: first bytes: %08x %08x %08x %08x %08x %08x %08x %08x\n", ((const uint32_t *)dump)[0], ((const uint32_t *)dump)[1],
+	    ((const uint32_t *)dump)[2], ((const uint32_t *)dump)[3], ((const uint32_t *)dump)[4], ((const uint32_t *)dump)[5],
+	    ((const uint32_t *)dump)[6], ((const uint32_t *)dump)[7]);
+	{
+		int disk = 0;
+
+		rddm_image = hakios_image_file("fw", "amss.bin", &rddm_image_size, &disk);
+	}
+	printed = rddm_scan(dump, extent, seen);
+	say("apollo wifi: RDDM: %u crash-reason candidates printed (printable runs of %u or more characters)\n", printed, RDDM_RUN_MIN);
+}
+
+/* amss.bin and the control pages in memory, mapped for the chip; the contexts and rings filled as Linux's mhi_init_dev_ctxt() does */
+static bool
+w2c_prepare(void)
+{
+	const uint8_t *image, *data;
+	uint64_t size = 0, remaining;
+	uint32_t segments;
+	struct w2c_context *chan, *event, *cmd;
+	struct bhi_vec {
+		uint64_t address, size;
+	} *vector;
+	int disk = -1;
+	uint64_t ctrl_physical = 0;
+
+	image = hakios_image_file("fw", "amss.bin", &size, &disk);
+	if (image == NULL || size < W2C_SEGMENT) {
+		say("apollo wifi: W2c: no fw/amss.bin in the small image (%llu bytes)\n", size);
+		return false;
+	}
+	/* mhi_fw_load_handler(): a second ELF header after the SBL's sbl_size means: the chip gets only what is behind it */
+	data = image;
+	if (size > W2C_SEGMENT + 4 && memcmp(image + W2C_SEGMENT, "\x7f" "ELF", 4) == 0) {
+		data += W2C_SEGMENT;
+		size -= W2C_SEGMENT;
+		say("apollo wifi: W2c: a second ELF header after the first %#x bytes: only what follows goes over BHIe\n", W2C_SEGMENT);
+	}
+	segments = (uint32_t)((size + W2C_SEGMENT - 1) / W2C_SEGMENT);
+	if (segments * sizeof(struct bhi_vec) > 4096) {
+		say("apollo wifi: W2c: %u segments do not fit one page of vector table\n", segments);
+		return false;
+	}
+	w2c.segments = segments;
+	if (kmem_alloc(kernel_map, &w2c.image, (vm_size_t)segments * W2C_SEGMENT, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS ||
+	    (w2c.ctrl = ctrl_alloc(W2C_CTRL_PAGES * 4096, &ctrl_physical)) == 0) {
+		say("apollo wifi: W2c: no memory for the image (%u KB) and the control pages (%u KB in one piece)\n", segments * W2C_SEGMENT / 1024, W2C_CTRL_PAGES * 4);
+		w2c.image = w2c.ctrl = 0;
+		return false;
+	}
+	memcpy((void *)w2c.image, data, size);
+	cache_flush(w2c.image, (size_t)size);
+	if (!wsmmu_map_as(0, ctrl_physical, W2C_CTRL_PAGES * 4096, WIFI_PTE, &w2c.ctrl_iova) || !wsmmu_map(w2c.image, segments * W2C_SEGMENT, &w2c.image_iova)) {
+		w2c.ctrl = 0;
+		return false;
+	}
+	/* the vector table: mhi_firmware_copy_bhie(): address and size of each segment (ours are contiguous in the chip's addresses) */
+	vector = (struct bhi_vec *)(w2c.ctrl + W2C_OFF_VECTOR);
+	remaining = size;
+	for (uint32_t n = 0; n < segments; n++) {
+		vector[n].address = w2c.image_iova + (uint64_t)n * W2C_SEGMENT;
+		vector[n].size = remaining < W2C_SEGMENT ? remaining : W2C_SEGMENT;
+		remaining -= vector[n].size;
+	}
+	/* channel contexts: all zero (disabled) but ath11k's two, IPCR 20 (to the device) and 21 (from it), on event ring 1, burst mode off */
+	chan = (struct w2c_context *)(w2c.ctrl + W2C_OFF_CHAN);
+	chan[20].word0 = W2C_BRST_DISABLE << 8;
+	chan[20].word1 = W2C_TO_DEVICE;
+	chan[20].word2 = 1;
+	chan[21].word0 = W2C_BRST_DISABLE << 8;
+	chan[21].word1 = W2C_FROM_DEVICE;
+	chan[21].word2 = 1;
+	/* event contexts: intmod (ms) in [31:16], ertype valid, the MSI vector number; ring base, length, rp = wp = base */
+	event = (struct w2c_context *)(w2c.ctrl + W2C_OFF_EVENT);
+	event[0].word0 = 0u << 16;
+	event[0].word1 = W2C_ER_TYPE_VALID;
+	event[0].word2 = 1;
+	event[0].rbase = event[0].rp = event[0].wp = w2c.ctrl_iova + W2C_OFF_ER0;
+	event[0].rlen = W2C_ER0_ELEMENTS * W2C_ELEMENT;
+	event[1].word0 = 1u << 16;
+	event[1].word1 = W2C_ER_TYPE_VALID;
+	event[1].word2 = 2;
+	event[1].rbase = event[1].rp = event[1].wp = w2c.ctrl_iova + W2C_OFF_ER1;
+	event[1].rlen = W2C_ER1_ELEMENTS * W2C_ELEMENT;
+	w2c.rp[0] = event[0].rp;                /* mhi_init_event_ctxt(): rp = wp = base, until the ready transition moves the wp */
+	w2c.rp[1] = event[1].rp;
+	cmd = (struct w2c_context *)(w2c.ctrl + W2C_OFF_CMD);
+	cmd->rbase = cmd->rp = cmd->wp = w2c.ctrl_iova + W2C_OFF_CMD_RING;
+	cmd->rlen = W2C_CMD_ELEMENTS * W2C_ELEMENT;
+	__asm__ volatile ("dsb sy");            /* (the control pages are the uncached alias: nothing to flush) */
+	say("apollo wifi: W2c: amss.bin: %llu bytes in %u segments of %#x at %#llx; control pages (%u KB) at %#llx: channel contexts +%#x, "
+	    "event contexts +%#x, command context +%#x, command ring +%#x, event rings +%#x and +%#x, vector table +%#x; next free address %#llx\n",
+	    size, segments, W2C_SEGMENT, w2c.image_iova, W2C_CTRL_PAGES * 4, w2c.ctrl_iova, W2C_OFF_CHAN, W2C_OFF_EVENT, W2C_OFF_CMD,
+	    W2C_OFF_CMD_RING, W2C_OFF_ER0, W2C_OFF_ER1, W2C_OFF_VECTOR, wsmmu.next);
+	return true;
+}
+
+/* mhi_ready_state_transition(), mhi_init_mmio(), M0: until the chip's MHI is in M0 */
+static bool
+w2c_ready_m0(void)
+{
+	uint64_t began = now_us();
+	uint32_t mhi = ~0u, ctrl = ~0u, offset, cfg, ee, window_unreadable = 0;
+	uint64_t window_start = WIFI_ADDRESSES, window_stop = WIFI_ADDRESSES + WIFI_POOL_SIZE - 1;
+
+	/* 1. MHISTATUS readable (all ones: the chip's MHI side is down; Linux's "link down" test) */
+	while (now_us() - began < W2C_WAIT_US) {
+		mhi = rd(bar + MHI_STATUS);
+		if (mhi != ~0u) {
+			break;
+		}
+		window_unreadable++;
+		sleep_ms(10);
+	}
+	if (mhi == ~0u) {
+		say("apollo wifi: W2c: MHISTATUS unreadable (all ones) for 20 s\n");
+		return false;
+	}
+	say("apollo wifi: W2c: MHISTATUS readable after %llu ms (%u reads all ones): %#x\n", (now_us() - began) / 1000, window_unreadable, mhi);
+	wr(bhi_base + BHI_INTVEC, 0);           /* mhi_async_power_up(): the chip clears it when it resets; 0: MHI's own interrupt is MSI vector 0 */
+	/* 2. RESET cleared, then READY, by the chip (polled every 10 ms; Linux: 25 ms) */
+	w2c.ee = w2c.mhi = 0x12345678;
+	for (began = now_us(); now_us() - began < W2C_WAIT_US; w2c_wait()) {
+		ctrl = rd(bar + MHI_CTRL);
+		mhi = rd(bar + MHI_STATUS);
+		w2c_poll(began, "waiting for READY");
+		if (ctrl != ~0u && mhi != ~0u && !(ctrl & MHICTRL_RESET) && (mhi & MHISTATUS_READY)) {
+			break;
+		}
+	}
+	if (ctrl == ~0u || mhi == ~0u || (ctrl & MHICTRL_RESET) || !(mhi & MHISTATUS_READY)) {
+		say("apollo wifi: W2c: THE CHIP DID NOT BECOME READY in 20 s: MHICTRL %#x, MHISTATUS %#x\n", ctrl, mhi);
+		wifi_final_dump("W2c: READY not reached");
+		return false;
+	}
+	say("apollo wifi: W2c: MHI READY after %llu ms (MHICTRL %#x, MHISTATUS %#x)\n", (now_us() - began) / 1000, ctrl, mhi);
+	if (!w2c_prepare()) {
+		return false;
+	}
+	w2c_rddm_prepare();                     /* mhi_prepare_for_power_up(): before the chip runs on (not fatal when it fails) */
+	/* mhi_init_mmio(): the register values come from the contexts and from the window */
+	offset = rd(bar + MHI_ERDBOFF);
+	if (offset == 0 || offset == ~0u || (uint64_t)offset + 8 * W2C_EVENT_RINGS > bar_mapped) {         /* (a doorbell of 8 bytes per event ring) */
+		say("apollo wifi: W2c: ERDBOFF %#x is out of range\n", offset);
+		return false;
+	}
+	say("apollo wifi: W2c: MHI registers: channel contexts %#llx, event contexts %#llx, command context %#llx, window %#llx to %#llx, "
+	    "%u event rings (doorbells at +%#x), 0 hardware event rings\n", w2c.ctrl_iova + W2C_OFF_CHAN, w2c.ctrl_iova + W2C_OFF_EVENT,
+	    w2c.ctrl_iova + W2C_OFF_CMD, window_start, window_stop, W2C_EVENT_RINGS, offset);
+	w2b_hold("the MHI context registers (first MMIO writes of W2c: CCABAP, ECABAP, CRCBAP, window, MHICFG)");
+	mhi_write64(MHI_CCABAP_LOWER, w2c.ctrl_iova + W2C_OFF_CHAN);
+	mhi_write64(MHI_ECABAP_LOWER, w2c.ctrl_iova + W2C_OFF_EVENT);
+	mhi_write64(MHI_CRCBAP_LOWER, w2c.ctrl_iova + W2C_OFF_CMD);
+	mhi_write64(MHI_CTRLBASE_LOWER, window_start);
+	mhi_write64(MHI_DATABASE_LOWER, window_start);
+	mhi_write64(MHI_CTRLLIMIT_LOWER, window_stop);
+	mhi_write64(MHI_DATALIMIT_LOWER, window_stop);
+	cfg = rd(bar + MHI_CFG);
+	cfg &= ~(0xffu << MHICFG_NER_SHIFT | 0xffu << MHICFG_NHWER_SHIFT);
+	cfg |= W2C_EVENT_RINGS << MHICFG_NER_SHIFT;
+	wr(bar + MHI_CFG, cfg);
+	say("apollo wifi: W2c: MHICFG now %#x\n", rd(bar + MHI_CFG));
+	/* mhi_ready_state_transition(): each software event ring's write pointer to its last element, and its doorbell */
+	{
+		struct w2c_context *event = (struct w2c_context *)(w2c.ctrl + W2C_OFF_EVENT);
+
+		for (unsigned ring = 0; ring < W2C_EVENT_RINGS; ring++) {
+			event[ring].wp = w2c.wp[ring] = event[ring].rbase + event[ring].rlen - W2C_ELEMENT;
+		}
+		w2c.erdb = offset;
+		w2c.chdb = rd(bar + MHI_CHDBOFF);       /* (checked where it is used: chdb_ok()) */
+		for (unsigned ring = 0; ring < W2C_EVENT_RINGS; ring++) {
+			mhi_write64(offset + 8 * ring, event[ring].wp);
+		}
+		w2c.rings = true;
+	}
+	/* 3. M0 */
+	w2b_hold("MHI state M0 requested (MHICTRL)");
+	ctrl = rd(bar + MHI_CTRL);
+	ctrl &= ~(0xffu << MHICTRL_STATE_SHIFT);
+	ctrl |= MHI_STATE_M0 << MHICTRL_STATE_SHIFT;
+	wr(bar + MHI_CTRL, ctrl);
+	say("apollo wifi: W2c: M0 requested (MHICTRL %#x)\n", ctrl);
+	w2c.ee = w2c.mhi = 0x12345678;
+	for (began = now_us(); now_us() - began < W2C_WAIT_US; w2c_wait()) {
+		w2c_poll(began, "waiting for M0");
+		mhi = w2c.mhi;
+		if (mhi != ~0u && (mhi >> MHISTATUS_STATE_SHIFT & 0xff) == MHI_STATE_M0) {
+			break;
+		}
+		if (mhi != ~0u && (mhi & MHISTATUS_SYSERR)) {
+			say("apollo wifi: W2c: THE CHIP REPORTS A SYSTEM ERROR (MHISTATUS %#x, BHI error %#x, debug %#x %#x %#x)\n", mhi,
+			    rd(bhi_base + BHI_ERRCODE), rd(bhi_base + BHI_ERRDBG1), rd(bhi_base + BHI_ERRDBG2), rd(bhi_base + BHI_ERRDBG3));
+			return false;
+		}
+	}
+	if (mhi == ~0u || (mhi >> MHISTATUS_STATE_SHIFT & 0xff) != MHI_STATE_M0) {
+		say("apollo wifi: W2c: THE CHIP DID NOT ENTER M0 in 20 s: MHISTATUS %#x\n", mhi);
+		return false;
+	}
+	say("apollo wifi: W2c: MHI state M0 after %llu ms\n", (now_us() - began) / 1000);
+	ee = rd(bhi_base + BHI_EXECENV);
+	say("apollo wifi: W2c: execution environment %#x (%s)\n", ee, execution_environment(ee));
+	return true;
+}
+
+/* mhi_fw_load_bhie(): the vector table's address and size, the doorbell with a sequence id, the status polled */
+static bool
+w2c_bhie(void)
+{
+	uint64_t vector = w2c.ctrl_iova + W2C_OFF_VECTOR, began;
+	uint32_t length = w2c.segments * 16, offset = rd(bar + MHI_BHIE_OFF), sequence, status = 0, db;
+
+	if (offset == 0 || offset == ~0u || (uint64_t)offset + BHIE_RXVECSTATUS + 4 > bar_mapped) {
+		say("apollo wifi: W2c: no BHIe block where MHI says (%#x)\n", offset);
+		return false;
+	}
+	w2c.bhie = bar + offset;
+	sequence = ((uint32_t)mach_absolute_time() & BHIE_SEQ_MASK) | 1;
+	say("apollo wifi: W2c: BHIe at +%#x: TXVECSTATUS before %#x; vector table at %#llx, %u bytes (%u segments), sequence %u\n", offset,
+	    rd(w2c.bhie + BHIE_TXVECSTATUS), vector, length, w2c.segments, sequence);
+	w2b_hold("the BHIe registers and doorbell: the chip reads all of amss.bin");
+	wr(w2c.bhie + BHIE_TXVECADDR_HIGH, (uint32_t)(vector >> 32));
+	wr(w2c.bhie + BHIE_TXVECADDR_LOW, (uint32_t)vector);
+	wr(w2c.bhie + BHIE_TXVECSIZE, length);
+	db = rd(w2c.bhie + BHIE_TXVECDB);       /* mhi_write_reg_field(): read, replace the field, write */
+	db = (db & ~BHIE_SEQ_MASK) | sequence;
+	wr(w2c.bhie + BHIE_TXVECDB, db);
+	w2c.ee = w2c.mhi = 0x12345678;
+	for (began = now_us(); now_us() - began < W2C_WAIT_US; w2c_wait()) {
+		w2c_poll(began, "BHIe");
+		status = rd(w2c.bhie + BHIE_TXVECSTATUS);
+		if (status != ~0u && (status >> 30) != 0) {
+			break;
+		}
+	}
+	if ((status >> 30) == BHIE_STATUS_ERROR || status == ~0u) {
+		say("apollo wifi: W2c: THE CHIP REFUSED THE FIRMWARE: TXVECSTATUS %#x (status %u, sequence %u), BHI error %#x, debug %#x %#x %#x\n",
+		    status, status >> 30, status & BHIE_SEQ_MASK, rd(bhi_base + BHI_ERRCODE), rd(bhi_base + BHI_ERRDBG1), rd(bhi_base + BHI_ERRDBG2),
+		    rd(bhi_base + BHI_ERRDBG3));
+		return false;
+	}
+	if ((status >> 30) != BHIE_STATUS_XFER_COMPL) {
+		say("apollo wifi: W2c: THE CHIP DID NOT FINISH THE DOWNLOAD in 20 s: TXVECSTATUS %#x, BHI error %#x\n", status, rd(bhi_base + BHI_ERRCODE));
+		return false;
+	}
+	say("apollo wifi: W2c: the chip took the firmware after %llu ms: TXVECSTATUS %#x (sequence %u, expected %u)\n",
+	    (now_us() - began) / 1000, status, status & BHIE_SEQ_MASK, sequence);
+	return true;
+}
+
+static bool
+mission_mode(void)
+{
+	uint64_t began;
+	uint32_t ee = ~0u;
+
+	if (bhi_base == 0 || !wsmmu.on) {
+		say("apollo wifi: W2c: W2b's state is not there\n");
+		return false;
+	}
+	if (!w2c.msi_attached) {                /* (first_stage() did it already with apollo_wifi_prep) */
+		w2c_msi_setup();                /* (its failure is not W2c's: the polls go on) */
+	}
+	if (!w2c_ready_m0()) {
+		return false;
+	}
+	/* the chip goes on to SBL (Linux waits for the EE event; this polls BHI's execution environment) */
+	for (began = now_us(); now_us() - began < W2C_WAIT_US; w2c_wait()) {
+		w2c_poll(began, "waiting for SBL");
+		ee = w2c.ee;
+		if (ee == MHI_EE_SBL || ee == MHI_EE_AMSS || ee == MHI_EE_RDDM) {
+			break;
+		}
+	}
+	if (ee == MHI_EE_RDDM || (ee != MHI_EE_SBL && ee != MHI_EE_AMSS)) {
+		say("apollo wifi: W2c: THE CHIP DID NOT REACH SBL: execution environment %#x (%s)\n", ee, execution_environment(ee));
+		return false;
+	}
+	if (ee == MHI_EE_SBL) {
+		say("apollo wifi: W2c: SBL after %llu ms\n", (now_us() - began) / 1000);
+		if (!w2c_bhie()) {
+			return false;
+		}
+	}
+	/* then AMSS, with MHI in M0 */
+	for (began = now_us(); now_us() - began < W2C_WAIT_US; w2c_wait()) {
+		w2c_poll(began, "waiting for AMSS");
+		if (w2c.ee == MHI_EE_AMSS && (w2c.mhi >> MHISTATUS_STATE_SHIFT & 0xff) == MHI_STATE_M0) {
+			break;
+		}
+		if (w2c.ee == MHI_EE_RDDM) {
+			break;
+		}
+	}
+	w2c_events();
+	if (w2c.ee != MHI_EE_AMSS || (w2c.mhi >> MHISTATUS_STATE_SHIFT & 0xff) != MHI_STATE_M0) {
+		if (w2c.ee == MHI_EE_RDDM) {
+			wifi_mark_dead("W2c: the chip is in RDDM, no mission mode");
+			wifi_rddm_collect("W2c: the chip is in RDDM, no mission mode");
+		}
+		say("apollo wifi: W2c: NO MISSION MODE: execution environment %#x (%s), MHISTATUS %#x, BHI status %#x, error %#x\n", w2c.ee,
+		    execution_environment(w2c.ee), w2c.mhi, rd(bhi_base + BHI_STATUS), rd(bhi_base + BHI_ERRCODE));
+		return false;
+	}
+	mhi_wake_hold();
+	say("apollo wifi: W2c DONE: the QCA6390 runs its firmware (AMSS), MHI in M0, after %llu ms\n", (now_us() - began) / 1000);
+	return true;
+}
+
+/* ---- IPCR: the MHI channels 20 (to the chip) and 21 (from it), and the interface of bsd/sys/hakios.apollo_wifi.h ------------------- */
+
+/*
+ * ath11k_mhi_channels_qca6390 (drivers/net/wireless/ath/ath11k/mhi.c): "IPCR" 20, DMA_TO_DEVICE, and 21, DMA_FROM_DEVICE, each
+ * num_elements = 64, event_ring = 1, doorbell MHI_DB_BRST_DISABLE, ee_mask 0x4 (AMSS), no lpm_notify, no offload; the client is
+ * the QRTR MHI transport (net/qrtr/mhi.c: one QRTR packet per transfer). Neither channel has intmod (BEI clear).
+ *
+ * Our memory for them is one allocation in the Wi-Fi's addresses (mapped by wsmmu_map, in this order; the TRE rings are 1 KB, a
+ * 4K page each keeps them aligned to their length as mhi_alloc_aligned_ring() does):
+ *   +0x0000  channel 20's transfer ring (64 elements of 16 bytes)
+ *   +0x1000  channel 21's transfer ring
+ *   +0x2000  the bounce buffer of apollo_ipcr_send (16 KB)
+ *   +0x6000  32 receive buffers of 16 KB (512 KB): channel 21's TREs, IEOT set, chain clear
+ * (16 KB: a QRTR packet is up to 8192 bytes of payload and its header, more than 8 KB; Linux's buffers are MHI_MAX_MTU, 64 KB)
+ */
+#define IPCR_ELEMENTS           64              /* .num_elements of both channels */
+#define IPCR_OFF_UL_RING        0x0000
+#define IPCR_OFF_DL_RING        0x1000
+#define IPCR_OFF_TX             0x2000
+#define IPCR_TX_SIZE            0x4000
+#define IPCR_OFF_RX             0x6000
+#define IPCR_RX_SIZE            0x4000          /* (the TRE's length field is 16 bits) */
+#define IPCR_RX_BUFFERS         32              /* half the ring: a TRE ring of 64 holds 63 at most */
+#define IPCR_PAGES              (IPCR_OFF_RX / 4096 + IPCR_RX_BUFFERS * IPCR_RX_SIZE / 4096)
+#define IPCR_CMD_TIMEOUT_MS     20000           /* ath11k_mhi_register(): mhi_ctrl->timeout_ms = 20 * 1000 */
+#define IPCR_TX_TIMEOUT_MS      3000
+#define IPCR_LOG_MOST           40              /* packets told in the log */
+
+static struct {
+	vm_offset_t mem;                /* never freed (the chip may use it until PERST# is down) */
+	uint64_t iova;
+	volatile bool up, stop, failed;
+	volatile bool event_alive, deliver_alive;
+	uint32_t ul_wp, dl_wp;          /* the host's write element index of each ring (mhi_ring wp) */
+	volatile uint32_t ul_rp;        /* the UL element after the last one the chip has completed (its transfer events) */
+	volatile bool ul_failed;        /* a send timed out: its TRE may still point at the bounce buffer, so no more sends */
+	uint8_t dl_slot[IPCR_ELEMENTS]; /* the receive buffer each DL element carries */
+	struct {
+		uint8_t buffer;
+		uint16_t length;
+	} queue[IPCR_RX_BUFFERS];       /* the events waiting for the delivery thread (wifi_ev_lock) */
+	unsigned queue_head, queue_count;
+	uint32_t cmd_wp;                /* the command ring's write element index */
+	volatile uint64_t cmd_ptr;      /* the command element the host waits for the completion of */
+	volatile bool cmd_done;
+	volatile uint32_t cmd_code;
+	volatile uint64_t tx_ptr;       /* the UL element the sender waits for */
+	volatile bool tx_done;
+	volatile uint32_t tx_code;
+	void (*receive)(const void *data, unsigned long length, void *context);
+	void *context;
+	uint32_t sent, received, dropped, told;
+	uint32_t wake_refs;             /* mhi_cntrl->dev_wake */
+	bool wake_set;                  /* mhi_cntrl->wake_set */
+	bool wake_perm;                 /* the permanent assertion of mhi_wake_hold() is on (one of wake_refs) */
+	vm_offset_t rings;              /* the two transfer rings (2 pages, one physical piece), the UNCACHED alias (ctrl_alloc) */
+	uint64_t rings_iova;
+} ipcr;
+static uint32_t ipcr_rx_wait;           /* the event the delivery thread sleeps on (its address) */
+static LCK_MTX_DECLARE(ipcr_tx_lock, &wifi_lck_grp);    /* apollo_ipcr_send: one at a time (the bounce buffer, the UL ring) */
+static LCK_MTX_DECLARE(ipcr_cmd_lock, &wifi_lck_grp);   /* one command on the command ring at a time */
+
+static void wake_toggle(void);
+
+/* CHDBOFF in BAR0 with room for all 128 doorbells of 8 bytes (the wake doorbell 127, at +0x3f8, is the last) */
+static bool
+chdb_ok(void)
+{
+	return w2c.chdb != 0 && w2c.chdb != ~0u && (uint64_t)w2c.chdb + 8 * 128 <= bar_mapped;
+}
+
+/* mhi_write_db() of channel (or doorbell number) n: the high half first, then the low half. Not to a crashed chip; in M2 the wake first (main.c wake_toggle) */
+static void
+ipcr_channel_db(unsigned n, uint64_t value)
+{
+	if (wifi_dead || !wifi_link_alive) {
+		return;
+	}
+	if (n != MHI_DEV_WAKE_DB && w2c_m2) {
+		wake_toggle();
+	}
+	mhi_write64(w2c.chdb + 8 * n, value);
+}
+
+/* The crash, once: from here no register of the chip is touched except by wifi_rddm_collect() (BHI, BHIe) */
+static void
+wifi_mark_dead(const char *why)
+{
+	if (!__sync_bool_compare_and_swap(&wifi_dead, false, true)) {
+		return;
+	}
+	say("apollo wifi: THE FIRMWARE HAS CRASHED (%s): no more register access, doorbells or sends; only the RDDM collection reads the chip\n", why);
+}
+
+/* mhi_assert_dev_wake(force) / mhi_deassert_dev_wake(): the count, and the wake doorbell (M0 is a state the doorbell is valid in). With the permanent assertion (mhi_wake_hold) only the count moves: the doorbell stays up. A crashed chip: nothing. */
+void
+apollo_wifi_wake(int on)
+{
+	bool valid = wifi_amss && chdb_ok();
+
+	if (wifi_dead) {
+		return;
+	}
+	lck_spin_lock(&wifi_wake_lock);
+	if (on) {
+		ipcr.wake_refs++;
+		if (valid && !ipcr.wake_perm && !ipcr.wake_set) {       /* MHI_WAKE_DB_FORCE_SET_VALID(M0) && !wake_set */
+			ipcr_channel_db(MHI_DEV_WAKE_DB, 1);
+			ipcr.wake_set = true;
+		}
+	} else if (ipcr.wake_refs != 0 && --ipcr.wake_refs == 0 && valid && ipcr.wake_set) {  /* MHI_WAKE_DB_CLEAR_VALID(M0) */
+		ipcr_channel_db(MHI_DEV_WAKE_DB, 0);
+		ipcr.wake_set = false;
+	}
+	lck_spin_unlock(&wifi_wake_lock);
+}
+
+/*
+ * The device kept in M0: mhi_assert_dev_wake(mhi_cntrl, true) (pm.c, the force case: dev_wake++, wake doorbell 127 = 1 when the PM
+ * state allows and wake_set is clear), once, right after AMSS and before IPCR; it stays up (its count included) until power down. Then
+ * MHISTATUS is polled for state M0, 2 s at most. wifi_amss is not set yet here, so the doorbell is rung directly (M0 is established).
+ */
+static void
+mhi_wake_hold(void)
+{
+	uint64_t began = now_us();
+	uint32_t mhi = ~0u;
+
+	if (wifi_dead || !chdb_ok()) {
+		return;
+	}
+	lck_spin_lock(&wifi_wake_lock);
+	if (!ipcr.wake_perm) {
+		ipcr.wake_refs++;
+		ipcr.wake_perm = true;
+		if (!ipcr.wake_set) {
+			ipcr_channel_db(MHI_DEV_WAKE_DB, 1);
+			ipcr.wake_set = true;
+		}
+	}
+	lck_spin_unlock(&wifi_wake_lock);
+	for (; now_us() - began < 2000000ull; sleep_ms(1)) {
+		mhi = rd(bar + MHI_STATUS);
+		if (mhi != ~0u && (mhi >> MHISTATUS_STATE_SHIFT & 0xff) == MHI_STATE_M0) {
+			break;
+		}
+	}
+	say("apollo wifi: W2c: device wake asserted for good (wake doorbell %u = 1): MHISTATUS %#x, state %u (%s) after %llu ms\n", MHI_DEV_WAKE_DB, mhi,
+	    mhi >> MHISTATUS_STATE_SHIFT & 0xff, (mhi != ~0u && (mhi >> MHISTATUS_STATE_SHIFT & 0xff) == MHI_STATE_M0) ? "M0" : "NOT M0", (now_us() - began) / 1000);
+}
+
+/* power down: the permanent assertion released (mhi_deassert_dev_wake: the count down, the doorbell to 0 at the last one); a crashed chip: nothing */
+static void
+mhi_wake_release(void)
+{
+	bool ring;
+
+	if (wifi_dead) {
+		return;
+	}
+	lck_spin_lock(&wifi_wake_lock);
+	ipcr.wake_perm = false;
+	ring = false;
+	if (ipcr.wake_refs != 0 && --ipcr.wake_refs == 0 && ipcr.wake_set) {
+		ring = true;
+		ipcr.wake_set = false;
+	}
+	if (ring) {
+		ipcr_channel_db(MHI_DEV_WAKE_DB, 0);
+	}
+	lck_spin_unlock(&wifi_wake_lock);
+}
+
+static bool
+mhi_wake_is_held(void)
+{
+	return ipcr.wake_perm || ipcr.wake_refs != 0;
+}
+
+/* mhi_pm_m1_transition()'s wake_get(force): the wake doorbell once more, the count unchanged */
+static void
+mhi_wake_reassert(void)
+{
+	lck_spin_lock(&wifi_wake_lock);
+	ipcr_channel_db(MHI_DEV_WAKE_DB, 1);
+	ipcr.wake_set = true;
+	lck_spin_unlock(&wifi_wake_lock);
+}
+
+/* main.c mhi_toggle_dev_wake (the wake_toggle of M2, before a doorbell): wake_get(false) then wake_put(override): the wake doorbell is up afterwards, the count as before */
+static void
+wake_toggle(void)
+{
+	lck_spin_lock(&wifi_wake_lock);
+	if (!ipcr.wake_set) {
+		ipcr_channel_db(MHI_DEV_WAKE_DB, 1);
+		ipcr.wake_set = true;
+	}
+	lck_spin_unlock(&wifi_wake_lock);
+}
+
+static bool
+ipcr_cmd_pending(void)
+{
+	return ipcr.cmd_ptr != 0;
+}
+
+static bool
+ipcr_up(void)
+{
+	return ipcr.up;
+}
+
+/* power down has begun: the IPCR threads are on their way out (wifi_rddm_collect() gives up) */
+static bool
+ipcr_stopping(void)
+{
+	return ipcr.stop;
+}
+
+/* a transfer ring element: ptr in words 0 and 1, dword[0] = length, dword[1] = type 2 (transfer) and IEOT (MHI_TRE_DATA_DWORD1(0, 1, 0, 0)) */
+static void
+ipcr_tre(vm_offset_t element, uint64_t buffer, uint32_t length)
+{
+	volatile uint32_t *tre = (volatile uint32_t *)element;
+
+	tre[0] = (uint32_t)buffer;
+	tre[1] = (uint32_t)(buffer >> 32);
+	tre[2] = length & 0xffff;                       /* MHI_TRE_DATA_DWORD0 */
+	tre[3] = W2C_TRE_TYPE_TRANSFER << 16 | 1u << 9; /* MHI_TRE_DATA_DWORD1: IEOT (BIT 9) */
+	/* (the rings are the uncached alias: no cache maintenance; mhi_write64() orders the stores before the doorbell) */
+}
+
+/* mhi_gen_tre() for channel 21 (the ring never fills: IPCR_RX_BUFFERS < IPCR_ELEMENTS - 1) and, with ring_db, mhi_ring_chan_db() */
+static void
+ipcr_dl_queue(uint8_t buffer, bool ring_db)
+{
+	struct w2c_context *chan = (struct w2c_context *)(w2c.ctrl + W2C_OFF_CHAN);
+	uint64_t ring = ipcr.rings_iova + IPCR_OFF_DL_RING;
+
+	ipcr_tre(ipcr.rings + IPCR_OFF_DL_RING + (vm_offset_t)ipcr.dl_wp * W2C_ELEMENT, ipcr.iova + IPCR_OFF_RX + (uint64_t)buffer * IPCR_RX_SIZE, IPCR_RX_SIZE);
+	ipcr.dl_slot[ipcr.dl_wp] = buffer;
+	ipcr.dl_wp = (ipcr.dl_wp + 1) % IPCR_ELEMENTS;
+	if (ring_db) {
+		chan[IPCR_DL].wp = ring + (uint64_t)ipcr.dl_wp * W2C_ELEMENT;   /* mhi_ring_chan_db(): *ring->ctxt_wp, then the doorbell */
+		ipcr_channel_db(IPCR_DL, chan[IPCR_DL].wp);
+	}
+}
+
+/*
+ * Called by w2c_events() with wifi_ev_lock held, on every element of an event ring. The command completion of ring 0 is recorded for
+ * ipcr_command() (mhi_process_cmd_completion(): the element it points at is the command's), not consumed: false makes the caller log
+ * it too. The transfer events of ring 1 once the channels run (parse_xfer_event()): true, handled.
+ */
+static bool
+ipcr_event(unsigned ring, __unused uint64_t index, const volatile uint32_t *tre)
+{
+	uint32_t type = tre[3] >> 16 & 0xff, code = tre[2] >> 24, length = tre[2] & 0xffff, chan = tre[3] >> 24;
+	uint64_t ptr = (uint64_t)tre[1] << 32 | tre[0];
+
+	if (ring == 0 && type == W2C_PKT_CMD_COMPLETION && ipcr.cmd_ptr != 0 && ptr == ipcr.cmd_ptr) {
+		ipcr.cmd_code = code;
+		ipcr.cmd_done = true;
+		thread_wakeup((event_t)&ipcr.cmd_done);
+		return false;
+	}
+	if (ring != 1 || type != W2C_PKT_TX_EVENT || !ipcr.up) {
+		return false;
+	}
+	if (code != W2C_EV_CC_EOT && code != W2C_EV_CC_EOB && code != W2C_EV_CC_OVERFLOW) {     /* OOB and DB_MODE: burst mode is off */
+		say("apollo wifi: IPCR: channel %u transfer event code %u (ptr %#llx, length %u)\n", chan, code, ptr, length);
+		return true;
+	}
+	if (chan == IPCR_UL) {
+		uint64_t ring_base = ipcr.rings_iova + IPCR_OFF_UL_RING;
+
+		if (ptr >= ring_base && ptr < ring_base + IPCR_ELEMENTS * W2C_ELEMENT && (ptr - ring_base) % W2C_ELEMENT == 0) {
+			ipcr.ul_rp = (uint32_t)((ptr - ring_base) / W2C_ELEMENT + 1) % IPCR_ELEMENTS;  /* (the chip's rp: the ring-full check of send) */
+		}
+		if (ptr == ipcr.tx_ptr) {                       /* (a late event of a send that timed out is not the one waited for) */
+			ipcr.tx_code = code;
+			ipcr.tx_done = true;
+			thread_wakeup((event_t)&ipcr.tx_done);
+		}
+	} else if (chan == IPCR_DL) {
+		uint64_t ring_base = ipcr.rings_iova + IPCR_OFF_DL_RING;
+		unsigned slot;
+		uint8_t buffer;
+
+		if (ptr < ring_base || ptr >= ring_base + IPCR_ELEMENTS * W2C_ELEMENT || (ptr - ring_base) % W2C_ELEMENT) {
+			say("apollo wifi: IPCR: DL event points outside the ring (%#llx)\n", ptr);
+			return true;
+		}
+		slot = (unsigned)((ptr - ring_base) / W2C_ELEMENT);
+		buffer = ipcr.dl_slot[slot];
+		if (code == W2C_EV_CC_OVERFLOW || length > IPCR_RX_SIZE || ipcr.queue_count >= IPCR_RX_BUFFERS) {
+			ipcr.dropped++;                         /* a packet bigger than the buffer, as parse_xfer_event(): -EOVERFLOW; not delivered */
+			say("apollo wifi: IPCR: a packet of %u bytes dropped (code %u)\n", length, code);
+			ipcr_dl_queue(buffer, true);
+			return true;
+		}
+		slot = (ipcr.queue_head + ipcr.queue_count++) % IPCR_RX_BUFFERS;
+		ipcr.queue[slot].buffer = buffer;
+		ipcr.queue[slot].length = (uint16_t)length;
+		thread_wakeup((event_t)&ipcr_rx_wait);
+	}
+	return true;
+}
+
+/* Sleep on an event until the flag is set (the wakeup may come before the sleep: 1 ms steps) or ms have passed */
+static bool
+ipcr_wait(volatile bool *flag, uint32_t ms)
+{
+	for (uint64_t began = now_us(); !*flag; ) {
+		if (now_us() - began > (uint64_t)ms * 1000) {
+			return false;
+		}
+		assert_wait_timeout((event_t)flag, THREAD_UNINT, 1, NSEC_PER_MSEC);
+		thread_block(THREAD_CONTINUE_NULL);
+	}
+	return true;
+}
+
+/* The event ring thread: both event rings, on the MSI interrupts (vectors 1 and 2 wake w2c_wait()) and every 10 ms */
+static void
+ipcr_event_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	bool fault_told = false, error_told = false;
+
+	while (!ipcr.stop) {
+		w2c_events();                   /* (returns at once once the firmware has crashed) */
+		/* the radio driver at work: a refused access of the chip's, or the firmware down (SYS_ERR), is told once */
+		wsmmu_faults(&fault_told);
+		if (!error_told && !ipcr.stop && wifi_link_alive && (wifi_dead || (rd(bar + MHI_STATUS) >> 8 & 0xff) == 0xff)) {
+			error_told = true;
+			wifi_mark_dead("the firmware went to SYS_ERR while the driver ran");   /* from here nothing but the RDDM collection touches the chip */
+			/* (no wifi_final_dump(): its window registers are accesses to a crashed chip) */
+			wifi_rddm_collect("the firmware went to SYS_ERR while the driver ran");
+		}
+		w2c_wait();
+	}
+	ipcr.event_alive = false;
+	thread_terminate(current_thread());
+}
+
+/* The receive function's thread: one packet at a time, then its buffer back on the ring */
+static void
+ipcr_deliver_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	while (!ipcr.stop) {
+		uint8_t buffer = 0;
+		unsigned length = 0;
+		bool have = false;
+		void (*receive)(const void *, unsigned long, void *);
+
+		lck_mtx_lock(&wifi_ev_lock);
+		if (ipcr.queue_count != 0) {
+			buffer = ipcr.queue[ipcr.queue_head].buffer;
+			length = ipcr.queue[ipcr.queue_head].length;
+			ipcr.queue_head = (ipcr.queue_head + 1) % IPCR_RX_BUFFERS;
+			ipcr.queue_count--;
+			have = true;
+		}
+		lck_mtx_unlock(&wifi_ev_lock);
+		if (!have) {
+			assert_wait_timeout((event_t)&ipcr_rx_wait, THREAD_UNINT, 10, NSEC_PER_MSEC);
+			thread_block(THREAD_CONTINUE_NULL);
+			continue;
+		}
+		receive = ipcr.receive;
+		if (receive != NULL) {
+			vm_offset_t data = ipcr.mem + IPCR_OFF_RX + (vm_offset_t)buffer * IPCR_RX_SIZE;
+
+			cache_flush(data, length);              /* the chip wrote it behind the cache */
+			if (ipcr.told < IPCR_LOG_MOST) {
+				ipcr.told++;
+				say("apollo wifi: IPCR: received %u bytes (packet %u)\n", length, ipcr.received + 1);
+			}
+			ipcr.received++;
+			receive((const void *)data, length, ipcr.context);
+		} else {
+			ipcr.dropped++;
+		}
+		lck_mtx_lock(&wifi_ev_lock);
+		ipcr_dl_queue(buffer, true);
+		lck_mtx_unlock(&wifi_ev_lock);
+	}
+	ipcr.deliver_alive = false;
+	thread_terminate(current_thread());
+}
+
+/*
+ * mhi_send_cmd() and mhi_update_channel_state(): the device awake (mhi_device_get_sync), the command's element on the command ring
+ * (ptr 0, dword[0] 0, dword[1] = channel << 24 | command << 16: MHI_TRE_CMD_{START,STOP,RESET}_DWORD1), the ring's wp in the command
+ * context and on the command ring doorbell (CRDB, mhi_ring_cmd_db()), then the CMD_COMPLETION event of ring 0 that points at the element,
+ * code SUCCESS (mhi_process_cmd_completion(), checked as mhi_chan->ccs).
+ */
+static int
+ipcr_command(unsigned chan, unsigned command, const char *what)
+{
+	struct w2c_context *cmd = (struct w2c_context *)(w2c.ctrl + W2C_OFF_CMD);
+	uint64_t ring = w2c.ctrl_iova + W2C_OFF_CMD_RING;
+	vm_offset_t element;
+	volatile uint32_t *tre;
+	int error = 0;
+
+	if (wifi_dead) {
+		return EIO;
+	}
+	lck_mtx_lock(&ipcr_cmd_lock);
+	apollo_wifi_wake(1);
+	element = w2c.ctrl + W2C_OFF_CMD_RING + (vm_offset_t)ipcr.cmd_wp * W2C_ELEMENT;
+	tre = (volatile uint32_t *)element;
+	tre[0] = tre[1] = tre[2] = 0;
+	tre[3] = chan << 24 | command << 16;
+	ipcr.cmd_done = false;
+	ipcr.cmd_ptr = ring + (uint64_t)ipcr.cmd_wp * W2C_ELEMENT;
+	ipcr.cmd_wp = (ipcr.cmd_wp + 1) % W2C_CMD_ELEMENTS;
+	cmd->wp = ring + (uint64_t)ipcr.cmd_wp * W2C_ELEMENT;
+	if (!wifi_dead) {
+		mhi_write64(MHI_CRDB_LOWER, cmd->wp);
+	}
+	if (wifi_dead) {
+		error = EIO;
+	} else if (!ipcr_wait(&ipcr.cmd_done, IPCR_CMD_TIMEOUT_MS)) {
+		say("apollo wifi: IPCR: %s of channel %u: no completion event in %u ms (command ring wp %#llx)\n", what, chan, IPCR_CMD_TIMEOUT_MS, cmd->wp);
+		error = ETIMEDOUT;
+	} else if (ipcr.cmd_code != W2C_EV_CC_SUCCESS) {
+		say("apollo wifi: IPCR: %s of channel %u completed with code %u, not SUCCESS\n", what, chan, ipcr.cmd_code);
+		error = EIO;
+	} else {
+		say("apollo wifi: IPCR: %s of channel %u: completion SUCCESS\n", what, chan);
+	}
+	ipcr.cmd_ptr = 0;
+	apollo_wifi_wake(0);
+	lck_mtx_unlock(&ipcr_cmd_lock);
+	return error;
+}
+
+/* mhi_init_chan_ctxt(): chstate ENABLED, ring base, length in bytes, rp = wp = base (the brstmode, chtype and erindex are mhi_init_dev_ctxt's, W2c's) */
+static void
+ipcr_chan_context(unsigned chan, uint64_t ring)
+{
+	struct w2c_context *context = (struct w2c_context *)(w2c.ctrl + W2C_OFF_CHAN) + chan;
+
+	context->word0 = (context->word0 & ~0xffu) | 1;         /* CHAN_CTX_CHSTATE: MHI_CH_STATE_ENABLED */
+	context->rbase = context->rp = context->wp = ring;
+	context->rlen = (uint64_t)IPCR_ELEMENTS * W2C_ELEMENT;
+}
+
+/* the IPCR channels started: memory, the two threads, the channel contexts, MHI_CMD_START_CHAN for 20 then 21 (mhi_prepare_for_transfer), the receive buffers */
+static int
+ipcr_start(void)
+{
+	vm_size_t bytes = (vm_size_t)IPCR_PAGES * 4096;
+	int error;
+
+	if (ipcr.up) {
+		return 0;
+	}
+	if (ipcr.failed) {
+		return EIO;
+	}
+	if (!wifi_amss || !chdb_ok()) {
+		say("apollo wifi: IPCR: the chip is not in mission mode, or its channel doorbells are not known (%#x)\n", w2c.chdb);
+		return ENXIO;
+	}
+	ipcr.failed = true;                     /* until it all works */
+	if (kmem_alloc(kernel_map, &ipcr.mem, bytes, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		ipcr.mem = 0;
+		say("apollo wifi: IPCR: no memory (%u KB)\n", (unsigned)(bytes / 1024));
+		return ENOMEM;
+	}
+	cache_flush(ipcr.mem, bytes);           /* the zeroes written back before the chip writes (no dirty line later overwrites its data) */
+	/* the buffers (from +IPCR_OFF_TX on; ipcr.iova is the address the first page would have: the offsets stay) and, apart, the two rings as the uncached alias */
+	if (!wsmmu_map(ipcr.mem + IPCR_OFF_TX, (uint32_t)(bytes - IPCR_OFF_TX), &ipcr.iova)) {
+		return ENOMEM;
+	}
+	ipcr.iova -= IPCR_OFF_TX;
+	if (ipcr.rings == 0) {
+		uint64_t physical = 0;
+
+		ipcr.rings = ctrl_alloc(2 * 4096, &physical);
+		if (ipcr.rings == 0 || !wsmmu_map_as(0, physical, 2 * 4096, WIFI_PTE, &ipcr.rings_iova)) {
+			ipcr.rings = 0;
+			say("apollo wifi: IPCR: no memory for the rings (8 KB in one piece)\n");
+			return ENOMEM;
+		}
+	}
+	ipcr.ul_wp = ipcr.dl_wp = ipcr.cmd_wp = ipcr.ul_rp = 0;
+	ipcr.ul_failed = false;
+	ipcr.queue_head = ipcr.queue_count = 0;
+	ipcr.stop = false;
+	ipcr.event_alive = ipcr.deliver_alive = true;
+	say("apollo wifi: IPCR: %u KB at %#llx: UL ring +%#x, DL ring +%#x (%u elements each), bounce buffer +%#x (%u KB), %u receive buffers of %u KB +%#x; "
+	    "channel doorbells at +%#x, command ring doorbell +%#x\n", (unsigned)(bytes / 1024), ipcr.rings_iova, IPCR_OFF_UL_RING, IPCR_OFF_DL_RING,
+	    IPCR_ELEMENTS, IPCR_OFF_TX, IPCR_TX_SIZE / 1024, IPCR_RX_BUFFERS, IPCR_RX_SIZE / 1024, IPCR_OFF_RX, w2c.chdb, MHI_CRDB_LOWER);
+	{
+		thread_t thread;
+
+		if (kernel_thread_start(ipcr_event_thread, NULL, &thread) != KERN_SUCCESS) {
+			ipcr.event_alive = false;
+			ipcr.stop = true;
+			return ENOMEM;
+		}
+		thread_set_thread_name(thread, "wifi ipcr event");
+		thread_deallocate(thread);
+		if (kernel_thread_start(ipcr_deliver_thread, NULL, &thread) != KERN_SUCCESS) {
+			ipcr.deliver_alive = false;
+			ipcr.stop = true;
+			return ENOMEM;
+		}
+		thread_set_thread_name(thread, "wifi ipcr deliver");
+		thread_deallocate(thread);
+	}
+	/* mhi_prepare_channel(): mhi_init_chan_ctxt(), then the START command, UL (dir 0) first */
+	ipcr_chan_context(IPCR_UL, ipcr.rings_iova + IPCR_OFF_UL_RING);
+	ipcr_chan_context(IPCR_DL, ipcr.rings_iova + IPCR_OFF_DL_RING);
+	w2b_hold("the first MHI command on the command ring: START_CHAN of IPCR channel 20, then 21 (the chip reads the channel contexts)");
+	error = ipcr_command(IPCR_UL, W2C_CMD_START_CHAN, "START_CHAN");
+	if (error == 0) {
+		error = ipcr_command(IPCR_DL, W2C_CMD_START_CHAN, "START_CHAN");
+	}
+	if (error != 0) {
+		ipcr.stop = true;
+		return error;
+	}
+	/* the receive buffers, then channel 21's doorbell once (the autoqueue of mhi_prepare_for_transfer_autoqueue(): mhi_gen_tre() each, one mhi_ring_chan_db()) */
+	lck_mtx_lock(&wifi_ev_lock);
+	ipcr.up = true;                         /* (the events of channel 21 count from here) */
+	for (unsigned n = 0; n < IPCR_RX_BUFFERS; n++) {
+		ipcr_dl_queue((uint8_t)n, n == IPCR_RX_BUFFERS - 1);
+	}
+	lck_mtx_unlock(&wifi_ev_lock);
+	ipcr.failed = false;
+	say("apollo wifi: IPCR DONE: channels 20 and 21 run, %u receive buffers of %u bytes queued\n", IPCR_RX_BUFFERS, IPCR_RX_SIZE);
+	return 0;
+}
+
+void
+apollo_ipcr_set_receive(void (*receive)(const void *data, unsigned long length, void *context), void *context)
+{
+	ipcr.context = context;
+	__atomic_thread_fence(__ATOMIC_SEQ_CST);
+	ipcr.receive = receive;
+}
+
+/* mhi_queue_buf() on channel 20: the bounce buffer as one TRE (IEOT), the ring's wp in the channel context and on the doorbell; then the TX event of ring 1 */
+int
+apollo_ipcr_send(const void *data, unsigned long length)
+{
+	struct w2c_context *chan = (struct w2c_context *)(w2c.ctrl + W2C_OFF_CHAN);
+	uint64_t ring = ipcr.rings_iova + IPCR_OFF_UL_RING, element;
+	int error = 0;
+
+	if (wifi_dead) {
+		return EIO;
+	}
+	if (!ipcr.up || ipcr.stop) {
+		return ENOTCONN;
+	}
+	if (length == 0 || length > IPCR_TX_SIZE || length > 0xffff) {
+		return EMSGSIZE;
+	}
+	lck_mtx_lock(&ipcr_tx_lock);
+	/* (again under the lock: power down clears ipcr.up holding it, so no send begins on a channel being reset) */
+	if (!ipcr.up || ipcr.stop || wifi_dead) {
+		lck_mtx_unlock(&ipcr_tx_lock);
+		return ENOTCONN;
+	}
+	if (ipcr.ul_failed) {
+		lck_mtx_unlock(&ipcr_tx_lock);
+		return EIO;
+	}
+	if ((ipcr.ul_wp + 1) % IPCR_ELEMENTS == ipcr.ul_rp) {   /* mhi_is_ring_full() */
+		lck_mtx_unlock(&ipcr_tx_lock);
+		say("apollo wifi: IPCR: the UL ring is full (wp %u, the chip's rp %u): a send of %lu bytes refused\n", ipcr.ul_wp, ipcr.ul_rp, length);
+		return ENOBUFS;
+	}
+	memcpy((void *)(ipcr.mem + IPCR_OFF_TX), data, length);
+	cache_flush(ipcr.mem + IPCR_OFF_TX, length);
+	element = ring + (uint64_t)ipcr.ul_wp * W2C_ELEMENT;
+	ipcr_tre(ipcr.rings + IPCR_OFF_UL_RING + (vm_offset_t)ipcr.ul_wp * W2C_ELEMENT, ipcr.iova + IPCR_OFF_TX, (uint32_t)length);
+	ipcr.tx_done = false;
+	ipcr.tx_ptr = element;
+	ipcr.ul_wp = (ipcr.ul_wp + 1) % IPCR_ELEMENTS;
+	chan[IPCR_UL].wp = ring + (uint64_t)ipcr.ul_wp * W2C_ELEMENT;   /* mhi_ring_chan_db() */
+	ipcr_channel_db(IPCR_UL, chan[IPCR_UL].wp);
+	if (!ipcr_wait(&ipcr.tx_done, IPCR_TX_TIMEOUT_MS)) {
+		/*
+		 * The chip may still read that TRE, and it points at the one bounce buffer that the next send would overwrite:
+		 * the UL channel is given up (Linux's QRTR would see the same channel stuck).
+		 */
+		ipcr.ul_failed = true;
+		say("apollo wifi: IPCR: a send of %lu bytes was not completed in %u ms: THE UL CHANNEL IS GIVEN UP, no more sends\n", length,
+		    IPCR_TX_TIMEOUT_MS);
+		error = ETIMEDOUT;
+	} else if (ipcr.tx_code != W2C_EV_CC_EOT && ipcr.tx_code != W2C_EV_CC_EOB) {
+		say("apollo wifi: IPCR: a send of %lu bytes completed with code %u\n", length, ipcr.tx_code);
+		error = EIO;
+	} else {
+		ipcr.sent++;
+	}
+	ipcr.tx_ptr = 0;
+	lck_mtx_unlock(&ipcr_tx_lock);
+	return error;
+}
+
+unsigned
+apollo_wifi_intid(unsigned vector)
+{
+	return W2C_MSI_INTID + vector;
+}
+
+int
+apollo_wifi_msi(unsigned long long *address, unsigned *data)
+{
+	if (!w2c.msi_on || w2c.msi_address == 0) {
+		return ENODEV;
+	}
+	*address = w2c.msi_address;
+	*data = W2C_MSI_INTID;
+	return 0;
+}
+
+/*
+ * ath11k_pcic_read32/write32 (pcic.c): offsets below ATH11K_PCI_WINDOW_START are direct, above through the window register
+ * (ath11k_pci_window_read32/write32, pci.c: window selected under register_window_lock, then the access). A spin lock holds both
+ * steps together; not for interrupt context. The chip's wake (apollo_wifi_wake) is the caller's business, as in Linux.
+ */
+uint32_t
+apollo_wifi_read32(uint32_t offset)
+{
+	uint32_t value;
+
+	if (!wifi_amss || wifi_dead || !wifi_link_alive) {
+		return ~0u;
+	}
+	lck_spin_lock(&wifi_chip_lock);
+	value = chip_rd(offset);
+	lck_spin_unlock(&wifi_chip_lock);
+	return value;
+}
+
+void
+apollo_wifi_write32(uint32_t offset, uint32_t value)
+{
+	if (!wifi_amss || wifi_dead || !wifi_link_alive) {
+		return;
+	}
+	lck_spin_lock(&wifi_chip_lock);
+	chip_wr(offset, value);
+	lck_spin_unlock(&wifi_chip_lock);
+}
+
+/*
+ * The buffer's pages entered in the Wi-Fi's SMMU context at the next free addresses (up to the pool of 256 MB: WIFI_L3_TABLES), as normal
+ * non-cacheable memory; the caches written back and invalidated first, so that no line of the buffer is written back over what the chip
+ * writes (the contents the caller has put there stay). The size is rounded up to whole 4K pages.
+ */
+int
+apollo_wifi_dma_map(void *buffer, unsigned long size, unsigned long long *iova)
+{
+	uint64_t at = 0;
+
+	if (buffer == NULL || iova == NULL || size == 0 || ((vm_offset_t)buffer & 4095) || size > WIFI_POOL_SIZE) {
+		return EINVAL;
+	}
+	if (!wsmmu.on) {
+		return ENODEV;
+	}
+	size = (size + 4095) & ~4095ul;
+	cache_flush((vm_offset_t)buffer, size);
+	if (!wsmmu_map((vm_offset_t)buffer, (uint32_t)size, &at)) {
+		return ENOMEM;
+	}
+	*iova = at;
+	return 0;
+}
+
+/* ---- the whole of step W1 to W2c, and power up/down ------------------------------------------------------- */
+
+static volatile bool started;
+static volatile bool clocked;   /* the pcie_0 power domain and clocks are on: PARF may be touched */
+/*
+ * apollo_wifi_power_down() ran, or W2b/W2c failed and the chip was quiesced: the state of W1 to W2c (tables, contexts) is not made for
+ * a second run, so from here power up says ENOTSUP. One way: nothing clears it before the next boot.
+ */
+static bool wifi_downed;
+
+/*
+ * apollo_qrtr_init (hakios.apollo_qrtr.c) and apollo_lx_prepare/start (hakios.apollo_lx.c: weak there, the apollo ath11k object's when
+ * it is linked in) are always there: both files are "standard" in bsd/conf/files (devices/mi-10t/xnu/mi-10t.patch).
+ */
+
+/* W1 up to the stage asked for (1 to 4: W2c is stage 4); 0 or an errno. With stage 4 and a success, the chip runs AMSS (wifi_amss). */
+static int
+wifi_bring_up(uint32_t stage)
+{
+	int error = EIO;
+
+	pin_wlan_en = ml_io_map(TLMM_NORTH_PHYS + 0x1000UL * PIN_WLAN_EN, 0x1000);
+	pins_pcie = ml_io_map(TLMM_NORTH_PHYS + 0x1000UL * PIN_PERST, 0x3000);
+	gcc = ml_io_map(GCC_PHYS, GCC_SIZE);
+	rsc = ml_io_map(RSC_PHYS, RSC_SIZE);
+	phy = ml_io_map(PHY_PHYS, PHY_SIZE);
+	parf = ml_io_map(PARF_PHYS, PARF_SIZE);
+	dbi = ml_io_map(DBI_PHYS, 0x1000);
+	atu = ml_io_map(ATU_PHYS, 0x1000);
+	conf = ml_io_map(CONF_PHYS, 0x1000);
+	if (!pin_wlan_en || !pins_pcie || !gcc || !rsc || !phy || !parf || !dbi || !atu || !conf) {
+		say("apollo wifi: cannot map the registers\n");
+		return ENXIO;
+	}
+	say("apollo wifi: W1: power the QCA6390 and bring up PCIe0 (as found: WLAN_EN %u, PERST# %u, GDSCR %#x)\n",
+	    rd(pin(PIN_WLAN_EN) + 4) & 1, rd(pin(PIN_PERST) + 4) & 1, rd(gcc + PCIE0_GDSCR));
+	started = true;
+	/* PERST# held low and the chip off while its power comes */
+	pin_setup(PIN_PERST, 0, PULL_DOWN, 2, true, false);
+	pin_setup(PIN_WAKE, 0, PULL_UP, 2, false, false);
+	pin_setup(PIN_WLAN_EN, 0, PULL_DOWN, 2, true, false);
+	if (!power_on()) {
+		goto off;
+	}
+	sleep_ms(100);
+	pin_setup(PIN_WLAN_EN, 0, PULL_UP, 16, true, true);
+	sleep_ms(60);
+	say("apollo wifi: WLAN_EN is high (%u)\n", rd(pin(PIN_WLAN_EN) + 4) & 1);
+	pin_setup(PIN_CLKREQ, PIN_FUNCTION_PCI_E0, PULL_UP, 2, false, false);
+	if (!clocks_on()) {
+		goto off;
+	}
+	clocked = true;
+	if (!phy_on()) {
+		goto off;
+	}
+	bcr_pulse(PCIE0_BCR);
+	controller_setup();
+	if (!link_on()) {
+		goto off;
+	}
+	wifi_link_alive = true;         /* (BAR0 may be touched until apollo_wifi_quiesce()) */
+	say("apollo wifi: W1 DONE: the QCA6390 is on PCIe0, link up, configuration space readable\n");
+	chip_prep = stage >= 4;         /* apollo_wifi_prep: default on from W2c, off for W2b alone */
+	PE_parse_boot_argn("apollo_wifi_prep", &chip_prep, sizeof(chip_prep));
+	PE_parse_boot_argn("apollo_wifi_rddm", &wifi_rddm, sizeof(wifi_rddm));
+	error = 0;
+	if (stage >= 2 && mhi_look()) {
+		say("apollo wifi: W2a DONE: the chip's MHI and BHI registers answer through BAR0\n");
+		/*
+		 * A failed W2b or W2c: the INTIDs given back, then the chip quiesced as power down does -- PERST# and WLAN_EN down
+		 * before the SMMU context goes, so that a chip still running can not DMA through a context that is gone -- and the
+		 * state marked as power down's (wifi_downed: power up says ENOTSUP, not a second pass over half-made tables).
+		 */
+		if (stage >= 3 && !first_stage()) {
+			say("apollo wifi: W2b failed: PERST# and WLAN_EN down\n");
+			w2c_msi_stop();
+			apollo_wifi_quiesce();
+			wifi_downed = true;
+			error = EIO;
+		} else if (stage >= 4) {
+			if (mission_mode()) {
+				wifi_amss = true;
+			} else {
+				say("apollo wifi: W2c failed: PERST# and WLAN_EN down\n");
+				w2c_msi_stop();
+				apollo_wifi_quiesce();
+				wifi_downed = true;
+				error = EIO;
+			}
+		}
+	} else if (stage >= 2) {
+		error = EIO;
+	}
+	return error;
+off:
+	apollo_wifi_quiesce();
+	say("apollo wifi: W1 failed: PERST# and WLAN_EN are down again\n");
+	return EIO;
+}
+
+/*
+ * With wifi_station=1 the driver has given its station to the kernel (sys/hakios.sta.h), and iOS's Wi-Fi side has it: the network
+ * of fw/network (the small image's; devices/mi-10t/userland/firmware.sh) is then joined the way anybody joins one, by asking the
+ * station, as hakios.wifi.c's join_given() does on redwood. iOS may ask for another later, or for none. wifi_file=0: not joined.
+ * (wifi_join=1 is the driver joining by itself instead, with no station for iOS: Settings shows no networks then.)
+ */
+extern int apollo_lx_os_network(unsigned char *name, unsigned *name_length, unsigned char *passphrase, unsigned *passphrase_length);
+
+static void
+join_given(void)
+{
+	static struct hakios_sta_join what;
+	struct hakios_sta_state *state;
+	unsigned name_length = sizeof(what.ssid), passphrase_length = sizeof(what.passphrase);
+	uint32_t station = 0, given = 1;
+	uint64_t began = now_us();
+	int error;
+
+	if (!PE_parse_boot_argn("wifi_station", &station, sizeof(station)) || station == 0) {
+		return;
+	}
+	if (PE_parse_boot_argn("wifi_file", &given, sizeof(given)) && given == 0) {
+		say("apollo wifi: the network of the file is not joined at the start (wifi_file=0): the radio waits to be asked\n");
+		return;
+	}
+	bzero(&what, sizeof(what));
+	if (!apollo_lx_os_network(what.ssid, &name_length, what.passphrase, &passphrase_length)) {
+		say("apollo wifi: no network to join from fw/network: the radio waits to be asked\n");
+		return;
+	}
+	what.ssid_length = (uint8_t)name_length;
+	what.passphrase_length = (uint8_t)passphrase_length;
+	what.security = HAKIOS_STA_WPA2_PSK;
+	error = hakios_sta_ask_join_standing(&what);
+	bzero(&what, sizeof(what));
+	for (unsigned waited = 0; error == 0 && hakios_sta_busy() && waited < 300; waited++) {
+		sleep_ms(100);
+	}
+	if ((state = kalloc_data(sizeof(*state), Z_WAITOK)) == NULL) {
+		return;
+	}
+	hakios_sta_state(state);
+	if (state->phase == HAKIOS_STA_JOINED) {
+		say("apollo wifi: THE NETWORK OF THE FILE IS JOINED, %llu ms after it was asked for\n", (now_us() - began) / 1000);
+	} else {
+		say("apollo wifi: THE NETWORK OF THE FILE IS NOT JOINED (%d, phase %d, %d): the radio waits to be asked\n", error,
+		    state->phase, state->last_error);
+	}
+	kfree_data(state, sizeof(*state));
+}
+
+/* apollo_wifi=1 to 5: the stages up to W2c as before; 5 goes on: the chip to AMSS, IPCR, the QRTR transport, then the apollo ath11k object */
+static void
+apollo_wifi_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	uint32_t stage = 0;
+
+	PE_parse_boot_argn("apollo_wifi", &stage, sizeof(stage));
+	if (stage >= 5) {
+		int error = apollo_wifi_power_up();
+
+		say("apollo wifi: stage 5: power up (W1 to W2c, IPCR): %d\n", error);
+		if (error == 0) {
+			error = apollo_qrtr_init();
+			say("apollo wifi: stage 5: apollo_qrtr_init: %d\n", error);
+			error = apollo_lx_prepare();
+			say("apollo wifi: stage 5: apollo_lx_prepare: %d\n", error);
+			if (error == 0) {
+				error = apollo_lx_start();
+				say("apollo wifi: stage 5: apollo_lx_start: %d\n", error);
+			}
+			if (error == 0) {
+				join_given();
+			}
+		}
+	} else {
+		lck_mtx_lock(&wifi_lock);
+		(void)wifi_bring_up(stage);
+		lck_mtx_unlock(&wifi_lock);
+	}
+	thread_terminate(current_thread());
+}
+
+/* W1, W2a, W2b (chip preparation), W2c unless the chip already runs AMSS, then the IPCR channels. Idempotent, one caller at a time. Sleeps. */
+int
+apollo_wifi_power_up(void)
+{
+	int error = 0;
+
+	lck_mtx_lock(&wifi_lock);
+	if (!wifi_amss) {
+		if (wifi_downed || started) {
+			/* (started without AMSS: an earlier run stopped short (apollo_wifi < 4) or W2a failed, and left state that a second pass is not made for) */
+			error = wifi_downed ? ENOTSUP : EIO;
+		} else {
+			error = wifi_bring_up(4);
+			if (error == 0 && !wifi_amss) {
+				error = EIO;
+			}
+		}
+	}
+	if (error == 0) {
+		error = ipcr_start();
+	}
+	lck_mtx_unlock(&wifi_lock);
+	return error;
+}
+
+#define IPCR_EXIT_WAIT_MS       30000           /* the threads' way out: an RDDM collection gives up at once, a receive function may take a while */
+
+/*
+ * The IPCR channels reset (mhi_unprepare_from_transfer(): RESET_CHAN, UL first), the threads stopped and waited for, then PERST# and
+ * WLAN_EN down as quiesce does. ipcr.up is cleared under ipcr_tx_lock: a send under way ends first, none begins after.
+ */
+void
+apollo_wifi_power_down(void)
+{
+	bool was_up;
+	uint64_t began;
+
+	lck_mtx_lock(&wifi_lock);
+	lck_mtx_lock(&ipcr_tx_lock);
+	was_up = ipcr.up;
+	ipcr.up = false;
+	lck_mtx_unlock(&ipcr_tx_lock);
+	if (was_up) {
+		(void)ipcr_command(IPCR_UL, W2C_CMD_RESET_CHAN, "RESET_CHAN");
+		(void)ipcr_command(IPCR_DL, W2C_CMD_RESET_CHAN, "RESET_CHAN");
+	}
+	mhi_wake_release();                     /* the permanent wake assertion of W2c ends with the channels */
+	ipcr.stop = true;
+	/* until both threads say they are out (their last BAR access behind them), not a fixed time: PERST# under a thread at work hangs the bus */
+	for (began = now_us(); (ipcr.event_alive || ipcr.deliver_alive) && now_us() - began < IPCR_EXIT_WAIT_MS * 1000ull; ) {
+		thread_wakeup((event_t)&w2c_wake);
+		thread_wakeup((event_t)&ipcr_rx_wait);
+		sleep_ms(1);
+	}
+	if (ipcr.event_alive || ipcr.deliver_alive) {
+		say("apollo wifi: power down: THE IPCR THREADS HAVE NOT ENDED in %u ms (event %d, delivery %d): the link goes anyway "
+		    "(their BAR accesses check wifi_link_alive)\n", IPCR_EXIT_WAIT_MS, ipcr.event_alive, ipcr.deliver_alive);
+	}
+	wifi_amss = false;                      /* nothing touches the chip's registers from here */
+	if (started) {
+		apollo_wifi_quiesce();
+		wifi_downed = true;
+		say("apollo wifi: powered down: PERST# and WLAN_EN are down\n");
+	}
+	lck_mtx_unlock(&wifi_lock);
+}
+
+/* Any way back to the loader, or a failed step: the chip held in reset and unpowered (no lock, no sleep). */
+void
+apollo_wifi_quiesce(void)
+{
+	if (!started) {
+		return;
+	}
+	/*
+	 * The GIC's side of the chip's interrupts only: its MSI capability is not written here. That was a configuration
+	 * read across a link that the line below had just taken down -- the bus hung on it, and with it the return to the
+	 * loader and the log of whatever had ended the run (25 October, three runs). PERST# resets the chip's MSI anyway.
+	 */
+	w2c.msi_cap_skip = true;
+	wifi_link_alive = false;                /* the BAR writers of the IPCR threads' paths stop here */
+	__asm__ volatile ("dsb sy");
+	w2c_msi_mask();                         /* before PERST# drops: no interrupt of a chip going away */
+	/* (PARF only when it is clocked: a register of an unclocked block hangs the bus -- that ended a run) */
+	if (clocked && parf != 0) {
+		wr(parf + PARF_LTSSM, rd(parf + PARF_LTSSM) & ~(1u << 8));
+	}
+	pin_set(PIN_PERST, false);
+	pin_set(PIN_WLAN_EN, false);
+	wsmmu_off();
+	started = false;
+}
+
+void
+apollo_wifi_init(void)
+{
+	uint32_t stage = 0;
+	thread_t thread;
+
+	PE_parse_boot_argn("apollo_wifi_pause", &w2b_pause_ms, sizeof(w2b_pause_ms));
+	if (!PE_parse_boot_argn("apollo_wifi", &stage, sizeof(stage)) || stage == 0) {
+		return;
+	}
+	if (stage >= 5) {
+		apollo_lx_reserve(64ul << 20);  /* the apollo build's POOL_SIZE (devices/mi-10t/tools/mk-ath11k.sh), while memory is still in large pieces */
+		apollo_lx_net_early();          /* en0 before iOS's Wi-Fi side looks (wifi_station=1 with wifi_mac=) */
+	}
+	if (kernel_thread_start(apollo_wifi_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_set_thread_name(thread, "apollo wifi");
+		thread_deallocate(thread);
+	}
+}
diff --git a/bsd/dev/hakios.apollo_qrtr.c b/bsd/dev/hakios.apollo_qrtr.c
new file mode 100644
index 000000000000..8f18c96a15d9
--- /dev/null
+++ b/bsd/dev/hakios.apollo_qrtr.c
@@ -0,0 +1,474 @@
+/*
+ * apollo: QRTR over the QCA6390's MHI IPCR channels (20 to the chip, 21 from it), as the kernel's QMI transport
+ * (sys/hakios.qrtr.h, installed with hakios_qmi_set_transport(); the QMI helpers in hakios.qmi.c are shared).
+ *
+ * The router logic is the one of redwood's GLINK transport (bsd/dev/hakios.wifi.c, "qrtr_*", lines ~2726-3050), copied
+ * here and adapted -- redwood's file is not touched. What differs, from Linux (net/qrtr/mhi.c, net/qrtr/af_qrtr.c,
+ * net/qrtr/ns.c; all fetched from git.kernel.org torvalds/linux):
+ *   - MHI: one MHI transfer is one QRTR packet (mhi.c: qcom_mhi_qrtr_send queues the skb as is, MHI_EOT; the download
+ *     callback hands each buffer whole to qrtr_endpoint_post). apollo_ipcr_send()/set_receive() are exactly that.
+ *   - Packet: version 1 header (af_qrtr.c qrtr_node_enqueue: 32-bit version, type, src node, src port, confirm_rx, size,
+ *     dst node, dst port, little endian) and the payload padded to 4 bytes (skb_put_padto(ALIGN(len, 4) + hdr)); a
+ *     receiver requires len == ALIGN(size, 4) + header (qrtr_endpoint_post), version 1 or 3 (v2).
+ *   - Nodes: the local node id is 1 (qrtr_local_nid). The chip's is not known until its first packet (Linux:
+ *     QRTR_EP_NID_AUTO, node->nid assigned from the first src node in qrtr_endpoint_post); control packets to a node not
+ *     yet known carry dst node 0xffffffff, as node->nid does in Linux until then.
+ *   - HELLO: Linux's endpoint registration sends HELLO at once (qrtr_endpoint_register -> qrtr_hello_work; from
+ *     {node 1, CTRL port} to {node AUTO, CTRL port}) and nothing else is sent before it (qrtr_node_enqueue: -EAGAIN until
+ *     hello_sent). Here apollo_qrtr_init() does the same. The chip's HELLO is then only logged: Linux's name service
+ *     answers a HELLO by announcing its own servers (ns.c ctrl_cmd_hello -> announce_servers), and there are none here, so
+ *     no second HELLO is sent (redwood's answer-once rule is not needed: ours already went out first).
+ *   - BYE / DEL_SERVER / DEL_CLIENT: as ns.c: BYE removes every server of that node, DEL_SERVER one, a local port's
+ *     close() sends DEL_CLIENT (ns.c ctrl_cmd_del_client) to the chip's node.
+ *   - No flow control: Linux sets confirm_rx on data after a high watermark of 10 unconfirmed messages per port (qrtr_tx_wait).
+ *     We never set it, so the chip never answers RESUME_TX; an incoming confirm_rx is answered, an incoming RESUME_TX ignored.
+ *   - Threading: the receive function of apollo_ipcr_* runs on one kernel thread; lookup()'s catch-up of servers that were
+ *     already there is done on a thread of our own (there is no link loop here to do it), both under qrtr_calling so
+ *     callbacks stay one at a time.
+ */
+#include <kern/kalloc.h>
+#include <kern/locks.h>
+#include <kern/sched_prim.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include <sys/hakios.apollo_wifi.h>
+#include <sys/hakios.qrtr.h>
+#include <sys/systm.h>
+
+extern void thread_set_thread_name(thread_t thread, const char *name);    /* (shown by the hitch tracer, apollo_hitch=1) */
+
+extern void loader_log_putc(char c);
+
+static int say(const char *format, ...) __printflike(1, 2);
+
+static int
+say(const char *format, ...)
+{
+	char line[300];
+	va_list list;
+
+	va_start(list, format);
+	vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
+	for (const char *c = line; *c != 0; c++) {
+		loader_log_putc(*c);
+	}
+	return printf("%s", line);
+}
+
+#define HAKIOS_QRTR_MAX        8192            /* the most a datagram holds, either way (sys/hakios.qrtr.h) */
+#define QRTR_US                 1u              /* qrtr_local_nid, af_qrtr.c */
+#define QRTR_CONTROL            0xfffffffeu     /* QRTR_PORT_CTRL */
+#define QRTR_NODE_UNKNOWN       0xffffffffu     /* QRTR_EP_NID_AUTO as it goes on the wire */
+#define QRTR_FIRST_PORT         0x4000u         /* where Linux begins numbering ports that ask for no number */
+enum { QRTR_DATA = 1, QRTR_HELLO = 2, QRTR_BYE = 3, QRTR_NEW_SERVER = 4, QRTR_DEL_SERVER = 5, QRTR_DEL_CLIENT = 6, QRTR_RESUME_TX = 7 };
+
+struct qrtr_header {                            /* version 1 (struct qrtr_hdr_v1, af_qrtr.c) */
+	uint32_t version, type, from_node, from_port, confirm, size, to_node, to_port;
+};
+struct qrtr_control {                           /* struct qrtr_ctrl_pkt: 20 bytes */
+	uint32_t command;
+	uint32_t words[4];                      /* a server: service, instance, node, port; a client: node, port */
+};
+
+struct hakios_qrtr_port {
+	uint32_t number;                        /* 0: free */
+	hakios_qrtr_receive_t receive;
+	hakios_qrtr_server_t server;
+	void *context;
+	struct {
+		uint32_t service, instance;     /* the instance as on the wire: version | instance << 8; 0: any */
+		bool asked;
+		bool fresh;                     /* not yet told of the services that were there before it */
+	} lookups[4];
+};
+
+static LCK_GRP_DECLARE(apollo_qrtr_grp, "apollo-qrtr");
+static LCK_MTX_DECLARE(qrtr_lock, &apollo_qrtr_grp);            /* the tables below */
+static LCK_MTX_DECLARE(qrtr_calling, &apollo_qrtr_grp);         /* held around every callback into the QMI helpers */
+static struct hakios_qrtr_port qrtr_ports[16];
+static struct {
+	uint32_t service, instance, node, port;
+	bool there;
+} qrtr_servers[64];
+static uint32_t qrtr_peer;                      /* the chip's node; 0: it has not said */
+static uint32_t qrtr_next_port = QRTR_FIRST_PORT, qrtr_in, qrtr_out;
+static thread_t calling_thread;                 /* the thread that holds qrtr_calling */
+static bool qrtr_started, qrtr_fresh_pending;
+static int qrtr_debug;                          /* boot-arg apollo_qrtr_debug=1: data packets too */
+
+static uint32_t
+qrtr_peer_node(void)
+{
+	return qrtr_peer != 0 ? qrtr_peer : QRTR_NODE_UNKNOWN;
+}
+
+/* One datagram out, of any type. */
+static int
+qrtr_out_packet(uint32_t type, uint32_t from_port, uint32_t to_node, uint32_t to_port, const void *data, uint32_t length)
+{
+	uint32_t padded = (length + 3) & ~3u;
+	struct qrtr_header *packet;
+	int error;
+
+	if (length == 0 || length > HAKIOS_QRTR_MAX) {
+		return EMSGSIZE;
+	}
+	packet = kalloc_data(sizeof(*packet) + padded, Z_WAITOK | Z_ZERO);
+	if (packet == NULL) {
+		return ENOMEM;
+	}
+	packet->version = 1;
+	packet->type = type;
+	packet->from_node = QRTR_US;
+	packet->from_port = from_port;
+	packet->size = length;
+	packet->to_node = to_port == QRTR_CONTROL && to_node == 0 ? qrtr_peer_node() : to_node;
+	packet->to_port = to_port;
+	memcpy(packet + 1, data, length);
+	error = apollo_ipcr_send(packet, (uint32_t)sizeof(*packet) + padded);
+	kfree_data(packet, sizeof(*packet) + padded);
+	if (error == 0) {
+		qrtr_out++;
+	} else {
+		say("apollo qrtr: send of type %u to node %u port %#x failed: %d\n", type, to_node, to_port, error);
+	}
+	if (qrtr_debug && (type == QRTR_DATA || error == 0)) {
+		say("apollo qrtr: out type %u, %u bytes, port %#x -> node %u port %#x\n", type, length, from_port, to_node, to_port);
+	}
+	return error;
+}
+
+static bool
+qrtr_matches(uint32_t service, uint32_t instance, unsigned server)
+{
+	return qrtr_servers[server].there && qrtr_servers[server].service == service &&
+	       (instance == 0 || qrtr_servers[server].instance == instance);
+}
+
+/* Everybody who looked a service up is told that it has come, or gone. Called with qrtr_calling held. */
+static void
+qrtr_tell(uint32_t service, uint32_t instance, uint32_t node, uint32_t port, bool arrived)
+{
+	for (unsigned p = 0; p < sizeof(qrtr_ports) / sizeof(qrtr_ports[0]); p++) {
+		for (unsigned l = 0; l < 4; l++) {
+			hakios_qrtr_server_t server = NULL;
+			void *context;
+
+			lck_mtx_lock(&qrtr_lock);
+			if (qrtr_ports[p].number != 0 && qrtr_ports[p].lookups[l].asked && !qrtr_ports[p].lookups[l].fresh &&
+			    qrtr_ports[p].lookups[l].service == service &&
+			    (qrtr_ports[p].lookups[l].instance == 0 || qrtr_ports[p].lookups[l].instance == instance)) {
+				server = qrtr_ports[p].server;
+			}
+			context = qrtr_ports[p].context;
+			lck_mtx_unlock(&qrtr_lock);
+			if (server != NULL) {
+				server(context, arrived, service, instance & 0xff, instance >> 8, node, port);
+			}
+		}
+	}
+}
+
+/* The control port's part: Linux's name service (ns.c), without services of our own to tell of. */
+static void
+qrtr_control(const struct qrtr_header *header, const struct qrtr_control *control)
+{
+	int found = -1;
+
+	switch (control->command) {
+	case QRTR_HELLO:
+		say("apollo qrtr: HELLO from node %u (ours went out at init)\n", header->from_node);
+		break;
+	case QRTR_NEW_SERVER:
+		lck_mtx_lock(&qrtr_lock);
+		for (unsigned i = 0; i < sizeof(qrtr_servers) / sizeof(qrtr_servers[0]); i++) {
+			if (qrtr_servers[i].there && qrtr_servers[i].node == control->words[2] && qrtr_servers[i].port == control->words[3]) {
+				found = (int)i;
+				break;
+			}
+			if (!qrtr_servers[i].there && found < 0) {
+				found = (int)i;
+			}
+		}
+		if (found >= 0) {
+			qrtr_servers[found].there = true;
+			qrtr_servers[found].service = control->words[0];
+			qrtr_servers[found].instance = control->words[1];
+			qrtr_servers[found].node = control->words[2];
+			qrtr_servers[found].port = control->words[3];
+		}
+		lck_mtx_unlock(&qrtr_lock);
+		say("apollo qrtr: NEW_SERVER service %u (%#x), version %u, instance %u, node %u, port %u%s\n", control->words[0],
+		    control->words[0], control->words[1] & 0xff, control->words[1] >> 8, control->words[2], control->words[3],
+		    found < 0 ? " (table full: not kept)" : "");
+		qrtr_tell(control->words[0], control->words[1], control->words[2], control->words[3], true);
+		break;
+	case QRTR_DEL_SERVER:
+	case QRTR_BYE:
+		for (unsigned i = 0; i < sizeof(qrtr_servers) / sizeof(qrtr_servers[0]); i++) {
+			bool gone;
+
+			lck_mtx_lock(&qrtr_lock);
+			gone = qrtr_servers[i].there && (control->command == QRTR_BYE ? qrtr_servers[i].node == header->from_node :
+			    qrtr_servers[i].node == control->words[2] && qrtr_servers[i].port == control->words[3]);
+			qrtr_servers[i].there = qrtr_servers[i].there && !gone;
+			lck_mtx_unlock(&qrtr_lock);
+			if (gone) {
+				say("apollo qrtr: %s: service %u at node %u port %u has gone\n", control->command == QRTR_BYE ? "BYE" : "DEL_SERVER",
+				    qrtr_servers[i].service, qrtr_servers[i].node, qrtr_servers[i].port);
+				qrtr_tell(qrtr_servers[i].service, qrtr_servers[i].instance, qrtr_servers[i].node, qrtr_servers[i].port, false);
+			}
+		}
+		break;
+	default:
+		break;                                  /* (DEL_CLIENT, EXIT, PING, lookups: nothing here wants them) */
+	}
+}
+
+/* One datagram from the channel (one MHI transfer). From the receive thread, with qrtr_calling held. */
+static void
+qrtr_input(const uint8_t *data, uint32_t length)
+{
+	struct qrtr_header header;
+	hakios_qrtr_receive_t receive = NULL;
+	void *context = NULL;
+	uint32_t at;
+
+	if (length >= sizeof(header) && data[0] == 1) {
+		memcpy(&header, data, sizeof(header));
+		at = sizeof(header);
+	} else if (length >= 16 && data[0] == 3) {
+		/* version 2: version, type, flags, a length of options; the size; then four numbers of 16 bits */
+		bzero(&header, sizeof(header));
+		header.type = data[1];
+		header.confirm = data[2] & 1;
+		memcpy(&header.size, data + 4, 4);
+		header.from_node = (uint32_t)(data[8] | data[9] << 8);
+		header.from_port = (uint32_t)(data[10] | data[11] << 8);
+		header.to_node = (uint32_t)(data[12] | data[13] << 8);
+		header.to_port = (uint32_t)(data[14] | data[15] << 8);
+		header.from_port = header.from_port == 0xfffe ? QRTR_CONTROL : header.from_port;
+		header.to_port = header.to_port == 0xfffe ? QRTR_CONTROL : header.to_port;
+		at = 16 + data[3];
+	} else {
+		say("apollo qrtr: %u bytes that are no packet (they begin %#x)\n", length, length ? data[0] : 0);
+		return;
+	}
+	if (header.size == 0 || header.size > length || at + header.size > length) {
+		say("apollo qrtr: a packet of %u bytes in a transfer of %u: dropped\n", header.size, length);
+		return;
+	}
+	qrtr_in++;
+	if (qrtr_peer == 0 && header.from_node != 0 && header.from_node != QRTR_NODE_UNKNOWN) {
+		qrtr_peer = header.from_node;           /* (qrtr_node_assign of the first source node) */
+		say("apollo qrtr: the chip is node %u\n", qrtr_peer);
+	}
+	if (qrtr_debug) {
+		say("apollo qrtr: in type %u, %u bytes, node %u port %#x -> port %#x\n", header.type, header.size, header.from_node,
+		    header.from_port, header.to_port);
+	}
+	if (header.type == QRTR_RESUME_TX) {
+		return;                                 /* (we never set confirm_rx, so none is asked for) */
+	}
+	if (header.confirm) {
+		/* the sender counts what it has sent to this port, and waits for this before it sends many more */
+		struct qrtr_control resume = { .command = QRTR_RESUME_TX, .words = { header.to_node, header.to_port } };
+
+		qrtr_out_packet(QRTR_RESUME_TX, header.to_port, header.from_node, header.from_port, &resume, sizeof(resume));
+	}
+	if (header.to_port == QRTR_CONTROL || header.to_port == 0) {    /* (0: QRTR_PORT_CTRL_LEGACY) */
+		struct qrtr_control control = { 0 };
+
+		if (header.type == QRTR_DATA) {
+			return;
+		}
+		memcpy(&control, data + at, header.size < sizeof(control) ? header.size : sizeof(control));
+		qrtr_control(&header, &control);
+		return;
+	}
+	lck_mtx_lock(&qrtr_lock);
+	for (unsigned p = 0; p < sizeof(qrtr_ports) / sizeof(qrtr_ports[0]); p++) {
+		if (qrtr_ports[p].number == header.to_port && header.type == QRTR_DATA) {
+			receive = qrtr_ports[p].receive;
+			context = qrtr_ports[p].context;
+		}
+	}
+	lck_mtx_unlock(&qrtr_lock);
+	if (receive != NULL) {
+		receive(context, header.from_node, header.from_port, data + at, header.size);
+	} else if (header.type == QRTR_DATA) {
+		say("apollo qrtr: a packet for port %#x, which is nobody's: dropped\n", header.to_port);
+	}
+}
+
+/* The receive function of the IPCR channel: a kernel thread, one packet at a time. */
+static void
+qrtr_receive(const void *data, unsigned long length, __unused void *context)
+{
+	lck_mtx_lock(&qrtr_calling);
+	calling_thread = current_thread();
+	qrtr_input(data, (uint32_t)length);
+	calling_thread = THREAD_NULL;
+	lck_mtx_unlock(&qrtr_calling);
+}
+
+/* Lookups made since the last look are told of the services that were there before them. With qrtr_calling held. */
+static void
+qrtr_fresh(void)
+{
+	for (unsigned p = 0; p < sizeof(qrtr_ports) / sizeof(qrtr_ports[0]); p++) {
+		for (unsigned l = 0; l < 4; l++) {
+			hakios_qrtr_server_t server;
+			uint32_t service, instance;
+			void *context;
+
+			lck_mtx_lock(&qrtr_lock);
+			if (qrtr_ports[p].number == 0 || !qrtr_ports[p].lookups[l].fresh) {
+				lck_mtx_unlock(&qrtr_lock);
+				continue;
+			}
+			qrtr_ports[p].lookups[l].fresh = false;
+			server = qrtr_ports[p].server;
+			service = qrtr_ports[p].lookups[l].service;
+			instance = qrtr_ports[p].lookups[l].instance;
+			context = qrtr_ports[p].context;
+			lck_mtx_unlock(&qrtr_lock);
+			for (unsigned i = 0; i < sizeof(qrtr_servers) / sizeof(qrtr_servers[0]) && server != NULL; i++) {
+				if (qrtr_matches(service, instance, i)) {
+					server(context, true, qrtr_servers[i].service, qrtr_servers[i].instance & 0xff,
+					    qrtr_servers[i].instance >> 8, qrtr_servers[i].node, qrtr_servers[i].port);
+				}
+			}
+		}
+	}
+}
+
+/* Ours: waits for lookup() to have asked, then does what qrtr_fresh() says, apart from the receive thread. */
+static void
+qrtr_fresh_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	for (;;) {
+		lck_mtx_lock(&qrtr_lock);
+		while (!qrtr_fresh_pending) {
+			lck_mtx_sleep(&qrtr_lock, LCK_SLEEP_DEFAULT, (event_t)&qrtr_fresh_pending, THREAD_UNINT);
+		}
+		qrtr_fresh_pending = false;
+		lck_mtx_unlock(&qrtr_lock);
+		lck_mtx_lock(&qrtr_calling);
+		calling_thread = current_thread();
+		qrtr_fresh();
+		calling_thread = THREAD_NULL;
+		lck_mtx_unlock(&qrtr_calling);
+	}
+}
+
+static struct hakios_qrtr_port *
+qrtr_open(hakios_qrtr_receive_t receive, hakios_qrtr_server_t server, void *context)
+{
+	struct hakios_qrtr_port *port = NULL;
+
+	lck_mtx_lock(&qrtr_lock);
+	for (unsigned p = 0; p < sizeof(qrtr_ports) / sizeof(qrtr_ports[0]) && port == NULL; p++) {
+		if (qrtr_ports[p].number == 0) {
+			port = &qrtr_ports[p];
+			bzero(port, sizeof(*port));
+			port->number = qrtr_next_port++;
+			port->receive = receive;
+			port->server = server;
+			port->context = context;
+		}
+	}
+	lck_mtx_unlock(&qrtr_lock);
+	return port;
+}
+
+static int
+qrtr_send(struct hakios_qrtr_port *port, uint32_t node, uint32_t to, const void *data, size_t length)
+{
+	if (port == NULL || port->number == 0 || length > HAKIOS_QRTR_MAX) {
+		return EINVAL;
+	}
+	return qrtr_out_packet(QRTR_DATA, port->number, node, to, data, (uint32_t)length);
+}
+
+static int
+qrtr_lookup(struct hakios_qrtr_port *port, uint32_t service, uint32_t version, uint32_t instance)
+{
+	int error = ENOSPC;
+
+	lck_mtx_lock(&qrtr_lock);
+	for (unsigned l = 0; l < 4 && error != 0 && port != NULL && port->number != 0; l++) {
+		if (!port->lookups[l].asked) {
+			port->lookups[l].service = service;
+			port->lookups[l].instance = instance != 0 ? (version & 0xff) | instance << 8 : 0;
+			port->lookups[l].asked = true;
+			port->lookups[l].fresh = true;
+			error = 0;
+		}
+	}
+	if (error == 0) {
+		qrtr_fresh_pending = true;
+		thread_wakeup((event_t)&qrtr_fresh_pending);
+	}
+	lck_mtx_unlock(&qrtr_lock);
+	return error;
+}
+
+static void
+qrtr_close(struct hakios_qrtr_port *port)
+{
+	struct qrtr_control gone = { .command = QRTR_DEL_CLIENT, .words = { QRTR_US, port ? port->number : 0 } };
+	bool outside = current_thread() != calling_thread;
+
+	if (port == NULL || port->number == 0) {
+		return;
+	}
+	if (outside) {
+		lck_mtx_lock(&qrtr_calling);            /* (a callback of the port's that is running ends first) */
+	}
+	lck_mtx_lock(&qrtr_lock);
+	port->number = 0;
+	lck_mtx_unlock(&qrtr_lock);
+	if (outside) {
+		lck_mtx_unlock(&qrtr_calling);
+	}
+	if (qrtr_peer != 0) {
+		qrtr_out_packet(QRTR_DEL_CLIENT, gone.words[1], qrtr_peer, QRTR_CONTROL, &gone, sizeof(gone));
+	}
+}
+
+static const struct hakios_qrtr_ops qrtr_ops = { .open = qrtr_open, .send = qrtr_send, .lookup = qrtr_lookup, .close = qrtr_close };
+
+int
+apollo_qrtr_init(void)
+{
+	struct qrtr_control hello = { .command = QRTR_HELLO };
+	thread_t thread;
+	int error;
+
+	lck_mtx_lock(&qrtr_lock);
+	if (qrtr_started) {
+		lck_mtx_unlock(&qrtr_lock);
+		return 0;
+	}
+	qrtr_started = true;
+	lck_mtx_unlock(&qrtr_lock);
+
+	PE_parse_boot_argn("apollo_qrtr_debug", &qrtr_debug, sizeof(qrtr_debug));
+	if (kernel_thread_start(qrtr_fresh_thread, NULL, &thread) != KERN_SUCCESS) {
+		say("apollo qrtr: no thread for lookups\n");
+		qrtr_started = false;
+		return ENOMEM;
+	}
+	thread_set_thread_name(thread, "apollo qrtr");
+	thread_deallocate(thread);
+	apollo_ipcr_set_receive(qrtr_receive, NULL);    /* first: the chip may answer at once */
+	/* what qrtr_endpoint_register() has Linux do: HELLO, from {node 1, control port} to {the node, control port} */
+	error = qrtr_out_packet(QRTR_HELLO, QRTR_CONTROL, QRTR_NODE_UNKNOWN, QRTR_CONTROL, &hello, sizeof(hello));
+	say("apollo qrtr: HELLO to the chip: %s\n", error == 0 ? "sent" : "NOT SENT");
+	hakios_qmi_set_transport(&qrtr_ops);
+	return error;
+}
diff --git a/bsd/dev/hakios.apollo_sound.c b/bsd/dev/hakios.apollo_sound.c
new file mode 100644
index 000000000000..d25771ef9d14
--- /dev/null
+++ b/bsd/dev/hakios.apollo_sound.c
@@ -0,0 +1,1551 @@
+/*
+ * The Xiaomi Mi 10T's (apollo) sound, steps 2 to 5 of apollo_audio=N: what its audio DSP's services are told so that
+ * the speakers play. A copy of bsd/dev/hakios.sound.c (the POCO X5 Pro's), kept apart from it, with apollo's
+ * numbers; it runs once hakios.apollo_adsp.c has the DSP's audio services up, and apollo_audio=N says how far:
+ *   apollo_audio=2  the port (redwood's sound=1)     apollo_audio=3  ... and a stream with a test tone (sound=2)
+ *   apollo_audio=4  ... and the amplifiers (sound=3)   apollo_audio=5  what iOS plays (sound=4)
+ *
+ * Apollo's speakers are two Cirrus CS35L41 amplifiers (bsd/dev/hakios.apollo_cs35l41.c) on the SoC's tertiary TDM interface:
+ * Android's TERT_TDM_RX_0, AFE port 0x9020 in group 0x9120 (with 0x9022), its bit clock TER_TDM_IBIT (0x204). The
+ * frame is Android's: 8 slots of 32 bits, the two channels in slots 0 (the earpiece amplifier, 0x42) and 1 (the
+ * speaker's, 0x40), as the amplifiers' own registers show after Android has played (.device-local/apollo/audio/
+ * NOTES-amps.txt). Android runs it at 96 kHz; this runs it at 48 kHz -- what iOS plays and redwood's DSP path take --,
+ * a bit clock of 12.288 MHz, which the amplifiers are set up to follow. The pins: GPIO 133 (bit clock), 135 (frame
+ * sync), 134 (data in), function 1, and 137 (data out to the amplifiers), function 3 (mi2s2_data1), all on the
+ * west tile (pinctrl-kona.c), as the tree's tert_tdm_pinctl has them.
+ *
+ * What is the same as redwood's -- the services, the SMMU (stream 0x1801 on apollo too), the stream, the feeder and the
+ * guard -- is described below as hakios.sound.c describes it, with "sound=N" read as apollo_audio=N+1.
+ *
+ * Under Android the speakers' sound goes from the audio server through three of the DSP's
+ * services: ASM, a stream the samples are written into; ADM, the matrix that routes a stream to
+ * a device path ("COPP"); and AFE, the port at the SoC's interface. The two amplifiers
+ * (hakios.speaker.c) sit on the primary TDM interface, which the DSP runs: Android's
+ * PRI_TDM_RX_0, AFE port 0x9000 in group 0x9100 (with 0x9002, unused). The samples themselves
+ * lie in memory of ours that the DSP reads through the application processors' SMMU, as
+ * stream 0x1801 (Android: qcom,msm-audio-ion, iommus <&apps_smmu 0x1801 0>, its addresses from
+ * 0x10000000, and the stream's low four bits in bits 32 to 35 of every address the DSP is given:
+ * qcom,smmu-sid-mask 0xf, msm_audio_ion.c).
+ *
+ *   sound=1  the port: the TDM pins to the interface, the interface's bit clock, the group, the
+ *            port, started; whether the bit clock and the frame sync then toggle at the pins is
+ *            looked at; held for sound_secs (default 3), then everything stopped and put back
+ *   sound=2  ... and a stream: our memory shown to the DSP through the SMMU, a device path
+ *            (ADM) to the port, an ASM stream routed to it, and a test tone -- 1 kHz at -20 dBFS,
+ *            both channels -- written into it for sound_secs (at most 3); the DSP's "written"
+ *            events say whether it takes the samples at 48 kHz. The amplifiers stay off.
+ *   sound=3  ... and the amplifiers, with the tone playing: set up as Android's driver sets them
+ *            up, started once the clock runs, faded in to sound_below eighths of a dB under
+ *            Android's own level (default 160 on apollo, 20 dB, as hakios.apollo_cs35l41.c says: there is no
+ *            speaker protection firmware, only the guard and the analog gain at 12 of 18), faded out and powered
+ *            down at the end. Audible.
+ *   sound=4  what iOS plays (/dev/hakios-audio, hakios.audio.c), until the run ends: the port
+ *            and the stream as above, kept running (silence when iOS writes nothing); the
+ *            amplifiers set up once and powered down, started and faded in (the driver's quick
+ *            fade) whenever a write is not silence, stopped after three seconds of silence; their
+ *            level is what is set on the plug-in's volume control (ioctl HAKIOS_AUDIO_SET_VOLUME):
+ *            so far under sound_below, which stays the loudest, and at 0 they stay off. (iOS sets
+ *            that control only once, to the top, and applies its volume to the samples itself --
+ *            see userland/src/audio_plugin.c --; at its volume 0 it writes silence, and the
+ *            amplifiers stay off for that too.) On their way the samples go through the speakers'
+ *            guard (hakios.guard.c), in place of the DSP's speaker protection that Android has:
+ *            sound_gain eighths of a dB of gain (default and most 96, 12 dB: iOS's own processing
+ *            keeps its top that far under full scale), a high-pass filter, three averages of the
+ *            power at the speakers and a peak limiter. sound_guard_as=N, for a test: the guard
+ *            reckons the amplifiers N eighths of a dB under Android's level (louder than they are)
+ *            and holds back as it would there -- with sound_below=720 (the amplifiers at -90 dB)
+ *            what it does at the loudest can be seen in the log and the recording without a sound.
+ *
+ * The numbers are Android's own, from the phone's live device tree (qcom,msm-dai-tdm-pri-rx and
+ * its port, the pins pri_tdm_*_active), its mixer paths (the speaker: PRI_TDM_RX_0 at 48 kHz,
+ * two channels, S32_LE) and its kernel (Xiaomi's redwood-s-oss, techpack/audio: asoc/lahaina.c,
+ * asoc/msm-dai-q6-v2.c, dsp/q6afe.c, dsp/q6adm.c, dsp/q6asm.c):
+ *   - the bit clock: the interface's internal one (clock 0x200, "PRI_TDM_IBIT"), attribute 4
+ *     ("invert, couple no", msm-dai-q6-v2.c's default; the tree names none), at 48000 x 32 bits x
+ *     2 slots = 3.072 MHz -- the machine driver sets that rate itself (lahaina.c, which on redwood
+ *     halves its four slots to two: "Using default tdm max slot: 4" in Android's log), not the
+ *     tree's 1.536 MHz
+ *   - the group: ports 0x9000 and 0x9002, two 32-bit slots, mask 3, 48 kHz
+ *   - the port: two channels of 32 bits at 48 kHz, linear PCM; sync mode 0, sync source 1, data
+ *     out 0, inverted sync 1, data delay 1; slot mapping: channels at byte offsets 0 and 4 (slot
+ *     0, the amplifier at 0x35; slot 1, the one at 0x34), MSB-aligned
+ *   - the pins: GPIO 97 (bit clock) and 100 (frame sync) function mi2s0, 8 mA, no pull, output
+ *     high; 98 and 99 (data in and out) function mi2s0, 8 mA, no pull (pinctrl-yupik.c: function
+ *     1 for all four)
+ *   - the path: ADM's device open (version 5) for playback to port 0x9000 with no processing
+ *     (topology 0x10312), two channels, 24 bits, 48 kHz; the stream: ASM session 1, stream 1,
+ *     opened for writing linear PCM of 16 bits, no processing (0x10c68), routed to that path
+ *
+ * What is started is stopped, and what is written is put back, when the time is over -- or, if
+ * the DSP is to be shut down earlier (the run's end), before that (apollo_sound_dsp_down()).
+ * The amplifiers are powered down on a panic's way out (apollo_sound_quiesce()).
+ *
+ * Message layouts: the files above, and Linux's sound/soc/qcom/qdsp6/ (q6afe.c, q6adm.c,
+ * q6asm.c); the SMMU: hakios.wifi.c, which does the same for the Wi-Fi's stream.
+ */
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <libkern/OSAtomic.h>
+#include <mach/mach_types.h>
+#include <mach/vm_param.h>
+#include <pexpert/pexpert.h>
+#include <sys/systm.h>
+#include <sys/hakios.apollo_input.h>
+#include <sys/hakios.apollo_audio.h>
+#include <sys/hakios.audio.h>
+#include <vm/vm_kern.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern uint64_t kvtophys(vm_offset_t va);
+extern kern_return_t thread_terminate(thread_t thread);
+extern void loader_log_putc(char c);
+
+/* The SMMU's match registers and contexts are found free and taken by the Wi-Fi's start as well (hakios.wifi.c). */
+
+static LCK_GRP_DECLARE(sound_lock_group, "apollo-sound");
+LCK_MTX_DECLARE(apollo_smmu_lock, &sound_lock_group);       /* (redwood shares its with the Wi-Fi; apollo's is its own) */
+static LCK_MTX_DECLARE(sound_lock, &sound_lock_group);  /* the path being set up or taken down */
+
+static uint32_t level, seconds = 3, below = 160, pause_ms = 1000, gain = APOLLO_GUARD_MAX_GAIN;
+#define BELOW_MOST              (8 * 102)       /* the most `below' (and below + iOS's volume) means: muted (apollo_cs35l41_volume()) */
+static uint32_t guard_as = UINT32_MAX;  /* boot-arg sound_guard_as=N: the guard reckons the amplifiers at most N under (a test) */
+static char last_write[96] = "nothing written";
+
+/* ---- what is said: to the loader's log as well, as it happens ---------------------------------------- */
+
+static int say(const char *format, ...) __printflike(1, 2);
+
+static int
+say(const char *format, ...)
+{
+	char line[400];
+	va_list list;
+	int length;
+
+	va_start(list, format);
+	length = vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
+	for (const char *c = line; *c != 0; c++) {
+		loader_log_putc(*c);
+	}
+	printf("%s", line);
+	return length;
+}
+
+static void
+sleep_ms(uint32_t ms)
+{
+	delay_for_interval(ms, NSEC_PER_MSEC);
+}
+
+static uint64_t
+now_us(void)
+{
+	uint64_t nanoseconds;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &nanoseconds);
+	return nanoseconds / 1000;
+}
+
+/* The time of day (UTC, as the host gave it: boot-arg epoch) and since the kernel began, for whoever listens. */
+static void
+say_when(const char *what)
+{
+	clock_sec_t secs;
+	clock_usec_t usecs;
+	uint64_t up = now_us();
+
+	clock_get_calendar_microtime(&secs, &usecs);
+	say("apollo sound: %s at %02lu:%02lu:%02lu.%01u UTC (%llu.%01llu s after the kernel began)\n", what, (unsigned long)(secs / 3600 % 24),
+	    (unsigned long)(secs / 60 % 60), (unsigned long)(secs % 60), (unsigned)(usecs / 100000), up / 1000000, up / 100000 % 10);
+}
+
+/* Time for the loader to note what has just been said, before something not yet seen to be harmless. */
+static void
+announce(const char *what)
+{
+	say("apollo sound: %s\n", what);
+	if (pause_ms) {
+		sleep_ms(pause_ms);
+	}
+}
+
+static uint32_t __attribute__((noinline))
+rd(vm_offset_t address)
+{
+	uint32_t value;
+
+	__asm__ volatile ("ldr %w0, [%1]" : "=r" (value) : "r" (address) : "memory");
+	return value;
+}
+
+static void __attribute__((noinline))
+wr(vm_offset_t address, uint32_t value)
+{
+	__asm__ volatile ("str %w0, [%1]" : : "r" (value), "r" (address) : "memory");
+}
+
+struct block {
+	const char *name;
+	uint32_t phys, size;
+	vm_offset_t base;
+};
+
+static uint32_t
+get(struct block *b, const char *name, uint32_t offset)
+{
+	uint32_t value;
+
+	if (b->base == 0) {
+		b->base = ml_io_map(b->phys, b->size);
+	}
+	value = rd(b->base + offset);
+	say("apollo sound: %s %s (%#x) = %#x\n", b->name, name, b->phys + offset, value);
+	return value;
+}
+
+static void
+put(struct block *b, const char *name, uint32_t offset, uint32_t value)
+{
+	if (b->base == 0) {
+		b->base = ml_io_map(b->phys, b->size);
+	}
+	say("apollo sound: about to write %s %s at %#x: %#x\n", b->name, name, b->phys + offset, value);
+	snprintf(last_write, sizeof(last_write), "wrote %#x to %s %s at %#x", value, b->name, name, b->phys + offset);
+	wr(b->base + offset, value);
+}
+
+/* ---- the TDM pins ------------------------------------------------------------------------------------- */
+
+static struct block tlmm = { "pin controller", 0x0f100000, 0x100000 };
+#define GPIO_CFG(n)             (0x1000u * (n))         /* [1:0] pull, [5:2] function, [8:6] drive (mA / 2 - 1), [9] output */
+#define GPIO_IO(n)              (0x1000u * (n) + 4)     /* bit 0 in, bit 1 out */
+#define CFG_MI2S2               (1u << 2)              /* mi2s2_sck, mi2s2_ws, mi2s2_data0: function 1 */
+#define CFG_MI2S2_DATA1         (3u << 2)              /* gpio137: sec_mi2s 1, audio_ref 2, mi2s2_data1 3 */
+#define CFG_8MA                 (3u << 6)
+#define CFG_OUTPUT              (1u << 9)
+
+static const struct {
+	unsigned pin;
+	const char *name;
+	uint32_t cfg, io;               /* Android's active state */
+} tdm_pins[] = {
+	{ 133, "gpio133 (bit clock)", CFG_MI2S2 | CFG_8MA | CFG_OUTPUT, 2 },
+	{ 135, "gpio135 (frame sync)", CFG_MI2S2 | CFG_8MA | CFG_OUTPUT, 2 },
+	{ 134, "gpio134 (data in)", CFG_MI2S2 | CFG_8MA, 0 },
+	{ 137, "gpio137 (data out)", CFG_MI2S2_DATA1 | CFG_8MA, 0 },
+};
+#define TDM_PINS                (sizeof(tdm_pins) / sizeof(tdm_pins[0]))
+static uint32_t found_cfg[TDM_PINS], found_io[TDM_PINS];
+static bool pins_taken;
+
+static void
+pins_on(void)
+{
+	for (unsigned i = 0; i < TDM_PINS; i++) {
+		found_cfg[i] = get(&tlmm, tdm_pins[i].name, GPIO_CFG(tdm_pins[i].pin));
+		found_io[i] = get(&tlmm, tdm_pins[i].name, GPIO_IO(tdm_pins[i].pin));
+	}
+	pins_taken = true;
+	for (unsigned i = 0; i < TDM_PINS; i++) {
+		put(&tlmm, tdm_pins[i].name, GPIO_IO(tdm_pins[i].pin), tdm_pins[i].io);
+		put(&tlmm, tdm_pins[i].name, GPIO_CFG(tdm_pins[i].pin), tdm_pins[i].cfg);
+	}
+}
+
+static void
+pins_off(void)
+{
+	if (!pins_taken) {
+		return;
+	}
+	for (unsigned i = 0; i < TDM_PINS; i++) {
+		put(&tlmm, tdm_pins[i].name, GPIO_CFG(tdm_pins[i].pin), found_cfg[i]);
+		put(&tlmm, tdm_pins[i].name, GPIO_IO(tdm_pins[i].pin), found_io[i] & 2);
+		get(&tlmm, tdm_pins[i].name, GPIO_CFG(tdm_pins[i].pin));
+	}
+	pins_taken = false;
+}
+
+/* Whether a pin toggles: read many times as fast as it goes. */
+static void
+pin_activity(unsigned pin, const char *name, uint32_t *changes, uint32_t *ones)
+{
+	uint32_t last = rd(tlmm.base + GPIO_IO(pin)) & 1, reads = 20000;
+	uint64_t began = now_us();
+
+	*changes = *ones = 0;
+	for (uint32_t i = 0; i < reads; i++) {
+		uint32_t now = rd(tlmm.base + GPIO_IO(pin)) & 1;
+
+		*changes += now != last;
+		*ones += now;
+		last = now;
+	}
+	say("apollo sound: %s: %u changes and %u ones in %u reads (%llu us)\n", name, *changes, *ones, reads, now_us() - began);
+}
+
+/* ---- APR ------------------------------------------------------------------------------------------- */
+
+#define APR_SVC_AFE             4
+#define APR_SVC_ASM             7
+#define APR_SVC_ADM             8
+#define APR_BASIC_RSP_RESULT    0x000110e8u
+#define APR_WAIT_MS             1000
+
+static const char *
+dsp_error(uint32_t status)
+{
+	static const char *const names[] = { "ok", "failed", "bad parameter", "unsupported", "version", "unexpected", "panic",
+		                             "no resource", "bad handle", "already", "not ready", "pending", "busy", "aborted",
+		                             "preempted", "continue", "immediate", "not implemented", "need more", "no memory",
+		                             "not there" };
+
+	return status < sizeof(names) / sizeof(names[0]) ? names[status] : "an error this does not know";
+}
+
+/*
+ * One command, its answer waited for: true if the answer is the basic one with status 0, or the
+ * opcode `wanted' (then in *answer).
+ */
+static bool
+command(const char *what, uint8_t service, uint16_t port, uint32_t opcode, const void *payload, uint32_t length, uint32_t wanted,
+    struct hakios_apr_answer *answer)
+{
+	struct hakios_apr_answer local;
+
+	if (answer == NULL) {
+		answer = &local;
+	}
+	snprintf(last_write, sizeof(last_write), "sent %s (opcode %#x)", what, opcode);
+	if (!apollo_adsp_apr(service, port, 0, opcode, payload, length, APR_WAIT_MS, answer)) {
+		say("apollo sound: %s (opcode %#x to service %u, port %#x): NO ANSWER\n", what, opcode, service, port);
+		return false;
+	}
+	if (answer->opcode == APR_BASIC_RSP_RESULT && answer->words[0] == opcode) {
+		say("apollo sound: %s: %s%s\n", what, answer->words[1] == 0 ? "done" : "REFUSED: ", answer->words[1] == 0 ? "" :
+		    dsp_error(answer->words[1]));
+		return answer->words[1] == 0 && wanted == 0;
+	}
+	if (wanted != 0 && answer->opcode == wanted) {
+		return true;
+	}
+	say("apollo sound: %s: an answer not expected: opcode %#x, %u bytes: %#x %#x\n", what, answer->opcode, answer->length,
+	    answer->words[0], answer->words[1]);
+	return false;
+}
+
+/* ---- AFE: the port ---------------------------------------------------------------------------------- */
+
+#define AFE_PORT_CMD_DEVICE_START               0x000100e5u
+#define AFE_PORT_CMD_DEVICE_STOP                0x000100e6u
+#define AFE_PORT_CMD_SET_PARAM_V2               0x000100efu
+#define AFE_SVC_CMD_SET_PARAM                   0x000100f3u
+#define AFE_MODULE_AUDIO_DEV_INTERFACE          0x0001020cu
+#define AFE_PARAM_ID_TDM_CONFIG                 0x0001029du
+#define AFE_MODULE_TDM                          0x0001028au
+#define AFE_PARAM_ID_PORT_SLOT_MAPPING_CONFIG   0x00010297u
+#define AFE_MODULE_GROUP_DEVICE                 0x00010254u
+#define AFE_PARAM_ID_GROUP_DEVICE_ENABLE        0x00010256u
+#define AFE_PARAM_ID_GROUP_DEVICE_TDM_CONFIG    0x0001029eu
+#define AFE_MODULE_CLOCK_SET                    0x0001028fu
+#define AFE_PARAM_ID_CLOCK_SET                  0x00010290u
+
+#define PORT                    0x9020          /* TERT_TDM_RX_0 */
+#define GROUP                   0x9120          /* TERT_TDM_RX */
+#define GROUP_OTHER_PORT        0x9022
+#define PORT_INVALID            0xffff
+#define CLOCK_TER_TDM_IBIT      0x204           /* q6afe: TER_TDM_IBIT */
+#define CLOCK_INVERT_COUPLE_NO  4
+#define RATE                    48000
+#define SLOTS                   8               /* Android's frame: 8 slots of 32 bits */
+#define SLOT_BITS               32
+#define PORT_BITS               32              /* the mixer path's S32_LE */
+
+struct afe_param {
+	uint32_t module, param;
+	uint16_t size, reserved;
+} __attribute__((packed));
+
+struct afe_clock_set {
+	uint32_t version, id, hz;
+	uint16_t attribute, root;
+	uint32_t enable;
+} __attribute__((packed));
+
+struct afe_group_tdm {
+	uint32_t version;
+	uint16_t group, reserved;
+	uint16_t ports[8];
+	uint32_t channels, rate, bits;
+	uint16_t slots, slot_bits;
+	uint32_t slot_mask;
+} __attribute__((packed));
+
+struct afe_group_enable {
+	uint16_t group, enable;
+} __attribute__((packed));
+
+struct afe_tdm {
+	uint32_t version, channels, rate, bits;
+	uint16_t data_format, sync_mode, sync_source, slots, data_out, invert_sync, data_delay, slot_bits;
+	uint32_t slot_mask;
+} __attribute__((packed));
+
+struct afe_slot_mapping {
+	uint32_t version;
+	uint16_t channels, bits;
+	uint32_t align;
+	uint16_t offsets[8];
+} __attribute__((packed));
+
+/* A parameter for the AFE as a whole (its clocks, its groups): in the packet, not in shared memory. */
+static bool
+afe_service_param(const char *what, uint32_t module, uint32_t param, const void *data, uint16_t size)
+{
+	uint8_t packet[16 + sizeof(struct afe_param) + 64];
+	uint32_t *head = (uint32_t *)packet;
+	struct afe_param *p = (struct afe_param *)(packet + 16);
+
+	bzero(packet, sizeof(packet));
+	head[0] = (uint32_t)sizeof(*p) + size;          /* payload size; address 0 and handle 0: in band */
+	p->module = module;
+	p->param = param;
+	p->size = size;
+	memcpy(packet + 16 + sizeof(*p), data, size);
+	return command(what, APR_SVC_AFE, 0, AFE_SVC_CMD_SET_PARAM, packet, 16 + (uint32_t)sizeof(*p) + size, 0, NULL);
+}
+
+/* A parameter of the port. */
+static bool
+afe_port_param(const char *what, uint32_t module, uint32_t param, const void *data, uint16_t size)
+{
+	uint8_t packet[16 + sizeof(struct afe_param) + 64];
+	struct afe_param *p = (struct afe_param *)(packet + 16);
+
+	bzero(packet, sizeof(packet));
+	*(uint16_t *)packet = PORT;
+	*(uint16_t *)(packet + 2) = (uint16_t)(sizeof(*p) + size);
+	p->module = module;
+	p->param = param;
+	p->size = size;
+	memcpy(packet + 16 + sizeof(*p), data, size);
+	return command(what, APR_SVC_AFE, 0, AFE_PORT_CMD_SET_PARAM_V2, packet, 16 + (uint32_t)sizeof(*p) + size, 0, NULL);
+}
+
+static bool clock_on, group_on, port_on;
+
+static bool
+afe_clock(bool on)
+{
+	struct afe_clock_set clock = { 1, CLOCK_TER_TDM_IBIT, RATE * SLOT_BITS * SLOTS, CLOCK_INVERT_COUPLE_NO, 0, on };
+
+	return afe_service_param(on ? "the TDM bit clock (0x204) at 12.288 MHz, on" : "the TDM bit clock, off", AFE_MODULE_CLOCK_SET,
+	           AFE_PARAM_ID_CLOCK_SET, &clock, sizeof(clock));
+}
+
+static bool
+afe_on(void)
+{
+	struct afe_group_tdm group = {
+		.version = 1, .group = GROUP, .ports = { PORT, GROUP_OTHER_PORT, PORT_INVALID, PORT_INVALID, PORT_INVALID,
+		                                         PORT_INVALID, PORT_INVALID, PORT_INVALID },
+		.channels = 2, .rate = RATE, .bits = SLOT_BITS, .slots = SLOTS, .slot_bits = SLOT_BITS, .slot_mask = 3,
+	};
+	struct afe_group_enable enable = { GROUP, 1 };
+	struct afe_tdm tdm = {
+		.version = 1, .channels = 2, .rate = RATE, .bits = PORT_BITS, .data_format = 0, .sync_mode = 0, .sync_source = 1,
+		.slots = SLOTS, .data_out = 0, .invert_sync = 1, .data_delay = 1, .slot_bits = SLOT_BITS, .slot_mask = 3,
+	};
+	struct afe_slot_mapping mapping = { .version = 1, .channels = 2, .bits = PORT_BITS, .align = 0,
+		                            .offsets = { 0, 4, 0xffff, 0xffff, 0xffff, 0xffff, 0xffff, 0xffff } };
+	uint16_t start[2] = { PORT, 0 };
+
+	announce("the DSP is asked for the TDM interface's bit clock, the group, the port and its start (AFE)");
+	clock_on = afe_clock(true);
+	if (!clock_on) {
+		return false;
+	}
+	group_on = afe_service_param("the group 0x9120: ports 0x9020 0x9022, 8 slots of 32 bits (2 used), 48 kHz", AFE_MODULE_GROUP_DEVICE,
+	    AFE_PARAM_ID_GROUP_DEVICE_TDM_CONFIG, &group, sizeof(group)) &&
+	    afe_service_param("the group 0x9120, on", AFE_MODULE_GROUP_DEVICE, AFE_PARAM_ID_GROUP_DEVICE_ENABLE, &enable,
+	    sizeof(enable));
+	if (!group_on) {
+		return false;
+	}
+	if (!afe_port_param("the port 0x9020: 2 channels of 32 bits at 48 kHz in slots 0 and 1 of 8, sync 0 1, inverted, delay 1",
+	    AFE_MODULE_AUDIO_DEV_INTERFACE, AFE_PARAM_ID_TDM_CONFIG, &tdm, sizeof(tdm)) ||
+	    !afe_port_param("the port's slots: channels at bytes 0 and 4", AFE_MODULE_TDM, AFE_PARAM_ID_PORT_SLOT_MAPPING_CONFIG,
+	    &mapping, sizeof(mapping))) {
+		return false;
+	}
+	port_on = command("the port 0x9020, started", APR_SVC_AFE, 0, AFE_PORT_CMD_DEVICE_START, start, sizeof(start), 0, NULL);
+	return port_on;
+}
+
+static void
+afe_off(void)
+{
+	uint16_t stop[2] = { PORT, 0 };
+	struct afe_group_enable disable = { GROUP, 0 };
+
+	if (port_on) {
+		command("the port 0x9020, stopped", APR_SVC_AFE, 0, AFE_PORT_CMD_DEVICE_STOP, stop, sizeof(stop), 0, NULL);
+		port_on = false;
+	}
+	if (group_on) {
+		afe_service_param("the group 0x9120, off", AFE_MODULE_GROUP_DEVICE, AFE_PARAM_ID_GROUP_DEVICE_ENABLE, &disable,
+		    sizeof(disable));
+		group_on = false;
+	}
+	if (clock_on) {
+		afe_clock(false);
+		clock_on = false;
+	}
+}
+
+/* ---- the DSP's view of our memory: stream 0x1801 of the SMMU ------------------------------------------- */
+
+static struct block apps_smmu = { "apps smmu", 0x15000000, 0x2000 };
+static struct block apps_smmu_second = { "apps smmu", 0, 0x1000 };              /* the second page: a word per context */
+static struct block apps_smmu_context = { "apps smmu, the audio context", 0, 0x1000 };
+#define SMMU_SCR0               0x000
+#define SMMU_IDR0               0x020
+#define SMMU_IDR1               0x024
+#define SMMU_SGFSR              0x048
+#define SMMU_SGFSYNR1           0x054
+#define SMMU_SMR(n)             (0x800 + 4 * (n))       /* bit 31 valid, [30:16] mask, [14:0] stream */
+#define SMMU_S2CR(n)            (0xc00 + 4 * (n))       /* [17:16] 0 translate 1 bypass 2 fault, [7:0] context */
+#define SMMU_CBAR(n)            (4 * (n))
+#define SMMU_CBAR_STAGE_1       (1u << 16 | 3u << 8 | 0xfu << 12)
+#define SMMU_CBA2R(n)           (0x800 + 4 * (n))
+#define SMMU_CBA2R_64_BIT       1
+#define SMMU_CB_SCTLR           0x00
+#define SMMU_CB_TCR2            0x10
+#define SMMU_CB_TTBR0           0x20
+#define SMMU_CB_TTBR1           0x28
+#define SMMU_CB_TCR             0x30
+#define SMMU_CB_MAIR0           0x38
+#define SMMU_CB_MAIR1           0x3c
+#define SMMU_CB_FSR             0x58
+#define SMMU_CB_FAR             0x60
+#define SMMU_CB_FSYNR0          0x68
+#define SMMU_CB_TLBIASID        0x610
+#define SMMU_CB_TLBSYNC         0x7f0
+#define SMMU_CB_TLBSTATUS       0x7f4
+#define SMMU_SCTLR_ON           (1u << 0 | 1u << 1 | 1u << 2 | 1u << 5 | 1u << 8 | 1u << 12)
+#define SMMU_TCR_39_BITS        (25u | 1u << 8 | 1u << 10 | 3u << 12 | 1u << 23)
+#define SMMU_TCR2               (1u | 1u << 4 | 7u << 15)
+#define SMMU_MAIR0              0xf404ff44
+#define SMMU_FSR_ALL            0xc00001fe
+#define PTE_ADDRESS             0x0000fffffffff000ull
+#define AUDIO_PTE               (3ull | 1ull << 6 | 2ull << 8 | 1ull << 10 | 1ull << 11)       /* as hakios.wifi.c's */
+
+#define AUDIO_STREAM            0x1801
+#define AUDIO_ADDRESSES         0x10000000ull   /* dt: qcom,iommu-dma-addr-pool of qcom,msm-audio-ion */
+#define AUDIO_STREAM_BITS       (1ull << 32)    /* the stream's low bits (0x1801 & 0xf), where the DSP takes them from */
+
+#define PERIODS                 8
+#define PERIOD_FRAMES           960             /* 20 ms */
+#define PERIOD_BYTES            (PERIOD_FRAMES * 4)
+#define BUFFER_BYTES            (PERIODS * 4096)        /* a page each */
+#define MIC_BYTES               (16 * 4096)             /* the microphones' (hakios.mic.c), behind the periods */
+#define SHARED_BYTES            (BUFFER_BYTES + MIC_BYTES)
+
+static struct {
+	bool found, on, passed;         /* passed: the boot chain lets the stream through untranslated */
+	uint32_t page, pages, match, context, old_smr, old_s2cr, old_sctlr;
+	vm_offset_t tables;             /* three of 4K: the root, one of the second level, one of the third */
+} space;
+static vm_offset_t buffer;              /* BUFFER_BYTES of ours, the periods (and MIC_BYTES behind them: the microphones') */
+static uint64_t buffer_address;         /* as the DSP is to know it */
+
+static bool
+space_find(void)
+{
+	bool used[256] = { false };
+	uint32_t scr0 = get(&apps_smmu, "scr0", SMMU_SCR0), idr0 = get(&apps_smmu, "idr0", SMMU_IDR0);
+	uint32_t idr1 = get(&apps_smmu, "idr1", SMMU_IDR1), matches = idr0 & 0xff, contexts = idr1 & 0xff;
+
+	if (scr0 & 1u << 3) {
+		say("apollo sound: this SMMU numbers its streams with 16 bits, which nothing here is written for\n");
+		return false;
+	}
+	space.page = idr1 >> 31 ? 0x10000 : 0x1000;
+	space.pages = 2u << (idr1 >> 28 & 7);
+	if (2 * space.pages * space.page != 0x100000) {
+		say("apollo sound: the SMMU says it has 2 x %u pages of %#x bytes, not a megabyte: its contexts are not looked for\n",
+		    space.pages, space.page);
+		return false;
+	}
+	space.match = ~0u;
+	for (uint32_t n = 0; n < matches && SMMU_SMR(n) < 0xc00; n++) {
+		uint32_t smr = rd(apps_smmu.base + SMMU_SMR(n)), s2cr = rd(apps_smmu.base + SMMU_S2CR(n));
+		uint32_t stream = smr & 0x7fff, mask = smr >> 16 & 0x7fff;
+
+		if (smr >> 31) {
+			used[s2cr & 0xff] = true;
+			if (((stream ^ AUDIO_STREAM) & ~mask) == 0) {
+				say("apollo sound: match register %u covers the audio stream already: stream %#x mask %#x, s2cr %#x\n", n,
+				    stream, mask, s2cr);
+				if ((s2cr >> 16 & 3) == 1) {
+					space.passed = true;
+					return true;
+				}
+				say("apollo sound: ... and does not let it through untranslated: it is somebody's, and is left alone\n");
+				return false;
+			}
+		} else if (space.match == ~0u) {
+			space.match = n;
+			space.old_smr = smr;
+			space.old_s2cr = s2cr;
+		}
+	}
+	for (space.context = 0; space.context < contexts && used[space.context]; space.context++) {
+	}
+	if (space.match == ~0u || space.context >= contexts) {
+		say("apollo sound: the SMMU has no match register or no context left\n");
+		return false;
+	}
+	apps_smmu_second.phys = apps_smmu.phys + space.page;
+	apps_smmu_context.phys = apps_smmu.phys + (space.pages + space.context) * space.page;
+	say("apollo sound: the boot chain has set nothing up for stream %#x; free: match register %u (smr %#x, s2cr %#x) and context %u, at "
+	    "%#x\n", AUDIO_STREAM, space.match, space.old_smr, space.old_s2cr, space.context, apps_smmu_context.phys);
+	space.old_sctlr = get(&apps_smmu_context, "sctlr", SMMU_CB_SCTLR);
+	if (space.old_sctlr & 1) {
+		say("apollo sound: CONTEXT %u IS SWITCHED ON although no stream is sent through it: it is somebody's, and is left alone\n",
+		    space.context);
+		return false;
+	}
+	space.found = true;
+	return true;
+}
+
+static void
+space_faults(void)
+{
+	uint32_t status, global;
+
+	if (!space.on) {
+		return;
+	}
+	status = rd(apps_smmu_context.base + SMMU_CB_FSR);
+	global = rd(apps_smmu.base + SMMU_SGFSR);
+	if ((status & SMMU_FSR_ALL) == 0 && global == 0) {
+		say("apollo sound: the SMMU has refused the DSP nothing (context %u: fsr %#x; sgfsr 0)\n", space.context, status);
+		return;
+	}
+	say("apollo sound: THE SMMU HAS REFUSED A REQUEST: context %u: status %#x, address %#llx, syndrome %#x; the SMMU as a whole: status "
+	    "%#x, stream %#x\n", space.context, status, (uint64_t)rd(apps_smmu_context.base + SMMU_CB_FAR + 4) << 32 |
+	    rd(apps_smmu_context.base + SMMU_CB_FAR), rd(apps_smmu_context.base + SMMU_CB_FSYNR0), global,
+	    rd(apps_smmu.base + SMMU_SGFSYNR1));
+}
+
+/* Our buffer behind the DSP's addresses from AUDIO_ADDRESSES on, through a context of ours. */
+static bool
+space_on(void)
+{
+	uint64_t *root, *second, *third, table_root;
+	uint32_t smr = SMMU_SMR(space.match), s2cr = SMMU_S2CR(space.match), sees = 1u << 31 | AUDIO_STREAM;
+
+	if (kmem_alloc(kernel_map, &space.tables, 3 * 4096, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return false;
+	}
+	root = (uint64_t *)space.tables;
+	second = (uint64_t *)(space.tables + 4096);
+	third = (uint64_t *)(space.tables + 8192);
+	root[AUDIO_ADDRESSES >> 30 & 0x1ff] = kvtophys((vm_offset_t)second) | 3;
+	second[AUDIO_ADDRESSES >> 21 & 0x1ff] = kvtophys((vm_offset_t)third) | 3;
+	for (unsigned page = 0; page < SHARED_BYTES / 4096; page++) {
+		third[(AUDIO_ADDRESSES >> 12 & 0x1ff) + page] = kvtophys(buffer + 4096 * page) | AUDIO_PTE;
+	}
+	for (vm_offset_t line = space.tables; line < space.tables + 3 * 4096; line += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (line));
+	}
+	__asm__ volatile ("dsb sy");
+	table_root = kvtophys(space.tables) | (uint64_t)space.context << 48;
+	say("apollo sound: THE SMMU IS ABOUT TO BE WRITTEN: context %u gets page tables of ours (root %#llx) for the %u KB of the periods and the microphones' "
+	    "at %#llx, and match register %u sends stream %#x through it\n", space.context, table_root & PTE_ADDRESS,
+	    SHARED_BYTES / 1024, AUDIO_ADDRESSES, space.match, AUDIO_STREAM);
+	if (pause_ms) {
+		sleep_ms(pause_ms);
+	}
+	put(&apps_smmu_context, "sctlr", SMMU_CB_SCTLR, 0);
+	put(&apps_smmu_second, "cba2r", SMMU_CBA2R(space.context), SMMU_CBA2R_64_BIT);
+	put(&apps_smmu_second, "cbar", SMMU_CBAR(space.context), SMMU_CBAR_STAGE_1);
+	put(&apps_smmu_context, "tcr2", SMMU_CB_TCR2, SMMU_TCR2);
+	put(&apps_smmu_context, "tcr", SMMU_CB_TCR, SMMU_TCR_39_BITS);
+	put(&apps_smmu_context, "ttbr0, low", SMMU_CB_TTBR0, (uint32_t)table_root);
+	put(&apps_smmu_context, "ttbr0, high", SMMU_CB_TTBR0 + 4, (uint32_t)(table_root >> 32));
+	put(&apps_smmu_context, "ttbr1, low", SMMU_CB_TTBR1, 0);
+	put(&apps_smmu_context, "ttbr1, high", SMMU_CB_TTBR1 + 4, 0);
+	put(&apps_smmu_context, "mair0", SMMU_CB_MAIR0, SMMU_MAIR0);
+	put(&apps_smmu_context, "mair1", SMMU_CB_MAIR1, 0);
+	put(&apps_smmu_context, "fsr", SMMU_CB_FSR, SMMU_FSR_ALL);
+	put(&apps_smmu_context, "tlbiasid", SMMU_CB_TLBIASID, space.context);
+	put(&apps_smmu_context, "tlbsync", SMMU_CB_TLBSYNC, 1);
+	for (unsigned ms = 0; rd(apps_smmu_context.base + SMMU_CB_TLBSTATUS) & 1; ms++) {
+		if (ms == 100) {
+			say("apollo sound: the SMMU does not finish forgetting old translations\n");
+			return false;
+		}
+		sleep_ms(1);
+	}
+	put(&apps_smmu_context, "sctlr", SMMU_CB_SCTLR, SMMU_SCTLR_ON);
+	space.on = true;
+	put(&apps_smmu, "s2cr", s2cr, space.context);
+	put(&apps_smmu, "smr", smr, sees);
+	if (get(&apps_smmu, "smr", smr) != sees || (get(&apps_smmu, "s2cr", s2cr) & 0x300ff) != space.context ||
+	    !(get(&apps_smmu_context, "sctlr", SMMU_CB_SCTLR) & 1) ||
+	    get(&apps_smmu_context, "ttbr0, low", SMMU_CB_TTBR0) != (uint32_t)table_root) {
+		say("apollo sound: THE SMMU DID NOT TAKE WHAT WAS WRITTEN: stream %#x is not going through context %u\n", AUDIO_STREAM,
+		    space.context);
+		return false;
+	}
+	say("apollo sound: THE AUDIO STREAM GOES THROUGH CONTEXT %u of the SMMU, with our page tables\n", space.context);
+	return true;
+}
+
+static void
+space_off(void)
+{
+	if (!space.on) {
+		return;
+	}
+	space_faults();
+	say("apollo sound: the audio stream and context %u of the SMMU are put back as they were found\n", space.context);
+	put(&apps_smmu, "smr", SMMU_SMR(space.match), space.old_smr);
+	put(&apps_smmu, "s2cr", SMMU_S2CR(space.match), space.old_s2cr);
+	put(&apps_smmu_context, "sctlr", SMMU_CB_SCTLR, space.old_sctlr);
+	get(&apps_smmu, "smr", SMMU_SMR(space.match));
+	space.on = false;
+}
+
+/*
+ * The DSP's view of our memory is one: the sound's periods and the microphones' buffers behind them
+ * (hakios.mic.c), through the same stream and context. Whoever comes first sets it up, whoever
+ * leaves last takes it down. user: 0 the sound, 1 the microphones. With apollo_smmu_lock held.
+ */
+static uint32_t space_users;
+
+static bool
+shared_get(unsigned user)
+{
+	if (space_users == 0) {
+		if (buffer == 0 && kmem_alloc(kernel_map, &buffer, SHARED_BYTES, KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+		    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			buffer = 0;
+			say("apollo sound: no memory for the DSP's buffers\n");
+			return false;
+		}
+		if (!space.found && !space.passed && !space_find()) {
+			return false;
+		}
+		if (!space.passed && !space.on && !space_on()) {
+			return false;
+		}
+		buffer_address = space.passed ? (kvtophys(buffer) | AUDIO_STREAM_BITS) : (AUDIO_ADDRESSES | AUDIO_STREAM_BITS);
+		if (space.passed) {
+			for (unsigned page = 1; page < SHARED_BYTES / 4096; page++) {
+				if (kvtophys(buffer + 4096 * page) != kvtophys(buffer) + 4096 * page) {
+					say("apollo sound: the DSP's buffers are not one piece of memory, and the stream is not translated\n");
+					return false;
+				}
+			}
+		}
+	}
+	space_users |= 1u << user;
+	return true;
+}
+
+static void
+shared_put(unsigned user)
+{
+	if (!(space_users & 1u << user)) {
+		return;
+	}
+	space_users &= ~(1u << user);
+	if (space_users == 0) {
+		space_off();
+	}
+}
+
+bool
+apollo_audio_dsp_memory(uintptr_t *memory, uint64_t *dsp_address, uint32_t *bytes)
+{
+	bool ok;
+
+	lck_mtx_lock(&apollo_smmu_lock);
+	ok = shared_get(1);
+	lck_mtx_unlock(&apollo_smmu_lock);
+	if (ok) {
+		*memory = buffer + BUFFER_BYTES;
+		*dsp_address = buffer_address + BUFFER_BYTES;
+		*bytes = MIC_BYTES;
+	}
+	return ok;
+}
+
+void
+apollo_audio_dsp_memory_put(void)
+{
+	lck_mtx_lock(&apollo_smmu_lock);
+	shared_put(1);
+	lck_mtx_unlock(&apollo_smmu_lock);
+}
+
+/* ---- ADM and ASM: the path and the stream --------------------------------------------------------------- */
+
+#define ADM_CMD_DEVICE_OPEN_V5                  0x00010326u
+#define ADM_CMDRSP_DEVICE_OPEN_V5               0x00010329u
+#define ADM_CMD_DEVICE_CLOSE_V5                 0x00010327u
+#define ADM_CMD_MATRIX_MAP_ROUTINGS_V5          0x00010325u
+#define ADM_PATH_PLAYBACK                       1
+#define ADM_MATRIX_AUDIO_RX                     0
+#define ADM_TOPOLOGY_NONE                       0x00010312u
+#define ADM_BITS                                24
+
+#define ASM_CMD_SHARED_MEM_MAP_REGIONS          0x00010d92u
+#define ASM_CMDRSP_SHARED_MEM_MAP_REGIONS       0x00010d93u
+#define ASM_CMD_SHARED_MEM_UNMAP_REGIONS        0x00010d94u
+#define ASM_STREAM_CMD_OPEN_WRITE_V3            0x00010db3u
+#define ASM_DATA_CMD_MEDIA_FMT_UPDATE_V2        0x00010d98u
+#define ASM_SESSION_CMD_RUN_V2                  0x00010daau
+#define ASM_DATA_CMD_WRITE_V2                   0x00010dabu
+#define ASM_DATA_EVENT_WRITE_DONE_V2            0x00010d99u
+#define ASM_SESSION_EVENT_RX_UNDERFLOW          0x00010c17u
+#define ASM_STREAM_CMD_CLOSE                    0x00010bcdu
+#define ASM_TOPOLOGY_NONE                       0x00010c68u
+#define ASM_MEDIA_FMT_MULTI_CHANNEL_PCM_V2      0x00010da5u
+#define ASM_SHMEM_4K_POOL                       3
+#define SESSION                                 1
+#define STREAM_PORT                             (SESSION << 8 | 1)
+#define WRITE_TOKEN                             0x80000000u     /* | the period: what a write's "done" carries back */
+#define PCM_CHANNEL_FL                          1
+#define PCM_CHANNEL_FR                          2
+
+static volatile bool stopping;          /* the run is ending: whatever plays stops */
+static bool mapped, copp_open, stream_open;
+static uint32_t map_handle, copp;
+static volatile uint32_t returned;      /* the periods the DSP has said it is done with (a bit each) */
+static volatile uint32_t written_done, underflows, write_errors;
+
+/* The DSP's events: the "done" of every write, and underflows. On the link's thread. */
+static bool
+events(uint8_t service, __unused uint16_t port, uint32_t opcode, uint32_t token, const uint32_t *payload, uint32_t length)
+{
+	if (service != APR_SVC_ASM) {
+		return false;
+	}
+	if (opcode == ASM_DATA_EVENT_WRITE_DONE_V2 && (token & WRITE_TOKEN)) {
+		if (length >= 16 && payload[3] != 0) {
+			OSIncrementAtomic((volatile SInt32 *)&write_errors);
+		}
+		OSIncrementAtomic((volatile SInt32 *)&written_done);
+		OSBitOrAtomic(1u << (token & 31), &returned);
+		return true;
+	}
+	if (opcode == APR_BASIC_RSP_RESULT && (token & WRITE_TOKEN)) {
+		/* (a write the DSP refused outright: it answers it as a command) */
+		OSIncrementAtomic((volatile SInt32 *)&write_errors);
+		OSIncrementAtomic((volatile SInt32 *)&written_done);
+		OSBitOrAtomic(1u << (token & 31), &returned);
+		return true;
+	}
+	if (opcode == ASM_SESSION_EVENT_RX_UNDERFLOW) {
+		OSIncrementAtomic((volatile SInt32 *)&underflows);
+		return true;
+	}
+	return false;
+}
+
+static bool
+stream_on(void)
+{
+	struct {
+		uint16_t pool, regions;
+		uint32_t property;
+		uint32_t low, high, size;
+	} __attribute__((packed)) map = { ASM_SHMEM_4K_POOL, 1, 0, (uint32_t)buffer_address, (uint32_t)(buffer_address >> 32),
+		                          BUFFER_BYTES };
+	struct {
+		uint16_t flags, mode, endpoint1, endpoint2;
+		uint32_t topology;
+		uint16_t channels, bits;
+		uint32_t rate;
+		uint8_t map[8];
+	} __attribute__((packed)) open = { 0, ADM_PATH_PLAYBACK, PORT, 0xffff, ADM_TOPOLOGY_NONE, 2, ADM_BITS, RATE,
+		                           { PCM_CHANNEL_FL, PCM_CHANNEL_FR } };
+	struct {
+		uint32_t matrix, sessions;
+		uint16_t session, copps;
+		uint16_t copp[2];
+	} __attribute__((packed)) route = { ADM_MATRIX_AUDIO_RX, 1, SESSION, 1, { 0, 0 } };
+	struct {
+		uint32_t flags;
+		uint16_t sink, bits;
+		uint32_t topology, format;
+	} __attribute__((packed)) write = { 0, 0, 16, ASM_TOPOLOGY_NONE, ASM_MEDIA_FMT_MULTI_CHANNEL_PCM_V2 };
+	struct {
+		uint32_t size;
+		uint16_t channels, bits;
+		uint32_t rate;
+		uint16_t is_signed, reserved;
+		uint8_t map[8];
+	} __attribute__((packed)) format = { 20, 2, 16, RATE, 1, 0, { PCM_CHANNEL_FL, PCM_CHANNEL_FR } };
+	uint32_t run[3] = { 0, 0, 0 };
+	struct hakios_apr_answer answer;
+
+	announce("the DSP is given our periods (ASM), a device path to the port (ADM) and a stream routed to it (ASM)");
+	if (!command("our periods, mapped for the DSP", APR_SVC_ASM, 0, ASM_CMD_SHARED_MEM_MAP_REGIONS, &map, sizeof(map),
+	    ASM_CMDRSP_SHARED_MEM_MAP_REGIONS, &answer)) {
+		return false;
+	}
+	mapped = true;
+	map_handle = answer.words[0];
+	say("apollo sound: our %u KB at %#llx are the DSP's handle %#x\n", BUFFER_BYTES / 1024, buffer_address, map_handle);
+	if (!command("a device path to the port: playback, no processing, 2 channels of 24 bits at 48 kHz", APR_SVC_ADM, PORT,
+	    ADM_CMD_DEVICE_OPEN_V5, &open, sizeof(open), ADM_CMDRSP_DEVICE_OPEN_V5, &answer)) {
+		return false;
+	}
+	if (answer.words[0] != 0) {
+		say("apollo sound: the device path: REFUSED: %s\n", dsp_error(answer.words[0]));
+		return false;
+	}
+	copp_open = true;
+	copp = answer.words[1] & 0xffff;        /* (the upper half is reserved) */
+	route.copp[0] = (uint16_t)copp;
+	say("apollo sound: the device path is open: COPP %u\n", copp);
+	if (!command("the stream, opened for writing: 16-bit linear PCM, no processing", APR_SVC_ASM, STREAM_PORT,
+	    ASM_STREAM_CMD_OPEN_WRITE_V3, &write, sizeof(write), 0, NULL)) {
+		return false;
+	}
+	stream_open = true;
+	return command("session 1 routed to the device path", APR_SVC_ADM, 0, ADM_CMD_MATRIX_MAP_ROUTINGS_V5, &route, sizeof(route),
+	           0, NULL) &&
+	       command("the stream's format: 2 channels of 16 bits at 48 kHz, left and right", APR_SVC_ASM, STREAM_PORT,
+	           ASM_DATA_CMD_MEDIA_FMT_UPDATE_V2, &format, sizeof(format), 0, NULL) &&
+	       command("the session, run", APR_SVC_ASM, STREAM_PORT, ASM_SESSION_CMD_RUN_V2, run, sizeof(run), 0, NULL);
+}
+
+static void
+stream_off(void)
+{
+	uint32_t handle = map_handle;
+
+	if (stream_open) {
+		command("the stream, closed", APR_SVC_ASM, STREAM_PORT, ASM_STREAM_CMD_CLOSE, NULL, 0, 0, NULL);
+		stream_open = false;
+	}
+	if (copp_open) {
+		command("the device path, closed", APR_SVC_ADM, (uint16_t)copp, ADM_CMD_DEVICE_CLOSE_V5, NULL, 0, 0, NULL);
+		copp_open = false;
+	}
+	if (mapped) {
+		command("our periods, unmapped", APR_SVC_ASM, 0, ASM_CMD_SHARED_MEM_UNMAP_REGIONS, &handle, sizeof(handle), 0, NULL);
+		mapped = false;
+	}
+}
+
+/* ---- the test tone ----------------------------------------------------------------------------------- */
+
+/* 1 kHz at 48 kHz, -20 dBFS (a peak of 3277): one cycle */
+static const int16_t tone[48] = {
+	0, 428, 848, 1254, 1638, 1995, 2317, 2600, 2838, 3028, 3165, 3249,
+	3277, 3249, 3165, 3028, 2838, 2600, 2317, 1995, 1638, 1254, 848, 428,
+	0, -428, -848, -1254, -1638, -1995, -2317, -2600, -2838, -3028, -3165, -3249,
+	-3277, -3249, -3165, -3028, -2838, -2600, -2317, -1995, -1638, -1254, -848, -428,
+};
+static uint32_t tone_at;
+
+static void
+period_fill(unsigned period, bool silent)
+{
+	int16_t *samples = (int16_t *)(buffer + 4096 * period);
+
+	for (unsigned frame = 0; frame < PERIOD_FRAMES; frame++) {
+		int16_t sample = silent ? 0 : tone[tone_at++ % 48];
+
+		samples[2 * frame] = sample;
+		samples[2 * frame + 1] = sample;
+	}
+	for (vm_offset_t line = (vm_offset_t)samples; line < (vm_offset_t)samples + PERIOD_BYTES; line += 64) {
+		__asm__ volatile ("dc cvac, %0" : : "r" (line));        /* the DSP reads memory, not our caches */
+	}
+	__asm__ volatile ("dsb sy");
+}
+
+static bool
+period_write(unsigned period)
+{
+	uint32_t write[8] = { (uint32_t)(buffer_address + 4096 * period), (uint32_t)((buffer_address + 4096 * period) >> 32),
+		              map_handle, PERIOD_BYTES, period, 0, 0, 0 };
+
+	return apollo_adsp_apr(APR_SVC_ASM, STREAM_PORT, WRITE_TOKEN | period, ASM_DATA_CMD_WRITE_V2, write, sizeof(write), 0, NULL);
+}
+
+/*
+ * The tone, written period after period as the DSP gives them back, for `ms'; then silence until
+ * the DSP has given every period back. What came back and how fast is said.
+ */
+static bool
+play(uint32_t ms, bool amplifiers)
+{
+	uint64_t began, last_look, ended;
+	uint32_t sent = 0, done_before = written_done, healthy_looks = 0;
+	bool ok = true, tone_over = false;
+
+	returned = 0;
+	tone_at = 0;
+	for (unsigned p = 0; p < PERIODS; p++) {
+		period_fill(p, false);
+	}
+	began = last_look = now_us();
+	for (unsigned p = 0; p < PERIODS; p++) {
+		if (!period_write(p)) {
+			say("apollo sound: the write of period %u could not be sent\n", p);
+			return false;
+		}
+		sent++;
+	}
+	for (;;) {
+		uint32_t back = returned;
+		uint64_t now = now_us();
+
+		if (back != 0) {
+			OSBitAndAtomic(~back, &returned);
+			for (unsigned p = 0; p < PERIODS; p++) {
+				if (!(back & 1u << p) || tone_over) {
+					continue;
+				}
+				period_fill(p, false);
+				if (!period_write(p)) {
+					say("apollo sound: the write of period %u could not be sent\n", p);
+					ok = false;
+					tone_over = true;
+					break;
+				}
+				sent++;
+			}
+		}
+		if (!tone_over && (now - began >= ms * 1000ull || stopping)) {
+			tone_over = true;
+		}
+		if (tone_over && written_done - done_before >= sent) {
+			break;
+		}
+		if (now - began > ms * 1000ull + 2000000) {
+			say("apollo sound: THE DSP HAS NOT GIVEN EVERY PERIOD BACK 2 s after the end (%u of %u)\n", written_done - done_before,
+			    sent);
+			ok = false;
+			break;
+		}
+		if (written_done == done_before && now - began > 1000000) {
+			say("apollo sound: THE DSP HAS GIVEN NO PERIOD BACK IN A SECOND\n");
+			ok = false;
+			break;
+		}
+		if (amplifiers && now - last_look >= 200000) {
+			last_look = now;
+			healthy_looks++;
+			if (!apollo_cs35l41_healthy()) {
+				ok = false;
+				tone_over = true;
+			}
+		}
+		sleep_ms(2);
+	}
+	ended = now_us();
+	{
+		uint32_t done = written_done - done_before;
+		uint64_t frames = (uint64_t)done * PERIOD_FRAMES, us = ended - began;
+
+		say("apollo sound: %u periods written, %u given back (%u with an error), %u underflows, in %llu ms: the DSP took %llu frames a "
+		    "second%s\n", sent, done, write_errors, underflows, us / 1000, us ? frames * 1000000 / us : 0,
+		    amplifiers ? "" : " (the amplifiers off: nothing to hear)");
+		if (amplifiers) {
+			say("apollo sound: the amplifiers' status looked at %u times while it played\n", healthy_looks);
+		}
+	}
+	return ok;
+}
+
+/* ---- sound=4: what iOS plays ------------------------------------------------------------------------------ */
+
+/*
+ * /dev/hakios-audio's writer (the audio server's real-time thread, hakios.audio.c) puts frames
+ * into a ring and does not wait; the feeder, a thread of ours, takes them from there into each
+ * period the DSP gives back (and silence when there is nothing), so the stream never stops
+ * while the run lasts. The amplifiers are only on while there is sound: the watcher starts them
+ * (and fades them in to sound_below) when a write is not silence, and stops them after three
+ * seconds of silence or no writes.
+ */
+#define RING_FRAMES             32768           /* 0.68 s; a power of two, the indices run on and wrap */
+#define SILENCE                 8               /* samples no larger than this are silence (as hakios.audio.c's) */
+#define QUIET_BEFORE_OFF_US     3000000ull
+
+static int16_t ring[RING_FRAMES * 2];
+static volatile uint32_t ring_head, ring_tail;  /* frames: written by the sink, taken by the feeder */
+static volatile uint64_t last_sound_us;         /* when the latest write that was not silence came */
+static volatile bool feeder_runs, watcher_runs;
+static uint64_t fed_frames, silent_frames, ios_frames;
+static volatile uint32_t ios_peak;              /* the largest sample since the amplifiers last started */
+
+/* From the writer's thread, under hakios.audio.c's lock: never waits. */
+static uint32_t
+ios_sink(const int16_t *frames, uint32_t count)
+{
+	uint32_t head = ring_head, room = RING_FRAMES - (head - ring_tail), taken = count < room ? count : room;
+	bool sound = false;
+
+	for (uint32_t i = 0; i < taken; i++) {
+		int16_t left = frames[2 * i], right = frames[2 * i + 1];
+		uint32_t l = left < 0 ? (uint32_t)-(int32_t)left : (uint32_t)left, r = right < 0 ? (uint32_t)-(int32_t)right : (uint32_t)right;
+
+		ring[2 * ((head + i) % RING_FRAMES)] = left;
+		ring[2 * ((head + i) % RING_FRAMES) + 1] = right;
+		sound |= l > SILENCE || r > SILENCE;
+		if (l > ios_peak || r > ios_peak) {
+			ios_peak = l > r ? l : r;
+		}
+	}
+	OSMemoryBarrier();
+	ring_head = head + taken;
+	ios_frames += taken;
+	if (sound) {
+		last_sound_us = now_us();
+	}
+	return taken;
+}
+
+static uint32_t guard_periods;                  /* periods through the guard */
+static volatile bool guard_on;                  /* the amplifiers are on: what the guard lets through is heard */
+
+/* tenths of a dB as text: "-5.7" */
+static const char *
+db_text(char *text, int tenths)
+{
+	snprintf(text, 16, "%s%d.%d", tenths < 0 ? "-" : "", (tenths < 0 ? -tenths : tenths) / 10, (tenths < 0 ? -tenths : tenths) % 10);
+	return text;
+}
+
+/* What the guard has done since it was last said (hakios.guard.c), as one line; nothing if `quiet'. */
+static void
+guard_say(const char *when, bool quiet)
+{
+	struct apollo_guard_report r;
+	char t[6][16];
+
+	apollo_guard_take_report(&r);
+	if (r.blocks == 0 || quiet) {
+		return;
+	}
+	/* (levels at the speakers: dB under a full-scale square wave at Android's level; gains in dB) */
+	say("apollo sound: the guard%s: peaks in %u, out %u (of 32768); gain now %s dB, least %s dB, held down by the 0.2 s/3 s/60 s "
+	    "averages in %u/%u/%u of %u periods; peaks limited in %u frames (by %s dB at most); averages %s/%s/%s dB\n",
+	    when, r.peak_in, r.peak_out, db_text(t[0], apollo_guard_decibels(r.gain * r.gain >> 30)),
+	    db_text(t[1], apollo_guard_decibels(r.least_gain * r.least_gain >> 30)), r.rms_blocks, r.fast_blocks, r.slow_blocks,
+	    r.blocks, r.limited_frames, db_text(t[2], apollo_guard_decibels((uint64_t)r.least_peak_gain * r.least_peak_gain >> 2)),
+	    db_text(t[3], apollo_guard_decibels(r.rms)), db_text(t[4], apollo_guard_decibels(r.fast)),
+	    db_text(t[5], apollo_guard_decibels(r.slow)));
+}
+
+/* A period from the ring, the rest of it silence. */
+static void
+period_fill_ios(unsigned period)
+{
+	int16_t *samples = (int16_t *)(buffer + 4096 * period);
+	uint32_t tail = ring_tail, available = ring_head - tail, n = available < PERIOD_FRAMES ? available : PERIOD_FRAMES;
+
+	OSMemoryBarrier();
+	for (uint32_t i = 0; i < n; i++) {
+		samples[2 * i] = ring[2 * ((tail + i) % RING_FRAMES)];
+		samples[2 * i + 1] = ring[2 * ((tail + i) % RING_FRAMES) + 1];
+	}
+	bzero(samples + 2 * n, (PERIOD_FRAMES - n) * 4);
+	OSMemoryBarrier();
+	ring_tail = tail + n;
+	fed_frames += n;
+	silent_frames += PERIOD_FRAMES - n;
+	/* the guard, on every period, silence too: its filter and its averages go on (hakios.guard.c) */
+	apollo_guard_process(samples, PERIOD_FRAMES);
+	if (n != 0 && apollo_audio_recording_fed()) {
+		apollo_audio_record_fed(samples, n);
+	}
+	guard_periods++;
+	for (vm_offset_t line = (vm_offset_t)samples; line < (vm_offset_t)samples + PERIOD_BYTES; line += 64) {
+		__asm__ volatile ("dc cvac, %0" : : "r" (line));
+	}
+	__asm__ volatile ("dsb sy");
+}
+
+static void
+feeder_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	uint32_t sent = 0, failed = 0;
+
+	returned = 0;
+	for (unsigned p = 0; p < PERIODS; p++) {
+		period_fill_ios(p);
+		sent += period_write(p);
+	}
+	while (!stopping) {
+		uint32_t back = returned;
+		static bool was_on;
+
+		if (guard_on && !was_on) {
+			guard_say("", true);    /* (what it did to the silence meanwhile is of no interest) */
+			guard_periods = 0;
+		} else if (was_on && !guard_on) {
+			guard_say(" until the amplifiers stopped", false);
+		} else if (guard_on && guard_periods >= 250) {
+			guard_say(", 5 s", false);
+			guard_periods = 0;
+		}
+		was_on = guard_on;
+		if (back != 0) {
+			OSBitAndAtomic(~back, &returned);
+			for (unsigned p = 0; p < PERIODS; p++) {
+				if (back & 1u << p) {
+					period_fill_ios(p);
+					if (period_write(p)) {
+						sent++;
+					} else {
+						failed++;
+					}
+				}
+			}
+		}
+		sleep_ms(2);
+	}
+	say("apollo sound: the feeder stops: %u periods written (%u could not be sent), %u given back (%u with an error), %u underflows; "
+	    "from iOS %llu frames came, %llu went to the DSP, %llu of silence filled in\n", sent, failed, written_done, write_errors,
+	    underflows, ios_frames, fed_frames, silent_frames);
+	feeder_runs = false;
+	thread_terminate(current_thread());
+}
+
+/* The amplifiers' level as the guard is to reckon with it (sound_guard_as: louder than it is, for a test). */
+static void
+guard_level(uint32_t level_below)
+{
+	apollo_guard_attenuation(level_below < guard_as ? level_below : guard_as);
+}
+
+/*
+ * The amplifiers are off. The guard goes on at their level all the same: what it lets through now reaches them
+ * 160 ms later, behind the periods queued at the DSP, and if that is sound, they will have been started by then
+ * (70 ms after it comes). While they are off nothing but silence comes, and the averages fall as a speaker cools.
+ * Only when nothing can be heard at all -- iOS's volume at 0, the amplifiers given up on -- is the guard told so.
+ */
+static void
+guard_off(bool unheard)
+{
+	guard_on = false;
+	if (unheard) {
+		apollo_guard_attenuation(APOLLO_GUARD_SILENT);
+	}
+}
+
+/* sound_below and iOS's volume together, eighths of a dB under Android's level: never wrapped (iOS's part comes from an
+ * ioctl), never past BELOW_MOST */
+static uint32_t
+below_with(uint32_t extra)
+{
+	return extra >= BELOW_MOST || below + extra >= BELOW_MOST ? BELOW_MOST : below + extra;
+}
+
+/*
+ * The amplifiers on while there is sound, at the volume iOS has set (apollo_audio_volume(): how
+ * far under the loudest, sound_below under Android's level), and off while iOS's volume is 0;
+ * their status looked at every 200 ms while they are on. On the sound's thread.
+ */
+static void
+watch(void)
+{
+	bool on = false, given_up = false, muted = false;
+	uint64_t last_look = 0, last_monitor = 0;
+	uint32_t starts = 0, changes = 0, generation = 0, extra = 0, monitor = 0, monitor_looks = 0;
+
+	guard_level(below);                     /* (from the first sample on: see guard_off()) */
+
+	while (!stopping) {
+		uint64_t now = now_us(), sounded = last_sound_us;
+		uint32_t extra_now, generation_now;
+		bool muted_now;
+
+		if (apollo_audio_volume(&extra_now, &muted_now, &generation_now) && generation_now != generation) {
+			generation = generation_now;
+			extra = extra_now;
+			muted = muted_now;
+			changes++;
+			say("apollo sound: iOS sets the volume: %s%u.%03u dB under the loudest, which is %u.%03u dB under Android's level%s\n",
+			    muted ? "muted (0), " : "", extra / 8, extra % 8 * 125, below / 8, below % 8 * 125,
+			    on ? (muted ? ": the amplifiers are stopped" : ": the amplifiers follow") : "");
+			if (muted) {
+				if (on) {
+					apollo_cs35l41_stop();
+					on = false;
+				}
+				guard_off(true);
+			} else if (on && !apollo_cs35l41_volume(below_with(extra), 1)) {
+				/* at a level not known: powered down before the guard is told nothing is heard */
+				say("apollo sound: THE AMPLIFIERS' VOLUME COULD NOT BE SET: they are powered down and given up on\n");
+				apollo_cs35l41_stop();
+				guard_off(true);
+				on = false;
+				given_up = true;
+			} else if (!given_up) {
+				guard_level(below_with(extra));
+			}
+		}
+		if (!on && !given_up && !muted && sounded != 0 && now - sounded < 100000) {
+			say_when("iOS plays: the amplifiers are started");
+			starts++;
+			ios_peak = 0;
+			if (!apollo_cs35l41_start() || !apollo_cs35l41_volume(below_with(extra), 1)) {
+				say("apollo sound: THE AMPLIFIERS DID NOT START; iOS's sound goes on to the DSP, unheard\n");
+				apollo_cs35l41_stop();          /* (any of them that did power up: not left on with the guard off) */
+				guard_off(true);
+				given_up = true;
+			} else {
+				on = true;
+				guard_on = true;
+				last_look = now_us();
+				last_monitor = 0;
+				monitor_looks = 0;
+				/* (what is written now is heard after the periods already queued at the DSP: PERIODS x 20 ms) */
+				say("apollo sound: the amplifiers are up %llu ms after the first write that was not silence; that write reaches "
+				    "them %u ms after it was made, behind the periods queued at the DSP\n", (last_look - sounded) / 1000,
+				    PERIODS * PERIOD_FRAMES / 48);
+			}
+		} else if (on && now - sounded > QUIET_BEFORE_OFF_US) {
+			say_when("three seconds of silence: the amplifiers are stopped");
+			say("apollo sound: what iOS wrote while they were on peaked at %u%% of full scale (%u)\n", ios_peak * 100 / 32768,
+			    ios_peak);
+			guard_off(false);
+			apollo_cs35l41_stop();
+			on = false;
+		} else if (on && now - last_look >= 200000) {
+			last_look = now;
+			if (!apollo_cs35l41_healthy()) {
+				guard_off(true);
+				on = false;
+				given_up = true;
+			} else if (now - last_monitor >= 1000000) {
+				/* the amplifiers' temperature and the battery as they see it, every second: a reduction if Android's table asks for one */
+				uint32_t wanted;
+
+				last_monitor = now;
+				wanted = apollo_cs35l41_monitor(monitor_looks++ % 10 == 0);
+				if (wanted != monitor) {
+					say("apollo sound: the amplifiers' watch asks for %u.%03u dB less (it was %u.%03u)\n", wanted / 8, wanted % 8 * 125,
+					    monitor / 8, monitor % 8 * 125);
+					monitor = wanted;
+					apollo_guard_monitor(monitor);
+				}
+			}
+		}
+		sleep_ms(5);
+	}
+	/* (take_down() stops them too, but only after waiting 3 s for this: if the watcher outlived that, what it started is
+	 * stopped here; the amplifiers' calls are serialized in hakios.apollo_cs35l41.c) */
+	if (on) {
+		apollo_cs35l41_stop();
+	}
+	guard_off(true);
+	say("apollo sound: the watcher stops; the amplifiers were started %u times, iOS set the volume %u times%s\n", starts, changes,
+	    given_up ? ", and the amplifiers were then given up on" : "");
+	watcher_runs = false;
+}
+
+/* ---- the whole ---------------------------------------------------------------------------------------- */
+
+static bool running, taken_down;
+
+static void
+take_down(void)
+{
+	stopping = true;
+	if (level >= 4) {
+		apollo_audio_set_sink("nothing", NULL);
+	}
+	for (unsigned ms = 0; ms < 3000 && (feeder_runs || watcher_runs); ms++) {
+		sleep_ms(1);
+	}
+	lck_mtx_lock(&sound_lock);
+	if (running && !taken_down) {
+		taken_down = true;
+		apollo_cs35l41_stop();
+		stream_off();
+		afe_off();
+		pins_off();
+		lck_mtx_lock(&apollo_smmu_lock);
+		shared_put(0);
+		lck_mtx_unlock(&apollo_smmu_lock);
+		apollo_adsp_apr_events(NULL);
+		say("apollo sound: everything of the sound's is stopped and put back\n");
+	}
+	lck_mtx_unlock(&sound_lock);
+}
+
+static void
+sound_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	const uint8_t *acf = NULL;
+	uint64_t acf_size = 0;
+	uint32_t changes, ones, sync_changes, sync_ones;
+	bool ok = false;
+
+	lck_mtx_lock(&sound_lock);
+	if (taken_down) {
+		lck_mtx_unlock(&sound_lock);
+		thread_terminate(current_thread());
+	}
+	if (level == 4) {
+		say("apollo sound: level 4: what iOS plays, through the port, a stream and the amplifiers, until the run ends\n");
+	} else {
+		say("apollo sound: level %u: %s, for %u s\n", level, level == 1 ? "the speakers' TDM port" : level == 2 ?
+		    "the port and a stream with a test tone, the amplifiers off" :
+		    "the port, a stream with a test tone, and the amplifiers", seconds);
+	}
+	if (level >= 2) {
+		lck_mtx_lock(&apollo_smmu_lock);
+		ok = shared_get(0);
+		lck_mtx_unlock(&apollo_smmu_lock);
+		if (!ok) {
+			goto out;
+		}
+		ok = false;
+		apollo_adsp_apr_events(events);
+	}
+	announce("the TDM pins (GPIO 133 to 137) to the interface, as Android's active state has them");
+	pins_on();
+	if (!afe_on()) {
+		goto out;
+	}
+	sleep_ms(20);
+	pin_activity(133, "the bit clock (gpio133)", &changes, &ones);
+	pin_activity(135, "the frame sync (gpio135)", &sync_changes, &sync_ones);
+	say("apollo sound: %s\n", changes > 100 && sync_changes > 4 ? "THE TDM CLOCK AND FRAME SYNC RUN at the pins" :
+	    "THE PINS DO NOT SHOW A RUNNING TDM CLOCK");
+	if (level == 1) {
+		sleep_ms(seconds * 1000);
+		ok = true;
+		goto out;
+	}
+	if (!stream_on()) {
+		goto out;
+	}
+	if (level == 4) {
+		thread_t feeder;
+
+		announce("the amplifiers, set up from Android's Music profile, powered down until iOS plays");
+		if (!apollo_cs35l41_prepare(acf, acf_size)) {
+			goto out;
+		}
+		apollo_adsp_fw_free(acf, acf_size);
+		acf = NULL;
+		feeder_runs = true;
+		if (kernel_thread_start(feeder_thread, NULL, &feeder) != KERN_SUCCESS) {
+			feeder_runs = false;
+			say("apollo sound: no thread for the feeder\n");
+			goto out;
+		}
+		thread_set_thread_name(feeder, "apollo sound feeder");
+		thread_deallocate(feeder);
+		watcher_runs = true;
+		apollo_audio_set_sink("the speakers (the audio DSP, hakios.sound.c)", ios_sink);
+		say("apollo sound: WHAT IOS PLAYS GOES TO THE SPEAKERS from here on, %u.%03u dB under Android's level, until the run ends\n",
+		    below / 8, below % 8 * 125);
+		say("apollo sound: through the guard (hakios.guard.c): %u.%03u dB of gain first (sound_gain), then high-pass at 200 Hz; peaks "
+		    "3 dB, the 0.2 s/3 s/60 s power 6/9/12 dB under full scale at Android's level\n", gain / 8, gain % 8 * 125);
+		if (guard_as < below) {
+			say("apollo sound: sound_guard_as=%u: FOR A TEST the guard reckons the amplifiers %u.%03u dB under Android's level, louder "
+			    "than they are, and holds back as much as it would there\n", guard_as, guard_as / 8, guard_as % 8 * 125);
+		}
+		lck_mtx_unlock(&sound_lock);
+		watch();
+		thread_terminate(current_thread());
+	}
+	if (level >= 3) {
+		/* the clock runs (the port is started, the stream as well): the amplifiers can lock to it */
+		announce("the amplifiers, set up from Android's Music profile, then started at the lowest volume");
+		if (!apollo_cs35l41_prepare(acf, acf_size) || !apollo_cs35l41_start()) {
+			goto out;
+		}
+	}
+	/* (the amplifiers are faded in before the tone begins: they fade in on silence, and the tone starts at that level) */
+	if (level >= 3 && !apollo_cs35l41_volume(below, 50)) {
+		goto out;
+	}
+	if (level >= 3) {
+		say("apollo sound: THE TONE PLAYS NOW for %u s: 1 kHz at -20 dBFS, both speakers, %u.%03u dB under Android's level\n",
+		    seconds, below / 8, below % 8 * 125);
+	}
+	say_when("the tone begins");
+	ok = play(seconds * 1000, level >= 3);
+	say_when("the tone has ended");
+	space_faults();
+out:
+	if (acf != NULL) {
+		apollo_adsp_fw_free(acf, acf_size);
+	}
+	lck_mtx_unlock(&sound_lock);
+	take_down();
+	say("apollo sound: %s; last: %s\n", ok ? "LEVEL DONE" : "STOPPED SHORT", last_write);
+	thread_terminate(current_thread());
+}
+
+void
+apollo_sound_dsp_up(void)
+{
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("apollo_audio", &level, sizeof(level)) || level < 2) {
+		return;
+	}
+	level -= 1;                     /* apollo_audio=1 is the DSP alone (hakios.apollo_adsp.c) */
+	if (level > 4) {
+		level = 4;
+	}
+	PE_parse_boot_argn("apollo_sound_secs", &seconds, sizeof(seconds));
+	PE_parse_boot_argn("apollo_sound_below", &below, sizeof(below));
+	if (below > BELOW_MOST) {
+		below = BELOW_MOST;
+	}
+	PE_parse_boot_argn("apollo_sound_pause", &pause_ms, sizeof(pause_ms));
+	PE_parse_boot_argn("apollo_sound_guard_as", &guard_as, sizeof(guard_as));
+	PE_parse_boot_argn("apollo_sound_gain", &gain, sizeof(gain));
+	if (gain > APOLLO_GUARD_MAX_GAIN) {
+		gain = APOLLO_GUARD_MAX_GAIN;
+	}
+	apollo_guard_configure(true, gain);
+	if (level >= 2 && level <= 3 && seconds > 3) {
+		seconds = 3;            /* the test tone: three seconds at most */
+	}
+	running = true;
+	if (kernel_thread_start(sound_thread, NULL, &thread) != KERN_SUCCESS) {
+		running = false;
+		say("apollo sound: no thread\n");
+		return;
+	}
+	thread_set_thread_name(thread, "apollo sound");
+	thread_deallocate(thread);
+}
+
+void
+apollo_sound_dsp_down(void)
+{
+	if (running) {
+		take_down();
+	}
+}
+
+void
+apollo_sound_quiesce(void)
+{
+	apollo_cs35l41_quiesce();
+}
diff --git a/bsd/dev/hakios.apollo_touch.c b/bsd/dev/hakios.apollo_touch.c
new file mode 100644
index 000000000000..497ba30d78a6
--- /dev/null
+++ b/bsd/dev/hakios.apollo_touch.c
@@ -0,0 +1,1209 @@
+/*
+ * The touch screen of the Xiaomi Mi 10T (apollo): a Novatek NT36675 ("j3s") in the display's panel, on the
+ * QUPv3 serial engine 4, as a source of touches for /dev/hakios-touch (sys/hakios.input.h). Only with
+ * boot-arg apollo_touch=1 on apollo (bsd/dev/hakios.apollo_input.c): every address, clock and pin below belongs to that phone.
+ *
+ * There is no clock, pin, regulator or SPI framework in this kernel, so the driver does all of it itself, in
+ * the order the vendor's Linux drivers do:
+ *   clocks   the serial engine's clocks, by vote in the global clock controller (kona GCC)
+ *   pins     four lines to the serial engine, plus reset, interrupt and the chip's I/O supply
+ *   SPI      the serial engine ("GENI") in FIFO mode, polled; or, if the engine cannot be used, the same
+ *            lines driven by hand
+ *   chip     Novatek: power the I/O supply on, reset the chip, then read the touch reports from its event
+ *            buffer, through the Novatek's own read framing (the "set page" register and the address bits of
+ *            the data byte), and keep reading them
+ * No interrupt is used: a thread reads the report every poll interval.
+ *
+ * Register layouts: Linux drivers/spi/spi-geni-qcom.c, drivers/soc/qcom/{qcom-geni-se,rpmh-rsc,cmd-db}.c,
+ * drivers/clk/qcom/gcc-kona.c, drivers/pinctrl/qcom/pinctrl-kona.c, and the phone's own device tree (the
+ * /soc/spi@990000/touch_spi@0 serial engine, and /soc/ts_novatek for the chip itself).
+ */
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>           /* assert_wait, thread_block, thread_wakeup */
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include <sys/hakios.apollo_input.h>
+#include <sys/hakios.input.h>          /* hakios_touch_post(): the queue backboardd reads, shared */
+#include <sys/systm.h>
+
+extern void hakios_tl(const char *format, ...) __printflike(1, 2);
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern kern_return_t thread_terminate(thread_t thread);
+
+/*
+ * Every line goes to the loader's log directly as well (as in hakios.buttons.c): the kernel's own
+ * messages reach that log only when a run ends cleanly, and a phone that resets keeps only these.
+ */
+extern void loader_log_putc(char c);
+
+static int say(const char *format, ...) __printflike(1, 2);
+
+static int
+say(const char *format, ...)
+{
+	char line[400];
+	va_list list;
+
+	va_start(list, format);
+	vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
+	for (const char *c = line; *c != 0; c++) {
+		loader_log_putc(*c);
+	}
+	return printf("%s", line);
+}
+#define printf say
+
+static vm_offset_t tlmm_north, tlmm_south_38, tlmm_south_69, gcc, se;
+
+static inline uint32_t
+rd(vm_offset_t address)
+{
+	return *(volatile uint32_t *)address;
+}
+
+static inline void
+wr(vm_offset_t address, uint32_t value)
+{
+	*(volatile uint32_t *)address = value;
+}
+
+static void
+sleep_us(uint32_t us)
+{
+	delay_for_interval(us, NSEC_PER_USEC);
+}
+
+static void
+sleep_ms(uint32_t ms)
+{
+	delay_for_interval(ms, NSEC_PER_MSEC);
+}
+
+/* ---- pins (TLMM) -------------------------------------------------------------------------------- */
+
+/* The QUPv3 wrappers of the SC chip give serial engine 4 its four lines at gpio 8, 9, 10 and 11 (miso, mosi, clk,
+ * chip select); the chip's interrupt is gpio 39, its reset is gpio 38, and it takes its I/O supply on gpio 69. */
+/* The TLMM window is 16 MiB, twice the kernel's whole io_submap (ml_io_map of it panics): only the pages of
+ * the pins used are mapped, each pin's registers being one page of its tile. */
+#define TLMM_PHYS               0x0f000000UL
+#define TLMM_NORTH              0x00900000UL
+#define TLMM_SOUTH              0x00500000UL
+#define TLMM_PIN_PHYS(tile, n)  (TLMM_PHYS + (tile) + 0x1000UL * (n))
+#define GPIO_CFG(n)             pin_base(n)
+#define GPIO_IO(n)              (GPIO_CFG(n) + 4) /* bit 0 in, bit 1 out */
+#define GPIO_INTR_CFG(n)        (GPIO_CFG(n) + 8) /* pinctrl-kona.c: intr_cfg_reg */
+#define GPIO_INTR_STATUS(n)     (GPIO_CFG(n) + 0xc) /* bit 0: an edge was seen; written 0 to clear */
+#define INTR_ENABLE             (1u << 0)        /* on to the interrupt controller: left off */
+#define INTR_POLARITY_HIGH      (1u << 1)
+#define INTR_DETECT_EDGE        (1u << 2)        /* [3:2] 1: edge */
+#define INTR_DETECT_MASK        (3u << 2)
+#define INTR_RAW_STATUS         (1u << 4)        /* the status latches even with the enable bit off */
+#define PULL_NONE               0
+#define PULL_UP                 3
+#define PULL_DOWN              2
+
+#define PIN_MISO                8
+#define PIN_MOSI                9
+#define PIN_CLK                 10
+#define PIN_CS                  11
+#define PIN_INT                 39
+#define PIN_RESET               38
+#define PIN_VDDIO               69
+#define PIN_FUNCTION_SPI        1       /* "qup4" */
+
+static vm_offset_t
+pin_base(unsigned pin)
+{
+	if (pin >= PIN_MISO && pin <= PIN_CS) {
+		return tlmm_north + 0x1000UL * (pin - PIN_MISO);
+	}
+	if (pin == PIN_RESET || pin == PIN_INT) {
+		return tlmm_south_38 + 0x1000UL * (pin - PIN_RESET);
+	}
+	return tlmm_south_69;   /* PIN_VDDIO, the only other pin used */
+}
+
+static void
+gpio_configure(unsigned pin, unsigned function, unsigned pull, unsigned ma, bool output)
+{
+	wr(GPIO_CFG(pin), pull | function << 2 | (ma / 2 - 1) << 6 | (output ? 1u << 9 : 0));
+}
+
+static void
+gpio_set(unsigned pin, bool high)
+{
+	wr(GPIO_IO(pin), high ? 2 : 0);
+}
+
+static void
+gpio_output(unsigned pin, bool high, unsigned pull, unsigned ma)
+{
+	gpio_set(pin, high);            /* the level first, so that the pin never drives the wrong one */
+	gpio_configure(pin, 0, pull, ma, true);
+}
+
+/* ---- clocks (GCC, kona) -------------------------------------------------------------------------------- */
+
+#define GCC_PHYS                0x00100000UL
+#define GCC_SIZE                0x60000UL
+#define GCC_VOTE                (gcc + 0x52008)         /* the application processor's votes */
+/* spi@990000 is serial engine 4 of the first QUPv3 wrapper (qupv3_0_geni_se@9c0000): its clocks are wrap0's */
+#define VOTE_QUP0_CORE_2X       (1u << 9)
+#define VOTE_QUP0_CORE          (1u << 8)
+#define VOTE_QUP0_M_AHB         (1u << 6)
+#define VOTE_QUP0_S_AHB         (1u << 7)
+#define VOTE_QUP0_SE4           (1u << 14)             /* serial engine 4 is the fifth of the first group */
+#define GCC_QUP0_M_AHB_CBCR     (gcc + 0x17004)         /* bit 31: the clock is off */
+#define GCC_QUP0_S_AHB_CBCR     (gcc + 0x17008)
+#define GCC_QUP0_SE4_CBCR       (gcc + 0x174cc)
+#define GCC_QUP0_SE4_CMD        (gcc + 0x174d0)         /* bit 0: take the new configuration */
+#define GCC_QUP0_SE4_CFG        (gcc + 0x174d4)         /* [4:0] 2*divider-1, [10:8] source, [13:12] mode */
+#define GCC_QUP0_SE4_DFSR       (gcc + 0x174e4)         /* bit 0: the engine chooses among preset rates itself */
+#define GCC_QUP0_SE4_PERF_CFG(l) (gcc + 0x174ec + 4 * (l))
+#define GCC_QUP0_SE4_PERF_M(l)  (gcc + 0x1752c + 4 * (l))
+#define GCC_QUP0_SE4_PERF_N(l)  (gcc + 0x1756c + 4 * (l))
+#define CLOCK_OFF               (1u << 31)
+#define CLOCK_HW_CTL            (1u << 1)               /* gated by the hardware: CLOCK_OFF says only "idle now" */
+#define XO_HZ                   19200000
+
+static uint32_t se_source_hz, se_clock_select;
+
+static uint32_t
+rcg_rate(uint32_t cfg, uint32_t m, uint32_t not_n_minus_m)
+{
+	static const uint32_t parent[8] = { XO_HZ, 600000000, 0, 0, 0, 0, 300000000, 0 };
+	uint64_t hz = parent[cfg >> 8 & 7];
+	uint32_t divider = cfg & 0x1f, mode = cfg >> 12 & 3;
+
+	if (divider) {
+		hz = hz * 2 / (divider + 1);
+	}
+	if (mode) {
+		uint32_t n = (~not_n_minus_m & 0xffff) + (m & 0xffff);
+
+		if (n) {
+			hz = hz * (m & 0xffff) / n;
+		}
+	}
+	return (uint32_t)hz;
+}
+
+/* A branch's status, with CLOCK_OFF left out of a branch the hardware gates (Linux skips its check too) */
+static uint32_t
+branch_status(vm_offset_t cbcr)
+{
+	uint32_t value = rd(cbcr);
+
+	return (value & CLOCK_HW_CTL) ? value & ~CLOCK_OFF : value;
+}
+
+static bool
+clocks_on(void)
+{
+	apollo_gcc_vote(GCC_VOTE, VOTE_QUP0_CORE_2X | VOTE_QUP0_CORE | VOTE_QUP0_M_AHB | VOTE_QUP0_S_AHB);
+	if (rd(GCC_QUP0_SE4_DFSR) & 1) {
+		for (uint32_t level = 0; level < 8; level++) {
+			uint32_t hz = rcg_rate(rd(GCC_QUP0_SE4_PERF_CFG(level)), rd(GCC_QUP0_SE4_PERF_M(level)),
+			    rd(GCC_QUP0_SE4_PERF_N(level)));
+
+			if (hz >= 4000000 && (se_source_hz == 0 || hz < se_source_hz)) {
+				se_source_hz = hz;
+				se_clock_select = level;
+			}
+		}
+		if (se_source_hz == 0) {
+			printf("apollo: no usable preset clock rate\n");
+			return false;
+		}
+	} else {
+		wr(GCC_QUP0_SE4_CFG, (rd(GCC_QUP0_SE4_CFG) & ~0x371fu) | 1);
+		wr(GCC_QUP0_SE4_CMD, rd(GCC_QUP0_SE4_CMD) | 1);
+		for (int i = 0; i < 500 && (rd(GCC_QUP0_SE4_CMD) & 1); i++) {
+			sleep_us(10);
+		}
+		if (rd(GCC_QUP0_SE4_CMD) & 1) {
+			printf("apollo: the serial engine's clock does not take its configuration (%#x)\n", rd(GCC_QUP0_SE4_CMD));
+			return false;
+		}
+		se_source_hz = XO_HZ;
+		se_clock_select = 0;
+	}
+	apollo_gcc_vote(GCC_VOTE, VOTE_QUP0_SE4);
+	for (int i = 0; i < 1000; i++) {
+		if (!((rd(GCC_QUP0_M_AHB_CBCR) | branch_status(GCC_QUP0_S_AHB_CBCR) | rd(GCC_QUP0_SE4_CBCR)) & CLOCK_OFF)) {
+			return true;
+		}
+		sleep_us(10);
+	}
+	printf("apollo: clocks stay off: %#x %#x %#x\n", rd(GCC_QUP0_M_AHB_CBCR), rd(GCC_QUP0_S_AHB_CBCR),
+	    rd(GCC_QUP0_SE4_CBCR));
+	return false;
+}
+
+/* ---- SPI through the serial engine (GENI) ---------------------------------------------------------- */
+
+#define SE_PHYS                 0x00990000UL     /* the fifth serial engine of the first QUPv3 group */
+#define SE_SIZE                 0x4000UL
+#define GENI_FORCE_DEFAULT      (se + 0x020)
+#define GENI_OUTPUT_CTRL        (se + 0x024)
+#define GENI_CGC_CTRL           (se + 0x028)
+#define GENI_STATUS             (se + 0x040)    /* bit 0: a command is running */
+#define GENI_SER_M_CLK_CFG      (se + 0x048)    /* bit 0 enable, [15:4] divider */
+#define GENI_IF_DISABLE_RO      (se + 0x064)    /* bit 0: no FIFO interface */
+#define GENI_FW_REVISION_RO     (se + 0x068)    /* [15:8] protocol: 1 = SPI */
+#define GENI_CLK_SEL            (se + 0x07c)
+#define SPI_CPHA                (se + 0x224)
+#define SPI_LOOPBACK            (se + 0x22c)
+#define SPI_CPOL                (se + 0x230)
+#define SPI_DEMUX_OUTPUT_INV    (se + 0x24c)
+#define SPI_DEMUX_SEL           (se + 0x250)
+#define GENI_BYTE_GRAN          (se + 0x254)
+#define GENI_DMA_MODE_EN        (se + 0x258)
+#define SPI_TRANS_CFG           (se + 0x25c)
+#define GENI_TX_PACKING_CFG0    (se + 0x260)
+#define GENI_TX_PACKING_CFG1    (se + 0x264)
+#define SPI_WORD_LEN            (se + 0x268)
+#define SPI_TX_TRANS_LEN        (se + 0x26c)
+#define SPI_RX_TRANS_LEN        (se + 0x270)
+#define SPI_DELAY_COUNTERS      (se + 0x278)
+#define GENI_RX_PACKING_CFG0    (se + 0x284)
+#define GENI_RX_PACKING_CFG1    (se + 0x288)
+#define GENI_M_CMD0             (se + 0x600)    /* [31:27] operation */
+#define GENI_M_CMD_CTRL         (se + 0x604)    /* bit 2 cancel, bit 1 abort */
+#define GENI_M_IRQ_STATUS       (se + 0x610)
+#define GENI_M_IRQ_EN           (se + 0x614)
+#define GENI_M_IRQ_CLEAR        (se + 0x618)
+#define GENI_S_IRQ_CLEAR        (se + 0x648)
+#define GENI_TX_FIFO            (se + 0x700)
+#define GENI_RX_FIFO            (se + 0x780)
+#define GENI_TX_FIFO_STATUS     (se + 0x800)    /* [27:0] words */
+#define GENI_RX_FIFO_STATUS     (se + 0x804)    /* bit 31 last, [30:28] bytes of the last word, [24:0] words */
+#define GENI_TX_WATERMARK       (se + 0x80c)
+#define GENI_RX_WATERMARK       (se + 0x810)
+#define GENI_RX_RFR_WATERMARK   (se + 0x814)
+#define SE_DMA_TX_IRQ_CLR       (se + 0xc44)
+#define SE_DMA_RX_IRQ_CLR       (se + 0xd44)
+#define SE_GSI_EVENT_EN         (se + 0xe18)
+#define SE_IRQ_EN               (se + 0xe1c)
+#define SE_HW_PARAM_0           (se + 0xe24)    /* [21:16] FIFO depth in words */
+#define SE_DMA_GENERAL_CFG      (se + 0xe30)
+
+#define M_CMD_DONE              (1u << 0)
+#define M_CMD_CANCEL            (1u << 4)
+#define M_CMD_ABORT             (1u << 5)
+#define M_ERRORS                ((1u << 1) | (1u << 2) | (1u << 3) | (1u << 24) | (1u << 25) | (1u << 28) | (1u << 29))
+#define SPI_FULL_DUPLEX         (3u << 27)
+
+static uint32_t fifo_depth;
+
+static void geni_show_state(const char *when);
+
+static const char *
+geni_spi_init(uint32_t hz)
+{
+	uint32_t divider;
+
+	if ((rd(GENI_FW_REVISION_RO) >> 8 & 0xff) != 1) {
+		return "the serial engine has no SPI firmware";
+	}
+	if (rd(GENI_IF_DISABLE_RO) & 1) {
+		return "the serial engine's FIFO interface is disabled";
+	}
+	fifo_depth = rd(SE_HW_PARAM_0) >> 16 & 0x3f;
+	if (fifo_depth < 4) {
+		return "the serial engine reports no FIFO";
+	}
+	wr(SE_GSI_EVENT_EN, 0);
+	wr(GENI_M_IRQ_CLEAR, 0xffffffff);
+	wr(GENI_S_IRQ_CLEAR, 0xffffffff);
+	wr(SE_DMA_TX_IRQ_CLR, 0xffffffff);
+	wr(SE_DMA_RX_IRQ_CLR, 0xffffffff);
+	wr(GENI_CGC_CTRL, rd(GENI_CGC_CTRL) | 0x7f);
+	wr(SE_DMA_GENERAL_CFG, rd(SE_DMA_GENERAL_CFG) | 0xf);
+	wr(GENI_OUTPUT_CTRL, 0x7f);
+	wr(GENI_FORCE_DEFAULT, 1);
+	wr(GENI_DMA_MODE_EN, rd(GENI_DMA_MODE_EN) & ~1u);
+	wr(GENI_RX_WATERMARK, fifo_depth - 3);
+	wr(GENI_RX_RFR_WATERMARK, fifo_depth - 2);
+	wr(GENI_TX_WATERMARK, 0);
+	wr(SE_IRQ_EN, rd(SE_IRQ_EN) | 0xf);
+	wr(GENI_M_IRQ_EN, rd(GENI_M_IRQ_EN) | 0x7fc0007f);
+	wr(SPI_LOOPBACK, 0);
+	wr(SPI_DEMUX_SEL, 0);
+	wr(SPI_CPHA, 0);
+	wr(SPI_CPOL, 0);
+	wr(SPI_DEMUX_OUTPUT_INV, 0);
+	wr(SPI_TRANS_CFG, rd(SPI_TRANS_CFG) & ~2u);
+	wr(SPI_DELAY_COUNTERS, 0);
+	wr(GENI_TX_PACKING_CFG0, 0x0007f8fe);
+	wr(GENI_TX_PACKING_CFG1, 0x000ffefe);
+	wr(GENI_RX_PACKING_CFG0, 0x0007f8fe);
+	wr(GENI_RX_PACKING_CFG1, 0x000ffefe);
+	wr(GENI_BYTE_GRAN, 0);
+	wr(SPI_WORD_LEN, 8 - 4);
+	divider = (se_source_hz + hz - 1) / hz;
+	wr(GENI_CLK_SEL, se_clock_select & 7);
+	wr(GENI_SER_M_CLK_CFG, (divider ? divider : 1) << 4 | 1);
+	geni_show_state("set up");
+	return NULL;
+}
+
+/* What the serial engine says of itself: enough to tell a stuck command, a full FIFO and the wrong mode apart */
+static void
+geni_show_state(const char *when)
+{
+	printf("apollo: engine, %s: status %#x, m_irq %#x/%#x, cmd %#x, tx fifo %#x, rx fifo %#x, fifo depth %u "
+	    "(hw param %#x), fw %#x, if-disable %#x, dma mode %#x, clk cfg %#x sel %#x\n", when, rd(GENI_STATUS),
+	    rd(GENI_M_IRQ_STATUS), rd(GENI_M_IRQ_EN), rd(GENI_M_CMD0), rd(GENI_TX_FIFO_STATUS), rd(GENI_RX_FIFO_STATUS),
+	    fifo_depth, rd(SE_HW_PARAM_0), rd(GENI_FW_REVISION_RO), rd(GENI_IF_DISABLE_RO), rd(GENI_DMA_MODE_EN),
+	    rd(GENI_SER_M_CLK_CFG), rd(GENI_CLK_SEL));
+}
+
+static void
+geni_drain(uint8_t *rx, uint32_t length, uint32_t *received)
+{
+	uint32_t status = rd(GENI_RX_FIFO_STATUS), words = status & 0x01ffffff, bytes = words * 4;
+
+	if (status & 0x80000000u) {
+		uint32_t valid = status >> 28 & 7;
+
+		if (valid && valid < 4) {
+			bytes -= 4 - valid;
+		}
+	}
+	for (uint32_t i = 0; i < words; i++) {
+		uint32_t word = rd(GENI_RX_FIFO);
+
+		for (int j = 0; j < 4 && bytes; j++, bytes--) {
+			if (*received < length) {
+				if (rx) {
+					rx[*received] = (uint8_t)(word >> (8 * j));
+				}
+				(*received)++;
+			}
+		}
+	}
+}
+
+static void
+geni_recover(void)
+{
+	wr(GENI_M_CMD_CTRL, 1u << 2);
+	for (int i = 0; i < 2000 && !(rd(GENI_M_IRQ_STATUS) & M_CMD_CANCEL); i++) {
+		sleep_us(100);
+	}
+	if (!(rd(GENI_M_IRQ_STATUS) & M_CMD_CANCEL)) {
+		wr(GENI_M_CMD_CTRL, 1u << 1);
+		for (int i = 0; i < 2000 && !(rd(GENI_M_IRQ_STATUS) & M_CMD_ABORT); i++) {
+			sleep_us(100);
+		}
+	}
+	for (int i = 0; i < 64 && (rd(GENI_RX_FIFO_STATUS) & 0x01ffffff); i++) {
+		(void)rd(GENI_RX_FIFO);
+	}
+	wr(GENI_M_IRQ_CLEAR, 0xffffffff);
+}
+
+/* One transfer with the chip selected throughout: `length` bytes out (zeros without tx) and as many in. */
+static bool
+geni_transfer(const uint8_t *tx, uint8_t *rx, uint32_t length)
+{
+	static unsigned complaints;
+	uint32_t sent = 0, received = 0, status = 0;
+	uint64_t deadline;
+
+	for (int i = 0; rd(GENI_STATUS) & 1; i++) {
+		if (i > 2000) {
+			geni_recover();
+			break;
+		}
+		sleep_us(100);
+	}
+	wr(GENI_M_IRQ_CLEAR, 0xffffffff);
+	wr(SPI_TX_TRANS_LEN, length);
+	wr(SPI_RX_TRANS_LEN, length);
+	wr(GENI_M_CMD0, SPI_FULL_DUPLEX);
+	clock_interval_to_deadline(200, NSEC_PER_MSEC, &deadline);
+	while (mach_absolute_time() < deadline) {
+		while (sent < length && (rd(GENI_TX_FIFO_STATUS) & 0x0fffffff) + 1 < fifo_depth) {
+			uint32_t word = 0;
+
+			for (int j = 0; j < 4 && sent < length; j++, sent++) {
+				word |= (uint32_t)(tx ? tx[sent] : 0) << (8 * j);
+			}
+			wr(GENI_TX_FIFO, word);
+		}
+		status = rd(GENI_M_IRQ_STATUS);
+		geni_drain(rx, length, &received);
+		if (status & M_ERRORS) {
+			break;
+		}
+		if (status & M_CMD_DONE) {
+			geni_drain(rx, length, &received);
+			wr(GENI_M_IRQ_CLEAR, status);
+			if (received == length) {
+				return true;
+			}
+			break;
+		}
+	}
+	if (complaints == 0) {
+		geni_show_state("first failed transfer");
+	}
+	if (complaints++ < 8) {
+		printf("apollo: SPI transfer of %u bytes failed: status %#x, sent %u, received %u\n", length, status, sent,
+		    received);
+	}
+	geni_recover();
+	return false;
+}
+
+static bool (*spi_transfer)(const uint8_t *tx, uint8_t *rx, uint32_t length);
+
+#define NVT_EVENT_BUF_ADDR          0x22d00
+#define NVT_EVENT_FWINFO           0x78
+#define NVT_EVENT_RESET_COMPLETE   0x60
+#define NVT_EVENT_PROJECTID        0x9a
+#define NVT_EVENT_MAP_HOST_CMD     0x50
+#define NVT_EVENT_MAP_HANDSHAKING 0x51
+#define NVT_RESET_STATE_INIT      0xa0
+#define NVT_RESET_STATE_MAX       0xaf
+#define NVT_POINT_DATA_LEN        65
+#define NVT_MAX_TOUCHES           10
+#define NVT_SW_RST_ADDR           0x3f0fe
+#define NVT_SPI_RD_FAST_ADDR      0x3f310
+
+/* one transfer's bytes: a whole touch report (NVT_POINT_DATA_LEN + 1) and its two framing bytes fit */
+static uint8_t spi_tx[80], spi_rx[80];
+static uint32_t max_x = 10800, max_y = 24000;
+static uint32_t nvt_abs_x_max, nvt_abs_y_max;
+static bool apollo_touch_verbose = true;
+
+static bool
+nvt_set_page(uint32_t addr)
+{
+	uint8_t buffer[3];
+
+	buffer[0] = 0xff;
+	buffer[1] = (addr >> 15) & 0xff;
+	buffer[2] = (addr >> 7) & 0xff;
+	for (uint32_t i = 0; i < 3; i++) {
+		spi_tx[i] = buffer[i];
+	}
+	return spi_transfer(spi_tx, spi_rx, 3);
+}
+
+/*
+ * data[0] is the first byte after the address: Linux's buffers keep the address in [0], so its buf[n] is data[n - 1]
+ * here.
+ */
+static bool
+nvt_read(uint32_t addr, uint8_t *data, uint32_t length)
+{
+	uint32_t frames = length + 2;
+
+	for (uint32_t i = 0; i < frames; i++) {
+		spi_tx[i] = (uint8_t)((i == 0) ? (addr & 0x7f) : 0);
+	}
+	if (!spi_transfer(spi_tx, spi_rx, frames)) {
+		return false;
+	}
+	for (uint32_t i = 0; i < length; i++) {
+		data[i] = spi_rx[i + 2];
+	}
+	return true;
+}
+
+static struct {
+	uint32_t polls, reports, touches, bad, last_x, last_y, edges, released, wdt, esd, reloads;
+} seen;
+
+static struct {
+	bool down, seen;
+	uint32_t x, y;
+} contact[NVT_MAX_TOUCHES];
+static uint64_t fingers_at;     /* when a report last had a finger in it */
+
+/* every finger still down is lifted: for when the reports that would have said so did not come */
+static void
+apollo_release_all(void)
+{
+	for (uint32_t id = 0; id < NVT_MAX_TOUCHES; id++) {
+		if (contact[id].down) {
+			contact[id].down = false;
+			hakios_touch_post(HAKIOS_TOUCH_UP, id, contact[id].x, contact[id].y);
+			seen.released++;
+		}
+	}
+}
+
+static bool
+apollo_any_down(void)
+{
+	for (uint32_t id = 0; id < NVT_MAX_TOUCHES; id++) {
+		if (contact[id].down) {
+			return true;
+		}
+	}
+	return false;
+}
+static uint32_t flip;   /* boot-arg touch_flip: 1 = mirror left-right, 2 = mirror top-bottom */
+
+static void
+apollo_nvt_report(const uint8_t *data, uint32_t blocks)
+{
+	static unsigned shown;
+	bool moved = false;
+
+	/* a finger that this report leaves out has been lifted (as in Linux's nvt_ts_work_func) */
+	for (uint32_t id = 0; id < NVT_MAX_TOUCHES; id++) {
+		contact[id].seen = false;
+	}
+	for (uint32_t i = 0; i < blocks; i++) {
+		const uint8_t *t = data + 6 * i;
+		uint32_t id = t[0] >> 3, status = t[0] & 0x7;
+
+		if (id == 0 || id > NVT_MAX_TOUCHES) {
+			continue;
+		}
+		if (status != 1 && status != 2) {
+			if (contact[id - 1].down) {
+				contact[id - 1].down = false;
+				hakios_touch_post(HAKIOS_TOUCH_UP, id - 1, contact[id - 1].x, contact[id - 1].y);
+			}
+			continue;
+		}
+		uint32_t x = ((uint32_t)t[1] << 4) + (uint32_t)(t[3] >> 4);
+		uint32_t y = ((uint32_t)t[2] << 4) + (uint32_t)(t[3] & 0xf);
+
+		if (x > nvt_abs_x_max || y > nvt_abs_y_max) {
+			continue;
+		}
+		uint32_t sx = x >= max_x ? 65535 : x * 65535 / max_x;
+		uint32_t sy = y >= max_y ? 65535 : y * 65535 / max_y;
+		if (flip & 1) {
+			sx = 65535 - sx;
+		}
+		if (flip & 2) {
+			sy = 65535 - sy;
+		}
+		seen.touches++;
+		fingers_at = mach_absolute_time();
+		seen.last_x = sx;
+		seen.last_y = sy;
+		contact[id - 1].seen = true;
+		if (!contact[id - 1].down) {
+			contact[id - 1].down = true;
+			contact[id - 1].x = sx;
+			contact[id - 1].y = sy;
+			hakios_touch_post(HAKIOS_TOUCH_DOWN, id - 1, sx, sy);
+			/* (a second finger: whether the chip reports one at all; the first few are told) */
+			if (shown < 20) {
+				uint32_t down = 0;
+
+				for (uint32_t n = 0; n < NVT_MAX_TOUCHES; n++) {
+					down += contact[n].down;
+				}
+				if (down > 1 || id > 1) {
+					shown++;
+					say("apollo touch: finger %u down (%u down now), report byte %#x\n", id, down, t[0]);
+				}
+			}
+		} else if (contact[id - 1].x != sx || contact[id - 1].y != sy) {
+			hakios_touch_post(HAKIOS_TOUCH_MOVE, id - 1, sx, sy);
+			moved = true;
+			contact[id - 1].x = sx;
+			contact[id - 1].y = sy;
+		}
+	}
+	for (uint32_t id = 0; id < NVT_MAX_TOUCHES; id++) {
+		if (contact[id].down && !contact[id].seen) {
+			contact[id].down = false;
+			hakios_touch_post(HAKIOS_TOUCH_UP, id, contact[id].x, contact[id].y);
+		}
+	}
+	apollo_hitch_touch(apollo_any_down(), moved);   /* (apollo_hitch=1: a gap between frames counts only while a finger moves) */
+}
+
+/* ---- the chip's firmware -------------------------------------------------------------------------- */
+
+/*
+ * The NT36675 has no flash: it waits in its boot code until the host has put its firmware in its memory, after
+ * every reset of the panel (Android's driver does it at each screen-on). This is Linux's
+ * nvt_download_firmware_hw_crc (Xiaomi's apollo kernel, drivers/input/touchscreen/nt36672c/nt36xxx_fw_update.c),
+ * with the NT36675's memory map (nt36xxx_mem_map.h: hw_crc 2). The file is the phone's own, built into its
+ * Android kernel; it comes in fw/ of the small image (fw-touch/ when the image is built).
+ */
+#define NVT_FW_NAME             "novatek_nt36675_j3s_fw01.bin"
+#define NVT_BOOT_RDY_ADDR       0x3f10d
+#define NVT_ILM_LENGTH_ADDR     0x3f118
+#define NVT_DLM_LENGTH_ADDR     0x3f130
+#define NVT_ILM_DES_ADDR        0x3f128
+#define NVT_DLM_DES_ADDR        0x3f12c
+#define NVT_G_ILM_CHECKSUM_ADDR 0x3f100
+#define NVT_G_DLM_CHECKSUM_ADDR 0x3f104
+#define NVT_R_ILM_CHECKSUM_ADDR 0x3f120
+#define NVT_R_DLM_CHECKSUM_ADDR 0x3f124
+#define NVT_BLD_CRC_EN_ADDR     0x3f30e
+#define NVT_BLD_ILM_DLM_CRC_ADDR 0x3f133
+#define NVT_RESET_STATE_REK     0xa1
+#define NVT_MAX_PARTITIONS      32
+#define NVT_WRITE_CHUNK         1024
+
+extern const uint8_t *hakios_image_file(const char *dir, const char *name, uint64_t *size, int *disk_out);
+
+static uint8_t nvt_write_buffer[NVT_WRITE_CHUNK + 1];
+
+/* `length` bytes to the chip's memory at `addr`: the address byte with its write bit, then the data */
+static bool
+nvt_write(uint32_t addr, const uint8_t *data, uint32_t length)
+{
+	while (length > 0) {
+		uint32_t n = length < NVT_WRITE_CHUNK ? length : NVT_WRITE_CHUNK;
+
+		if (!nvt_set_page(addr)) {
+			return false;
+		}
+		nvt_write_buffer[0] = (uint8_t)((addr & 0x7f) | 0x80);
+		memcpy(nvt_write_buffer + 1, data, n);
+		if (!spi_transfer(nvt_write_buffer, NULL, n + 1)) {
+			return false;
+		}
+		addr += n;
+		data += n;
+		length -= n;
+	}
+	return true;
+}
+
+static bool
+nvt_write_byte(uint32_t addr, uint8_t value)
+{
+	return nvt_write(addr, &value, 1);
+}
+
+static bool
+nvt_read_at(uint32_t addr, uint8_t *data, uint32_t length)
+{
+	return nvt_set_page(addr) && nvt_read(addr, data, length);
+}
+
+static uint32_t
+le32(const uint8_t *p)
+{
+	return p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+static struct {
+	uint32_t bin, sram, size, crc;
+} nvt_part[NVT_MAX_PARTITIONS];
+static uint32_t nvt_parts;
+
+/* nvt_bin_header_parser: ILM and DLM first, then the info sections from 0x30, then the DLM's overlays */
+static const char *
+nvt_parse_firmware(const uint8_t *fw, uint64_t size)
+{
+	uint32_t end, info, overlays;
+
+	if (size < 0x20000 || memcmp(fw + 0x20000 - 3, "NVT", 3) != 0) {
+		return "has no \"NVT\" end flag at 128 KiB";
+	}
+	if (fw[0x20000 - 0x1000] + fw[0x20000 - 0x1000 + 1] != 0xff) {
+		return "has a broken version";
+	}
+	/* (the info sections run from 0x30 to `end`: within the file, or the file is not believed) */
+	end = le32(fw);
+	if (end > size) {
+		return "has a section table beyond its end";
+	}
+	info = end > 0x30 ? (uint32_t)(((uint64_t)end - 0x30 + 0xf) / 0x10) : 0;
+	overlays = (fw[0x28] & 0x10) ? (fw[0x28] & 0x0f) : 0;
+	nvt_parts = 2 + info + overlays;
+	if (nvt_parts > NVT_MAX_PARTITIONS) {
+		return "has too many sections";
+	}
+	for (uint32_t i = 0; i < nvt_parts; i++) {
+		if (i < 2) {
+			nvt_part[i].bin = le32(fw + 12 * i);
+			nvt_part[i].sram = le32(fw + 12 * i + 4);
+			nvt_part[i].size = le32(fw + 12 * i + 8);
+			nvt_part[i].crc = le32(fw + 0x18 + 4 * i);
+		} else {
+			/* (in 64 bits: an overlay's place comes from DLM's offset, which the file says, sized or not) */
+			uint64_t pos = i < 2 + info ? 0x30 + 0x10 * (uint64_t)(i - 2) :
+			    (uint64_t)nvt_part[1].bin + 0x10 * (uint64_t)(i - 2 - info);
+
+			if (pos + 16 > size) {
+				return "has a section table beyond its end";
+			}
+			nvt_part[i].sram = le32(fw + pos);
+			nvt_part[i].size = le32(fw + pos + 4);
+			nvt_part[i].bin = le32(fw + pos + 8);
+			nvt_part[i].crc = le32(fw + pos + 12);
+		}
+		/* the sections are written one byte longer than they say (nvt_write_firmware) */
+		if (nvt_part[i].size != 0 && (uint64_t)nvt_part[i].bin + nvt_part[i].size + 1 > size) {
+			return "has a section beyond its end";
+		}
+	}
+	return NULL;
+}
+
+static bool
+nvt_reset_state(uint8_t at_least, int tries, uint8_t *seen)
+{
+	uint8_t status[6];
+
+	for (int i = 0; i < tries; i++) {
+		if (!nvt_read_at(NVT_EVENT_BUF_ADDR | NVT_EVENT_RESET_COMPLETE, status, 6)) {
+			return false;
+		}
+		*seen = status[0];
+		if (status[0] >= at_least && status[0] <= NVT_RESET_STATE_MAX) {
+			return true;
+		}
+		sleep_ms(10);
+	}
+	return false;
+}
+
+/* the address, length and expected checksum of ILM or DLM, for the boot code's own check (nvt_set_bld_crc_bank) */
+static bool
+nvt_crc_bank(uint32_t des, uint32_t length_addr, uint32_t checksum_addr, uint32_t part)
+{
+	uint8_t a[3] = { (uint8_t)nvt_part[part].sram, (uint8_t)(nvt_part[part].sram >> 8), (uint8_t)(nvt_part[part].sram >> 16) };
+	uint8_t l[3] = { (uint8_t)nvt_part[part].size, (uint8_t)(nvt_part[part].size >> 8), (uint8_t)(nvt_part[part].size >> 16 & 1) };
+	uint8_t c[4] = { (uint8_t)nvt_part[part].crc, (uint8_t)(nvt_part[part].crc >> 8), (uint8_t)(nvt_part[part].crc >> 16),
+		         (uint8_t)(nvt_part[part].crc >> 24) };
+
+	return nvt_write(des, a, 3) && nvt_write(length_addr, l, 3) && nvt_write(checksum_addr, c, 4);
+}
+
+static bool
+nvt_download_firmware(const uint8_t *fw)
+{
+	uint8_t state = 0, flag;
+
+	for (int attempt = 1; attempt <= 3; attempt++) {
+		/* the boot code's reset (nvt_bootloader_reset), with the fast read mode off */
+		if (!nvt_write_byte(NVT_SW_RST_ADDR, 0x69)) {
+			return false;
+		}
+		sleep_ms(5);
+		nvt_write_byte(NVT_SPI_RD_FAST_ADDR, 0x00);
+
+		for (uint32_t i = 0; i < nvt_parts; i++) {
+			if (nvt_part[i].size != 0 && !nvt_write(nvt_part[i].sram, fw + nvt_part[i].bin, nvt_part[i].size + 1)) {
+				printf("apollo: touch firmware: writing section %u failed\n", i);
+				return false;
+			}
+		}
+		nvt_crc_bank(NVT_ILM_DES_ADDR, NVT_ILM_LENGTH_ADDR, NVT_G_ILM_CHECKSUM_ADDR, 0);
+		nvt_crc_bank(NVT_DLM_DES_ADDR, NVT_DLM_LENGTH_ADDR, NVT_G_DLM_CHECKSUM_ADDR, 1);
+		/* the boot code checks ILM and DLM itself (nvt_bld_crc_enable) */
+		if (nvt_read_at(NVT_BLD_CRC_EN_ADDR, &flag, 1)) {
+			nvt_write_byte(NVT_BLD_CRC_EN_ADDR, flag | 0x80);
+		}
+		/* the firmware's reset status cleared, its own check on (nvt_fw_crc_enable) */
+		nvt_write_byte(NVT_EVENT_BUF_ADDR | NVT_EVENT_RESET_COMPLETE, 0x00);
+		nvt_write_byte(NVT_EVENT_BUF_ADDR | NVT_EVENT_MAP_HOST_CMD, 0xae);
+		/* and go (nvt_boot_ready) */
+		nvt_write_byte(NVT_BOOT_RDY_ADDR, 1);
+		sleep_ms(5);
+		if (nvt_reset_state(NVT_RESET_STATE_INIT, 11, &state)) {
+			printf("apollo: touch firmware loaded (%u sections; attempt %d), reset state %#x\n", nvt_parts, attempt, state);
+			return true;
+		}
+		printf("apollo: touch firmware: no reset state after attempt %d (%#x)\n", attempt, state);
+	}
+	{
+		uint8_t crc_flag = 0, r[8] = { 0 };
+
+		nvt_read_at(NVT_BLD_ILM_DLM_CRC_ADDR, &crc_flag, 1);
+		nvt_read_at(NVT_R_ILM_CHECKSUM_ADDR, r, 8);
+		printf("apollo: touch firmware: crc done %u, ilm %u, dlm %u; ilm %#x (file %#x), dlm %#x (file %#x)\n",
+		    crc_flag >> 2 & 1, crc_flag & 1, crc_flag >> 1 & 1, le32(r), nvt_part[0].crc, le32(r + 4), nvt_part[1].crc);
+	}
+	return false;
+}
+
+static const uint8_t *nvt_file;    /* kept for a reload (Linux's ESD and watchdog recoveries) */
+
+static bool
+apollo_novatek_probe(void)
+{
+	uint8_t fw[17], state = 0;
+	uint64_t size = 0;
+	const uint8_t *file = hakios_image_file("fw", NVT_FW_NAME, &size, NULL);
+
+	nvt_file = file;
+	const char *problem;
+
+	if (file == NULL) {
+		printf("apollo: no fw/" NVT_FW_NAME " in the small image (fw-touch/ when it is built)\n");
+		return false;
+	}
+	problem = nvt_parse_firmware(file, size);
+	if (problem != NULL) {
+		printf("apollo: " NVT_FW_NAME " %s\n", problem);
+		return false;
+	}
+	if (!nvt_download_firmware(file)) {
+		return false;
+	}
+
+	if (!nvt_read_at(NVT_EVENT_BUF_ADDR | NVT_EVENT_FWINFO, fw, 17)) {
+		return false;
+	}
+	if ((fw[0] + fw[1]) != 0xff) {
+		if (apollo_touch_verbose) {
+			printf("apollo: the touch firmware version read %02x %02x\n", fw[0], fw[1]);
+		}
+		return false;
+	}
+	nvt_abs_x_max = ((uint32_t)fw[4] << 8) | fw[5];
+	nvt_abs_y_max = ((uint32_t)fw[6] << 8) | fw[7];
+	max_x = nvt_abs_x_max;
+	max_y = nvt_abs_y_max;
+	if (apollo_touch_verbose) {
+		printf("apollo: touch firmware version %02x, geometry %u x %u\n", fw[0], max_x, max_y);
+	}
+
+	/* the baseline (nvt_ts_resume waits for it too), then the page of the reports stays selected */
+	if (!nvt_reset_state(NVT_RESET_STATE_REK, 50, &state)) {
+		printf("apollo: the touch firmware has no baseline yet (reset state %#x)\n", state);
+	}
+	return nvt_set_page(NVT_EVENT_BUF_ADDR);
+}
+
+static void
+apollo_touch_show_state(const char *when)
+{
+	printf("apollo: %s: votes %#x, clocks %#x %#x %#x, rate cfg %#x dfs %#x; pins cs/miso/mosi/clk cfg %#x %#x %#x %#x,"
+	    " reset %#x/%u, int %#x/%u, vddio %#x/%u\n", when, rd(GCC_VOTE), rd(GCC_QUP0_M_AHB_CBCR),
+	    rd(GCC_QUP0_S_AHB_CBCR), rd(GCC_QUP0_SE4_CBCR), rd(GCC_QUP0_SE4_CFG), rd(GCC_QUP0_SE4_DFSR), rd(GPIO_CFG(PIN_CS)),
+	    rd(GPIO_CFG(PIN_MISO)), rd(GPIO_CFG(PIN_MOSI)), rd(GPIO_CFG(PIN_CLK)), rd(GPIO_CFG(PIN_RESET)),
+	    rd(GPIO_IO(PIN_RESET)), rd(GPIO_CFG(PIN_INT)), rd(GPIO_IO(PIN_INT)), rd(GPIO_CFG(PIN_VDDIO)), rd(GPIO_IO(PIN_VDDIO)));
+}
+
+/*
+ * The screen follows iOS (apollo_backlight_power -> apollo_touch_screen): the caller only records the wanted state and
+ * wakes the thread, which does the SPI work. A request that comes before the thread has started (or without a touch
+ * thread at all) is kept: the thread's loop looks at the wanted state first, so a screen switched off before the touch
+ * was up puts the chip to sleep as soon as it is.
+ */
+static volatile bool touch_screen_wanted = true;
+
+void
+apollo_touch_screen(bool on)
+{
+	touch_screen_wanted = on;
+	thread_wakeup((event_t)&touch_screen_wanted);
+}
+
+/* nvt_ts_suspend: the deep-sleep command, then no more reports are read until the screen is on again */
+static void
+apollo_touch_sleep(void)
+{
+	apollo_release_all();
+	sleep_ms(10);                           /* nvt_ts_suspend: mdelay(10) before the command */
+	/* nvt_ts_suspend (no gesture wake): buf[0] = EVENT_MAP_HOST_CMD, buf[1] = 0x11 "deep sleep mode" */
+	bool ok = nvt_write_byte(NVT_EVENT_BUF_ADDR | NVT_EVENT_MAP_HOST_CMD, 0x11);
+
+	sleep_ms(10);                           /* nvt_ts_suspend: mdelay(10) after it */
+	say("apollo touch: the screen is off, the chip is put to sleep%s\n", ok ? "" : " (the command failed)");
+}
+
+/*
+ * nvt_ts_resume: the reset line high (the panel's reset has reset the chip), the firmware downloaded again
+ * (nvt_update_firmware, which starts with the boot code's reset), then the wait for the baseline (RESET_STATE_REK).
+ */
+static void
+apollo_touch_wake(void)
+{
+	uint8_t state = 0;
+	bool ok = false;
+
+	for (int attempt = 1; attempt <= 2 && !ok; attempt++) {
+		/*
+		 * The vendor only raises the line: on Android the panel's own power cycle has reset the chip by then. Here the panel
+		 * stays powered with the light off, so a second attempt pulses the line low first.
+		 */
+		if (attempt == 2) {
+			gpio_output(PIN_RESET, false, PULL_UP, 8);
+			sleep_ms(10);
+		}
+		gpio_output(PIN_RESET, true, PULL_UP, 8);       /* nvt_ts_resume: gpio_set_value(ts->reset_gpio, 1) */
+		if (attempt == 2) {
+			sleep_ms(10);
+		}
+		if (nvt_file == NULL || !nvt_download_firmware(nvt_file)) {
+			say("apollo touch: the firmware could not be loaded on wake (attempt %d)\n", attempt);
+			continue;
+		}
+		/* nvt_ts_resume: nvt_check_fw_reset_state(RESET_STATE_REK) */
+		if (!nvt_reset_state(NVT_RESET_STATE_REK, 50, &state)) {
+			say("apollo touch: no baseline after the wake (reset state %#x, attempt %d)\n", state, attempt);
+			continue;
+		}
+		ok = true;
+	}
+	nvt_set_page(NVT_EVENT_BUF_ADDR);       /* the page of the reports stays selected */
+	say("apollo touch: the screen is on, the chip is %s\n", ok ? "awake" : "not confirmed awake; polling anyway");
+}
+
+static void
+apollo_touch_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	static uint8_t report[NVT_POINT_DATA_LEN + 1];
+	uint32_t poll_us = 8000;
+
+	PE_parse_boot_argn("touch_poll_us", &poll_us, sizeof(poll_us));
+	if (poll_us < 250 || poll_us > 100000) {
+		poll_us = 8000;
+	}
+	printf("apollo: touch thread started: map the pins, the clock controller and serial engine 4\n");
+	tlmm_north = ml_io_map(TLMM_PIN_PHYS(TLMM_NORTH, PIN_MISO), 0x4000);           /* pins 8 to 11 */
+	tlmm_south_38 = ml_io_map(TLMM_PIN_PHYS(TLMM_SOUTH, PIN_RESET), 0x2000);       /* pins 38 and 39 */
+	tlmm_south_69 = ml_io_map(TLMM_PIN_PHYS(TLMM_SOUTH, PIN_VDDIO), 0x1000);
+	gcc = ml_io_map(GCC_PHYS, GCC_SIZE);
+	se = ml_io_map(SE_PHYS, SE_SIZE);
+	if (tlmm_north == 0 || tlmm_south_38 == 0 || tlmm_south_69 == 0 || gcc == 0 || se == 0) {
+		printf("apollo: cannot map TLMM/GCC/GENI registers\n");
+		thread_terminate(current_thread());
+		return;
+	}
+
+	bool clocks_ok = clocks_on();
+	if (!clocks_ok) {
+		printf("apollo: the clocks cannot be turned on\n");
+		thread_terminate(current_thread());
+		return;
+	}
+	apollo_touch_show_state("as found");
+	/* the reset line high and left so: the panel's own reset has reset the chip (nvt_ts_resume does no more) */
+	gpio_output(PIN_VDDIO, true, PULL_NONE, 2);
+	sleep_ms(20);
+	gpio_output(PIN_RESET, true, PULL_UP, 8);
+	sleep_ms(10);
+	apollo_touch_show_state("powered");
+	gpio_configure(PIN_MISO, PIN_FUNCTION_SPI, PULL_NONE, 6, false);
+	gpio_configure(PIN_MOSI, PIN_FUNCTION_SPI, PULL_NONE, 6, false);
+	gpio_configure(PIN_CLK, PIN_FUNCTION_SPI, PULL_NONE, 6, false);
+	gpio_configure(PIN_CS, PIN_FUNCTION_SPI, PULL_NONE, 6, true);
+	const char *problem = geni_spi_init(10000000);         /* touch_spi@0's spi-max-frequency */
+	if (problem != NULL) {
+		printf("apollo: %s\n", problem);
+		thread_terminate(current_thread());
+		return;
+	}
+	spi_transfer = geni_transfer;
+	if (apollo_novatek_probe()) {
+		/* the chip is up */
+	} else {
+		printf("apollo: no Novatek touch screen\n");
+		thread_terminate(current_thread());
+		return;
+	}
+	/*
+	 * The chip has a report ready when its interrupt line rises (the tree's irq-gpio: 39, rising edge). The TLMM
+	 * latches that edge for us without passing an interrupt on (raw status on, the enable bit off), and the latch
+	 * is looked at every millisecond: a report is read only then, never while the chip is writing the next one.
+	 * Until a first edge has been seen a report is read every 100 ms all the same; touch_int=0 reads on a timer.
+	 */
+	uint32_t use_int = 1;
+	uint64_t last_read = mach_absolute_time(), fallback, fallback_down;
+
+	PE_parse_boot_argn("touch_int", &use_int, sizeof(use_int));
+	nanoseconds_to_absolutetime(100 * NSEC_PER_MSEC, &fallback);
+	nanoseconds_to_absolutetime(15 * NSEC_PER_MSEC, &fallback_down);
+	if (use_int) {
+		uint32_t cfg = rd(GPIO_INTR_CFG(PIN_INT));
+
+		cfg &= ~(INTR_ENABLE | INTR_DETECT_MASK | INTR_POLARITY_HIGH);
+		wr(GPIO_INTR_CFG(PIN_INT), cfg | INTR_RAW_STATUS | INTR_DETECT_EDGE | INTR_POLARITY_HIGH);
+		wr(GPIO_INTR_STATUS(PIN_INT), 0);
+		printf("apollo: Novatek touch screen ready; a report is read when its interrupt line rises (cfg %#x)\n",
+		    rd(GPIO_INTR_CFG(PIN_INT)));
+	} else {
+		printf("apollo: Novatek touch screen ready; the report is read every %u us\n", poll_us);
+	}
+
+	uint64_t now, lifted, esd_quiet, status_every, status_at = mach_absolute_time(), edge_at = status_at, gap_long;
+	struct {
+		uint64_t since;                 /* the last report passed on */
+		bool down;                      /* a finger was down after it */
+		uint32_t reads, empty, failed, no_edge, edges, told;
+	} gap = { .since = status_at };
+
+	nanoseconds_to_absolutetime(100 * NSEC_PER_MSEC, &gap_long);
+	unsigned wdt_run = 0;
+	bool esd_pending = false;
+
+	/*
+	 * Measured (touch_lat=1, 25 October): while a finger is on the glass a report comes every 8 ms or so, and the one
+	 * that would say it has lifted does not come at all -- every tap of a run ended on this timer. At 150 ms a quick
+	 * second tap landed while the first was still down, as the same finger moving: the keyboard took the first key
+	 * as dragged to the second and wrote neither. 45 ms is five reports missed.
+	 */
+	nanoseconds_to_absolutetime(45 * NSEC_PER_MSEC, &lifted);
+	nanoseconds_to_absolutetime(1500 * NSEC_PER_MSEC, &esd_quiet);
+	nanoseconds_to_absolutetime(10 * NSEC_PER_SEC, &status_every);
+	for (;;) {
+		if (!touch_screen_wanted) {
+			apollo_touch_sleep();
+			/* no polling and no SPI traffic until the screen is on */
+			for (;;) {
+				assert_wait((event_t)&touch_screen_wanted, THREAD_UNINT);
+				if (touch_screen_wanted) {
+					clear_wait(current_thread(), THREAD_AWAKENED);
+					break;
+				}
+				thread_block(THREAD_CONTINUE_NULL);
+			}
+			apollo_touch_wake();
+			wdt_run = 0;
+			esd_pending = false;
+			if (use_int) {
+				wr(GPIO_INTR_STATUS(PIN_INT), 0);
+			}
+			last_read = edge_at = mach_absolute_time();
+		}
+		now = mach_absolute_time();
+		if (use_int) {
+			bool edge = rd(GPIO_INTR_STATUS(PIN_INT)) & 1;
+
+			/*
+			 * Without an edge, a look every 100 ms all the same: a missed edge must not leave a finger down. While a
+			 * finger is down, every 15 ms: measured (touch_lat=1), one tap in 17 was cut in two when a missed edge left
+			 * a gap of more than the 45 ms after which a finger counts as lifted.
+			 */
+			if (!edge && now - last_read < (apollo_any_down() ? fallback_down : fallback)) {
+				/* the chip reports all the time a finger is on the glass: none for 45 ms, and it is gone */
+				if (apollo_any_down() && now - fingers_at > lifted) {
+					apollo_release_all();
+				}
+				sleep_us(1000);
+				continue;
+			}
+			if (!edge) {
+				gap.no_edge++;
+			}
+			if (edge) {
+				gap.edges++;
+				wr(GPIO_INTR_STATUS(PIN_INT), 0);       /* before the read: an edge during it is the next report */
+				edge_at = now;
+				if (seen.edges++ == 0) {
+					printf("apollo: the first edge of the touch interrupt line: reports follow it from now on\n");
+				}
+			}
+			last_read = now;
+		}
+		seen.polls++;
+		/*
+		 * A gap between reports while a finger is down (the hitch tracer, 28 October: 409-479 ms without a report while a
+		 * finger moved, and no frame from iOS meanwhile): what the reads in it saw, said once the next report comes.
+		 */
+		gap.reads++;
+		if (!nvt_read(NVT_EVENT_BUF_ADDR, report, NVT_POINT_DATA_LEN + 1)) {
+			gap.failed++;
+			seen.bad++;
+			if (seen.bad < 8) {
+				printf("apollo: the touch report cannot be read\n");
+			}
+		} else {
+			bool wdt = true, esd = true;
+
+			seen.reports++;
+			/* Linux's two recoveries look at the first six bytes: 0xfd/0xfe the firmware's watchdog, 0x77 ESD */
+			for (int i = 0; i < 6; i++) {
+				wdt = wdt && (report[i] == 0xfd || report[i] == 0xfe);
+				esd = esd && report[i] == 0x77;
+			}
+			if (wdt) {
+				if (++wdt_run > 10) {
+					seen.wdt++;
+					printf("apollo: the touch firmware's watchdog has reset it: loading it again\n");
+					goto reload;
+				}
+			} else {
+				wdt_run = 0;
+			}
+			if (esd) {
+				if (!esd_pending) {
+					seen.esd++;
+					printf("apollo: the touch firmware asks for its ESD check\n");
+				}
+				esd_pending = true;
+			} else if (report[0] != 0xff || report[1] != 0xff) {
+				uint64_t since = now - gap.since;
+
+				if (gap.down && since > gap_long && gap.told < 64) {
+					uint64_t ns;
+
+					absolutetime_to_nanoseconds(since, &ns);
+					gap.told++;
+					say("apollo touch: %llu ms without a report while a finger was down: %u reads (%u empty, %u failed, "
+					    "%u with no edge), %u edges, the interrupt line %u now\n", ns / 1000000, gap.reads, gap.empty,
+					    gap.failed, gap.no_edge, gap.edges, rd(GPIO_IO(PIN_INT)) & 1);
+				}
+				apollo_nvt_report(report, NVT_POINT_DATA_LEN / 6);
+				gap.since = now;
+				gap.down = apollo_any_down();
+				gap.reads = gap.empty = gap.failed = gap.no_edge = gap.edges = 0;
+			} else {
+				gap.empty++;
+			}
+		}
+		/* (nvt_esd_check_func) the firmware asked, and the line has been quiet for 1.5 s: load it again */
+		if (esd_pending && now - edge_at > esd_quiet) {
+			printf("apollo: no touch report for 1.5 s after the ESD request: loading the firmware again\n");
+			goto reload;
+		}
+		goto status;
+reload:
+		apollo_release_all();
+		wdt_run = 0;
+		esd_pending = false;
+		seen.reloads++;
+		if (nvt_file == NULL || !nvt_download_firmware(nvt_file) || !nvt_set_page(NVT_EVENT_BUF_ADDR)) {
+			printf("apollo: the touch firmware could not be loaded again\n");
+		}
+		if (use_int) {
+			wr(GPIO_INTR_STATUS(PIN_INT), 0);
+		}
+		edge_at = mach_absolute_time();
+status:
+		if (mach_absolute_time() - status_at > status_every) {
+			status_at = mach_absolute_time();
+			printf("apollo: touch: %u reports in %u reads (%u bad), %u edges, %u finger positions, %u lifted by the "
+			    "driver, %u watchdog and %u ESD recoveries (%u reloads); int line %u\n", seen.reports, seen.polls,
+			    seen.bad, seen.edges, seen.touches, seen.released, seen.wdt, seen.esd, seen.reloads,
+			    rd(GPIO_IO(PIN_INT)) & 1);
+		}
+		if (!use_int) {
+			sleep_us(poll_us);
+		}
+	}
+}
+
+void
+apollo_touch_init(void)
+{
+	uint32_t enabled = 0;
+
+	if (!PE_parse_boot_argn("apollo_touch", &enabled, sizeof(enabled)) || !enabled) {
+		return;
+	}
+	PE_parse_boot_argn("touch_flip", &flip, sizeof(flip));
+	thread_t thread;
+
+	if (kernel_thread_start(apollo_touch_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_set_thread_name(thread, "apollo touch");
+		thread_deallocate(thread);
+	}
+}
diff --git a/bsd/sys/hakios.apollo_audio.h b/bsd/sys/hakios.apollo_audio.h
new file mode 100644
index 000000000000..a58bf4fc3802
--- /dev/null
+++ b/bsd/sys/hakios.apollo_audio.h
@@ -0,0 +1,56 @@
+/*
+ * The Xiaomi Mi 10T's (apollo) sound for iOS, kept apart from redwood's (sys/hakios.audio.h):
+ *   /dev/apollo-audio   what iOS's audio plug-in writes (userland/src/audio_plugin.c opens it when it is there):
+ *                       48 kHz stereo, 16-bit samples, written as they come (bsd/dev/hakios.apollo_audio.c)
+ *   the speakers' guard what the samples go through on their way to the amplifiers, for want of Cirrus's speaker
+ *                       protection firmware (bsd/dev/hakios.apollo_guard.c)
+ * The device speaks the plug-in's protocol: the same frames, and the volume ioctl with the same number.
+ */
+#ifndef _SYS_APOLLO_AUDIO_H_
+#define _SYS_APOLLO_AUDIO_H_
+
+#include <sys/ioccom.h>
+
+#define APOLLO_AUDIO_DEVICE     "/dev/apollo-audio"
+#define APOLLO_AUDIO_RATE       48000
+#define APOLLO_AUDIO_FRAME      4       /* bytes */
+
+/* the speakers' volume as iOS sets it: eighths of a dB under the loudest, and muted (iOS's volume at 0) */
+struct apollo_audio_volume {
+	uint32_t below;
+	uint32_t muted;
+};
+#define APOLLO_AUDIO_SET_VOLUME _IOW('r', 1, struct apollo_audio_volume)       /* the plug-in's number */
+
+#ifdef KERNEL
+#include <stdbool.h>
+
+/* a sink is offered frames as they are written and says how many it took; called from the writer, must not wait */
+typedef uint32_t (*apollo_audio_sink_t)(const int16_t *frames, uint32_t count);
+
+void apollo_audio_init(void);
+void apollo_audio_set_sink(const char *name, apollo_audio_sink_t sink);
+bool apollo_audio_volume(uint32_t *below, bool *muted, uint32_t *generation);  /* false if iOS has set none */
+bool apollo_audio_recording_fed(void);          /* (no recording on apollo yet: false) */
+void apollo_audio_record_fed(const int16_t *frames, uint32_t count);
+
+/* the guard: levels in eighths of a dB */
+#define APOLLO_GUARD_SILENT     0xffffffffu     /* the amplifiers are off */
+struct apollo_guard_report {
+	uint32_t blocks, rms_blocks, fast_blocks, slow_blocks;
+	uint32_t limited_frames;
+	uint32_t peak_in, peak_out;
+	uint32_t least_peak_gain;               /* 1/65536 */
+	uint64_t least_gain, gain;              /* Q30 */
+	uint64_t rms, fast, slow;               /* Q30 of a full-scale square wave at Android's level */
+};
+#define APOLLO_GUARD_MAX_GAIN   (12 * 8)
+void apollo_guard_configure(bool hpf, uint32_t gain);
+void apollo_guard_attenuation(uint32_t below);
+void apollo_guard_monitor(uint32_t below);
+void apollo_guard_process(int16_t *frames, uint32_t count);
+void apollo_guard_take_report(struct apollo_guard_report *report);
+int apollo_guard_decibels(uint64_t ratio);
+#endif /* KERNEL */
+
+#endif /* _SYS_APOLLO_AUDIO_H_ */
diff --git a/bsd/sys/hakios.apollo_input.h b/bsd/sys/hakios.apollo_input.h
new file mode 100644
index 000000000000..73235092fda4
--- /dev/null
+++ b/bsd/sys/hakios.apollo_input.h
@@ -0,0 +1,108 @@
+/*
+ * The Xiaomi Mi 10T (apollo): its own drivers, kept apart from redwood's. bsd_init calls apollo_input_init() right after
+ * hakios_input_init() (devices/mi-10t/xnu/mi-10t.patch); it does nothing unless the loader says the phone is apollo (device=apollo),
+ * and each part needs its own boot-arg as well, so that redwood's drivers (touchscreen=, buttons=, battery=,
+ * cpufreq=) stay off on this phone.
+ */
+#ifndef _SYS_APOLLO_INPUT_H_
+#define _SYS_APOLLO_INPUT_H_
+
+void apollo_input_init(void);
+void apollo_touch_init(void);   /* apollo_touch=1: the Novatek NT36675 touch screen (bsd/dev/hakios.apollo_touch.c) */
+void apollo_buttons_init(void); /* apollo_buttons=1: power and the volume keys of the PM8150 (bsd/dev/hakios.apollo_buttons.c) */
+void apollo_battery_init(void); /* apollo_battery=1: the battery, as the UEFI's charger drivers see it (hakios.apollo_battery.c) */
+void apollo_cpufreq_init(void); /* apollo_cpufreq=1: every core group at its top speed (bsd/dev/hakios.apollo_cpufreq.c) */
+void apollo_display_init(void);         /* apollo_display=1: the panel's timing, measured; apollo_display_hz=N (bsd/dev/hakios.apollo_display.c) */
+bool apollo_display_flip(uint64_t phys, uint32_t stride);       /* page flip of the pipe that scans the boot framebuffer (hakios.apollo_display.c) */
+bool apollo_display_flip_latched(void);         /* the last flip has taken effect (the hardware cleared the CTL_FLUSH bit) */
+/* apollo_flip=1: three frames to draw into and flip between (hakios.apollo_display.c); one thread (the presenter) only */
+int apollo_scanout_get(unsigned *count, vm_offset_t va[3], uint64_t pa[3], uint32_t *stride);   /* va[0] in: frame 0's mapping; count 0: no flips */
+bool apollo_scanout_flip(unsigned index, bool gpu);     /* flip to frame index (gpu: drawn by the GPU, with its stride); over a pending one, or queued; false: refused */
+int apollo_scanout_take(void);                  /* a free (or, apollo_flip_latest=1, the queued) frame for the presenter's CPU copy, reserved until its flip; -1: none now */
+void apollo_scanout_release(unsigned index);    /* a reserved frame given back without a flip */
+/* apollo_gpu_present=1: frames the GPU (the window server's Mesa) scales into; ApolloGPU's kApolloScanout */
+bool apollo_scanout_gpu_info(unsigned index, uint64_t *phys, uint32_t *stride, uint32_t *width, uint32_t *height, uint64_t *bytes, vm_offset_t *va);
+int apollo_scanout_acquire(uint32_t timeout_ms);        /* a free frame for the GPU, reserved for the caller; waits; -1: none */
+void apollo_scanout_mark(unsigned index, uint32_t swap);        /* the SwapEnd with this number is of that frame */
+int apollo_scanout_take_mark(uint32_t swap, uint32_t surface);  /* present(): the frame swap `swap` (whose layer 0 is `surface`) was drawn into by the GPU, or -1 */
+bool apollo_scanout_latched(void);              /* a flip may be asked for now (always: they are queued); the front updated */
+void apollo_scanout_wait(uint32_t timeout_us);  /* (returns at once: the flips are queued, apollo_scanout_latched is true) */
+unsigned apollo_scanout_front(void);            /* the frame the panel scans */
+/* apollo_frames=1 statistics of the flips (bsd/dev/hakios.apollo_frames.c), from hakios.apollo_display.c, under its scan_lock */
+#define APOLLO_FRAMES_FLIP_AT_ONCE      0       /* written to the pipe at once: nothing was pending */
+#define APOLLO_FRAMES_FLIP_QUEUED       1       /* queued behind a pending flip */
+#define APOLLO_FRAMES_FLIP_APPLIED      2       /* a queued one written; ns: after the frame start (the latch's line) */
+#define APOLLO_FRAMES_FLIP_LATCHED      3       /* a flip seen latched; ns: since it was asked for */
+#define APOLLO_FRAMES_FLIP_REPLACED     4       /* a queued one replaced by a newer (latest wins): never shown */
+#define APOLLO_FRAMES_FLIP_TAKEN_BACK   5       /* a queued one taken back to draw a newer picture into: never shown */
+#define APOLLO_FRAMES_FLIP_FAILED       6       /* a queued one that could not be written */
+#define APOLLO_FRAMES_FLIP_NONE_FREE    7       /* apollo_scanout_take found no frame */
+#define APOLLO_FRAMES_FLIP_SUPERSEDED   8       /* a pending one written over by a newer (latest wins): (almost always) never shown */
+#define APOLLO_FRAMES_FLIP_KINDS        9
+void apollo_frames_flip(unsigned what, uint64_t ns);
+void apollo_frames_acquire(uint64_t wait_abs, bool got);       /* the window server's apollo_scanout_acquire: its wait */
+/* apollo_hitch=1 (with apollo_frames=1): what the processors run while CoreAnimation hands over no frame (bsd/dev/hakios.apollo_hitch.c) */
+void apollo_hitch_init(void);
+void apollo_hitch_swap(uint64_t last_abs, uint64_t now_abs);    /* apollo_frames_swap: two swaps of CA's */
+void apollo_hitch_window(bool begin, uint64_t window_ns);       /* apollo_frames_shown: a 2 s window begins, or has been told */
+uint32_t apollo_gpu_in_flight(void);    /* submissions given to the GPU and not done yet; no lock (hakios.apollo_adreno.c) */
+uint32_t apollo_gpu_mhz(void);          /* the 3D core's speed, as last asked for (hakios.apollo_adreno.c) */
+uint32_t apollo_cpufreq_mhz(unsigned domain);   /* a core group's speed now: 0 cores 0-3, 1 4-6, 2 7 (hakios.apollo_cpufreq.c) */
+void apollo_hitch_touch(bool down, bool moved); /* apollo_touch's every report: a finger down, one moved (for the hitch tracer) */
+/* a kernel thread's name (osfmk/kern/thread.c), which the hitch tracer shows for it instead of "kernel_task" */
+void thread_set_thread_name(struct thread *thread, const char *name);
+void apollo_backlight_init(void);       /* apollo_backlight=P: the panel's light, the PM8150L's WLED (bsd/dev/hakios.apollo_backlight.c) */
+void apollo_backlight_set(uint32_t fraction);   /* iOS's brightness, 0 to 0x10000 */
+void apollo_backlight_power(bool on);   /* the display switched off or on */
+void apollo_backlight_stop(void);       /* the run ends: the light as the firmware had it */
+void apollo_haptic_init(void);  /* apollo_haptic=N: the vibration motor, an Awinic AW8697 (bsd/dev/hakios.apollo_haptic.c) */
+void apollo_haptic_quiesce(void);       /* the run ends or a panic's way back: the chip into reset, no lock, no sleep */
+void apollo_adreno_init(void);  /* apollo_gpu=N: the Adreno 650, steps 1 to N (bsd/dev/hakios.apollo_adreno.c) */
+
+/*
+ * The sound (apollo_audio=N): the audio DSP (bsd/dev/hakios.apollo_adsp.c), the speakers' path through it (hakios.apollo_sound.c).
+ * The APR types are the shared ones of sys/hakios.audio.h.
+ */
+#include <sys/hakios.audio.h>
+void apollo_adsp_init(void);
+void apollo_adsp_stop(void);            /* the run ends in order: the sound down, the DSP shut down (loader_return.c) */
+void apollo_adsp_quiesce(void);         /* a panic's way back: amplifiers off, the DSP stopped, no lock, no sleep */
+bool apollo_adsp_apr(uint8_t service, uint16_t port, uint32_t token, uint32_t opcode, const void *payload, uint32_t length,
+    uint32_t wait_ms, struct hakios_apr_answer *answer);
+void apollo_adsp_apr_events(hakios_apr_events_t handler);
+void apollo_adsp_apr_events_second(hakios_apr_events_t handler);
+const uint8_t *apollo_adsp_fw_file(const char *name, uint64_t *size);
+void apollo_adsp_fw_free(const uint8_t *data, uint64_t size);
+void apollo_sound_dsp_up(void);         /* the DSP's audio services are up */
+void apollo_sound_dsp_down(void);       /* the DSP is about to be shut down */
+void apollo_sound_quiesce(void);        /* a panic's way back */
+/* the main microphone (apollo_mic=N, bsd/dev/hakios.apollo_mic.c): its path through the DSP; /dev/hakios-mic for iOS */
+void apollo_mic_dsp_up(void);           /* the DSP's audio services are up */
+void apollo_mic_dsp_down(void);         /* the DSP is about to be shut down: what the microphone's path asked for given back */
+void apollo_mic_quiesce(void);          /* any way back: the codec into reset, the run's lines said again; no lock, no sleep */
+bool apollo_audio_dsp_memory(uintptr_t *memory, uint64_t *dsp_address, uint32_t *bytes);
+void apollo_audio_dsp_memory_put(void);
+/* the two CS35L41 amplifiers (bsd/dev/hakios.apollo_cs35l41.c), as hakios_speaker_* are for the Awinic ones */
+bool apollo_cs35l41_prepare(const uint8_t *config, uint64_t size);
+bool apollo_cs35l41_start(void);
+bool apollo_cs35l41_volume(uint32_t below, uint32_t step_ms);
+bool apollo_cs35l41_healthy(void);
+void apollo_cs35l41_stop(void);
+void apollo_cs35l41_quiesce(void);
+uint32_t apollo_cs35l41_monitor(bool tell);
+
+void apollo_touch_screen(bool on);      /* the display is off or on: the touch chip sleeps or wakes (hakios.apollo_touch.c) */
+void apollo_cpufreq_screen(bool on);   /* the display off: every core group at its lowest speed (bsd/dev/hakios.apollo_cpufreq.c) */
+
+/* The Wi-Fi (apollo_wifi=N): the QCA6390 on PCIe0 (bsd/dev/hakios.apollo_pcie.c) */
+void apollo_wifi_init(void);
+void apollo_wifi_quiesce(void);         /* any way back: PERST# and WLAN_EN down (loader_return.c) */
+#include <kern/locks.h>
+extern lck_mtx_t apollo_smmu_lock;      /* the apps SMMU's match registers and contexts: whoever takes one (hakios.apollo_sound.c, hakios.apollo_pcie.c) */
+/* GCC's APCS branch vote register (0x52008) is shared by the touch, haptic, amplifier and PCIe drivers: set bits under one lock */
+void apollo_gcc_vote(vm_offset_t vote_register, uint32_t bits);         /* (hakios.apollo_cpufreq.c) */
+extern lck_mtx_t apollo_rpmh_tcs1_lock; /* RPMh's TCS 1: apollo_rpmh_bcm_vote (hakios.apollo_cpufreq.c) and the Wi-Fi's tcs_send (hakios.apollo_pcie.c) */
+/* the SPMI arbiter: one transfer at a time, whatever the channel (defined in hakios.apollo_battery.c; taken by the battery, buttons and backlight drivers) */
+extern lck_spin_t apollo_spmi_bus_lock;
+
+#endif /* _SYS_APOLLO_INPUT_H_ */
diff --git a/bsd/sys/hakios.apollo_wifi.h b/bsd/sys/hakios.apollo_wifi.h
new file mode 100644
index 000000000000..fe739fcb1d48
--- /dev/null
+++ b/bsd/sys/hakios.apollo_wifi.h
@@ -0,0 +1,61 @@
+/*
+ * The Mi 10T's (apollo) Wi-Fi, a QCA6390 on PCIe0: what the PCIe/MHI side (bsd/dev/hakios.apollo_pcie.c) offers the rest of the
+ * apollo Wi-Fi stack -- the QRTR transport (bsd/dev/hakios.apollo_qrtr.c) and the OS side of the apollo ath11k object
+ * (bsd/dev/hakios.apollo_lx.c, devices/mi-10t/tools/mk-ath11k.sh). Nothing here is redwood's.
+ */
+#ifndef _SYS_APOLLO_WIFI_H_
+#define _SYS_APOLLO_WIFI_H_
+
+#include <stdint.h>
+
+/*
+ * The chip from power to mission mode (W1, W2a, W2b with the chip preparation, W2c: AMSS, MHI M0, MSI on) and the IPCR
+ * channels (MHI 20 to the chip, 21 from it) started. Idempotent: 0 at once when it is already so. 0 or an errno. Sleeps.
+ */
+int apollo_wifi_power_up(void);
+/*
+ * The IPCR channels reset and their threads ended, then apollo_wifi_quiesce()'s way: the MSIs masked, the LTSSM off, PERST# and WLAN_EN
+ * down, the chip's SMMU context off. The RPMh votes for the rails and CX, and the pcie_0 clocks, are NOT withdrawn (no off-vote has been
+ * tried on the phone). One way: after it, power up says ENOTSUP until the next boot (W1 to W2c are not made for a second run). Sleeps.
+ */
+void apollo_wifi_power_down(void);
+
+/*
+ * DMA: page-aligned kernel memory (contiguous or not) entered in the chip's SMMU context; *iova is what the chip uses.
+ * The mapping stays (nothing is unmapped while the chip may use it). 0 or an errno.
+ */
+int apollo_wifi_dma_map(void *buffer, unsigned long size, unsigned long long *iova);
+
+/*
+ * MSI: the chip's view of the doorbell (an IOVA) and the data of vector 0 (the GIC INTID 800); vector v is INTID
+ * apollo_wifi_intid(v) = 800 + v. The chip's capability is set for 32 vectors.
+ */
+int apollo_wifi_msi(unsigned long long *address, unsigned *data);
+unsigned apollo_wifi_intid(unsigned vector);
+
+/* registers of the chip through BAR0, with the window above 0x80000 (ath11k_pcic_read32/write32's way) */
+uint32_t apollo_wifi_read32(uint32_t offset);
+void apollo_wifi_write32(uint32_t offset, uint32_t value);
+
+/* MHI device wake (Linux mhi_device_get_sync/put: the wake doorbell), for ath11k's register access while the chip may sleep */
+void apollo_wifi_wake(int on);
+
+/*
+ * IPCR: one QRTR packet per transfer. Send may sleep; 0 or an errno. The receive function is called on a kernel thread
+ * (never in interrupt context, may sleep), one packet at a time, with the bytes valid during the call only.
+ */
+int apollo_ipcr_send(const void *data, unsigned long length);
+void apollo_ipcr_set_receive(void (*receive)(const void *data, unsigned long length, void *context), void *context);
+
+/* bsd/dev/hakios.apollo_qrtr.c: installs itself as the kernel's QMI transport (hakios_qmi_set_transport, shared) */
+int apollo_qrtr_init(void);
+
+/* the apollo ath11k object (devices/mi-10t/tools/mk-ath11k.sh): its four entry points, weak in hakios.apollo_lx.c when it is absent */
+void apollo_lx_reserve(unsigned long size);     /* hakios.apollo_lx.c: the DMA pool in one piece, taken at boot */
+void apollo_lx_net_early(void);                 /* hakios.apollo_lx.c: en0 at the kernel's start (wifi_station=1, wifi_mac=) */
+int apollo_lx_prepare(void);
+int apollo_lx_start(void);
+void apollo_lx_stop(void);
+int apollo_lx_transmit(const unsigned char *frame, unsigned long length);
+
+#endif /* _SYS_APOLLO_WIFI_H_ */
diff --git a/iokit/Kernel/hakios.apollo_gpu.cpp b/iokit/Kernel/hakios.apollo_gpu.cpp
new file mode 100644
index 000000000000..43ebc52781b1
--- /dev/null
+++ b/iokit/Kernel/hakios.apollo_gpu.cpp
@@ -0,0 +1,1621 @@
+/*
+ * ApolloGPU: the Mi 10T's Adreno 650 for programs to draw with. A copy of hakios.gpu.cpp (the POCO X5 Pro's, which
+ * has the long explanations), kept apart from it: the same interface of Linux's msm driver -- the one Mesa's
+ * freedreno speaks, through the libdrm stand-in of tools/mesa/hakios-drm, which looks for ApolloGPU first -- on
+ * the kept-on API of bsd/dev/hakios.apollo_adreno.c (apollo_gpu_*) instead of hakios.adreno.c's. The selectors of our own
+ * (0x7d, 0x7e, 0x7f) keep their numbers, so that nothing in userland has to know which phone it is on.
+ */
+
+#include <IOKit/IOLib.h>
+#include <IOKit/IOLocks.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <IOKit/IOSubMemoryDescriptor.h>
+#include <kern/clock.h>
+#include <mach/mach_time.h>
+#include <mach/vm_param.h>
+#include <sys/systm.h>
+
+#include "MiniIOSurface.h"
+
+extern "C" void hakios_tl(const char * format, ...) __printflike(1, 2);
+
+extern "C" {
+/* bsd/dev/hakios.apollo_adreno.c ("the GPU kept on"; declared here only: no header of bsd/sys is seen from here) */
+bool apollo_gpu_ready(void);
+bool apollo_gpu_parameter(uint32_t which, uint64_t * value);
+uint64_t apollo_gpu_address(uint64_t size);
+void apollo_gpu_address_free(uint64_t address, uint64_t size);
+void apollo_gpu_space(uint64_t * used, uint32_t * live, uint64_t * largest, unsigned * holes, unsigned * most,
+    uint64_t * lost, uint32_t * refused);
+extern uint32_t apollo_gpu_va;                 /* boot-arg gpu_va: 0 as before, 1 describe the addresses, 2 also guard them */
+bool apollo_gpu_map(uint64_t address, uint64_t phys, bool read_only);
+void apollo_gpu_mapped(void);
+bool apollo_gpu_unmap(uint64_t address, uint64_t size);       /* false: the SMMU may still see the pages: keep them */
+void apollo_gpu_to_memory(void * start, uint64_t size);
+uint32_t apollo_gpu_submit(const uint64_t * addresses, const uint32_t * words, uint32_t count);
+extern uint64_t apollo_gpu_phase[4];           /* the last submission's ticks: ring room, times, ring writes, doorbell */
+extern uint32_t apollo_gpu_log;
+bool apollo_gpu_done(uint32_t fence);
+uint32_t apollo_gpu_last(void);
+void apollo_gpu_worked(uint64_t * microseconds, uint32_t * submissions, uint32_t by[7]);
+void apollo_gpu_report(const char * why);
+bool apollo_gpu_recover(void);
+void apollo_gpu_stop(void);
+
+void ApolloGPUStart(void);
+void ApolloGPUStop(void);
+void MiniIOMobileFramebufferShow(const uint8_t * pixels, uint32_t width, uint32_t height, uint32_t rowBytes);
+void MiniIOMobileFramebufferSize(uint32_t * width, uint32_t * height);     /* the display as user space sees it */
+/* apollo_gpu_present=1 (bsd/dev/hakios.apollo_display.c): the panel's three frames, which the GPU may draw into */
+bool apollo_scanout_gpu_info(unsigned index, uint64_t * phys, uint32_t * stride, uint32_t * width, uint32_t * height,
+    uint64_t * bytes, vm_offset_t * va);
+int apollo_scanout_acquire(uint32_t timeout_ms);
+void apollo_scanout_release(unsigned index);
+void apollo_scanout_mark(unsigned index, uint32_t swap);
+}
+
+/* Linux's include/uapi/drm/msm_drm.h and drm.h: the requests' numbers and structures. */
+enum {
+	kDrmGemClose            = 0x09,
+	kMsmGetParam            = 0x40,
+	kMsmSetParam            = 0x41,
+	kMsmGemNew              = 0x42,
+	kMsmGemInfo             = 0x43,
+	kMsmGemCpuPrep          = 0x44,
+	kMsmGemCpuFini          = 0x45,
+	kMsmGemSubmit           = 0x46,
+	kMsmWaitFence           = 0x47,
+	kMsmGemMadvise          = 0x48,
+	kMsmSubmitQueueNew      = 0x4a,
+	kMsmSubmitQueueClose    = 0x4b,
+	kMsmSubmitQueueQuery    = 0x4c,
+	kApolloScanout         = 0x7c,         /* ours: the panel's frames as buffers to draw into (apollo_gpu_present=1) */
+	kApolloGPUWorked       = 0x7d,         /* ours: how long the 3D core itself has worked, and on how many */
+	kApolloSurface         = 0x7e,         /* ours: an IOSurface's memory as a buffer */
+	kApolloShow            = 0x7f,         /* ours: pixels of the caller's onto the panel, to see a test's result */
+};
+
+struct msm_timespec {
+	int64_t seconds, nanoseconds;           /* of the clock that goes on while the machine sleeps */
+};
+struct msm_param {
+	uint32_t pipe, param;
+	uint64_t value;
+	uint32_t len, pad;
+};
+struct msm_gem_new {
+	uint64_t size;
+	uint32_t flags, handle;
+};
+struct msm_gem_info {
+	uint32_t handle, info;
+	uint64_t value;
+	uint32_t len, pad;
+};
+struct msm_gem_cpu_prep {
+	uint32_t handle, op;
+	struct msm_timespec timeout;
+};
+struct msm_gem_submit_cmd {
+	uint32_t type, submit_idx, submit_offset, size, pad, nr_relocs;
+	uint64_t relocs;
+};
+struct msm_gem_submit_bo {
+	uint32_t flags, handle;
+	uint64_t presumed;
+};
+struct msm_gem_submit {
+	uint32_t flags, fence, nr_bos, nr_cmds;
+	uint64_t bos, cmds;
+	int32_t fence_fd;
+	uint32_t queueid;
+	uint64_t in_syncobjs, out_syncobjs;
+	uint32_t nr_in_syncobjs, nr_out_syncobjs, syncobj_stride, pad;
+};
+struct msm_wait_fence {
+	uint32_t fence, flags;
+	struct msm_timespec timeout;
+	uint32_t queueid;
+};
+struct msm_gem_madvise {
+	uint32_t handle, madv, retained;
+};
+struct msm_submitqueue {
+	uint32_t flags, prio, id;
+};
+struct msm_submitqueue_query {
+	uint64_t data;
+	uint32_t id, param, len, pad;
+};
+struct drm_gem_close {
+	uint32_t handle, pad;
+};
+struct apollo_surface {
+	uint32_t surface;                       /* the IOSurface's ID */
+	uint32_t handle;                        /* kApolloDescribe: no buffer is wanted; else, back: the buffer, */
+	uint64_t size;                          /* how big it is, */
+	uint32_t offset, rowBytes;              /* where the pixels start in it and how long a row of them is, */
+	uint32_t width, height, pixelFormat, planes;    /* and what they are */
+};
+struct apollo_show {
+	uint64_t pixels;
+	uint32_t width, height, rowBytes, pad;
+};
+/*
+ * kApolloScanout (apollo_gpu_present=1): the window server's GPU scales CoreAnimation's frame into one of the panel's three
+ * frames itself, and the display's driver flips to it instead of scaling with the processor.
+ *   kScanoutInfo     out: count (3, or 0: not available -- no apollo_flip=1 / apollo_gpu_present=1), width, height, stride (bytes
+ *                    of a GPU frame's row: a multiple of 64), surface (the frame 0's ID: frame i is that + i), displayWidth and
+ *                    displayHeight (the size user space believes the display to be: what a swap's rectangles are in).
+ *   kScanoutAcquire  in: timeoutMs; out: index, surface. A frame that is neither scanned, nor waiting for its latch, nor another
+ *                    caller's, reserved for this one until the swap is shown or kScanoutRelease; waits up to timeoutMs for one
+ *                    (EBUSY-like kIOReturnTimeout if there is none). The frame is a buffer by kApolloSurface with `surface` as
+ *                    the IOSurface ID (it is what Mesa imports as a texture with glEGLImageTargetTexture2DOES).
+ *   kScanoutQueue    in: index, swap. The next SwapEnd with that swap number (the word at 0x50 of its blob; with bit 31 set, whose layer 0
+ *                    surface ID, the word at 0x54, is the rest of the number) is of a frame the GPU
+ *                    scaled into `index`: the presenter waits for the GPU's last submission that named that buffer, and flips
+ *                    to it without drawing. If the swap is not of a shape it can show so (more than the one layer, not a
+ *                    full-panel BGRA picture), or no submission named the buffer, it is drawn by the processor as always.
+ *   kScanoutRelease  in: index. The frame is given back: it was not used.
+ */
+enum { kScanoutInfo = 0, kScanoutAcquire = 1, kScanoutQueue = 2, kScanoutRelease = 3 };
+#define kScanoutSurface 0x5ca00000u             /* the IDs of the frames as buffers, kApolloSurface: this + index (no IOSurface has them) */
+struct apollo_scanout {
+	uint32_t op, index, surface, swap;
+	uint32_t timeoutMs, count, width, height;
+	uint32_t stride, displayWidth, displayHeight, pad;
+};
+/*
+ * kApolloGPUWorked: the GPU's own side of a measurement a program makes with its own clock.
+ *
+ * A program timing this driver (userland/src/metal_drv_test.m --time) can measure only wall
+ * time: the whole of a draw, which is its own work, this ioctl, the submission, the core's
+ * execution and the wait. Nothing it can reach says how much of that was the core -- and the
+ * kernel has known all along, because bsd/dev/hakios.apollo_adreno.c times every submission off
+ * CP_ALWAYS_ON_COUNTER (19.2 ticks a microsecond) and until now only ever printed it. This
+ * request hands the same three numbers to the program, so the subtraction happens where the
+ * two halves are both in hand instead of in whoever reads the log afterwards.
+ *
+ * It RESETS what it reports, which is apollo_gpu_worked()'s own contract ("since this was
+ * last asked") and is what makes it useful: a caller reads once to zero the counters, does the
+ * work it wants to price, and reads again. Two consequences, and they are the whole of the
+ * sharp edge: two programs asking at once each get a part of the truth, and the kernel's own
+ * five-second report in submit() below shares the same counters -- so a boot that reads this
+ * will see gaps in those lines, and that is expected rather than a fault.
+ */
+struct apollo_worked {
+	uint64_t microseconds;                  /* the core's own time on the submissions counted here */
+	uint32_t submissions;                   /* how many of them it timed; 0 means nothing finished since */
+	uint32_t by[7];                         /* ... of which under 0.1, 0.25, 0.5, 1, 2, 4 ms, and longer */
+};
+
+#define kApolloDescribe        0xffffffffu
+
+#define MSM_INFO_GET_OFFSET     0
+#define MSM_INFO_GET_IOVA       1
+#define MSM_INFO_SET_NAME       2
+#define MSM_INFO_SET_IOVA       4
+#define MSM_INFO_GET_FLAGS      5
+#define MSM_BO_GPU_READONLY     0x00000002
+#define MSM_PREP_NOSYNC         0x04
+#define MSM_SUBMIT_CMD_BUF      1
+#define MSM_SUBMIT_FENCE_FD_OUT 0x20000000
+
+#define GPU_BUFFERS             8192            /* a client's, at most */
+#define GPU_BUFFER_MAX          (256u << 20)
+#define GPU_SUBMIT_CMDS         128
+#define GPU_SUBMIT_BOS          8192
+#define GPU_PATIENCE_MS         5000            /* for a buffer or a submission that somebody waits for without a limit */
+#define GPU_ASK_AGAIN_US        200             /* while waiting for the core: how long between two looks at how far it is */
+#define GPU_PUSH_AGAIN_MS       4               /* a surface is pushed out of the cache again for a submission this long after the last */
+
+static IOLock * gGPULock;                       /* around everything that is the GPU's (apollo_gpu_...) */
+static bool gGPUReported;
+static bool gGPUCached;                         /* boot-arg gpu_cached=1 */
+static bool gGPUSaidSetIova;                    /* MSM_INFO_SET_IOVA has been refused out loud once */
+
+/* What the last seconds' submissions were and cost here, for the log. */
+static struct {
+	uint64_t since, flushing, waiting, taking;      /* times of the processor's clock */
+	uint64_t flushed;                       /* bytes sent out of the cache */
+	uint32_t submissions, commands, buffers, surfaces, waits, over;
+	uint32_t made, given_again;             /* buffers of their own made for programs, and of those kept ones given again */
+	uint64_t making;                        /* ... and the time it took to make the others */
+} gGPUStat;
+
+/*
+ * The threads in gpuWait's loop right now (the presenter's wait for a drawn frame, a program's for its submission ...): read
+ * without the lock by the hitch tracer (bsd/dev/hakios.apollo_hitch.c, boot-arg apollo_hitch=1), from a timer interrupt.
+ */
+static uint32_t gGPUWaiters;
+
+extern "C" uint32_t apollo_gpu_waiters(void);
+uint32_t
+apollo_gpu_waiters(void)
+{
+	return __atomic_load_n(&gGPUWaiters, __ATOMIC_RELAXED);
+}
+
+/* Wait for the 3D core to be done with submission `fence`; with the lock held, which is let go of while waiting. */
+static bool
+gpuWait(uint32_t fence, uint64_t milliseconds)
+{
+	uint64_t began = mach_absolute_time(), patience;
+
+	nanoseconds_to_absolutetime(milliseconds * NSEC_PER_MSEC, &patience);
+	for (bool waited = false;; waited = true) {
+		if (apollo_gpu_done(fence)) {
+			if (waited) {
+				gGPUStat.waits++;
+				gGPUStat.waiting += mach_absolute_time() - began;
+				__atomic_fetch_sub(&gGPUWaiters, 1, __ATOMIC_RELAXED);
+			}
+			return true;
+		}
+		if (mach_absolute_time() - began >= patience || gGPUReported) {
+			if (waited) {
+				__atomic_fetch_sub(&gGPUWaiters, 1, __ATOMIC_RELAXED);
+			}
+			break;                  /* (a GPU that has stopped answering is not waited for again) */
+		}
+		if (!waited) {
+			__atomic_fetch_add(&gGPUWaiters, 1, __ATOMIC_RELAXED);
+		}
+		IOLockUnlock(gGPULock);
+		delay_for_interval(GPU_ASK_AGAIN_US, NSEC_PER_USEC);
+		IOLockLock(gGPULock);
+	}
+	/*
+	 * A wait of a second or more that came to nothing: the core has stopped answering. What it
+	 * and its SMMU context say is put down, and then, with boot-arg gpu_recover=1, the core is
+	 * reset and started again, which gives up the submission that hung and leaves later ones
+	 * the core's own. Without that -- or if it does not work -- nothing is waited for again in
+	 * this run: a GPU that may yet write memory of ours is given nothing more. Either way this
+	 * wait has failed, and says so: the submission did not finish.
+	 */
+	if (milliseconds >= 1000 && !gGPUReported) {
+		apollo_gpu_report("no answer");
+		gGPUReported = !apollo_gpu_recover();
+	}
+	return false;
+}
+
+/*
+ * The last submission that named each of the panel's frames (0: none since it was acquired), set under gGPULock by submit() and
+ * cleared by kScanoutAcquire. A frame that was scaled into by the GPU is shown once that submission is done.
+ */
+static uint32_t gScanFence[3];
+
+/* true: the GPU is done with the frame, or has no submission for it (then *submitted is false: nothing was drawn) */
+bool
+ApolloGPUScanoutDrawn(unsigned index, uint64_t milliseconds, bool * submitted)
+{
+	uint32_t fence;
+	bool done = true;
+
+	if (index > 2 || gGPULock == NULL) {
+		*submitted = false;
+		return true;
+	}
+	IOLockLock(gGPULock);
+	fence = gScanFence[index];
+	*submitted = fence != 0;
+	if (fence != 0) {
+		done = !apollo_gpu_ready() || gpuWait(fence, milliseconds);
+	}
+	IOLockUnlock(gGPULock);
+	return done;
+}
+
+bool
+ApolloGPUSurfaceDrawn(MiniIOSurface * surface, uint64_t milliseconds)
+{
+	uint32_t fence = surface->drawn;
+	bool done = true;
+
+	if (fence != 0 && gGPULock != NULL) {
+		IOLockLock(gGPULock);
+		done = !apollo_gpu_ready() || gpuWait(fence, milliseconds);
+		IOLockUnlock(gGPULock);
+	}
+	return done;
+}
+
+/*
+ * Boot-arg touch_lat=1: a line for every wait of a program's for the GPU that took a millisecond or
+ * more ("tl: f KIND US at US"), for telling apart what holds a frame up (tools/frames.py).
+ */
+static TUNABLE(uint32_t, gWaitLines, "touch_lat", 0);
+
+static void
+slowWait(const char * kind, uint64_t began)
+{
+	uint64_t now = mach_absolute_time(), ns, at;
+
+	if (!gWaitLines) {
+		return;
+	}
+	absolutetime_to_nanoseconds(now - began, &ns);
+	if (ns >= NSEC_PER_MSEC) {
+		absolutetime_to_nanoseconds(now, &at);
+		hakios_tl("tl: f %s %llu at %llu\n", kind, ns / 1000, at / 1000);
+	}
+}
+
+/* How long from now a time of msm's is, in milliseconds; 0: now or past. */
+static uint64_t
+millisecondsUntil(const struct msm_timespec * when)
+{
+	uint64_t now;
+	int64_t left;
+
+	absolutetime_to_nanoseconds(mach_continuous_time(), &now);
+	left = when->seconds * (int64_t) NSEC_PER_SEC + when->nanoseconds - (int64_t) now;
+	if (left <= 0) {
+		return 0;
+	}
+	return (uint64_t) left / NSEC_PER_MSEC > GPU_PATIENCE_MS ? GPU_PATIENCE_MS : (uint64_t) left / NSEC_PER_MSEC;
+}
+
+/*
+ * A wait that was to end at a time that had passed when it was asked for, and the GPU was not
+ * done: whoever asked goes on as if it were (a picture is shown half drawn). That is what comes
+ * of a caller whose clock is not this one, so the first few are told.
+ */
+static void
+waitOver(const struct msm_timespec * when, uint32_t fence)
+{
+	static uint32_t told;
+	uint64_t now;
+
+	gGPUStat.over++;
+	if (told < 4) {
+		told++;
+		absolutetime_to_nanoseconds(mach_continuous_time(), &now);
+		IOLog("ApolloGPU: a wait for submission %u, which is not done, until %lld.%09lld s, asked for at %llu.%09llu s: "
+		    "over before it began\n", fence, when->seconds, when->nanoseconds, now / NSEC_PER_SEC, now % NSEC_PER_SEC);
+	}
+}
+
+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+
+class ApolloGPU : public IOService
+{
+	OSDeclareDefaultStructors(ApolloGPU);
+
+public:
+	virtual bool start(IOService * provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(ApolloGPU, IOService);
+
+bool
+ApolloGPU::start(IOService * provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "ApolloGPUUserClient");
+	setName("ApolloGPU");
+	registerService();
+	return true;
+}
+
+void
+ApolloGPUStart(void)
+{
+	IOService * provider = IOService::getPlatform();
+	ApolloGPU * gpu;
+	uint32_t cached = 0;
+
+	gGPUCached = PE_parse_boot_argn("gpu_cached", &cached, sizeof(cached)) && cached != 0;
+	gGPULock = IOLockAlloc();
+	gpu = OSTypeAlloc(ApolloGPU);
+	if (gpu == NULL || provider == NULL || !gpu->init() || !gpu->attach(provider)) {
+		OSSafeReleaseNULL(gpu);
+		IOLog("ApolloGPU: cannot create the service\n");
+		return;
+	}
+	if (!gpu->start(provider)) {
+		gpu->detach(provider);
+		IOLog("ApolloGPU: the service did not start\n");
+	}
+	gpu->release();
+}
+
+/* The run is ending (hakios.apollo_adreno.c): nobody is in the middle of anything when the GPU goes. */
+void
+ApolloGPUStop(void)
+{
+	IOLockLock(gGPULock);
+	apollo_gpu_stop();
+	IOLockUnlock(gGPULock);
+}
+
+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+
+struct gpu_buffer {
+	IOMemoryDescriptor *            memory;         /* NULL: this handle is free */
+	uint8_t *                       kernel;         /* where it is in the kernel */
+	MiniIOSurface *                 surface;        /* whose memory it is, when not its own */
+	uint64_t                        address;        /* the GPU's for it */
+	uint64_t                        size;
+	uint32_t                        flags;
+	uint32_t                        seed;           /* the surface's when it was last pushed out of the cache, */
+	uint64_t                        pushed;         /* ... and when that was */
+	bool                            seen;           /* by the program: mapped, and from then on written by it */
+	uint32_t                        fence;          /* the last submission that names it (0: none has) */
+	uint32_t                        scanout;        /* one of the panel's frames (apollo_scanout_gpu_info), 1 + its index; else 0 */
+};
+
+/*
+ * A buffer given back while the GPU is still at it: its memory and its place in the GPU's
+ * address space are kept until the submission is done, and nobody waits for that. (A window
+ * server that makes a surface for every frame gives the last frame's back while the GPU draws
+ * this one: waiting there, for all the GPU had been given, cost it some five milliseconds a
+ * frame.)
+ */
+struct gpu_left {
+	IOMemoryDescriptor *            memory;
+	MiniIOSurface *                 surface;
+	uint64_t                        address, size;
+	uint32_t                        fence, flags;
+	uint32_t                        scanout;
+};
+#define GPU_LEFT                64
+
+/*
+ * A buffer of the program's own given back, and done with: kept, memory and place in the GPU's
+ * address space, for the next one of the same size and kind. CoreAnimation makes a new texture to
+ * draw a blur into for every frame of an animation with one (Search: 1082 x 1226, 6 MB with Mesa's
+ * rounding), and gives them back only later, a score at a time; Mesa keeps what is given back for
+ * a second and then lets it go. Each made afresh here took 2 to 3.5 ms of the window server's frame
+ * (memory got, cleared, made write-combined, and entered page by page into the GPU's address
+ * space). A buffer kept is given again as it is, not cleared: it was the same program's (Mesa's own
+ * cache gives buffers back the same way). At most GPU_KEPT_BYTES are kept (the one kept longest
+ * makes way), none for longer than GPU_KEPT_SECONDS. rc.jobs.fps, Search: 8 such textures made
+ * slowly instead of 77, the window server's frames drawn in 6.8 ms instead of 9.3-10 (median).
+ */
+struct gpu_kept {
+	IOMemoryDescriptor *            memory;         /* NULL: this place is free */
+	uint8_t *                       kernel;
+	uint64_t                        address, size, since;
+	uint32_t                        flags;
+};
+#define GPU_KEPT                48
+#define GPU_KEPT_BYTES          (160ull << 20)
+#define GPU_KEPT_SECONDS        60              /* a buffer not asked for again in so long is let go */
+#define GPU_KEEP_FROM           (256u << 10)    /* bytes: smaller ones are not worth it */
+static TUNABLE(uint32_t, gGPUKeep, "gpu_keep", 1);      /* boot-arg gpu_keep=0 (a test): none kept; gpu_keep=2: kept ones cleared when given again */
+/*
+ * The most a client may have in buffers of its own making (kMsmGemNew), in MB: boot-arg gpu_client_mb, 1024 if
+ * not given. The memory is wired, so one program could otherwise take all of the phone's; the window server's
+ * frames and textures are a few hundred MB at the most. (fBufferBytes, which this is held against, also counts
+ * the IOSurfaces and the panel's frames a client has as buffers.)
+ */
+static TUNABLE(uint32_t, gGPUClientMB, "gpu_client_mb", 1024);
+
+class ApolloGPUUserClient : public IOUserClient
+{
+	OSDeclareDefaultStructors(ApolloGPUUserClient);
+
+	task_t                  fTask;
+	struct gpu_buffer *     fBuffers;               /* handle n is fBuffers[n - 1] */
+	uint32_t                fNextQueue;
+	uint32_t                fNextBuffer;            /* where the search for a free handle starts: one given back is not the next given */
+	uint32_t                fBufferCount;
+	uint64_t                fBufferBytes;
+	uint32_t                fSubmits;
+	uint32_t                fStrangers;             /* requests that named a buffer the client does not have */
+	struct gpu_left         fLeft[GPU_LEFT];
+	uint32_t                fLeftCount;
+	struct gpu_kept         fKept[GPU_KEPT];
+	uint64_t                fKeptBytes;
+	uint32_t                fScanReserved;          /* panel frames this client has acquired and not yet queued or released: a bit each */
+
+	struct gpu_buffer * buffer(uint32_t handle);
+	struct gpu_buffer * newBuffer(IOMemoryDescriptor * memory, uint64_t from, uint64_t size, uint32_t flags, uint32_t * handle);
+	void freeBuffer(struct gpu_buffer * b);
+	bool keep(IOMemoryDescriptor * memory, uint8_t * kernel, uint64_t address, uint64_t size, uint32_t flags);
+	void dropKept(struct gpu_kept * k);
+	void reap(void);
+	IOReturn gemNew(struct msm_gem_new * request);
+	IOReturn surfaceBuffer(struct apollo_surface * request);
+	IOReturn scanoutBuffer(struct apollo_surface * request);
+	IOReturn scanout(struct apollo_scanout * request);
+	IOReturn gemInfo(struct msm_gem_info * request);
+	IOReturn submit(struct msm_gem_submit * request);
+	IOReturn show(const struct apollo_show * request);
+
+public:
+	virtual bool initWithTask(task_t owningTask, void * securityID, UInt32 type, OSDictionary * properties) APPLE_KEXT_OVERRIDE;
+	virtual bool start(IOService * provider) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	virtual void free(void) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn clientMemoryForType(UInt32 type, IOOptionBits * options, IOMemoryDescriptor ** memory) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments * args,
+	    IOExternalMethodDispatch * dispatch, OSObject * target, void * reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(ApolloGPUUserClient, IOUserClient);
+
+bool
+ApolloGPUUserClient::initWithTask(task_t owningTask, void * securityID, UInt32 type, OSDictionary * properties)
+{
+	if (!IOUserClient::initWithTask(owningTask, securityID, type, properties)) {
+		return false;
+	}
+	fTask = owningTask;
+	return true;
+}
+
+bool
+ApolloGPUUserClient::start(IOService * provider)
+{
+	if (!apollo_gpu_ready() || !IOUserClient::start(provider)) {
+		return false;
+	}
+	fBuffers = IONewZero(struct gpu_buffer, GPU_BUFFERS);
+	return fBuffers != NULL;
+}
+
+/*
+ * A buffer's addresses out of the GPU's space and free for another. false: the SMMU has not said that it
+ * has forgotten them (apollo_gpu_unmap()): the addresses are not handed out again, and the caller keeps the
+ * memory the GPU's for good (gpuKeepForGood()), as it does a buffer the core is not done with. With the lock held.
+ */
+static bool
+gpuUnmap(uint64_t address, uint64_t size)
+{
+	if (!apollo_gpu_unmap(address, size)) {
+		return false;
+	}
+	apollo_gpu_address_free(address, size);
+	return true;
+}
+
+/* Memory the GPU may still reach: a reference that is never let go of, so that it is nobody else's. */
+static void
+gpuKeepForGood(IOMemoryDescriptor * memory, MiniIOSurface * surface)
+{
+	if (surface == NULL) {
+		memory->retain();
+	} else {
+		surface->memory->retain();
+	}
+}
+
+/*
+ * With the lock held. A buffer the GPU is not done with is left (fLeft) until it is, or, with
+ * nowhere to leave it, waited for; if the GPU has stopped answering, the buffer's memory stays
+ * the GPU's for good: it may yet be written, and must not be somebody else's by then.
+ *
+ * The handle is free from the start, before the wait lets go of the lock: what is given back is a
+ * copy of the slot, so another thread giving back the same handle meanwhile finds nothing there,
+ * and one making a buffer may have the slot again.
+ */
+void
+ApolloGPUUserClient::freeBuffer(struct gpu_buffer * slot)
+{
+	struct gpu_buffer copy = *slot, * b = &copy;
+	bool busy, lost;
+
+	slot->memory = NULL;
+	slot->surface = NULL;
+	fBufferCount--;
+	fBufferBytes -= b->size;
+	busy = apollo_gpu_ready() && b->fence != 0 && !apollo_gpu_done(b->fence);
+	if (busy && fLeftCount == GPU_LEFT) {
+		busy = !gpuWait(b->fence, 1000);        /* (nowhere to keep it: this one is waited for; fLeftCount is looked at again after) */
+	}
+	if (busy && fLeftCount < GPU_LEFT) {
+		struct gpu_left * left = &fLeft[fLeftCount++];
+
+		left->memory = b->memory;
+		left->surface = b->surface;
+		left->address = b->address;
+		left->size = b->size;
+		left->fence = b->fence;
+		left->flags = b->flags;
+		left->scanout = b->scanout;
+	} else {
+		lost = busy;
+		if (busy) {
+			static uint32_t said;
+
+			if (said++ < 8) {
+				IOLog("ApolloGPU: the GPU is not done with what it was given: a buffer of %llu bytes stays its own\n", b->size);
+			}
+		} else if (b->surface == NULL && b->scanout == 0 && apollo_gpu_ready() &&
+		    keep(b->memory, b->kernel, b->address, b->size, b->flags)) {
+			b->memory = NULL;               /* (now the kept one's) */
+		} else if (apollo_gpu_ready()) {
+			lost = !gpuUnmap(b->address, b->size);
+		}
+		if (lost) {
+			gpuKeepForGood(b->memory, b->surface);
+		}
+		if (b->memory != NULL) {
+			b->memory->release();
+		}
+		if (b->surface != NULL) {
+			MiniIOSurfaceDrop(b->surface);
+		}
+	}
+}
+
+/* The buffers that were given back early and that the GPU is done with now: freed. With the lock held. */
+void
+ApolloGPUUserClient::reap(void)
+{
+	for (uint32_t i = 0; i < fLeftCount;) {
+		struct gpu_left * left = &fLeft[i];
+
+		if (apollo_gpu_ready() && !apollo_gpu_done(left->fence)) {
+			i++;
+			continue;
+		}
+		if (left->surface == NULL && left->scanout == 0 && apollo_gpu_ready() &&
+		    keep(left->memory, NULL, left->address, left->size, left->flags)) {
+			left->memory = NULL;
+		} else if (apollo_gpu_ready() && !gpuUnmap(left->address, left->size)) {
+			gpuKeepForGood(left->memory, left->surface);
+		}
+		if (left->memory != NULL) {
+			left->memory->release();
+		}
+		if (left->surface != NULL) {
+			MiniIOSurfaceDrop(left->surface);
+		}
+		*left = fLeft[--fLeftCount];
+	}
+}
+
+IOReturn
+ApolloGPUUserClient::clientClose(void)
+{
+	uint32_t reserved;
+
+	/* (taken under the lock, given back outside it: the display's driver takes gGPULock under locks of its own) */
+	IOLockLock(gGPULock);
+	reserved = fScanReserved;
+	fScanReserved = 0;
+	IOLockUnlock(gGPULock);
+	for (unsigned i = 0; i < 3; i++) {
+		if (reserved & (1u << i)) {
+			apollo_scanout_release(i);              /* (a window server that is gone has no frame to be waited for) */
+		}
+	}
+	if (fBuffers != NULL) {
+		IOLockLock(gGPULock);
+		/* what the client had the GPU do last may still be going on, in these buffers */
+		if (apollo_gpu_ready()) {
+			gpuWait(apollo_gpu_last(), 1000);
+		}
+		for (uint32_t i = 0; i < GPU_BUFFERS; i++) {
+			if (fBuffers[i].memory != NULL) {
+				freeBuffer(&fBuffers[i]);
+			}
+		}
+		reap();
+		for (uint32_t i = 0; i < GPU_KEPT; i++) {
+			dropKept(&fKept[i]);
+		}
+		if (fLeftCount != 0) {
+			IOLog("ApolloGPU: the GPU is not done with %u buffers of a program that is gone: they stay its own\n", fLeftCount);
+		}
+		IOLockUnlock(gGPULock);
+	}
+	if (!isInactive()) {
+		terminate();
+	}
+	return kIOReturnSuccess;
+}
+
+void
+ApolloGPUUserClient::free(void)
+{
+	if (fBuffers != NULL) {
+		IODelete(fBuffers, struct gpu_buffer, GPU_BUFFERS);
+		fBuffers = NULL;
+	}
+	IOUserClient::free();
+}
+
+struct gpu_buffer *
+ApolloGPUUserClient::buffer(uint32_t handle)
+{
+	if (handle == 0 || handle > GPU_BUFFERS || fBuffers[handle - 1].memory == NULL) {
+		/* (a program that names a buffer it has given back draws into somebody else's next: worth knowing) */
+		if (handle != 0 && fStrangers++ < 16) {
+			IOLog("ApolloGPU: buffer %u is asked for and is not there\n", handle);
+		}
+		return NULL;
+	}
+	return &fBuffers[handle - 1];
+}
+
+/*
+ * A handle and addresses of the GPU's for `size` bytes of a memory descriptor, from byte `from`
+ * of it on (wired memory; both in whole pages). With the lock held; NULL: there is no room.
+ */
+struct gpu_buffer *
+ApolloGPUUserClient::newBuffer(IOMemoryDescriptor * memory, uint64_t from, uint64_t size, uint32_t flags, uint32_t * handle)
+{
+	struct gpu_buffer * b = NULL;
+	bool mapped = true;
+
+	if (!apollo_gpu_ready()) {
+		return NULL;                            /* (given back while the caller was not holding the lock: the run is ending) */
+	}
+	for (uint32_t n = 0; n < GPU_BUFFERS; n++) {
+		uint32_t i = (fNextBuffer + n) % GPU_BUFFERS;
+
+		if (fBuffers[i].memory == NULL) {
+			b = &fBuffers[i];
+			*handle = i + 1;
+			fNextBuffer = i + 1;
+			break;
+		}
+	}
+	if (b == NULL || (b->address = apollo_gpu_address(size)) == 0) {
+		IOLog("ApolloGPU: no %s left for a buffer of %llu bytes\n", b ? "addresses" : "handles", size);
+		return NULL;
+	}
+	for (uint64_t offset = 0; offset < size && mapped; offset += 4096) {
+		IOByteCount length = 0;
+		addr64_t phys = memory->getPhysicalSegment(from + offset, &length, kIOMemoryMapperNone);
+
+		mapped = phys != 0 && apollo_gpu_map(b->address + offset, phys, flags & MSM_BO_GPU_READONLY);
+	}
+	apollo_gpu_mapped();
+	if (!mapped) {
+		if (!gpuUnmap(b->address, size)) {
+			memory->retain();               /* (what was entered may still be seen: stays the GPU's, gpuKeepForGood()) */
+		}
+		IOLog("ApolloGPU: a buffer of %llu bytes cannot be entered into the GPU's address space\n", size);
+		return NULL;
+	}
+	b->size = size;
+	b->flags = flags;
+	b->seed = 0;
+	b->pushed = 0;
+	b->seen = false;
+	b->fence = 0;
+	b->surface = NULL;
+	b->scanout = 0;
+	fBufferCount++;
+	fBufferBytes += size;
+	return b;
+}
+
+/* With the lock held. */
+void
+ApolloGPUUserClient::dropKept(struct gpu_kept * k)
+{
+	if (k->memory == NULL) {
+		return;
+	}
+	if (apollo_gpu_ready() && !gpuUnmap(k->address, k->size)) {
+		gpuKeepForGood(k->memory, NULL);
+	}
+	k->memory->release();
+	k->memory = NULL;
+	fKeptBytes -= k->size;
+}
+
+/* With the lock held, the GPU done with the buffer: kept if it is worth it (those kept longest make way). */
+bool
+ApolloGPUUserClient::keep(IOMemoryDescriptor * memory, uint8_t * kernel, uint64_t address, uint64_t size, uint32_t flags)
+{
+	struct gpu_kept * place = NULL;
+
+	if (gGPUKeep == 0 || size < GPU_KEEP_FROM || size > GPU_KEPT_BYTES / 4 || memory == NULL ||
+	    (kernel == NULL && OSDynamicCast(IOBufferMemoryDescriptor, memory) == NULL)) {
+		return false;
+	}
+	for (;;) {
+		struct gpu_kept * oldest = NULL;
+
+		place = NULL;
+		for (uint32_t i = 0; i < GPU_KEPT; i++) {
+			if (fKept[i].memory == NULL) {
+				place = place != NULL ? place : &fKept[i];
+			} else if (oldest == NULL || fKept[i].since < oldest->since) {
+				oldest = &fKept[i];
+			}
+		}
+		if (place != NULL && fKeptBytes + size <= GPU_KEPT_BYTES) {
+			break;
+		}
+		dropKept(oldest);
+	}
+	place->memory = memory;
+	place->kernel = kernel != NULL ? kernel : (uint8_t *) OSDynamicCast(IOBufferMemoryDescriptor, memory)->getBytesNoCopy();
+	place->address = address;
+	place->size = size;
+	place->flags = flags;
+	place->since = mach_absolute_time();
+	fKeptBytes += size;
+	return true;
+}
+
+IOReturn
+ApolloGPUUserClient::gemNew(struct msm_gem_new * request)
+{
+	uint64_t size = round_page_64(request->size), began = mach_absolute_time();
+	struct gpu_buffer * b;
+	IOBufferMemoryDescriptor * memory;
+
+	if (size == 0 || size > GPU_BUFFER_MAX) {
+		return kIOReturnBadArgument;
+	}
+	/* one kept of this size and kind, if there is one (the one kept last: likeliest still in the caches' way) */
+	IOLockLock(gGPULock);
+	struct gpu_kept * found = NULL;
+	uint64_t old;
+
+	if (!apollo_gpu_ready()) {
+		IOLockUnlock(gGPULock);
+		return kIOReturnNotReady;                       /* (given back since externalMethod() looked: the run is ending) */
+	}
+	if (fBufferBytes + size > ((uint64_t) gGPUClientMB << 20)) {
+		static uint32_t said;
+
+		IOLockUnlock(gGPULock);
+		if (said++ < 8) {
+			IOLog("ApolloGPU: a buffer of %llu bytes refused: the client has %llu MB in buffers, gpu_client_mb=%u\n", size,
+			    fBufferBytes >> 20, gGPUClientMB);
+		}
+		return kIOReturnNoMemory;
+	}
+
+	nanoseconds_to_absolutetime(GPU_KEPT_SECONDS * NSEC_PER_SEC, &old);
+	for (uint32_t i = 0; i < GPU_KEPT; i++) {
+		struct gpu_kept * k = &fKept[i];
+
+		if (k->memory != NULL && began - k->since > old) {
+			dropKept(k);
+		}
+
+		if (k->memory != NULL && k->size == size && k->flags == request->flags && (found == NULL || k->since > found->since)) {
+			found = k;
+		}
+	}
+	for (uint32_t n = 0; found != NULL && n < GPU_BUFFERS; n++) {
+		uint32_t h = (fNextBuffer + n) % GPU_BUFFERS;
+
+		if (fBuffers[h].memory == NULL) {
+			if (gGPUKeep == 2) {
+				bzero(found->kernel, (size_t) found->size);     /* (before the handle is the program's: under the lock) */
+			}
+			b = &fBuffers[h];
+			bzero(b, sizeof(*b));
+			b->memory = found->memory;
+			b->kernel = found->kernel;
+			b->address = found->address;
+			b->size = found->size;
+			b->flags = found->flags;
+			fNextBuffer = h + 1;
+			fBufferCount++;
+			fBufferBytes += size;
+			request->handle = h + 1;
+			found->memory = NULL;
+			fKeptBytes -= size;
+			gGPUStat.given_again++;
+			IOLockUnlock(gGPULock);
+			return kIOReturnSuccess;
+		}
+	}
+	IOLockUnlock(gGPULock);
+	/* (the memory comes zeroed, and making it write-combined pushes the zeroes out of the cache) */
+	memory = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task, kIODirectionInOut | kIOMemoryKernelUserShared |
+	    (gGPUCached ? 0 : kIOMapWriteCombineCache), (vm_size_t) size, PAGE_SIZE);
+	if (memory == NULL) {
+		IOLog("ApolloGPU: no memory for a buffer of %llu bytes (%u buffers, %llu MB with this client)\n", size, fBufferCount,
+		    fBufferBytes >> 20);
+		return kIOReturnNoMemory;
+	}
+	if (gGPUCached) {
+		apollo_gpu_to_memory(memory->getBytesNoCopy(), size);
+	}
+
+	IOLockLock(gGPULock);
+	/* (the lock was let go of: the limit again, against what other threads of the client made meanwhile; newBuffer() sees to the GPU being there) */
+	b = fBufferBytes + size > ((uint64_t) gGPUClientMB << 20) ? NULL : newBuffer(memory, 0, size, request->flags, &request->handle);
+	if (b != NULL) {
+		b->memory = memory;
+		b->kernel = (uint8_t *) memory->getBytesNoCopy();
+		gGPUStat.made++;
+		gGPUStat.making += mach_absolute_time() - began;
+	}
+	IOLockUnlock(gGPULock);
+	if (b == NULL) {
+		memory->release();
+		return kIOReturnNoMemory;
+	}
+	return kIOReturnSuccess;
+}
+
+/*
+ * The memory of an IOSurface as a buffer: its pixels, from the page after the surface's shared
+ * state on (MiniIOSurface.h). The surface is held for as long as the buffer is there. A surface
+ * that is a buffer of this client's already is that buffer again, as with Linux's handles: so
+ * the client must not be giving that buffer back at the same moment (freedreno asks under the
+ * lock it gives buffers back under). Asked only to describe (kApolloDescribe), no buffer is made.
+ */
+IOReturn
+ApolloGPUUserClient::surfaceBuffer(struct apollo_surface * request)
+{
+	MiniIOSurface * s;
+	struct gpu_buffer * b = NULL;
+	IOMemoryDescriptor * memory;
+	uint64_t size, began = mach_absolute_time();
+
+	if ((request->surface & 0xffff0000u) == kScanoutSurface) {
+		return scanoutBuffer(request);
+	}
+	s = MiniIOSurfaceCopy(request->surface);
+	if (s == NULL) {
+		return kIOReturnNotFound;
+	}
+	if (s->client != NULL) {
+		/* (memory of a program's own with a surface made around it: not in whole pages, and seldom in rows the GPU takes) */
+		MiniIOSurfaceDrop(s);
+		return kIOReturnUnsupported;
+	}
+	size = round_page_64(s->info.allocSize);
+	memory = IOSubMemoryDescriptor::withSubRange(s->memory, PAGE_SIZE, size, kIODirectionInOut);
+	if (memory == NULL || size == 0 || size > GPU_BUFFER_MAX) {
+		OSSafeReleaseNULL(memory);
+		MiniIOSurfaceDrop(s);
+		return kIOReturnNoMemory;
+	}
+	request->size = size;
+	request->offset = s->info.offset;
+	request->rowBytes = s->info.bytesPerRow;
+	request->width = s->info.width;
+	request->height = s->info.height;
+	request->pixelFormat = s->info.pixelFormat;
+	request->planes = s->info.planeCount;
+	if (request->handle == kApolloDescribe) {
+		request->handle = 0;
+		memory->release();
+		MiniIOSurfaceDrop(s);
+		return kIOReturnSuccess;
+	}
+
+	IOLockLock(gGPULock);
+	for (uint32_t i = 0; i < GPU_BUFFERS; i++) {
+		if (fBuffers[i].memory != NULL && fBuffers[i].surface == s) {
+			b = &fBuffers[i];
+			request->handle = i + 1;
+			break;
+		}
+	}
+	if (b != NULL) {
+		memory->release();
+		MiniIOSurfaceDrop(s);
+	} else if ((b = newBuffer(s->memory, PAGE_SIZE, size, 0, &request->handle)) != NULL) {
+		b->memory = memory;
+		b->kernel = s->kbase + PAGE_SIZE;
+		b->surface = s;
+		gGPUStat.surfaces++;
+	}
+	gGPUStat.taking += mach_absolute_time() - began;
+	IOLockUnlock(gGPULock);
+	if (b == NULL) {
+		memory->release();
+		MiniIOSurfaceDrop(s);
+		return kIOReturnNoMemory;
+	}
+	return kIOReturnSuccess;
+}
+
+/*
+ * One of the panel's frames (kScanoutSurface + index) as a buffer, as an IOSurface's memory is one (surfaceBuffer() above): its
+ * physical pages, which are the display's reservation (bsd/dev/hakios.apollo_display.c), entered into the GPU's address space. The
+ * 3D core's page table entries are PTE_CORE, attribute 0 of MAIR (Linux's: uncached, SMMU_MAIR0 in hakios.apollo_adreno.c), so what
+ * the core writes is in memory for the display controller, which reads memory with nothing in between. Rows are of the GPU
+ * stride (64-byte multiples; Mesa takes no other pitch of a render target). The same frame asked for again is the same buffer.
+ * It is made whether or not the client has the frame acquired (the window server makes all three when it starts,
+ * userland/src/eagl.c): what is checked is that a submission naming one is of the client that has it acquired (submit()).
+ */
+IOReturn
+ApolloGPUUserClient::scanoutBuffer(struct apollo_surface * request)
+{
+	unsigned index = request->surface & 0xffffu;
+	uint64_t phys, bytes;
+	uint32_t stride, width, height;
+	vm_offset_t va;
+	IOMemoryDescriptor * memory;
+	struct gpu_buffer * b = NULL;
+
+	if (index > 2 || !apollo_scanout_gpu_info(index, &phys, &stride, &width, &height, &bytes, &va)) {
+		return kIOReturnUnsupported;
+	}
+	request->size = bytes;
+	request->offset = 0;
+	request->rowBytes = stride;
+	request->width = width;
+	request->height = height;
+	request->pixelFormat = 0x42475241;              /* 'BGRA' */
+	request->planes = 0;
+	if (request->handle == kApolloDescribe) {
+		request->handle = 0;
+		return kIOReturnSuccess;
+	}
+	IOLockLock(gGPULock);
+	for (uint32_t i = 0; i < GPU_BUFFERS; i++) {
+		if (fBuffers[i].memory != NULL && fBuffers[i].scanout == index + 1) {
+			request->handle = i + 1;
+			IOLockUnlock(gGPULock);
+			return kIOReturnSuccess;
+		}
+	}
+	IOLockUnlock(gGPULock);
+	memory = IOMemoryDescriptor::withPhysicalAddress((IOPhysicalAddress) phys, (IOByteCount) bytes, kIODirectionInOut);
+	if (memory == NULL) {
+		return kIOReturnNoMemory;
+	}
+	IOLockLock(gGPULock);
+	b = newBuffer(memory, 0, bytes, 0, &request->handle);
+	if (b != NULL) {
+		b->memory = memory;
+		b->kernel = (uint8_t *) va;
+		b->scanout = index + 1;
+	}
+	IOLockUnlock(gGPULock);
+	if (b == NULL) {
+		memory->release();
+		return kIOReturnNoMemory;
+	}
+	return kIOReturnSuccess;
+}
+
+IOReturn
+ApolloGPUUserClient::scanout(struct apollo_scanout * request)
+{
+	uint64_t phys, bytes;
+	uint32_t stride, width, height;
+	vm_offset_t va;
+
+	switch (request->op) {
+	case kScanoutInfo:
+		request->count = 0;
+		if (apollo_scanout_gpu_info(0, &phys, &stride, &width, &height, &bytes, &va)) {
+			request->count = 3;
+			request->width = width;
+			request->height = height;
+			request->stride = stride;
+			request->surface = kScanoutSurface;
+			MiniIOMobileFramebufferSize(&request->displayWidth, &request->displayHeight);
+		}
+		return kIOReturnSuccess;
+	case kScanoutAcquire: {
+		int index = apollo_scanout_acquire(request->timeoutMs > 1000 ? 1000 : request->timeoutMs);
+
+		if (index < 0) {
+			return kIOReturnTimeout;
+		}
+		IOLockLock(gGPULock);
+		gScanFence[index] = 0;                  /* (nothing has drawn into it yet) */
+		fScanReserved |= 1u << index;
+		IOLockUnlock(gGPULock);
+		request->index = (uint32_t) index;
+		request->surface = kScanoutSurface + (uint32_t) index;
+		return kIOReturnSuccess;
+	}
+	/*
+	 * fScanReserved is looked at and changed under gGPULock (submit() reads it there too), so that of two
+	 * threads queueing or releasing one frame, one does; the display's driver is called outside the lock.
+	 */
+	case kScanoutQueue:
+	case kScanoutRelease: {
+		bool reserved;
+
+		if (request->index > 2) {
+			return kIOReturnBadArgument;
+		}
+		IOLockLock(gGPULock);
+		reserved = (fScanReserved & (1u << request->index)) != 0;
+		fScanReserved &= ~(1u << request->index);       /* (the display's driver has it from here: apollo_scanout_*) */
+		IOLockUnlock(gGPULock);
+		if (!reserved) {
+			return kIOReturnBadArgument;
+		}
+		if (request->op == kScanoutQueue) {
+			apollo_scanout_mark(request->index, request->swap);
+		} else {
+			apollo_scanout_release(request->index);
+		}
+		return kIOReturnSuccess;
+	}
+	}
+	return kIOReturnBadArgument;
+}
+
+IOReturn
+ApolloGPUUserClient::gemInfo(struct msm_gem_info * request)
+{
+	struct gpu_buffer * b;
+	IOReturn ret = kIOReturnSuccess;
+
+	IOLockLock(gGPULock);
+	b = buffer(request->handle);
+	if (b == NULL) {
+		ret = kIOReturnBadArgument;
+	} else if (request->info == MSM_INFO_GET_OFFSET) {
+		request->value = (uint64_t) request->handle << 32;      /* nobody maps by it here */
+	} else if (request->info == MSM_INFO_GET_IOVA) {
+		/*
+		 * The address the buffer was given when it was made, and the buffer's until it is
+		 * given back. Nothing here ever moves a live buffer, so a caller may ask once and
+		 * keep the answer -- which is what freedreno does (fd_bo_init_common).
+		 */
+		request->value = b->address;
+	} else if (request->info == MSM_INFO_SET_IOVA) {
+		/*
+		 * Where a buffer goes is not the program's to choose here: every client is in the
+		 * one SMMU context 0, so an address one program picked would be a place in every
+		 * other program's space as well. Linux draws the line in the same place for the
+		 * two parameters that describe a space -- VA_START and VA_SIZE are refused unless
+		 * the client has page tables of its own (adreno_gpu.c, adreno_get_param) -- and
+		 * placing a buffer is the stronger request of the two. Said once, by name, rather
+		 * than returned as a bare code nobody can look up.
+		 */
+		if (!gGPUSaidSetIova) {
+			gGPUSaidSetIova = true;
+			IOLog("ApolloGPU: a program asked to place buffer %u at %#llx itself: refused. There is one "
+			    "page table here for every client, so addresses are the kernel's to give and "
+			    "MSM_INFO_GET_IOVA is how to learn them\n", request->handle, request->value);
+		}
+		ret = kIOReturnUnsupported;
+	} else if (request->info == MSM_INFO_GET_FLAGS) {
+		request->value = b->flags;
+	} else if (request->info != MSM_INFO_SET_NAME) {            /* a name for somebody's debugger: not kept */
+		ret = kIOReturnUnsupported;
+	}
+	IOLockUnlock(gGPULock);
+	return ret;
+}
+
+IOReturn
+ApolloGPUUserClient::submit(struct msm_gem_submit * request)
+{
+	struct msm_gem_submit_bo * bos = NULL;
+	struct msm_gem_submit_cmd * cmds = NULL;
+	uint64_t addresses[GPU_SUBMIT_CMDS] = { 0 };     /* (the first is put in the log even when no command buffer is taken) */
+	uint32_t words[GPU_SUBMIT_CMDS] = { 0 }, count = 0;
+	uint64_t began, nanos, again;
+	uint64_t at_start = mach_absolute_time(), at_copied = at_start, at_locked = at_start, at_flushed = at_start;
+	uint64_t at_submitted = at_start, at_reaped = at_start;
+	IOReturn ret = kIOReturnBadArgument;
+
+	if (request->nr_cmds == 0 || request->nr_cmds > GPU_SUBMIT_CMDS || request->nr_bos == 0 || request->nr_bos > GPU_SUBMIT_BOS) {
+		IOLog("ApolloGPU: a submission of %u command buffers in %u buffers: not taken\n", request->nr_cmds, request->nr_bos);
+		return kIOReturnBadArgument;
+	}
+	bos = IONew(struct msm_gem_submit_bo, request->nr_bos);
+	cmds = IONew(struct msm_gem_submit_cmd, request->nr_cmds);
+	if (bos == NULL || cmds == NULL) {
+		ret = kIOReturnNoMemory;
+		goto out;
+	}
+	if (copyin((user_addr_t) request->bos, bos, request->nr_bos * sizeof(*bos)) != 0 ||
+	    copyin((user_addr_t) request->cmds, cmds, request->nr_cmds * sizeof(*cmds)) != 0) {
+		ret = kIOReturnVMError;
+		goto out;
+	}
+	at_copied = mach_absolute_time();
+	IOLockLock(gGPULock);
+	at_locked = mach_absolute_time();
+	/*
+	 * Looked at again under the lock (externalMethod() looked without it): a GPU given back meanwhile takes
+	 * nothing, and one that has stopped answering and was not recovered (gGPUReported) is given nothing more in
+	 * this run -- as gpuWait() waits for nothing more.
+	 */
+	if (!apollo_gpu_ready() || gGPUReported) {
+		IOLockUnlock(gGPULock);
+		ret = apollo_gpu_ready() ? kIOReturnNotResponding : kIOReturnNotReady;
+		goto out;
+	}
+	/*
+	 * A submission that names one of the panel's frames is not checked against kScanoutAcquire: Mesa sends the
+	 * blit into a frame after eagl.c has queued it (glClientWaitSync does not always flush, userland/src/eagl.c),
+	 * and keeps the frames in later submissions, so such a check refused about 1600 good submissions in a
+	 * 240 s run (27 October, -22 in MESA's flush_submit_list). Keeping other programs off the frames needs
+	 * eagl.c to hold a frame until its blit is submitted.
+	 */
+	/*
+	 * The GPU reads memory and writes memory. What this processor's cache holds of an IOSurface
+	 * (somebody has written it, or has read it, as the display's driver does, and the GPU is to
+	 * draw into it again) goes out of the cache now: when the surface is said to have changed
+	 * (its seed: who writes one is to lock it, and so does a program that has had the GPU draw
+	 * into one: userland/src/eagl.c), and in any case once in a few milliseconds, which is once
+	 * a frame and not once a submission: not everybody who draws into a surface says so (an
+	 * application drawing a picture that is on the screen meanwhile). A surface this program
+	 * has mapped, every time. The buffers made here need none of that, unless they are
+	 * ordinary memory (gpu_cached=1).
+	 */
+	began = mach_absolute_time();
+	nanoseconds_to_absolutetime(GPU_PUSH_AGAIN_MS * NSEC_PER_MSEC, &again);
+	for (uint32_t i = 0; i < request->nr_bos; i++) {
+		struct gpu_buffer * b = buffer(bos[i].handle);
+
+		if (b == NULL) {
+			continue;
+		}
+		if (b->surface != NULL) {
+			uint32_t seed = b->surface->shared()->seed;
+
+			if (seed == b->seed && !b->seen && began - b->pushed < again) {
+				continue;
+			}
+			b->seed = seed;
+			b->pushed = began;
+		} else if (!b->seen || !gGPUCached || b->scanout != 0) {
+			continue;               /* (the panel's frames are write-combined for the processor and uncached for the GPU) */
+		}
+		apollo_gpu_to_memory(b->kernel, b->size);
+		gGPUStat.flushed += b->size;
+	}
+	apollo_gpu_to_memory(NULL, 0);                 /* (and what was written last is in memory: a barrier) */
+	gGPUStat.flushing += mach_absolute_time() - began;
+	gGPUStat.buffers += request->nr_bos;
+	at_flushed = mach_absolute_time();
+	for (uint32_t i = 0; i < request->nr_cmds; i++) {
+		struct gpu_buffer * b = cmds[i].submit_idx < request->nr_bos ? buffer(bos[cmds[i].submit_idx].handle) : NULL;
+
+		if (cmds[i].type != MSM_SUBMIT_CMD_BUF) {
+			continue;                               /* the other kinds are for a GPU shared between address spaces */
+		}
+		if (b == NULL || cmds[i].nr_relocs != 0 || (cmds[i].size & 3) || (cmds[i].submit_offset & 3) ||
+		    (uint64_t) cmds[i].submit_offset + cmds[i].size > b->size) {
+			IOLog("ApolloGPU: command buffer %u of a submission: buffer %u, offset %u, %u bytes, %u relocations: not taken\n",
+			    i, cmds[i].submit_idx, cmds[i].submit_offset, cmds[i].size, cmds[i].nr_relocs);
+			IOLockUnlock(gGPULock);
+			goto out;
+		}
+		addresses[count] = b->address + cmds[i].submit_offset;
+		words[count++] = cmds[i].size / 4;
+	}
+	request->fence = apollo_gpu_submit(addresses, words, count);
+	at_submitted = mach_absolute_time();
+	/*
+	 * The ring is full and the core is not reading it: it has stopped. With gpu_recover=1 it is
+	 * reset and given this submission again -- after a reset the ring is empty, so there is
+	 * room for it. (A wait of a second or more notices a stopped core first, as a rule; this is
+	 * for a program that submits without waiting.)
+	 */
+	if (request->fence == 0 && !gGPUReported) {
+		apollo_gpu_report("the ring is full");
+		gGPUReported = !apollo_gpu_recover();
+		if (!gGPUReported) {
+			request->fence = apollo_gpu_submit(addresses, words, count);
+		}
+	}
+	if (apollo_gpu_log && request->fence != 0) {
+		/* "tl: Q FENCE at US: N buffers, B of 4 MB or more, W words of commands": what was given (tl: q: what it took) */
+		uint32_t big = 0, all_words = 0;
+		uint64_t ns;
+
+		for (uint32_t i = 0; i < request->nr_bos; i++) {
+			struct gpu_buffer * b = buffer(bos[i].handle);
+
+			big += b != NULL && b->size >= (4u << 20);
+		}
+		for (uint32_t i = 0; i < count; i++) {
+			all_words += words[i];
+		}
+		absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+		hakios_tl("tl: Q %u at %llu: %u buffers, %u big, %u words\n", request->fence, ns / 1000, request->nr_bos, big, all_words);
+	}
+	if (request->flags & MSM_SUBMIT_FENCE_FD_OUT) {
+		request->fence_fd = -1;
+	}
+	/*
+	 * The surfaces named are being drawn into, or read, until this submission is done: the
+	 * display's driver waits for that before it puts one on the panel (ApolloGPUSurfaceDrawn()).
+	 * (freedreno names every buffer for reading and writing alike, so which it is cannot be
+	 * told; the last submission of a frame names the surface the frame is drawn into.)
+	 */
+	for (uint32_t i = 0; request->fence != 0 && i < request->nr_bos; i++) {
+		struct gpu_buffer * b = buffer(bos[i].handle);
+
+		if (b != NULL) {
+			b->fence = request->fence;
+			if (b->surface != NULL) {
+				b->surface->drawn = request->fence;
+			}
+			if (b->scanout != 0) {
+				gScanFence[b->scanout - 1] = request->fence;    /* (what the display's driver waits for, ApolloGPUScanoutDrawn) */
+			}
+		}
+	}
+	reap();
+	at_reaped = mach_absolute_time();
+	if (fSubmits++ < 4) {
+		IOLog("ApolloGPU: submission %u: %u command buffers, the first at %#llx, %u words\n", request->fence, count,
+		    addresses[0], words[0]);
+	}
+	/* every five seconds in which something was submitted: how much, and what it cost here */
+	gGPUStat.submissions++;
+	gGPUStat.commands += count;
+	if (gGPUStat.since == 0) {
+		gGPUStat.since = began;
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time() - gGPUStat.since, &nanos);
+	if (nanos >= 5 * NSEC_PER_SEC) {
+		uint64_t flushing, waiting, taking, worked;
+		uint32_t timed, by[7];
+
+		absolutetime_to_nanoseconds(gGPUStat.flushing, &flushing);
+		absolutetime_to_nanoseconds(gGPUStat.waiting, &waiting);
+		absolutetime_to_nanoseconds(gGPUStat.taking, &taking);
+		apollo_gpu_worked(&worked, &timed, by);
+		uint64_t making;
+
+		absolutetime_to_nanoseconds(gGPUStat.making, &making);
+		IOLog("ApolloGPU: buffers: %u made in %llu us each, %u kept ones given again (%llu MB kept)\n", gGPUStat.made,
+		    gGPUStat.made ? making / NSEC_PER_USEC / gGPUStat.made : 0, gGPUStat.given_again, fKeptBytes >> 20);
+		IOLog("ApolloGPU: %u submissions in %llu ms: %u command buffers and %u buffers named, %llu KB out of the cache "
+		    "in %llu us a submission; the GPU worked %llu us on each of %u (%u under 0.1 ms, %u under 0.25, %u under 0.5, "
+		    "%u under 1, %u under 2, %u under 4, %u longer; %llu ms in all); %u waits of %llu us, %u over before they "
+		    "began; %u IOSurfaces taken as buffers in %llu us each; %u buffers, %llu MB\n",
+		    gGPUStat.submissions, nanos / NSEC_PER_MSEC, gGPUStat.commands, gGPUStat.buffers,
+		    (gGPUStat.flushed >> 10) / gGPUStat.submissions, flushing / NSEC_PER_USEC / gGPUStat.submissions,
+		    timed ? worked / timed : 0, timed, by[0], by[1], by[2], by[3], by[4], by[5], by[6], worked / 1000,
+		    gGPUStat.waits, gGPUStat.waits ? waiting / NSEC_PER_USEC / gGPUStat.waits : 0, gGPUStat.over,
+		    gGPUStat.surfaces, gGPUStat.surfaces ? taking / NSEC_PER_USEC / gGPUStat.surfaces : 0, fBufferCount,
+		    fBufferBytes >> 20);
+		if (apollo_gpu_va != 0) {
+			/*
+			 * The address space itself, because nothing else said anything about it: what
+			 * argument buffers and heaps are built on is that this allocator holds, and
+			 * "lost" and "refused" are the two ways it stops holding (bsd/dev/
+			 * hakios.apollo_adreno.c, apollo_gpu_address_free).
+			 */
+			uint64_t used, largest, lost;
+			uint32_t live, refused;
+			unsigned holes, most;
+
+			apollo_gpu_space(&used, &live, &largest, &holes, &most, &lost, &refused);
+			IOLog("ApolloGPU: addresses: %llu MB in %u buffers, longest run free %llu MB, %u holes "
+			    "(%u at most, of 1024), %llu KB lost, %u allocations refused\n", used >> 20, live,
+			    largest >> 20, holes, most, lost >> 10, refused);
+		}
+		bzero(&gGPUStat, sizeof(gGPUStat));
+	}
+	IOLockUnlock(gGPULock);
+	{
+		/*
+		 * A submission that took 10 ms or more: where the time went (the first 20, then every 200th), in
+		 * microseconds: the copies from the caller, waiting for the clients' lock, the cache flushes of the
+		 * buffers, naming and checking the commands, the ring (waiting for room, adding up the core's times,
+		 * writing the commands, the doorbell: apollo_gpu_phase), the rest of the submission (the reaping of
+		 * buffers, the five-second report), and the whole of it.
+		 */
+		static uint32_t slow;
+		uint64_t end = mach_absolute_time(), total, parts[9];
+
+		absolutetime_to_nanoseconds(end - at_start, &total);
+		if (total >= 10 * NSEC_PER_MSEC && (slow++ < 20 || slow % 200 == 0)) {
+			uint64_t ticks[5] = { at_copied - at_start, at_locked - at_copied, at_flushed - at_locked,
+				at_submitted - at_flushed, at_reaped - at_submitted };
+
+			for (unsigned i = 0; i < 5; i++) {
+				absolutetime_to_nanoseconds(ticks[i], &parts[i]);
+			}
+			for (unsigned i = 0; i < 4; i++) {
+				absolutetime_to_nanoseconds(apollo_gpu_phase[i], &parts[5 + i]);
+			}
+			hakios_tl("tl: slow-submit %u (#%u): %llu us: copyin %llu, lock %llu, flush %llu, submit %llu (ring room %llu, times %llu, "
+			    "writes %llu, doorbell %llu), reap %llu, report %llu\n", request->fence, slow, total / 1000, parts[0] / 1000,
+			    parts[1] / 1000, parts[2] / 1000, parts[3] / 1000, parts[5] / 1000, parts[6] / 1000, parts[7] / 1000,
+			    parts[8] / 1000, parts[4] / 1000, (total - parts[0] - parts[1] - parts[2] - parts[3] - parts[4]) / 1000);
+		}
+	}
+	ret = request->fence != 0 ? kIOReturnSuccess : kIOReturnTimeout;
+out:
+	if (bos != NULL) {
+		IODelete(bos, struct msm_gem_submit_bo, request->nr_bos);
+	}
+	if (cmds != NULL) {
+		IODelete(cmds, struct msm_gem_submit_cmd, request->nr_cmds);
+	}
+	return ret;
+}
+
+/* Pixels of the caller's (32 bits each, blue first) copied to the panel: for a test to show what it has drawn. */
+IOReturn
+ApolloGPUUserClient::show(const struct apollo_show * request)
+{
+	uint64_t size = (uint64_t) request->rowBytes * request->height;
+	uint8_t * pixels;
+	IOReturn ret = kIOReturnSuccess;
+
+	if (request->width == 0 || request->width > 4096 || request->height == 0 || request->height > 4096 ||
+	    request->rowBytes < 4 * request->width) {
+		return kIOReturnBadArgument;
+	}
+	pixels = (uint8_t *) IOMallocData(size);
+	if (pixels == NULL) {
+		return kIOReturnNoMemory;
+	}
+	if (copyin((user_addr_t) request->pixels, pixels, size) != 0) {
+		ret = kIOReturnVMError;
+	} else {
+		MiniIOMobileFramebufferShow(pixels, request->width, request->height, request->rowBytes);
+	}
+	IOFreeData(pixels, size);
+	return ret;
+}
+
+IOReturn
+ApolloGPUUserClient::clientMemoryForType(UInt32 type, IOOptionBits * options, IOMemoryDescriptor ** memory)
+{
+	struct gpu_buffer * b;
+	IOReturn ret = kIOReturnBadArgument;
+
+	IOLockLock(gGPULock);
+	b = buffer(type);
+	if (b != NULL) {
+		b->memory->retain();
+		b->seen = true;
+		*memory = b->memory;
+		*options = 0;
+		ret = kIOReturnSuccess;
+	}
+	IOLockUnlock(gGPULock);
+	return ret;
+}
+
+IOReturn
+ApolloGPUUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments * args,
+    IOExternalMethodDispatch * dispatch, OSObject * target, void * reference)
+{
+	union {
+		struct msm_param param;
+		struct msm_gem_new gemNew;
+		struct msm_gem_info gemInfo;
+		struct msm_gem_cpu_prep cpuPrep;
+		struct msm_gem_submit submit;
+		struct msm_wait_fence waitFence;
+		struct msm_gem_madvise madvise;
+		struct msm_submitqueue queue;
+		struct msm_submitqueue_query query;
+		struct drm_gem_close close;
+		struct apollo_surface surface;
+		struct apollo_show show;
+		struct apollo_worked worked;
+		struct apollo_scanout scanout;
+	} r;
+	size_t size = args->structureInputSize;
+	struct gpu_buffer * b;
+	IOReturn ret = kIOReturnSuccess;
+	uint64_t zero = 0, patience, waitBegan;
+
+	if (args->structureInput == NULL || size > sizeof(r) || fBuffers == NULL) {
+		return kIOReturnBadArgument;
+	}
+	if (!apollo_gpu_ready()) {
+		return kIOReturnNotReady;                       /* given back: the run is ending (kApolloShow too: the panel is not ours then) */
+	}
+	bzero(&r, sizeof(r));
+	memcpy(&r, args->structureInput, size);
+
+	switch (selector) {
+	case kMsmGetParam:
+		ret = apollo_gpu_parameter(r.param.param, &r.param.value) ? kIOReturnSuccess : kIOReturnBadArgument;
+		break;
+	case kMsmSetParam:                              /* the program's name, for Linux's lists of who uses the GPU */
+	case kMsmGemCpuFini:
+	case kMsmSubmitQueueClose:
+		break;
+	case kMsmGemNew:
+		ret = gemNew(&r.gemNew);
+		break;
+	case kMsmGemInfo:
+		ret = gemInfo(&r.gemInfo);
+		break;
+	case kMsmGemCpuPrep:                            /* is the GPU done with a buffer: with all it has been given, here */
+		waitBegan = mach_absolute_time();
+		IOLockLock(gGPULock);
+		patience = (r.cpuPrep.op & MSM_PREP_NOSYNC) ? 0 : millisecondsUntil(&r.cpuPrep.timeout);
+		if (!gpuWait(apollo_gpu_last(), patience)) {
+			ret = kIOReturnBusy;
+			if (patience == 0 && !(r.cpuPrep.op & MSM_PREP_NOSYNC)) {
+				waitOver(&r.cpuPrep.timeout, apollo_gpu_last());
+			}
+		} else if ((b = buffer(r.cpuPrep.handle)) != NULL && b->scanout == 0 && (b->surface != NULL || gGPUCached)) {
+			/*
+			 * The GPU is done, and the program is about to look: memory that this processor caches (an
+			 * IOSurface's; a buffer of the program's own with gpu_cached=1) may have lines in the cache
+			 * from before the GPU wrote it -- read ahead while the GPU was at work -- which would be seen
+			 * instead of what it wrote. Out of the cache. (Write-combined buffers, the usual, and the
+			 * panel's frames are not cached: nothing to do.)
+			 */
+			apollo_gpu_to_memory(b->kernel, b->size);
+		}
+		IOLockUnlock(gGPULock);
+		slowWait("cpu-prep", waitBegan);
+		break;
+	case kMsmGemSubmit:
+		ret = submit(&r.submit);
+		break;
+	case kMsmWaitFence:
+		waitBegan = mach_absolute_time();
+		IOLockLock(gGPULock);
+		patience = millisecondsUntil(&r.waitFence.timeout);
+		if (!gpuWait(r.waitFence.fence, patience)) {
+			ret = kIOReturnTimeout;
+			if (patience == 0) {
+				waitOver(&r.waitFence.timeout, r.waitFence.fence);
+			}
+		}
+		IOLockUnlock(gGPULock);
+		slowWait("fence", waitBegan);
+		break;
+	case kMsmGemMadvise:
+		r.madvise.retained = 1;
+		break;
+	case kMsmSubmitQueueNew:
+		r.queue.id = ++fNextQueue;
+		break;
+	case kMsmSubmitQueueQuery:                      /* how often the GPU has faulted on this client's commands */
+		if (r.query.data != 0 && r.query.len >= sizeof(zero)) {
+			copyout(&zero, (user_addr_t) r.query.data, sizeof(zero));
+		}
+		break;
+	case kDrmGemClose:
+		IOLockLock(gGPULock);
+		b = buffer(r.close.handle);
+		if (b == NULL) {
+			ret = kIOReturnBadArgument;
+		} else {
+			freeBuffer(b);
+			reap();
+		}
+		IOLockUnlock(gGPULock);
+		break;
+	case kApolloGPUWorked:
+		/*
+		 * Under gGPULock because apollo_gpu_worked() calls gpu_times(), which reads the
+		 * scratch page and advances the same counters the submit path advances -- and
+		 * submit() holds this lock while it does exactly that. The output goes back
+		 * through the common copy at the end of this method, so a caller that passes a
+		 * struct of this size in gets it filled on the way out; one that passes fewer
+		 * bytes gets as many as it asked for, and the rest of the numbers are lost with
+		 * the reset, which is the one way to misuse this request.
+		 */
+		IOLockLock(gGPULock);
+		apollo_gpu_worked(&r.worked.microseconds, &r.worked.submissions, r.worked.by);
+		IOLockUnlock(gGPULock);
+		break;
+	case kApolloSurface:
+		ret = surfaceBuffer(&r.surface);
+		break;
+	case kApolloShow:
+		ret = show(&r.show);
+		break;
+	case kApolloScanout:
+		ret = scanout(&r.scanout);
+		break;
+	default:
+		IOLog("ApolloGPU: request %#x (%zu bytes) is not known here\n", selector, size);
+		ret = kIOReturnUnsupported;
+		break;
+	}
+	if (ret == kIOReturnSuccess && args->structureOutput != NULL) {
+		if (args->structureOutputSize > size) {
+			args->structureOutputSize = (uint32_t) size;
+		}
+		memcpy(args->structureOutput, &r, args->structureOutputSize);
+	}
+	return ret;
+}
diff --git a/osfmk/arm64/hakios.apollo_hitch_cpu.c b/osfmk/arm64/hakios.apollo_hitch_cpu.c
new file mode 100644
index 000000000000..7134a86c9382
--- /dev/null
+++ b/osfmk/arm64/hakios.apollo_hitch_cpu.c
@@ -0,0 +1,220 @@
+/*
+ * The Xiaomi Mi 10T (apollo): the scheduler's side of the hitch tracer (boot-arg apollo_hitch=1, bsd/dev/hakios.apollo_hitch.c).
+ * The tracer lives with the other apollo drivers in bsd/dev, which does not see the scheduler's structures (struct processor,
+ * struct thread, struct thread_ro are osfmk's own); what it needs of them is here, behind plain C prototypes:
+ *
+ *   - apollo_hitch_cpu(): what one processor runs right now -- nothing (off line), its idle thread, or a thread, given as
+ *     the thread's address and its system-wide id (thread_tid).
+ *   - apollo_hitch_thread(): for a thread found that way, its task's BSD process (struct proc, whose p_comm the tracer reads)
+ *     and its uthread (whose pth_name holds the name thread_set_thread_name gave a kernel thread), and whether it is one of
+ *     the kernel's own (kernel_task).
+ *   - apollo_hitch_task_waiting(): the threads of a task that are runnable but on no processor (waiting for one), walked
+ *     through the task's thread list with the same fault-free reads.
+ *   - apollo_hitch_peek(): a read of kernel memory that never faults (ml_nofault_copy).
+ *   - apollo_hitch_timer(): a timer that runs the tracer's sampler every N us on one processor, in its timer interrupt.
+ *
+ * Nothing here takes a lock or a reference: the sampler runs in an interrupt, every 2 ms, and looks at the other processors
+ * while they run. processor_array[] and the processors themselves are never freed (zalloc_permanent, or the boot processor's
+ * static one), so processor->active_thread and ->idle_thread are plain loads -- racy, which is fine: the thread may have
+ * been switched out a moment later, and the sample is then a moment stale. The thread itself is NOT safe to touch: by the
+ * time it is looked at it may have terminated, been freed by the terminate daemon, and the zone's page given back
+ * (zone_depopulate), so a plain load could fault. Every field of a thread, of its thread_ro, of the proc and of the name is
+ * therefore read with ml_nofault_copy, which translates each source page first (kvtophys: the AT instruction, else a
+ * lock-free walk of the kernel's tables) and copies through the physical aperture: an unmapped page ends the copy short
+ * instead of faulting. What it may return for a thread that has just been freed (zeroes: the zones are ZC_ZFREE_CLEARMEM,
+ * or another thread's fields if the memory was reused) is only a wrong name in a statistic -- the reads never write.
+ */
+#include <arm/machine_routines.h>       /* ml_nofault_copy */
+#include <kern/cpu_number.h>
+#include <kern/processor.h>
+#include <kern/sched_prim.h>            /* thread_bind, thread_block */
+#include <kern/task.h>                  /* kernel_task */
+#include <kern/thread.h>
+#include <kern/timer_call.h>
+#include <mach/mach_types.h>
+
+int apollo_hitch_cpu(unsigned cpu, uint64_t *tid, uintptr_t *thread);
+bool apollo_hitch_thread(uintptr_t thread, uintptr_t *proc, uintptr_t *uthread, bool *kernel, uintptr_t *task);
+int apollo_hitch_task_waiting(uintptr_t task, uintptr_t *threads, uint64_t *tids, uint64_t *since_abs, int max);
+bool apollo_hitch_thread_tid(uintptr_t thread, uint64_t *tid);
+size_t apollo_hitch_peek(uintptr_t from, void *to, size_t size);
+bool apollo_hitch_timer(unsigned cpu, uint64_t interval_ns, void (*tick)(uint64_t now));
+
+size_t
+apollo_hitch_peek(uintptr_t from, void *to, size_t size)
+{
+	if (from < VM_MIN_KERNEL_ADDRESS) {     /* (NULL, or a field read from a zeroed thread) */
+		return 0;
+	}
+	return ml_nofault_copy((vm_offset_t)from, (vm_offset_t)to, size);
+}
+
+static inline bool
+peek_word(const void *at, uintptr_t *value)
+{
+	return apollo_hitch_peek((uintptr_t)at, value, sizeof(*value)) == sizeof(*value);
+}
+
+/*
+ * What processor `cpu` runs: -1 it is not there or off line, 0 its idle thread (the processor is idle), 1 a thread: *thread
+ * is its address (only ever handed to apollo_hitch_thread, never dereferenced by the caller) and *tid its id. On the
+ * processor that takes the sampler's timer interrupt, active_thread is the thread the interrupt came in on: what that
+ * processor was doing too.
+ */
+int
+apollo_hitch_cpu(unsigned cpu, uint64_t *tid, uintptr_t *thread)
+{
+	processor_t processor;
+	processor_state_t state;
+	thread_t active;
+
+	if (cpu >= MAX_SCHED_CPUS || (processor = processor_array[cpu]) == PROCESSOR_NULL) {
+		return -1;
+	}
+	state = os_atomic_load(&processor->state, relaxed);
+	if (state == PROCESSOR_OFF_LINE || state == PROCESSOR_PENDING_OFFLINE) {
+		return -1;
+	}
+	active = os_atomic_load(&processor->active_thread, relaxed);
+	if (active == THREAD_NULL) {
+		return -1;
+	}
+	if (active == processor->idle_thread) {
+		return 0;
+	}
+	*thread = (uintptr_t)active;
+	if (apollo_hitch_peek((uintptr_t)&active->thread_id, tid, sizeof(*tid)) != sizeof(*tid)) {
+		return -1;                      /* (gone already) */
+	}
+	return 1;
+}
+
+/* the id of the thread at `thread` now (the logger's check that a thread sampled earlier is still that one) */
+bool
+apollo_hitch_thread_tid(uintptr_t thread, uint64_t *tid)
+{
+	return apollo_hitch_peek((uintptr_t)&((thread_t)thread)->thread_id, tid, sizeof(*tid)) == sizeof(*tid);
+}
+
+/*
+ * The process of a thread that apollo_hitch_cpu() found (thread_ro's tro_proc: NULL for a task without one) and its uthread
+ * (co-allocated right after the thread: get_bsdthread_info is arithmetic, nothing is read). kernel: its task is kernel_task;
+ * *task_out: the task itself (only ever handed back to apollo_hitch_task_waiting).
+ * False: the thread was gone by now.
+ */
+bool
+apollo_hitch_thread(uintptr_t thread, uintptr_t *proc, uintptr_t *uthread, bool *kernel, uintptr_t *task_out)
+{
+	thread_t th = (thread_t)thread;
+	uintptr_t tro, task;
+
+	if (!peek_word(&th->t_tro, &tro) || tro == 0) {
+		return false;
+	}
+	if (!peek_word(&((struct thread_ro *)tro)->tro_task, &task) ||
+	    !peek_word(&((struct thread_ro *)tro)->tro_proc, proc)) {
+		return false;
+	}
+	*kernel = task == (uintptr_t)kernel_task;
+	*uthread = (uintptr_t)get_bsdthread_info(th);
+	*task_out = task;
+	return true;
+}
+
+/*
+ * The threads of `task` (as apollo_hitch_thread gave it) that are runnable but on no processor: state TH_RUN without TH_WAIT
+ * (TH_RUN is "running or on a run queue"), and no processor's active_thread. Up to max of them: their addresses, ids, and
+ * last_made_runnable_time (when they were woken or preempted: how long they have waited for a processor). -1: the task's
+ * thread list could not be read. The list (task->threads, linked through thread->task_threads) is walked without the task's
+ * lock, with fault-free reads only: it may change under the walk, so the walk stops at the list's head, at a thread whose
+ * thread_ro does not name this task (a link into another list, or memory reused), or after 256 threads.
+ */
+int
+apollo_hitch_task_waiting(uintptr_t task, uintptr_t *threads, uint64_t *tids, uint64_t *since_abs, int max)
+{
+	uintptr_t head = (uintptr_t)&((task_t)task)->threads, link, active[MAX_SCHED_CPUS];
+	unsigned cpus = 0;
+	int found = 0;
+
+	for (unsigned cpu = 0; cpu < MAX_SCHED_CPUS && cpu < 16; cpu++) {
+		processor_t processor = processor_array[cpu];
+
+		active[cpus++] = processor == PROCESSOR_NULL ? 0 : (uintptr_t)os_atomic_load(&processor->active_thread, relaxed);
+	}
+	if (!peek_word(&((queue_head_t *)head)->next, &link)) {
+		return -1;
+	}
+	for (unsigned walked = 0; link != head && link != 0 && walked < 256 && found < max; walked++) {
+		thread_t th = (thread_t)(link - offsetof(struct thread, task_threads));
+		uintptr_t tro = 0, owner = 0;
+		int state = 0;
+		bool running = false;
+
+		if (!peek_word(&th->t_tro, &tro) || !peek_word(&((struct thread_ro *)tro)->tro_task, &owner) || owner != task ||
+		    apollo_hitch_peek((uintptr_t)&th->state, &state, sizeof(state)) != sizeof(state)) {
+			break;
+		}
+		if ((state & (TH_RUN | TH_WAIT | TH_TERMINATE)) == TH_RUN) {
+			for (unsigned cpu = 0; cpu < cpus; cpu++) {
+				running |= active[cpu] == (uintptr_t)th;
+			}
+			if (!running &&
+			    apollo_hitch_peek((uintptr_t)&th->thread_id, &tids[found], sizeof(tids[found])) == sizeof(tids[found]) &&
+			    apollo_hitch_peek((uintptr_t)&th->last_made_runnable_time, &since_abs[found], sizeof(since_abs[found])) ==
+			    sizeof(since_abs[found])) {
+				threads[found++] = (uintptr_t)th;
+			}
+		}
+		if (!peek_word(&th->task_threads.next, &link)) {
+			break;
+		}
+	}
+	return found;
+}
+
+/*
+ * The sampler's clock: a timer call that is local to one processor (TIMER_CALL_LOCAL: it stays on the queue of the processor
+ * that armed it, and re-arming it from its own callout keeps it there) and critical (TIMER_CALL_SYS_CRITICAL: no coalescing
+ * leeway). Its callout runs in that processor's timer interrupt, so the sampler is never late for want of a thread being
+ * scheduled, and the thread it interrupts is what that processor was doing.
+ */
+static timer_call_data_t hitch_timer;
+static uint64_t hitch_interval_abs, hitch_deadline;
+static void (*hitch_tick)(uint64_t now);
+
+static void
+hitch_fire(__unused timer_call_param_t p0, __unused timer_call_param_t p1)
+{
+	uint64_t now = mach_absolute_time();
+
+	hitch_tick(now);
+	hitch_deadline += hitch_interval_abs;
+	if (hitch_deadline <= now) {
+		hitch_deadline = now + hitch_interval_abs;      /* (late: the ticks missed are not made up for) */
+	}
+	timer_call_enter(&hitch_timer, hitch_deadline, TIMER_CALL_SYS_CRITICAL | TIMER_CALL_LOCAL);
+}
+
+/* From a thread (it is bound to `cpu` for the moment it takes to arm the timer there, then let go): false, not started. */
+bool
+apollo_hitch_timer(unsigned cpu, uint64_t interval_ns, void (*tick)(uint64_t now))
+{
+	processor_t processor = cpu < MAX_SCHED_CPUS ? processor_array[cpu] : PROCESSOR_NULL;
+	bool armed = false;
+
+	if (processor == PROCESSOR_NULL || tick == NULL || hitch_tick != NULL) {
+		return false;
+	}
+	thread_bind(processor);
+	thread_block(THREAD_CONTINUE_NULL);     /* (onto that processor) */
+	if (cpu_number() == (int)cpu) {
+		nanoseconds_to_absolutetime(interval_ns, &hitch_interval_abs);
+		hitch_tick = tick;
+		timer_call_setup(&hitch_timer, hitch_fire, NULL);
+		hitch_deadline = mach_absolute_time() + hitch_interval_abs;
+		timer_call_enter(&hitch_timer, hitch_deadline, TIMER_CALL_SYS_CRITICAL | TIMER_CALL_LOCAL);
+		armed = true;
+	}
+	thread_bind(PROCESSOR_NULL);
+	return armed;
+}
